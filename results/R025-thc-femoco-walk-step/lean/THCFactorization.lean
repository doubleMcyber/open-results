namespace QC14.OneBodyRank

open QuantumComputation QuantumComputation.Specs Matrix
open QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.OrbitalBridge
  (orbitalReflection orbitalNumberOp_eq_annihilate orbitalAnnihilate
    orbitalAnnihilate_conjTranspose)
open scoped Matrix

theorem oneBodyHamiltonian_add {N : ℕ} (h h' : Matrix (Fin N) (Fin N) ℝ) :
    oneBodyHamiltonian (h + h') = oneBodyHamiltonian h + oneBodyHamiltonian h' := by
  unfold oneBodyHamiltonian
  simp only [Matrix.add_apply, Complex.ofReal_add, add_smul, Finset.sum_add_distrib]

theorem oneBodyHamiltonian_smul {N : ℕ} (c : ℝ) (h : Matrix (Fin N) (Fin N) ℝ) :
    oneBodyHamiltonian (c • h) = (c : ℂ) • oneBodyHamiltonian h := by
  unfold oneBodyHamiltonian
  simp only [Matrix.smul_apply, smul_eq_mul, Complex.ofReal_mul, mul_smul, Finset.smul_sum]

theorem oneBodyHamiltonian_sum {N L : ℕ} (h : Fin L → Matrix (Fin N) (Fin N) ℝ) :
    oneBodyHamiltonian (∑ ℓ, h ℓ) = ∑ ℓ, oneBodyHamiltonian (h ℓ) := by
  have h0 : oneBodyHamiltonian (0 : Matrix (Fin N) (Fin N) ℝ) = 0 := by
    simp [oneBodyHamiltonian]
  have key : ∀ s : Finset (Fin L), oneBodyHamiltonian (∑ ℓ ∈ s, h ℓ) =
      ∑ ℓ ∈ s, oneBodyHamiltonian (h ℓ) := by
    intro s
    induction s using Finset.induction_on with
    | empty => simpa using h0
    | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha,
        oneBodyHamiltonian_add, ih]
  exact key Finset.univ

/-- The rank-one case: `u uᵀ` gives the orbital number operators of both spins. -/
theorem oneBodyHamiltonian_vecMulVec {N : ℕ} (u : Fin N → ℝ) :
    oneBodyHamiltonian (vecMulVec u u) = ∑ σ : Fin 2, orbitalNumberOp N u σ := by
  unfold oneBodyHamiltonian
  apply Finset.sum_congr rfl
  intro σ _
  rw [orbitalNumberOp_eq_annihilate, orbitalAnnihilate_conjTranspose]
  unfold orbitalAnnihilate
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro p _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro q _
  simp only [Matrix.smul_mul, Matrix.mul_smul, smul_smul, Matrix.vecMulVec_apply,
    Complex.ofReal_mul]
  congr 1
  ring

/-- A rank-one sum as an identity offset minus a combination of orbital reflections. -/
theorem oneBodyHamiltonian_eq_reflections {N L : ℕ} (t : Fin L → ℝ) (u : Fin L → Fin N → ℝ) :
    oneBodyHamiltonian (∑ ℓ, t ℓ • vecMulVec (u ℓ) (u ℓ)) =
      ((∑ ℓ, t ℓ : ℝ) : ℂ) • 1 -
        ∑ ℓ, ∑ σ : Fin 2, ((t ℓ / 2 : ℝ) : ℂ) • orbitalReflection N (u ℓ) σ := by
  have key : ∀ ℓ, (t ℓ : ℂ) • ∑ σ : Fin 2, orbitalNumberOp N (u ℓ) σ =
      (t ℓ : ℂ) • (1 : Operator (2 ^ (2 * N))) -
        ∑ σ : Fin 2, ((t ℓ / 2 : ℝ) : ℂ) • orbitalReflection N (u ℓ) σ := by
    intro ℓ
    simp only [orbitalReflection, Fin.sum_univ_two]
    push_cast
    module
  rw [oneBodyHamiltonian_sum]
  simp only [oneBodyHamiltonian_smul, oneBodyHamiltonian_vecMulVec]
  rw [Finset.sum_congr rfl (fun ℓ _ => key ℓ), Finset.sum_sub_distrib, Complex.ofReal_sum,
    Finset.sum_smul]


end QC14.OneBodyRank


