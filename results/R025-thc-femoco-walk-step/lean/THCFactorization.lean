private lemma pairs_abs {A : Type*} [Ring A] [Algebra ℂ A] {K : ℕ}
    (w : Fin K → Fin K → ℂ) (hw : ∀ i j, w i j = w j i) (R : Fin K → A)
    (hsq : ∀ i, R i * R i = 1) :
    ∑ i, ∑ j, w i j • (R i * R j) =
      (∑ i, w i i) • (1 : A) +
        ∑ i, ∑ j, if i < j then w i j • (R i * R j + R j * R i) else 0 := by
  have hsplit : ∀ i j, w i j • (R i * R j) =
      (if i = j then w i i • (1 : A) else 0) + (if i < j then w i j • (R i * R j) else 0) +
        (if j < i then w i j • (R i * R j) else 0) := by
    intro i j
    rcases lt_trichotomy i j with h | h | h
    · simp [h, h.ne, not_lt.mpr h.le]
    · subst h
      simp [hsq]
    · simp [h, h.ne', not_lt.mpr h.le]
  have hD : (∑ i, ∑ j, if i = j then w i i • (1 : A) else 0) = (∑ i, w i i) • (1 : A) := by
    rw [Finset.sum_smul]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp
  have hV : (∑ i, ∑ j, if j < i then w i j • (R i * R j) else 0) =
      ∑ i, ∑ j, if i < j then w i j • (R j * R i) else 0 := by
    refine Finset.sum_comm.trans (Finset.sum_congr rfl fun j _ =>
      Finset.sum_congr rfl fun i _ => ?_)
    rw [hw i j]
  have hU : (∑ i, ∑ j, if i < j then w i j • (R i * R j + R j * R i) else 0) =
      (∑ i, ∑ j, if i < j then w i j • (R i * R j) else 0) +
        ∑ i, ∑ j, if i < j then w i j • (R j * R i) else 0 := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    split_ifs
    · rw [smul_add]
    · rw [add_zero]
  calc ∑ i, ∑ j, w i j • (R i * R j)
      = ∑ i, ∑ j, ((if i = j then w i i • (1 : A) else 0) +
          (if i < j then w i j • (R i * R j) else 0) +
          (if j < i then w i j • (R i * R j) else 0)) :=
        Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => hsplit i j
