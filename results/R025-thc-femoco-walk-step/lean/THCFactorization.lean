namespace QC14.PairProgram

open QuantumComputation QuantumComputation.Specs Matrix Finset
open QuantumComputation.Specs.ArcsinImpl
open Operator QProg Function
open QC14.Catalytic QC14.GivensPlane QC14.RowProgram QC14.SelectRows QC14.SelectL QC14.BlockLCU QC14.WeightsC
open QC14.PairBlock QC14.PairPrep
open QC14 (blkA blkS blkSys prepU prepC)
open QuantumComputation.Specs.PrepareImpl (clean_key count_prog mulVec_mul_unitary tblOf)
open scoped Matrix

variable {n : ℕ}

/-- Wire bounds and distinctness on the pair index (`bP = 2 bIC + 2`). -/
local macro "pairw" : tactic =>
  `(tactic| ((try simp only [ne_eq, Fin.ext_iff, bP, idxC] at *) <;> omega))

/-! ## Fredkin gates without `TOFF` -/

/-- `t ^= c₁ c₂` with two `AND4T` and a clean scratch wire `w`. -/
def toffW {k : ℕ} (c₁ c₂ t w : Wire k) (h₁₂ : c₁ ≠ c₂) (h₁w : c₁ ≠ w) (h₂w : c₂ ≠ w)
    (htw : t ≠ w) : Circuit k :=
  .seq (AND4T c₁ c₂ w h₁₂ h₁w h₂w)
    (.seq (Circuit.CNOT w t htw.symm) (AND4T c₁ c₂ w h₁₂ h₁w h₂w).inverse)

/-- `CSWAP(c; a, b)` with a clean scratch wire `w`. -/
def fredkinW {k : ℕ} (c a b w : Wire k) (hca : c ≠ a) (hab : a ≠ b) (hcw : c ≠ w)
    (haw : a ≠ w) (hbw : b ≠ w) : Circuit k :=
  .seq (Circuit.CNOT b a hab.symm)
    (.seq (toffW c a b w hca hcw haw hbw) (Circuit.CNOT b a hab.symm))

private theorem AND4T_inv_ket {k : ℕ} (c₁ c₂ t : Wire k) (h₁₂ : c₁ ≠ c₂) (h₁t : c₁ ≠ t)
    (h₂t : c₂ ≠ t) (β : BitAssignment k) (ht : β t = β c₁ * β c₂) :
    (AND4T c₁ c₂ t h₁₂ h₁t h₂t).inverse.eval.1 *ᵥ ket β = ket (Function.update β t 0) := by
  have h := ket_AND4T_eq_smul c₁ c₂ t h₁₂ h₁t h₂t (Function.update β t 0)
  rw [Function.update_of_ne h₁t, Function.update_of_ne h₂t, Function.update_self,
    Function.update_idem, zero_add, ← ht, Function.update_eq_self] at h
  have h1 : cleanAndPhase (β c₁) (β c₂) 0 = 1 := by simp [cleanAndPhase]
  rw [h1, one_smul] at h
  have hinv : (AND4T c₁ c₂ t h₁₂ h₁t h₂t).inverse.eval.1 * (AND4T c₁ c₂ t h₁₂ h₁t h₂t).eval.1 =
      1 := by
    rw [Circuit.eval_inverse]
    exact congrArg Subtype.val (inv_mul_cancel (AND4T c₁ c₂ t h₁₂ h₁t h₂t).eval)
  calc (AND4T c₁ c₂ t h₁₂ h₁t h₂t).inverse.eval.1 *ᵥ ket β
      = (AND4T c₁ c₂ t h₁₂ h₁t h₂t).inverse.eval.1 *ᵥ
          ((AND4T c₁ c₂ t h₁₂ h₁t h₂t).eval.1 *ᵥ ket (Function.update β t 0)) := by rw [h]
    _ = ket (Function.update β t 0) := by rw [Matrix.mulVec_mulVec, hinv, Matrix.one_mulVec]

theorem fredkinW_ket {k : ℕ} (c a b w : Wire k) (hca : c ≠ a) (hcb : c ≠ b) (hab : a ≠ b)
    (hcw : c ≠ w) (haw : a ≠ w) (hbw : b ≠ w) (β : BitAssignment k) (hw : β w = 0) :
    (fredkinW c a b w hca hab hcw haw hbw).eval.1 *ᵥ ket β =
      ket (if β c = 1 then β ∘ Equiv.swap a b else β) := by
  obtain ⟨β1, hβ1⟩ : ∃ γ : BitAssignment k, γ = Function.update β a (β a + β b) := ⟨_, rfl⟩
  obtain ⟨β2, hβ2⟩ : ∃ γ : BitAssignment k, γ = Function.update β1 w (β1 c * β1 a) := ⟨_, rfl⟩
  obtain ⟨β3, hβ3⟩ : ∃ γ : BitAssignment k, γ = Function.update β2 b (β2 b + β2 w) := ⟨_, rfl⟩
  obtain ⟨β4, hβ4⟩ : ∃ γ : BitAssignment k, γ = Function.update β3 w 0 := ⟨_, rfl⟩
  obtain ⟨β5, hβ5⟩ : ∃ γ : BitAssignment k, γ = Function.update β4 a (β4 a + β4 b) := ⟨_, rfl⟩
  have hac := hca.symm
  have hbc := hcb.symm
  have hba := hab.symm
  have hwa := haw.symm
  have hwb := hbw.symm
  have hwc := hcw.symm
  have h1w : β1 w = 0 := by rw [hβ1, Function.update_of_ne hwa]; exact hw
  have s1 : (Circuit.CNOT b a hab.symm).eval.1 *ᵥ ket β = ket β1 := by
    rw [ket_CNOT, hβ1]
  have s2 : (AND4T c a w hca hcw haw).eval.1 *ᵥ ket β1 = ket β2 := by
    rw [ket_AND4T_eq_smul, h1w, hβ2]
    simp [cleanAndPhase]
  have s3 : (Circuit.CNOT w b hbw.symm).eval.1 *ᵥ ket β2 = ket β3 := by
    rw [ket_CNOT, hβ3]
  have s4 : (AND4T c a w hca hcw haw).inverse.eval.1 *ᵥ ket β3 = ket β4 := by
    rw [hβ4]
    apply AND4T_inv_ket
    simp [hβ3, hβ2, Function.update_apply, hwb, hwa, hwc, hbc, hba, hac, hab, hcb, hca, hcw,
      haw, hbw]
  have s5 : (Circuit.CNOT b a hab.symm).eval.1 *ᵥ ket β4 = ket β5 := by
    rw [ket_CNOT, hβ5]
  unfold fredkinW toffW
  simp only [seq_mulVec]
  rw [s1, s2, s3, s4, s5]
  congr 1
  clear s1 s2 s3 s4 s5
  funext x
  rcases bit_cases (β a) with ha | ha <;> rcases bit_cases (β b) with hb | hb <;>
    rcases bit_cases (β c) with hc | hc <;>
    by_cases hxa : x = a <;> by_cases hxb : x = b <;> by_cases hxw : x = w <;>
    simp_all [Function.update_apply, one_add_one_zmod2, Equiv.swap_apply_of_ne_of_ne]

theorem fredkinW_count {k : ℕ} (c a b w : Wire k) (hca : c ≠ a) (hab : a ≠ b) (hcw : c ≠ w)
    (haw : a ≠ w) (hbw : b ≠ w) :
    (fredkinW c a b w hca hab hcw haw hbw).count PrimitiveGate.TOFF = 0 ∧
      (fredkinW c a b w hca hab hcw haw hbw).count PrimitiveGate.T = 8 := by
  have hT : (AND4T c a w hca hcw haw).inverse.count PrimitiveGate.T = 4 := by
    rw [Circuit.count_inverse_of_ne _ (by simp) (by simp)]
    exact count_T_AND4T _ _ _ _ _ _
  have hO : (AND4T c a w hca hcw haw).inverse.count PrimitiveGate.TOFF = 0 := by
    rw [Circuit.count_inverse_of_ne _ (by simp) (by simp)]
    exact count_TOFF_AND4T _ _ _ _ _ _
  constructor
  · simp [fredkinW, toffW, hO, count_TOFF_AND4T]
  · simp [fredkinW, toffW, hT, count_T_AND4T]

/-! ## Local circuits on the pair index -/

/-- `CSWAP(o; A_i, B_i)` for `i < m`, on index (`bP` wires) ++ one scratch wire (`bP`). -/
def cswapLoc (N M : ℕ) : (m : ℕ) → m ≤ bIC N M → Circuit (bP N M + 1)
  | 0, _ => .identity
  | m + 1, h =>
      .seq (cswapLoc N M m (by omega))
        (fredkinW ⟨idxC N M, by pairw⟩ ⟨m, by pairw⟩
          ⟨bIC N M + m, by pairw⟩ ⟨bP N M, by pairw⟩
          (by pairw) (by pairw)
          (by pairw) (by pairw)
          (by pairw))

theorem cswapLoc_count (N M : ℕ) (m : ℕ) (h : m ≤ bIC N M) :
    (cswapLoc N M m h).count PrimitiveGate.TOFF = 0 ∧
      (cswapLoc N M m h).count PrimitiveGate.T = 8 * m := by
  induction m with
  | zero => simp [cswapLoc]
  | succ m ih =>
    obtain ⟨h1, h2⟩ := ih (by omega)
    obtain ⟨f1, f2⟩ := fredkinW_count (k := bP N M + 1) ⟨idxC N M, by pairw⟩ ⟨m, by pairw⟩
      ⟨bIC N M + m, by pairw⟩ ⟨bP N M, by pairw⟩ (by pairw) (by pairw) (by pairw) (by pairw)
      (by pairw)
    refine ⟨?_, ?_⟩
    · simp only [cswapLoc, Circuit.count_seq, h1, f1]
    · simp only [cswapLoc, Circuit.count_seq, h2, f2]; omega

/-- `SWAP(A_i, B_i)` for `i < m`, on the index. -/
def swapLoc (N M : ℕ) : (m : ℕ) → m ≤ bIC N M → Circuit (bP N M)
  | 0, _ => .identity
  | m + 1, h =>
      .seq (swapLoc N M m (by omega))
        (Circuit.SWAP ⟨m, by pairw⟩ ⟨bIC N M + m, by pairw⟩
          (by pairw))

/-- `SWAP(A, B) X_o` on the index. -/
def swapXLoc (N M : ℕ) : Circuit (bP N M) :=
  .seq (swapLoc N M (bIC N M) le_rfl) (Circuit.single PrimitiveGate.X ⟨idxC N M, by pairw⟩)

/-- `Z_z` on the index. -/
def zLoc (N M : ℕ) : Circuit (bP N M) :=
  Circuit.single PrimitiveGate.Z ⟨2 * bIC N M, by pairw⟩

private theorem swapLoc_count (N M : ℕ) (m : ℕ) (h : m ≤ bIC N M) :
    (swapLoc N M m h).count PrimitiveGate.TOFF = 0 ∧ (swapLoc N M m h).count PrimitiveGate.T = 0 := by
  induction m with
  | zero => simp [swapLoc]
  | succ m ih =>
    obtain ⟨h1, h2⟩ := ih (by omega)
    simp [swapLoc, h1, h2]

private theorem swapXLoc_count (N M : ℕ) :
    (swapXLoc N M).count PrimitiveGate.TOFF = 0 ∧ (swapXLoc N M).count PrimitiveGate.T = 0 := by
  obtain ⟨h1, h2⟩ := swapLoc_count N M (bIC N M) le_rfl
  simp [swapXLoc, h1, h2]

private theorem zLoc_count (N M : ℕ) :
    (zLoc N M).count PrimitiveGate.TOFF = 0 ∧ (zLoc N M).count PrimitiveGate.T = 0 := by
  simp [zLoc]

/-! ### Bit bridge for the pair index -/

private theorem exists_enc (N M : ℕ) (j : Fin (2 ^ bP N M)) :
    ∃ (A B : Fin (2 ^ bIC N M)) (z o : Bool), j = encP (encC A B z) o :=
  ⟨idxA (loP j), idxB (loP j), idxZ (loP j), oP j, by rw [encC_idx, encP_loP]⟩

private theorem swapP_enc (N M : ℕ) (A B : Fin (2 ^ bIC N M)) (z o : Bool) :
    swapP (encP (encC A B z) o) = encP (encC B A z) (!o) := by
  unfold swapP swapAB
  rw [loP_encP, oP_encP, idxA_encC, idxB_encC, idxZ_encC]

private theorem tb_one (c : Bool) (y : ℕ) :
    (if c then 1 else 0 : ℕ).testBit y = (c && decide (y = 0)) := by
  cases c
  · simp
  · rcases y with _ | y
    · simp
    · have : (1 : ℕ) < 2 ^ (y + 1) := Nat.one_lt_two_pow (by omega)
      simp [Nat.testBit_lt_two_pow this]

private theorem testBit_enc (N M : ℕ) (A B : Fin (2 ^ bIC N M)) (z o : Bool) (x : ℕ) :
    (encP (encC A B z) o).val.testBit x =
      if x < bIC N M then A.val.testBit x
      else if x < 2 * bIC N M then B.val.testBit (x - bIC N M)
      else if x = 2 * bIC N M then z else if x = 2 * bIC N M + 1 then o else false := by
  have hv : (encP (encC A B z) o).val = 2 ^ bIC N M * (B.val + 2 ^ bIC N M *
      (2 ^ 1 * (if o then 1 else 0) + (if z then 1 else 0))) + A.val := by
    show A.val + 2 ^ bIC N M * B.val + 2 ^ (2 * bIC N M) * (if z then 1 else 0) +
      2 ^ idxC N M * (if o then 1 else 0) = _
    simp only [idxC]
    ring
  have hz : (if z then 1 else 0 : ℕ) < 2 ^ 1 := by split_ifs <;> norm_num
  rw [hv, Nat.testBit_two_pow_mul_add _ A.2]
  by_cases h1 : x < bIC N M
  · simp [h1]
  · rw [if_neg h1, Nat.add_comm B.val, Nat.testBit_two_pow_mul_add _ B.2]
    by_cases h2 : x < 2 * bIC N M
    · have h3 : x - bIC N M < bIC N M := by omega
      simp [h1, h2, h3]
    · have h3 : ¬ x - bIC N M < bIC N M := by omega
      rw [if_neg h3, Nat.testBit_two_pow_mul_add _ hz]
      rcases (by omega : x = 2 * bIC N M ∨ x = 2 * bIC N M + 1 ∨ 2 * bIC N M + 2 ≤ x) with
        h4 | h4 | h4
      · have e : x - bIC N M - bIC N M = 0 := by omega
        subst h4
        have a1 : ¬ 2 * bIC N M < bIC N M := by omega
        rw [if_neg a1, if_neg h2, if_pos rfl, e]
        cases z <;> simp [tb_one]
      · have e : x - bIC N M - bIC N M = 1 := by omega
        have e' : ¬ x = 2 * bIC N M := by omega
        subst h4
        have a1 : ¬ 2 * bIC N M + 1 < bIC N M := by omega
        rw [if_neg a1, if_neg h2, if_neg e', if_pos rfl, e]
        cases o <;> simp [tb_one]
      · have e : ¬ x - bIC N M - bIC N M < 1 := by omega
        have e' : ¬ x - bIC N M - bIC N M - 1 = 0 := by omega
        have e2 : ¬ x = 2 * bIC N M := by omega
        have e3 : ¬ x = 2 * bIC N M + 1 := by omega
        simp [h1, h2, e, e', e2, e3, tb_one]

private theorem enc_bit_A (N M : ℕ) (A B : Fin (2 ^ bIC N M)) (z o : Bool) (x : ℕ)
    (h : x < bIC N M) : (encP (encC A B z) o).val.testBit x = A.val.testBit x := by
  rw [testBit_enc, if_pos h]

private theorem enc_bit_B (N M : ℕ) (A B : Fin (2 ^ bIC N M)) (z o : Bool) (x : ℕ)
    (h1 : bIC N M ≤ x) (h2 : x < 2 * bIC N M) :
    (encP (encC A B z) o).val.testBit x = B.val.testBit (x - bIC N M) := by
  rw [testBit_enc, if_neg (by omega), if_pos h2]

private theorem enc_bit_z (N M : ℕ) (A B : Fin (2 ^ bIC N M)) (z o : Bool) :
    (encP (encC A B z) o).val.testBit (2 * bIC N M) = z := by
  rw [testBit_enc, if_neg (by omega), if_neg (by omega), if_pos rfl]

private theorem enc_bit_o (N M : ℕ) (A B : Fin (2 ^ bIC N M)) (z o : Bool) :
    (encP (encC A B z) o).val.testBit (2 * bIC N M + 1) = o := by
  rw [testBit_enc, if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos rfl]

/-! ### Kets through the index circuits -/

private theorem ket_SWAP' {k : ℕ} (l r : Wire k) (h : l ≠ r) (β : BitAssignment k) :
    (Circuit.SWAP l r h).eval.1 *ᵥ ket β = ket (β ∘ Equiv.swap l r) := by
  rw [Circuit.eval_gate, QRegister.embedUnitary_val, PrimitiveGate.eval_swap_val,
    embedMatrix_permMatrix_mulVec_ket]
  have hloc : ∀ γ : BitAssignment 2,
      basisBits 2 ((Equiv.swap (1 : Fin 4) 2).symm ((basisBits 2).symm γ)) = ![γ 1, γ 0] := by
    decide
  rw [localIdx, hloc]
  congr 1
  funext x
  by_cases hxl : x = l
  · subst hxl
    have := writeReg_apply_reg β (QRegister.pair x r h) ![β r, β x] 0
    simpa [Equiv.swap_apply_left] using this
  · by_cases hxr : x = r
    · subst hxr
      have := writeReg_apply_reg β (QRegister.pair l x h) ![β x, β l] 1
      simpa [Equiv.swap_apply_right] using this
    · rw [writeReg_apply_of_not_mem _ _ _ _ (by
        simp [QRegister.pair, Set.mem_range, Fin.exists_fin_two, Ne.symm hxl, Ne.symm hxr, hxl, hxr])]
      simp [Equiv.swap_apply_of_ne_of_ne hxl hxr]

/-- Wire map of the first `m` swaps `(i, bIC + i)`. -/
private def swapG (N M m x : ℕ) : ℕ :=
  if x < m then bIC N M + x else if bIC N M ≤ x ∧ x < bIC N M + m then x - bIC N M else x

private theorem swapG_zero (N M x : ℕ) : swapG N M 0 x = x := by
  unfold swapG; split_ifs <;> omega

private theorem swapG_lt (N M m x : ℕ) (hm : m ≤ bIC N M) (hx : x < bP N M) :
    swapG N M m x < bP N M := by
  unfold swapG
  split_ifs <;> simp only [bP, idxC] at * <;> omega

private theorem swapLoc_ket (N M m : ℕ) (hm : m ≤ bIC N M) (β : BitAssignment (bP N M)) :
    (swapLoc N M m hm).eval.1 *ᵥ ket β =
      ket (fun x ↦ β ⟨swapG N M m x.val, swapG_lt N M m x.val hm x.2⟩) := by
  induction m with
  | zero =>
    simp only [swapLoc, Circuit.eval_identity]
    change (1 : Matrix (Fin (2 ^ bP N M)) (Fin (2 ^ bP N M)) ℂ) *ᵥ ket β = _
    rw [Matrix.one_mulVec]
    congr 1
    funext x
    exact congrArg β (Fin.ext (swapG_zero N M x.val).symm)
  | succ m ih =>
    unfold swapLoc
    rw [seq_mulVec, ih (by omega), ket_SWAP']
    congr 1
    funext x
    simp only [Function.comp_apply, Equiv.swap_apply_def, Fin.ext_iff]
    congr 1
    apply Fin.ext
    simp only [swapG]
    split_ifs <;> simp_all <;> omega

private theorem swapXLoc_ket (N M : ℕ) (β : BitAssignment (bP N M)) :
    (swapXLoc N M).eval.1 *ᵥ ket β =
      ket (Function.update
        (fun x ↦ β ⟨swapG N M (bIC N M) x.val, swapG_lt N M _ x.val le_rfl x.2⟩)
        ⟨idxC N M, by pairw⟩
        (β ⟨swapG N M (bIC N M) (idxC N M), swapG_lt N M _ _ le_rfl (by pairw)⟩ + 1)) := by
  unfold swapXLoc
  rw [seq_mulVec, swapLoc_ket, ket_X]

private theorem basisBits_mk (N M : ℕ) (j : Fin (2 ^ bP N M)) (y : ℕ) (h : y < bP N M) :
    basisBits (bP N M) j ⟨y, h⟩ = if j.val.testBit y then 1 else 0 :=
  basisBits_eq_testBit _ j ⟨y, h⟩

private theorem swapXLoc_ket_basis (N M : ℕ) (j : Fin (2 ^ bP N M)) :
    (swapXLoc N M).eval.1 *ᵥ ket (basisBits _ j) = ket (basisBits _ (swapP j)) := by
  obtain ⟨A, B, z, o, rfl⟩ := exists_enc N M j
  rw [swapXLoc_ket, swapP_enc]
  congr 1
  funext x
  have hc : idxC N M = 2 * bIC N M + 1 := rfl
  have hb : bP N M = 2 * bIC N M + 2 := rfl
  obtain ⟨xv, hxv⟩ := x
  rw [Function.update_apply]
  by_cases hxo : xv = idxC N M
  · subst hxo
    rw [if_pos rfl]
    have g : swapG N M (bIC N M) (idxC N M) = idxC N M := by
      unfold swapG; rw [if_neg (by omega), if_neg (by omega)]
    simp only [basisBits_mk, g]
    simp only [hc, enc_bit_o]
    cases o <;> first | decide | simp
  · have hne : ¬ (⟨xv, hxv⟩ : Fin (bP N M)) = ⟨idxC N M, by pairw⟩ := fun h ↦ hxo (by
      simpa using h)
    rw [if_neg hne]
    simp only [basisBits_mk]
    by_cases h1 : xv < bIC N M
    · have g : swapG N M (bIC N M) xv = bIC N M + xv := by
        unfold swapG; rw [if_pos h1]
      rw [g, enc_bit_B N M A B z o _ (by omega) (by omega), enc_bit_A N M B A z _ _ h1]
      simp
    · by_cases h2 : xv < 2 * bIC N M
      · have g : swapG N M (bIC N M) xv = xv - bIC N M := by
          unfold swapG; rw [if_neg h1, if_pos ⟨by omega, by omega⟩]
        rw [g, enc_bit_A N M A B z o _ (by omega), enc_bit_B N M B A z _ _ (by omega) h2]
      · have g : swapG N M (bIC N M) xv = xv := by
          unfold swapG; rw [if_neg h1, if_neg (by omega)]
        rw [g]
        by_cases h3 : xv = 2 * bIC N M
        · rw [h3, enc_bit_z, enc_bit_z]
        · omega

private theorem sum_single_mulVec {d : ℕ} (σ : Fin d → Fin d) (j : Fin d) :
    (∑ x, Matrix.single (σ x) x (1 : ℂ)) *ᵥ (Pi.single j 1 : Fin d → ℂ) = Pi.single (σ j) 1 := by
  rw [Matrix.mulVec_single_one]
  funext i
  have : (∑ x, Matrix.single (σ x) x (1 : ℂ)) i j = (Pi.single (σ j) (1 : ℂ) : Fin d → ℂ) i := by
    rw [Matrix.sum_apply, Finset.sum_eq_single j]
    · simp [Matrix.single_apply, Pi.single_apply, eq_comm]
    · intro x _ hx
      simp [Matrix.single_apply, hx]
    · simp
  exact this

private theorem sum_diag_mulVec {d : ℕ} (c : Fin d → ℂ) (j : Fin d) :
    (∑ x, c x • Matrix.single x x (1 : ℂ)) *ᵥ (Pi.single j 1 : Fin d → ℂ) =
      c j • Pi.single j 1 := by
  rw [Matrix.mulVec_single_one]
  funext i
  have : (∑ x, c x • Matrix.single x x (1 : ℂ)) i j = (c j • Pi.single j 1 : Fin d → ℂ) i := by
    rw [Matrix.sum_apply, Finset.sum_eq_single j]
    · simp [Matrix.single_apply, Pi.single_apply, eq_comm]
    · intro x _ hx
      simp [Matrix.single_apply, hx]
    · simp
  exact this

theorem swapXLoc_eval (N M : ℕ) :
    (idxReg N (bP N M)).embedMatrix (swapXLoc N M).eval.1 = swapOp N M := by
  have hloc : (swapXLoc N M).eval.1 =
      ∑ x : Fin (2 ^ bP N M), Matrix.single (swapP x) x (1 : ℂ) := by
    apply matrix_ext_ket
    intro β
    obtain ⟨j, rfl⟩ := (basisBits (bP N M)).surjective β
    rw [swapXLoc_ket_basis]
    simp only [← single_eq_ket]
    exact (sum_single_mulVec _ _).symm
  unfold swapOp idxTr
  rw [hloc, QRegister.embedMatrix_sum]

private theorem zLoc_ket_basis (N M : ℕ) (j : Fin (2 ^ bP N M)) :
    (zLoc N M).eval.1 *ᵥ ket (basisBits _ j) =
      (if idxZ (loP j) then (-1 : ℂ) else 1) • ket (basisBits _ j) := by
  obtain ⟨A, B, z, o, rfl⟩ := exists_enc N M j
  unfold zLoc
  rw [ket_Z, basisBits_eq_testBit, show (⟨2 * bIC N M, by pairw⟩ : Fin (bP N M)).val = 2 * bIC N M
    from rfl, enc_bit_z, loP_encP, idxZ_encC]
  simp only [bitSign]
  cases z <;> simp

theorem zLoc_eval (N M : ℕ) :
    (idxReg N (bP N M)).embedMatrix (zLoc N M).eval.1 = zOp N M := by
  have hloc : (zLoc N M).eval.1 =
      ∑ x : Fin (2 ^ bP N M), (if idxZ (loP x) then (-1 : ℂ) else 1) •
        Matrix.single x x (1 : ℂ) := by
    apply matrix_ext_ket
    intro β
    obtain ⟨j, rfl⟩ := (basisBits (bP N M)).surjective β
    rw [zLoc_ket_basis]
    simp only [← single_eq_ket]
    exact (sum_diag_mulVec (fun x ↦ if idxZ (loP x) = true then (-1 : ℂ) else 1) j).symm
  unfold zOp idxTr
  simp only [← QRegister.embedMatrix_smul]
  rw [hloc, QRegister.embedMatrix_sum]

/-! ### CSWAP kets -/

private theorem swapG_lt1 (N M m x : ℕ) (hm : m ≤ bIC N M) (hx : x < bP N M + 1) :
    swapG N M m x < bP N M + 1 := by
  unfold swapG
  split_ifs <;> simp only [bP, idxC] at * <;> omega

private theorem cswapLoc_ket (N M : ℕ) (m : ℕ) (hm : m ≤ bIC N M)
    (γ : BitAssignment (bP N M + 1)) (hw : γ ⟨bP N M, by omega⟩ = 0) :
    (cswapLoc N M m hm).eval.1 *ᵥ ket γ =
      ket (if γ ⟨idxC N M, by pairw⟩ = 1 then
        (fun x ↦ γ ⟨swapG N M m x.val, swapG_lt1 N M m x.val hm x.2⟩) else γ) := by
  have hc : idxC N M = 2 * bIC N M + 1 := rfl
  have hb : bP N M = 2 * bIC N M + 2 := rfl
  induction m with
  | zero =>
    simp only [cswapLoc, Circuit.eval_identity]
    change (1 : Matrix (Fin (2 ^ (bP N M + 1))) (Fin (2 ^ (bP N M + 1))) ℂ) *ᵥ ket γ = _
    rw [Matrix.one_mulVec]
    split_ifs
    · congr 1; funext x; exact congrArg γ (Fin.ext (swapG_zero N M x.val).symm)
    · rfl
  | succ m ih =>
    unfold cswapLoc
    rw [seq_mulVec, ih (by omega) hw]
    have gc : swapG N M m (idxC N M) = idxC N M := by
      unfold swapG; rw [if_neg (by omega), if_neg (by omega)]
    have gw : swapG N M m (bP N M) = bP N M := by
      unfold swapG; rw [if_neg (by omega), if_neg (by omega)]
    by_cases hcc : γ ⟨idxC N M, by pairw⟩ = 1
    · rw [if_pos hcc, if_pos hcc]
      have hF := fredkinW_ket (⟨idxC N M, by pairw⟩ : Wire (bP N M + 1)) ⟨m, by pairw⟩
        ⟨bIC N M + m, by pairw⟩ ⟨bP N M, by pairw⟩ (by pairw) (by pairw) (by pairw)
        (by pairw) (by pairw) (by pairw)
        (fun x ↦ γ ⟨swapG N M m x.val, swapG_lt1 N M m x.val (by omega) x.2⟩)
        (by simp only [gw]; exact hw)
      rw [hF]
      have hcc' : (fun x : Fin (bP N M + 1) ↦
          γ ⟨swapG N M m x.val, swapG_lt1 N M m x.val (by omega) x.2⟩) ⟨idxC N M, by pairw⟩ = 1 := by
        simp only [gc]; exact hcc
      rw [if_pos hcc']
      congr 1
      funext x
      simp only [Function.comp_apply, Equiv.swap_apply_def, Fin.ext_iff]
      congr 1
      apply Fin.ext
      simp only [swapG]
      split_ifs <;> simp_all <;> omega
    · rw [if_neg hcc, if_neg hcc]
      have hF := fredkinW_ket (⟨idxC N M, by pairw⟩ : Wire (bP N M + 1)) ⟨m, by pairw⟩
        ⟨bIC N M + m, by pairw⟩ ⟨bP N M, by pairw⟩ (by pairw) (by pairw) (by pairw)
        (by pairw) (by pairw) (by pairw) γ hw
      rw [hF, if_neg hcc]

private theorem embedMatrix_ket_of {k m : ℕ} (r : QRegister k m)
    (U : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ) (β : BitAssignment m) (γ' : BitAssignment k)
    (hU : U *ᵥ ket (basisBits k (localIdx r β)) = ket γ') :
    r.embedMatrix U *ᵥ ket β = ket (writeReg β r γ') := by
  have hk : ket γ' = Pi.single ((basisBits k).symm γ') (1 : ℂ) := by
    rw [single_eq_ket, Equiv.apply_symm_apply]
  have hU' : ∀ l, U l (localIdx r β) = (Pi.single ((basisBits k).symm γ') (1 : ℂ) :
      Fin (2 ^ k) → ℂ) l := by
    intro l
    have h1 := congrFun hU l
    rw [← single_eq_ket, Matrix.mulVec_single_one, hk] at h1
    exact h1
  rw [embedMatrix_mulVec_ket, Finset.sum_eq_single ((basisBits k).symm γ')]
  · rw [hU', Pi.single_eq_same, one_smul, Equiv.apply_symm_apply]
  · intro l _ hl
    rw [hU', Pi.single_eq_of_ne hl, zero_smul]
  · intro h
    exact absurd (Finset.mem_univ _) h

private theorem A3_ket {N M g : ℕ} (R : QRegister (bP N M + g) n) (β : BitAssignment n) :
    (R.embedUnitary (permutationUnitary (cswapPerm N M g))).1 *ᵥ ket β =
      ket (writeReg β R (basisBits _ (cswapPerm N M g (localIdx R β)))) := by
  rw [QRegister.embedUnitary_val]
  show R.embedMatrix (Equiv.Perm.permMatrix ℂ (cswapPerm N M g)⁻¹) *ᵥ ket β = _
  rw [embedMatrix_permMatrix_mulVec_ket, Equiv.Perm.inv_def, Equiv.symm_symm]

private theorem pde_bit (P g : ℕ) (j : Fin (2 ^ P)) (y : Fin (2 ^ g)) (i : ℕ) :
    (prepareDataEquiv P g (j, y)).val.testBit i =
      if i < P then j.val.testBit i else y.val.testBit (i - P) := by
  rw [prepareDataEquiv_val, Nat.add_comm, Nat.testBit_two_pow_mul_add _ j.2]

private theorem cswapPerm_pde (N M g : ℕ) (j : Fin (2 ^ bP N M)) (y : Fin (2 ^ g)) :
    cswapPerm N M g (prepareDataEquiv (bP N M) g (j, y)) =
      prepareDataEquiv (bP N M) g (cswapIdx j, y) := by
  simp [cswapPerm]
  rfl

private theorem bit_swap (N M : ℕ) (A B : Fin (2 ^ bIC N M)) (z o o' : Bool) (i : ℕ)
    (hi : i < bP N M) (ho : i = idxC N M → o' = o) :
    (encP (encC B A z) o').val.testBit i =
      (encP (encC A B z) o).val.testBit (swapG N M (bIC N M) i) := by
  have hc : idxC N M = 2 * bIC N M + 1 := rfl
  have hb : bP N M = 2 * bIC N M + 2 := rfl
  by_cases h1 : i < bIC N M
  · have g : swapG N M (bIC N M) i = bIC N M + i := by unfold swapG; rw [if_pos h1]
    rw [g, enc_bit_B N M A B z o _ (by omega) (by omega), enc_bit_A N M B A z _ _ h1]
    simp
  · by_cases h2 : i < 2 * bIC N M
    · have g : swapG N M (bIC N M) i = i - bIC N M := by
        unfold swapG; rw [if_neg h1, if_pos ⟨by omega, by omega⟩]
      rw [g, enc_bit_A N M A B z o _ (by omega), enc_bit_B N M B A z _ _ (by omega) h2]
    · have g : swapG N M (bIC N M) i = i := by
        unfold swapG; rw [if_neg h1, if_neg (by omega)]
      rw [g]
      by_cases h3 : i = 2 * bIC N M
      · rw [h3, enc_bit_z, enc_bit_z]
      · have h4 : i = 2 * bIC N M + 1 := by omega
        rw [h4, enc_bit_o, enc_bit_o, ho (by omega)]

private theorem cswapIdx_bit (N M : ℕ) (j : Fin (2 ^ bP N M)) (i : ℕ) (hi : i < bP N M) :
    (cswapIdx j).val.testBit i =
      if j.val.testBit (idxC N M) then j.val.testBit (swapG N M (bIC N M) i)
      else j.val.testBit i := by
  have hc : idxC N M = 2 * bIC N M + 1 := rfl
  obtain ⟨A, B, z, o, rfl⟩ := exists_enc N M j
  rw [hc, enc_bit_o]
  cases o
  · simp [cswapIdx, oP_encP]
  · simp only [cswapIdx, oP_encP, if_true, loP_encP, swapAB, idxA_encC, idxB_encC, idxZ_encC]
    exact bit_swap N M A B z true true i hi (fun _ ↦ rfl)

/-! ## The pair PREPARE circuit -/

/-- Index ++ scratch wire `rAnc 0`. -/
def cswReg {N M g : ℕ} (rData : QRegister (2 * N + (bP N M + g)) n)
    (rAnc : QRegister (bP N M + g + 1) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    QRegister (bP N M + 1) n :=
  (rData.slice (2 * N) (bP N M) (by omega)).concat (rAnc.slice 0 1 (by omega))
    (QRegister.disjoint_iff.2 (fun i j ↦ hd _ _))


theorem cswap_clean {N M g : ℕ} (rData : QRegister (2 * N + (bP N M + g)) n)
    (rAnc : QRegister (bP N M + g + 1) n) (hd : ∀ i j, rData i ≠ rAnc j)
    (β : BitAssignment n) (h0 : localIdx rAnc β = 0) :
    ((cswapLoc N M (bIC N M) le_rfl).onRegister (cswReg rData rAnc hd)).eval.1 *ᵥ ket β =
      ((rData.compose (blkA (2 * N) (bP N M) g)).embedUnitary
        (permutationUnitary (cswapPerm N M g))).1 *ᵥ ket β := by
  have hc : idxC N M = 2 * bIC N M + 1 := rfl
  have hb : bP N M = 2 * bIC N M + 2 := rfl
  set R := rData.compose (blkA (2 * N) (bP N M) g) with hR
  have hRapp : ∀ i : Fin (bP N M + g), R i = rData ⟨2 * N + i.val, by omega⟩ := fun i ↦ rfl
  have hcswL : ∀ i : Fin (bP N M), cswReg rData rAnc hd (Fin.castAdd 1 i) =
      R (Fin.castAdd g i) := by
    intro i
    unfold cswReg
    rw [QRegister.concat_apply_left, QRegister.slice_apply]
    rfl
  have hcswR : ∀ m : Fin 1, cswReg rData rAnc hd (Fin.natAdd (bP N M) m) =
      rAnc ⟨0, by omega⟩ := by
    intro m
    obtain rfl : m = 0 := Subsingleton.elim _ _
    unfold cswReg
    rw [QRegister.concat_apply_right, QRegister.slice_apply]
    rfl
  have hz : β (rAnc ⟨0, by omega⟩) = 0 := (localIdx_eq_zero_iff rAnc β).1 h0 _
  set γ : BitAssignment (bP N M + 1) := fun k ↦ β (cswReg rData rAnc hd k) with hγdef
  have hγw : γ ⟨bP N M, by omega⟩ = 0 := by
    show β (cswReg rData rAnc hd (Fin.natAdd (bP N M) 0)) = 0
    rw [hcswR]; exact hz
  have hloc : basisBits (bP N M + 1) (localIdx (cswReg rData rAnc hd) β) = γ :=
    Equiv.apply_symm_apply _ _
  have hU : (cswapLoc N M (bIC N M) le_rfl).eval.1 *ᵥ
      ket (basisBits (bP N M + 1) (localIdx (cswReg rData rAnc hd) β)) =
      ket (if γ ⟨idxC N M, by pairw⟩ = 1 then
        (fun x ↦ γ ⟨swapG N M (bIC N M) x.val, swapG_lt1 N M _ x.val le_rfl x.2⟩) else γ) := by
    rw [hloc]; exact cswapLoc_ket N M (bIC N M) le_rfl γ hγw
  rw [Circuit.eval_onRegister, QRegister.embedUnitary_val, A3_ket,
    embedMatrix_ket_of _ _ β _ hU]
  obtain ⟨⟨j', y'⟩, hx⟩ := (prepareDataEquiv (bP N M) g).surjective (localIdx R β)
  have hbitx : ∀ i : Fin (bP N M + g), β (R i) =
      if (localIdx R β).val.testBit i.val then 1 else 0 := by
    intro i
    have h1 := basisBits_eq_testBit _ (localIdx R β) i
    rw [show basisBits _ (localIdx R β) i = β (R i) from
      congrFun (Equiv.apply_symm_apply (basisBits (bP N M + g)) (fun i ↦ β (R i))) i] at h1
    exact h1
  rw [← hx] at hbitx ⊢
  rw [cswapPerm_pde]
  congr 1
  have hγbit : ∀ (m : ℕ) (hm : m < bP N M) (hm' : m < bP N M + 1),
      γ ⟨m, hm'⟩ = if j'.val.testBit m then 1 else 0 := by
    intro m hm hm'
    show β (cswReg rData rAnc hd (Fin.castAdd 1 ⟨m, hm⟩)) = _
    rw [hcswL, hbitx, Fin.coe_castAdd, pde_bit, if_pos hm]
  have gw : swapG N M (bIC N M) (bP N M) = bP N M := by
    unfold swapG; rw [if_neg (by omega), if_neg (by omega)]
  have hnotin : ∀ i : Fin (bP N M + g), ¬ i.val < bP N M →
      R i ∉ Set.range (cswReg rData rAnc hd).wires := by
    rintro i hi ⟨k, hk⟩
    induction k using Fin.addCases with
    | left m =>
      have h1 : R (Fin.castAdd g m) = R i := (hcswL m).symm.trans hk
      have h2 := congrArg Fin.val (R.wires.injective h1)
      simp only [Fin.coe_castAdd] at h2
      omega
    | right m =>
      rw [hcswR] at hk
      exact hd ⟨2 * N + i.val, by omega⟩ ⟨0, by omega⟩ (by rw [← hRapp i]; exact hk.symm)
  funext w
  by_cases hwR : ∃ i : Fin (bP N M + g), R i = w
  · obtain ⟨i, rfl⟩ := hwR
    rw [writeReg_apply_reg, basisBits_eq_testBit, pde_bit]
    by_cases hi : i.val < bP N M
    · have hi' : R i = cswReg rData rAnc hd (Fin.castAdd 1 ⟨i.val, hi⟩) := by
        rw [hcswL]; rfl
      rw [hi', writeReg_apply_reg, if_pos hi, cswapIdx_bit N M j' i.val hi]
      have hlt : swapG N M (bIC N M) i.val < bP N M := swapG_lt N M _ i.val le_rfl hi
      by_cases hb' : j'.val.testBit (idxC N M)
      · have e1 : γ ⟨idxC N M, by pairw⟩ = 1 := by
          rw [hγbit _ (by omega) _, if_pos hb']
        rw [if_pos e1, if_pos hb']
        show γ ⟨swapG N M (bIC N M) i.val, _⟩ = _
        rw [hγbit _ hlt _]
      · have e1 : ¬ γ ⟨idxC N M, by pairw⟩ = 1 := by
          rw [hγbit _ (by omega) _, if_neg hb']; decide
        rw [if_neg e1, if_neg hb']
        show γ ⟨i.val, _⟩ = _
        rw [hγbit _ hi _]
    · rw [writeReg_apply_of_not_mem _ _ _ _ (hnotin i hi), if_neg hi, hbitx, pde_bit, if_neg hi]
  · rw [writeReg_apply_of_not_mem β R _ w (by rintro ⟨i, hi⟩; exact hwR ⟨i, hi⟩)]
    by_cases hwA : w = rAnc ⟨0, by omega⟩
    · subst hwA
      rw [← hcswR 0, writeReg_apply_reg]
      have e : (⟨swapG N M (bIC N M) (bP N M), swapG_lt1 N M _ _ le_rfl (by omega)⟩ :
          Fin (bP N M + 1)) = ⟨bP N M, by omega⟩ := Fin.ext gw
      by_cases hcc : γ ⟨idxC N M, by pairw⟩ = 1
      · rw [if_pos hcc]
        show γ ⟨swapG N M (bIC N M) (bP N M), _⟩ = _
        rw [e]
        try rfl
      · rw [if_neg hcc]
    · refine writeReg_apply_of_not_mem β (cswReg rData rAnc hd) _ w ?_
      rintro ⟨k, hk⟩
      induction k using Fin.addCases with
      | left m => exact hwR ⟨Fin.castAdd g m, (hcswL m).symm.trans hk⟩
      | right m => rw [hcswR] at hk; exact hwA hk.symm


theorem ket_of_clean_mul {m k : ℕ} (rAnc : QRegister k m)
    (X Y : Matrix (Fin (2 ^ m)) (Fin (2 ^ m)) ℂ)
    (h : X * rAnc.basisOutcomeProjector 0 = Y * rAnc.basisOutcomeProjector 0)
    (β : BitAssignment m) (h0 : localIdx rAnc β = 0) : X *ᵥ ket β = Y *ᵥ ket β := by
  have hQk : rAnc.basisOutcomeProjector 0 *ᵥ ket β = ket β := by
    rw [basisOutcomeProjector_mulVec_ket]; exact if_pos h0
  have h1 := congrArg (fun M ↦ M *ᵥ ket β) h
  simp only [← Matrix.mulVec_mulVec, hQk] at h1
  exact h1

theorem chain3_ket {m k kt : ℕ} (rT : QRegister kt m) (rAnc : QRegister k m)
    (hdD : rT.DisjointWires rAnc)
    (C1 C2 C3 : Matrix (Fin (2 ^ m)) (Fin (2 ^ m)) ℂ) (U1 U2 U3 : Unitary (2 ^ kt))
    (h1 : ∀ β, localIdx rAnc β = 0 → C1 *ᵥ ket β = (rT.embedUnitary U1).1 *ᵥ ket β)
    (h2 : ∀ β, localIdx rAnc β = 0 → C2 *ᵥ ket β = (rT.embedUnitary U2).1 *ᵥ ket β)
    (h3 : ∀ β, localIdx rAnc β = 0 → C3 *ᵥ ket β = (rT.embedUnitary U3).1 *ᵥ ket β)
    (β : BitAssignment m) (h0 : localIdx rAnc β = 0) :
    (C3 * C2 * C1) *ᵥ ket β = (rT.embedUnitary (U3 * U2 * U1)).1 *ᵥ ket β := by
  have e1 := QC14.clean_ext rAnc _ _ h1
  have e2 := QC14.clean_ext rAnc _ _ h2
  have e3 := QC14.clean_ext rAnc _ _ h3
  have c1 := (CleanSubroutineBridge.embed_comm_proj rT rAnc hdD U1).symm
  have c2 := (CleanSubroutineBridge.embed_comm_proj rT rAnc hdD U2).symm
  have c12 : ((rT.embedUnitary U2).1 * (rT.embedUnitary U1).1) * rAnc.basisOutcomeProjector 0 =
      rAnc.basisOutcomeProjector 0 * ((rT.embedUnitary U2).1 * (rT.embedUnitary U1).1) := by
    rw [mul_assoc, c1, ← mul_assoc, c2, mul_assoc]
  have key := QC14.chain_clean (QC14.chain_clean e1 e2 c1) e3 c12
  have hE : (rT.embedUnitary (U3 * U2 * U1)).1 =
      (rT.embedUnitary U3).1 * (rT.embedUnitary U2).1 * (rT.embedUnitary U1).1 := by
    rw [QRegister.embedUnitary_mul, QRegister.embedUnitary_mul]
    try rfl
  apply ket_of_clean_mul rAnc _ _ _ β h0
  rw [mul_assoc C3 C2 C1, hE,
    mul_assoc (rT.embedUnitary U3).1 (rT.embedUnitary U2).1 (rT.embedUnitary U1).1]
  exact key

theorem inv_ket {m k : ℕ} (rAnc : QRegister k m) (C Ci A : Unitary (2 ^ m))
    (hC : ∀ β, localIdx rAnc β = 0 → C.1 *ᵥ ket β = A.1 *ᵥ ket β)
    (hcom : (star A).1 * rAnc.basisOutcomeProjector 0 = rAnc.basisOutcomeProjector 0 * (star A).1)
    (hCi : Ci.1 * C.1 = 1) (β : BitAssignment m) (h0 : localIdx rAnc β = 0) :
    Ci.1 *ᵥ ket β = (star A).1 *ᵥ ket β := by
  have hCQ := QC14.clean_ext rAnc _ _ hC
  have hAu : A.1 * (star A).1 = 1 := by
    have : A * star A = 1 := by rw [Unitary.star_eq_inv, mul_inv_cancel A]
    exact congrArg Subtype.val this
  have hInv : Ci.1 * rAnc.basisOutcomeProjector 0 = (star A).1 * rAnc.basisOutcomeProjector 0 :=
    QC14.inv_clean hCQ hcom.symm hAu hCi
  exact ket_of_clean_mul rAnc _ _ hInv β h0

/-- `prepC`, `H_o`, `CSWAP(o; A, B)`. -/
noncomputable def pairPrepC {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (bP N M + gP N M aleph + 1) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    Circuit n :=
  .seq (prepC (fP thc D aleph) rData rAnc hd)
    (.seq ((Circuit.H (⟨idxC N M, by pairw⟩ : Wire (bP N M + gP N M aleph))).onRegister
        (rData.slice (2 * N) (bP N M + gP N M aleph) le_rfl))
      ((cswapLoc N M (bIC N M) le_rfl).onRegister (cswReg rData rAnc hd)))

/-- On kets with clean scratch, the pair PREPARE circuit is the embedded `pairPrepU`. -/
theorem pairPrepC_ket {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (bP N M + gP N M aleph + 1) n) (hd : ∀ i j, rData i ≠ rAnc j)
    (β : BitAssignment n) (h0 : localIdx rAnc β = 0) :
    (pairPrepC thc D aleph rData rAnc hd).eval.1 *ᵥ ket β =
      (rData.embedUnitary ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
        (pairPrepU thc D aleph))).1 *ᵥ ket β := by
  have hdD : rData.DisjointWires rAnc := QRegister.disjoint_iff.2 hd
  have e : (blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (pairPrepU thc D aleph) =
      (blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
          (permutationUnitary (cswapPerm N M (gP N M aleph))) *
        (blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (hO N M (gP N M aleph)) *
        (blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
          (prepU (bP N M) (gP N M aleph) (fP thc D aleph)) := by
    unfold pairPrepU
    rw [QRegister.embedUnitary_mul, QRegister.embedUnitary_mul]
  have hC2 : ((Circuit.H (⟨idxC N M, by pairw⟩ : Wire (bP N M + gP N M aleph))).onRegister
      (rData.slice (2 * N) (bP N M + gP N M aleph) le_rfl)).eval =
      rData.embedUnitary ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
        (hO N M (gP N M aleph))) := by
    rw [Circuit.eval_onRegister]
    show (rData.compose (blkA (2 * N) (bP N M) (gP N M aleph))).embedUnitary
      (hO N M (gP N M aleph)) = _
    rw [QRegister.embedUnitary_compose]
  rw [e]
  have := chain3_ket rData rAnc hdD
    (prepC (fP thc D aleph) rData rAnc hd).eval.1
    ((Circuit.H (⟨idxC N M, by pairw⟩ : Wire (bP N M + gP N M aleph))).onRegister
      (rData.slice (2 * N) (bP N M + gP N M aleph) le_rfl)).eval.1
    ((cswapLoc N M (bIC N M) le_rfl).onRegister (cswReg rData rAnc hd)).eval.1
    ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
      (prepU (bP N M) (gP N M aleph) (fP thc D aleph)))
    ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (hO N M (gP N M aleph)))
    ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
      (permutationUnitary (cswapPerm N M (gP N M aleph))))
    (fun β h0 ↦ prepC_ket (fP thc D aleph) rData rAnc hd β h0)
    (fun β _ ↦ congrArg (fun U : Unitary (2 ^ n) ↦ U.1 *ᵥ ket β) hC2)
    (fun β h0 ↦ by
      have := cswap_clean rData rAnc hd β h0
      rwa [QRegister.embedUnitary_compose] at this)
    β h0
  unfold pairPrepC
  rw [Circuit.eval_seq, Circuit.eval_seq]
  exact this

theorem pairPrepCinv_ket {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (bP N M + gP N M aleph + 1) n) (hd : ∀ i j, rData i ≠ rAnc j)
    (β : BitAssignment n) (h0 : localIdx rAnc β = 0) :
    (pairPrepC thc D aleph rData rAnc hd).inverse.eval.1 *ᵥ ket β =
      (rData.embedUnitary (star ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
        (pairPrepU thc D aleph)))).1 *ᵥ ket β := by
  have hdD : rData.DisjointWires rAnc := QRegister.disjoint_iff.2 hd
  rw [QC14.embedUnitary_star']
  refine inv_ket rAnc (pairPrepC thc D aleph rData rAnc hd).eval
    (pairPrepC thc D aleph rData rAnc hd).inverse.eval _
    (fun β h0 ↦ pairPrepC_ket thc D aleph rData rAnc hd β h0) ?_ ?_ β h0
  · rw [← QC14.embedUnitary_star']
    exact (CleanSubroutineBridge.embed_comm_proj rData rAnc hdD _).symm
  · rw [Circuit.eval_inverse]
    exact congrArg Subtype.val (inv_mul_cancel (pairPrepC thc D aleph rData rAnc hd).eval)

theorem pairPrepC_count {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (bP N M + gP N M aleph + 1) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    (pairPrepC thc D aleph rData rAnc hd).count PrimitiveGate.TOFF = 0 ∧
      (pairPrepC thc D aleph rData rAnc hd).count PrimitiveGate.T ≤
        8 * gP N M aleph * 2 ^ gP N M aleph + 8 * bIC N M := by
  have hp : (prepC (fP thc D aleph) rData rAnc hd).count PrimitiveGate.TOFF = 0 ∧
      (prepC (fP thc D aleph) rData rAnc hd).count PrimitiveGate.T ≤
        8 * gP N M aleph * 2 ^ gP N M aleph :=
    count_prog (bP N M) (gP N M aleph) (tblOf (bP N M) (gP N M aleph) (fP thc D aleph))
      (rData.slice (2 * N) (bP N M + gP N M aleph) le_rfl)
      (rAnc.slice 0 (gP N M aleph + 1) (by omega)) (fun i j ↦ hd _ _)
  obtain ⟨hc1, hc2⟩ := cswapLoc_count N M (bIC N M) le_rfl
  have hH1 : (Circuit.H (⟨idxC N M, by pairw⟩ : Wire (bP N M + gP N M aleph))).count
      PrimitiveGate.TOFF = 0 := by simp
  have hH2 : (Circuit.H (⟨idxC N M, by pairw⟩ : Wire (bP N M + gP N M aleph))).count
      PrimitiveGate.T = 0 := by simp
  simp only [pairPrepC, Circuit.count_seq, Circuit.count_onRegister]
  omega

/-! ## The pair SELECT program -/

/-- `selectL` on system ++ `A`, `SWAP(A, B) X_o`, `selectL`, `Z_z`. -/
noncomputable def pairSelProgram {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ} (D : CData N M)
    (rSI : QRegister (2 * N + bP N M) n) (rA : QRegister (bIC N M + 1) n)
    (rK : QRegister (2 * beth) n) (rCat : QRegister beth n) (hTA : ∀ i j, rSI i ≠ rA j)
    (hcT : rCat.DisjointWires rSI) : DynamicCircuit Var n :=
  .seq (selectL v beth (kAll D) (fun _ ↦ false) (rSI.compose (regSA N M)) rA rK rCat
      (fun i j ↦ hTA _ _) (hcT.compose_right _))
    (.seq (.circuit ((swapXLoc N M).onRegister (rSI.compose (idxReg N (bP N M)))))
      (.seq (selectL v beth (kAll D) (fun _ ↦ false) (rSI.compose (regSA N M)) rA rK rCat
          (fun i j ↦ hTA _ _) (hcT.compose_right _))
        (.circuit ((zLoc N M).onRegister (rSI.compose (idxReg N (bP N M)))))))

theorem pairSel_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    {N M : ℕ} [NeZero N] (D : CData N M) (rSI : QRegister (2 * N + bP N M) n)
    (rA : QRegister (bIC N M + 1) n) (rK : QRegister (2 * beth) n) (rCat : QRegister beth n)
    (hTA : ∀ i j, rSI i ≠ rA j) (hcT : rCat.DisjointWires rSI) (hAK : rA.DisjointWires rK)
    (hsc : (rA.concat rK hAK).DisjointWires rCat)
    (hdisj : rSI.DisjointWires ((rA.concat rK hAK).concat rCat hsc)) :
    ∃ S : Unitary (2 ^ (2 * N + bP N M)),
      S.1 = pairSelOp D beth ∧
      CatKet rSI (rA.concat rK hAK) rCat hsc
        (pairSelProgram v beth D rSI rA rK rCat hTA hcT).compile S := by
  have h2L : 2 * (N + M) ≤ 2 ^ bIC N M := by have := rows_le_bIC N M; omega
  obtain ⟨U, hUval, hSel⟩ := selectL_catKet v beth (kAll D) (fun _ ↦ false) h2L
    (rSI.compose (regSA N M)) rA rK rCat (fun i j ↦ hTA _ _) (hcT.compose_right _) hAK hsc
    (hdisj.compose_left _)
  have hS1 := CatKet.compose (outer := rSI) (regSA N M) hSel
  have hX := CatKet.compose (outer := rSI) (idxReg N (bP N M))
    (CatKet.circuit (Var := Var) (rSI.compose (idxReg N (bP N M))) (rA.concat rK hAK) rCat hsc
      (swapXLoc N M))
  have hZ := CatKet.compose (outer := rSI) (idxReg N (bP N M))
    (CatKet.circuit (Var := Var) (rSI.compose (idxReg N (bP N M))) (rA.concat rK hAK) rCat hsc
      (zLoc N M))
  have h := CatKet.seq hdisj hS1 (CatKet.seq hdisj hX (CatKet.seq hdisj hS1 hZ))
  refine ⟨(idxReg N (bP N M)).embedUnitary (zLoc N M).eval * (regSA N M).embedUnitary U *
    (idxReg N (bP N M)).embedUnitary (swapXLoc N M).eval * (regSA N M).embedUnitary U, ?_, ?_⟩
  · rw [pairSelOp_factor]
    change ((idxReg N (bP N M)).embedUnitary (zLoc N M).eval).1 *
      ((regSA N M).embedUnitary U).1 * ((idxReg N (bP N M)).embedUnitary (swapXLoc N M).eval).1 *
      ((regSA N M).embedUnitary U).1 = _
    simp only [QRegister.embedUnitary_val]
    rw [swapXLoc_eval, zLoc_eval, hUval]
    simp only [selA]
  · simp only [pairSelProgram, DynamicCircuit.compile_seq, DynamicCircuit.compile_circuit]
    exact h

theorem pairSel_count {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ} [NeZero N] (D : CData N M)
    (rSI : QRegister (2 * N + bP N M) n) (rA : QRegister (bIC N M + 1) n)
    (rK : QRegister (2 * beth) n) (rCat : QRegister beth n) (hTA : ∀ i j, rSI i ≠ rA j)
    (hcT : rCat.DisjointWires rSI) :
    (pairSelProgram v beth D rSI rA rK rCat hTA hcT).count PrimitiveGate.TOFF = 0 ∧
      (pairSelProgram v beth D rSI rA rK rCat hTA hcT).count PrimitiveGate.T ≤
        2 * (2 * (N + M) * (16 * (N - 1) * (beth - 1) + 8 * bIC N M)) := by
  have hs := selectL_count v beth (kAll D) (fun _ ↦ false) (rSI.compose (regSA N M)) rA rK rCat
    (fun i j ↦ hTA _ _) (hcT.compose_right _)
  obtain ⟨hx1, hx2⟩ := swapXLoc_count N M
  obtain ⟨hz1, hz2⟩ := zLoc_count N M
  simp only [pairSelProgram, DynamicCircuit.count, Circuit.count_onRegister]
  omega

/-! ## The whole program -/

theorem concat_sub2 {a c beth : ℕ} (rAnc : QRegister a n)
    (rK : QRegister (2 * beth) n) (hb : 0 + c ≤ a) (hAK : rAnc.DisjointWires rK)
    (hAK' : (rAnc.slice 0 c hb).DisjointWires rK) (i : Fin (c + 2 * beth)) :
    ∃ i' : Fin (a + 2 * beth),
      ((rAnc.slice 0 c hb).concat rK hAK') i = (rAnc.concat rK hAK) i' := by
  induction i using Fin.addCases with
  | left i2 =>
    refine ⟨Fin.castAdd (2 * beth) ⟨i2.val, by omega⟩, ?_⟩
    simp only [QRegister.concat_apply_left]
    first
      | done
      | (simp [QRegister.slice_apply]; done)
      | (rw [QRegister.slice_apply]; congr 1; exact Fin.ext (Nat.zero_add _))
  | right i2 =>
    refine ⟨Fin.natAdd a i2, ?_⟩
    simp only [QRegister.concat_apply_right]

theorem concat_sub3 {a c beth : ℕ} (rAnc : QRegister a n)
    (rK : QRegister (2 * beth) n) (rCat : QRegister beth n) (hb : 0 + c ≤ a)
    (hAK : rAnc.DisjointWires rK) (hAK' : (rAnc.slice 0 c hb).DisjointWires rK)
    (hsc : (rAnc.concat rK hAK).DisjointWires rCat)
    (hsc' : ((rAnc.slice 0 c hb).concat rK hAK').DisjointWires rCat)
    (i : Fin (c + 2 * beth + beth)) :
    ∃ i' : Fin (a + 2 * beth + beth),
      (((rAnc.slice 0 c hb).concat rK hAK').concat rCat hsc') i =
        ((rAnc.concat rK hAK).concat rCat hsc) i' := by
  induction i using Fin.addCases with
  | left i1 =>
    obtain ⟨i1', h⟩ := concat_sub2 rAnc rK hb hAK hAK' i1
    exact ⟨Fin.castAdd beth i1', by simp only [QRegister.concat_apply_left]; exact h⟩
  | right i1 =>
    exact ⟨Fin.natAdd (a + 2 * beth) i1, by simp only [QRegister.concat_apply_right]⟩


/-- `PREPARE; SELECT; PREPARE†`; SELECT uses the first `bIC + 1` scratch wires as its chain. -/
noncomputable def pairProgram {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ}
    (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (bP N M + gP N M aleph + 1) n) (rK : QRegister (2 * beth) n)
    (rCat : QRegister beth n) (hd : ∀ i j, rData i ≠ rAnc j) (hcD : rCat.DisjointWires rData) :
    DynamicCircuit Var n :=
  .seq (.circuit (pairPrepC thc D aleph rData rAnc hd))
    (.seq (pairSelProgram v beth D (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
        (rAnc.slice 0 (bIC N M + 1) (by pairw)) rK rCat (fun i j ↦ hd _ _)
        (hcD.compose_right _))
      (.circuit (pairPrepC thc D aleph rData rAnc hd).inverse))

theorem pair_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    {N M : ℕ} [NeZero N] (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (bP N M + gP N M aleph + 1) n) (rK : QRegister (2 * beth) n)
    (rCat : QRegister beth n) (hd : ∀ i j, rData i ≠ rAnc j) (hcD : rCat.DisjointWires rData)
    (hAK : rAnc.DisjointWires rK) (hsc : (rAnc.concat rK hAK).DisjointWires rCat)
    (hdisj : rData.DisjointWires ((rAnc.concat rK hAK).concat rCat hsc)) :
    ∃ S : Unitary (2 ^ (2 * N + bP N M)),
      S.1 = pairSelOp D beth ∧
      CatKet rData (rAnc.concat rK hAK) rCat hsc
        (pairProgram v beth thc D aleph rData rAnc rK rCat hd hcD).compile
        (lcuQ N (bP N M) (gP N M aleph) (pairPrepU thc D aleph) S) := by
  have hb : 0 + (bIC N M + 1) ≤ bP N M + gP N M aleph + 1 := by
    have h2 : bP N M = 2 * bIC N M + 2 := rfl
    omega
  have hAK' : (rAnc.slice 0 (bIC N M + 1) hb).DisjointWires rK := hAK.compose_left _
  have hsc' : ((rAnc.slice 0 (bIC N M + 1) hb).concat rK hAK').DisjointWires rCat := by
    rw [QRegister.disjoint_iff]
    intro i j h
    obtain ⟨i', hi'⟩ := concat_sub2 rAnc rK hb hAK hAK' i
    exact (QRegister.disjoint_iff.1 hsc i' j) (hi'.symm.trans h)
  have hdisj' : (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph))).DisjointWires
      (((rAnc.slice 0 (bIC N M + 1) hb).concat rK hAK').concat rCat hsc') := by
    rw [QRegister.disjoint_iff]
    intro i j h
    obtain ⟨j', hj'⟩ := concat_sub3 rAnc rK rCat hb hAK hAK' hsc hsc' j
    exact (QRegister.disjoint_iff.1 hdisj (blkS (2 * N) (bP N M) (gP N M aleph) i) j')
      (h.trans hj')
  obtain ⟨S, hSval, hSel⟩ := pairSel_catKet v beth D
    (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
    (rAnc.slice 0 (bIC N M + 1) hb) rK rCat (fun i j ↦ hd _ _) (hcD.compose_right _) hAK' hsc'
    hdisj'
  have hSel2 := CatKet.compose (blkS (2 * N) (bP N M) (gP N M aleph)) hSel
  have hsub : ∀ β : BitAssignment n,
      localIdx ((rAnc.concat rK hAK).concat rCat hsc) β = 0 →
      localIdx (((rAnc.slice 0 (bIC N M + 1) hb).concat rK hAK').concat rCat hsc') β = 0 := by
    intro β h0
    apply localIdx_eq_zero_of_forall
    intro i
    obtain ⟨i', hi'⟩ := concat_sub3 rAnc rK rCat hb hAK hAK' hsc hsc' i
    rw [hi']
    exact eq_zero_of_localIdx_eq_zero _ β h0 i'
  have hSel3 := catKet_mono_scratch hsub hSel2
  have hPrep := catKet_circuit_ket (Var := Var) rData (rAnc.concat rK hAK) rCat hsc
    (pairPrepC thc D aleph rData rAnc hd)
    ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (pairPrepU thc D aleph))
    (fun β h0 ↦ pairPrepC_ket thc D aleph rData rAnc hd β
      (localIdx_concat_zero rAnc rK hAK β h0).1)
  have hInvK := catKet_circuit_ket (Var := Var) rData (rAnc.concat rK hAK) rCat hsc
    (pairPrepC thc D aleph rData rAnc hd).inverse
    (star ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (pairPrepU thc D aleph)))
    (fun β h0 ↦ pairPrepCinv_ket thc D aleph rData rAnc hd β
      (localIdx_concat_zero rAnc rK hAK β h0).1)
  refine ⟨S, hSval, ?_⟩
  unfold lcuQ
  simp only [pairProgram, DynamicCircuit.compile_seq]
  exact CatKet.seq hdisj hPrep (CatKet.seq hdisj hSel3 hInvK)

theorem pair_count {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ} [NeZero N]
    (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (bP N M + gP N M aleph + 1) n) (rK : QRegister (2 * beth) n)
    (rCat : QRegister beth n) (hd : ∀ i j, rData i ≠ rAnc j) (hcD : rCat.DisjointWires rData) :
    (pairProgram v beth thc D aleph rData rAnc rK rCat hd hcD).count PrimitiveGate.TOFF = 0 ∧
      (pairProgram v beth thc D aleph rData rAnc rK rCat hd hcD).count PrimitiveGate.T ≤
        2 * (8 * gP N M aleph * 2 ^ gP N M aleph + 8 * bIC N M) +
          2 * (2 * (N + M) * (16 * (N - 1) * (beth - 1) + 8 * bIC N M)) := by
  have hp := pairPrepC_count thc D aleph rData rAnc hd
  have hs := pairSel_count v beth D (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
    (rAnc.slice 0 (bIC N M + 1) (by pairw)) rK rCat (fun i j ↦ hd _ _) (hcD.compose_right _)
  have hiT : ∀ c : Circuit n, c.inverse.count PrimitiveGate.T = c.count PrimitiveGate.T :=
    fun c ↦ Circuit.count_inverse_of_ne _ (by simp) (by simp) c
  have hiO : ∀ c : Circuit n, c.inverse.count PrimitiveGate.TOFF = c.count PrimitiveGate.TOFF :=
    fun c ↦ Circuit.count_inverse_of_ne _ (by simp) (by simp) c
  simp only [pairProgram, DynamicCircuit.count, hiT, hiO]
  omega

end QC14.PairProgram


/-! Inlined from lane module `THC/UnaryLookup.lean`. -/

namespace QC14.UnaryLookup
open QuantumComputation QuantumComputation.Specs Matrix
open QuantumComputation.Specs.ArcsinImpl
open QuantumComputation.Specs.SelectPauliImpl (Wires bitsZ)

variable {n : ℕ}

/-- The table word `a` placed on the target wires of `W`. -/
noncomputable def tabAdd {s N' : ℕ} (W : Wires s N' n) (a : Fin N' → ZMod 2) : BitAssignment n :=
  ∑ q : Fin N', Pi.single (W.sw q) (a q)

/-- The table word `a` placed on the target wires `sw`. -/
noncomputable def ulTab {N' : ℕ} (sw : Fin N' → Wire n) (a : Fin N' → ZMod 2) : BitAssignment n :=
  ∑ q : Fin N', Pi.single (sw q) (a q)

theorem ulTab_apply_of_ne {N' : ℕ} (sw : Fin N' → Wire n) (a : Fin N' → ZMod 2) (y : Wire n)
    (h : ∀ q, y ≠ sw q) : ulTab sw a y = 0 := by
  unfold ulTab
  rw [Finset.sum_apply]
  exact Finset.sum_eq_zero fun q _ ↦ by simp [Pi.single_apply, h q]

theorem ulTab_eq_list {N' : ℕ} (sw : Fin N' → Wire n) (a : Fin N' → ZMod 2) :
    ulTab sw a = ((List.finRange N').map fun q ↦ Pi.single (sw q) (a q)).sum := by
  unfold ulTab
  exact Fin.sum_univ_def _

/-- Support of a bit-assignment delta inside the target wires. -/
def UlSupp {N' : ℕ} (sw : Fin N' → Wire n) (δ : BitAssignment n) : Prop :=
  ∀ y, (∀ q, y ≠ sw q) → δ y = 0

theorem UlSupp.smul {N' : ℕ} {sw : Fin N' → Wire n} {δ : BitAssignment n} (a : ZMod 2)
    (h : UlSupp sw δ) : UlSupp sw (a • δ) := fun y hy ↦ by simp [h y hy]

theorem UlSupp.add {N' : ℕ} {sw : Fin N' → Wire n} {δ₁ δ₂ : BitAssignment n}
    (h₁ : UlSupp sw δ₁) (h₂ : UlSupp sw δ₂) : UlSupp sw (δ₁ + δ₂) :=
  fun y hy ↦ by simp [h₁ y hy, h₂ y hy]

theorem ulSupp_tab {N' : ℕ} (sw : Fin N' → Wire n) (a : Fin N' → ZMod 2) :
    UlSupp sw (ulTab sw a) := fun y hy ↦ ulTab_apply_of_ne sw a y hy

/-- Value of the optional control (`1` when absent). -/
def ulCv : Option (Wire n) → BitAssignment n → ZMod 2
  | none, _ => 1
  | some c, β => β c

theorem ulCv_add (c : Option (Wire n)) (β δ : BitAssignment n)
    (h : ∀ c', c = some c' → δ c' = 0) : ulCv c (β + δ) = ulCv c β := by
  cases c with
  | none => rfl
  | some c' => simp [ulCv, h c' rfl]

theorem ulCv_update (c : Option (Wire n)) (β : BitAssignment n) (t : Wire n) (v : ZMod 2)
    (h : ∀ c', c = some c' → c' ≠ t) : ulCv c (Function.update β t v) = ulCv c β := by
  cases c with
  | none => rfl
  | some c' => simp [ulCv, Function.update_of_ne (h c' rfl)]

theorem ulUpd_add (β δ : BitAssignment n) (t : Wire n) (v : ZMod 2) (h : δ t = 0) :
    Function.update (β + δ) t v = Function.update β t v + δ := by
  ext y
  by_cases hy : y = t
  · subst hy; simp [h]
  · simp [Function.update_of_ne hy]

theorem ulUpd_single (β : BitAssignment n) (t : Wire n) (k : ZMod 2) :
    Function.update β t (β t + k) = β + Pi.single t k := by
  ext y
  by_cases hy : y = t
  · subst hy; simp
  · simp [Function.update_of_ne hy, Pi.single_apply, hy]

theorem ul_smul_single (v a : ZMod 2) (t : Wire n) :
    v • (Pi.single t a : BitAssignment n) = Pi.single t (v * a) := by
  ext y
  by_cases hy : y = t
  · subst hy; simp
  · simp [Pi.single_apply, hy]

theorem ul_add_one_one (b : ZMod 2) : b + 1 + 1 = b := by revert b; decide

theorem ulId_ket (β : BitAssignment n) :
    (Circuit.identity : Circuit n).eval.1 *ᵥ ket β = ket β := by
  rw [Circuit.eval_identity]; exact Matrix.one_mulVec _

theorem ul_inv_ket (c : Circuit n) (β β' : BitAssignment n)
    (h : c.eval.1 *ᵥ ket β = ket β') : c.inverse.eval.1 *ᵥ ket β' = ket β := by
  have hinv : c.inverse.eval.1 * c.eval.1 = 1 := by
    rw [Circuit.eval_inverse]
    exact congrArg Subtype.val (inv_mul_cancel c.eval)
  rw [← h, Matrix.mulVec_mulVec, hinv, Matrix.one_mulVec]

theorem ulAnd_inv_ket {k : ℕ} (c₁ c₂ t : Wire k) (h₁₂ : c₁ ≠ c₂) (h₁t : c₁ ≠ t)
    (h₂t : c₂ ≠ t) (β : BitAssignment k) (ht : β t = β c₁ * β c₂) :
    (AND4T c₁ c₂ t h₁₂ h₁t h₂t).inverse.eval.1 *ᵥ ket β = ket (Function.update β t 0) := by
  have h := ket_AND4T_eq_smul c₁ c₂ t h₁₂ h₁t h₂t (Function.update β t 0)
  rw [Function.update_of_ne h₁t, Function.update_of_ne h₂t, Function.update_self,
    Function.update_idem, zero_add, ← ht, Function.update_eq_self] at h
  have h1 : cleanAndPhase (β c₁) (β c₂) 0 = 1 := by simp [cleanAndPhase]
  rw [h1, one_smul] at h
  exact ul_inv_ket _ _ _ h

theorem ulE_cond (c : Option (Wire n)) (β δ : BitAssignment n) (x₀ w : Wire n) (hxw : x₀ ≠ w)
    (hδw : δ w = 0) (hδx : δ x₀ = 0) (hδc : ∀ c', c = some c' → δ c' = 0)
    (hcw : ∀ c', c = some c' → c' ≠ w) :
    (Function.update β w (ulCv c β * β x₀) + δ) w =
      ulCv c (Function.update β w (ulCv c β * β x₀) + δ) *
        (Function.update β w (ulCv c β * β x₀) + δ) x₀ := by
  rw [ulCv_add c _ _ hδc, ulCv_update c β _ _ hcw, Pi.add_apply, Pi.add_apply,
    Function.update_self, hδw, Function.update_of_ne hxw, hδx]
  simp

/-! ### Leaf: XOR the table word into the targets -/

/-- `sw q ⊕= c ∧ a` (as a gate: nothing for `a = 0`, `X` without control, `CNOT` with). -/
def ulXor {N' : ℕ} (c : Option (Wire n)) (sw : Fin N' → Wire n) (q : Fin N') (a : ZMod 2) :
    Circuit n :=
  if a = 0 then Circuit.identity else
  match c with
  | none => Circuit.X (sw q)
  | some c => if h : c ≠ sw q then Circuit.CNOT c (sw q) h else Circuit.identity

theorem ulXor_ket {N' : ℕ} (c : Option (Wire n)) (sw : Fin N' → Wire n) (q : Fin N') (a : ZMod 2)
    (hc : ∀ c', c = some c' → c' ≠ sw q) (β : BitAssignment n) :
    (ulXor c sw q a).eval.1 *ᵥ ket β = ket (β + ulCv c β • Pi.single (sw q) a) := by
  by_cases ha : a = 0
  · subst ha
    have e : ulXor c sw q 0 = Circuit.identity := by simp [ulXor]
    rw [e, ulId_ket]; simp
  · have ha1 : a = 1 := (bit_cases a).resolve_left ha
    subst ha1
    cases c with
    | none =>
      rw [ulXor, if_neg ha]
      rw [ket_X, ulUpd_single]
      simp [ulCv]
    | some c' =>
      have h := hc c' rfl
      rw [ulXor, if_neg ha]
      rw [dif_pos h, ket_CNOT, ulUpd_single, ul_smul_single]
      simp [ulCv]

def ulLeaf {N' : ℕ} (c : Option (Wire n)) (sw : Fin N' → Wire n) (T : Fin N' → ZMod 2) :
    List (Fin N') → Circuit n
  | [] => Circuit.identity
  | q :: l => (ulXor c sw q (T q)).seq (ulLeaf c sw T l)

theorem ulLeaf_ket {N' : ℕ} (c : Option (Wire n)) (sw : Fin N' → Wire n) (T : Fin N' → ZMod 2)
    (hc : ∀ q c', c = some c' → c' ≠ sw q) (l : List (Fin N')) (β : BitAssignment n) :
    (ulLeaf c sw T l).eval.1 *ᵥ ket β =
      ket (β + ulCv c β • (l.map fun q ↦ (Pi.single (sw q) (T q) : BitAssignment n)).sum) := by
  induction l generalizing β with
  | nil => rw [ulLeaf, ulId_ket]; simp
  | cons q l ih =>
    have hv := ulCv_add c β (ulCv c β • Pi.single (sw q) (T q)) (fun c' h ↦ by
      simp [Pi.single_apply, hc q c' h])
    rw [ulLeaf, eval_seq_mulVec, ulXor_ket c sw q _ (hc q) β, ih, hv]
    simp [smul_add, add_assoc]

theorem ulLeaf_count {N' : ℕ} (c : Option (Wire n)) (sw : Fin N' → Wire n) (T : Fin N' → ZMod 2)
    (l : List (Fin N')) :
    (ulLeaf c sw T l).count PrimitiveGate.TOFF = 0 ∧ (ulLeaf c sw T l).count PrimitiveGate.T = 0 := by
  induction l with
  | nil => simp [ulLeaf, Circuit.count_identity]
  | cons q l ih =>
    have h : (ulXor c sw q (T q)).count PrimitiveGate.TOFF = 0 ∧
        (ulXor c sw q (T q)).count PrimitiveGate.T = 0 := by
      unfold ulXor
      split_ifs with h1
      · simp [Circuit.count_identity]
      · cases c with
        | none => exact ⟨rfl, rfl⟩
        | some c' =>
          dsimp only
          split_ifs
          · exact ⟨rfl, rfl⟩
          · simp [Circuit.count_identity]
    simp only [ulLeaf, Circuit.count_seq]
    exact ⟨by omega, by omega⟩

/-! ### The three gate blocks of one level -/

/-- `w ⊕= c ∧ ¬x₀`, with `x₀` restored. -/
def ulCompute (c : Option (Wire n)) (x₀ w : Wire n) : Circuit n :=
  match c with
  | none =>
    if h : x₀ ≠ w then (Circuit.X x₀).seq ((Circuit.CNOT x₀ w h).seq (Circuit.X x₀))
    else Circuit.identity
  | some c =>
    if h : c ≠ x₀ ∧ c ≠ w ∧ x₀ ≠ w then
      (Circuit.X x₀).seq ((AND4T c x₀ w h.1 h.2.1 h.2.2).seq (Circuit.X x₀))
    else Circuit.identity

theorem ulCompute_ket (c : Option (Wire n)) (x₀ w : Wire n) (hxw : x₀ ≠ w)
    (hc : ∀ c', c = some c' → c' ≠ x₀ ∧ c' ≠ w) (β : BitAssignment n) (hw : β w = 0) :
    (ulCompute c x₀ w).eval.1 *ᵥ ket β =
      ket (Function.update β w (ulCv c β * (β x₀ + 1))) := by
  cases c with
  | none =>
    rw [ulCompute]
    rw [dif_pos hxw, eval_seq_mulVec, eval_seq_mulVec, ket_X, ket_CNOT, ket_X]
    congr 1
    ext y
    by_cases h1 : y = x₀
    · subst h1
      simp [Function.update_apply, hxw, hxw.symm, hw, ulCv, ul_add_one_one]
    · by_cases h2 : y = w
      · subst h2
        simp [Function.update_apply, h1, hxw, hxw.symm, hw, ulCv]
      · simp [Function.update_apply, h1, h2]
  | some c' =>
    obtain ⟨h1, h2⟩ := hc c' rfl
    rw [ulCompute]
    rw [dif_pos ⟨h1, h2, hxw⟩, eval_seq_mulVec, eval_seq_mulVec, ket_X, ket_AND4T_eq_smul]
    have hw' : (Function.update β x₀ (β x₀ + 1)) w = 0 := by
      rw [Function.update_of_ne hxw.symm]; exact hw
    have hph : ∀ a b : ZMod 2, cleanAndPhase a b 0 = 1 := fun a b ↦ by simp [cleanAndPhase]
    rw [hw', hph, one_smul, ket_X]
    congr 1
    ext y
    by_cases h3 : y = x₀
    · subst h3
      simp [Function.update_apply, hxw, hxw.symm, h1, ul_add_one_one, ulCv]
    · by_cases h4 : y = w
      · subst h4
        simp [Function.update_apply, h3, hxw, hxw.symm, h1, h2, ulCv]
      · simp [Function.update_apply, h3, h4]

theorem ulCompute_count (c : Option (Wire n)) (x₀ w : Wire n) :
    (ulCompute c x₀ w).count PrimitiveGate.TOFF = 0 ∧ (ulCompute c x₀ w).count PrimitiveGate.T ≤ 4 := by
  cases c with
  | none =>
    unfold ulCompute
    dsimp only
    split_ifs
    · exact ⟨rfl, by refine le_trans (le_of_eq ?_) (Nat.zero_le 4); rfl⟩
    · simp [Circuit.count_identity]
  | some c' =>
    unfold ulCompute
    dsimp only
    split_ifs with h
    · simp only [Circuit.count_seq]
      exact ⟨by simp [count_TOFF_AND4T], by simp [count_T_AND4T]⟩
    · simp [Circuit.count_identity]

/-- `w ⊕= c`. -/
def ulFlip (c : Option (Wire n)) (w : Wire n) : Circuit n :=
  match c with
  | none => Circuit.X w
  | some c => if h : c ≠ w then Circuit.CNOT c w h else Circuit.identity

theorem ulFlip_ket (c : Option (Wire n)) (w : Wire n) (hc : ∀ c', c = some c' → c' ≠ w)
    (β : BitAssignment n) :
    (ulFlip c w).eval.1 *ᵥ ket β = ket (Function.update β w (β w + ulCv c β)) := by
  cases c with
  | none => rw [ulFlip]; rw [ket_X]; simp [ulCv]
  | some c' =>
    rw [ulFlip]; rw [dif_pos (hc c' rfl), ket_CNOT]; simp [ulCv]

theorem ulFlip_count (c : Option (Wire n)) (w : Wire n) :
    (ulFlip c w).count PrimitiveGate.TOFF = 0 ∧ (ulFlip c w).count PrimitiveGate.T = 0 := by
  cases c with
  | none => exact ⟨rfl, rfl⟩
  | some c' =>
    unfold ulFlip
    dsimp only
    split_ifs
    · exact ⟨rfl, rfl⟩
    · simp [Circuit.count_identity]

/-- `w ⊕= c ∧ x₀`, valid when `w = c ∧ x₀` already (uncompute). -/
def ulUncompute (c : Option (Wire n)) (x₀ w : Wire n) : Circuit n :=
  match c with
  | none => if h : x₀ ≠ w then Circuit.CNOT x₀ w h else Circuit.identity
  | some c =>
    if h : c ≠ x₀ ∧ c ≠ w ∧ x₀ ≠ w then (AND4T c x₀ w h.1 h.2.1 h.2.2).inverse
    else Circuit.identity

theorem ulUncompute_ket (c : Option (Wire n)) (x₀ w : Wire n) (hxw : x₀ ≠ w)
    (hc : ∀ c', c = some c' → c' ≠ x₀ ∧ c' ≠ w) (β : BitAssignment n)
    (h : β w = ulCv c β * β x₀) :
    (ulUncompute c x₀ w).eval.1 *ᵥ ket β = ket (Function.update β w 0) := by
  cases c with
  | none =>
    rw [ulUncompute]
    rw [dif_pos hxw, ket_CNOT]
    have hh : ∀ b : ZMod 2, b + b = 0 := by decide
    have : β w + β x₀ = 0 := by rw [h]; simp only [ulCv, one_mul]; exact hh _
    rw [this]
  | some c' =>
    obtain ⟨h1, h2⟩ := hc c' rfl
    rw [ulUncompute]
    rw [dif_pos ⟨h1, h2, hxw⟩]
    exact ulAnd_inv_ket c' x₀ w h1 h2 hxw β h

theorem ulUncompute_count (c : Option (Wire n)) (x₀ w : Wire n) :
    (ulUncompute c x₀ w).count PrimitiveGate.TOFF = 0 ∧
      (ulUncompute c x₀ w).count PrimitiveGate.T ≤ 4 := by
  cases c with
  | none =>
    unfold ulUncompute
    dsimp only
    split_ifs
    · exact ⟨rfl, by refine le_trans (le_of_eq ?_) (Nat.zero_le 4); rfl⟩
    · simp [Circuit.count_identity]
  | some c' =>
    unfold ulUncompute
    dsimp only
    split_ifs with h
    · have hT : (AND4T c' x₀ w h.1 h.2.1 h.2.2).inverse.count PrimitiveGate.T = 4 := by
        rw [Circuit.count_inverse_of_ne _ (by simp) (by simp)]
        exact count_T_AND4T _ _ _ _ _ _
      have hO : (AND4T c' x₀ w h.1 h.2.1 h.2.2).inverse.count PrimitiveGate.TOFF = 0 := by
        rw [Circuit.count_inverse_of_ne _ (by simp) (by simp)]
        exact count_TOFF_AND4T _ _ _ _ _ _
      exact ⟨hO, hT.le⟩
    · simp [Circuit.count_identity]

/-! ### The recursion -/

/-- Unary iteration over the `m` address wires `xs` (least significant first) with work wires `ws`,
optional control `c`, targets `sw`, and table `T : ℕ → Fin N' → ZMod 2`. -/
def ulk {N' : ℕ} (sw : Fin N' → Wire n) :
    (m : ℕ) → Option (Wire n) → (Fin m → Wire n) → (Fin m → Wire n) →
      (ℕ → Fin N' → ZMod 2) → Circuit n
  | 0, c, _, _, T => ulLeaf c sw (T 0) (List.finRange N')
  | m + 1, c, xs, ws, T =>
      (ulCompute c (xs 0) (ws 0)).seq
        ((ulk sw m (some (ws 0)) (fun i ↦ xs i.succ) (fun i ↦ ws i.succ) (fun j ↦ T (2 * j))).seq
          ((ulFlip c (ws 0)).seq
            ((ulk sw m (some (ws 0)) (fun i ↦ xs i.succ) (fun i ↦ ws i.succ)
                (fun j ↦ T (2 * j + 1))).seq
              (ulUncompute c (xs 0) (ws 0)))))

/-- Wire-distinctness hypotheses of `ulk`. -/
structure UlOK {N' m : ℕ} (sw : Fin N' → Wire n) (c : Option (Wire n)) (xs ws : Fin m → Wire n) :
    Prop where
  xw : ∀ i j, xs i ≠ ws j
  ww : ∀ i j, i ≠ j → ws i ≠ ws j
  sx : ∀ q i, sw q ≠ xs i
  sw' : ∀ q i, sw q ≠ ws i
  cx : ∀ c', c = some c' → ∀ i, c' ≠ xs i
  cw : ∀ c', c = some c' → ∀ i, c' ≠ ws i
  cs : ∀ c', c = some c' → ∀ q, c' ≠ sw q

theorem UlOK.tail {N' m : ℕ} {sw : Fin N' → Wire n} {c : Option (Wire n)} {xs ws : Fin (m + 1) → Wire n}
    (h : UlOK sw c xs ws) :
    UlOK sw (some (ws 0)) (fun i : Fin m ↦ xs i.succ) (fun i : Fin m ↦ ws i.succ) where
  xw i j := h.xw i.succ j.succ
  ww i j hij := h.ww i.succ j.succ (fun e ↦ hij (Fin.succ_injective _ e))
  sx q i := h.sx q i.succ
  sw' q i := h.sw' q i.succ
  cx c' hc' i := by
    obtain rfl := Option.some.inj hc'
    exact (h.xw i.succ 0).symm
  cw c' hc' i := by
    obtain rfl := Option.some.inj hc'
    exact h.ww 0 i.succ (Fin.succ_ne_zero i).symm
  cs c' hc' q := by
    obtain rfl := Option.some.inj hc'
    exact (h.sw' q 0).symm

theorem ulk_ket {N' : ℕ} (sw : Fin N' → Wire n) :
    ∀ (m : ℕ) (c : Option (Wire n)) (xs ws : Fin m → Wire n) (T : ℕ → Fin N' → ZMod 2)
      (_ : UlOK sw c xs ws) (x : ℕ) (_ : x < 2 ^ m) (β : BitAssignment n)
      (_ : ∀ i, β (ws i) = 0) (_ : ∀ i, β (xs i) = bitsZ m x i),
      (ulk sw m c xs ws T).eval.1 *ᵥ ket β = ket (β + ulCv c β • ulTab sw (T x))
  | 0, c, xs, ws, T, hok, x, hx, β, _, _ => by
    have hx1 : x < 1 := by simpa using hx
    have hx0 : x = 0 := by omega
    subst hx0
    rw [ulk, ulLeaf_ket c sw (T 0) (fun q c' h ↦ hok.cs c' h q) (List.finRange N') β,
      ulTab_eq_list]
  | m + 1, c, xs, ws, T, hok, x, hx, β, hw0, hxb => by
    have hxw : xs 0 ≠ ws 0 := hok.xw 0 0
    have hx2 : x / 2 < 2 ^ m := by rw [pow_succ] at hx; omega
    have hb0 : β (xs 0) = ((x % 2 : ℕ) : ZMod 2) := by rw [hxb 0]; simp [bitsZ]
    have hbs : ∀ i : Fin m, bitsZ (m + 1) x i.succ = bitsZ m (x / 2) i := by
      intro i; unfold bitsZ; rw [Fin.val_succ, pow_succ', ← Nat.div_div_eq_div_mul]
    have hxn : ∀ i : Fin m, xs i.succ ≠ ws 0 := fun i ↦ hok.xw i.succ 0
    have hwn : ∀ i : Fin m, ws i.succ ≠ ws 0 := fun i ↦ hok.ww i.succ 0 (Fin.succ_ne_zero i)
    have hcw : ∀ c', c = some c' → c' ≠ ws 0 := fun c' h ↦ hok.cw c' h 0
    -- step A: compute
    rw [ulk, eval_seq_mulVec,
      ulCompute_ket c (xs 0) (ws 0) hxw (fun c' h ↦ ⟨hok.cx c' h 0, hok.cw c' h 0⟩) β (hw0 0),
      eval_seq_mulVec]
    -- step B: even half
    have hB := ulk_ket sw m (some (ws 0)) (fun i ↦ xs i.succ) (fun i ↦ ws i.succ)
      (fun j ↦ T (2 * j)) hok.tail (x / 2) hx2
      (Function.update β (ws 0) (ulCv c β * (β (xs 0) + 1)))
      (fun i ↦ by rw [Function.update_of_ne (hwn i)]; exact hw0 _)
      (fun i ↦ by rw [Function.update_of_ne (hxn i), hxb i.succ, hbs i])
    rw [hB, eval_seq_mulVec]
    -- state after B
    have hd0 : UlSupp sw ((ulCv c β * (β (xs 0) + 1)) • ulTab sw (T (2 * (x / 2)))) :=
      (ulSupp_tab sw _).smul _
    have hd0w : ((ulCv c β * (β (xs 0) + 1)) • ulTab sw (T (2 * (x / 2)))) (ws 0) = 0 :=
      hd0 _ (fun q ↦ (hok.sw' q 0).symm)
    have e0 : ulCv (some (ws 0)) (Function.update β (ws 0) (ulCv c β * (β (xs 0) + 1))) =
        ulCv c β * (β (xs 0) + 1) := by simp [ulCv]
    rw [e0]
    -- step C: flip
    have hc2 : ∀ c', c = some c' →
        ((ulCv c β * (β (xs 0) + 1)) • ulTab sw (T (2 * (x / 2)))) c' = 0 :=
      fun c' h ↦ hd0 _ (fun q ↦ hok.cs c' h q)
    rw [ulFlip_ket c (ws 0) hcw, ulCv_add c _ _ hc2, ulCv_update c β _ _ hcw,
      Pi.add_apply, Function.update_self, hd0w, add_zero,
      ulUpd_add _ _ _ _ hd0w, Function.update_idem]
    have ar : ∀ v b : ZMod 2, v * (b + 1) + v = v * b := by decide
    rw [ar, eval_seq_mulVec]
    -- step D: odd half
    have hB' := ulk_ket sw m (some (ws 0)) (fun i ↦ xs i.succ) (fun i ↦ ws i.succ)
      (fun j ↦ T (2 * j + 1)) hok.tail (x / 2) hx2
      (Function.update β (ws 0) (ulCv c β * β (xs 0)) +
        (ulCv c β * (β (xs 0) + 1)) • ulTab sw (T (2 * (x / 2))))
      (fun i ↦ by
        rw [Pi.add_apply, Function.update_of_ne (hwn i), hw0,
          hd0 _ (fun q ↦ (hok.sw' q i.succ).symm), add_zero])
      (fun i ↦ by
        rw [Pi.add_apply, Function.update_of_ne (hxn i), hxb i.succ, hbs i,
          hd0 _ (fun q ↦ (hok.sx q i.succ).symm), add_zero])
    rw [hB']
    -- state after D
    have hd1 : UlSupp sw ((ulCv c β * (β (xs 0) + 1)) • ulTab sw (T (2 * (x / 2))) +
        (ulCv c β * β (xs 0)) • ulTab sw (T (2 * (x / 2) + 1))) :=
      hd0.add ((ulSupp_tab sw _).smul _)
    have hd1w : ((ulCv c β * (β (xs 0) + 1)) • ulTab sw (T (2 * (x / 2))) +
        (ulCv c β * β (xs 0)) • ulTab sw (T (2 * (x / 2) + 1))) (ws 0) = 0 :=
      hd1 _ (fun q ↦ (hok.sw' q 0).symm)
    have hd1x : ((ulCv c β * (β (xs 0) + 1)) • ulTab sw (T (2 * (x / 2))) +
        (ulCv c β * β (xs 0)) • ulTab sw (T (2 * (x / 2) + 1))) (xs 0) = 0 :=
      hd1 _ (fun q ↦ (hok.sx q 0).symm)
    have hd1c : ∀ c', c = some c' →
        ((ulCv c β * (β (xs 0) + 1)) • ulTab sw (T (2 * (x / 2))) +
        (ulCv c β * β (xs 0)) • ulTab sw (T (2 * (x / 2) + 1))) c' = 0 :=
      fun c' h ↦ hd1 _ (fun q ↦ hok.cs c' h q)
    have e1 : ulCv (some (ws 0)) (Function.update β (ws 0) (ulCv c β * β (xs 0)) +
        (ulCv c β * (β (xs 0) + 1)) • ulTab sw (T (2 * (x / 2)))) = ulCv c β * β (xs 0) := by
      change (Function.update β (ws 0) (ulCv c β * β (xs 0)) +
        (ulCv c β * (β (xs 0) + 1)) • ulTab sw (T (2 * (x / 2)))) (ws 0) = _
      rw [Pi.add_apply, Function.update_self, hd0w, add_zero]
    rw [e1, add_assoc]
    -- step E: uncompute
    have hβ0 : Function.update β (ws 0) 0 = β := by
      have := Function.update_eq_self (ws 0) β
      rwa [hw0 0] at this
    have hcond := ulE_cond c β _ (xs 0) (ws 0) hxw hd1w hd1x hd1c hcw
    rw [ulUncompute_ket c (xs 0) (ws 0) hxw (fun c' h ↦ ⟨hok.cx c' h 0, hok.cw c' h 0⟩) _ hcond,
      ulUpd_add _ _ _ _ hd1w, Function.update_idem, hβ0]
    refine congrArg ket ?_
    have h2 : (1 : ZMod 2) + 1 = 0 := rfl
    rcases Nat.mod_two_eq_zero_or_one x with h | h
    · have hT : T x = T (2 * (x / 2)) := by congr 1; omega
      rw [hb0, h, hT]
      simp
    · have hT : T x = T (2 * (x / 2) + 1) := by congr 1; omega
      rw [hb0, h, hT]
      simp only [Nat.cast_one, h2, mul_zero, zero_smul, zero_add, mul_one]

theorem ulk_count {N' : ℕ} (sw : Fin N' → Wire n) :
    ∀ (m : ℕ) (c : Option (Wire n)) (xs ws : Fin m → Wire n) (T : ℕ → Fin N' → ZMod 2),
      (ulk sw m c xs ws T).count PrimitiveGate.TOFF = 0 ∧
        (ulk sw m c xs ws T).count PrimitiveGate.T + 8 ≤ 8 * 2 ^ m
  | 0, c, xs, ws, T => by
    have h := ulLeaf_count c sw (T 0) (List.finRange N')
    rw [ulk]
    exact ⟨h.1, by rw [h.2]; simp⟩
  | m + 1, c, xs, ws, T => by
    have h1 := ulk_count sw m (some (ws 0)) (fun i ↦ xs i.succ) (fun i ↦ ws i.succ)
      (fun j ↦ T (2 * j))
    have h2 := ulk_count sw m (some (ws 0)) (fun i ↦ xs i.succ) (fun i ↦ ws i.succ)
      (fun j ↦ T (2 * j + 1))
    have hc := ulCompute_count c (xs 0) (ws 0)
    have hf := ulFlip_count c (ws 0)
    have hu := ulUncompute_count c (xs 0) (ws 0)
    rw [ulk]
    simp only [Circuit.count_seq]
    rw [pow_succ]
    generalize 2 ^ m = P at h1 h2 ⊢
    exact ⟨by omega, by omega⟩

/-- Unary-iteration lookup of `tab` addressed by `W.xw`, work wires among `W.aw`, targets `W.sw`. -/
def ulookup {s N' : ℕ} (W : Wires s N' n) (tab : Fin (2 ^ s) → Fin N' → ZMod 2) : Circuit n :=
  ulk W.sw s none W.xw (fun i ↦ W.aw i.succ) (fun j ↦ if h : j < 2 ^ s then tab ⟨j, h⟩ else 0)

theorem ulookup_ok {s N' : ℕ} (W : Wires s N' n) :
    UlOK W.sw none W.xw (fun i : Fin s ↦ W.aw i.succ) where
  xw i j := W.xa i j.succ
  ww i j hij e := hij (Fin.succ_injective _ (W.aw_inj e))
  sx q i := W.sx q i
  sw' q i := W.sa q i.succ
  cx c' h := by simp at h
  cw c' h := by simp at h
  cs c' h := by simp at h

theorem ulookup_ket {s N' : ℕ} (W : Wires s N' n) (tab : Fin (2 ^ s) → Fin N' → ZMod 2)
    (x : Fin (2 ^ s)) (β : BitAssignment n) (hc : ∀ k, β (W.aw k) = 0)
    (hx : ∀ i, β (W.xw i) = bitsZ s x.val i) :
    (ulookup W tab).eval.1 *ᵥ ket β = ket (β + tabAdd W (tab x)) := by
  have h := ulk_ket W.sw s none W.xw (fun i ↦ W.aw i.succ)
    (fun j ↦ if h : j < 2 ^ s then tab ⟨j, h⟩ else 0) (ulookup_ok W) x.val x.2 β
    (fun i ↦ hc _) hx
  have hT : (if h : x.val < 2 ^ s then tab ⟨x.val, h⟩ else (0 : Fin N' → ZMod 2)) = tab x := by
    rw [dif_pos x.2]
  rw [ulookup, h]
  simp only [ulCv, one_smul]
  rw [hT]
  rfl

theorem ulookup_count {s N' : ℕ} (W : Wires s N' n) (tab : Fin (2 ^ s) → Fin N' → ZMod 2) :
    (ulookup W tab).count PrimitiveGate.TOFF = 0 ∧
      (ulookup W tab).count PrimitiveGate.T ≤ 8 * 2 ^ s := by
  have h := ulk_count W.sw s none W.xw (fun i ↦ W.aw i.succ)
    (fun j ↦ if h : j < 2 ^ s then tab ⟨j, h⟩ else 0)
  exact ⟨h.1, by unfold ulookup; omega⟩

end QC14.UnaryLookup


