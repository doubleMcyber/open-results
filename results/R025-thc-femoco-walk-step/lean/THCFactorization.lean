theorem norm_selectPauliString_le {k : ℕ} (row : Fin k → SelectPauli.Pauli) :
    ‖(selectPauliString row).1‖ ≤ 1 := by
  have : NeZero (2 ^ k) := ⟨by positivity⟩
  exact (CStarRing.norm_of_mem_unitary (E := Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ)
    (selectPauliString row).2).le

open scoped Matrix.Norms.L2Operator in
theorem norm_rows_le {N : ℕ} (a : RowIdx N → ℝ) :
    ‖∑ r : RowIdx N, ((a r : ℝ) : ℂ) • (selectPauliString (pRow N r)).1‖ ≤ ∑ r, |a r| := by
