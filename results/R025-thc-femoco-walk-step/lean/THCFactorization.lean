variable {n : ℕ}

/-! ## The pair SELECT -/

/-- `selectR` on system ++ `A`, `SWAP(A, B) X_o`, `selectR`, `Z_z`. -/
noncomputable def pairSelProgramR {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ} (D : CData N M)
    (hbI : 1 ≤ bIC N M) (rSI : QRegister (2 * N + bP N M) n)
    (rS : QRegister (selRScr N (bIC N M) beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rSI.DisjointWires (rS.concat rCat hsc)) :
    DynamicCircuit Var n :=
  .seq (selectR v beth hbI (kAll D) (fun _ ↦ false) (rSI.compose (regSA N M)) rS rCat hsc
      (hdisj.compose_left _))
    (.seq (.circuit ((swapXLoc N M).onRegister (rSI.compose (idxReg N (bP N M)))))
      (.seq (selectR v beth hbI (kAll D) (fun _ ↦ false) (rSI.compose (regSA N M)) rS rCat hsc
          (hdisj.compose_left _))
        (.circuit ((zLoc N M).onRegister (rSI.compose (idxReg N (bP N M)))))))

theorem pairSelR_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    (hb : 2 ≤ beth) {N M : ℕ} [NeZero N] (D : CData N M) (hbI : 1 ≤ bIC N M)
    (rSI : QRegister (2 * N + bP N M) n) (rS : QRegister (selRScr N (bIC N M) beth) n)
    (rCat : QRegister beth n) (hsc : rS.DisjointWires rCat)
    (hdisj : rSI.DisjointWires (rS.concat rCat hsc)) :
    ∃ S : Unitary (2 ^ (2 * N + bP N M)),
      S.1 = pairSelOp D beth ∧
      CatKet rSI rS rCat hsc (pairSelProgramR v beth D hbI rSI rS rCat hsc hdisj).compile S := by
  have h2L : 2 * (N + M) ≤ 2 ^ bIC N M := by have := rows_le_bIC N M; omega
  obtain ⟨U, hUval, hSel⟩ := selectR_catKet v beth hb hbI (kAll D) (fun _ ↦ false) h2L
    (rSI.compose (regSA N M)) rS rCat hsc (hdisj.compose_left _)
  have hS1 := CatKet.compose (outer := rSI) (regSA N M) hSel
  have hX := CatKet.compose (outer := rSI) (idxReg N (bP N M))
    (CatKet.circuit (Var := Var) (rSI.compose (idxReg N (bP N M))) rS rCat hsc (swapXLoc N M))
  have hZ := CatKet.compose (outer := rSI) (idxReg N (bP N M))
    (CatKet.circuit (Var := Var) (rSI.compose (idxReg N (bP N M))) rS rCat hsc (zLoc N M))
  have h := CatKet.seq hdisj hS1 (CatKet.seq hdisj hX (CatKet.seq hdisj hS1 hZ))
  refine ⟨(idxReg N (bP N M)).embedUnitary (zLoc N M).eval * (regSA N M).embedUnitary U *
    (idxReg N (bP N M)).embedUnitary (swapXLoc N M).eval * (regSA N M).embedUnitary U, ?_, ?_⟩
  · rw [pairSelOp_factor]
    change ((idxReg N (bP N M)).embedUnitary (zLoc N M).eval).1 *
      ((regSA N M).embedUnitary U).1 * ((idxReg N (bP N M)).embedUnitary (swapXLoc N M).eval).1 *
      ((regSA N M).embedUnitary U).1 = _
    simp only [QRegister.embedUnitary_val]
    rw [swapXLoc_eval, zLoc_eval, hUval]
    simp only [selA]
  · simp only [pairSelProgramR, DynamicCircuit.compile_seq, DynamicCircuit.compile_circuit]
    exact h

/-- Per pair SELECT: `2 (16 (N − 1)(beth − 1) + 16 N + selLkT bIC (N · beth + 2))` (P4.2 signed kicks). -/
abbrev selTR (N M beth : ℕ) : ℕ := 2 * (16 * (N - 1) * (beth - 1) + 16 * N + selLkT (bIC N M) (N * beth + 2))

theorem pairSelR_count {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ} [NeZero N] (D : CData N M)
    (hbI : 1 ≤ bIC N M) (rSI : QRegister (2 * N + bP N M) n)
    (rS : QRegister (selRScr N (bIC N M) beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rSI.DisjointWires (rS.concat rCat hsc)) :
    (pairSelProgramR v beth D hbI rSI rS rCat hsc hdisj).count PrimitiveGate.TOFF = 0 ∧
      (pairSelProgramR v beth D hbI rSI rS rCat hsc hdisj).count PrimitiveGate.T ≤
        selTR N M beth := by
  have hs := selectR_count v beth hbI (kAll D) (fun _ ↦ false) (rSI.compose (regSA N M)) rS rCat
    hsc (hdisj.compose_left _)
  obtain ⟨hx1, hx2⟩ := pqSwapXLoc_count N M
  obtain ⟨hz1, hz2⟩ := pqZLoc_count N M
  simp only [pairSelProgramR, DynamicCircuit.count, Circuit.count_onRegister, selTR]
  omega


end QC14.PairSelR


