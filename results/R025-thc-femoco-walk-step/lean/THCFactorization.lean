namespace QC14.PairPrep

open QuantumComputation QuantumComputation.Specs Matrix Finset
open Operator
open PrepareImpl SelectPauliImpl SelectPauliSteps
open QC14.RowProgram QC14.SelectRows QC14.SelectL QC14.BlockLCU QC14.WeightsC QC14.PairBlock
open QC14 (blkA blkS blkSys prepU natW aliasF)
open scoped Matrix

/-! ## Widths and the fibre function -/

/-- Garbage width of the pair PREPARE. -/
abbrev gP (N M aleph : ℕ) : ℕ := bP N M + muC N M aleph

theorem gP_eq (N M aleph : ℕ) : gP N M aleph = gC N M aleph :=
  idxC_add_muC N M aleph

/-- The alias-table conditions of `exists_alias_flatW` at `g = gC`, `s = sA`. -/
def AliasOK {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (t : (Fin (2 ^ sA N M) → Fin (2 ^ idxC N M)) × (Fin (2 ^ sA N M) → Fin (2 ^ idxC N M)) ×
      (Fin (2 ^ sA N M) → ℕ)) : Prop :=
  (∀ x, t.2.2 x < 2 ^ (gC N M aleph - sA N M)) ∧
    ∀ y, (univ.filter fun σ : Fin (2 ^ gC N M aleph) ↦ aliasF t.1 t.2.1 t.2.2 σ = y).card =
      flatW thc D aleph y

open Classical in
/-- The chosen alias tables (`exists_alias_flatW`); all-zero tables when none exist. -/
noncomputable def aliasTabs {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) :
    (Fin (2 ^ sA N M) → Fin (2 ^ idxC N M)) × (Fin (2 ^ sA N M) → Fin (2 ^ idxC N M)) ×
      (Fin (2 ^ sA N M) → ℕ) :=
  if h : ∃ t, AliasOK thc D aleph t then h.choose
  else (fun _ ↦ ⟨0, Nat.two_pow_pos _⟩, fun _ ↦ ⟨0, Nat.two_pow_pos _⟩, fun _ ↦ 0)

theorem aliasTabs_K_lt {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (x : Fin (2 ^ sA N M)) : (aliasTabs thc D aleph).2.2 x < 2 ^ (gP N M aleph - sA N M) := by
  rw [gP_eq]
  unfold aliasTabs
  split_ifs with h
  · exact h.choose_spec.1 x
  · exact Nat.two_pow_pos _

theorem aliasTabs_ok {N M : ℕ} {thc : THCFactorization N M} {aleph beth : ℕ} {lam : ℝ}
    {D : CData N M} (hD : CFacts thc aleph beth lam D) :
    AliasOK thc D aleph (aliasTabs thc D aleph) := by
  have h : ∃ t, AliasOK thc D aleph t := by
    obtain ⟨ind, alt, K, hK, hc⟩ := exists_alias_flatW hD
    exact ⟨(ind, alt, K), hK, hc⟩
  unfold aliasTabs
  rw [dif_pos h]
  exact h.choose_spec

/-- Index tables with `o = 0`. -/
noncomputable def indP {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (x : Fin (2 ^ sA N M)) : Fin (2 ^ bP N M) :=
  encP ((aliasTabs thc D aleph).1 x) false

/-- Alias tables with `o = 0`. -/
noncomputable def altP {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (x : Fin (2 ^ sA N M)) : Fin (2 ^ bP N M) :=
  encP ((aliasTabs thc D aleph).2.1 x) false

/-- The alias fibre function over the pair weights (E1, `notes/PHASE3.md`). -/
noncomputable def fP {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) :
    Fin (2 ^ gP N M aleph) → Fin (2 ^ bP N M) :=
  aliasF (indP thc D aleph) (altP thc D aleph) (aliasTabs thc D aleph).2.2

theorem fP_def {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (σ : Fin (2 ^ gP N M aleph)) :
    fP thc D aleph σ = encP (aliasF (aliasTabs thc D aleph).1 (aliasTabs thc D aleph).2.1
      (aliasTabs thc D aleph).2.2 σ) false := by
  unfold fP aliasF indP altP
  split_ifs <;> rfl

/-- Every value of `fP` has `o = 0`. -/
theorem fP_eq_encP {N M : ℕ} {thc : THCFactorization N M} {aleph beth : ℕ} {lam : ℝ}
    {D : CData N M} (_hD : CFacts thc aleph beth lam D) (σ : Fin (2 ^ gP N M aleph)) :
    fP thc D aleph σ = encP (loP (fP thc D aleph σ)) false := by
  rw [fP_def, loP_encP]

private theorem card_cast_val {g g' : ℕ} (h : g = g') (P : ℕ → Prop) [DecidablePred P] :
    (univ.filter fun σ : Fin (2 ^ g) ↦ P σ.val).card =
      (univ.filter fun σ : Fin (2 ^ g') ↦ P σ.val).card := by
  subst h; rfl

/-- The fibre of `y ++ 0` has `flatW y` elements. -/
theorem card_fP {N M : ℕ} {thc : THCFactorization N M} {aleph beth : ℕ} {lam : ℝ}
    {D : CData N M} (hD : CFacts thc aleph beth lam D) (y : Fin (2 ^ idxC N M)) :
    (univ.filter fun σ ↦ fP thc D aleph σ = encP y false).card = flatW thc D aleph y := by
  have hinj : ∀ a : Fin (2 ^ idxC N M), (encP a false = encP y false ↔ a = y) := fun a ↦
    ⟨fun h ↦ by simpa [loP_encP] using congrArg loP h, fun h ↦ h ▸ rfl⟩
  simp only [fP_def, hinj]
  rw [← (aliasTabs_ok hD).2 y]
  exact card_cast_val (gP_eq N M aleph)
    (fun v ↦ (if v / 2 ^ sA N M < (aliasTabs thc D aleph).2.2 ⟨v % 2 ^ sA N M,
      Nat.mod_lt _ (Nat.two_pow_pos _)⟩ then (aliasTabs thc D aleph).1 ⟨v % 2 ^ sA N M,
      Nat.mod_lt _ (Nat.two_pow_pos _)⟩ else (aliasTabs thc D aleph).2.1 ⟨v % 2 ^ sA N M,
      Nat.mod_lt _ (Nat.two_pow_pos _)⟩) = y)

/-! ## The PREPARE unitary -/

/-- `CSWAP(o; A, B)` on the pair index. -/
def cswapIdx {N M : ℕ} (x : Fin (2 ^ bP N M)) : Fin (2 ^ bP N M) :=
  if oP x then encP (swapAB (loP x)) true else x

theorem cswapIdx_cswapIdx {N M : ℕ} (x : Fin (2 ^ bP N M)) : cswapIdx (cswapIdx x) = x := by
  by_cases h : oP x
  · simp [cswapIdx, h, oP_encP, loP_encP, swapAB_swapAB]
    have := encP_loP x
    rwa [h] at this
  · simp [cswapIdx, h]

/-- `CSWAP(o; A, B)` on index ++ garbage, as a permutation of basis states. -/
def cswapPerm (N M g : ℕ) : Equiv.Perm (Fin (2 ^ (bP N M + g))) :=
  (prepareDataEquiv (bP N M) g).symm.trans
    ((Equiv.prodCongr (Function.Involutive.toPerm (cswapIdx (N := N) (M := M)) cswapIdx_cswapIdx) (Equiv.refl _)).trans
      (prepareDataEquiv (bP N M) g))

/-- `H` on the `o` wire (wire `idxC`) of index ++ garbage. -/
noncomputable def hO (N M g : ℕ) : Unitary (2 ^ (bP N M + g)) :=
  (Circuit.H (⟨idxC N M, Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (Nat.le_add_right _ _)⟩ : Wire (bP N M + g))).eval

/-- The pair PREPARE `CSWAP · H_o · prepU`. -/
noncomputable def pairPrepU {N M : ℕ} (thc : THCFactorization N M) (D : CData N M)
    (aleph : ℕ) : Unitary (2 ^ (bP N M + gP N M aleph)) :=
  permutationUnitary (cswapPerm N M (gP N M aleph)) * hO N M (gP N M aleph) *
    prepU (bP N M) (gP N M aleph) (fP thc D aleph)

/-! ### Column 0 helpers -/

private theorem div_mod_add_pow (v q i : ℕ) (hv : v / 2 ^ q % 2 = 0) :
    (v + 2 ^ q) / 2 ^ i % 2 = if i = q then 1 else v / 2 ^ i % 2 := by
  rcases lt_trichotomy i q with h | h | h
  · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt h
    rw [if_neg (by omega), show 2 ^ (i + d + 1) = 2 ^ i * (2 ^ d * 2) by ring,
      Nat.add_mul_div_left _ _ (Nat.two_pow_pos i)]
    omega
  · subst h
    rw [if_pos rfl, Nat.add_div_right _ (Nat.two_pow_pos _)]
    omega
  · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt h
    rw [if_neg (by omega)]
    obtain ⟨m, hm⟩ : ∃ m, v / 2 ^ q = 2 * m := ⟨v / 2 ^ q / 2, by omega⟩
    have hp : 2 ^ (q + d + 1) = 2 ^ q * (2 * 2 ^ d) := by ring
    have e1 : (v + 2 ^ q) / (2 ^ q * (2 * 2 ^ d)) = (2 * m + 1) / (2 * 2 ^ d) := by
      rw [← Nat.div_div_eq_div_mul (v + 2 ^ q) (2 ^ q) (2 * 2 ^ d),
        Nat.add_div_right _ (Nat.two_pow_pos q), hm]
    have e2 : v / (2 ^ q * (2 * 2 ^ d)) = (2 * m) / (2 * 2 ^ d) := by
      rw [← Nat.div_div_eq_div_mul v (2 ^ q) (2 * 2 ^ d), hm]
    have e3 : (2 * m + 1) / (2 * 2 ^ d) = m / 2 ^ d := by
      rw [← Nat.div_div_eq_div_mul]; congr 1; omega
    have e4 : (2 * m) / (2 * 2 ^ d) = m / 2 ^ d := by
      rw [← Nat.div_div_eq_div_mul]; congr 1; omega
    rw [hp, e1, e2, e3, e4]

private theorem basisBits_add_pow {n : ℕ} (q : Fin n) (v v' : Fin (2 ^ n))
    (hv : v.val / 2 ^ q.val % 2 = 0) (hv' : v'.val = v.val + 2 ^ q.val) :
    basisBits n v' = Function.update (basisBits n v) q 1 := by
  funext i
  rw [basisBits_eq_div_mod, hv', div_mod_add_pow _ _ _ hv]
  by_cases h : i = q
  · subst h; simp
  · rw [Function.update_of_ne h, basisBits_eq_div_mod, if_neg (fun h' => h (Fin.ext h'))]

private theorem H_basis {n : ℕ} (q : Wire n) (v v' : Fin (2 ^ n))
    (hv : v.val / 2 ^ q.val % 2 = 0) (hv' : v'.val = v.val + 2 ^ q.val) :
    (Circuit.H q).eval.1 *ᵥ basisState v =
      (Real.sqrt (1 / 2) : ℂ) • (basisState v + basisState v') := by
  have hb : ∀ w : Fin (2 ^ n), basisState w = ket (basisBits _ w) := fun w ↦ by simp [ket]
  have h1 := basisBits_add_pow q v v' hv hv'
  have h0 : basisBits n v q = 0 := by
    rw [basisBits_eq_div_mod]; simp [hv]
  have h2 := Function.update_eq_self q (basisBits n v)
  rw [h0] at h2
  rw [hb v, hb v', h1, SelectPauliSteps.ket_H, h0, h2]
  simp [SelectPauliSteps.bitSign]

private theorem hO_basis {N M g : ℕ} (v v' : Fin (2 ^ (bP N M + g)))
    (hv : v.val / 2 ^ idxC N M % 2 = 0) (hv' : v'.val = v.val + 2 ^ idxC N M) :
    (hO N M g).1 *ᵥ basisState v =
      (Real.sqrt (1 / 2) : ℂ) • (basisState v + basisState v') :=
  H_basis _ v v' hv hv'

private theorem prepU_col (b g : ℕ) (F : Fin (2 ^ g) → Fin (2 ^ b)) :
    (prepU b g F).1 *ᵥ basisState 0 =
      ((Real.sqrt (1 / 2) : ℂ) ^ g) •
        ∑ σ : Fin (2 ^ g), basisState (prepareDataEquiv b g (F σ, σ)) := by
  have h0 : ket (0 : BitAssignment (b + g)) = basisState (0 : Fin (2 ^ (b + g))) := by
    simp only [ket]
    congr 1
    exact (basisBits (b + g)).symm_apply_eq.2 (basisBits_zero _).symm
  have hfs := final_state b g F
  rw [h0, Matrix.mulVec_mulVec] at hfs
  have hsel : ∀ σ, selectPauliDataEquiv g b (σ, F σ) = prepareDataEquiv b g (F σ, σ) := fun σ ↦
    Fin.ext (by rw [selectPauliDataEquiv_val, prepareDataEquiv_val])
  simp only [hsel] at hfs
  rw [← hfs]
  rfl

private theorem pd_bit {N M g : ℕ} (y : Fin (2 ^ idxC N M)) (σ : Fin (2 ^ g)) :
    (prepareDataEquiv (bP N M) g (encP y false, σ)).val / 2 ^ idxC N M % 2 = 0 := by
  have e : (prepareDataEquiv (bP N M) g (encP y false, σ)).val =
      y.val + 2 ^ idxC N M * (2 * σ.val) := by
    rw [prepareDataEquiv_val]
    simp [encP, bP, pow_succ] <;> ring
  rw [e, Nat.add_mul_div_left _ _ (Nat.two_pow_pos _), Nat.div_eq_of_lt y.2]
  omega

private theorem pd_add {N M g : ℕ} (y : Fin (2 ^ idxC N M)) (σ : Fin (2 ^ g)) :
    (prepareDataEquiv (bP N M) g (encP y true, σ)).val =
      (prepareDataEquiv (bP N M) g (encP y false, σ)).val + 2 ^ idxC N M := by
  simp [prepareDataEquiv_val, encP] <;> ring

private theorem cswapPerm_pd {N M g : ℕ} (x : Fin (2 ^ bP N M)) (σ : Fin (2 ^ g)) :
    cswapPerm N M g (prepareDataEquiv (bP N M) g (x, σ)) =
      prepareDataEquiv (bP N M) g (cswapIdx x, σ) := by
  simp [cswapPerm]
  rfl

private theorem cswapIdx_false {N M : ℕ} (y : Fin (2 ^ idxC N M)) :
    cswapIdx (N := N) (M := M) (encP y false) = encP y false := by
  simp [cswapIdx, oP_encP]

private theorem cswapIdx_true {N M : ℕ} (y : Fin (2 ^ idxC N M)) :
    cswapIdx (N := N) (M := M) (encP y true) = encP (swapAB y) true := by
  simp [cswapIdx, oP_encP, loP_encP]

private theorem perm_basis {d : ℕ} (e : Equiv.Perm (Fin d)) (w : Fin d) :
    (permutationUnitary e).1 *ᵥ basisState w = basisState (e w) :=
  permutationUnitary_mulVec_single e w 1

private theorem encP_inj {N M : ℕ} {y y' : Fin (2 ^ idxC N M)} {o o' : Bool} :
    encP y o = encP y' o' ↔ y = y' ∧ o = o' := by
  constructor
  · intro h
    exact ⟨by simpa [loP_encP] using congrArg loP h, by simpa [oP_encP] using congrArg oP h⟩
  · rintro ⟨rfl, rfl⟩; rfl

private theorem pairPrep_vec {N M : ℕ} {thc : THCFactorization N M} {aleph beth : ℕ} {lam : ℝ}
    {D : CData N M} (hD : CFacts thc aleph beth lam D) :
    (pairPrepU thc D aleph).1 *ᵥ basisState 0 =
      ((Real.sqrt (1 / 2) : ℂ) ^ (gP N M aleph + 1)) •
        ∑ σ, (basisState (prepareDataEquiv (bP N M) (gP N M aleph)
                (encP (loP (fP thc D aleph σ)) false, σ)) +
              basisState (prepareDataEquiv (bP N M) (gP N M aleph)
                (encP (swapAB (loP (fP thc D aleph σ))) true, σ))) := by
  have h1 : (pairPrepU thc D aleph).1 *ᵥ basisState 0 =
      (permutationUnitary (cswapPerm N M (gP N M aleph))).1 *ᵥ
        ((hO N M (gP N M aleph)).1 *ᵥ
          ((prepU (bP N M) (gP N M aleph) (fP thc D aleph)).1 *ᵥ basisState 0)) := by
    rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec]; rfl
  have hstep : ∀ σ : Fin (2 ^ gP N M aleph),
      (hO N M (gP N M aleph)).1 *ᵥ
        basisState (prepareDataEquiv (bP N M) (gP N M aleph) (fP thc D aleph σ, σ)) =
      (Real.sqrt (1 / 2) : ℂ) •
        (basisState (prepareDataEquiv (bP N M) (gP N M aleph)
            (encP (loP (fP thc D aleph σ)) false, σ)) +
          basisState (prepareDataEquiv (bP N M) (gP N M aleph)
            (encP (loP (fP thc D aleph σ)) true, σ))) := by
    intro σ
    obtain ⟨y, hy⟩ : ∃ y, fP thc D aleph σ = encP y false := ⟨_, fP_eq_encP hD σ⟩
    rw [hy, loP_encP]
    exact hO_basis _ _ (pd_bit y σ) (pd_add y σ)
  rw [h1, prepU_col, Matrix.mulVec_smul, Matrix.mulVec_sum]
  simp only [hstep]
  rw [Matrix.mulVec_smul, Matrix.mulVec_sum]
  simp only [Matrix.mulVec_smul, Matrix.mulVec_add, perm_basis, cswapPerm_pd, cswapIdx_false,
    cswapIdx_true]
  simp only [← Finset.smul_sum, smul_smul, pow_succ]

/-- Column 0 of the pair PREPARE: amplitude `2^{-(gP+1)/2}` on `(x, σ)` exactly when
`fP σ = c x ++ 0`, `c x = loP x` (`o = 0`) or `swapAB (loP x)` (`o = 1`). -/
theorem pairPrepU_col {N M : ℕ} {thc : THCFactorization N M} {aleph beth : ℕ} {lam : ℝ}
    {D : CData N M} (hD : CFacts thc aleph beth lam D) (x : Fin (2 ^ bP N M))
    (σ : Fin (2 ^ gP N M aleph)) :
    (pairPrepU thc D aleph).1 (prepareDataEquiv (bP N M) (gP N M aleph) (x, σ)) 0 =
      (Real.sqrt (1 / 2) : ℂ) ^ (gP N M aleph + 1) *
        (if fP thc D aleph σ = encP (if oP x then swapAB (loP x) else loP x) false
          then 1 else 0) := by
  have key : ((if x = fP thc D aleph σ then 1 else 0) +
      (if x = encP (swapAB (loP (fP thc D aleph σ))) true then 1 else 0) : ℂ) =
      if fP thc D aleph σ = encP (if oP x then swapAB (loP x) else loP x) false
        then 1 else 0 := by
    obtain ⟨y, hy⟩ : ∃ y, fP thc D aleph σ = encP y false := ⟨_, fP_eq_encP hD σ⟩
    obtain ⟨lx, ox, rfl⟩ : ∃ lx ox, x = encP lx ox := ⟨loP x, oP x, (encP_loP x).symm⟩
    have e : (y = swapAB lx) ↔ (lx = swapAB y) :=
      ⟨fun h => by rw [h, swapAB_swapAB], fun h => by rw [h, swapAB_swapAB]⟩
    rw [hy]
    cases ox
    · simp [oP_encP, loP_encP, encP_inj]
      exact if_congr eq_comm rfl rfl
    · simp [oP_encP, loP_encP, encP_inj, e]
  have hent : (pairPrepU thc D aleph).1 (prepareDataEquiv (bP N M) (gP N M aleph) (x, σ)) 0 =
      ((pairPrepU thc D aleph).1 *ᵥ basisState 0)
        (prepareDataEquiv (bP N M) (gP N M aleph) (x, σ)) :=
    (mulVec_basisState _ _ _).symm
  rw [hent, pairPrep_vec hD]
  simp only [Pi.smul_apply, Finset.sum_apply, Pi.add_apply, basisState_apply, smul_eq_mul,
    Equiv.apply_eq_iff_eq, Prod.mk.injEq]
  congr 1
  rw [Finset.sum_eq_single σ]
  · rw [← fP_eq_encP hD σ]
    simp only [and_true]
    exact key
  · intro σ' _ hne
    simp [Ne.symm hne]
  · intro h; exact absurd (mem_univ _) h

/-- The reduced amplitude seen by the pair SELECT. -/
theorem redAmp_pair {N M : ℕ} {thc : THCFactorization N M} {aleph beth : ℕ} {lam : ℝ}
    {D : CData N M} (hD : CFacts thc aleph beth lam D) (x : Fin (2 ^ bP N M)) :
    redAmp (bP N M) (gP N M aleph) (pairPrepU thc D aleph) (swapP x) x =
      (((flatW thc D aleph (if oP x then swapAB (loP x) else loP x) : ℝ) /
        2 ^ (gP N M aleph + 1) : ℝ) : ℂ) := by
  have hcc : (if oP (swapP x) then swapAB (loP (swapP x)) else loP (swapP x)) =
      (if oP x then swapAB (loP x) else loP x) := by
    unfold swapP
    cases h : oP x <;> simp [oP_encP, loP_encP, swapAB_swapAB, h]
  have hstar : star ((Real.sqrt (1 / 2) : ℂ) ^ (gP N M aleph + 1)) *
      (Real.sqrt (1 / 2) : ℂ) ^ (gP N M aleph + 1) =
      (((1 : ℝ) / 2 ^ (gP N M aleph + 1) : ℝ) : ℂ) := by
    have h2 : Real.sqrt (1 / 2) * Real.sqrt (1 / 2) = 1 / 2 := Real.mul_self_sqrt (by norm_num)
    rw [star_pow, Complex.star_def, Complex.conj_ofReal, ← mul_pow, ← Complex.ofReal_mul, h2]
    push_cast
    rw [div_pow, one_pow]
  have hσ : ∀ σ : Fin (2 ^ gP N M aleph),
      star ((Real.sqrt (1 / 2) : ℂ) ^ (gP N M aleph + 1) *
          (if fP thc D aleph σ = encP (if oP x then swapAB (loP x) else loP x) false
            then 1 else 0)) *
        ((Real.sqrt (1 / 2) : ℂ) ^ (gP N M aleph + 1) *
          (if fP thc D aleph σ = encP (if oP x then swapAB (loP x) else loP x) false
            then 1 else 0)) =
      (((1 : ℝ) / 2 ^ (gP N M aleph + 1) : ℝ) : ℂ) *
        (if fP thc D aleph σ = encP (if oP x then swapAB (loP x) else loP x) false
          then 1 else 0) := by
    intro σ
    by_cases h : fP thc D aleph σ = encP (if oP x then swapAB (loP x) else loP x) false
    · simp only [if_pos h, mul_one]; exact hstar
    · simp [if_neg h]
  unfold redAmp
  simp only [pairPrepU_col hD, hcc]
  rw [Finset.sum_congr rfl (fun σ _ ↦ hσ σ), ← Finset.mul_sum, Finset.sum_boole,
    card_fP hD]
  push_cast
  ring

/-! ## The exact two-body block -/

/-- The pair SELECT as a unitary. -/
noncomputable def pairSelU {N M : ℕ} [NeZero N] (D : CData N M) (beth : ℕ) :
    Unitary (2 ^ (2 * N + bP N M)) :=
  ⟨pairSelOp D beth, pairSelOp_mem D beth⟩

/-- The pair sum over `x` is C3's weighted sum over `y = A ++ B ++ z`. -/
theorem pair_sum_eq {N M : ℕ} [NeZero N] {thc : THCFactorization N M} {aleph beth : ℕ}
    {lam : ℝ} {D : CData N M} (hD : CFacts thc aleph beth lam D) :
    ∑ x, redAmp (bP N M) (gP N M aleph) (pairPrepU thc D aleph) (swapP x) x • selPW D beth x =
      ∑ y, (((flatW thc D aleph y : ℝ) / 2 ^ gC N M aleph : ℝ) : ℂ) • pairOpC D beth y := by
  simp only [redAmp_pair hD]
  rw [sum_bP_eq]
  simp only [Fintype.sum_bool, oP_encP, loP_encP, Bool.false_eq_true, ↓reduceIte]
  have hre : ∑ y, (((flatW thc D aleph (swapAB y) : ℝ) / 2 ^ (gP N M aleph + 1) : ℝ) : ℂ) •
        selPW D beth (encP y true) =
      ∑ y, (((flatW thc D aleph y : ℝ) / 2 ^ (gP N M aleph + 1) : ℝ) : ℂ) •
        selPW D beth (encP (swapAB y) true) := by
    have := Equiv.sum_comp (Function.Involutive.toPerm swapAB (swapAB_swapAB (N := N) (M := M)))
      (fun y ↦ (((flatW thc D aleph y : ℝ) / 2 ^ (gP N M aleph + 1) : ℝ) : ℂ) •
        selPW D beth (encP (swapAB y) true))
    have e : ∀ y, (Function.Involutive.toPerm swapAB (swapAB_swapAB (N := N) (M := M))) y =
        swapAB y := fun _ ↦ rfl
    simp only [e, swapAB_swapAB] at this
    exact this
  rw [Finset.sum_add_distrib, hre, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun y _ ↦ ?_
  have hr : (((flatW thc D aleph y : ℝ) / 2 ^ (gP N M aleph + 1) : ℝ) : ℂ) =
      (((flatW thc D aleph y : ℝ) / 2 ^ gC N M aleph : ℝ) : ℂ) * 2⁻¹ := by
    rw [gP_eq]; push_cast; field_simp; ring
  rw [← smul_add, hr]
  unfold pairOpC selPW
  simp only [loP_encP, idxZ_swapAB, idxA_swapAB, idxB_swapAB]
  module

/-- Top-left block of `Q† S Q`: exactly `α⁻¹ (thcHamiltonian - c' 1)` on the system. -/
theorem pair_block {N M : ℕ} [NeZero N] {thc : THCFactorization N M} {aleph beth : ℕ}
    {lam : ℝ} {D : CData N M} (hD : CFacts thc aleph beth lam D) :
    (blkA (2 * N) (bP N M) (gP N M aleph)).basisOutcomeProjector 0 *
        (lcuQ N (bP N M) (gP N M aleph) (pairPrepU thc D aleph) (pairSelU D beth)).1 *
        (blkA (2 * N) (bP N M) (gP N M aleph)).basisOutcomeProjector 0 =
      (blkA (2 * N) (bP N M) (gP N M aleph)).basisOutcomeProjector 0 *
        (blkSys (2 * N) (bP N M) (gP N M aleph)).embedMatrix
          (((alphaC thc D aleph)⁻¹ : ℂ) • (thcHamiltonian thc - (offsetC thc D aleph : ℂ) • 1)) *
        (blkA (2 * N) (bP N M) (gP N M aleph)).basisOutcomeProjector 0 := by
  rw [lcuQ_block_map N (bP N M) (gP N M aleph) (pairPrepU thc D aleph) (pairSelU D beth)
    swapP (selPW D beth) rfl, pair_sum_eq hD, blockSumC_eq hD]

/-- `Q† S Q` is Hermitian. -/
theorem pair_herm {N M : ℕ} [NeZero N] (thc : THCFactorization N M) (D : CData N M)
    (aleph beth : ℕ) :
    (lcuQ N (bP N M) (gP N M aleph) (pairPrepU thc D aleph) (pairSelU D beth)).1ᴴ =
      (lcuQ N (bP N M) (gP N M aleph) (pairPrepU thc D aleph) (pairSelU D beth)).1 := by
  exact lcuQ_herm N (bP N M) (gP N M aleph) _ (pairSelU D beth) (pairSelOp_conjTranspose D beth)

end QC14.PairPrep


