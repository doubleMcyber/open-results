variable {n : ℕ}

/-- `runList_levelSwap` together with the content of the upper blocks `B (l + off)`. -/
theorem runList_levelSwap_full (c w_clean : Wire n) (w : ℕ) (B : ℕ → QRegister w n)
    (off k : ℕ) (hk : k ≤ off)
    (hD : ∀ l l', l < 2 * off → l' < 2 * off → l ≠ l' → (B l).DisjointWires (B l'))
    (hc : ∀ l, c ∉ Set.range (B l).wires) (hwc : c ≠ w_clean)
    (hwB : ∀ l, w_clean ∉ Set.range (B l).wires)
    (β : BitAssignment n) (hw0 : β w_clean = 0) :
    ∃ β', runList (levelSwap c w_clean w B off k) β = some β' ∧
      (∀ v, (∀ l < k, v ∉ Set.range (B l).wires ∧ v ∉ Set.range (B (l + off)).wires) →
        β' v = β v) ∧
      (∀ l < k, ∀ i, β' (B l i) = β (B (l + off * (β c).val) i)) ∧
      ∀ l < k, ∀ i, β' (B (l + off) i) = β (B (l + off * (1 - (β c).val)) i) := by
  induction k with
  | zero =>
    exact ⟨β, rfl, fun _ _ ↦ rfl, fun l hl ↦ absurd hl (Nat.not_lt_zero l),
      fun l hl ↦ absurd hl (Nat.not_lt_zero l)⟩
  | succ k ih =>
    obtain ⟨β1, h1, hfr1, h1B, h1B'⟩ := ih (by omega)
    obtain ⟨β2, h2, hfr2, h2A, h2B⟩ := runList_cswapSteps c w_clean w (B k) (B (k + off))
      (hD _ _ (by omega) (by omega) (by omega)) (hc _) (hc _) hwc (hwB _) (hwB _) β1
      (by rw [hfr1 w_clean fun l _ ↦ ⟨hwB l, hwB _⟩, hw0])
    have hc1 : β1 c = β c := hfr1 c fun l _ ↦ ⟨hc l, hc _⟩
    have dis : ∀ a b, a < 2 * off → b < 2 * off → a ≠ b → ∀ i,
        B a i ∉ Set.range (B b).wires := fun a b ha hb hab i ↦
      not_mem_of_disjoint (hD a b ha hb hab) i
    have e1 : ∀ i, β1 (B k i) = β (B k i) := fun i ↦
      hfr1 _ fun l' hl' ↦ ⟨dis k l' (by omega) (by omega) (by omega) i,
        dis k (l' + off) (by omega) (by omega) (by omega) i⟩
    have e2 : ∀ i, β1 (B (k + off) i) = β (B (k + off) i) := fun i ↦
      hfr1 _ fun l' hl' ↦ ⟨dis (k + off) l' (by omega) (by omega) (by omega) i,
        dis (k + off) (l' + off) (by omega) (by omega) (by omega) i⟩
    refine ⟨β2, by rw [levelSwap, runList_append, h1, Option.bind_some, h2],
      fun v hv ↦ by
        rw [hfr2 v (hv k (by omega)).1 (hv k (by omega)).2,
          hfr1 v fun l hl ↦ hv l (by omega)],
      fun l hl i ↦ ?_, fun l hl i ↦ ?_⟩
    · rcases Nat.lt_succ_iff_lt_or_eq.mp hl with hl | hl
      · rw [hfr2 _ (dis l k (by omega) (by omega) (by omega) i)
          (dis l (k + off) (by omega) (by omega) (by omega) i), h1B l hl i]
      · subst hl
        rw [h2A, hc1, e1, e2]
        rcases bit_cases (β c) with h | h <;> rw [h]
        · simp
        · rw [one_mul, ← add_assoc, CharTwo.add_self_eq_zero, zero_add,
            show ZMod.val (1 : ZMod 2) = 1 from rfl, mul_one]
    · rcases Nat.lt_succ_iff_lt_or_eq.mp hl with hl | hl
      · rw [hfr2 _ (dis (l + off) k (by omega) (by omega) (by omega) i)
          (dis (l + off) (k + off) (by omega) (by omega) (by omega) i), h1B' l hl i]
      · subst hl
        rw [h2B, hc1, e1, e2]
        rcases bit_cases (β c) with h | h <;> rw [h]
        · simp
        · rw [one_mul, add_comm (β (B l i)) (β (B (l + off) i)), ← add_assoc,
            CharTwo.add_self_eq_zero, zero_add,
            show ZMod.val (1 : ZMod 2) = 1 from rfl, Nat.sub_self, mul_zero, add_zero]

/-- The block that ends up in position `j` after `swapTree` on the address `xl`. -/
def swapSrc : ℕ → ℕ → ℕ → ℕ
  | 0, _, j => j
  | s + 1, xl, j =>
    if j < 2 ^ s then swapSrc s (xl % 2 ^ s) j + 2 ^ s * (xl / 2 ^ s % 2)
    else j - 2 ^ s * (xl / 2 ^ s % 2)

theorem swapSrc_lt (s : ℕ) : ∀ xl j, j < 2 ^ s → swapSrc s xl j < 2 ^ s := by
  induction s with
  | zero => intro xl j hj; simpa [swapSrc] using hj
  | succ s ih =>
    intro xl j hj
    have hb := Nat.mod_lt (xl / 2 ^ s) (show 0 < 2 by norm_num)
    have hm : 2 ^ s * (xl / 2 ^ s % 2) ≤ 2 ^ s * 1 := Nat.mul_le_mul_left _ (by omega)
    rw [pow_succ] at hj ⊢
    simp only [swapSrc]
    split_ifs with h
    · have := ih (xl % 2 ^ s) j h
      omega
    · omega

theorem swapSrc_zero (s : ℕ) : ∀ xl, xl < 2 ^ s → swapSrc s xl 0 = xl := by
  induction s with
  | zero => intro xl h; simp at h; simp [swapSrc, h]
  | succ s ih =>
    intro xl h
    have h0 : 0 < 2 ^ s := by positivity
    rw [pow_succ] at h
    simp only [swapSrc, if_pos h0]
    rw [ih (xl % 2 ^ s) (Nat.mod_lt _ h0),
      Nat.mod_eq_of_lt (Nat.div_lt_of_lt_mul h)]
    exact Nat.mod_add_div xl (2 ^ s)

theorem swapSrc_succ_split (s L T j : ℕ) (hL : L < 2 ^ s) (hT : T < 2) :
    swapSrc (s + 1) (L + 2 ^ s * T) j =
      if j < 2 ^ s then swapSrc s L j + 2 ^ s * T else j - 2 ^ s * T := by
  have e1 : (L + 2 ^ s * T) % 2 ^ s = L := by
    rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hL]
  have e2 : (L + 2 ^ s * T) / 2 ^ s % 2 = T := by
    rw [Nat.add_mul_div_left _ _ (by positivity), Nat.div_eq_of_lt hL, zero_add,
      Nat.mod_eq_of_lt hT]
  simp only [swapSrc, e1, e2]

theorem runList_swapTree_full (w_clean : Wire n) (w : ℕ) (B : ℕ → QRegister w n) (s : ℕ)
    (rc : QRegister s n)
    (hD : ∀ l l', l < 2 ^ s → l' < 2 ^ s → l ≠ l' → (B l).DisjointWires (B l'))
    (hc : ∀ j l, rc j ∉ Set.range (B l).wires)
    (hwrc : w_clean ∉ Set.range rc.wires) (hwB : ∀ l, w_clean ∉ Set.range (B l).wires)
    (β : BitAssignment n) (hw0 : β w_clean = 0) :
    ∃ β', runList (swapTree w_clean w B s rc) β = some β' ∧
      (∀ v, (∀ l < 2 ^ s, v ∉ Set.range (B l).wires) → β' v = β v) ∧
      ∀ j < 2 ^ s, ∀ i, β' (B j i) = β (B (swapSrc s (localIdx rc β) j) i) := by
  induction s generalizing β with
  | zero =>
    exact ⟨β, rfl, fun _ _ ↦ rfl, fun j hj i ↦ by simp [swapSrc]⟩
  | succ s ih =>
    obtain ⟨β1, h1, hfr1, h1B, h1B'⟩ := runList_levelSwap_full (rc (Fin.last s)) w_clean w B
      (2 ^ s) (2 ^ s) le_rfl
      (fun l l' hl hl' ↦ hD l l' (by rw [pow_succ]; omega) (by rw [pow_succ]; omega))
      (hc _) (fun h ↦ hwrc ⟨Fin.last s, h⟩) hwB β hw0
    have hc' : ∀ j l, (rc.slice 0 s (by omega)) j ∉ Set.range (B l).wires := fun j l ↦ by
      rw [QRegister.slice_apply]
      exact hc _ l
    obtain ⟨β2, h2, hfr2, h2B⟩ := ih (rc.slice 0 s (by omega))
      (fun l l' hl hl' ↦ hD l l' (by rw [pow_succ]; omega) (by rw [pow_succ]; omega)) hc'
      (not_mem_slice hwrc 0 s (by omega)) β1
      (by rw [hfr1 w_clean fun l _ ↦ ⟨hwB l, hwB _⟩, hw0])
    have hrc : localIdx (rc.slice 0 s (by omega)) β1 = localIdx (rc.slice 0 s (by omega)) β := by
      simp only [localIdx]
      congr 1
      funext j
      exact hfr1 _ fun l _ ↦ ⟨hc' j l, hc' j _⟩
    have hlast : (localIdx (rc.slice s 1 (by omega)) β : ℕ) = (β (rc (Fin.last s))).val := by
      rw [localIdx_val, Fin.sum_univ_one, QRegister.slice_apply]
      simp only [Fin.val_zero, _root_.pow_zero, mul_one, add_zero]
      rfl
    have hL : (localIdx (rc.slice 0 s (by omega)) β : ℕ) < 2 ^ s := (localIdx _ _).isLt
    have hT : (β (rc (Fin.last s))).val < 2 := ZMod.val_lt _
    have hsplit : (localIdx rc β : ℕ) = (localIdx (rc.slice 0 s (by omega)) β : ℕ) +
        2 ^ s * (β (rc (Fin.last s))).val := by
      rw [localIdx_val_split rc s 1 rfl β, hlast]
    refine ⟨β2, by rw [swapTree, runList_append, h1, Option.bind_some, h2],
      fun v hv ↦ by
        rw [hfr2 v fun l hl ↦ hv l (by rw [pow_succ]; omega),
          hfr1 v fun l hl ↦ ⟨hv l (by rw [pow_succ]; omega),
            hv (l + 2 ^ s) (by rw [pow_succ]; omega)⟩],
      fun j hj i ↦ ?_⟩
    rw [hsplit, swapSrc_succ_split _ _ _ _ hL hT]
    split_ifs with hjs
    · rw [h2B j hjs i, hrc, h1B _ (swapSrc_lt s _ j hjs) i]
    · obtain ⟨l, rfl⟩ : ∃ l, j = l + 2 ^ s := ⟨j - 2 ^ s, by omega⟩
      have hl : l < 2 ^ s := by rw [pow_succ] at hj; omega
      rw [hfr2 _ (fun l' hl' ↦ not_mem_of_disjoint
        (hD (l + 2 ^ s) l' (by rw [pow_succ]; omega) (by rw [pow_succ]; omega) (by omega)) i),
        h1B' l hl i]
      have key : ∀ T l : ℕ, T < 2 → l + 2 ^ s * (1 - T) = l + 2 ^ s - 2 ^ s * T := by
        intro T l hT
        rcases (by omega : T = 0 ∨ T = 1) with rfl | rfl <;> simp
      rw [key _ _ hT]

/-- The first three parts of `ssSteps`: compute into `rD`, swap, copy (no unswap). -/
def mbl2Stage1 (p : LookupParams) (s : ℕ) (hs : s ≤ p.m) (f : ℕ → ℕ)
    (rData : QRegister (p.m + p.w) n) (rD : QRegister (2 ^ s * p.w) n)
    (rW : QRegister (p.m - s) n) (ci : Wire n) : List (Step n) :=
  lookupSteps (2 ^ s * p.w) rD (p.m - s) none (rData.slice (p.w + s) (p.m - s) (by omega)) rW
      (wideTab s p.w f) ++
    swapTree ci p.w (dataBlock s p.w rD) s (rData.slice p.w s (by omega)) ++
    copySteps p.w (dataBlock s p.w rD 0) (rData.slice 0 p.w (by omega))

/-- Content of the junk register after the swap tree: block `j` holds the table entry at
`swapSrc s xl j + 2^s xh`. -/
def swTab (s w : ℕ) (f : ℕ → ℕ) (xl xh : ℕ) : BitAssignment (2 ^ s * w) :=
  fun q ↦ tableBits w f (swapSrc s xl ((q : ℕ) / w) + 2 ^ s * xh)
    ⟨(q : ℕ) % w, Nat.mod_lt _ (Nat.pos_of_ne_zero (by
      rintro rfl
      exact absurd q.isLt (by simp)))⟩

theorem rD_eq_block (s w : ℕ) (rD : QRegister (2 ^ s * w) n) (q : Fin (2 ^ s * w))
    (hw : 0 < w) :
    rD q = dataBlock s w rD ((q : ℕ) / w) ⟨(q : ℕ) % w, Nat.mod_lt _ hw⟩ := by
  have hj : (q : ℕ) / w < 2 ^ s := Nat.div_lt_of_lt_mul (lt_of_lt_of_eq q.isLt (mul_comm _ _))
  rw [dataBlock, QRegister.slice_apply]
  congr 1
  apply Fin.ext
  simp only [Nat.mod_eq_of_lt hj]
  exact (Nat.div_add_mod' _ _).symm

theorem runList_mbl2Stage1 (p : LookupParams) (s : ℕ) (hs : s ≤ p.m) (f : ℕ → ℕ)
    (rData : QRegister (p.m + p.w) n) (rD : QRegister (2 ^ s * p.w) n)
    (rW : QRegister (p.m - s) n) (ci : Wire n)
    (hDl : rD.DisjointWires (rData.slice p.w s (by omega)))
    (hDh : rD.DisjointWires (rData.slice (p.w + s) (p.m - s) (by omega)))
    (hDW : rD.DisjointWires rW)
    (hDY : rD.DisjointWires (rData.slice 0 p.w (by omega)))
    (hlY : (rData.slice p.w s (by omega)).DisjointWires (rData.slice 0 p.w (by omega)))
    (hhW : (rData.slice (p.w + s) (p.m - s) (by omega)).DisjointWires rW)
    (hiD : ci ∉ Set.range rD.wires) (hiXl : ci ∉ Set.range (rData.slice p.w s (by omega)).wires)
    (β : BitAssignment n)
    (hD : ∀ i, β (rD i) = 0) (hW : ∀ i, β (rW i) = 0) (hci : β ci = 0) :
    ∃ β1, runList (mbl2Stage1 p s hs f rData rD rW ci) β = some β1 ∧
      (∀ v, v ∉ Set.range rD.wires → v ∉ Set.range (rData.slice 0 p.w (by omega)).wires →
        β1 v = β v) ∧
      (∀ i, β1 (rData.slice 0 p.w (by omega) i) = β (rData.slice 0 p.w (by omega) i) +
        tableBits p.w f ((localIdx (rData.slice p.w s (by omega)) β : ℕ) +
          2 ^ s * (localIdx (rData.slice (p.w + s) (p.m - s) (by omega)) β : ℕ)) i) ∧
      ∀ q, β1 (rD q) = swTab s p.w f (localIdx (rData.slice p.w s (by omega)) β : ℕ)
        (localIdx (rData.slice (p.w + s) (p.m - s) (by omega)) β : ℕ) q := by
  set rXl := rData.slice p.w s (by omega) with hrXl
  set rXh := rData.slice (p.w + s) (p.m - s) (by omega) with hrXh
  set rY := rData.slice 0 p.w (by omega) with hrY
  set B := dataBlock s p.w rD with hBdef
  set S := swapTree ci p.w B s rXl with hS
  have hnB : ∀ {v}, v ∉ Set.range rD.wires → ∀ l, v ∉ Set.range (B l).wires :=
    fun hv _ ↦ not_mem_slice hv _ _ _
  have hlook := fun β' ↦ runList_lookupSteps (2 ^ s * p.w) rD (p.m - s) none rXh rW
    (wideTab s p.w f) hhW
    (QRegister.disjoint_comm.mp hDh) (QRegister.disjoint_comm.mp hDW)
    (fun _ ↦ ctrlNe_none _) (fun _ ↦ ctrlNe_none _) (fun _ ↦ ctrlNe_none _) β'
  set x := (localIdx rXl β : ℕ) + 2 ^ s * (localIdx rXh β : ℕ) with hx
  set β1 := writeReg β rD (wideTab s p.w f (localIdx rXh β)) with hβ1
  have h1 : runList (lookupSteps (2 ^ s * p.w) rD (p.m - s) none rXh rW (wideTab s p.w f)) β =
      some β1 := by
    rw [hlook β hW]
    simp only [hD, ctrlVal, zero_add, one_mul]
    rfl
  have hb1 : ∀ v, v ∉ Set.range rD.wires → β1 v = β v := fun v hv ↦
    writeReg_apply_of_not_mem _ _ _ _ hv
  obtain ⟨β2, h2, hfr2_B, h2B⟩ := runList_swapTree_full ci p.w B s rXl
    (fun l l' hl hl' h ↦ dataBlock_disjoint s p.w rD hl hl' h)
    (fun j ↦ hnB (not_mem_of_disjoint (QRegister.disjoint_comm.mp hDl) j))
    hiXl (hnB hiD) β1 (by rw [hb1 _ hiD, hci])
  have hfr2 : ∀ v, v ∉ Set.range rD.wires → β2 v = β1 v := fun v hv ↦
    hfr2_B v (fun l _ ↦ hnB hv l)
  have hBj : ∀ j < 2 ^ s, ∀ i, β2 (B j i) =
      tableBits p.w f (swapSrc s (localIdx rXl β : ℕ) j + 2 ^ s * (localIdx rXh β : ℕ)) i :=
    fun j hj i ↦ by
    rw [h2B j hj i, localIdx_writeReg_of_disjoint _ _ _ hDl, hβ1,
      writeReg_wideTab_dataBlock _ _ _ _ _ _ _ (swapSrc_lt s _ j hj)]
  have hB0 : ∀ i, β2 (B 0 i) = tableBits p.w f x i := fun i ↦ by
    rw [hBj 0 (by positivity) i, swapSrc_zero s _ (localIdx rXl β).isLt]
  have hrY2 : ∀ i, β2 (rY i) = β (rY i) := fun i ↦ by
    rw [hfr2 _ (not_mem_of_disjoint (QRegister.disjoint_comm.mp hDY) i),
      hb1 _ (not_mem_of_disjoint (QRegister.disjoint_comm.mp hDY) i)]
  set γ : BitAssignment p.w := fun i ↦ β (rY i) + tableBits p.w f x i with hγ
  have h3 : runList (copySteps p.w (B 0) rY) β2 = some (writeReg β2 rY γ) := by
    rw [runList_copySteps p.w (B 0) rY (hDY.compose_left _)]
    congr 2
    funext i
    rw [hB0, hrY2]
  refine ⟨writeReg β2 rY γ, ?_, fun v hvD hvY ↦ ?_, fun i ↦ ?_, fun q ↦ ?_⟩
  · rw [mbl2Stage1, runList_append, runList_append, h1, Option.bind_some, ← hS, h2,
      Option.bind_some, h3]
  · rw [writeReg_apply_of_not_mem _ _ _ _ hvY, hfr2 v hvD, hb1 v hvD]
  · exact writeReg_apply_reg β2 rY γ i
  · have hw : 0 < p.w := Nat.pos_of_ne_zero (by
      intro h
      have := q.isLt
      simp [h] at this)
    rw [writeReg_apply_of_not_mem _ _ _ _ (not_mem_of_disjoint hDY q), rD_eq_block s p.w rD q hw,
      hBj _ (Nat.div_lt_of_lt_mul (lt_of_lt_of_eq q.isLt (mul_comm _ _)))]
    rfl

theorem mbl2Stage1_ac (p : LookupParams) (s : ℕ) (hs : s ≤ p.m) (f : ℕ → ℕ)
    (rData : QRegister (p.m + p.w) n) (rD : QRegister (2 ^ s * p.w) n)
    (rW : QRegister (p.m - s) n) (ci : Wire n) :
    ac (mbl2Stage1 p s hs f rData rD rW ci) + p.w ≤ (2 ^ (p.m - s) - 1) + 2 ^ s * p.w := by
  have h1 : ac (lookupSteps (2 ^ s * p.w) rD (p.m - s) none
      (rData.slice (p.w + s) (p.m - s) (by omega)) rW (wideTab s p.w f)) ≤ 2 ^ (p.m - s) - 1 :=
    andCount_lookupSteps _ _ _ _ _ _ _
  have h2 := ac_swapTree ci p.w (dataBlock s p.w rD) s (rData.slice p.w s (by omega))
  have h4 := ac_copySteps p.w (dataBlock s p.w rD 0) (rData.slice 0 p.w (by omega))
  simp only [mbl2Stage1, ac_append]
  omega

/-- The width-1 table of parities of the mask `r` against the swapped junk content, as a
function of the full address. -/
def gTab2 (p : LookupParams) (s : ℕ) (f : ℕ → ℕ) (r : Fin (2 ^ s * p.w) → ZMod 2) (h : ℕ) : ℕ :=
  (∑ j, r j * swTab s p.w f (h % 2 ^ s) (h / 2 ^ s) j).val

theorem gTab2_bit (p : LookupParams) (s : ℕ) (f : ℕ → ℕ) (r : Fin (2 ^ s * p.w) → ZMod 2)
    (h : ℕ) : tableBits 1 (gTab2 p s f r) h 0 =
      ∑ j, r j * swTab s p.w f (h % 2 ^ s) (h / 2 ^ s) j := by
  simp only [tableBits, gTab2, Fin.val_zero, _root_.pow_zero, Nat.div_one]
  rw [ZMod.natCast_mod, ZMod.natCast_zmod_val]

/-- Stage 2 leaf: width-1 phase lookup over the full address. -/
def mbl2Leaf (p : LookupParams) (s s2 : ℕ) (hs : s ≤ p.m) (hs2 : s2 ≤ p.m)
    (data : LookupTable p) (rData : QRegister (p.m + p.w) n) {N : ℕ} (rAnc : QRegister N n)
    (hN : 2 ^ s * p.w + (p.m - s) + 1 + (2 ^ s2 * 1 + (p.m - s2) + 1) ≤ N)
    (r : Fin (2 ^ s * p.w) → ZMod 2) : DynamicCircuit Var n :=
  leafCirc p.m s2 (gTab2 p s (fTab data) r)
    ((rData.slice p.w p.m (by omega)).slice 0 s2 (by omega))
    ((rData.slice p.w p.m (by omega)).slice s2 (p.m - s2) (by omega))
    (rAnc.slice (2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1) (p.m - s2) (by omega))
    (rAnc.slice (2 ^ s * p.w + (p.m - s) + 1) (2 ^ s2 * 1) (by omega))
    (rAnc ⟨2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1 + (p.m - s2), by omega⟩)

/-- Lookup measuring the junk register right after the copy. -/
def mbl2Prog (p : LookupParams) (s s2 : ℕ) (hs : s ≤ p.m) (hs2 : s2 ≤ p.m)
    (data : LookupTable p) (rData : QRegister (p.m + p.w) n) {N : ℕ} (rAnc : QRegister N n)
    (hN : 2 ^ s * p.w + (p.m - s) + 1 + (2 ^ s2 * 1 + (p.m - s2) + 1) ≤ N) :
    DynamicCircuit Var n :=
  .seq (compileList (Var.v 0) (mbl2Stage1 p s hs (fTab data) rData
      (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
      (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩)))
    (mbuTree (Var.v 0) (fun i ↦ rAnc.slice 0 (2 ^ s * p.w) (by omega) i)
      (mbl2Leaf p s s2 hs hs2 data rData rAnc hN) (List.finRange (2 ^ s * p.w)) (fun _ ↦ 0))

theorem mbl2Prog_count_T (p : LookupParams) (s s2 : ℕ) (hs : s ≤ p.m) (hs2 : s2 ≤ p.m)
    (data : LookupTable p) (rData : QRegister (p.m + p.w) n) {N : ℕ} (rAnc : QRegister N n)
    (hN : 2 ^ s * p.w + (p.m - s) + 1 + (2 ^ s2 * 1 + (p.m - s2) + 1) ≤ N) :
    (mbl2Prog p s s2 hs hs2 data rData rAnc hN).count PrimitiveGate.T ≤
      4 * (2 ^ (p.m - s) - 1) + 4 * (2 ^ s - 1) * p.w + ssT p.m 1 s2 := by
  have h1 := count_T_compileList (Var.v 0) (mbl2Stage1 p s hs (fTab data) rData
      (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
      (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩))
  have h2 := mbl2Stage1_ac p s hs (fTab data) rData
      (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
      (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩)
  have h3 : (mbuTree (Var.v 0) (fun i ↦ rAnc.slice 0 (2 ^ s * p.w) (by omega) i)
      (mbl2Leaf p s s2 hs hs2 data rData rAnc hN) (List.finRange (2 ^ s * p.w))
      (fun _ ↦ 0)).count PrimitiveGate.T ≤ ssT p.m 1 s2 :=
    mbuTree_count _ _ _ _ _ (fun q ↦ by simp) (fun q ↦ by simp)
      (fun r ↦ leafCirc_count_T _ _ hs2 _ _ _ _ _ _) _ _
  have e : ((mbl2Stage1 p s hs (fTab data) rData
      (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
      (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩)).map Step.andCount).sum = ac (mbl2Stage1 p s hs
      (fTab data) rData
      (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
      (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩)) := rfl
  rw [e] at h1
  have h4 : 4 * (2 ^ s - 1) * p.w + 4 * p.w = 4 * (2 ^ s * p.w) := by
    obtain ⟨k, hk⟩ : ∃ k, 2 ^ s = k + 1 := ⟨2 ^ s - 1, by have := @Nat.one_le_two_pow s; omega⟩
    rw [hk, Nat.add_sub_cancel]
    ring
  unfold mbl2Prog
  simp only [DynamicCircuit.count]
  omega

theorem mbl2Prog_count_TOFF (p : LookupParams) (s s2 : ℕ) (hs : s ≤ p.m) (hs2 : s2 ≤ p.m)
    (data : LookupTable p) (rData : QRegister (p.m + p.w) n) {N : ℕ} (rAnc : QRegister N n)
    (hN : 2 ^ s * p.w + (p.m - s) + 1 + (2 ^ s2 * 1 + (p.m - s2) + 1) ≤ N) :
    (mbl2Prog p s s2 hs hs2 data rData rAnc hN).count PrimitiveGate.TOFF = 0 := by
  have h3 := mbuTree_count (Var.v 0) (fun i ↦ rAnc.slice 0 (2 ^ s * p.w) (by omega) i)
      (mbl2Leaf p s s2 hs hs2 data rData rAnc hN) PrimitiveGate.TOFF 0
      (fun q ↦ by simp) (fun q ↦ by simp)
      (fun r ↦ (leafCirc_count_TOFF _ _ _ _ _ _ _ _).le) (List.finRange (2 ^ s * p.w))
      (fun _ ↦ 0)
  have h1 := count_TOFF_compileList (Var.v 0) (mbl2Stage1 p s hs (fTab data) rData
      (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
      (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩))
  unfold mbl2Prog
  simp only [DynamicCircuit.count]
  omega

theorem split_mod_div (L H s : ℕ) (hL : L < 2 ^ s) :
    (L + 2 ^ s * H) % 2 ^ s = L ∧ (L + 2 ^ s * H) / 2 ^ s = H := by
  refine ⟨?_, ?_⟩
  · rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hL]
  · rw [Nat.add_mul_div_left _ _ (by positivity), Nat.div_eq_of_lt hL, zero_add]

theorem mbl2Prog_realizes (p : LookupParams) (s s2 : ℕ) (hs : s ≤ p.m) (hs2 : s2 ≤ p.m)
    (data : LookupTable p) (rData : QRegister (p.m + p.w) n) {N : ℕ} (rAnc : QRegister N n)
    (hN : 2 ^ s * p.w + (p.m - s) + 1 + (2 ^ s2 * 1 + (p.m - s2) + 1) ≤ N)
    (hd : rData.DisjointWires rAnc) (V : Set (Fin (2 ^ (p.m + p.w)))) :
    RealizesCleanSubroutineOnEncoding rData rAnc hd V (tableXorPerm data.extend)
      (mbl2Prog p s s2 hs hs2 data rData rAnc hN).compile := by
  haveI : NeZero (2 ^ n) := ⟨pow_ne_zero _ two_ne_zero⟩
  have hDA : ∀ {a b : ℕ} (r : QRegister a (p.m + p.w)) (r' : QRegister b N),
      (rAnc.compose r').DisjointWires (rData.compose r) := fun _ _ ↦
    QRegister.disjoint_comm.mp ((hd.compose_left _).compose_right _)
  have hXA : ∀ {a b : ℕ} (r : QRegister a p.m) (r' : QRegister b N),
      (rAnc.compose r').DisjointWires ((rData.slice p.w p.m (by omega)).compose r) :=
    fun r r' ↦ QRegister.disjoint_comm.mp
      (((hd.compose_left (QRegister.block p.w p.m (by omega))).compose_left r).compose_right r')
  have hx : ∀ γ : BitAssignment n, (localIdx (addrReg p rData) γ : ℕ) =
      (localIdx (rData.slice p.w s (by omega)) γ : ℕ) +
        2 ^ s * (localIdx (rData.slice (p.w + s) (p.m - s) (by omega)) γ : ℕ) := fun γ ↦ by
    rw [localIdx_val_split (addrReg p rData) s (p.m - s) (by omega)]
    simp only [localIdx_slice_slice, add_zero]
  have hxh : ∀ γ : BitAssignment n,
      (localIdx ((rData.slice p.w p.m (by omega)).slice 0 s2 (by omega)) γ : ℕ) +
        2 ^ s2 * (localIdx ((rData.slice p.w p.m (by omega)).slice s2
          (p.m - s2) (by omega)) γ : ℕ) =
        (localIdx (rData.slice p.w p.m (by omega)) γ : ℕ) := fun γ ↦
    (localIdx_val_split (rData.slice p.w p.m (by omega)) s2 (p.m - s2)
      (by omega) γ).symm
  have hDl : (rAnc.slice 0 (2 ^ s * p.w) (by omega)).DisjointWires
      (rData.slice p.w s (by omega)) := hDA _ _
  have hDh : (rAnc.slice 0 (2 ^ s * p.w) (by omega)).DisjointWires
      (rData.slice (p.w + s) (p.m - s) (by omega)) := hDA _ _
  obtain ⟨R1, hK1, hR1, -⟩ := exists_lowerKraus_compileList (Var.v 0) (mbl2Stage1 p s hs (fTab data)
    rData (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
    (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩))
  obtain ⟨R2, hK2, hR2⟩ := mbuTree_kraus (Var.v 0) (fun i ↦ rAnc.slice 0 (2 ^ s * p.w) (by omega) i)
    (mbl2Leaf p s s2 hs hs2 data rData rAnc hN)
    (fun i γ ↦ swTab s p.w (fTab data) (localIdx (rData.slice p.w s (by omega)) γ : ℕ)
      (localIdx (rData.slice (p.w + s) (p.m - s) (by omega)) γ : ℕ) i)
    (fun γ ↦ ∀ k : Fin N, 2 ^ s * p.w + (p.m - s) + 1 ≤ k.val → γ (rAnc k) = 0)
    (fun i j h ↦ (rAnc.slice 0 (2 ^ s * p.w) (by omega)).wires.injective h)
    (fun γ i a h k hk ↦ by
      rw [update_of_ne]
      · exact h k hk
      · intro e
        have := rAnc.wires.injective e
        have h2 : 0 + (i : ℕ) = (k : ℕ) := (congrArg Fin.val this).symm
        have h3 := i.isLt
        omega)
    (fun γ i j a ↦ by
      simp only [localIdx_update_of_not_mem _ γ (not_mem_of_disjoint hDl i) a,
        localIdx_update_of_not_mem _ γ (not_mem_of_disjoint hDh i) a])
    (fun r ↦ by
      obtain ⟨L, hL, hLk⟩ := leafCirc_kraus p.m s2 (gTab2 p s (fTab data) r)
        ((rData.slice p.w p.m (by omega)).slice 0 s2 (by omega))
        ((rData.slice p.w p.m (by omega)).slice s2 (p.m - s2) (by omega))
        (rAnc.slice (2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1) (p.m - s2) (by omega))
        (rAnc.slice (2 ^ s * p.w + (p.m - s) + 1) (2 ^ s2 * 1) (by omega))
        (rAnc ⟨2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1 + (p.m - s2), by omega⟩)
        (hXA _ _) (hXA _ _)
        (QRegister.slice_disjoint_of_le rAnc _ _ _ _ (by omega) (by omega) (by omega))
        (QRegister.disjoint_comm.mp (hXA _ _))
        (apply_not_mem_slice rAnc _ (2 ^ s * p.w + (p.m - s) + 1) _ (by omega) (Or.inr (by simp)))
        (fun ⟨i, h⟩ ↦ ((hd.compose_left (QRegister.block p.w p.m (by omega))).compose_left
          (QRegister.block 0 s2 (by omega))).ne i _ h)
      refine ⟨L, hL, fun γ hγ ↦ ?_⟩
      have hD0 : ∀ i : Fin (2 ^ s2 * 1), γ (rAnc.slice (2 ^ s * p.w + (p.m - s) + 1)
          (2 ^ s2 * 1) (by omega) i) = 0 := fun i ↦ by
        have := i.isLt
        exact hγ ⟨2 ^ s * p.w + (p.m - s) + 1 + i, by omega⟩ (Nat.le_add_right _ _)
      have hW0 : ∀ i : Fin (p.m - s2), γ (rAnc.slice (2 ^ s * p.w + (p.m - s) + 1 +
          2 ^ s2 * 1) (p.m - s2) (by omega) i) = 0 := fun i ↦ by
        have := i.isLt
        exact hγ ⟨2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1 + i, by omega⟩
          (by change _ ≤ 2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1 + (i : ℕ); omega)
      have hc0 : γ (rAnc ⟨2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1 + (p.m - s2),
          by omega⟩) = 0 :=
        hγ _ (by change _ ≤ 2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1 + (p.m - s2); omega)
      rw [hLk γ hD0 hW0 hc0, hxh γ, gTab2_bit]
      have hx' : (localIdx (rData.slice p.w p.m (by omega)) γ : ℕ) =
          (localIdx (rData.slice p.w s (by omega)) γ : ℕ) +
            2 ^ s * (localIdx (rData.slice (p.w + s) (p.m - s) (by omega)) γ : ℕ) := hx γ
      obtain ⟨hm, hdv⟩ := split_mod_div _ (localIdx (rData.slice (p.w + s) (p.m - s)
        (by omega)) γ : ℕ) s (localIdx (rData.slice p.w s (by omega)) γ).isLt
      rw [hx', hm, hdv])
    (List.finRange (2 ^ s * p.w)) (List.nodup_finRange _) (fun _ ↦ 0)
  refine realizesOnEncoding_of_lowerKraus rData rAnc hd V _ (hK1.qSeq hK2) fun β h0 _ ↦ ?_
  have hclean := eq_zero_of_localIdx_eq_zero rAnc β h0
  have hD0 : ∀ i, β (rAnc.slice 0 (2 ^ s * p.w) (by omega) i) = 0 := fun _ ↦ hclean _
  have hW0 : ∀ i, β (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega) i) = 0 := fun _ ↦ hclean _
  have hlYs : (rData.slice p.w s (by omega)).DisjointWires (rData.slice 0 p.w (by omega)) :=
    QRegister.disjoint_comm.mp
      (QRegister.slice_disjoint_of_le rData _ _ _ _ (by omega) (by omega) (by omega))
  have hhYs : (rData.slice (p.w + s) (p.m - s) (by omega)).DisjointWires
      (rData.slice 0 p.w (by omega)) :=
    QRegister.disjoint_comm.mp
      (QRegister.slice_disjoint_of_le rData _ _ _ _ (by omega) (by omega) (by omega))
  obtain ⟨β1, hrun, hfr, hY, hDc⟩ := runList_mbl2Stage1 p s hs (fTab data) rData
    (rAnc.slice 0 (2 ^ s * p.w) (by omega))
    (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega)) (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩)
    hDl hDh
    (QRegister.slice_disjoint_of_le rAnc _ _ _ _ (by omega) (by omega) (by omega)) (hDA _ _)
    hlYs
    (QRegister.disjoint_comm.mp (hDA _ _))
    (apply_not_mem_slice rAnc _ 0 _ (by omega) (Or.inr (by simp)))
    (fun ⟨_, h⟩ ↦ hd.ne _ _ h)
    β hD0 hW0 (hclean _)
  set rD := rAnc.slice 0 (2 ^ s * p.w) (by omega) with hrD
  set rXl := rData.slice p.w s (by omega) with hrXl
  set rXh := rData.slice (p.w + s) (p.m - s) (by omega) with hrXh
  set rY := rData.slice 0 p.w (by omega) with hrY
  have hDY : rD.DisjointWires rY := hDA _ _
  have hYA : rY.DisjointWires rAnc := hd.compose_left _
  have hG : ∀ k : Fin N, 2 ^ s * p.w + (p.m - s) + 1 ≤ k.val → β1 (rAnc k) = 0 := by
    intro k hk
    rw [hfr _ (apply_not_mem_slice rAnc k 0 _ (by omega) (Or.inr (by omega)))
      (fun ⟨i, h⟩ ↦ hYA.ne i k h)]
    exact hclean k
  have hloc : ∀ {a : ℕ} (r : QRegister a n), (∀ i, r i ∉ Set.range rD.wires) →
      (∀ i, r i ∉ Set.range rY.wires) → localIdx r β1 = localIdx r β := fun r h1 h2 ↦ by
    simp only [localIdx]
    congr 1
    funext i
    exact hfr _ (h1 i) (h2 i)
  have hl1 : localIdx rXl β1 = localIdx rXl β :=
    hloc _ (fun i ↦ not_mem_of_disjoint (QRegister.disjoint_comm.mp hDl) i)
      (fun i ↦ not_mem_of_disjoint hlYs i)
  have hl2 : localIdx rXh β1 = localIdx rXh β :=
    hloc _ (fun i ↦ not_mem_of_disjoint (QRegister.disjoint_comm.mp hDh) i)
      (fun i ↦ not_mem_of_disjoint hhYs i)
  have hcond : ∀ i ∈ List.finRange (2 ^ s * p.w),
      β1 (rD i) = swTab s p.w (fTab data) (localIdx rXl β1 : ℕ) (localIdx rXh β1 : ℕ) i := by
    intro i _
    rw [hl1, hl2]
    exact hDc i
  rw [← Matrix.mulVec_mulVec, hR1 _ _ hrun, hR2 _ hG, if_pos hcond]
  simp only [zero_mul, Finset.sum_const_zero, bitSign, if_true, one_smul]
  rw [MblImpl.zeroL_finRange', ← target_xor_eq data rData β]
  congr 1
  funext v
  by_cases hvD : v ∈ Set.range rD.wires
  · obtain ⟨i, rfl⟩ := hvD
    rw [writeReg_apply_reg, writeReg_apply_of_not_mem _ _ _ _ (not_mem_of_disjoint hDY i), hD0 i]
  · by_cases hvY : v ∈ Set.range rY.wires
    · obtain ⟨i, rfl⟩ := hvY
      rw [writeReg_apply_of_not_mem _ _ _ _ (not_mem_of_disjoint (QRegister.disjoint_comm.mp hDY) i),
        hY i, writeReg_apply_reg, ← hx β]
      exact congrArg (β (rY i) + ·) (congrFun (hbits data _ (localIdx (addrReg p rData) β).isLt) i)
    · rw [writeReg_apply_of_not_mem _ _ _ _ hvD, writeReg_apply_of_not_mem _ _ _ _ hvY,
        hfr v hvD hvY]

/-- `T` count of the lookup that measures the junk register right after the copy. -/
def mbl2T (m w s s2 : ℕ) : ℕ := 4 * (2 ^ (m - s) - 1) + 4 * (2 ^ s - 1) * w + ssT m 1 s2

/-- Second swap depth: best select-swap depth for the width-1 phase lookup over the full
address in the remaining budget. -/
def mbl2S2 (m w a s : ℕ) : ℕ := ssBest m 1 (a - ssA m w s)

/-- Clean ancillas of the lookup that measures the junk register right after the copy. -/
def mbl2A (m w s s2 : ℕ) : ℕ := ssA m w s + ssA m 1 s2

/-- Swap depth in `0..m` minimizing `mbl2T` among those with `mbl2A ≤ a` (ties to the smaller
`s`). -/
def mbl2Best (m w a : ℕ) : ℕ :=
  (List.range (m + 1)).foldl
    (fun b s ↦ if mbl2A m w s (mbl2S2 m w a s) ≤ a ∧
        (a < mbl2A m w b (mbl2S2 m w a b) ∨
          mbl2T m w s (mbl2S2 m w a s) < mbl2T m w b (mbl2S2 m w a b))
      then s else b) 0

/-- Ancillas of the previous budgeted lookup (measurement cleanup after the unswap, or
select-swap, or unary). -/
def curAnc (m w a : ℕ) : ℕ :=
  if MblImpl.mblCond m w a then
    MblImpl.mblA m w (MblImpl.mblBest m w a) (MblImpl.mblS2 m w a (MblImpl.mblBest m w a))
  else SelectSwapImpl.ssAnc m w a

/-- `T` cost of the previous budgeted lookup. -/
def curT (m w a : ℕ) : ℕ :=
  if MblImpl.mblCond m w a then
    MblImpl.mblT m w (MblImpl.mblBest m w a) (MblImpl.mblS2 m w a (MblImpl.mblBest m w a))
  else MbuImpl.oldTCost m w a

/-- The previous budgeted lookup program. -/
def curProg {n : ℕ} (p : BudgetLookupParams) (data : LookupTable p.toLookupParams)
    (rData : QRegister (p.m + p.w) n) (rAnc : QRegister (curAnc p.m p.w p.a) n) :
    DynamicCircuit Var n :=
  if h : MblImpl.mblCond p.m p.w p.a then
    MblImpl.mblProg p.toLookupParams (MblImpl.mblBest p.m p.w p.a)
      (MblImpl.mblS2 p.m p.w p.a (MblImpl.mblBest p.m p.w p.a)) h.1 h.2.1 data rData rAnc
      (le_of_eq (if_pos h).symm)
  else
    MbuImpl.oldProg p data rData (SelectSwapImpl.castReg (if_neg h) rAnc)

/-- Use the lookup that measures the junk register right after the copy. -/
def mbl2Cond (m w a : ℕ) : Prop :=
  mbl2Best m w a ≤ m ∧ mbl2S2 m w a (mbl2Best m w a) ≤ m ∧
    mbl2A m w (mbl2Best m w a) (mbl2S2 m w a (mbl2Best m w a)) ≤ a ∧
    mbl2T m w (mbl2Best m w a) (mbl2S2 m w a (mbl2Best m w a)) < curT m w a

instance (m w a : ℕ) : Decidable (mbl2Cond m w a) := by unfold mbl2Cond; infer_instance

theorem curProg_realizes (p : BudgetLookupParams) (data : LookupTable p.toLookupParams)
    {n : ℕ} (rData : QRegister (p.m + p.w) n) (rAnc : QRegister (curAnc p.m p.w p.a) n)
    (hdisj : rData.DisjointWires rAnc) (V : Set (Fin (2 ^ (p.m + p.w)))) :
    RealizesCleanSubroutineOnEncoding rData rAnc hdisj V
      (tableXorPerm data.extend) (curProg p data rData rAnc).compile := by
  by_cases h : MblImpl.mblCond p.m p.w p.a
  · unfold curProg
    rw [dif_pos h]
    exact MblImpl.mblProg_realizes p.toLookupParams _ _ h.1 h.2.1 data rData rAnc _ hdisj _
  · unfold curProg
    rw [dif_neg h]
    exact MblImpl.oldProgL_realizes_cast p data rData (if_neg h) rAnc hdisj _

theorem curProg_realizes_cast (p : BudgetLookupParams) (data : LookupTable p.toLookupParams)
    {n : ℕ} (rData : QRegister (p.m + p.w) n) {N : ℕ} (hN : N = curAnc p.m p.w p.a)
    (rAnc : QRegister N n) (hdisj : rData.DisjointWires rAnc)
    (V : Set (Fin (2 ^ (p.m + p.w)))) :
    RealizesCleanSubroutineOnEncoding rData rAnc hdisj V
      (tableXorPerm data.extend)
      (curProg p data rData (SelectSwapImpl.castReg hN rAnc)).compile := by
  subst hN
  exact curProg_realizes p data rData rAnc hdisj V

theorem curProg_count (p : BudgetLookupParams) (hp : p.Valid)
    (data : LookupTable p.toLookupParams) {n : ℕ} (rData : QRegister (p.m + p.w) n)
    (rAnc : QRegister (curAnc p.m p.w p.a) n) :
    curAnc p.m p.w p.a ≤ p.a ∧
      (curProg p data rData rAnc).count PrimitiveGate.TOFF = 0 ∧
      (curProg p data rData rAnc).count PrimitiveGate.T ≤ curT p.m p.w p.a := by
  by_cases h : MblImpl.mblCond p.m p.w p.a
  · refine ⟨?_, ?_, ?_⟩
    · unfold curAnc
      rw [if_pos h]
      exact h.2.2.1
    · unfold curProg
      rw [dif_pos h]
      exact MblImpl.mblProg_count_TOFF p.toLookupParams _ _ h.1 h.2.1 data rData rAnc _
    · unfold curProg curT
      rw [dif_pos h, if_pos h]
      exact MblImpl.mblProg_count_T p.toLookupParams _ _ h.1 h.2.1 data rData rAnc _
  · refine ⟨?_, ?_, ?_⟩
    · unfold curAnc
      rw [if_neg h]
      exact MbuImpl.oldAnc_le p hp
    · unfold curProg
      rw [dif_neg h]
      exact (MbuImpl.oldProg_count p data rData _).1
    · unfold curProg curT
      rw [dif_neg h]
      refine (MbuImpl.oldProg_count p data rData _).2.trans (le_of_eq ?_)
      rw [if_neg h]

end Mbl2Impl


/-- Number of clean ancilla qubits `qromBudgetLookupProgram` uses. -/
def qromBudgetLookupAncillas (p : BudgetLookupParams) : ℕ :=
  if Mbl2Impl.mbl2Cond p.m p.w p.a then
    Mbl2Impl.mbl2A p.m p.w (Mbl2Impl.mbl2Best p.m p.w p.a)
      (Mbl2Impl.mbl2S2 p.m p.w p.a (Mbl2Impl.mbl2Best p.m p.w p.a))
  else Mbl2Impl.curAnc p.m p.w p.a

/-- Budgeted lookup circuit for table `data` on the `p.m + p.w` data wires `rData` (`p.w`
target wires followed by `p.m` address wires) and `qromBudgetLookupAncillas p` clean ancilla
wires `rAnc`. -/
def qromBudgetLookupProgram {n : ℕ} (p : BudgetLookupParams) (data : LookupTable p.toLookupParams)
    (rData : QRegister (p.m + p.w) n)
    (rAnc : QRegister (qromBudgetLookupAncillas p) n) : DynamicCircuit Var n :=
  if h : Mbl2Impl.mbl2Cond p.m p.w p.a then
    Mbl2Impl.mbl2Prog p.toLookupParams (Mbl2Impl.mbl2Best p.m p.w p.a)
      (Mbl2Impl.mbl2S2 p.m p.w p.a (Mbl2Impl.mbl2Best p.m p.w p.a)) h.1 h.2.1 data rData rAnc
      (le_of_eq (if_pos h).symm)
  else
    Mbl2Impl.curProg p data rData (SelectSwapImpl.castReg (if_neg h) rAnc)

/-- For valid sizes and budget and every table, `qromBudgetLookupProgram` realizes
`|x⟩|b⟩ ↦ |x⟩|b ⊕ data(x)⟩` on every address `x < L` and every target `b`, as an exact clean
subroutine across all disjoint register placements. -/
theorem qromBudgetLookup_correctness (p : BudgetLookupParams) (hp : p.Valid)
    (data : LookupTable p.toLookupParams) {n : ℕ} (rData : QRegister (p.m + p.w) n)
    (rAnc : QRegister (qromBudgetLookupAncillas p) n) (hdisj : rData.DisjointWires rAnc) :
    RealizesCleanSubroutineOnEncoding rData rAnc hdisj (lookupValidInputs p.toLookupParams)
      (tableXorPerm data.extend) (qromBudgetLookupProgram p data rData rAnc).compile := by
  by_cases h : Mbl2Impl.mbl2Cond p.m p.w p.a
  · unfold qromBudgetLookupProgram
    rw [dif_pos h]
    exact Mbl2Impl.mbl2Prog_realizes p.toLookupParams _ _ h.1 h.2.1 data rData rAnc _ hdisj _
  · unfold qromBudgetLookupProgram
    rw [dif_neg h]
    exact Mbl2Impl.curProg_realizes_cast p data rData (if_neg h) rAnc hdisj _

/-- Claimed `T` count of the budgeted lookup, as a function of the sizes and the budget. -/
def qromBudgetLookupTCost (p : BudgetLookupParams) : ℕ :=
  if Mbl2Impl.mbl2Cond p.m p.w p.a then
    Mbl2Impl.mbl2T p.m p.w (Mbl2Impl.mbl2Best p.m p.w p.a)
      (Mbl2Impl.mbl2S2 p.m p.w p.a (Mbl2Impl.mbl2Best p.m p.w p.a))
  else Mbl2Impl.curT p.m p.w p.a

/-- For valid sizes and budget, every table and every placement, the budgeted lookup uses at
most `p.a` clean ancillas, no `TOFF` gates and at most `qromBudgetLookupTCost p` `T` gates. -/
theorem qromBudgetLookup_t_cost (p : BudgetLookupParams) (hp : p.Valid)
    (data : LookupTable p.toLookupParams) {n : ℕ} (rData : QRegister (p.m + p.w) n)
    (rAnc : QRegister (qromBudgetLookupAncillas p) n) :
    qromBudgetLookupAncillas p ≤ p.a ∧
      (qromBudgetLookupProgram p data rData rAnc).count PrimitiveGate.TOFF = 0 ∧
      (qromBudgetLookupProgram p data rData rAnc).count PrimitiveGate.T ≤
        qromBudgetLookupTCost p := by
  by_cases h : Mbl2Impl.mbl2Cond p.m p.w p.a
  · refine ⟨?_, ?_, ?_⟩
    · unfold qromBudgetLookupAncillas
      rw [if_pos h]
      exact h.2.2.1
    · unfold qromBudgetLookupProgram
      rw [dif_pos h]
      exact Mbl2Impl.mbl2Prog_count_TOFF p.toLookupParams _ _ h.1 h.2.1 data rData rAnc _
    · unfold qromBudgetLookupProgram qromBudgetLookupTCost
      rw [dif_pos h, if_pos h]
      exact Mbl2Impl.mbl2Prog_count_T p.toLookupParams _ _ h.1 h.2.1 data rData rAnc _
  · have hc := Mbl2Impl.curProg_count p hp data rData (SelectSwapImpl.castReg (if_neg h) rAnc)
    refine ⟨?_, ?_, ?_⟩
    · unfold qromBudgetLookupAncillas
      rw [if_neg h]
      exact hc.1
    · unfold qromBudgetLookupProgram
      rw [dif_neg h]
      exact hc.2.1
    · unfold qromBudgetLookupProgram qromBudgetLookupTCost
      rw [dif_neg h]
      refine hc.2.2.trans (le_of_eq ?_)
      rw [if_neg h]

/-- Claimed bound on `T count * (m + w + a)` for the budgeted lookup at
`BudgetLookupParams.l1024w32a256`: `1900 * (10 + 32 + 256) = 566200`. -/
def qromBudgetLookupL1024W32A256ConstCost : ℕ := 566200

/-- At `BudgetLookupParams.l1024w32a256`, for every table and every placement, the budgeted
lookup uses at most `256` clean ancillas, no `TOFF` gates and has
`T count * (m + w + a) ≤ qromBudgetLookupL1024W32A256ConstCost`, where `m + w + a = 298` is the
declared width. -/
theorem qromBudgetLookup_l1024w32a256_const_cost
    (data : LookupTable BudgetLookupParams.l1024w32a256.toLookupParams) {n : ℕ}
    (rData : QRegister (BudgetLookupParams.l1024w32a256.m + BudgetLookupParams.l1024w32a256.w) n)
    (rAnc : QRegister (qromBudgetLookupAncillas .l1024w32a256) n) :
    qromBudgetLookupAncillas .l1024w32a256 ≤ BudgetLookupParams.l1024w32a256.a ∧
      (qromBudgetLookupProgram .l1024w32a256 data rData rAnc).count PrimitiveGate.TOFF = 0 ∧
      (qromBudgetLookupProgram .l1024w32a256 data rData rAnc).count PrimitiveGate.T *
          (BudgetLookupParams.l1024w32a256.m + BudgetLookupParams.l1024w32a256.w +
            BudgetLookupParams.l1024w32a256.a) ≤
        qromBudgetLookupL1024W32A256ConstCost := by
  have hv : BudgetLookupParams.Valid .l1024w32a256 := by
    unfold BudgetLookupParams.Valid LookupParams.Valid
    decide
  have h := qromBudgetLookup_t_cost .l1024w32a256 hv data rData rAnc
  have hc : qromBudgetLookupTCost .l1024w32a256 = 1900 := by decide
  have ha : qromBudgetLookupAncillas .l1024w32a256 = 175 := by decide
  refine ⟨by rw [ha]; decide, h.2.1, ?_⟩
  calc _ ≤ qromBudgetLookupTCost .l1024w32a256 * _ := Nat.mul_le_mul_right _ h.2.2
    _ ≤ _ := by rw [hc]; decide


/-- Number of clean ancilla qubits `qromBudgetUnlookupProgram` uses. -/
def qromBudgetUnlookupAncillas (p : BudgetLookupParams) : ℕ :=
  if MbuImpl.mbuCond p.m p.w p.a then
    SelectSwapImpl.ssA p.m 1 (SelectSwapImpl.ssBest p.m 1 p.a)
  else SelectSwapImpl.ssAnc p.m p.w p.a

/-- Budgeted unlookup circuit for table `data` on the `p.m + p.w` data wires `rData` and
`qromBudgetUnlookupAncillas p` clean ancilla wires `rAnc`. When the measurement-based variant is
cheaper it measures the `p.w` target wires in the Hadamard basis and applies a width-one phase
lookup per outcome pattern; otherwise it reruns the select-swap lookup. -/
def qromBudgetUnlookupProgram {n : ℕ} (p : BudgetLookupParams)
    (data : LookupTable p.toLookupParams) (rData : QRegister (p.m + p.w) n)
    (rAnc : QRegister (qromBudgetUnlookupAncillas p) n) : DynamicCircuit Var n :=
  if h : MbuImpl.mbuCond p.m p.w p.a then
    MbuImpl.mbuProg p.toLookupParams (SelectSwapImpl.ssBest p.m 1 p.a) h.1 data rData rAnc
      (le_of_eq (if_pos h).symm)
  else
    MbuImpl.oldProg p data rData (SelectSwapImpl.castReg (if_neg h) rAnc)

/-- For valid sizes and budget and every table, `qromBudgetUnlookupProgram` realizes
`|x⟩|data(x)⟩ ↦ |x⟩|0⟩` on every address `x < L`, as an exact clean subroutine across all
disjoint register placements. Inputs whose target differs from `data(x)` are unconstrained. -/
theorem qromBudgetUnlookup_correctness (p : BudgetLookupParams) (hp : p.Valid)
    (data : LookupTable p.toLookupParams) {n : ℕ} (rData : QRegister (p.m + p.w) n)
    (rAnc : QRegister (qromBudgetUnlookupAncillas p) n) (hdisj : rData.DisjointWires rAnc) :
    RealizesCleanSubroutineOnEncoding rData rAnc hdisj (unlookupValidInputs data)
      (tableXorPerm data.extend) (qromBudgetUnlookupProgram p data rData rAnc).compile := by
  by_cases h : MbuImpl.mbuCond p.m p.w p.a
  · unfold qromBudgetUnlookupProgram
    rw [dif_pos h]
    exact MbuImpl.mbuProg_realizes p.toLookupParams _ h.1 data rData rAnc _ hdisj
  · unfold qromBudgetUnlookupProgram
    rw [dif_neg h]
    exact MbuImpl.oldProg_realizes_cast p data rData (if_neg h) rAnc hdisj

/-- Claimed `T` count of the budgeted unlookup, as a function of the sizes and the budget. -/
def qromBudgetUnlookupTCost (p : BudgetLookupParams) : ℕ :=
  if MbuImpl.mbuCond p.m p.w p.a then
    SelectSwapImpl.ssT p.m 1 (SelectSwapImpl.ssBest p.m 1 p.a)
  else MbuImpl.oldTCost p.m p.w p.a

/-- For valid sizes and budget, every table and every placement, the budgeted unlookup uses at
most `p.a` clean ancillas, no `TOFF` gates and at most `qromBudgetUnlookupTCost p` `T` gates.
Classically controlled branches count as the larger branch. -/
theorem qromBudgetUnlookup_t_cost (p : BudgetLookupParams) (hp : p.Valid)
    (data : LookupTable p.toLookupParams) {n : ℕ} (rData : QRegister (p.m + p.w) n)
    (rAnc : QRegister (qromBudgetUnlookupAncillas p) n) :
    qromBudgetUnlookupAncillas p ≤ p.a ∧
      (qromBudgetUnlookupProgram p data rData rAnc).count PrimitiveGate.TOFF = 0 ∧
      (qromBudgetUnlookupProgram p data rData rAnc).count PrimitiveGate.T ≤
        qromBudgetUnlookupTCost p := by
  by_cases h : MbuImpl.mbuCond p.m p.w p.a
  · refine ⟨?_, ?_, ?_⟩
    · unfold qromBudgetUnlookupAncillas
      rw [if_pos h]
      exact h.2.1
    · unfold qromBudgetUnlookupProgram
      rw [dif_pos h]
      exact MbuImpl.mbuProg_count_TOFF p.toLookupParams _ h.1 data rData rAnc _
    · unfold qromBudgetUnlookupProgram qromBudgetUnlookupTCost
      rw [dif_pos h, if_pos h]
      exact MbuImpl.mbuProg_count_T p.toLookupParams _ h.1 data rData rAnc _
  · refine ⟨?_, ?_, ?_⟩
    · unfold qromBudgetUnlookupAncillas
      rw [if_neg h]
      exact MbuImpl.oldAnc_le p hp
    · unfold qromBudgetUnlookupProgram
      rw [dif_neg h]
      exact (MbuImpl.oldProg_count p data rData _).1
    · unfold qromBudgetUnlookupProgram qromBudgetUnlookupTCost
      rw [dif_neg h]
      refine (MbuImpl.oldProg_count p data rData _).2.trans (le_of_eq ?_)
      rw [if_neg h]

/-- Claimed bound on `T count * (m + w + a)` for the budgeted unlookup at
`BudgetLookupParams.l1024w32a256`: `496 * (10 + 32 + 256) = 147808`. -/
def qromBudgetUnlookupL1024W32A256ConstCost : ℕ := 147808

/-- At `BudgetLookupParams.l1024w32a256`, for every table and every placement, the budgeted
unlookup uses at most `256` clean ancillas, no `TOFF` gates and has
`T count * (m + w + a) ≤ qromBudgetUnlookupL1024W32A256ConstCost`. -/
theorem qromBudgetUnlookup_l1024w32a256_const_cost
    (data : LookupTable BudgetLookupParams.l1024w32a256.toLookupParams) {n : ℕ}
    (rData : QRegister (BudgetLookupParams.l1024w32a256.m + BudgetLookupParams.l1024w32a256.w) n)
    (rAnc : QRegister (qromBudgetUnlookupAncillas .l1024w32a256) n) :
    qromBudgetUnlookupAncillas .l1024w32a256 ≤ BudgetLookupParams.l1024w32a256.a ∧
      (qromBudgetUnlookupProgram .l1024w32a256 data rData rAnc).count PrimitiveGate.TOFF = 0 ∧
      (qromBudgetUnlookupProgram .l1024w32a256 data rData rAnc).count PrimitiveGate.T *
          (BudgetLookupParams.l1024w32a256.m + BudgetLookupParams.l1024w32a256.w +
            BudgetLookupParams.l1024w32a256.a) ≤
        qromBudgetUnlookupL1024W32A256ConstCost := by
  have hv : BudgetLookupParams.Valid .l1024w32a256 := by
    unfold BudgetLookupParams.Valid LookupParams.Valid
    decide
  have h := qromBudgetUnlookup_t_cost .l1024w32a256 hv data rData rAnc
  have hc : qromBudgetUnlookupTCost .l1024w32a256 = 496 := by decide
  have ha : qromBudgetUnlookupAncillas .l1024w32a256 = 38 := by decide
  refine ⟨by rw [ha]; decide, h.2.1, ?_⟩
  calc _ ≤ qromBudgetUnlookupTCost .l1024w32a256 * _ := Nat.mul_le_mul_right _ h.2.2
    _ ≤ _ := by rw [hc]; decide

end QuantumComputation.Specs

/-! Inlined from lane module `THC/Catalytic.lean`. -/

namespace QC14.Catalytic

open QuantumComputation QuantumComputation.Specs Matrix
open QuantumComputation.Specs.ArcsinImpl
open Operator QProg Function
open scoped Matrix ComplexOrder MatrixOrder

variable {n : ℕ}

/-! ### Clean-subroutine bridge

Adapted from `CleanSubroutineBridge` in `QuantumSolutions/BlockEncoding/PreparePauliLCU.lean`
(this lane's copy of the QC5 solution), restated for `ArcsinImpl.LowerKraus`. -/

section Bridge

open HermitianMat

/-- An embedded unitary on a register disjoint from `rA` commutes with the clean projector of
`rA`. -/
theorem embed_comm_proj {k m : ℕ} (rT : QRegister k n) (rA : QRegister m n)
    (hd : rT.DisjointWires rA) (U : Unitary (2 ^ k)) :
    rA.basisOutcomeProjector 0 * (rT.embedUnitary U).1 =
      (rT.embedUnitary U).1 * rA.basisOutcomeProjector 0 := by
  apply matrix_ext_ket
  intro β
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, basisOutcomeProjector_mulVec_ket,
    QRegister.embedUnitary_val, embedMatrix_mulVec_ket]
  by_cases h0 : localIdx rA β = 0
  · rw [if_pos h0, embedMatrix_mulVec_ket, Matrix.mulVec_sum]
    simp only [Matrix.mulVec_smul, basisOutcomeProjector_mulVec_ket,
      localIdx_writeReg_of_disjoint β rT rA hd, h0, if_true]
  · rw [if_neg h0, Matrix.mulVec_zero]
    simp only [Matrix.mulVec_sum, Matrix.mulVec_smul, basisOutcomeProjector_mulVec_ket,
      localIdx_writeReg_of_disjoint β rT rA hd, h0, if_false, smul_zero,
      Finset.sum_const_zero]

/-- If `R` is a Kraus lower bound of `P` that agrees with the embedded unitary on every basis ket
whose `rA` bits are all zero, then `P` realizes `U` as a clean subroutine. -/
theorem realizesCleanSubroutine_of_lowerKraus_ket {Var : Type} [DecidableEq Var] {k m : ℕ}
    [NeZero (2 ^ n)] (rT : QRegister k n) (rA : QRegister m n) (hd : rT.DisjointWires rA)
    (U : Unitary (2 ^ k)) {P : QProg Var (2 ^ n)}
    {R : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} (hP : LowerKraus P R)
    (hkey : ∀ β, localIdx rA β = 0 → R *ᵥ ket β = (rT.embedUnitary U).1 *ᵥ ket β) :
    RealizesCleanSubroutine rT rA hd U P := by
  set Q0 := rA.basisOutcomeProjector 0 with hQ
  set E := (rT.embedUnitary U).1 with hE
  have hcomm : Q0 * E = E * Q0 := embed_comm_proj rT rA hd U
  have hQh : Q0ᴴ = Q0 := QRegister.basisOutcomeProjector_conjTranspose _ _
  have hQQ : Q0 * Q0 = Q0 := QRegister.basisOutcomeProjector_mul_self _ _
  have hEE : Eᴴ * E = 1 := by
    have h := Unitary.coe_star_mul_self (rT.embedUnitary U)
    rw [Matrix.star_eq_conjTranspose] at h
    exact h
  have hEE' : E * Eᴴ = 1 := by
    have h := Unitary.coe_mul_star_self (rT.embedUnitary U)
    rw [Unitary.coe_star, Matrix.star_eq_conjTranspose] at h
    exact h
  have hRQ : R * Q0 = E * Q0 := by
    apply matrix_ext_ket
    intro β
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hQ, basisOutcomeProjector_mulVec_ket]
    by_cases h0 : localIdx rA β = 0
    · rw [if_pos h0]; exact hkey β h0
    · rw [if_neg h0, Matrix.mulVec_zero, Matrix.mulVec_zero]
  have hiso : Q0 * (Rᴴ * R) * Q0 = Q0 := by
    have h1 : (R * Q0)ᴴ * (R * Q0) = (E * Q0)ᴴ * (E * Q0) := by rw [hRQ]
    simp only [Matrix.conjTranspose_mul, hQh] at h1
    calc Q0 * (Rᴴ * R) * Q0 = Q0 * (Rᴴ * (R * Q0)) := by simp only [Matrix.mul_assoc]
      _ = Q0 * (Eᴴ * (E * Q0)) := by simpa only [Matrix.mul_assoc] using h1
      _ = Q0 := by rw [← Matrix.mul_assoc Eᴴ, hEE, Matrix.one_mul, hQQ]
  have hpsd : (1 - Rᴴ * R).PosSemidef := by
    have h := hP.conj_le_one 1
    have := (HermitianMat.le_iff.mp h)
    simpa [HermitianMat.conj_apply_mat, Matrix.mul_assoc] using this
  have hzero : Q0ᴴ * ((1 - Rᴴ * R) * Q0) = 0 := by
    rw [hQh, ← Matrix.mul_assoc, Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_one, hiso, hQQ,
      sub_self]
  have hDQ : (1 - Rᴴ * R) * Q0 = 0 := by
    apply matrix_ext_ket
    intro β
    rw [Matrix.zero_mulVec, ← Matrix.mulVec_mulVec]
    set y := Q0 *ᵥ ket β with hy
    refine (hpsd.dotProduct_mulVec_zero_iff).mp ?_
    have h3 : star y ⬝ᵥ ((1 - Rᴴ * R) *ᵥ y) =
        star (ket β) ⬝ᵥ ((Q0ᴴ * ((1 - Rᴴ * R) * Q0)) *ᵥ ket β) := by
      rw [hy, Matrix.star_mulVec, Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
        Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, Matrix.vecMul_vecMul]
      simp only [Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, Matrix.vecMul_vecMul,
        Matrix.mul_assoc]
    rw [h3, hzero, Matrix.zero_mulVec, dotProduct_zero]
  have hRRQ : Rᴴ * R * Q0 = Q0 := by
    rw [Matrix.sub_mul, Matrix.one_mul, sub_eq_zero] at hDQ
    exact hDQ.symm
  have hQE : E * Q0 * Eᴴ = Q0 := by
    rw [← hcomm, Matrix.mul_assoc, hEE', Matrix.mul_one]
  have hcomm' : Q0 * Eᴴ = Eᴴ * Q0 := by
    have := congrArg Matrix.conjTranspose hcomm
    simpa [Matrix.conjTranspose_mul, hQh] using this.symm
  have hRH : Rᴴ * Q0 = Q0 * Eᴴ := by
    calc Rᴴ * Q0 = Rᴴ * (E * Q0 * Eᴴ) := by rw [hQE]
      _ = Rᴴ * (R * Q0) * Eᴴ := by rw [← hRQ, ← Matrix.mul_assoc]
      _ = (Rᴴ * R * Q0) * Eᴴ := by simp only [Matrix.mul_assoc]
      _ = Q0 * Eᴴ := by rw [hRRQ]
  have hR : Q0 * R = Q0 * E * Q0 := by
    have := congrArg Matrix.conjTranspose hRH
    simp only [Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose, hQh] at this
    rw [this, Matrix.mul_assoc, ← hcomm, ← Matrix.mul_assoc, hQQ]
  exact realizesCleanSubroutine_of_lowerKraus rT rA hd U hP hR

end Bridge

/-! ### Register helpers -/

theorem localIdx_eq_zero_of_forall {k : ℕ} (r : QRegister k n) (β : BitAssignment n)
    (h : ∀ i, β (r i) = 0) : localIdx r β = 0 := by
  apply Fin.ext
  rw [localIdx_val]
  simp [h]

theorem localIdx_one (r : QRegister 1 n) (β : BitAssignment n) :
    (localIdx r β : ℕ) = (β (r 0)).val := by
  rw [localIdx_val]
  simp

theorem writeReg_localIdx_self {k : ℕ} (β : BitAssignment n) (r : QRegister k n) :
    writeReg β r (basisBits k (localIdx r β)) = β := by
  simp only [localIdx, basisBits_basisBitsEquiv_symm, writeReg_self]

theorem disjoint_cat {k m b : ℕ} (rT : QRegister k n) (rS : QRegister m n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (hdisj : rT.DisjointWires (rS.concat rCat hsc)) :
    rT.DisjointWires rCat ∧ rT.DisjointWires rS := by
  rw [QRegister.disjoint_iff] at hdisj
  refine ⟨QRegister.disjoint_iff.mpr fun i j ↦ ?_, QRegister.disjoint_iff.mpr fun i j ↦ ?_⟩
  · have := hdisj i (Fin.natAdd m j)
    rwa [QRegister.concat_apply_right] at this
  · have := hdisj i (Fin.castAdd b j)
    rwa [QRegister.concat_apply_left] at this

theorem localIdx_concat_zero {m b : ℕ} (rS : QRegister m n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (β : BitAssignment n)
    (h : localIdx (rS.concat rCat hsc) β = 0) :
    localIdx rS β = 0 ∧ localIdx rCat β = 0 := by
  have hz := eq_zero_of_localIdx_eq_zero _ β h
  refine ⟨localIdx_eq_zero_of_forall _ _ fun i ↦ ?_, localIdx_eq_zero_of_forall _ _ fun i ↦ ?_⟩
  · have := hz (Fin.castAdd b i)
    rwa [QRegister.concat_apply_left] at this
  · have := hz (Fin.natAdd m i)
    rwa [QRegister.concat_apply_right] at this

/-- The basis ket `β` with the catalyst bits replaced by `phaseGradientState b`. -/
noncomputable def catalystKet {b : ℕ} (rCat : QRegister b n) (β : BitAssignment n) :
    Fin (2 ^ n) → ℂ :=
  ∑ y : Fin (2 ^ b), phaseGradientState b y • ket (writeReg β rCat (basisBits b y))

/-- Bridge to the spec's catalytic predicate. -/
theorem catalytic_of_lowerKraus_phi {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)]
    {k m b : ℕ} (rT : QRegister k n) (rS : QRegister m n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (hdisj : rT.DisjointWires (rS.concat rCat hsc))
    (U : Unitary (2 ^ k)) {P : QProg Var (2 ^ n)} {R : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (hP : LowerKraus P R)
    (hkey : ∀ β, localIdx (rS.concat rCat hsc) β = 0 →
      R *ᵥ catalystKet rCat β = (rT.embedUnitary U).1 *ᵥ catalystKet rCat β) :
    RealizesCatalyticSubroutine rT rS rCat hsc hdisj U P := by
  intro V hV
  have hTC : rT.DisjointWires rCat := (disjoint_cat rT rS rCat hsc hdisj).1
  have hcat : ∀ β, localIdx rCat β = 0 →
      (rCat.embedUnitary V).1 *ᵥ ket β = catalystKet rCat β := by
    intro β h0
    rw [QRegister.embedUnitary_val, embedMatrix_mulVec_ket, h0]
    unfold catalystKet
    refine Finset.sum_congr rfl fun y _ ↦ ?_
    rw [hV y]
  have hinv : (rCat.embedUnitary V⁻¹).1 * (rCat.embedUnitary V).1 = 1 := by
    have h := congrArg Subtype.val
      (show rCat.embedUnitary V⁻¹ * rCat.embedUnitary V = 1 by
        rw [← QRegister.embedUnitary_mul, inv_mul_cancel, QRegister.embedUnitary_one])
    exact h
  have hcomm : (rCat.embedUnitary V⁻¹).1 * (rT.embedUnitary U).1 =
      (rT.embedUnitary U).1 * (rCat.embedUnitary V⁻¹).1 :=
    QRegister.embedMatrix_comm_of_disjoint rCat rT (QRegister.disjoint_comm.mp hTC) _ _
  have hLK := (lowerKraus_qAssign (Var := Var) (rCat.embedUnitary V)).qSeq
    (hP.qSeq (lowerKraus_qAssign (Var := Var) (rCat.embedUnitary V⁻¹)))
  refine realizesCleanSubroutine_of_lowerKraus_ket rT (rS.concat rCat hsc) hdisj U hLK ?_
  intro β hβ
  have hβC := (localIdx_concat_zero rS rCat hsc β hβ).2
  have hV' : (rCat.embedUnitary V⁻¹).1 *ᵥ catalystKet rCat β = ket β := by
    rw [← hcat β hβC, Matrix.mulVec_mulVec, hinv, Matrix.one_mulVec]
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hcat β hβC, hkey β hβ,
    Matrix.mulVec_mulVec, hcomm, ← Matrix.mulVec_mulVec, hV']

/-! ### The phase unitary -/

theorem phase_mul_star (x : ℝ) :
    Complex.exp (x * Complex.I) * star (Complex.exp (x * Complex.I)) = 1 := by
  rw [Complex.star_def, ← Complex.exp_conj, ← Complex.exp_add]
  simp [Complex.conj_ofReal]

theorem phase_entry_norm (b : ℕ) (m : ℕ) :
    Complex.exp (2 * Real.pi * Complex.I * (m : ℂ) / 2 ^ b) *
      star (Complex.exp (2 * Real.pi * Complex.I * (m : ℂ) / 2 ^ b)) = 1 := by
  have : (2 * Real.pi * Complex.I * (m : ℂ) / 2 ^ b) =
      ((2 * Real.pi * (m : ℝ) / 2 ^ b : ℝ) : ℂ) * Complex.I := by
    push_cast; ring
  rw [this]
  exact phase_mul_star _

theorem phase_diag_mem (k b : ℕ) (f : Fin (2 ^ k) → ℕ) :
    Matrix.diagonal (fun j : Fin (2 ^ k) ↦
      Complex.exp (2 * Real.pi * Complex.I * (f j : ℂ) / 2 ^ b)) ∈
      Matrix.unitaryGroup (Fin (2 ^ k)) ℂ := by
  rw [Matrix.mem_unitaryGroup_iff, Matrix.star_eq_conjTranspose, Matrix.diagonal_conjTranspose,
    Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
  congr 1
  funext j
  exact phase_entry_norm b (f j)

/-- Diagonal phase `|j⟩ ↦ exp(2πi f(j) / 2^b) |j⟩` on `k` qubits. -/
noncomputable def phaseUnitary (k b : ℕ) (f : Fin (2 ^ k) → ℕ) : Unitary (2 ^ k) :=
  ⟨Matrix.diagonal fun j ↦ Complex.exp (2 * Real.pi * Complex.I * (f j : ℂ) / 2 ^ b), by
    exact phase_diag_mem k b f⟩

theorem phaseUnitary_val (k b : ℕ) (f : Fin (2 ^ k) → ℕ) :
    (phaseUnitary k b f).1 =
      Matrix.diagonal fun j ↦ Complex.exp (2 * Real.pi * Complex.I * (f j : ℂ) / 2 ^ b) := rfl

/-- Adding `s` to the index multiplies the phase-gradient amplitude by `exp(2πi s / 2^b)`. -/
theorem phaseGradient_shift (b : ℕ) (y z : Fin (2 ^ b)) (s : ℕ)
    (h : (z : ℕ) = ((y : ℕ) + s) % 2 ^ b) :
    phaseGradientState b y =
      Complex.exp (2 * Real.pi * Complex.I * (s : ℂ) / 2 ^ b) * phaseGradientState b z := by
  unfold phaseGradientState
  have hq : (y : ℕ) + s = z + 2 ^ b * (((y : ℕ) + s) / 2 ^ b) := by
    rw [h]; exact (Nat.mod_add_div _ _).symm
  set q := ((y : ℕ) + s) / 2 ^ b with hqdef
  have hqC : (y : ℂ) + s = z + 2 ^ b * q := by exact_mod_cast hq
  have hu : (2 : ℂ) ^ b ≠ 0 := pow_ne_zero _ two_ne_zero
  have h1 : (2 : ℂ) ^ b * ((2 : ℂ) ^ b)⁻¹ = 1 := mul_inv_cancel₀ hu
  have e1 : Complex.exp (2 * Real.pi * Complex.I * (s : ℂ) / 2 ^ b) *
      Complex.exp (-(2 * Real.pi * Complex.I * (z : ℂ)) / 2 ^ b) =
      Complex.exp (-(2 * Real.pi * Complex.I * (y : ℂ)) / 2 ^ b) := by
    rw [← Complex.exp_add]
    have : 2 * Real.pi * Complex.I * (s : ℂ) / 2 ^ b + -(2 * Real.pi * Complex.I * (z : ℂ)) / 2 ^ b =
        (q : ℂ) * (2 * Real.pi * Complex.I) + -(2 * Real.pi * Complex.I * (y : ℂ)) / 2 ^ b := by
      linear_combination (2 * Real.pi * Complex.I * ((2 : ℂ) ^ b)⁻¹) * hqC +
        (2 * Real.pi * Complex.I * (q : ℂ)) * h1
    rw [this, Complex.exp_add, Complex.exp_nat_mul_two_pi_mul_I, one_mul]
  rw [← e1]
  ring

/-! ### Generic exact phase kick -/

/-- Kraus-witness form of the generic exact phase kick (QC14 A2): the step list's Kraus lower
bound acts as `phaseUnitary k b f` on every catalyst ket with clean scratch. -/
theorem catKet_kick_compileList {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)]
    {k m b : ℕ} (v : Var) (ss : List (Step n))
    (rT : QRegister k n) (rS : QRegister m n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (hdisj : rT.DisjointWires (rS.concat rCat hsc))
    (f : Fin (2 ^ k) → ℕ)
    (hrun : ∀ β, localIdx rS β = 0 → runList ss β = some (writeReg β rCat (basisBits b
        ⟨(localIdx rCat β + f (localIdx rT β)) % 2 ^ b, Nat.mod_lt _ (by positivity)⟩))) :
    ∃ R : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ, LowerKraus (compileList v ss).compile R ∧
      ∀ β, localIdx (rS.concat rCat hsc) β = 0 →
        R *ᵥ catalystKet rCat β = (rT.embedUnitary (phaseUnitary k b f)).1 *ᵥ catalystKet rCat β := by
  obtain ⟨R, hR, hRrun, -⟩ := exists_lowerKraus_compileList v ss
  refine ⟨R, hR, ?_⟩
  intro β hβ
  obtain ⟨hTC, -⟩ := disjoint_cat rT rS rCat hsc hdisj
  have hCT : rCat.DisjointWires rT := QRegister.disjoint_comm.mp hTC
  have hCS : rCat.DisjointWires rS := QRegister.disjoint_comm.mp hsc
  have hS := (localIdx_concat_zero rS rCat hsc β hβ).1
  set t := localIdx rT β with ht
  have hL : R *ᵥ catalystKet rCat β = ∑ y : Fin (2 ^ b), phaseGradientState b y •
      ket (writeReg β rCat (basisBits b
        ⟨((y : ℕ) + f t) % 2 ^ b, Nat.mod_lt _ (by positivity)⟩)) := by
    unfold catalystKet
    rw [Matrix.mulVec_sum]
    refine Finset.sum_congr rfl fun y _ ↦ ?_
    rw [Matrix.mulVec_smul]
    congr 1
    apply hRrun
    have h1 : localIdx rS (writeReg β rCat (basisBits b y)) = 0 := by
      rw [localIdx_writeReg_of_disjoint β rCat rS hCS, hS]
    have e1 : localIdx rCat (writeReg β rCat (basisBits b y)) = y := by
      rw [localIdx_writeReg, basisBitsEquiv_symm_basisBits]
    have e2 : localIdx rT (writeReg β rCat (basisBits b y)) = t :=
      localIdx_writeReg_of_disjoint β rCat rT hCT _
    rw [hrun _ h1]
    simp only [e1, e2, writeReg_writeReg]
  have hE : ∀ γ : BitAssignment n, (rT.embedUnitary (phaseUnitary k b f)).1 *ᵥ ket γ =
      Complex.exp (2 * Real.pi * Complex.I * (f (localIdx rT γ) : ℂ) / 2 ^ b) • ket γ := by
    intro γ
    rw [QRegister.embedUnitary_val, embedMatrix_mulVec_ket, phaseUnitary_val,
      Finset.sum_eq_single (localIdx rT γ)]
    · simp only [Matrix.diagonal_apply_eq, writeReg_localIdx_self]
    · intro l _ hl
      rw [Matrix.diagonal_apply_ne _ hl, zero_smul]
    · intro h
      exact absurd (Finset.mem_univ _) h
  set e := Complex.exp (2 * Real.pi * Complex.I * (f t : ℂ) / 2 ^ b) with he
  have hR2 : (rT.embedUnitary (phaseUnitary k b f)).1 *ᵥ catalystKet rCat β =
      ∑ y : Fin (2 ^ b), phaseGradientState b y • (e • ket (writeReg β rCat (basisBits b y))) := by
    unfold catalystKet
    rw [Matrix.mulVec_sum]
    refine Finset.sum_congr rfl fun y _ ↦ ?_
    rw [Matrix.mulVec_smul, hE, localIdx_writeReg_of_disjoint β rCat rT hCT]
  rw [hL, hR2]
  set c : Fin (2 ^ b) := ⟨f t % 2 ^ b, Nat.mod_lt _ (by positivity)⟩ with hc
  have hFin : ∀ y : Fin (2 ^ b),
      (⟨((y : ℕ) + f t) % 2 ^ b, Nat.mod_lt _ (by positivity)⟩ : Fin (2 ^ b)) = y + c := by
    intro y
    apply Fin.ext
    rw [Fin.val_add]
    simp only [hc]
    exact (Nat.add_mod_mod _ _ _).symm
  calc ∑ y : Fin (2 ^ b), phaseGradientState b y •
        ket (writeReg β rCat (basisBits b
          ⟨((y : ℕ) + f t) % 2 ^ b, Nat.mod_lt _ (by positivity)⟩))
      = ∑ y : Fin (2 ^ b), (e * phaseGradientState b (y + c)) •
          ket (writeReg β rCat (basisBits b (y + c))) := by
        refine Finset.sum_congr rfl fun y _ ↦ ?_
        rw [hFin y, phaseGradient_shift b y (y + c) (f t)
          (by rw [← hFin y])]
    _ = ∑ z : Fin (2 ^ b), (e * phaseGradientState b z) •
          ket (writeReg β rCat (basisBits b z)) :=
        Equiv.sum_comp (Equiv.addRight c)
          (fun z ↦ (e * phaseGradientState b z) • ket (writeReg β rCat (basisBits b z)))
    _ = _ := by
        refine Finset.sum_congr rfl fun z _ ↦ ?_
        rw [smul_smul, mul_comm]

/-- Generic exact phase kick: a step list that, on clean scratch, adds `f(target)` into the
catalyst modulo `2^b` and leaves every other wire unchanged realizes `phaseUnitary k b f`
catalytically. -/
theorem catalytic_kick_compileList {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)]
    {k m b : ℕ} (v : Var) (ss : List (Step n))
    (rT : QRegister k n) (rS : QRegister m n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (hdisj : rT.DisjointWires (rS.concat rCat hsc))
    (f : Fin (2 ^ k) → ℕ)
    (hrun : ∀ β, localIdx rS β = 0 → runList ss β = some (writeReg β rCat (basisBits b
        ⟨(localIdx rCat β + f (localIdx rT β)) % 2 ^ b, Nat.mod_lt _ (by positivity)⟩))) :
    RealizesCatalyticSubroutine rT rS rCat hsc hdisj (phaseUnitary k b f)
      (compileList v ss).compile := by
  obtain ⟨R, hR, hk⟩ := catKet_kick_compileList v ss rT rS rCat hsc hdisj f hrun
  exact catalytic_of_lowerKraus_phi rT rS rCat hsc hdisj (phaseUnitary k b f) hR hk

/-! ### The constant kick -/

/-- The data register `rCat` (least significant first) followed by the wire of `rT`, as a
`(1 + b)`-wire register. -/
def dataReg {b : ℕ} (rCat : QRegister b n) (rT : QRegister 1 n) (h : rCat.DisjointWires rT) :
    QRegister (1 + b) n :=
  (rCat.concat rT h).compose ⟨⟨Fin.cast (Nat.add_comm 1 b), Fin.cast_injective _⟩⟩

theorem dataReg_apply_lt {b : ℕ} (rCat : QRegister b n) (rT : QRegister 1 n)
    (h : rCat.DisjointWires rT) (i : Fin (1 + b)) (hi : i.val < b) :
    dataReg rCat rT h i = rCat ⟨i, hi⟩ :=
  QRegister.concat_apply_left rCat rT h ⟨i, hi⟩

theorem dataReg_apply_ctrl {b : ℕ} (rCat : QRegister b n) (rT : QRegister 1 n)
    (h : rCat.DisjointWires rT) (i : Fin (1 + b)) (hi : i.val = b) :
    dataReg rCat rT h i = rT 0 := by
  show (rCat.concat rT h) (Fin.cast (Nat.add_comm 1 b) i) = _
  rw [show Fin.cast (Nat.add_comm 1 b) i = Fin.natAdd b 0 from Fin.ext (by simp [hi])]
  exact QRegister.concat_apply_right rCat rT h 0

theorem dataReg_slice_low {b : ℕ} (rCat : QRegister b n) (rT : QRegister 1 n)
    (h : rCat.DisjointWires rT) :
    (dataReg rCat rT h).slice 0 b (by omega) = rCat := by
  apply QRegister.ext
  apply Function.Embedding.ext
  intro i
  exact (dataReg_apply_lt rCat rT h ⟨0 + i.val, by omega⟩ (by simp)).trans
    (congrArg rCat (Fin.ext (by simp)))

theorem dataReg_disjoint {b : ℕ} (rCat : QRegister b n) (rT : QRegister 1 n)
    (rS : QRegister (2 * b) n) (hcT : rCat.DisjointWires rT) (hsc : rS.DisjointWires rCat)
    (hdisj : rT.DisjointWires (rS.concat rCat hsc)) :
    (dataReg rCat rT hcT).DisjointWires rS := by
  obtain ⟨-, hTS⟩ := disjoint_cat rT rS rCat hsc hdisj
  rw [QRegister.disjoint_iff]
  intro i j
  by_cases hi : i.val < b
  · rw [dataReg_apply_lt rCat rT hcT i hi]
    exact (hsc.ne j ⟨i, hi⟩).symm
  · rw [dataReg_apply_ctrl rCat rT hcT i (by omega)]
    exact hTS.ne 0 j

/-- Phase-kick program for a classical constant `a`: QC9's controlled constant adder with the
catalyst `rCat` as its `b` target wires (least significant first) and the single wire of `rT` as
its control, scratch `rS`. The data register is `rCat` followed by the wire of `rT`. -/
noncomputable def kickConstProgram {Var : Type} (v : Var) (b : ℕ) (a : Fin (2 ^ b))
    (rT : QRegister 1 n) (rS : QRegister (2 * b) n) (rCat : QRegister b n)
    (hcT : rCat.DisjointWires rT) : DynamicCircuit Var n :=
  compileList v
    (ControlledAddConstantImpl.controlledAddConstantSteps b a (dataReg rCat rT hcT) rS)

theorem kickConst_run {b : ℕ} (a : Fin (2 ^ b)) (rT : QRegister 1 n)
    (rS : QRegister (2 * b) n) (rCat : QRegister b n) (hcT : rCat.DisjointWires rT)
    (hsc : rS.DisjointWires rCat) (hdisj : rT.DisjointWires (rS.concat rCat hsc))
    (β : BitAssignment n) (hβ : localIdx rS β = 0) :
    runList (ControlledAddConstantImpl.controlledAddConstantSteps b a (dataReg rCat rT hcT) rS)
        β =
      some (writeReg β rCat (basisBits b
        ⟨(localIdx rCat β + (localIdx rT β).val * a.val) % 2 ^ b,
          Nat.mod_lt _ (by positivity)⟩)) := by
  have hDS := dataReg_disjoint rCat rT rS hcT hsc hdisj
  cases b with
  | zero =>
    have hw : ∀ γ : BitAssignment 0, writeReg β rCat γ = β := fun γ ↦ by
      rw [show γ = fun i ↦ β (rCat i) from funext fun i ↦ i.elim0]
      exact writeReg_self β rCat
    rw [ControlledAddConstantImpl.controlledAddConstantSteps, runList_nil, hw]
  | succ K =>
    rw [ControlledAddConstantImpl.runList_controlledAddConstantSteps (K + 1) a
      (dataReg rCat rT hcT) rS hDS (tableAddPerm (controlledConstant a))
      (ControlledAddConstantImpl.tableAddPerm_controlledConstant_val a) β hβ]
    refine congrArg some ?_
    have hj := localIdx_val_split (dataReg rCat rT hcT) (K + 1) 1 (by omega) β
    have h0 : localIdx ((dataReg rCat rT hcT).slice 0 (K + 1) (by omega)) β =
        localIdx rCat β := by rw [dataReg_slice_low]
    have hw : (localIdx ((dataReg rCat rT hcT).slice (K + 1) 1 (by omega)) β : ℕ) =
        (localIdx rT β : ℕ) := by
      rw [localIdx_one, localIdx_one]
      congr 1
      exact congrArg β (dataReg_apply_ctrl rCat rT hcT ⟨K + 1, by omega⟩ rfl)
    have key := ControlledAddConstantImpl.writeReg_low_eq K (dataReg rCat rT hcT) β
      ⟨(localIdx rCat β + (localIdx rT β).val * a.val) % 2 ^ (K + 1),
        Nat.mod_lt _ (by positivity)⟩
      (tableAddPerm (controlledConstant a) (localIdx (dataReg rCat rT hcT) β)) (by
        rw [ControlledAddConstantImpl.tableAddPerm_controlledConstant_val]
        rw [h0, hw] at hj
        rw [hj]
        have hU := (localIdx rCat β).isLt
        have hT := (localIdx rT β).isLt
        simp only [pow_one] at hT
        dsimp only
        generalize (localIdx rCat β : ℕ) = U at *
        generalize (localIdx rT β : ℕ) = T at *
        have e1 : (U + 2 ^ (K + 1) * T) % 2 ^ (K + 1) = U := by
          rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hU]
        have e2 : (U + 2 ^ (K + 1) * T) / 2 ^ (K + 1) = T := by
          rw [Nat.add_mul_div_left _ _ (by positivity), Nat.div_eq_of_lt hU, zero_add]
        rw [e1, e2]
        rcases (by omega : T = 0 ∨ T = 1) with h | h <;> simp [h] <;>
          first
          | exact hw.trans h
          | exact Fin.ext (by rw [hw, h]; rfl))
    rw [dataReg_slice_low] at key
    exact key.symm

/-- The constant kick realizes `diag(1, exp(2πi a / 2^b))` on the control qubit. -/
theorem kickConst_catalytic {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (b : ℕ)
    (a : Fin (2 ^ b)) (rT : QRegister 1 n) (rS : QRegister (2 * b) n) (rCat : QRegister b n)
    (hcT : rCat.DisjointWires rT) (hsc : rS.DisjointWires rCat)
    (hdisj : rT.DisjointWires (rS.concat rCat hsc)) :
    RealizesCatalyticSubroutine rT rS rCat hsc hdisj
      (phaseUnitary 1 b fun j ↦ j.val * a.val)
      (kickConstProgram v b a rT rS rCat hcT).compile :=
  catalytic_kick_compileList v _ rT rS rCat hsc hdisj (fun j ↦ j.val * a.val)
    (fun β hβ ↦ kickConst_run a rT rS rCat hcT hsc hdisj β hβ)

/-- Cost of the constant kick: QC9's bound, no `TOFF`. -/
theorem kickConst_count {Var : Type} (v : Var) (b : ℕ) (a : Fin (2 ^ b))
    (rT : QRegister 1 n) (rS : QRegister (2 * b) n) (rCat : QRegister b n)
    (hcT : rCat.DisjointWires rT) :
    (kickConstProgram v b a rT rS rCat hcT).count PrimitiveGate.TOFF = 0 ∧
      (kickConstProgram v b a rT rS rCat hcT).count PrimitiveGate.T ≤ 4 * (b - 1) := by
  unfold kickConstProgram
  refine ⟨count_TOFF_compileList v _, ?_⟩
  have h := count_T_compileList v
    (ControlledAddConstantImpl.controlledAddConstantSteps b a (dataReg rCat rT hcT) rS)
  exact h.trans (le_of_eq (congrArg (4 * ·)
    (ControlledAddConstantImpl.andCount_controlledAddConstantSteps b a _ _)))

end QC14.Catalytic


/-! Inlined from lane module `THC/Reuse/SpinSegregationGivens.lean`. -/

namespace QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.GivensOps

open Operator Matrix Circuit QuantumComputation.Specs
open scoped Matrix Circuit.Notation

local instance (priority := 100000) instNeZeroTwoPowLocal (k : ℕ) : NeZero (2 ^ k) :=
  ⟨Nat.pos_iff_ne_zero.mp (Nat.two_pow_pos k)⟩

/-! ## Section 1: Two-Qubit Register & Jordan–Wigner Parity Factoring -/

/-- Ordered two-wire register selecting adjacent physical wires `(j, j + 1)`. -/
def pairAdj (n j : ℕ) (hj : j + 1 < n) : QRegister 2 n :=
  QRegister.pair ⟨j, by omega⟩ ⟨j + 1, hj⟩ (by
    intro h
    injection h with hv
    omega)

@[simp]
theorem pairAdj_zero (n j : ℕ) (hj : j + 1 < n) :
    pairAdj n j hj 0 = ⟨j, by omega⟩ := rfl

@[simp]
theorem pairAdj_one (n j : ℕ) (hj : j + 1 < n) :
    pairAdj n j hj 1 = ⟨j + 1, hj⟩ := rfl

theorem pairAdj_compose_singleton_zero (n j : ℕ) (hj : j + 1 < n) :
    (pairAdj n j hj).compose (QRegister.singleton 0) = QRegister.singleton ⟨j, by omega⟩ := by
  ext i
  rw [Subsingleton.elim i 0]
  rfl

theorem pairAdj_compose_singleton_one (n j : ℕ) (hj : j + 1 < n) :
    (pairAdj n j hj).compose (QRegister.singleton 1) = QRegister.singleton ⟨j + 1, hj⟩ := by
  ext i
  rw [Subsingleton.elim i 0]
  rfl

theorem singleton_disjoint_pairAdj {n j : ℕ} (hj : j + 1 < n) {q : Fin n}
    (hq0 : q.val ≠ j) (hq1 : q.val ≠ j + 1) :
    (QRegister.singleton q).DisjointWires (pairAdj n j hj) := by
  rw [QRegister.disjoint_iff]
  intro a b hab
  rw [Subsingleton.elim a 0] at hab
  match b with
  | ⟨0, _⟩ =>
      have hv : q.val = j := congrArg Fin.val hab
      exact hq0 hv
  | ⟨1, _⟩ =>
      have hv : q.val = j + 1 := congrArg Fin.val hab
      exact hq1 hv

theorem pairAdj_embedMatrix_comm_singleton {n j : ℕ} (hj : j + 1 < n) {q : Fin n}
    (hq0 : q.val ≠ j) (hq1 : q.val ≠ j + 1) (A : Operator 4) (B : Operator 2) :
    (pairAdj n j hj).embedMatrix A * (QRegister.singleton q).embedMatrix B =
      (QRegister.singleton q).embedMatrix B * (pairAdj n j hj).embedMatrix A :=
  QRegister.embedMatrix_comm_of_disjoint (pairAdj n j hj) (QRegister.singleton q)
    (QRegister.disjoint_comm.mp (singleton_disjoint_pairAdj hj hq0 hq1)) A B

/-- Single-qubit Pauli-`Z` embedded at wire `r` of an `n`-qubit system. -/
noncomputable def embedPauliZ (n : ℕ) (r : Fin n) : Operator (2 ^ n) :=
  (QRegister.singleton r).embedMatrix Qubit.Z.1

/-- Single-qubit lowering matrix `|0⟩⟨1|` embedded at wire `r` of an `n`-qubit system. -/
noncomputable def embedLower (n : ℕ) (r : Fin n) : Operator (2 ^ n) :=
  (QRegister.singleton r).embedMatrix (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℂ))

theorem qubitZ_eq_diagonal :
    Qubit.Z.1 = Matrix.diagonal (fun b : Fin 2 ↦ (-1 : ℂ) ^ b.val) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Qubit.Z]

theorem extractIndex_singleton_val {n : ℕ} (r : Fin n) (i : Fin (2 ^ n)) :
    ((QRegister.singleton r).extractIndex i).val = (basisBits n i r).val := by
  have hb := QRegister.basisBits_extractIndex (QRegister.singleton r) i 0
  have h0 : basisBits 1 ((QRegister.singleton r).extractIndex i) 0 =
      (((QRegister.singleton r).extractIndex i).val : ZMod 2) := by
    rw [basisBits_eq_div_mod]
    have hlt : ((QRegister.singleton r).extractIndex i).val < 2 :=
      ((QRegister.singleton r).extractIndex i).isLt
    simp [Nat.mod_eq_of_lt hlt]
  have hval := congrArg ZMod.val (h0.symm.trans hb)
  have hlt : ((QRegister.singleton r).extractIndex i).val < 2 :=
    ((QRegister.singleton r).extractIndex i).isLt
  simpa [ZMod.val_natCast, Nat.mod_eq_of_lt hlt] using hval

theorem embedPauliZ_eq_diagonal (n : ℕ) (r : Fin n) :
    embedPauliZ n r = Matrix.diagonal (fun i : Fin (2 ^ n) ↦ (-1 : ℂ) ^ (basisBits n i r).val) := by
  unfold embedPauliZ
  rw [qubitZ_eq_diagonal, QRegister.embedMatrix_diagonal]
  ext i j
  by_cases hij : i = j
  · subst hij
    simp [extractIndex_singleton_val]
  · simp [hij]

/-- Finite product of diagonal matrices over any `Finset` (commuting automatically). -/
noncomputable def zString (n : ℕ) (s : Finset (Fin n)) : Operator (2 ^ n) :=
  Matrix.diagonal (fun i : Fin (2 ^ n) ↦ (-1 : ℂ) ^ ∑ r ∈ s, (basisBits n i r).val)

theorem zString_empty (n : ℕ) : zString n ∅ = 1 := by
  ext i j
  by_cases hij : i = j
  · subst hij
    simp [zString]
  · simp [zString, hij]

theorem zString_singleton (n : ℕ) (r : Fin n) :
    zString n {r} = embedPauliZ n r := by
  rw [embedPauliZ_eq_diagonal]
  ext i j
  by_cases hij : i = j <;> simp [zString, hij]

theorem zString_union_disjoint {n : ℕ} {s t : Finset (Fin n)} (hd : Disjoint s t) :
    zString n (s ∪ t) = zString n s * zString n t := by
  unfold zString
  rw [Matrix.diagonal_mul_diagonal]
  congr 1
  ext i
  rw [Finset.sum_union hd, pow_add]

theorem jwAnnihilate_eq_zString_mul (n : ℕ) (q : Fin n) :
    jwAnnihilate n q = zString n (Finset.univ.filter (· < q)) * embedLower n q := rfl

/-- If every wire in `s` avoids `{j, j + 1}`, `zString n s` commutes with any operator embedded on
`pairAdj n j hj`. -/
theorem zString_comm_pairAdj {n j : ℕ} (hj : j + 1 < n) {s : Finset (Fin n)}
    (hs : ∀ r ∈ s, r.val ≠ j ∧ r.val ≠ j + 1) (A : Operator 4) :
    (pairAdj n j hj).embedMatrix A * zString n s =
      zString n s * (pairAdj n j hj).embedMatrix A := by
  induction s using Finset.cons_induction with
  | empty => simp [zString_empty]
  | cons a t hat ih =>
      have hdisj_at : Disjoint ({a} : Finset (Fin n)) t := by simp [hat]
      have hcons : Finset.cons a t hat = {a} ∪ t := by
        rw [Finset.cons_eq_insert, Finset.insert_eq]
      rw [hcons, zString_union_disjoint hdisj_at, zString_singleton]
      have ha := hs a (by simp)
      have hcomm_a :
          (pairAdj n j hj).embedMatrix A * embedPauliZ n a =
            embedPauliZ n a * (pairAdj n j hj).embedMatrix A :=
        pairAdj_embedMatrix_comm_singleton hj ha.1 ha.2 A Qubit.Z.1
      have hcomm_t :
          (pairAdj n j hj).embedMatrix A * zString n t =
            zString n t * (pairAdj n j hj).embedMatrix A :=
        ih (fun r hr ↦ hs r (by simp [hr]))
      calc
        (pairAdj n j hj).embedMatrix A * (embedPauliZ n a * zString n t)
            = ((pairAdj n j hj).embedMatrix A * embedPauliZ n a) * zString n t := by
                rw [Matrix.mul_assoc]
        _ = embedPauliZ n a * ((pairAdj n j hj).embedMatrix A * zString n t) := by
                rw [hcomm_a, Matrix.mul_assoc]
        _ = (embedPauliZ n a * zString n t) * (pairAdj n j hj).embedMatrix A := by
                rw [hcomm_t, Matrix.mul_assoc]

/-! ## Section 2: Local Two-Qubit Fermionic Modes (`localA0`, `localZ0`, `localA1`) -/

/-- Local two-qubit Jordan–Wigner operators on `Fin 4`. -/
noncomputable def localA0 : Operator 4 :=
  (QRegister.singleton (0 : Fin 2)).embedMatrix (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℂ))

noncomputable def localZ0 : Operator 4 :=
  (QRegister.singleton (0 : Fin 2)).embedMatrix Qubit.Z.1

noncomputable def localA1 : Operator 4 :=
  (QRegister.singleton (1 : Fin 2)).embedMatrix (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℂ))

theorem pairAdj_embed_localA0 (n j : ℕ) (hj : j + 1 < n) :
    (pairAdj n j hj).embedMatrix localA0 = embedLower n ⟨j, by omega⟩ := by
  unfold localA0 embedLower
  rw [← QRegister.embedMatrix_compose, pairAdj_compose_singleton_zero]

theorem pairAdj_embed_localA1 (n j : ℕ) (hj : j + 1 < n) :
    (pairAdj n j hj).embedMatrix localA1 = embedLower n ⟨j + 1, hj⟩ := by
  unfold localA1 embedLower
  rw [← QRegister.embedMatrix_compose, pairAdj_compose_singleton_one]

theorem pairAdj_embed_localZ0 (n j : ℕ) (hj : j + 1 < n) :
    (pairAdj n j hj).embedMatrix localZ0 = embedPauliZ n ⟨j, by omega⟩ := by
  unfold localZ0 embedPauliZ
  rw [← QRegister.embedMatrix_compose, pairAdj_compose_singleton_zero]

theorem filter_lt_j_plus_one {n j : ℕ} (hj : j + 1 < n) :
    Finset.univ.filter (fun r : Fin n ↦ r < ⟨j + 1, hj⟩) =
      Finset.univ.filter (fun r : Fin n ↦ r < ⟨j, by omega⟩) ∪ {⟨j, by omega⟩} := by
  ext r
  simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_union,
    Finset.mem_singleton, Fin.lt_def, Fin.ext_iff]
  omega

theorem jwAnnihilate_at_pair_zero {n j : ℕ} (hj : j + 1 < n) :
    jwAnnihilate n ⟨j, by omega⟩ =
      zString n (Finset.univ.filter (fun r : Fin n ↦ r < ⟨j, by omega⟩)) *
        (pairAdj n j hj).embedMatrix localA0 := by
  rw [jwAnnihilate_eq_zString_mul, pairAdj_embed_localA0]

theorem jwAnnihilate_at_pair_one {n j : ℕ} (hj : j + 1 < n) :
    jwAnnihilate n ⟨j + 1, hj⟩ =
      zString n (Finset.univ.filter (fun r : Fin n ↦ r < ⟨j, by omega⟩)) *
        (pairAdj n j hj).embedMatrix (localZ0 * localA1) := by
  rw [jwAnnihilate_eq_zString_mul, filter_lt_j_plus_one hj]
  have hd : Disjoint (Finset.univ.filter (fun r : Fin n ↦ r < ⟨j, by omega⟩))
      ({⟨j, by omega⟩} : Finset (Fin n)) := by
    rw [Finset.disjoint_singleton_right]
    simp
  rw [zString_union_disjoint hd, zString_singleton, QRegister.embedMatrix_mul,
    pairAdj_embed_localZ0, pairAdj_embed_localA1, Matrix.mul_assoc]

/-! ## Section 4: `cz2Circuit`, `fswap2Circuit` & `fswapAdjCircuit` -/

private theorem unitary_val_mul {d : ℕ} (U V : Operator.Unitary d) :
    (U * V).1 = U.1 * V.1 := rfl

private theorem extractIndex_singleton0 (x : Fin 4) :
    (QRegister.singleton (0 : Wire 2)).extractIndex x = ⟨x.val % 2, Nat.mod_lt _ (by decide)⟩ := by
  fin_cases x <;> apply Fin.ext <;> rw [extractIndex_singleton_val, basisBits_eq_div_mod] <;>
    decide

private theorem extractIndex_singleton1 (x : Fin 4) :
    (QRegister.singleton (1 : Wire 2)).extractIndex x =
      ⟨(x.val / 2) % 2, Nat.mod_lt _ (by decide)⟩ := by
  fin_cases x <;> apply Fin.ext <;> rw [extractIndex_singleton_val, basisBits_eq_div_mod] <;>
    decide

private theorem env_singleton0_iff (i j : Fin 4) :
    (((QRegister.singleton (0 : Wire 2)).basisSplitEquiv i).2 =
      ((QRegister.singleton (0 : Wire 2)).basisSplitEquiv j).2) ↔
      i.val / 2 = j.val / 2 := by
  rw [QRegister.singleton_zero_basisSplit_environment_eq_iff]
  fin_cases i <;> fin_cases j <;> decide

private theorem env_singleton1_iff (i j : Fin 4) :
    (((QRegister.singleton (1 : Wire 2)).basisSplitEquiv i).2 =
      ((QRegister.singleton (1 : Wire 2)).basisSplitEquiv j).2) ↔
      i.val % 2 = j.val % 2 := by
  rw [QRegister.singleton_one_basisSplit_environment_eq_iff]
  fin_cases i <;> fin_cases j <;> decide

private theorem singleton0_embedMatrix_apply (A : Operator 2) (i j : Fin (2 ^ 2)) :
    (QRegister.singleton (0 : Wire 2)).embedMatrix A i j =
      if i.val / 2 = j.val / 2 then
        A ⟨i.val % 2, Nat.mod_lt _ (by decide)⟩ ⟨j.val % 2, Nat.mod_lt _ (by decide)⟩
      else 0 := by
  rw [QRegister.embedMatrix_apply, extractIndex_singleton0 i, extractIndex_singleton0 j]
  by_cases h : ((QRegister.singleton (0 : Wire 2)).basisSplitEquiv i).2 =
      ((QRegister.singleton (0 : Wire 2)).basisSplitEquiv j).2
  · simp only [h, (env_singleton0_iff i j).mp h, ↓reduceIte, mul_one]
  · have h' : ¬ (i.val / 2 = j.val / 2) := mt (env_singleton0_iff i j).mpr h
    simp only [h, h', ↓reduceIte, mul_zero]

private theorem singleton1_embedMatrix_apply (A : Operator 2) (i j : Fin (2 ^ 2)) :
    (QRegister.singleton (1 : Wire 2)).embedMatrix A i j =
      if i.val % 2 = j.val % 2 then
        A ⟨(i.val / 2) % 2, Nat.mod_lt _ (by decide)⟩ ⟨(j.val / 2) % 2, Nat.mod_lt _ (by decide)⟩
      else 0 := by
  rw [QRegister.embedMatrix_apply, extractIndex_singleton1 i, extractIndex_singleton1 j]
  by_cases h : ((QRegister.singleton (1 : Wire 2)).basisSplitEquiv i).2 =
      ((QRegister.singleton (1 : Wire 2)).basisSplitEquiv j).2
  · simp only [h, (env_singleton1_iff i j).mp h, ↓reduceIte, mul_one]
  · have h' : ¬ (i.val % 2 = j.val % 2) := mt (env_singleton1_iff i j).mpr h
    simp only [h, h', ↓reduceIte, mul_zero]

private theorem localA0_apply (i j : Fin 4) :
    localA0 i j =
      if i.val / 2 = j.val / 2 then
        Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℂ)
          ⟨i.val % 2, Nat.mod_lt _ (by decide)⟩ ⟨j.val % 2, Nat.mod_lt _ (by decide)⟩
      else 0 :=
  singleton0_embedMatrix_apply _ i j

private theorem localZ0_apply (i j : Fin 4) :
    localZ0 i j =
      if i.val / 2 = j.val / 2 then
        Qubit.Z.1 ⟨i.val % 2, Nat.mod_lt _ (by decide)⟩ ⟨j.val % 2, Nat.mod_lt _ (by decide)⟩
      else 0 :=
  singleton0_embedMatrix_apply _ i j

private theorem localA1_apply (i j : Fin 4) :
    localA1 i j =
      if i.val % 2 = j.val % 2 then
        Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℂ)
          ⟨(i.val / 2) % 2, Nat.mod_lt _ (by decide)⟩ ⟨(j.val / 2) % 2, Nat.mod_lt _ (by decide)⟩
      else 0 :=
  singleton1_embedMatrix_apply _ i j

/-! ## Section 5: General `fSWAP` Networks & `spinSegregateCircuit N` -/

/-! ## Section 6: Segregated Orbital Operators, Zero-`CZ` Spin-Block Factorization & Spin Swap -/

/-- Orbital number operator on a single `N`-qubit spin block. -/
noncomputable def singleSpinOrbitalNumberOp (N : ℕ) (u : Fin N → ℝ) : Operator (2 ^ N) :=
  let b := ∑ p : Fin N, (u p : ℂ) • jwAnnihilate N p
  bᴴ * b

/-! ## Section 7: Two-Qubit Givens Unitary & `givensLeaf` Reflection Bridge -/

/-- Exact 4×4 single-excitation Givens unitary `G_4(φ)` in little-endian basis
(`|0⟩ = (0,0)`, `|1⟩ = (1,0)`, `|2⟩ = (0,1)`, `|3⟩ = (1,1)`), fixing `|0⟩, |3⟩` and rotating
`|1⟩ ↦ cos φ |1⟩ - sin φ |2⟩`, `|2⟩ ↦ sin φ |1⟩ + cos φ |2⟩`. -/
noncomputable def givensPlaneMatrix (φ : ℝ) : Operator 4 :=
  !![1, 0, 0, 0;
     0, (Real.cos φ : ℂ), (Real.sin φ : ℂ), 0;
     0, (-(Real.sin φ) : ℂ), (Real.cos φ : ℂ), 0;
     0, 0, 0, 1]

private theorem star_complex_cos_ofReal (φ : ℝ) :
    (starRingEnd ℂ) (Complex.cos (φ : ℂ)) = Complex.cos (φ : ℂ) := by
  rw [← Complex.ofReal_cos]
  exact Complex.conj_ofReal (Real.cos φ)

private theorem star_complex_sin_ofReal (φ : ℝ) :
    (starRingEnd ℂ) (Complex.sin (φ : ℂ)) = Complex.sin (φ : ℂ) := by
  rw [← Complex.ofReal_sin]
  exact Complex.conj_ofReal (Real.sin φ)

theorem givensPlaneMatrix_conjTranspose_mul_self (φ : ℝ) :
    (givensPlaneMatrix φ)ᴴ * givensPlaneMatrix φ = 1 := by
  have hcs : Complex.cos (φ : ℂ) ^ 2 + Complex.sin (φ : ℂ) ^ 2 = 1 :=
    Complex.cos_sq_add_sin_sq (φ : ℂ)
  ext i j
  simp only [Matrix.mul_apply, Fin.sum_univ_four]
  fin_cases i <;> fin_cases j <;>
    simp [givensPlaneMatrix, star_complex_cos_ofReal, star_complex_sin_ofReal]
  · linear_combination hcs
  · ring
  · ring
  · linear_combination hcs

/-- Bundled two-qubit Givens unitary `G_4(φ) : Unitary 4`. -/
noncomputable def givensPlaneUnitary (φ : ℝ) : Unitary 4 :=
  ⟨givensPlaneMatrix φ, by
    rw [Matrix.mem_unitaryGroup_iff']
    simpa [Matrix.star_eq_conjTranspose] using givensPlaneMatrix_conjTranspose_mul_self φ⟩

@[simp]
theorem givensPlaneUnitary_val (φ : ℝ) :
    (givensPlaneUnitary φ).1 = givensPlaneMatrix φ := rfl

theorem givensPlane_conj_localA0 (φ : ℝ) :
    (givensPlaneMatrix φ)ᴴ * localA0 * givensPlaneMatrix φ =
      (Real.cos φ : ℂ) • localA0 + (Real.sin φ : ℂ) • (localZ0 * localA1) := by
  ext i j
  simp only [Matrix.mul_apply, Fin.sum_univ_four, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
  fin_cases i <;> fin_cases j <;>
    simp [givensPlaneMatrix, localA0_apply, localZ0_apply, localA1_apply, Qubit.Z,
      star_complex_cos_ofReal, star_complex_sin_ofReal]

/-- **Fused-Apex `p = 0` Identity**: Conjugating `Z_0` on wires `(0, 1)` by `G_4(φ)` equals
`Z_0 * G_4(2 * φ)` (and `G_4(-2 * φ) * Z_0`), collapsing `G_0(φ)ᴴ * Z_0 * G_0(φ)` from two Givens
rotations into **one** double-angle Givens rotation! -/
theorem givensPlane_conj_localZ0_eq_mul_double (φ : ℝ) :
    (givensPlaneMatrix φ)ᴴ * localZ0 * givensPlaneMatrix φ =
      localZ0 * givensPlaneMatrix (2 * φ) := by
  unfold givensPlaneMatrix
  rw [Real.cos_two_mul', Real.sin_two_mul]
  ext i j
  simp only [Matrix.mul_apply, Fin.sum_univ_four]
  fin_cases i <;> fin_cases j <;>
    simp [localZ0_apply, Qubit.Z,
      star_complex_cos_ofReal, star_complex_sin_ofReal] <;>
    ring

/-- Adjacent Givens rotation unitary on wires `(p, p + 1)` of an `N`-qubit register. -/
noncomputable def givensAdjUnitary (N p : ℕ) (hp : p + 1 < N) (φ : ℝ) : Unitary (2 ^ N) :=
  (pairAdj N p hp).embedUnitary (givensPlaneUnitary φ)

theorem givensAdjUnitary_conj_jwAnnihilate_self (N p : ℕ) (hp : p + 1 < N) (φ : ℝ) :
    (givensAdjUnitary N p hp φ).1ᴴ * jwAnnihilate N ⟨p, by omega⟩ * (givensAdjUnitary N p hp φ).1 =
      (Real.cos φ : ℂ) • jwAnnihilate N ⟨p, by omega⟩ +
        (Real.sin φ : ℂ) • jwAnnihilate N ⟨p + 1, hp⟩ := by
  let r := pairAdj N p hp
  simp only [givensAdjUnitary, QRegister.embedUnitary_val, givensPlaneUnitary_val,
    ← QRegister.embedMatrix_conjTranspose]
  rw [jwAnnihilate_at_pair_zero hp, jwAnnihilate_at_pair_one hp]
  have hcommZ :
      r.embedMatrix (givensPlaneMatrix φ)ᴴ *
          zString N (Finset.univ.filter (fun x : Fin N ↦ x < ⟨p, by omega⟩)) =
        zString N (Finset.univ.filter (fun x : Fin N ↦ x < ⟨p, by omega⟩)) *
          r.embedMatrix (givensPlaneMatrix φ)ᴴ := by
    apply zString_comm_pairAdj hp
    intro x hx
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Fin.lt_def] at hx
    omega
  calc
    r.embedMatrix (givensPlaneMatrix φ)ᴴ *
        (zString N (Finset.univ.filter (fun x : Fin N ↦ x < ⟨p, by omega⟩)) *
          r.embedMatrix localA0) * r.embedMatrix (givensPlaneMatrix φ)
        = (r.embedMatrix (givensPlaneMatrix φ)ᴴ *
            zString N (Finset.univ.filter (fun x : Fin N ↦ x < ⟨p, by omega⟩))) *
            (r.embedMatrix localA0 * r.embedMatrix (givensPlaneMatrix φ)) := by
              simp [Matrix.mul_assoc]
    _ = zString N (Finset.univ.filter (fun x : Fin N ↦ x < ⟨p, by omega⟩)) *
          (r.embedMatrix (givensPlaneMatrix φ)ᴴ * r.embedMatrix localA0 *
            r.embedMatrix (givensPlaneMatrix φ)) := by
            rw [hcommZ]; simp [Matrix.mul_assoc]
    _ = zString N (Finset.univ.filter (fun x : Fin N ↦ x < ⟨p, by omega⟩)) *
          r.embedMatrix ((Real.cos φ : ℂ) • localA0 + (Real.sin φ : ℂ) • (localZ0 * localA1)) := by
            rw [← QRegister.embedMatrix_mul, ← QRegister.embedMatrix_mul, givensPlane_conj_localA0]
    _ = (Real.cos φ : ℂ) •
          (zString N (Finset.univ.filter (fun x : Fin N ↦ x < ⟨p, by omega⟩)) *
            r.embedMatrix localA0) +
        (Real.sin φ : ℂ) •
          (zString N (Finset.univ.filter (fun x : Fin N ↦ x < ⟨p, by omega⟩)) *
            r.embedMatrix (localZ0 * localA1)) := by
            rw [QRegister.embedMatrix_add, QRegister.embedMatrix_smul,
              QRegister.embedMatrix_smul, Matrix.mul_add, Algebra.mul_smul_comm,
              Algebra.mul_smul_comm]

theorem givensAdjUnitary_conj_jwAnnihilate_of_lt (N p : ℕ) (hp : p + 1 < N) (φ : ℝ)
    {q : Fin N} (hq : q.val < p) :
    (givensAdjUnitary N p hp φ).1ᴴ * jwAnnihilate N q * (givensAdjUnitary N p hp φ).1 =
      jwAnnihilate N q := by
  let r := pairAdj N p hp
  simp only [givensAdjUnitary, QRegister.embedUnitary_val, givensPlaneUnitary_val,
    ← QRegister.embedMatrix_conjTranspose, jwAnnihilate_eq_zString_mul]
  have hcommZ :
      r.embedMatrix (givensPlaneMatrix φ)ᴴ * zString N (Finset.univ.filter (· < q)) =
        zString N (Finset.univ.filter (· < q)) * r.embedMatrix (givensPlaneMatrix φ)ᴴ := by
    apply zString_comm_pairAdj hp
    intro x hx
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Fin.lt_def] at hx
    omega
  have hcommA :
      r.embedMatrix (givensPlaneMatrix φ)ᴴ * embedLower N q =
        embedLower N q * r.embedMatrix (givensPlaneMatrix φ)ᴴ :=
    pairAdj_embedMatrix_comm_singleton hp (by omega) (by omega) _ _
  calc
    r.embedMatrix (givensPlaneMatrix φ)ᴴ *
        (zString N (Finset.univ.filter (· < q)) * embedLower N q) *
        r.embedMatrix (givensPlaneMatrix φ)
        = (r.embedMatrix (givensPlaneMatrix φ)ᴴ * zString N (Finset.univ.filter (· < q))) *
            embedLower N q * r.embedMatrix (givensPlaneMatrix φ) := by simp [Matrix.mul_assoc]
    _ = zString N (Finset.univ.filter (· < q)) *
          (r.embedMatrix (givensPlaneMatrix φ)ᴴ * embedLower N q) *
          r.embedMatrix (givensPlaneMatrix φ) := by rw [hcommZ]; simp [Matrix.mul_assoc]
    _ = zString N (Finset.univ.filter (· < q)) * embedLower N q *
          (r.embedMatrix (givensPlaneMatrix φ)ᴴ * r.embedMatrix (givensPlaneMatrix φ)) := by
          rw [hcommA]; simp [Matrix.mul_assoc]
    _ = zString N (Finset.univ.filter (· < q)) * embedLower N q := by
          rw [← QRegister.embedMatrix_mul, givensPlaneMatrix_conjTranspose_mul_self,
            QRegister.embedMatrix_one, Matrix.mul_one]

/-- Prefix product `U_m = G_0(φ 0) * G_1(φ 1) * ... * G_{m-1}(φ (m-1))` for `m < N`
(corresponding to circuit execution in reverse plane order `p = m - 1` down to `0`). -/
noncomputable def givensCascadePrefix (N : ℕ) (φ : ℕ → ℝ) : (m : ℕ) → (hm : m < N) → Unitary (2 ^ N)
  | 0, _ => 1
  | m + 1, hm => givensCascadePrefix N φ m (by omega) * givensAdjUnitary N m hm (φ m)

theorem givensCascadePrefix_conj_jwAnnihilate_zero (N : ℕ) (φ : ℕ → ℝ) (m : ℕ) (hm : m < N) :
    (givensCascadePrefix N φ m hm).1ᴴ * jwAnnihilate N ⟨0, by omega⟩ *
        (givensCascadePrefix N φ m hm).1 =
      (∑ p : Fin m, (((∏ q ∈ Finset.range p.val, Real.sin (φ q)) * Real.cos (φ p.val) : ℝ) : ℂ) •
          jwAnnihilate N ⟨p.val, by omega⟩) +
        ((∏ q ∈ Finset.range m, Real.sin (φ q) : ℝ) : ℂ) • jwAnnihilate N ⟨m, hm⟩ := by
  induction m with
  | zero => simp [givensCascadePrefix]
  | succ m ih =>
      simp only [givensCascadePrefix, unitary_val_mul, Matrix.conjTranspose_mul]
      let Gm := givensAdjUnitary N m hm (φ m)
      have hstep :
          Gm.1ᴴ * ((givensCascadePrefix N φ m (by omega)).1ᴴ *
              jwAnnihilate N ⟨0, by omega⟩ * (givensCascadePrefix N φ m (by omega)).1) * Gm.1 =
            Gm.1ᴴ * (givensCascadePrefix N φ m (by omega)).1ᴴ *
              jwAnnihilate N ⟨0, by omega⟩ *
              ((givensCascadePrefix N φ m (by omega)).1 * Gm.1) := by
        simp [Matrix.mul_assoc]
      rw [← hstep, ih (by omega), Matrix.mul_add, Matrix.add_mul]
      have hsum_part :
          Gm.1ᴴ * (∑ p : Fin m,
              (((∏ q ∈ Finset.range p.val, Real.sin (φ q)) * Real.cos (φ p.val) : ℝ) : ℂ) •
                jwAnnihilate N ⟨p.val, by omega⟩) * Gm.1 =
            ∑ p : Fin m,
              (((∏ q ∈ Finset.range p.val, Real.sin (φ q)) * Real.cos (φ p.val) : ℝ) : ℂ) •
                jwAnnihilate N ⟨p.val, by omega⟩ := by
        rw [Finset.mul_sum, Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro p _
        simp only [Algebra.mul_smul_comm, Algebra.smul_mul_assoc]
        congr 1
        exact givensAdjUnitary_conj_jwAnnihilate_of_lt N m hm (φ m) p.isLt
      have htail_part :
          Gm.1ᴴ * (((∏ q ∈ Finset.range m, Real.sin (φ q) : ℝ) : ℂ) •
              jwAnnihilate N ⟨m, by omega⟩) * Gm.1 =
            (((∏ q ∈ Finset.range m, Real.sin (φ q)) * Real.cos (φ m) : ℝ) : ℂ) •
                jwAnnihilate N ⟨m, by omega⟩ +
              ((∏ q ∈ Finset.range (m + 1), Real.sin (φ q) : ℝ) : ℂ) •
                jwAnnihilate N ⟨m + 1, hm⟩ := by
        simp only [Algebra.mul_smul_comm, Algebra.smul_mul_assoc]
        rw [givensAdjUnitary_conj_jwAnnihilate_self N m hm (φ m), smul_add, smul_smul, smul_smul,
          Finset.prod_range_succ]
        push_cast
        rfl
      rw [hsum_part, htail_part, Fin.sum_univ_castSucc]
      simp [add_assoc]

/-- Full `(N - 1)`-plane Givens cascade unitary `G_0(φ_0) ⋯ G_{N-2}(φ_{N-2})` for `givensLeaf b k`,
where `φ_p = 2 * (2 * π * k_p / 2^b) = 2 * π * k_p / 2^(b - 1)`. -/
noncomputable def givensLeafAngle (N b : ℕ) (k : Fin N → ℤ) (q : ℕ) : ℝ :=
  if h : q < N then 2 * (2 * Real.pi * (k ⟨q, h⟩ : ℝ) / 2 ^ b) else 0

noncomputable def givensCascadeUnitary (N : ℕ) [NeZero N] (b : ℕ) (k : Fin N → ℤ) :
    Unitary (2 ^ N) :=
  givensCascadePrefix N (givensLeafAngle N b k) (N - 1)
    (Nat.sub_lt (Nat.pos_of_ne_zero (NeZero.ne N)) Nat.zero_lt_one)

theorem givensCascadeUnitary_conj_jwAnnihilate_zero (N : ℕ) [NeZero N] (b : ℕ) (k : Fin N → ℤ) :
    (givensCascadeUnitary N b k).1ᴴ * jwAnnihilate N ⟨0, Nat.pos_of_ne_zero (NeZero.ne N)⟩ *
        (givensCascadeUnitary N b k).1 =
      ∑ p : Fin N, (givensLeaf b k p : ℂ) • jwAnnihilate N p := by
  obtain ⟨n, rfl⟩ : ∃ n, N = n + 1 := ⟨N - 1, (Nat.succ_pred_eq_of_ne_zero (NeZero.ne N)).symm⟩
  unfold givensCascadeUnitary
  simp only [Nat.add_sub_cancel]
  rw [givensCascadePrefix_conj_jwAnnihilate_zero]
  rw [Fin.sum_univ_castSucc]
  congr 1
  · apply Finset.sum_congr rfl
    intro p _
    have hp_eq : (⟨p.val, by omega⟩ : Fin (n + 1)) = p.castSucc := rfl
    rw [hp_eq]
    congr 1
    congr 1
    have hmap :
        (Finset.univ.filter (· < p.castSucc)).map Fin.valEmbedding = Finset.range p.val := by
      rw [Finset.filter_gt_eq_Iio, Fin.map_valEmbedding_Iio]
      simp [Nat.Iio_eq_range]
    have hprod :
        ∏ q ∈ Finset.univ.filter (· < p.castSucc),
            Real.sin (2 * (2 * Real.pi * (k q : ℝ) / 2 ^ b)) =
          ∏ q ∈ Finset.range p.val, Real.sin (givensLeafAngle (n + 1) b k q) := by
      rw [← hmap, Finset.prod_map]
      apply Finset.prod_congr rfl
      intro q _
      simp [givensLeafAngle, q.isLt]
    rw [← hprod]
    have hp_ne : p.val ≠ n := ne_of_lt p.isLt
    have hlt : p.val < n + 1 := by omega
    simp only [givensLeaf, givensLeafAngle, hlt, ↓reduceDIte, Fin.val_castSucc,
      Nat.add_right_cancel_iff, hp_ne, ↓reduceIte]
    rfl
  · have hlast_eq : (⟨n, by omega⟩ : Fin (n + 1)) = Fin.last n := rfl
    rw [hlast_eq]
    congr 1
    congr 1
    have hlast_val : (Fin.last n).val = n := Fin.val_last n
    have hmap :
        (Finset.univ.filter (· < Fin.last n)).map Fin.valEmbedding = Finset.range n := by
      rw [Finset.filter_gt_eq_Iio, Fin.map_valEmbedding_Iio, hlast_val, Nat.Iio_eq_range]
    have hprod :
        ∏ q ∈ Finset.univ.filter (· < Fin.last n),
            Real.sin (2 * (2 * Real.pi * (k q : ℝ) / 2 ^ b)) =
          ∏ q ∈ Finset.range n, Real.sin (givensLeafAngle (n + 1) b k q) := by
      rw [← hmap, Finset.prod_map]
      apply Finset.prod_congr rfl
      intro q _
      simp [givensLeafAngle, q.isLt]
    rw [← hprod]
    simp [givensLeaf]

private theorem embedMatrix_sub {k n : ℕ} (r : QRegister k n) (A B : Operator (2 ^ k)) :
    r.embedMatrix (A - B) = r.embedMatrix A - r.embedMatrix B := by
  rw [sub_eq_add_neg, ← neg_one_smul ℂ B, r.embedMatrix_add, r.embedMatrix_smul,
    neg_one_smul, ← sub_eq_add_neg]

theorem pauliZ_zero_eq_one_sub_two_numOp (N : ℕ) [NeZero N] :
    (QRegister.singleton (⟨0, Nat.pos_of_ne_zero (NeZero.ne N)⟩ : Fin N)).embedMatrix Qubit.Z.1 =
      1 - (2 : ℂ) • ((jwAnnihilate N ⟨0, Nat.pos_of_ne_zero (NeZero.ne N)⟩)ᴴ *
        jwAnnihilate N ⟨0, Nat.pos_of_ne_zero (NeZero.ne N)⟩) := by
  let z0 : Fin N := ⟨0, Nat.pos_of_ne_zero (NeZero.ne N)⟩
  change (QRegister.singleton z0).embedMatrix Qubit.Z.1 =
    1 - (2 : ℂ) • ((jwAnnihilate N z0)ᴴ * jwAnnihilate N z0)
  have hfilt : Finset.univ.filter (· < z0) = ∅ := by
    ext q
    simp [z0]
  have hjw0 : jwAnnihilate N z0 =
      (QRegister.singleton z0).embedMatrix (Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℂ)) := by
    rw [jwAnnihilate_eq_zString_mul, hfilt, zString_empty, Matrix.one_mul]
    rfl
  rw [hjw0, ← QRegister.embedMatrix_conjTranspose, ← QRegister.embedMatrix_mul,
    ← QRegister.embedMatrix_smul, ← QRegister.embedMatrix_one (QRegister.singleton z0),
    ← embedMatrix_sub]
  congr 1
  change Qubit.Z.1 = (1 : Operator 2) - (2 : ℂ) •
    ((Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℂ))ᴴ *
      Matrix.single (0 : Fin 2) (1 : Fin 2) (1 : ℂ))
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Qubit.Z]
  norm_num

/-- **Master `givensLeaf` Reflection Theorem**: Conjugating Pauli-`Z` on wire `0` of an `N`-qubit
single-spin register by `givensCascadeUnitary N b k` produces the exact orbital reflection
`1 - 2 • singleSpinOrbitalNumberOp N (givensLeaf b k)`. -/
theorem givensCascadeUnitary_conj_pauliZ0 (N : ℕ) [NeZero N] (b : ℕ) (k : Fin N → ℤ) :
    let z0 : Fin N := ⟨0, Nat.pos_of_ne_zero (NeZero.ne N)⟩
    (givensCascadeUnitary N b k).1ᴴ * (QRegister.singleton z0).embedMatrix Qubit.Z.1 *
        (givensCascadeUnitary N b k).1 =
      1 - (2 : ℂ) • singleSpinOrbitalNumberOp N (givensLeaf b k) := by
  intro z0
  let U := givensCascadeUnitary N b k
  have hUU : U.1ᴴ * U.1 = 1 := by
    rw [← Matrix.star_eq_conjTranspose]
    exact U.2.1
  have hUU' : U.1 * U.1ᴴ = 1 := by
    rw [← Matrix.star_eq_conjTranspose]
    exact U.2.2
  change U.1ᴴ * (QRegister.singleton z0).embedMatrix Qubit.Z.1 * U.1 =
    1 - (2 : ℂ) • singleSpinOrbitalNumberOp N (givensLeaf b k)
  rw [pauliZ_zero_eq_one_sub_two_numOp N, Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_one, hUU]
  congr 1
  simp only [Algebra.mul_smul_comm, Algebra.smul_mul_assoc]
  congr 1
  have hconj : U.1ᴴ * jwAnnihilate N z0 * U.1 =
      ∑ p : Fin N, (givensLeaf b k p : ℂ) • jwAnnihilate N p :=
    givensCascadeUnitary_conj_jwAnnihilate_zero N b k
  have hconj_dag :
      U.1ᴴ * (jwAnnihilate N z0)ᴴ * U.1 =
        (∑ p : Fin N, (givensLeaf b k p : ℂ) • jwAnnihilate N p)ᴴ := by
    rw [← hconj]
    simp [Matrix.conjTranspose_mul, Matrix.mul_assoc]
  unfold singleSpinOrbitalNumberOp
  dsimp only []
  rw [← hconj_dag, ← hconj]
  calc
    U.1ᴴ * ((jwAnnihilate N z0)ᴴ * jwAnnihilate N z0) * U.1
        = U.1ᴴ * (jwAnnihilate N z0)ᴴ * (U.1 * U.1ᴴ) * jwAnnihilate N z0 * U.1 := by
            rw [hUU']; simp [Matrix.mul_assoc]
    _ = (U.1ᴴ * (jwAnnihilate N z0)ᴴ * U.1) * (U.1ᴴ * jwAnnihilate N z0 * U.1) := by
            simp [Matrix.mul_assoc]

/-- **`N`-Qubit Fused-Apex `p = 0` Identity**: Conjugating Pauli-`Z` on wire `0` by the `p = 0`
plane unitary `G_0(φ)` equals `Z_0 * G_0(2 * φ)`, collapsing the `p = 0` apex of `Uᴴ * Z_0 * U`
from two Givens rotations to **one** double-angle Givens rotation! -/
theorem givensAdjUnitary_zero_conj_pauliZ0 (N : ℕ) (hN : 1 < N) (φ : ℝ) :
    let z0 : Fin N := ⟨0, by omega⟩
    (givensAdjUnitary N 0 hN φ).1ᴴ * (QRegister.singleton z0).embedMatrix Qubit.Z.1 *
        (givensAdjUnitary N 0 hN φ).1 =
      (QRegister.singleton z0).embedMatrix Qubit.Z.1 *
        (givensAdjUnitary N 0 hN (2 * φ)).1 := by
  intro z0
  have hz0 : (QRegister.singleton z0).embedMatrix Qubit.Z.1 =
      (pairAdj N 0 hN).embedMatrix localZ0 := (pairAdj_embed_localZ0 N 0 hN).symm
  simp only [givensAdjUnitary, QRegister.embedUnitary_val, givensPlaneUnitary_val,
    ← QRegister.embedMatrix_conjTranspose, hz0, ← QRegister.embedMatrix_mul]
  rw [givensPlane_conj_localZ0_eq_mul_double]

/-- Tail product `G_1(φ 1) * G_2(φ 2) * ... * G_m(φ m)` (`1 .. m`, omitting apex `p = 0`). -/
noncomputable def givensCascadeTail (N : ℕ) (φ : ℕ → ℝ) :
    (t : ℕ) → (ht : t + 1 < N) → Unitary (2 ^ N)
  | 0, _ => 1
  | t + 1, ht => givensCascadeTail N φ t (by omega) * givensAdjUnitary N (t + 1) ht (φ (t + 1))

theorem givensCascadePrefix_eq_zero_mul_tail (N : ℕ) (φ : ℕ → ℝ) (t : ℕ) (ht : t + 1 < N) :
    givensCascadePrefix N φ (t + 1) ht =
      givensAdjUnitary N 0 (by omega) (φ 0) * givensCascadeTail N φ t ht := by
  induction t with
  | zero =>
      simp [givensCascadePrefix, givensCascadeTail]
  | succ t ih =>
      rw [givensCascadePrefix, givensCascadeTail, ih (by omega), mul_assoc]

/-- **Fused-Apex `givensLeaf` Reflection Theorem**: For `1 < N`, conjugating the fused apex
`Z_0 * G_0(2 * φ_0)` by the `(N - 2)`-plane tail `G_1(φ_1) ⋯ G_{N-2}(φ_{N-2})` produces the exact
orbital reflection `1 - 2 • singleSpinOrbitalNumberOp N (givensLeaf b k)`. -/
theorem givensCascadeTail_conj_fusedApex (N : ℕ) (hN : 1 < N) (b : ℕ) (k : Fin N → ℤ) :
    let z0 : Fin N := ⟨0, by omega⟩
    let U_tail := givensCascadeTail N (givensLeafAngle N b k) (N - 2) (by omega)
    U_tail.1ᴴ *
        ((QRegister.singleton z0).embedMatrix Qubit.Z.1 *
          (givensAdjUnitary N 0 hN (2 * givensLeafAngle N b k 0)).1) *
        U_tail.1 =
      1 - (2 : ℂ) • singleSpinOrbitalNumberOp N (givensLeaf b k) := by
  have : NeZero N := ⟨by omega⟩
  intro z0 U_tail
  have hsplit : givensCascadeUnitary N b k =
      givensAdjUnitary N 0 hN (givensLeafAngle N b k 0) * U_tail := by
    unfold givensCascadeUnitary U_tail
    have h1 := givensCascadePrefix_eq_zero_mul_tail N (givensLeafAngle N b k) (N - 2) (by omega)
    convert h1 using 2
    omega
  have hmaster := givensCascadeUnitary_conj_pauliZ0 N b k
  dsimp only at hmaster
  rw [← hmaster, hsplit, unitary_val_mul, Matrix.conjTranspose_mul]
  calc
    U_tail.1ᴴ *
        ((QRegister.singleton z0).embedMatrix Qubit.Z.1 *
          (givensAdjUnitary N 0 hN (2 * givensLeafAngle N b k 0)).1) *
        U_tail.1
        = U_tail.1ᴴ *
            ((givensAdjUnitary N 0 hN (givensLeafAngle N b k 0)).1ᴴ *
              (QRegister.singleton z0).embedMatrix Qubit.Z.1 *
              (givensAdjUnitary N 0 hN (givensLeafAngle N b k 0)).1) *
            U_tail.1 := by
              rw [givensAdjUnitary_zero_conj_pauliZ0 N hN]
    _ = (U_tail.1ᴴ * (givensAdjUnitary N 0 hN (givensLeafAngle N b k 0)).1ᴴ) *
          (QRegister.singleton z0).embedMatrix Qubit.Z.1 *
          ((givensAdjUnitary N 0 hN (givensLeafAngle N b k 0)).1 * U_tail.1) := by
            simp [Matrix.mul_assoc]

end QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.GivensOps


