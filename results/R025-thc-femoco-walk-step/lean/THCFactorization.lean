namespace QC14.SelectQ

open QuantumComputation QuantumComputation.Specs Matrix Finset
open QuantumComputation.Specs.ArcsinImpl
open Operator QProg Function
open QC14.Catalytic QC14.GivensPlane QC14.GivensCascade QC14.SpinBlock QC14.RowProgram
open QC14.SelectRows QC14.SelectL QC14.RegCascade QC14.RegKickS
open QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.GivensOps
open QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.OrbitalBridge
open scoped Matrix

variable {n : ℕ}

/-- Scratch size: words `N · beth`, flags `e`, `sg`, kick scratch `2 beth`, QROM ancillas `bI`. -/
def selQScr (N bI beth : ℕ) : ℕ := (N * beth + 2) + 2 * beth + bI

/-! ## Cross-spin parity (helpers for `orbitalReflection_eq_parityFix0`) -/

theorem sqListSumFilter {α : Type*} (L : List α) (P : α → Prop) [DecidablePred P]
    (g : α → ℕ) :
    ((L.filter fun x ↦ decide (P x)).map g).sum = (L.map fun x ↦ if P x then g x else 0).sum := by
  induction L with
  | nil => simp
  | cons x xs ih => by_cases hx : P x <;> simp [List.filter_cons, hx, ih]

theorem sqFlatSum {α β : Type*} (L1 : List α) (L2 : List β) (h : α × β → ℕ) :
    ((L1.flatMap fun a ↦ L2.map fun c ↦ (a, c)).map h).sum =
      (L1.map fun a ↦ (L2.map fun c ↦ h (a, c)).sum).sum := by
  induction L1 with
  | nil => simp
  | cons a l ih => simp [List.flatMap_cons, ih, List.map_map, Function.comp_def]

theorem sqCzPairsSum (N : ℕ) (σ : Fin 2) (g : Wire (2 * N) × Wire (2 * N) → ℕ) :
    ((czPairs N σ).map g).sum =
      ∑ a : Wire (2 * N), ∑ c : Wire (2 * N),
        if a.val % 2 = σ.val ∧ c.val % 2 ≠ σ.val ∧ c < a then g (a, c) else 0 := by
  unfold czPairs
  rw [sqListSumFilter _ (fun x : Wire (2 * N) × Wire (2 * N) ↦
    x.1.val % 2 = σ.val ∧ x.2.val % 2 ≠ σ.val ∧ x.2 < x.1) g, sqFlatSum]
  simp only [Fin.sum_univ_def]

theorem sqSumSpin (N : ℕ) (σ : Fin 2) (g : Wire (2 * N) → ℕ) :
    ∑ a : Wire (2 * N), (if a.val % 2 = σ.val then g a else 0) =
      ∑ q : Fin N, g (spinOrbital N q σ) := by
  have hσ := σ.isLt
  rw [← Finset.sum_filter]
  refine Eq.symm (Finset.sum_bij (fun q _ ↦ spinOrbital N q σ) ?_ ?_ ?_ ?_)
  · intro q _
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, spinOrbital]
    omega
  · intro q1 _ q2 _ h
    simp only [spinOrbital, Fin.mk.injEq] at h
    exact Fin.ext (by omega)
  · intro a ha
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at ha
    refine ⟨⟨a.val / 2, by omega⟩, Finset.mem_univ _, ?_⟩
    apply Fin.ext
    simp only [spinOrbital]
    omega
  · intro q _
    rfl

/-- The two parity-fix exponents add up to `n_↑ · n_↓`. -/
theorem sqExpSum (N : ℕ) (i : Fin (2 ^ (2 * N))) :
    ((czPairs N 0).map fun x ↦
        (basisBits (2 * N) i x.1).val * (basisBits (2 * N) i x.2).val).sum +
      ((czPairs N 1).map fun x ↦
        (basisBits (2 * N) i x.1).val * (basisBits (2 * N) i x.2).val).sum =
      (∑ q : Fin N, (basisBits (2 * N) i (spinOrbital N q 0)).val) *
        ∑ q : Fin N, (basisBits (2 * N) i (spinOrbital N q 1)).val := by
  rw [sqCzPairsSum, sqCzPairsSum, ← sqSumSpin N 0 (fun w ↦ (basisBits (2 * N) i w).val),
    ← sqSumSpin N 1 (fun w ↦ (basisBits (2 * N) i w).val), Finset.sum_mul_sum]
  conv_lhs => arg 2; rw [Finset.sum_comm]
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun a _ ↦ ?_
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun c _ ↦ ?_
  have ha := a.isLt
  have hc := c.isLt
  simp only [Fin.lt_def, Fin.isValue, Fin.val_zero, Fin.val_one]
  split_ifs <;> first | (exfalso; omega) | ring1 | simp

theorem sqSignSq (N : ℕ) (σ : Fin 2) (i : Fin (2 ^ (2 * N))) :
    parityFixSign N σ i * parityFixSign N σ i = 1 := by
  unfold parityFixSign
  rw [← mul_pow]
  norm_num

theorem sqSignProd (N : ℕ) (i : Fin (2 ^ (2 * N))) :
    parityFixSign N 0 i * parityFixSign N 1 i =
      (-1 : ℂ) ^ ((∑ q : Fin N, (basisBits (2 * N) i (spinOrbital N q 0)).val) *
        ∑ q : Fin N, (basisBits (2 * N) i (spinOrbital N q 1)).val) := by
  unfold parityFixSign
  rw [← pow_add, sqExpSum]

theorem sqNumOp_support (N : ℕ) (χ : Fin N → ℝ) {x y : Fin (2 ^ N)}
    (h : singleSpinOrbitalNumberOp N χ x y ≠ 0) : hammingWeight N x = hammingWeight N y := by
  dsimp only [singleSpinOrbitalNumberOp] at h
  rw [Matrix.mul_apply] at h
  obtain ⟨z, -, hz⟩ := Finset.exists_ne_zero_of_sum_ne_zero h
  have h1 : (∑ p : Fin N, (χ p : ℂ) • jwAnnihilate N p) z x ≠ 0 := by
    intro h0
    apply hz
    rw [Matrix.conjTranspose_apply, h0, star_zero, zero_mul]
  have h2 : (∑ p : Fin N, (χ p : ℂ) • jwAnnihilate N p) z y ≠ 0 := by
    intro h0
    apply hz
    rw [h0, mul_zero]
  rw [Matrix.sum_apply] at h1 h2
  obtain ⟨p, -, hp⟩ := Finset.exists_ne_zero_of_sum_ne_zero h1
  obtain ⟨p', -, hp'⟩ := Finset.exists_ne_zero_of_sum_ne_zero h2
  rw [Matrix.smul_apply, smul_eq_mul] at hp hp'
  have e1 := jwAnnihilate_support_hammingWeight (right_ne_zero_of_mul hp)
  have e2 := jwAnnihilate_support_hammingWeight (right_ne_zero_of_mul hp')
  omega

theorem sqRefl_support (N : ℕ) (χ : Fin N → ℝ) {x y : Fin (2 ^ N)}
    (h : (1 - (2 : ℂ) • singleSpinOrbitalNumberOp N χ) x y ≠ 0) :
    hammingWeight N x = hammingWeight N y := by
  by_cases hxy : x = y
  · rw [hxy]
  · apply sqNumOp_support N χ
    intro h0
    apply h
    rw [Matrix.sub_apply, Matrix.one_apply_ne hxy, Matrix.smul_apply, h0]
    simp

theorem sqHw_spin1 (N : ℕ) (i : Fin (2 ^ (2 * N))) :
    hammingWeight N ((spinReg N 1).extractIndex i) =
      ∑ q : Fin N, (basisBits (2 * N) i (spinOrbital N q 1)).val := by
  unfold hammingWeight
  refine Finset.sum_congr rfl fun q _ ↦ ?_
  rw [QRegister.basisBits_extractIndex]
  rfl

theorem sqSpin0_not_mem (N : ℕ) (q : Fin N) :
    spinOrbital N q 0 ∉ Set.range (spinReg N 1).wires := by
  rintro ⟨p, hp⟩
  change spinOrbital N p 1 = spinOrbital N q 0 at hp
  simp only [spinOrbital, Fin.mk.injEq, Fin.isValue, Fin.val_zero, Fin.val_one] at hp
  omega

/-- One spin-0 parity fix serves both spins. -/
theorem orbitalReflection_eq_parityFix0 (N : ℕ) (χ : Fin N → ℝ) (σ : Fin 2) :
    orbitalReflection N χ σ =
      diagonal (parityFixSign N 0) *
        (spinReg N σ).embedMatrix (1 - (2 : ℂ) • singleSpinOrbitalNumberOp N χ) *
          diagonal (parityFixSign N 0) := by
  have hσ := σ.isLt
  rcases (by omega : σ.val = 0 ∨ σ.val = 1) with h | h
  · have e : σ = 0 := Fin.ext h
    subst e
    exact orbitalReflection_eq_parityFix N χ 0
  · have e : σ = 1 := Fin.ext h
    subst e
    rw [orbitalReflection_eq_parityFix N χ 1]
    ext i j
    rw [Matrix.mul_diagonal, Matrix.diagonal_mul, Matrix.mul_diagonal, Matrix.diagonal_mul]
    by_cases hX : (spinReg N 1).embedMatrix (1 - (2 : ℂ) • singleSpinOrbitalNumberOp N χ) i j = 0
    · rw [hX]
      simp
    have hX' := hX
    rw [QRegister.embedMatrix_apply_of_agreeOutside] at hX'
    by_cases hag : (spinReg N 1).AgreeOutside i j
    swap
    · rw [if_neg hag, mul_zero] at hX'
      exact absurd rfl hX'
    rw [if_pos hag, mul_one] at hX'
    have hw := sqRefl_support N χ hX'
    rw [sqHw_spin1, sqHw_spin1] at hw
    have hE : (∑ q : Fin N, (basisBits (2 * N) i (spinOrbital N q 0)).val) =
        ∑ q : Fin N, (basisBits (2 * N) j (spinOrbital N q 0)).val :=
      Finset.sum_congr rfl fun q _ ↦ by rw [hag _ (sqSpin0_not_mem N q)]
    have hp : parityFixSign N 0 i * parityFixSign N 1 i =
        parityFixSign N 0 j * parityFixSign N 1 j := by
      rw [sqSignProd, sqSignProd, hE, hw]
    have h0i := sqSignSq N 0 i
    have h1j := sqSignSq N 1 j
    have key : parityFixSign N 1 i * parityFixSign N 1 j =
        parityFixSign N 0 i * parityFixSign N 0 j := by
      linear_combination (parityFixSign N 0 i * parityFixSign N 1 j) * hp -
        (parityFixSign N 1 i * parityFixSign N 1 j) * h0i +
        (parityFixSign N 0 i * parityFixSign N 0 j) * h1j
    calc parityFixSign N 1 i *
          (spinReg N 1).embedMatrix (1 - (2 : ℂ) • singleSpinOrbitalNumberOp N χ) i j *
          parityFixSign N 1 j
        = (spinReg N 1).embedMatrix (1 - (2 : ℂ) • singleSpinOrbitalNumberOp N χ) i j *
            (parityFixSign N 1 i * parityFixSign N 1 j) := by ring
      _ = (spinReg N 1).embedMatrix (1 - (2 : ℂ) • singleSpinOrbitalNumberOp N χ) i j *
            (parityFixSign N 0 i * parityFixSign N 0 j) := by rw [key]
      _ = _ := by ring

/-! ## Registers of the construction -/

theorem sqLe1 (N bI beth : ℕ) : 0 + (N * beth + 2) ≤ selQScr N bI beth := by
  unfold selQScr; omega

theorem sqLe2 (N bI beth : ℕ) : (N * beth + 2) + 2 * beth ≤ selQScr N bI beth := by
  unfold selQScr; omega

theorem sqLe3 (N bI beth : ℕ) : (N * beth + 2 + 2 * beth) + bI ≤ selQScr N bI beth := by
  unfold selQScr; omega

theorem sqLe4 (N bI beth : ℕ) : (N * beth + 2) + (2 * beth + bI) ≤ selQScr N bI beth := by
  unfold selQScr; omega

/-- The QROM target words `N · beth` ++ `e` ++ `sg`. -/
def sqRX {N bI beth : ℕ} (rS : QRegister (selQScr N bI beth) n) : QRegister (N * beth + 2) n :=
  rS.slice 0 (N * beth + 2) (sqLe1 N bI beth)

/-- The kick scratch of the cascades. -/
def sqRK {N bI beth : ℕ} (rS : QRegister (selQScr N bI beth) n) : QRegister (2 * beth) n :=
  rS.slice (N * beth + 2) (2 * beth) (sqLe2 N bI beth)

/-- The QROM ancillas. -/
def sqRA {N bI beth : ℕ} (rS : QRegister (selQScr N bI beth) n) : QRegister bI n :=
  rS.slice (N * beth + 2 + 2 * beth) bI (sqLe3 N bI beth)

/-- Everything but the words: kick scratch ++ QROM ancillas (the scratch of the middle). -/
def sqRest {N bI beth : ℕ} (rS : QRegister (selQScr N bI beth) n) :
    QRegister (2 * beth + bI) n :=
  rS.slice (N * beth + 2) (2 * beth + bI) (sqLe4 N bI beth)

/-- The angle words inside `rX`. -/
def sqWords {N beth : ℕ} (rX : QRegister (N * beth + 2) n) : QRegister (N * beth) n :=
  rX.compose (QRegister.block 0 (N * beth) (by omega))

/-- Spin-0 system wires inside `rTI`. -/
def sqSys0 (N bI : ℕ) : QRegister N (2 * N + bI) := (sysReg N bI).compose (spinReg N 0)

theorem sqRTI_ne_rS {N bI beth : ℕ} {rTI : QRegister (2 * N + bI) n}
    {rS : QRegister (selQScr N bI beth) n} {rCat : QRegister beth n}
    {hsc : rS.DisjointWires rCat} (hdisj : rTI.DisjointWires (rS.concat rCat hsc))
    (i : Fin (2 * N + bI)) (j : Fin (selQScr N bI beth)) : rTI i ≠ rS j := by
  intro h
  have := QRegister.disjoint_iff.1 hdisj i (Fin.castAdd beth j)
  rw [QRegister.concat_apply_left] at this
  exact this h

theorem sqRS_inj {N bI beth : ℕ} (rS : QRegister (selQScr N bI beth) n)
    (i j : Fin (selQScr N bI beth)) (h : rS i = rS j) : i = j := rS.wires.injective h

theorem sqRX_apply {N bI beth : ℕ} (rS : QRegister (selQScr N bI beth) n)
    (q : Fin (N * beth + 2)) :
    sqRX rS q = rS ⟨q.val, by have := sqLe1 N bI beth; omega⟩ := by
  rw [sqRX, QRegister.slice_apply]; congr 1; exact Fin.ext (Nat.zero_add _)

theorem sqRA_apply {N bI beth : ℕ} (rS : QRegister (selQScr N bI beth) n) (k : Fin bI) :
    sqRA rS k = rS ⟨N * beth + 2 + 2 * beth + k.val, by have := sqLe3 N bI beth; omega⟩ :=
  QRegister.slice_apply _ _ _ _ _

/-- The QROM wires: address = index bits `1 .. bI − 1`, ancillas `rA`, targets `rX`. -/
def sqWires {N bI beth : ℕ} (hbI : 1 ≤ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    SelectPauliImpl.Wires (bI - 1) (N * beth + 2) n where
  sw q := sqRX rS q
  xw i := rTI ⟨2 * N + 1 + i.val, by omega⟩
  aw k := sqRA rS ⟨k.val, by omega⟩
  sw_inj a b h := by
    have h' : sqRX rS a = sqRX rS b := h
    rw [sqRX_apply, sqRX_apply] at h'
    have := sqRS_inj rS _ _ h'
    simp only [Fin.ext_iff] at this ⊢; exact this
  xw_inj a b h := by
    have := rTI.wires.injective h
    simp only [Fin.ext_iff] at this ⊢; omega
  aw_inj a b h := by
    have h' : sqRA rS ⟨a.val, by omega⟩ = sqRA rS ⟨b.val, by omega⟩ := h
    rw [sqRA_apply, sqRA_apply] at h'
    have := sqRS_inj rS _ _ h'
    simp only [Fin.ext_iff] at this ⊢; omega
  sx q i h := by
    have h' : sqRX rS q = rTI ⟨2 * N + 1 + i.val, by omega⟩ := h
    rw [sqRX_apply] at h'
    exact sqRTI_ne_rS hdisj _ _ h'.symm
  sa q k h := by
    have h' : sqRX rS q = sqRA rS ⟨k.val, by omega⟩ := h
    rw [sqRX_apply, sqRA_apply] at h'
    have := sqRS_inj rS _ _ h'
    simp only [Fin.ext_iff] at this; omega
  xa i k h := by
    have h' : rTI ⟨2 * N + 1 + i.val, by omega⟩ = sqRA rS ⟨k.val, by omega⟩ := h
    rw [sqRA_apply] at h'
    exact sqRTI_ne_rS hdisj _ _ h'

/-- Word `q` of leaf `ℓ`: `k ℓ q mod 2^beth`. -/
def sqWordVal (beth : ℕ) (a : ℤ) : ℕ := (a % 2 ^ beth).toNat

/-- The QROM table: for `ℓ < L` the words `k ℓ q mod 2^beth`, `e = 1`, `sg = s ℓ`; else `0`. -/
noncomputable def sqTab {N L : ℕ} (beth bI : ℕ) (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (ℓ : Fin (2 ^ (bI - 1))) (q : Fin (N * beth + 2)) : ZMod 2 :=
  if hℓ : ℓ.val < L then
    if hq : q.val < N * beth then
      ((sqWordVal beth (k ⟨ℓ.val, hℓ⟩ ⟨q.val / beth, Nat.div_lt_of_lt_mul
        (lt_of_lt_of_eq hq (Nat.mul_comm N beth))⟩) / 2 ^ (q.val % beth) % 2 : ℕ) : ZMod 2)
    else if q.val = N * beth then 1
    else if s ⟨ℓ.val, hℓ⟩ then 1 else 0
  else 0

/-- The QROM circuit. -/
noncomputable def sqQrom {N L bI beth : ℕ} (hbI : 1 ≤ bI) (k : Fin L → Fin N → ℤ)
    (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) : Circuit n :=
  QC14.UnaryLookup.ulookup (sqWires hbI rTI rS rCat hsc hdisj) (sqTab beth bI k s)

/-- The first `m` controlled swaps `CSWAP(index bit 0; 2p, 2p + 1)`, work wire `rA 0`. -/
def sqCswP {N bI beth : ℕ} (hbI : 1 ≤ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    (m : ℕ) → m ≤ N → Circuit n
  | 0, _ => .identity
  | m + 1, hm =>
      .seq (sqCswP hbI rTI rS rCat hsc hdisj m (by omega))
        (QC14.PairProgram.fredkinW (rTI ⟨2 * N, by omega⟩) (rTI ⟨2 * m, by omega⟩)
          (rTI ⟨2 * m + 1, by omega⟩) (sqRA rS ⟨0, by omega⟩)
          (fun h ↦ by have := rTI.wires.injective h; simp only [Fin.ext_iff] at this; omega)
          (fun h ↦ by have := rTI.wires.injective h; simp only [Fin.ext_iff] at this; omega)
          (sqRTI_ne_rS hdisj _ _) (sqRTI_ne_rS hdisj _ _) (sqRTI_ne_rS hdisj _ _))

/-- All `N` controlled swaps. -/
def sqCsw {N bI beth : ℕ} (hbI : 1 ≤ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) : Circuit n :=
  sqCswP hbI rTI rS rCat hsc hdisj N le_rfl

/-- `CZ(e; system wire 0)`. -/
def sqCZ {N bI beth : ℕ} (hbI : 1 ≤ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) : Circuit n :=
  czGate (sqRX rS ⟨N * beth, by omega⟩) (rTI ⟨0, by omega⟩)

/-- `Z(sg)`. -/
def sqZ {N bI beth : ℕ} (rS : QRegister (selQScr N bI beth) n) : Circuit n :=
  Circuit.Z (sqRX rS ⟨N * beth + 1, by omega⟩)

/-- The parity fix `parityFix N 0` on the system. -/
def sqPF {N bI : ℕ} (rTI : QRegister (2 * N + bI) n) : Circuit n :=
  (parityFix N 0).onRegister (rTI.compose (sysReg N bI))

theorem sqTA {N bI beth : ℕ} (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    (rTI.compose (sqSys0 N bI)).DisjointWires (sqWords (sqRX rS)) :=
  QRegister.disjoint_iff.2 fun i j h ↦ sqRTI_ne_rS hdisj _ _ h

/-- The middle: parity fix, CSWAP, cascade, `CZ`, inverse cascade, CSWAP, parity fix, `Z(sg)`. -/
noncomputable def sqMid {Var : Type} (v : Var) (beth : ℕ) {N bI : ℕ} (hbI : 1 ≤ bI)
    (rTI : QRegister (2 * N + bI) n) (rS : QRegister (selQScr N bI beth) n)
    (rCat : QRegister beth n) (hsc : rS.DisjointWires rCat)
    (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) (hN : 0 < N) : DynamicCircuit Var n :=
  .seq (.circuit (sqPF rTI))
    (.seq (.circuit (sqCsw hbI rTI rS rCat hsc hdisj))
      (.seq (regCascadeSProgram v beth (rTI.compose (sqSys0 N bI)) (sqWords (sqRX rS))
          (sqTA rTI rS rCat hsc hdisj) (sqRK rS) rCat (N - 1) (by omega))
        (.seq (.circuit (sqCZ hbI rTI rS))
          (.seq (regCascadeInvSProgram v beth (rTI.compose (sqSys0 N bI)) (sqWords (sqRX rS))
              (sqTA rTI rS rCat hsc hdisj) (sqRK rS) rCat (N - 1) (by omega))
            (.seq (.circuit (sqCsw hbI rTI rS rCat hsc hdisj))
              (.seq (.circuit (sqPF rTI)) (.circuit (sqZ rS))))))))

/-- The SELECT program (worker-defined; see the module docstring for the construction). -/
noncomputable def selectQ {Var : Type} (v : Var) (beth : ℕ) {N L bI : ℕ} (hbI : 1 ≤ bI)
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    DynamicCircuit Var n :=
  if hN : 0 < N then
    .seq (.circuit (sqQrom hbI k s rTI rS rCat hsc hdisj))
      (.seq (sqMid v beth hbI rTI rS rCat hsc hdisj hN)
        (.circuit (sqQrom hbI k s rTI rS rCat hsc hdisj)))
  else .circuit .identity

/-! ## Helpers for `selectQ_catKet`: kets, catalyst kets, block-diagonal unitaries -/

theorem sqCatLin {b : ℕ} (rCat : QRegister b n) (β : BitAssignment n)
    (A B : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ)
    (h : ∀ z : Fin (2 ^ b), A *ᵥ ket (writeReg β rCat (basisBits b z)) =
      B *ᵥ ket (writeReg β rCat (basisBits b z))) :
    A *ᵥ catalystKet rCat β = B *ᵥ catalystKet rCat β := by
  unfold catalystKet
  rw [Matrix.mulVec_sum, Matrix.mulVec_sum]
  refine Finset.sum_congr rfl fun y _ ↦ ?_
  rw [Matrix.mulVec_smul, Matrix.mulVec_smul, h y]

theorem sqCatMap {b : ℕ} (rCat : QRegister b n) (β β' : BitAssignment n)
    (A : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ)
    (h : ∀ z : Fin (2 ^ b), A *ᵥ ket (writeReg β rCat (basisBits b z)) =
      ket (writeReg β' rCat (basisBits b z))) :
    A *ᵥ catalystKet rCat β = catalystKet rCat β' := by
  unfold catalystKet
  rw [Matrix.mulVec_sum]
  refine Finset.sum_congr rfl fun y _ ↦ ?_
  rw [Matrix.mulVec_smul, h y]

theorem sqEmbed_col {k : ℕ} (R : QRegister k n) (β : BitAssignment n)
    (A B : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ)
    (h : ∀ l, A l (localIdx R β) = B l (localIdx R β)) :
    R.embedMatrix A *ᵥ ket β = R.embedMatrix B *ᵥ ket β := by
  rw [embedMatrix_mulVec_ket, embedMatrix_mulVec_ket]
  exact Finset.sum_congr rfl fun l _ ↦ by rw [h l]

theorem sqHi_localIdx {k j : ℕ} (R : QRegister (k + j) n) (β : BitAssignment n) :
    bdHi (localIdx R β) = localIdx (R.compose (QRegister.block k j le_rfl)) β := by
  apply (basisBits j).injective
  funext l
  rw [← rcBits_hi]
  simp only [localIdx, Equiv.apply_symm_apply, QRegister.compose_apply, rcB1]

/-- A block-diagonal unitary on a basis ket acts by the block of the ket's high bits. -/
theorem sqBD_ket {k j : ℕ} (R : QRegister (k + j) n) (W : Fin (2 ^ j) → Unitary (2 ^ k))
    (β : BitAssignment n) :
    (R.embedUnitary (blockDiag W)).1 *ᵥ ket β =
      ((R.compose (QRegister.block 0 k (by omega))).embedUnitary
        (W (localIdx (R.compose (QRegister.block k j le_rfl)) β))).1 *ᵥ ket β := by
  rw [QRegister.embedUnitary_compose, ← blockDiag_const, QRegister.embedUnitary_val,
    QRegister.embedUnitary_val]
  apply sqEmbed_col
  intro l
  rw [blockDiag_val, blockDiag_val, ← sqHi_localIdx]
  simp only [blockDiagMat]

theorem sqBD_cat {k j b : ℕ} (R : QRegister (k + j) n) (rCat : QRegister b n)
    (hRC : R.DisjointWires rCat) (W : Fin (2 ^ j) → Unitary (2 ^ k)) (β : BitAssignment n) :
    (R.embedUnitary (blockDiag W)).1 *ᵥ catalystKet rCat β =
      ((R.compose (QRegister.block 0 k (by omega))).embedUnitary
        (W (localIdx (R.compose (QRegister.block k j le_rfl)) β))).1 *ᵥ catalystKet rCat β := by
  apply sqCatLin
  intro z
  rw [sqBD_ket, localIdx_writeReg_of_disjoint β rCat _
    ((QRegister.disjoint_comm.mp hRC).compose_right _)]

/-- A circuit acting as `V` on `rT` lifts to the constant block-diagonal unitary on `rT ++ rX`. -/
theorem sqLiftT {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] {k j m b : ℕ}
    (rT : QRegister k n) (rX : QRegister j n) (hTX : rT.DisjointWires rX) (rS : QRegister m n)
    (rCat : QRegister b n) (hsc : rS.DisjointWires rCat) (c : Circuit n) (V : Unitary (2 ^ k))
    (h : ∀ β, localIdx rS β = 0 → c.eval.1 *ᵥ ket β = (rT.embedUnitary V).1 *ᵥ ket β) :
    CatKet (rT.concat rX hTX) rS rCat hsc ((DynamicCircuit.circuit (Var := Var) c).compile)
      (blockDiag fun _ : Fin (2 ^ j) ↦ V) := by
  refine catKet_circuit_ket _ rS rCat hsc c _ fun β hβ ↦ ?_
  rw [blockDiag_const, ← QRegister.embedUnitary_compose, rcConcat_lo]
  exact h β hβ

theorem sqSysConst (N bI : ℕ) (U : Unitary (2 ^ (2 * N))) :
    (sysReg N bI).embedUnitary U = blockDiag (fun _ : Fin (2 ^ bI) ↦ U) :=
  (blockDiag_const U).symm

theorem sqPF_ket {N bI : ℕ} (rTI : QRegister (2 * N + bI) n) (β : BitAssignment n) :
    (sqPF rTI).eval.1 *ᵥ ket β =
      (rTI.embedUnitary (blockDiag fun _ : Fin (2 ^ bI) ↦ (parityFix N 0).eval)).1 *ᵥ ket β := by
  rw [sqPF, Circuit.eval_onRegister, ← sqSysConst, ← QRegister.embedUnitary_compose]

theorem sqS_apply {N bI : ℕ} (rTI : QRegister (2 * N + bI) n) (i : Fin (2 * N)) :
    (rTI.compose (sysReg N bI)) i = rTI ⟨i.val, by omega⟩ := by
  rw [QRegister.compose_apply,
    show (sysReg N bI) i = (⟨i.val, by omega⟩ : Fin (2 * N + bI)) from rcB0 _ i]

/-! ## The controlled swaps -/

/-- Swap `2p ↔ 2p + 1` for `p < m`. -/
def sqTau (N m : ℕ) (i : Fin (2 * N)) : Fin (2 * N) :=
  if i.val < 2 * m then
    if h : i.val % 2 = 0 then ⟨i.val + 1, by have := i.isLt; omega⟩
    else ⟨i.val - 1, by have := i.isLt; omega⟩
  else i

theorem sqTau_val (N m : ℕ) (i : Fin (2 * N)) :
    (sqTau N m i).val =
      if i.val < 2 * m then (if i.val % 2 = 0 then i.val + 1 else i.val - 1) else i.val := by
  unfold sqTau
  split_ifs <;> rfl

theorem sqTau_invol (N m : ℕ) (i : Fin (2 * N)) : sqTau N m (sqTau N m i) = i := by
  apply Fin.ext
  simp only [sqTau_val]
  split_ifs <;> omega

theorem sqCswP_ket {N bI beth : ℕ} (hbI : 1 ≤ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc))
    (β : BitAssignment n) (hw : β (sqRA rS ⟨0, by omega⟩) = 0) (m : ℕ) (hm : m ≤ N) :
    (sqCswP hbI rTI rS rCat hsc hdisj m hm).eval.1 *ᵥ ket β =
      ket (if β (rTI ⟨2 * N, by omega⟩) = 1 then
        writeReg β (rTI.compose (sysReg N bI))
          (fun i ↦ β (rTI.compose (sysReg N bI) (sqTau N m i)))
        else β) := by
  revert hm
  induction m with
  | zero =>
    intro hm
    have e : (fun i ↦ β (rTI.compose (sysReg N bI) (sqTau N 0 i))) =
        fun i ↦ β (rTI.compose (sysReg N bI) i) := by
      funext i
      rw [show sqTau N 0 i = i from Fin.ext (by rw [sqTau_val]; simp)]
    rw [e, writeReg_self, ite_self, sqCswP, Circuit.eval_identity]
    exact Matrix.one_mulVec _
  | succ m ih =>
    intro hm
    have hS := sqS_apply (N := N) (bI := bI) rTI
    have hne : ∀ (i j : ℕ) (hi : i < 2 * N + bI) (hj : j < 2 * N + bI),
        rTI ⟨i, hi⟩ = rTI ⟨j, hj⟩ → i = j := fun i j hi hj h ↦ by
      have := rTI.wires.injective h
      simpa using this
    have hc0S : rTI ⟨2 * N, by omega⟩ ∉ Set.range (rTI.compose (sysReg N bI)).wires := by
      rintro ⟨i, hi⟩
      have := hne _ _ _ _ ((hS i).symm.trans hi)
      have := i.isLt
      omega
    have hwS : sqRA rS ⟨0, by omega⟩ ∉ Set.range (rTI.compose (sysReg N bI)).wires := by
      rintro ⟨i, hi⟩
      rw [sqRA_apply] at hi
      exact sqRTI_ne_rS hdisj _ _ ((hS i).symm.trans hi)
    have hca : rTI ⟨2 * N, by omega⟩ ≠ rTI ⟨2 * m, by omega⟩ := fun h ↦ by
      have := hne _ _ _ _ h; omega
    have hcb : rTI ⟨2 * N, by omega⟩ ≠ rTI ⟨2 * m + 1, by omega⟩ := fun h ↦ by
      have := hne _ _ _ _ h; omega
    have hab : rTI ⟨2 * m, by omega⟩ ≠ rTI ⟨2 * m + 1, by omega⟩ := fun h ↦ by
      have := hne _ _ _ _ h; omega
    have hcw : rTI ⟨2 * N, by omega⟩ ≠ sqRA rS ⟨0, by omega⟩ := by
      rw [sqRA_apply]; exact sqRTI_ne_rS hdisj _ _
    have haw : rTI ⟨2 * m, by omega⟩ ≠ sqRA rS ⟨0, by omega⟩ := by
      rw [sqRA_apply]; exact sqRTI_ne_rS hdisj _ _
    have hbw : rTI ⟨2 * m + 1, by omega⟩ ≠ sqRA rS ⟨0, by omega⟩ := by
      rw [sqRA_apply]; exact sqRTI_ne_rS hdisj _ _
    rw [sqCswP, eval_seq_mulVec, ih (by omega)]
    by_cases hc : β (rTI ⟨2 * N, by omega⟩) = 1
    · rw [if_pos hc, if_pos hc]
      have hγc : writeReg β (rTI.compose (sysReg N bI))
          (fun i ↦ β (rTI.compose (sysReg N bI) (sqTau N m i))) (rTI ⟨2 * N, by omega⟩) = 1 := by
        rw [writeReg_apply_of_not_mem _ _ _ _ hc0S]; exact hc
      have hγw : writeReg β (rTI.compose (sysReg N bI))
          (fun i ↦ β (rTI.compose (sysReg N bI) (sqTau N m i))) (sqRA rS ⟨0, by omega⟩) = 0 := by
        rw [writeReg_apply_of_not_mem _ _ _ _ hwS]; exact hw
      rw [QC14.PairProgram.fredkinW_ket _ _ _ _ hca hcb hab hcw haw hbw _ hγw, if_pos hγc]
      refine congrArg ket ?_
      have ha : rTI ⟨2 * m, by omega⟩ =
          (rTI.compose (sysReg N bI)).wires ⟨2 * m, by omega⟩ := (hS ⟨2 * m, by omega⟩).symm
      have hb : rTI ⟨2 * m + 1, by omega⟩ =
          (rTI.compose (sysReg N bI)).wires ⟨2 * m + 1, by omega⟩ :=
        (hS ⟨2 * m + 1, by omega⟩).symm
      have key : ∀ i : Fin (2 * N),
          sqTau N m (Equiv.swap (⟨2 * m, by omega⟩ : Fin (2 * N)) ⟨2 * m + 1, by omega⟩ i) =
            sqTau N (m + 1) i := by
        intro i
        apply Fin.ext
        rcases eq_or_ne i ⟨2 * m, by omega⟩ with h1 | h1
        · subst h1
          rw [Equiv.swap_apply_left]
          simp only [sqTau_val, Fin.val_mk]
          split_ifs <;> omega
        rcases eq_or_ne i ⟨2 * m + 1, by omega⟩ with h2 | h2
        · subst h2
          rw [Equiv.swap_apply_right]
          simp only [sqTau_val, Fin.val_mk]
          split_ifs <;> omega
        rw [Equiv.swap_apply_of_ne_of_ne h1 h2]
        have h1' : i.val ≠ 2 * m := fun h ↦ h1 (Fin.ext h)
        have h2' : i.val ≠ 2 * m + 1 := fun h ↦ h2 (Fin.ext h)
        simp only [sqTau_val]
        split_ifs <;> omega
      funext v
      rw [Function.comp_apply, ha, hb]
      by_cases hv : v ∈ Set.range (rTI.compose (sysReg N bI)).wires
      · obtain ⟨i, rfl⟩ := hv
        rw [Function.Injective.swap_apply (rTI.compose (sysReg N bI)).wires.injective,
          writeReg_apply_reg, writeReg_apply_reg, key]
      · rw [Equiv.swap_apply_of_ne_of_ne (fun h ↦ hv ⟨_, h.symm⟩) (fun h ↦ hv ⟨_, h.symm⟩),
          writeReg_apply_of_not_mem _ _ _ _ hv, writeReg_apply_of_not_mem _ _ _ _ hv]
    · rw [if_neg hc, if_neg hc, QC14.PairProgram.fredkinW_ket _ _ _ _ hca hcb hab hcw haw hbw _ hw,
        if_neg hc]

/-- The bit permutation `2p ↔ 2p + 1` of the system index. -/
noncomputable def sqSwF (N : ℕ) (x : Fin (2 ^ (2 * N))) : Fin (2 ^ (2 * N)) :=
  (basisBits (2 * N)).symm (fun i ↦ basisBits (2 * N) x (sqTau N N i))

theorem sqSwF_invol (N : ℕ) (x : Fin (2 ^ (2 * N))) : sqSwF N (sqSwF N x) = x := by
  unfold sqSwF
  simp only [Equiv.apply_symm_apply, sqTau_invol, Equiv.symm_apply_apply]

noncomputable def sqSwP (N : ℕ) : Equiv.Perm (Fin (2 ^ (2 * N))) where
  toFun := sqSwF N
  invFun := sqSwF N
  left_inv x := sqSwF_invol N x
  right_inv x := sqSwF_invol N x

/-- The swap of the spin sectors, as a unitary on the system. -/
noncomputable def sqSW (N : ℕ) : Unitary (2 ^ (2 * N)) := permutationUnitary (sqSwP N)

/-- The controlled sector swap on system ++ index: `SW` on index blocks with bit 0 set. -/
noncomputable def sqWsw (N bI : ℕ) (hbI : 1 ≤ bI) : Unitary (2 ^ (2 * N + bI)) :=
  blockDiag fun j : Fin (2 ^ bI) ↦ if basisBits bI j ⟨0, hbI⟩ = 1 then sqSW N else 1

theorem sqCsw_ket {N bI beth : ℕ} (hbI : 1 ≤ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc))
    (β : BitAssignment n) (hw : β (sqRA rS ⟨0, by omega⟩) = 0) :
    (sqCsw hbI rTI rS rCat hsc hdisj).eval.1 *ᵥ ket β =
      (rTI.embedUnitary (sqWsw N bI hbI)).1 *ᵥ ket β := by
  rw [sqCsw, sqCswP_ket hbI rTI rS rCat hsc hdisj β hw, sqWsw, sqBD_ket]
  have hbit : basisBits bI (localIdx (rTI.compose (QRegister.block (2 * N) bI le_rfl)) β)
      ⟨0, hbI⟩ = β (rTI ⟨2 * N, by omega⟩) :=
    congrFun ((basisBits bI).apply_symm_apply _) ⟨0, hbI⟩
  by_cases hc : β (rTI ⟨2 * N, by omega⟩) = 1
  · rw [if_pos hc, if_pos (hbit.trans hc), QRegister.embedUnitary_val]
    show _ = (rTI.compose (sysReg N bI)).embedMatrix
      (Equiv.Perm.permMatrix ℂ (sqSwP N)⁻¹) *ᵥ ket β
    rw [embedMatrix_permMatrix_mulVec_ket, Equiv.Perm.inv_def, Equiv.symm_symm]
    refine congrArg ket (congrArg (writeReg β _) ?_)
    funext i
    show _ = basisBits (2 * N) ((basisBits (2 * N)).symm _) i
    rw [Equiv.apply_symm_apply]
    exact (congrFun ((basisBits (2 * N)).apply_symm_apply
      (fun i ↦ β ((rTI.compose (sysReg N bI)) i))) _).symm
  · rw [if_neg hc, if_neg (fun h ↦ hc (hbit.symm.trans h)), QRegister.embedUnitary_val]
    show _ = (rTI.compose (sysReg N bI)).embedMatrix 1 *ᵥ ket β
    rw [QRegister.embedMatrix_one, Matrix.one_mulVec]


/-! ## The registers of the middle: target `rTI ++ rX`, scratch `rest` -/

theorem sqRK_apply {N bI beth : ℕ} (rS : QRegister (selQScr N bI beth) n) (c : Fin (2 * beth)) :
    sqRK rS c = rS ⟨N * beth + 2 + c.val, by have := sqLe2 N bI beth; omega⟩ :=
  QRegister.slice_apply _ _ _ _ _

theorem sqRest_apply {N bI beth : ℕ} (rS : QRegister (selQScr N bI beth) n)
    (c : Fin (2 * beth + bI)) :
    sqRest rS c = rS ⟨N * beth + 2 + c.val, by have := sqLe4 N bI beth; omega⟩ :=
  QRegister.slice_apply _ _ _ _ _

theorem sqWords_apply {N bI beth : ℕ} (rS : QRegister (selQScr N bI beth) n)
    (a : Fin (N * beth)) :
    sqWords (sqRX rS) a = rS ⟨a.val, by have := sqLe1 N bI beth; omega⟩ := by
  rw [sqWords, QRegister.compose_apply, rcB0, sqRX_apply]
  rfl

theorem sqRTI_ne_cat {N bI beth : ℕ} {rTI : QRegister (2 * N + bI) n}
    {rS : QRegister (selQScr N bI beth) n} {rCat : QRegister beth n}
    {hsc : rS.DisjointWires rCat} (hdisj : rTI.DisjointWires (rS.concat rCat hsc))
    (i : Fin (2 * N + bI)) (j : Fin beth) : rTI i ≠ rCat j := by
  intro h
  have := QRegister.disjoint_iff.1 hdisj i (Fin.natAdd _ j)
  rw [QRegister.concat_apply_right] at this
  exact this h

theorem sqTX {N bI beth : ℕ} {rTI : QRegister (2 * N + bI) n}
    {rS : QRegister (selQScr N bI beth) n} {rCat : QRegister beth n}
    {hsc : rS.DisjointWires rCat} (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    rTI.DisjointWires (sqRX rS) :=
  QRegister.disjoint_iff.2 fun i j h ↦ sqRTI_ne_rS hdisj i _ (h.trans (sqRX_apply rS j))

theorem sqHR {N bI beth : ℕ} {rS : QRegister (selQScr N bI beth) n} {rCat : QRegister beth n}
    (hsc : rS.DisjointWires rCat) : (sqRest rS).DisjointWires rCat :=
  QRegister.disjoint_iff.2 fun i j h ↦
    QRegister.disjoint_iff.1 hsc _ j ((sqRest_apply rS i).symm.trans h)

theorem sqHK {N bI beth : ℕ} {rS : QRegister (selQScr N bI beth) n} {rCat : QRegister beth n}
    (hsc : rS.DisjointWires rCat) : (sqRK rS).DisjointWires rCat :=
  QRegister.disjoint_iff.2 fun i j h ↦
    QRegister.disjoint_iff.1 hsc _ j ((sqRK_apply rS i).symm.trans h)

theorem sqMidDisj {N bI beth : ℕ} {rTI : QRegister (2 * N + bI) n}
    {rS : QRegister (selQScr N bI beth) n} {rCat : QRegister beth n}
    {hsc : rS.DisjointWires rCat} (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    (rTI.concat (sqRX rS) (sqTX hdisj)).DisjointWires ((sqRest rS).concat rCat (sqHR hsc)) := by
  rw [QRegister.disjoint_iff]
  intro i j
  induction i using Fin.addCases with
  | left a =>
      rw [QRegister.concat_apply_left]
      induction j using Fin.addCases with
      | left c => rw [QRegister.concat_apply_left, sqRest_apply]; exact sqRTI_ne_rS hdisj _ _
      | right c => rw [QRegister.concat_apply_right]; exact sqRTI_ne_cat hdisj _ _
  | right a =>
      rw [QRegister.concat_apply_right, sqRX_apply]
      induction j using Fin.addCases with
      | left c =>
          rw [QRegister.concat_apply_left, sqRest_apply]
          intro h
          have h1 : a.val = N * beth + 2 + c.val := congrArg Fin.val (sqRS_inj rS _ _ h)
          have h2 := a.isLt
          omega
      | right c =>
          rw [QRegister.concat_apply_right]
          exact QRegister.disjoint_iff.1 hsc _ c

theorem sqCascDisj {N bI beth : ℕ} {rTI : QRegister (2 * N + bI) n}
    {rS : QRegister (selQScr N bI beth) n} {rCat : QRegister beth n}
    {hsc : rS.DisjointWires rCat} (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    ((rTI.compose (sqSys0 N bI)).concat (sqWords (sqRX rS))
      (sqTA rTI rS rCat hsc hdisj)).DisjointWires ((sqRK rS).concat rCat (sqHK hsc)) := by
  rw [QRegister.disjoint_iff]
  intro i j
  induction i using Fin.addCases with
  | left a =>
      rw [QRegister.concat_apply_left, QRegister.compose_apply]
      induction j using Fin.addCases with
      | left c => rw [QRegister.concat_apply_left, sqRK_apply]; exact sqRTI_ne_rS hdisj _ _
      | right c => rw [QRegister.concat_apply_right]; exact sqRTI_ne_cat hdisj _ _
  | right a =>
      rw [QRegister.concat_apply_right, sqWords_apply]
      induction j using Fin.addCases with
      | left c =>
          rw [QRegister.concat_apply_left, sqRK_apply]
          intro h
          have h1 : a.val = N * beth + 2 + c.val := congrArg Fin.val (sqRS_inj rS _ _ h)
          have h2 := a.isLt
          omega
      | right c =>
          rw [QRegister.concat_apply_right]
          exact QRegister.disjoint_iff.1 hsc _ c

theorem sqConcat_hi {k m : ℕ} (r : QRegister k n) (s : QRegister m n) (h : r.DisjointWires s) :
    (r.concat s h).compose (QRegister.block k m le_rfl) = s := by
  apply QRegister.ext
  ext i
  simp only [QRegister.compose_apply, rcB1, QRegister.concat_apply_right]

/-- Copy of `PairProgramQ.pqCatKet_sub` (that module is not imported here). -/
theorem sqCatKet_sub {Var : Type} [DecidableEq Var] {k m m' b : ℕ}
    {rT : QRegister k n} {rS : QRegister m n} {rS' : QRegister m' n} {rCat : QRegister b n}
    {hsc : rS.DisjointWires rCat} {hsc' : rS'.DisjointWires rCat} {P : QProg Var (2 ^ n)}
    {U : Unitary (2 ^ k)} (hw : ∀ i, ∃ j, rS i = rS' j)
    (h : CatKet rT rS rCat hsc P U) : CatKet rT rS' rCat hsc' P U := by
  refine catKet_mono_scratch (fun β h0 ↦ ?_) h
  have hz := eq_zero_of_localIdx_eq_zero _ β h0
  apply localIdx_eq_zero_of_forall
  intro i
  induction i using Fin.addCases with
  | left a =>
      rw [QRegister.concat_apply_left]
      obtain ⟨j, hj⟩ := hw a
      rw [hj]
      have := hz (Fin.castAdd b j)
      rwa [QRegister.concat_apply_left] at this
  | right c =>
      rw [QRegister.concat_apply_right]
      have := hz (Fin.natAdd m' c)
      rwa [QRegister.concat_apply_right] at this

/-! ## Kets through diagonal gates -/

/-- Copy of `RowProgram.embed_diag_ket` (private there). -/
theorem sqEmbDiag_ket {k : ℕ} (r : QRegister k n) (d : Fin (2 ^ k) → ℂ)
    (β : BitAssignment n) :
    r.embedMatrix (diagonal d) *ᵥ ket β = d (localIdx r β) • ket β := by
  rw [embedMatrix_mulVec_ket, Finset.sum_eq_single (localIdx r β)]
  · rw [Matrix.diagonal_apply_eq, writeReg_localIdx_self]
  · intro l _ hl
    rw [Matrix.diagonal_apply_ne _ hl, zero_smul]
  · intro h
    exact absurd (Finset.mem_univ _) h

theorem sqDiag_ket (d : Fin (2 ^ n) → ℂ) (β : BitAssignment n) :
    diagonal d *ᵥ ket β = d ((basisBits n).symm β) • ket β := by
  have e : ket β = Pi.single ((basisBits n).symm β) (1 : ℂ) := by
    first
    | rw [single_eq_ket, Equiv.apply_symm_apply]
    | simp [ket, basisState]
  rw [e]
  funext i
  simp only [Matrix.mulVec_diagonal, Pi.smul_apply, Pi.single_apply, smul_eq_mul]
  split_ifs with h
  · rw [h]
  · simp

theorem sqNegOne_eq (k : ℕ) :
    (-1 : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ) = diagonal fun _ ↦ -1 := by
  ext i j
  by_cases h : i = j
  · subst h; simp
  · simp [h, Matrix.diagonal_apply_ne _ h, Matrix.one_apply_ne h]

theorem sqQZ_ket (q : Wire n) (β : BitAssignment n) :
    ((QRegister.singleton q).embedUnitary Qubit.Z).1 *ᵥ ket β = bitSign (β q) • ket β := by
  rw [QRegister.embedUnitary_val, singleton_embedMatrix_mulVec_ket]
  have e := Function.update_eq_self q β
  rcases bit_cases (β q) with hb | hb <;> rw [hb] at e <;> simp [hb, e, Qubit.Z]

/-- `−1` as a unitary. -/
noncomputable def sqNeg (k : ℕ) : Unitary (2 ^ k) :=
  ⟨-1, by rw [Matrix.mem_unitaryGroup_iff, star_neg, star_one, neg_mul_neg, mul_one]⟩

/-! ## The pieces of the middle, each block diagonal in the value of `rX` -/

/-- `Z` on spin-0 orbital 0 of the system. -/
noncomputable def sqZ0 (N : ℕ) (hN : 0 < N) : Unitary (2 ^ (2 * N)) :=
  (spinReg N 0).embedUnitary ((QRegister.singleton (⟨0, hN⟩ : Wire N)).embedUnitary Qubit.Z)

/-- The block of `CZ(e; system 0)` at `rX` value `y`. -/
noncomputable def sqWcz (N bI beth : ℕ) (hN : 0 < N) (y : Fin (2 ^ (N * beth + 2))) :
    Unitary (2 ^ (2 * N + bI)) :=
  if basisBits (N * beth + 2) y ⟨N * beth, by omega⟩ = 1 then (sysReg N bI).embedUnitary (sqZ0 N hN)
  else 1

/-- The block of `Z(sg)` at `rX` value `y`. -/
noncomputable def sqWz (N bI beth : ℕ) (y : Fin (2 ^ (N * beth + 2))) :
    Unitary (2 ^ (2 * N + bI)) :=
  if basisBits (N * beth + 2) y ⟨N * beth + 1, by omega⟩ = 1 then sqNeg (2 * N + bI) else 1

/-- The parity fix on system ++ index. -/
noncomputable def sqPFU (N bI : ℕ) : Unitary (2 ^ (2 * N + bI)) :=
  blockDiag fun _ : Fin (2 ^ bI) ↦ (parityFix N 0).eval

/-- The words part of `rX`. -/
def sqQ (N beth : ℕ) : QRegister (N * beth) (N * beth + 2) := QRegister.block 0 (N * beth) (by omega)

/-- The cascade at word value `x`. -/
noncomputable def sqGW (N beth : ℕ) (hN : 0 < N) (x : Fin (2 ^ (N * beth))) : Unitary (2 ^ N) :=
  givensCascadePrefix N (givensLeafAngle N beth (angleVec N beth x)) (N - 1) (by omega)

/-- The cascade block at `rX` value `y`. -/
noncomputable def sqWG (N bI beth : ℕ) (hN : 0 < N) (y : Fin (2 ^ (N * beth + 2))) :
    Unitary (2 ^ (2 * N + bI)) :=
  (sqSys0 N bI).embedUnitary (sqGW N beth hN ((sqQ N beth).extractIndex y))

/-- The inverse cascade block at `rX` value `y`. -/
noncomputable def sqWGi (N bI beth : ℕ) (hN : 0 < N) (y : Fin (2 ^ (N * beth + 2))) :
    Unitary (2 ^ (2 * N + bI)) :=
  (sqSys0 N bI).embedUnitary (sqGW N beth hN ((sqQ N beth).extractIndex y))⁻¹

/-- The whole middle at `rX` value `y` (operator order: last applied leftmost). -/
noncomputable def sqMidW (N bI beth : ℕ) (hbI : 1 ≤ bI) (hN : 0 < N)
    (y : Fin (2 ^ (N * beth + 2))) : Unitary (2 ^ (2 * N + bI)) :=
  sqWz N bI beth y * sqPFU N bI * sqWsw N bI hbI * sqWGi N bI beth hN y *
    sqWcz N bI beth hN y * sqWG N bI beth hN y * sqWsw N bI hbI * sqPFU N bI

theorem sqHiBit {N bI beth : ℕ} (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (hTX : rTI.DisjointWires (sqRX rS))
    (β : BitAssignment n) (q : Fin (N * beth + 2)) :
    basisBits (N * beth + 2)
      (localIdx ((rTI.concat (sqRX rS) hTX).compose (QRegister.block (2 * N + bI) (N * beth + 2)
        le_rfl)) β) q = β (sqRX rS q) := by
  rw [sqConcat_hi]
  exact congrFun ((basisBits (N * beth + 2)).apply_symm_apply _) q

theorem sqPF_cat {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] {N bI beth : ℕ}
    (rTI : QRegister (2 * N + bI) n) (rS : QRegister (selQScr N bI beth) n)
    (rCat : QRegister beth n) (hsc : rS.DisjointWires rCat)
    (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    CatKet (rTI.concat (sqRX rS) (sqTX hdisj)) (sqRest rS) rCat (sqHR hsc)
      ((DynamicCircuit.circuit (Var := Var) (sqPF rTI)).compile)
      (blockDiag fun _ : Fin (2 ^ (N * beth + 2)) ↦ sqPFU N bI) :=
  sqLiftT rTI (sqRX rS) (sqTX hdisj) (sqRest rS) rCat (sqHR hsc) (sqPF rTI) _
    fun β _ ↦ sqPF_ket rTI β

theorem sqCsw_cat {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] {N bI beth : ℕ}
    (hbI : 1 ≤ bI) (rTI : QRegister (2 * N + bI) n) (rS : QRegister (selQScr N bI beth) n)
    (rCat : QRegister beth n) (hsc : rS.DisjointWires rCat)
    (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    CatKet (rTI.concat (sqRX rS) (sqTX hdisj)) (sqRest rS) rCat (sqHR hsc)
      ((DynamicCircuit.circuit (Var := Var) (sqCsw hbI rTI rS rCat hsc hdisj)).compile)
      (blockDiag fun _ : Fin (2 ^ (N * beth + 2)) ↦ sqWsw N bI hbI) :=
  sqLiftT rTI (sqRX rS) (sqTX hdisj) (sqRest rS) rCat (sqHR hsc) _ _ fun β hβ ↦
    sqCsw_ket hbI rTI rS rCat hsc hdisj β (by
      have h := eq_zero_of_localIdx_eq_zero _ β hβ ⟨2 * beth, by omega⟩
      rw [sqRest_apply] at h
      rw [sqRA_apply]
      exact h)

theorem sqG_cat {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    (hb : 2 ≤ beth) {N bI : ℕ} (hN : 0 < N) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    CatKet (rTI.concat (sqRX rS) (sqTX hdisj)) (sqRest rS) rCat (sqHR hsc)
      (regCascadeSProgram v beth (rTI.compose (sqSys0 N bI)) (sqWords (sqRX rS))
          (sqTA rTI rS rCat hsc hdisj) (sqRK rS) rCat (N - 1) (by omega)).compile
      (blockDiag (sqWG N bI beth hN)) := by
  have h1 := regCascadeS_catKet v beth hb (rTI.compose (sqSys0 N bI)) (sqWords (sqRX rS))
    (sqTA rTI rS rCat hsc hdisj) (sqRK rS) rCat (sqHK hsc) (sqCascDisj hdisj) (N - 1)
    (by omega)
  have h2 := sqCatKet_sub (rS' := sqRest rS) (hsc' := sqHR hsc)
    (fun i ↦ ⟨⟨i.val, by omega⟩, by rw [sqRK_apply, sqRest_apply]⟩) h1
  have h3 : CatKet ((rTI.concat (sqRX rS) (sqTX hdisj)).compose
      (lrReg (sqSys0 N bI) (sqQ N beth))) (sqRest rS) rCat (sqHR hsc)
      (regCascadeSProgram v beth (rTI.compose (sqSys0 N bI)) (sqWords (sqRX rS))
          (sqTA rTI rS rCat hsc hdisj) (sqRK rS) rCat (N - 1) (by omega)).compile
      (blockDiag (sqGW N beth hN)) := by
    rw [concat_compose_lrReg]
    exact h2
  have h4 := CatKet.compose (lrReg (sqSys0 N bI) (sqQ N beth)) h3
  rw [embedUnitary_lrReg_blockDiag] at h4
  exact h4

theorem sqGi_cat {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    (hb : 2 ≤ beth) {N bI : ℕ} (hN : 0 < N) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    CatKet (rTI.concat (sqRX rS) (sqTX hdisj)) (sqRest rS) rCat (sqHR hsc)
      (regCascadeInvSProgram v beth (rTI.compose (sqSys0 N bI)) (sqWords (sqRX rS))
          (sqTA rTI rS rCat hsc hdisj) (sqRK rS) rCat (N - 1) (by omega)).compile
      (blockDiag (sqWGi N bI beth hN)) := by
  have h1 := regCascadeInvS_catKet v beth hb (rTI.compose (sqSys0 N bI)) (sqWords (sqRX rS))
    (sqTA rTI rS rCat hsc hdisj) (sqRK rS) rCat (sqHK hsc) (sqCascDisj hdisj) (N - 1)
    (by omega)
  have h2 := sqCatKet_sub (rS' := sqRest rS) (hsc' := sqHR hsc)
    (fun i ↦ ⟨⟨i.val, by omega⟩, by rw [sqRK_apply, sqRest_apply]⟩) h1
  have h3 : CatKet ((rTI.concat (sqRX rS) (sqTX hdisj)).compose
      (lrReg (sqSys0 N bI) (sqQ N beth))) (sqRest rS) rCat (sqHR hsc)
      (regCascadeInvSProgram v beth (rTI.compose (sqSys0 N bI)) (sqWords (sqRX rS))
          (sqTA rTI rS rCat hsc hdisj) (sqRK rS) rCat (N - 1) (by omega)).compile
      (blockDiag fun x ↦ (sqGW N beth hN x)⁻¹) := by
    rw [concat_compose_lrReg]
    exact h2
  have h4 := CatKet.compose (lrReg (sqSys0 N bI) (sqQ N beth)) h3
  rw [embedUnitary_lrReg_blockDiag] at h4
  exact h4

theorem sqCZ_cat {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] {N bI beth : ℕ}
    (hbI : 1 ≤ bI) (hN : 0 < N) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    CatKet (rTI.concat (sqRX rS) (sqTX hdisj)) (sqRest rS) rCat (sqHR hsc)
      ((DynamicCircuit.circuit (Var := Var) (sqCZ hbI rTI rS)).compile)
      (blockDiag (sqWcz N bI beth hN)) := by
  refine catKet_circuit_ket _ _ rCat (sqHR hsc) _ _ fun β _ ↦ ?_
  have hne : sqRX rS ⟨N * beth, by omega⟩ ≠ rTI ⟨0, by omega⟩ := fun h ↦
    sqRTI_ne_rS hdisj _ _ (h.symm.trans (sqRX_apply rS _))
  rw [sqBD_ket, rcConcat_lo, sqConcat_hi, sqCZ, czGate_eval _ _ hne, sqDiag_ket]
  simp only [Equiv.apply_symm_apply]
  have hbit : basisBits (N * beth + 2) (localIdx (sqRX rS) β) ⟨N * beth, by omega⟩ =
      β (sqRX rS ⟨N * beth, by omega⟩) :=
    congrFun ((basisBits (N * beth + 2)).apply_symm_apply _) _
  unfold sqWcz
  rcases bit_cases (β (sqRX rS ⟨N * beth, by omega⟩)) with hc | hc
  · rw [if_neg (fun h ↦ by rw [hbit, hc] at h; exact zero_ne_one h), hc,
      QRegister.embedUnitary_val]
    show _ = rTI.embedMatrix 1 *ᵥ ket β
    rw [QRegister.embedMatrix_one, Matrix.one_mulVec]
    simp
  · rw [if_pos (hbit.trans hc), hc, sqZ0, ← QRegister.embedUnitary_compose,
      ← QRegister.embedUnitary_compose, ← QRegister.embedUnitary_compose]
    have e : ((rTI.compose (sysReg N bI)).compose (spinReg N 0)).compose
        (QRegister.singleton (⟨0, hN⟩ : Wire N)) = QRegister.singleton (rTI ⟨0, by omega⟩) := rfl
    rw [e, sqQZ_ket]
    rcases bit_cases (β (rTI ⟨0, by omega⟩)) with hd | hd <;>
      simp [hd, bitSign, show (1 : ZMod 2).val = 1 from rfl]

theorem sqZ_cat {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] {N bI beth : ℕ}
    (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    CatKet (rTI.concat (sqRX rS) (sqTX hdisj)) (sqRest rS) rCat (sqHR hsc)
      ((DynamicCircuit.circuit (Var := Var) (sqZ rS)).compile)
      (blockDiag (sqWz N bI beth)) := by
  refine catKet_circuit_ket _ _ rCat (sqHR hsc) _ _ fun β _ ↦ ?_
  rw [sqBD_ket, rcConcat_lo, sqConcat_hi, sqZ, ket_Z]
  have hbit : basisBits (N * beth + 2) (localIdx (sqRX rS) β) ⟨N * beth + 1, by omega⟩ =
      β (sqRX rS ⟨N * beth + 1, by omega⟩) :=
    congrFun ((basisBits (N * beth + 2)).apply_symm_apply _) _
  unfold sqWz
  rcases bit_cases (β (sqRX rS ⟨N * beth + 1, by omega⟩)) with hc | hc
  · rw [if_neg (fun h ↦ by rw [hbit, hc] at h; exact zero_ne_one h), hc,
      QRegister.embedUnitary_val]
    show _ = rTI.embedMatrix 1 *ᵥ ket β
    rw [QRegister.embedMatrix_one, Matrix.one_mulVec]
    simp [bitSign]
  · rw [if_pos (hbit.trans hc), hc, QRegister.embedUnitary_val]
    show _ = rTI.embedMatrix (-1) *ᵥ ket β
    rw [sqNegOne_eq, sqEmbDiag_ket]
    simp [bitSign]

/-- The middle in one piece. -/
theorem sqMid_cat {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    (hb : 2 ≤ beth) {N bI : ℕ} (hbI : 1 ≤ bI) (hN : 0 < N) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    CatKet (rTI.concat (sqRX rS) (sqTX hdisj)) (sqRest rS) rCat (sqHR hsc)
      (sqMid v beth hbI rTI rS rCat hsc hdisj hN).compile
      (blockDiag (sqMidW N bI beth hbI hN)) := by
  have hd := sqMidDisj hdisj
  have h := CatKet.seq hd (sqPF_cat (Var := Var) rTI rS rCat hsc hdisj)
    (CatKet.seq hd (sqCsw_cat (Var := Var) hbI rTI rS rCat hsc hdisj)
      (CatKet.seq hd (sqG_cat v beth hb hN rTI rS rCat hsc hdisj)
        (CatKet.seq hd (sqCZ_cat (Var := Var) hbI hN rTI rS rCat hsc hdisj)
          (CatKet.seq hd (sqGi_cat v beth hb hN rTI rS rCat hsc hdisj)
            (CatKet.seq hd (sqCsw_cat (Var := Var) hbI rTI rS rCat hsc hdisj)
              (CatKet.seq hd (sqPF_cat (Var := Var) rTI rS rCat hsc hdisj)
                (sqZ_cat (Var := Var) rTI rS rCat hsc hdisj)))))))
  simp only [blockDiag_mul] at h
  simp only [sqMid, DynamicCircuit.compile_seq]
  exact h

/-! ## Helpers for `selectQ_catKet`: arithmetic and the QROM table -/

theorem sqMulVal {m : ℕ} (a b : Unitary (2 ^ m)) : (a * b).1 = a.1 * b.1 := rfl

theorem sqAssoc8 {m : ℕ} (a b c d e f g h : Matrix (Fin m) (Fin m) ℂ) :
    a * b * c * d * e * f * g * h = a * (b * (c * (d * e * f) * g) * h) := by
  simp only [mul_assoc]

theorem sqModDiv (a b i : ℕ) (hi : i < b) : a % 2 ^ b / 2 ^ i % 2 = a / 2 ^ i % 2 := by
  have e : 2 ^ b = 2 ^ i * 2 ^ (b - i) := by
    rw [← pow_add]; congr 1; omega
  rw [e, Nat.mod_mul_right_div_self, Nat.mod_mod_of_dvd _ (dvd_pow_self 2 (by omega))]

theorem sqWord_eq {M : ℕ} (b : ℕ) (X : Fin (2 ^ M)) (o w : ℕ) (hw : w < 2 ^ b)
    (h : ∀ i, i < b → ((X.val / 2 ^ (o + i) % 2 : ℕ) : ZMod 2) = ((w / 2 ^ i % 2 : ℕ) : ZMod 2)) :
    X.val / 2 ^ o % 2 ^ b = w := by
  apply SelectPauliImpl.bitsZ_inj (b := b) (Nat.mod_lt _ (by positivity)) hw
  funext i
  show ((X.val / 2 ^ o % 2 ^ b / 2 ^ i.val % 2 : ℕ) : ZMod 2) = ((w / 2 ^ i.val % 2 : ℕ) : ZMod 2)
  rw [sqModDiv _ _ _ i.isLt, Nat.div_div_eq_div_mul, ← pow_add]
  exact h i.val i.isLt

theorem sqWordVal_lt (beth : ℕ) (a : ℤ) : sqWordVal beth a < 2 ^ beth := by
  have h0 : 0 ≤ a % 2 ^ beth := Int.emod_nonneg _ (by positivity)
  have h1 : a % 2 ^ beth < 2 ^ beth := Int.emod_lt_of_pos _ (by positivity)
  unfold sqWordVal
  first
  | (rw [← Int.ofNat_lt, Int.toNat_of_nonneg h0]; exact_mod_cast h1)
  | (rw [← Nat.cast_lt (α := ℤ), Int.toNat_of_nonneg h0]; exact_mod_cast h1)
  | omega

theorem sqQB {N beth : ℕ} (q : Fin N) (i : ℕ) (hi : i < beth) : q.val * beth + i < N * beth := by
  have h1 : (q.val + 1) * beth ≤ N * beth := Nat.mul_le_mul (Nat.succ_le_of_lt q.isLt) le_rfl
  rw [Nat.add_mul, Nat.one_mul] at h1
  omega

theorem sqTab_word {N L : ℕ} (beth bI : ℕ) (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (ℓ : Fin (2 ^ (bI - 1))) (hℓ : ℓ.val < L) (q : Fin N) (i : ℕ) (hi : i < beth) :
    sqTab beth bI k s ℓ ⟨q.val * beth + i, by have := sqQB q i hi; omega⟩ =
      ((sqWordVal beth (k ⟨ℓ.val, hℓ⟩ q) / 2 ^ i % 2 : ℕ) : ZMod 2) := by
  have hq : q.val * beth + i < N * beth := sqQB q i hi
  have e1 : (q.val * beth + i) / beth = q.val := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega : 0 < beth), Nat.div_eq_of_lt hi,
      zero_add]
  have e2 : (q.val * beth + i) % beth = i := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hi]
  have key : ∀ (a : ℕ) (ha : a < N) (c : ℕ), a = q.val → c = i →
      ((sqWordVal beth (k ⟨ℓ.val, hℓ⟩ ⟨a, ha⟩) / 2 ^ c % 2 : ℕ) : ZMod 2) =
        ((sqWordVal beth (k ⟨ℓ.val, hℓ⟩ q) / 2 ^ i % 2 : ℕ) : ZMod 2) := by
    rintro a ha c rfl rfl
    rfl
  unfold sqTab
  first
  | rw [dif_pos hℓ, dif_pos hq]
  | (simp only [Fin.val_mk]; rw [dif_pos hℓ, dif_pos hq])
  exact key _ _ _ e1 e2

theorem sqA_lt {bI : ℕ} (hbI : 1 ≤ bI) (j : Fin (2 ^ bI)) : j.val / 2 < 2 ^ (bI - 1) := by
  have e : 2 ^ bI = 2 ^ (bI - 1) * 2 := by
    rw [← pow_succ]; congr 1; omega
  rw [Nat.div_lt_iff_lt_mul (by norm_num), ← e]
  exact j.isLt

theorem sqBit0 {bI : ℕ} (hbI : 1 ≤ bI) (j : Fin (2 ^ bI)) :
    basisBits bI j ⟨0, hbI⟩ = ((j.val % 2 : ℕ) : ZMod 2) := by
  rw [basisBits_eq_div_mod]
  simp only [Fin.val_mk, pow_zero, Nat.div_one]

theorem sqAddr_bits {N bI : ℕ} (hbI : 1 ≤ bI) (l : Fin (2 ^ (2 * N + bI))) (i : Fin (bI - 1)) :
    basisBits (2 * N + bI) l ⟨2 * N + 1 + i.val, by omega⟩ =
      SelectPauliImpl.bitsZ (bI - 1) ((bdHi (k := 2 * N) (j := bI) l).val / 2) i := by
  rw [basisBits_eq_div_mod]
  show ((l.val / 2 ^ (2 * N + 1 + i.val) % 2 : ℕ) : ZMod 2) =
    ((l.val / 2 ^ (2 * N) / 2 / 2 ^ i.val % 2 : ℕ) : ZMod 2)
  have e : l.val / 2 ^ (2 * N) / 2 / 2 ^ i.val = l.val / 2 ^ (2 * N + 1 + i.val) := by
    simp only [Nat.div_div_eq_div_mul, pow_add, pow_one, mul_assoc]
  rw [e]

theorem sqTabAdd_sw {s N' : ℕ} (W : SelectPauliImpl.Wires s N' n) (a : Fin N' → ZMod 2)
    (q : Fin N') : QC14.UnaryLookup.tabAdd W a (W.sw q) = a q := by
  unfold QC14.UnaryLookup.tabAdd
  rw [Finset.sum_apply, Finset.sum_eq_single q]
  · rw [Pi.single_apply, if_pos rfl]
  · intro b _ hb
    rw [Pi.single_apply, if_neg (fun h ↦ hb (W.sw_inj h).symm)]
  · intro h
    exact absurd (Finset.mem_univ q) h

theorem sqTabAdd_off {s N' : ℕ} (W : SelectPauliImpl.Wires s N' n) (a : Fin N' → ZMod 2)
    (y : Wire n) (h : ∀ q, y ≠ W.sw q) : QC14.UnaryLookup.tabAdd W a y = 0 :=
  QC14.UnaryLookup.ulTab_apply_of_ne W.sw a y h

theorem sqWrite_add {k : ℕ} (β δ : BitAssignment n) (r : QRegister k n) (γ : Fin k → ZMod 2)
    (hδ : ∀ i, δ (r i) = 0) : writeReg β r γ + δ = writeReg (β + δ) r γ := by
  funext w
  rw [Pi.add_apply]
  by_cases hw : w ∈ Set.range r.wires
  · obtain ⟨i, rfl⟩ := hw
    rw [writeReg_apply_reg, writeReg_apply_reg]
    show γ i + δ (r i) = γ i
    rw [hδ i, add_zero]
  · rw [writeReg_apply_of_not_mem _ _ _ _ hw, writeReg_apply_of_not_mem _ _ _ _ hw, Pi.add_apply]

theorem sqLocal_add {k : ℕ} (r : QRegister k n) (β δ : BitAssignment n) (h : ∀ i, δ (r i) = 0) :
    localIdx r (β + δ) = localIdx r β := by
  show (basisBits k).symm (fun i ↦ (β + δ) (r i)) = (basisBits k).symm (fun i ↦ β (r i))
  congr 1
  funext i
  rw [Pi.add_apply, h, add_zero]

theorem sqLocal_write {k : ℕ} (r : QRegister k n) (β : BitAssignment n) (l : Fin (2 ^ k)) :
    localIdx r (writeReg β r (basisBits k l)) = l := by
  rw [localIdx_writeReg, Equiv.symm_apply_apply]

/-! ## The entries of `selectOpL` -/

theorem sqSysEmb_apply (N bI : ℕ) (A : Matrix (Fin (2 ^ (2 * N))) (Fin (2 ^ (2 * N))) ℂ)
    (l x : Fin (2 ^ (2 * N + bI))) :
    (sysReg N bI).embedMatrix A l x = if bdHi l = bdHi x then A (bdLo l) (bdLo x) else 0 := by
  rw [QRegister.embedMatrix_apply_of_agreeOutside]
  unfold sysReg
  rw [← rcLo_eq, ← rcLo_eq]
  by_cases h : bdHi l = bdHi x
  · rw [if_pos h, if_pos ((rcAgree_block0 (by omega) l x).2 h), mul_one]
  · rw [if_neg h, if_neg (mt (rcAgree_block0 (by omega) l x).1 h), mul_zero]

theorem sqIdx_ext (N bI : ℕ) (l : Fin (2 ^ (2 * N + bI))) :
    (idxReg N bI).extractIndex l = bdHi l := by
  apply Fin.ext
  unfold idxReg
  rw [rcExt_block]
  exact Nat.mod_eq_of_lt (bdHi_lt l)

theorem sqSel_apply (N L bI beth : ℕ) (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (h2L : 2 * L ≤ 2 ^ bI) (l x : Fin (2 ^ (2 * N + bI))) :
    selectOpL N L bI beth k s h2L l x =
      if bdHi l = bdHi x then selWL beth bI k s (bdHi x) (bdLo l) (bdLo x) else 0 := by
  rw [selectOpL_eq_sum, Matrix.sum_apply, Finset.sum_eq_single (bdHi l)]
  · unfold idxProj
    rw [QRegister.basisOutcomeProjector_eq_diagonal, Matrix.diagonal_mul]
    try dsimp only
    rw [sqIdx_ext, if_pos (show bdHi l = ⟨(bdHi l).val, (bdHi l).2⟩ from rfl), one_mul,
      sqSysEmb_apply]
    split_ifs with h
    · rw [h]
    · rfl
  · intro j _ hj
    unfold idxProj
    rw [QRegister.basisOutcomeProjector_eq_diagonal, Matrix.diagonal_mul]
    try dsimp only
    rw [sqIdx_ext, if_neg (show ¬ (bdHi l = (⟨j.val, j.2⟩ : Fin (2 ^ bI))) from
      fun h ↦ hj (Fin.ext (congrArg Fin.val h).symm)), zero_mul]
  · intro h
    exact absurd (Finset.mem_univ _) h

/-! ## Conjugation by the sector swap -/

theorem sqSwF_bits (N : ℕ) (x : Fin (2 ^ (2 * N))) (i : Fin (2 * N)) :
    basisBits (2 * N) (sqSwF N x) i = basisBits (2 * N) x (sqTau N N i) := by
  unfold sqSwF
  rw [Equiv.apply_symm_apply]

theorem sqTau_sp0 (N : ℕ) (q : Fin N) : sqTau N N (spinOrbital N q 0) = spinOrbital N q 1 := by
  apply Fin.ext
  rw [sqTau_val]
  simp only [spinOrbital, Fin.val_mk, Fin.isValue, Fin.val_zero, Fin.val_one]
  have := q.isLt
  have h1 : 2 * q.val + 0 < 2 * N := by omega
  have h2 : (2 * q.val + 0) % 2 = 0 := by omega
  first
  | (simp only [h1, h2, ↓reduceIte]; try omega; done)
  | (rw [if_pos h1, if_pos h2])
  | (split <;> (try split) <;> omega)

theorem sqSpin_mem (N : ℕ) (σ : Fin 2) (w : Wire (2 * N)) :
    w ∈ Set.range (spinReg N σ).wires ↔ w.val % 2 = σ.val := by
  have hσ := σ.isLt
  have hw := w.isLt
  constructor
  · rintro ⟨q, rfl⟩
    change (spinOrbital N q σ).val % 2 = σ.val
    simp only [spinOrbital]
    omega
  · intro h
    refine ⟨⟨w.val / 2, by omega⟩, ?_⟩
    change spinOrbital N ⟨w.val / 2, by omega⟩ σ = w
    apply Fin.ext
    simp only [spinOrbital]
    omega

theorem sqSwF_ext (N : ℕ) (l : Fin (2 ^ (2 * N))) :
    (spinReg N 0).extractIndex (sqSwF N l) = (spinReg N 1).extractIndex l := by
  apply (basisBits N).injective
  funext q
  rw [QRegister.basisBits_extractIndex, QRegister.basisBits_extractIndex, sqSwF_bits]
  change basisBits (2 * N) l (sqTau N N (spinOrbital N q 0)) =
    basisBits (2 * N) l (spinOrbital N q 1)
  rw [sqTau_sp0]

theorem sqSwF_agree (N : ℕ) (i j : Fin (2 ^ (2 * N))) :
    (spinReg N 0).AgreeOutside (sqSwF N i) (sqSwF N j) ↔ (spinReg N 1).AgreeOutside i j := by
  have hpar : ∀ w : Wire (2 * N), (sqTau N N w).val % 2 = 1 - w.val % 2 := by
    intro w
    have := w.isLt
    rw [sqTau_val]
    split_ifs <;> omega
  constructor
  · intro h w hw
    have hw' : sqTau N N w ∉ Set.range (spinReg N 0).wires := by
      rw [sqSpin_mem] at hw ⊢
      rw [hpar]
      simp only [Fin.isValue, Fin.val_zero, Fin.val_one] at hw ⊢
      omega
    have := h _ hw'
    rwa [sqSwF_bits, sqSwF_bits, sqTau_invol] at this
  · intro h w hw
    rw [sqSwF_bits, sqSwF_bits]
    apply h
    rw [sqSpin_mem] at hw ⊢
    rw [hpar]
    simp only [Fin.isValue, Fin.val_zero, Fin.val_one] at hw ⊢
    omega

theorem sqSW_conj (N : ℕ) (A : Matrix (Fin (2 ^ N)) (Fin (2 ^ N)) ℂ) :
    (sqSW N).1 * (spinReg N 0).embedMatrix A * (sqSW N).1 = (spinReg N 1).embedMatrix A := by
  have hP : (sqSW N).1 = ((sqSwP N)⁻¹ : Equiv.Perm (Fin (2 ^ (2 * N)))).toPEquiv.toMatrix := rfl
  rw [hP, PEquiv.toMatrix_toPEquiv_mul, PEquiv.mul_toMatrix_toPEquiv]
  ext i j
  show (spinReg N 0).embedMatrix A (sqSwF N i) (sqSwF N j) = _
  rw [QRegister.embedMatrix_apply_of_agreeOutside, QRegister.embedMatrix_apply_of_agreeOutside,
    sqSwF_ext, sqSwF_ext]
  by_cases hag : (spinReg N 1).AgreeOutside i j
  · rw [if_pos ((sqSwF_agree N i j).2 hag), if_pos hag]
  · rw [if_neg (mt (sqSwF_agree N i j).1 hag), if_neg hag]

/-- The sector swap of index block `j` (bit 0 of `j` set). -/
noncomputable def sqSWj (N bI : ℕ) (hbI : 1 ≤ bI) (j : Fin (2 ^ bI)) : Unitary (2 ^ (2 * N)) :=
  if basisBits bI j ⟨0, hbI⟩ = 1 then sqSW N else 1

theorem sqSWb_conj (N bI : ℕ) (hbI : 1 ≤ bI) (j : Fin (2 ^ bI)) (σ : Fin 2)
    (hσ : j.val % 2 = σ.val) (A : Matrix (Fin (2 ^ N)) (Fin (2 ^ N)) ℂ) :
    (sqSWj N bI hbI j).1 * (spinReg N 0).embedMatrix A * (sqSWj N bI hbI j).1 =
      (spinReg N σ).embedMatrix A := by
  unfold sqSWj
  rw [sqBit0 hbI j]
  rcases Nat.mod_two_eq_zero_or_one j.val with h | h
  · have e : σ = 0 := Fin.ext (by rw [← hσ, h]; try rfl)
    subst e
    rw [h, Nat.cast_zero, if_neg zero_ne_one]
    have hone : (1 : Unitary (2 ^ (2 * N))).1 = 1 := rfl
    rw [hone, Matrix.one_mul, Matrix.mul_one]
  · have e : σ = 1 := Fin.ext (by rw [← hσ, h]; try rfl)
    subst e
    rw [h, Nat.cast_one, if_pos rfl]
    exact sqSW_conj N A

theorem sqSWj_sq (N bI : ℕ) (hbI : 1 ≤ bI) (j : Fin (2 ^ bI)) :
    sqSWj N bI hbI j * sqSWj N bI hbI j = 1 := by
  apply Subtype.ext
  have h := sqSWb_conj N bI hbI j ⟨j.val % 2, Nat.mod_lt _ (by norm_num)⟩ rfl 1
  rw [QRegister.embedMatrix_one, QRegister.embedMatrix_one, Matrix.mul_one] at h
  exact h

theorem sqPF_sq (N : ℕ) : (parityFix N 0).eval * (parityFix N 0).eval = 1 := by
  apply Subtype.ext
  show (parityFix N 0).eval.1 * (parityFix N 0).eval.1 = 1
  rw [parityFix_eval, Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
  congr 1
  funext i
  exact sqSignSq N 0 i

/-! ## Conjugation by the cascade -/

theorem sqG_conj (N beth : ℕ) [NeZero N] (hN : 0 < N) (x : Fin (2 ^ (N * beth)))
    (κ : Fin N → ℤ) (hx : ∀ q, angleVec N beth x q % 2 ^ beth = κ q % 2 ^ beth) :
    ((spinReg N 0).embedUnitary (sqGW N beth hN x)⁻¹).1 * (sqZ0 N hN).1 *
        ((spinReg N 0).embedUnitary (sqGW N beth hN x)).1 =
      (spinReg N 0).embedMatrix (1 - (2 : ℂ) • singleSpinOrbitalNumberOp N (givensLeaf beth κ)) := by
  have hG : sqGW N beth hN x = givensCascadeUnitary N beth κ :=
    givensCascadePrefix_leaf_congr N beth _ _ hx _ _
  have hz := givensCascadeUnitary_conj_pauliZ0 N beth κ
  simp only at hz
  have hinv : ((givensCascadeUnitary N beth κ)⁻¹).1 = (givensCascadeUnitary N beth κ).1ᴴ := by
    show star (givensCascadeUnitary N beth κ).1 = _
    exact Matrix.star_eq_conjTranspose _
  rw [hG]
  unfold sqZ0
  simp only [QRegister.embedUnitary_val]
  rw [← QRegister.embedMatrix_mul, ← QRegister.embedMatrix_mul, hinv, hz]

/-! ## The middle, block by block in the index -/

/-- The middle at `rX` value `y` and index block `j`. -/
noncomputable def sqMid2 (N bI beth : ℕ) (hbI : 1 ≤ bI) (hN : 0 < N)
    (y : Fin (2 ^ (N * beth + 2))) (j : Fin (2 ^ bI)) : Unitary (2 ^ (2 * N)) :=
  (if basisBits (N * beth + 2) y ⟨N * beth + 1, by omega⟩ = 1 then sqNeg (2 * N) else 1) *
    (parityFix N 0).eval * sqSWj N bI hbI j *
    (spinReg N 0).embedUnitary (sqGW N beth hN ((sqQ N beth).extractIndex y))⁻¹ *
    (if basisBits (N * beth + 2) y ⟨N * beth, by omega⟩ = 1 then sqZ0 N hN else 1) *
    (spinReg N 0).embedUnitary (sqGW N beth hN ((sqQ N beth).extractIndex y)) *
    sqSWj N bI hbI j * (parityFix N 0).eval

theorem sqNeg_bd (N bI : ℕ) :
    sqNeg (2 * N + bI) = blockDiag (fun _ : Fin (2 ^ bI) ↦ sqNeg (2 * N)) := by
  rw [blockDiag_const]
  apply Subtype.ext
  change (-1 : Matrix (Fin (2 ^ (2 * N + bI))) (Fin (2 ^ (2 * N + bI))) ℂ) =
    (QRegister.block 0 (2 * N) (by omega) : QRegister (2 * N) (2 * N + bI)).embedMatrix (-1)
  rw [show (-1 : Matrix (Fin (2 ^ (2 * N))) (Fin (2 ^ (2 * N))) ℂ) = (-1 : ℂ) • 1 from
    (neg_one_smul ℂ _).symm, QRegister.embedMatrix_smul, QRegister.embedMatrix_one, neg_one_smul]

theorem sqMidW_eq (N bI beth : ℕ) (hbI : 1 ≤ bI) (hN : 0 < N) (y : Fin (2 ^ (N * beth + 2))) :
    sqMidW N bI beth hbI hN y = blockDiag (fun j ↦ sqMid2 N bI beth hbI hN y j) := by
  have hz : sqWz N bI beth y = blockDiag (fun _ : Fin (2 ^ bI) ↦
      if basisBits (N * beth + 2) y ⟨N * beth + 1, by omega⟩ = 1 then sqNeg (2 * N) else 1) := by
    unfold sqWz
    by_cases h : basisBits (N * beth + 2) y ⟨N * beth + 1, by omega⟩ = 1
    · rw [if_pos h, if_pos h, sqNeg_bd]
    · rw [if_neg h, if_neg h, blockDiag_one]
  have hcz : sqWcz N bI beth hN y = blockDiag (fun _ : Fin (2 ^ bI) ↦
      if basisBits (N * beth + 2) y ⟨N * beth, by omega⟩ = 1 then sqZ0 N hN else 1) := by
    unfold sqWcz
    by_cases h : basisBits (N * beth + 2) y ⟨N * beth, by omega⟩ = 1
    · rw [if_pos h, if_pos h, sqSysConst]
    · rw [if_neg h, if_neg h, blockDiag_one]
  have hg : sqWG N bI beth hN y = blockDiag (fun _ : Fin (2 ^ bI) ↦
      (spinReg N 0).embedUnitary (sqGW N beth hN ((sqQ N beth).extractIndex y))) := by
    unfold sqWG sqSys0
    rw [QRegister.embedUnitary_compose, sqSysConst]
  have hgi : sqWGi N bI beth hN y = blockDiag (fun _ : Fin (2 ^ bI) ↦
      (spinReg N 0).embedUnitary (sqGW N beth hN ((sqQ N beth).extractIndex y))⁻¹) := by
    unfold sqWGi sqSys0
    rw [QRegister.embedUnitary_compose, sqSysConst]
  unfold sqMidW
  rw [hz, hcz, hg, hgi]
  unfold sqPFU sqWsw
  simp only [blockDiag_mul]
  try rfl

theorem sqMid2_eq {N L : ℕ} [NeZero N] (bI beth : ℕ) (hbI : 1 ≤ bI) (hN : 0 < N)
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (y : Fin (2 ^ (N * beth + 2)))
    (j : Fin (2 ^ bI))
    (hy : ∀ q, basisBits (N * beth + 2) y q = sqTab beth bI k s ⟨j.val / 2, sqA_lt hbI j⟩ q) :
    (sqMid2 N bI beth hbI hN y j).1 = selWL beth bI k s j := by
  by_cases hj : j.val < 2 * L
  · have hℓ : j.val / 2 < L := by omega
    have he : basisBits (N * beth + 2) y ⟨N * beth, by omega⟩ = 1 := by
      rw [hy]
      unfold sqTab
      try dsimp only
      rw [dif_pos hℓ, dif_neg (lt_irrefl _), if_pos rfl]
    have hs : basisBits (N * beth + 2) y ⟨N * beth + 1, by omega⟩ =
        if s ⟨j.val / 2, hℓ⟩ then 1 else 0 := by
      rw [hy]
      unfold sqTab
      try dsimp only
      rw [dif_pos hℓ, dif_neg (show ¬ (N * beth + 1 < N * beth) by omega),
        if_neg (show ¬ (N * beth + 1 = N * beth) by omega)]
    have hword : ∀ q : Fin N,
        ((sqQ N beth).extractIndex y).val / 2 ^ (q.val * beth) % 2 ^ beth =
          sqWordVal beth (k ⟨j.val / 2, hℓ⟩ q) := by
      intro q
      apply sqWord_eq beth _ _ _ (sqWordVal_lt beth _)
      intro i hi
      have hqi := sqQB q i hi
      have h1 := QRegister.basisBits_extractIndex (sqQ N beth) y ⟨q.val * beth + i, hqi⟩
      rw [basisBits_eq_div_mod (N * beth)] at h1
      have h2 : (sqQ N beth) ⟨q.val * beth + i, hqi⟩ =
          (⟨q.val * beth + i, by omega⟩ : Fin (N * beth + 2)) := by
        unfold sqQ
        rw [rcB0]
        try rfl
      rw [h2, hy, sqTab_word beth bI k s ⟨j.val / 2, sqA_lt hbI j⟩ hℓ q i hi] at h1
      exact h1
    have hang : ∀ q, angleVec N beth ((sqQ N beth).extractIndex y) q % 2 ^ beth =
        k ⟨j.val / 2, hℓ⟩ q % 2 ^ beth := by
      intro q
      unfold angleVec
      rw [hword q]
      unfold sqWordVal
      rw [Int.toNat_of_nonneg (Int.emod_nonneg _ (by positivity))]
      first
      | rw [Int.emod_emod]
      | rw [Int.emod_emod_of_dvd _ (dvd_refl _)]
      | simp
    have hsel : selWL beth bI k s j =
        (if s ⟨j.val / 2, hℓ⟩ then (-1 : ℂ) else 1) •
          orbitalReflection N (givensLeaf beth (k ⟨j.val / 2, hℓ⟩))
            ⟨j.val % 2, Nat.mod_lt _ (by norm_num)⟩ := by
      unfold selWL
      rw [dif_pos hj]
      try rfl
    have hneg : (sqNeg (2 * N)).1 = -1 := rfl
    have hone : (1 : Unitary (2 ^ (2 * N))).1 = 1 := rfl
    rw [hsel]
    unfold sqMid2
    rw [if_pos he]
    simp only [sqMulVal]
    rw [sqAssoc8, sqG_conj N beth hN _ (k ⟨j.val / 2, hℓ⟩) hang,
      sqSWb_conj N bI hbI j ⟨j.val % 2, Nat.mod_lt _ (by norm_num)⟩ rfl, parityFix_eval,
      ← orbitalReflection_eq_parityFix0]
    by_cases hst : s ⟨j.val / 2, hℓ⟩ = true
    · rw [if_pos hst] at hs
      rw [if_pos hs, if_pos hst, hneg, neg_one_mul, neg_one_smul]
    · rw [if_neg hst] at hs
      rw [if_neg (fun h ↦ zero_ne_one (hs.symm.trans h)), if_neg hst, hone, Matrix.one_mul,
        one_smul]
  · have hℓ : ¬ j.val / 2 < L := by omega
    have h0 : ∀ q, basisBits (N * beth + 2) y q = 0 := by
      intro q
      rw [hy]
      unfold sqTab
      rw [dif_neg hℓ]
    have he0 : ¬ basisBits (N * beth + 2) y ⟨N * beth, by omega⟩ = 1 := by
      rw [h0]; exact zero_ne_one
    have hs0 : ¬ basisBits (N * beth + 2) y ⟨N * beth + 1, by omega⟩ = 1 := by
      rw [h0]; exact zero_ne_one
    have hm : sqMid2 N bI beth hbI hN y j = 1 := by
      unfold sqMid2
      rw [if_neg hs0, if_neg he0, QRegister.embedUnitary_inv]
      simp only [mul_one, one_mul, inv_mul_cancel_right]
      rw [mul_assoc ((parityFix N 0).eval) (sqSWj N bI hbI j), sqSWj_sq, mul_one, sqPF_sq]
    rw [hm]
    unfold selWL
    rw [dif_neg hj]
    try rfl

/-! ## The QROM on a basis ket -/

theorem sqQrom_ket {N L bI beth : ℕ} (hbI : 1 ≤ bI) (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (rTI : QRegister (2 * N + bI) n) (rS : QRegister (selQScr N bI beth) n)
    (rCat : QRegister beth n) (hsc : rS.DisjointWires rCat)
    (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) (γ : BitAssignment n) (j : Fin (2 ^ bI))
    (hj : bdHi (k := 2 * N) (j := bI) (localIdx rTI γ) = j) (hA : ∀ c, γ (sqRA rS c) = 0) :
    (sqQrom hbI k s rTI rS rCat hsc hdisj).eval.1 *ᵥ ket γ =
      ket (γ + QC14.UnaryLookup.tabAdd (sqWires hbI rTI rS rCat hsc hdisj)
        (sqTab beth bI k s ⟨j.val / 2, sqA_lt hbI j⟩)) := by
  subst hj
  unfold sqQrom
  exact QC14.UnaryLookup.ulookup_ket (sqWires hbI rTI rS rCat hsc hdisj) (sqTab beth bI k s)
    ⟨(bdHi (k := 2 * N) (j := bI) (localIdx rTI γ)).val / 2, sqA_lt hbI _⟩ γ
    (fun c ↦ hA _) (fun i ↦
      (congrFun ((basisBits (2 * N + bI)).apply_symm_apply (fun i ↦ γ (rTI i)))
        ⟨2 * N + 1 + i.val, by omega⟩).symm.trans (sqAddr_bits hbI _ i))

set_option maxHeartbeats 800000 in
/-- `selectOpL` exactly, catalyst restored, scratch clean. -/
theorem selectQ_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    (hb : 2 ≤ beth) {N L bI : ℕ} [NeZero N] (hbI : 1 ≤ bI) (k : Fin L → Fin N → ℤ)
    (s : Fin L → Bool) (h2L : 2 * L ≤ 2 ^ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    ∃ U : Unitary (2 ^ (2 * N + bI)),
      U.1 = selectOpL N L bI beth k s h2L ∧
      CatKet rTI rS rCat hsc (selectQ v beth hbI k s rTI rS rCat hsc hdisj).compile U := by
  have hN : 0 < N := Nat.pos_of_ne_zero (NeZero.ne N)
  refine ⟨⟨selectOpL N L bI beth k s h2L, selectOpL_mem N L bI beth k s h2L⟩, rfl, ?_⟩
  simp only [selectQ, dif_pos hN, DynamicCircuit.compile_seq, DynamicCircuit.compile_circuit]
  obtain ⟨Rm, hRm, hkm⟩ := sqMid_cat v beth hb hbI hN rTI rS rCat hsc hdisj
  refine ⟨_, (lowerKraus_circuit (Var := Var) (sqQrom hbI k s rTI rS rCat hsc hdisj)).qSeq
    (hRm.qSeq (lowerKraus_circuit (Var := Var) (sqQrom hbI k s rTI rS rCat hsc hdisj))),
    fun β hβ ↦ ?_⟩
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
  have hz := eq_zero_of_localIdx_eq_zero rS β (localIdx_concat_zero rS rCat hsc β hβ).1
  have hC0 := eq_zero_of_localIdx_eq_zero rCat β (localIdx_concat_zero rS rCat hsc β hβ).2
  have hX0 : ∀ q, β (sqRX rS q) = 0 := fun q ↦ by rw [sqRX_apply]; exact hz _
  have hA0 : ∀ c, β (sqRA rS c) = 0 := fun c ↦ by rw [sqRA_apply]; exact hz _
  have hR0 : ∀ c, β (sqRest rS c) = 0 := fun c ↦ by rw [sqRest_apply]; exact hz _
  obtain ⟨hTC, hTS⟩ := disjoint_cat rTI rS rCat hsc hdisj
  have hCT := QRegister.disjoint_comm.mp hTC
  have hRAnC : ∀ c, sqRA rS c ∉ Set.range rCat.wires := fun c ⟨i, hi⟩ ↦
    QRegister.disjoint_iff.1 hsc _ i ((sqRA_apply rS c).symm.trans hi.symm)
  have hRAnT : ∀ c, sqRA rS c ∉ Set.range rTI.wires := fun c ⟨i, hi⟩ ↦
    sqRTI_ne_rS hdisj i _ (hi.trans (sqRA_apply rS c))
  obtain ⟨x, hx⟩ : ∃ x, localIdx rTI β = x := ⟨_, rfl⟩
  obtain ⟨δ, hδdef⟩ : ∃ δ, δ = QC14.UnaryLookup.tabAdd (sqWires hbI rTI rS rCat hsc hdisj)
      (sqTab beth bI k s ⟨(bdHi x).val / 2, sqA_lt hbI (bdHi x)⟩) := ⟨_, rfl⟩
  have hδT : ∀ i, δ (rTI i) = 0 := by
    intro i
    rw [hδdef]
    exact sqTabAdd_off _ _ _ fun q h ↦ sqRTI_ne_rS hdisj i _ (h.trans (sqRX_apply rS q))
  have hδC : ∀ i, δ (rCat i) = 0 := by
    intro i
    rw [hδdef]
    exact sqTabAdd_off _ _ _ fun q h ↦
      QRegister.disjoint_iff.1 hsc _ i ((sqRX_apply rS q).symm.trans h.symm)
  have hδA : ∀ c, δ (sqRA rS c) = 0 := by
    intro c
    rw [hδdef]
    apply sqTabAdd_off
    intro q h
    have h' : sqRA rS c = sqRX rS q := h
    rw [sqRA_apply, sqRX_apply] at h'
    have h1 : N * beth + 2 + 2 * beth + c.val = q.val := congrArg Fin.val (sqRS_inj rS _ _ h')
    have := q.isLt
    omega
  have hδR : ∀ c, δ (sqRest rS c) = 0 := by
    intro c
    rw [hδdef]
    apply sqTabAdd_off
    intro q h
    have h' : sqRest rS c = sqRX rS q := h
    rw [sqRest_apply, sqRX_apply] at h'
    have h1 : N * beth + 2 + c.val = q.val := congrArg Fin.val (sqRS_inj rS _ _ h')
    have := q.isLt
    omega
  have hδX : ∀ q, δ (sqRX rS q) =
      sqTab beth bI k s ⟨(bdHi x).val / 2, sqA_lt hbI (bdHi x)⟩ q := by
    intro q
    rw [hδdef]
    exact sqTabAdd_sw _ _ q
  have hstep1 : (sqQrom hbI k s rTI rS rCat hsc hdisj).eval.1 *ᵥ catalystKet rCat β =
      catalystKet rCat (β + δ) := by
    apply sqCatMap
    intro z
    have hj : bdHi (k := 2 * N) (j := bI) (localIdx rTI (writeReg β rCat (basisBits beth z))) =
        bdHi x := by
      rw [localIdx_writeReg_of_disjoint β rCat rTI hCT, hx]
    have hA : ∀ c, writeReg β rCat (basisBits beth z) (sqRA rS c) = 0 := by
      intro c
      rw [writeReg_apply_of_not_mem _ _ _ _ (hRAnC c)]
      exact hA0 c
    rw [sqQrom_ket hbI k s rTI rS rCat hsc hdisj _ (bdHi x) hj hA, ← hδdef,
      sqWrite_add β δ rCat _ hδC]
  have hcl : localIdx ((sqRest rS).concat rCat (sqHR hsc)) (β + δ) = 0 := by
    apply localIdx_eq_zero_of_forall
    intro i
    induction i using Fin.addCases with
    | left c => rw [QRegister.concat_apply_left, Pi.add_apply, hR0 c, hδR c, add_zero]
    | right c => rw [QRegister.concat_apply_right, Pi.add_apply, hC0 c, hδC c, add_zero]
  have hRC : (rTI.concat (sqRX rS) (sqTX hdisj)).DisjointWires rCat := by
    have h := (sqMidDisj hdisj).compose_right (QRegister.block (2 * beth + bI) beth le_rfl)
    rwa [sqConcat_hi] at h
  rw [hstep1, hkm (β + δ) hcl, sqBD_cat _ rCat hRC, rcConcat_lo, sqConcat_hi]
  have hy : ∀ q, basisBits (N * beth + 2) (localIdx (sqRX rS) (β + δ)) q =
      sqTab beth bI k s ⟨(bdHi x).val / 2, sqA_lt hbI (bdHi x)⟩ q := by
    intro q
    rw [show basisBits (N * beth + 2) (localIdx (sqRX rS) (β + δ)) q = (β + δ) (sqRX rS q) from
      congrFun ((basisBits (N * beth + 2)).apply_symm_apply _) q, Pi.add_apply, hX0 q, hδX q,
      zero_add]
  have hcol : ∀ l, (sqMidW N bI beth hbI hN (localIdx (sqRX rS) (β + δ))).1 l x =
      selectOpL N L bI beth k s h2L l x := by
    intro l
    rw [sqMidW_eq, blockDiag_val]
    simp only [blockDiagMat]
    rw [sqMid2_eq bI beth hbI hN k s _ (bdHi x) hy, sqSel_apply]
  rw [embed_catalystKet rTI rCat hTC, embed_catalystKet rTI rCat hTC, Matrix.mulVec_sum]
  refine Finset.sum_congr rfl fun l _ ↦ ?_
  rw [Matrix.mulVec_smul, sqLocal_add rTI β δ hδT, hx, hcol l]
  show selectOpL N L bI beth k s h2L l x • _ = selectOpL N L bI beth k s h2L l x • _
  by_cases hH : bdHi l = bdHi x
  · rw [sqCatMap rCat (writeReg (β + δ) rTI (basisBits (2 * N + bI) l))
      (writeReg β rTI (basisBits (2 * N + bI) l)) (sqQrom hbI k s rTI rS rCat hsc hdisj).eval.1 ?_]
    intro z
    have hj : bdHi (k := 2 * N) (j := bI) (localIdx rTI (writeReg (writeReg (β + δ) rTI
        (basisBits (2 * N + bI) l)) rCat (basisBits beth z))) = bdHi x := by
      rw [localIdx_writeReg_of_disjoint _ rCat rTI hCT, sqLocal_write, hH]
    have hA : ∀ c, writeReg (writeReg (β + δ) rTI (basisBits (2 * N + bI) l)) rCat
        (basisBits beth z) (sqRA rS c) = 0 := by
      intro c
      rw [writeReg_apply_of_not_mem _ _ _ _ (hRAnC c), writeReg_apply_of_not_mem _ _ _ _ (hRAnT c),
        Pi.add_apply, hA0 c, hδA c, add_zero]
    rw [sqQrom_ket hbI k s rTI rS rCat hsc hdisj _ (bdHi x) hj hA, ← hδdef]
    refine congrArg ket ?_
    rw [← sqWrite_add β δ rTI _ hδT, ← sqWrite_add _ δ rCat _ hδC, add_assoc]
    have h2 : ∀ t : ZMod 2, t + t = 0 := by decide
    rw [show δ + δ = 0 from funext fun w ↦ h2 (δ w), add_zero]
  · rw [sqSel_apply, if_neg hH, zero_smul, zero_smul]

theorem sqCswP_count {N bI beth : ℕ} (hbI : 1 ≤ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc))
    (m : ℕ) (hm : m ≤ N) :
    (sqCswP hbI rTI rS rCat hsc hdisj m hm).count PrimitiveGate.TOFF = 0 ∧
      (sqCswP hbI rTI rS rCat hsc hdisj m hm).count PrimitiveGate.T = 8 * m := by
  induction m with
  | zero => simp [sqCswP, Circuit.count_identity]
  | succ m ih =>
      obtain ⟨a, b⟩ := ih (by omega)
      obtain ⟨c, d⟩ := QC14.PairProgram.fredkinW_count (rTI ⟨2 * N, by omega⟩)
        (rTI ⟨2 * m, by omega⟩) (rTI ⟨2 * m + 1, by omega⟩) (sqRA rS ⟨0, by omega⟩)
        (fun h ↦ by have := rTI.wires.injective h; simp only [Fin.ext_iff] at this; omega)
        (fun h ↦ by have := rTI.wires.injective h; simp only [Fin.ext_iff] at this; omega)
        (sqRTI_ne_rS hdisj _ _) (sqRTI_ne_rS hdisj _ _) (sqRTI_ne_rS hdisj _ _)
      simp only [sqCswP, Circuit.count_seq]
      omega

theorem sqCzGate_count (a c : Wire n) :
    (czGate a c).count PrimitiveGate.TOFF = 0 ∧ (czGate a c).count PrimitiveGate.T = 0 := by
  unfold czGate
  split_ifs <;> simp [Circuit.count_seq, Circuit.count_identity, Circuit.count_gate]

theorem sqCzCircuit_count (l : List (Wire n × Wire n)) :
    (czCircuit l).count PrimitiveGate.TOFF = 0 ∧ (czCircuit l).count PrimitiveGate.T = 0 := by
  induction l with
  | nil => simp [czCircuit, Circuit.count_identity]
  | cons x xs ih =>
      obtain ⟨a, b⟩ := sqCzGate_count x.1 x.2
      simp only [czCircuit, Circuit.count_seq]
      omega

theorem sqClifford_count {N bI beth : ℕ} (hbI : 1 ≤ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) :
    (sqPF rTI).count PrimitiveGate.TOFF = 0 ∧ (sqPF rTI).count PrimitiveGate.T = 0 ∧
      (sqCZ hbI rTI rS).count PrimitiveGate.TOFF = 0 ∧ (sqCZ hbI rTI rS).count PrimitiveGate.T = 0 ∧
      (sqZ rS).count PrimitiveGate.TOFF = 0 ∧ (sqZ rS).count PrimitiveGate.T = 0 := by
  obtain ⟨a, b⟩ := sqCzCircuit_count (czPairs N 0)
  obtain ⟨c, d⟩ := sqCzGate_count (sqRX rS ⟨N * beth, by omega⟩) (rTI ⟨0, by omega⟩)
  refine ⟨?_, ?_, c, d, ?_, ?_⟩
  · rw [sqPF, Circuit.count_onRegister]; exact a
  · rw [sqPF, Circuit.count_onRegister]; exact b
  · simp [sqZ, Circuit.count_gate]
  · simp [sqZ, Circuit.count_gate]

/-- No Toffoli; `T ≤ 16 (N − 1)(beth − 1) + 16 N + 8 · 2^bI` (P4.2; was `32 (N − 1) beth + …`). -/
theorem selectQ_count {Var : Type} (v : Var) (beth : ℕ) {N L bI : ℕ} [NeZero N] (hbI : 1 ≤ bI)
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selQScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    (selectQ v beth hbI k s rTI rS rCat hsc hdisj).count PrimitiveGate.TOFF = 0 ∧
      (selectQ v beth hbI k s rTI rS rCat hsc hdisj).count PrimitiveGate.T ≤
        16 * (N - 1) * (beth - 1) + 16 * N + 8 * 2 ^ bI := by
  have hN : 0 < N := Nat.pos_of_ne_zero (NeZero.ne N)
  obtain ⟨q1, q2⟩ := QC14.UnaryLookup.ulookup_count (sqWires hbI rTI rS rCat hsc hdisj)
    (sqTab beth bI k s)
  obtain ⟨w1, w2⟩ := sqCswP_count hbI rTI rS rCat hsc hdisj N le_rfl
  obtain ⟨c1, c2⟩ := regCascadeS_count v beth (rTI.compose (sqSys0 N bI)) (sqWords (sqRX rS))
    (sqTA rTI rS rCat hsc hdisj) (sqRK rS) rCat (N - 1) (by omega)
  obtain ⟨d1, d2⟩ := regCascadeInvS_count v beth (rTI.compose (sqSys0 N bI)) (sqWords (sqRX rS))
    (sqTA rTI rS rCat hsc hdisj) (sqRK rS) rCat (N - 1) (by omega)
  obtain ⟨p1, p2, z1, z2, g1, g2⟩ := sqClifford_count hbI rTI rS
  have h2 : 2 ^ bI = 2 * 2 ^ (bI - 1) := by
    rw [← pow_succ']; congr 1; omega
  simp only [selectQ, dif_pos hN, sqMid, DynamicCircuit.count, sqQrom, sqCsw]
  refine ⟨by omega, ?_⟩
  rw [h2]
  have e : 16 * (N - 1) * (beth - 1) = 8 * (N - 1) * (beth - 1) + 8 * (N - 1) * (beth - 1) := by ring
  omega

end QC14.SelectQ


