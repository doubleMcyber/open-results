          (∑ i, ∑ j, if i < j then w i j • (R i * R j) else 0) +
          ∑ i, ∑ j, if j < i then w i j • (R i * R j) else 0 := by
        simp only [Finset.sum_add_distrib]
    _ = _ := by
        rw [hD, hV, hU]
        abel

/-! ### The four statements -/

/-- Centered form of the THC Hamiltonian. -/
theorem thcHamiltonian_centered {N M : ℕ} (thc : THCFactorization N M) :
    thcHamiltonian thc =
      oneBodyHamiltonian (thcShiftedOneBody thc) -
        ((2⁻¹ * ∑ μ, ∑ ν, thc.zeta μ ν : ℝ) : ℂ) • (1 : Operator (2 ^ (2 * N))) +
        (8 : ℂ)⁻¹ • ∑ a : Fin (2 * M), ∑ b : Fin (2 * M),
          (zeta2 thc a b : ℂ) • (twoRow thc a * twoRow thc b) := by
  have hw : ∀ a b : Fin (2 * M), (zeta2 thc a b : ℂ) = (zeta2 thc b a : ℂ) :=
    fun a b => congrArg (fun x : ℝ => (x : ℂ)) (zeta2_symm thc a b)
  have habs : (2 : ℂ)⁻¹ • ∑ a : Fin (2 * M), ∑ b : Fin (2 * M),
        (zeta2 thc a b : ℂ) • (nRow thc a * nRow thc b) =
      (2 : ℂ)⁻¹ • ∑ a : Fin (2 * M), ∑ b : Fin (2 * M), (zeta2 thc a b : ℂ) • nRow thc a -
        ((8 : ℂ)⁻¹ * ∑ a : Fin (2 * M), ∑ b : Fin (2 * M), (zeta2 thc a b : ℂ)) •
          (1 : Operator (2 ^ (2 * N))) +
        (8 : ℂ)⁻¹ • ∑ a : Fin (2 * M), ∑ b : Fin (2 * M), (zeta2 thc a b : ℂ) •
          ((1 - (2 : ℂ) • nRow thc a) * (1 - (2 : ℂ) • nRow thc b)) :=
    center_abs (fun a b => (zeta2 thc a b : ℂ)) hw (nRow thc)
  have hQ : ∑ a : Fin (2 * M), ∑ b : Fin (2 * M),
        (zeta2 thc a b : ℂ) • (nRow thc a * nRow thc b) =
      ∑ σ : Fin 2, ∑ τ : Fin 2, ∑ μ : Fin M, ∑ ν : Fin M, (thc.zeta μ ν : ℂ) •
        (orbitalNumberOp N (thc.chi μ) σ * orbitalNumberOp N (thc.chi ν) τ) := by
    simp only [sumRows, nRow_equiv, zeta2_equiv]
    exact sum4_perm (fun μ σ ν τ => (thc.zeta μ ν : ℂ) •
      (orbitalNumberOp N (thc.chi μ) σ * orbitalNumberOp N (thc.chi ν) τ))
  have hL : ∑ a : Fin (2 * M), ∑ b : Fin (2 * M), (zeta2 thc a b : ℂ) • nRow thc a =
      (2 : ℂ) • ∑ μ : Fin M, ∑ ν : Fin M,
        (thc.zeta μ ν : ℂ) • ∑ σ : Fin 2, orbitalNumberOp N (thc.chi μ) σ := by
    simp only [sumRows, nRow_equiv, zeta2_equiv, Fin.sum_univ_two, smul_add,
      Finset.sum_add_distrib]
    module
  have hW : ∑ a : Fin (2 * M), ∑ b : Fin (2 * M), (zeta2 thc a b : ℂ) =
      4 * ∑ μ : Fin M, ∑ ν : Fin M, (thc.zeta μ ν : ℂ) := by
    simp only [sumRows, zeta2_equiv, Fin.sum_univ_two, Finset.sum_add_distrib]
    ring
  have hOB : oneBodyHamiltonian (thcShiftedOneBody thc) = oneBodyHamiltonian thc.h1eMod +
      ∑ μ : Fin M, ∑ ν : Fin M,
        (thc.zeta μ ν : ℂ) • ∑ σ : Fin 2, orbitalNumberOp N (thc.chi μ) σ := by
    have hT : thcShiftedOneBody thc = thc.h1eMod +
        ∑ μ : Fin M, ∑ ν : Fin M, thc.zeta μ ν • vecMulVec (thc.chi μ) (thc.chi μ) := by
      ext p q
      simp only [thcShiftedOneBody, Matrix.add_apply, Matrix.sum_apply, Matrix.smul_apply,
        Matrix.vecMulVec_apply, smul_eq_mul, mul_assoc]
    rw [hT, oneBodyHamiltonian_add]
    congr 1
    simp only [oneBodyHamiltonian_sum, oneBodyHamiltonian_smul, oneBodyHamiltonian_vecMulVec]
  unfold thcHamiltonian
  simp only [twoRow_eq_nRow]
  rw [hOB, ← hQ, habs, hL, hW]
  push_cast
  module

/-- Ordered row pairs grouped into unordered ones. -/
theorem twoBody_pairs {N M : ℕ} (thc : THCFactorization N M)
    (hsq : ∀ a, twoRow thc a * twoRow thc a = 1) :
    (8 : ℂ)⁻¹ • ∑ a : Fin (2 * M), ∑ b : Fin (2 * M),
        (zeta2 thc a b : ℂ) • (twoRow thc a * twoRow thc b) =
      ((4⁻¹ * ∑ μ, thc.zeta μ μ : ℝ) : ℂ) • (1 : Operator (2 ^ (2 * N))) +
        ∑ a : Fin (2 * M), ∑ b : Fin (2 * M),
          if a < b then ((zeta2 thc a b / 8 : ℝ) : ℂ) •
            (twoRow thc a * twoRow thc b + twoRow thc b * twoRow thc a) else 0 := by
  have hw : ∀ a b : Fin (2 * M), (zeta2 thc a b : ℂ) = (zeta2 thc b a : ℂ) :=
    fun a b => congrArg (fun x : ℝ => (x : ℂ)) (zeta2_symm thc a b)
  have habs : ∑ a : Fin (2 * M), ∑ b : Fin (2 * M),
        (zeta2 thc a b : ℂ) • (twoRow thc a * twoRow thc b) =
      (∑ a : Fin (2 * M), (zeta2 thc a a : ℂ)) • (1 : Operator (2 ^ (2 * N))) +
        ∑ a : Fin (2 * M), ∑ b : Fin (2 * M), if a < b then (zeta2 thc a b : ℂ) •
          (twoRow thc a * twoRow thc b + twoRow thc b * twoRow thc a) else 0 :=
    pairs_abs (fun a b => (zeta2 thc a b : ℂ)) hw (twoRow thc) hsq
  have hdiag : ∑ a : Fin (2 * M), (zeta2 thc a a : ℂ) = 2 * ∑ μ : Fin M, (thc.zeta μ μ : ℂ) := by
    simp only [sumRows, zeta2_equiv, Fin.sum_univ_two]
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun μ _ => by ring
  have hite : (8 : ℂ)⁻¹ • ∑ a : Fin (2 * M), ∑ b : Fin (2 * M), (if a < b then
        (zeta2 thc a b : ℂ) • (twoRow thc a * twoRow thc b + twoRow thc b * twoRow thc a)
        else 0) =
      ∑ a : Fin (2 * M), ∑ b : Fin (2 * M), if a < b then ((zeta2 thc a b / 8 : ℝ) : ℂ) •
        (twoRow thc a * twoRow thc b + twoRow thc b * twoRow thc a) else 0 := by
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl fun b _ => ?_
    split_ifs
    · rw [smul_smul]
      congr 1
      push_cast
      ring
    · simp
  have hc : (8 : ℂ)⁻¹ * ∑ a : Fin (2 * M), (zeta2 thc a a : ℂ) =
      ((4⁻¹ * ∑ μ, thc.zeta μ μ : ℝ) : ℂ) := by
    rw [hdiag]
    push_cast
    ring
  rw [habs, smul_add, smul_smul, hc, hite]

/-- The THC Hamiltonian as identity, one-body rows and symmetrized two-body row pairs, given a
rank decomposition of the shifted one-body matrix. -/
theorem thcHamiltonian_rows {N M L : ℕ} (thc : THCFactorization N M) (t : Fin L → ℝ)
    (u : Fin L → Fin N → ℝ)
    (hT : thcShiftedOneBody thc = ∑ ℓ, t ℓ • vecMulVec (u ℓ) (u ℓ))
    (hsq : ∀ a, twoRow thc a * twoRow thc a = 1) :
    thcHamiltonian thc =
      ((∑ ℓ, t ℓ - 2⁻¹ * ∑ μ, ∑ ν, thc.zeta μ ν + 4⁻¹ * ∑ μ, thc.zeta μ μ : ℝ) : ℂ) •
          (1 : Operator (2 ^ (2 * N))) -
        ∑ ℓ, ∑ σ : Fin 2, ((t ℓ / 2 : ℝ) : ℂ) • orbitalReflection N (u ℓ) σ +
        ∑ a : Fin (2 * M), ∑ b : Fin (2 * M),
          if a < b then ((zeta2 thc a b / 8 : ℝ) : ℂ) •
            (twoRow thc a * twoRow thc b + twoRow thc b * twoRow thc a) else 0 := by
  rw [thcHamiltonian_centered thc, twoBody_pairs thc hsq, hT,
    oneBodyHamiltonian_eq_reflections t u]
  push_cast
  module

/-- The THC Hamiltonian preserves every electron-number sector. -/
theorem thcHamiltonian_comm_sector {N M : ℕ} (thc : THCFactorization N M) (η : ℕ) :
    thcHamiltonian thc * electronSectorProjector (2 * N) η =
      electronSectorProjector (2 * N) η * thcHamiltonian thc := by
  have hn : ∀ (χ : Fin N → ℝ) (σ : Fin 2),
      Commute (orbitalNumberOp N χ σ) (electronSectorProjector (2 * N) η) := fun χ σ ↦
    QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.OrbitalBridge.orbitalNumberOp_comm_electronSectorProjector
      N η χ σ
  have h1 : Commute (oneBodyHamiltonian thc.h1eMod) (electronSectorProjector (2 * N) η) :=
    oneBody_comm_sector _ η
  have h2 : Commute (thcHamiltonian thc) (electronSectorProjector (2 * N) η) := by
    unfold thcHamiltonian
    refine h1.add_left (Commute.smul_left (Commute.sum_left _ _ _ fun σ _ ↦
      Commute.sum_left _ _ _ fun τ _ ↦ Commute.sum_left _ _ _ fun μ _ ↦
        Commute.sum_left _ _ _ fun ν _ ↦
          Commute.smul_left ((hn _ _).mul_left (hn _ _)) _) _)
  exact h2

end QC14.TwoBodyAlgebra


/-! Inlined from lane module `THC/WeightsM0.lean`. -/

namespace QC14.WeightsM0

open QuantumComputation QuantumComputation.Specs Finset Matrix
open QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.OrbitalBridge
  (orbitalReflection orbitalNumberOp_conjTranspose)
open scoped Matrix

/-! ## Extraction from `IsRounded` -/

/-- What `IsRounded` says at `M = 0`, with the integer weights chosen (zero when all `t`
vanish). -/
def M0Facts {N : ℕ} (thc : THCFactorization N 0) (aleph beth : ℕ) (lam : ℝ)
    (t : Fin N → ℝ) (k : Fin N → Fin N → ℤ) (j : Fin N → ℕ) : Prop :=
  thc.h1eMod = ∑ ℓ, t ℓ • vecMulVec (givensLeaf beth (k ℓ)) (givensLeaf beth (k ℓ)) ∧
    ∑ ℓ, |t ℓ| ≤ lam ∧
    (∀ ℓ, |t ℓ| = j ℓ * ((∑ ℓ', |t ℓ'|) / ((N : ℝ) * 2 ^ aleph))) ∧
    ((∑ ℓ, |t ℓ|) = 0 → ∀ ℓ, j ℓ = 0)

theorem exists_m0Facts {N : ℕ} (thc : THCFactorization N 0) {aleph beth : ℕ} {lam : ℝ}
    (hround : thc.IsRounded aleph beth lam) :
    ∃ t k j, M0Facts thc aleph beth lam t k j := by
  obtain ⟨-, t, k, h⟩ := hround
  obtain ⟨h1, h2, h3, -, -⟩ := h
  have e : thcShiftedOneBody thc = thc.h1eMod := by
    funext p q
    simp [thcShiftedOneBody]
  have h1' : thc.h1eMod = ∑ ℓ, t ℓ • vecMulVec (givensLeaf beth (k ℓ)) (givensLeaf beth (k ℓ)) := by
    rw [← e]; exact h1
  have h2' : ∑ ℓ, |t ℓ| ≤ lam := by simpa using h2
  have h3' : ∀ ℓ, ∃ j : ℕ, |t ℓ| = j * ((∑ ℓ', |t ℓ'|) / ((N : ℝ) * 2 ^ aleph)) := by
    intro ℓ
    obtain ⟨j, hj⟩ := h3 ℓ
    exact ⟨j, by simpa using hj⟩
  by_cases hS : ∑ ℓ, |t ℓ| = 0
  · refine ⟨t, k, fun _ => 0, h1', h2', ?_, fun _ _ => rfl⟩
    intro ℓ
    have : |t ℓ| = 0 :=
      (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => abs_nonneg (t i))).1 hS ℓ (Finset.mem_univ _)
    simp [this]
  · choose j hj using h3'
    exact ⟨t, k, j, h1', h2', hj, fun h => absurd h hS⟩

/-- The rounding data: coefficients, Givens angle indices, integer weights. -/
structure M0Data (N : ℕ) where
  t : Fin N → ℝ
  k : Fin N → Fin N → ℤ
  j : Fin N → ℕ

open scoped Classical in
/-- The rounding data chosen from `IsRounded` (all zero when it fails). -/
noncomputable def m0Data {N : ℕ} (thc : THCFactorization N 0) (aleph beth : ℕ) (lam : ℝ) :
    M0Data N :=
  if h : ∃ t k j, M0Facts thc aleph beth lam t k j then
    ⟨h.choose, h.choose_spec.choose, h.choose_spec.choose_spec.choose⟩
  else ⟨0, 0, 0⟩

theorem m0Data_facts {N : ℕ} (thc : THCFactorization N 0) {aleph beth : ℕ} {lam : ℝ}
    (hround : thc.IsRounded aleph beth lam) :
    M0Facts thc aleph beth lam (m0Data thc aleph beth lam).t (m0Data thc aleph beth lam).k
      (m0Data thc aleph beth lam).j := by
  unfold m0Data
  rw [dif_pos (exists_m0Facts thc hround)]
  exact (exists_m0Facts thc hround).choose_spec.choose_spec.choose_spec

/-! ## Sizes and weights -/

/-- `Σ |t_ℓ|`. -/
noncomputable def lamRepD {N : ℕ} (D : M0Data N) : ℝ := ∑ ℓ, |D.t ℓ|

/-- The rounding unit `q = Σ |t| / (N 2^aleph)`. -/
noncomputable def qD {N : ℕ} (D : M0Data N) (aleph : ℕ) : ℝ :=
  lamRepD D / ((N : ℝ) * 2 ^ aleph)

/-- Width of the PREPARE garbage register: the weights sum to `2^gW`. -/
def gW (N aleph : ℕ) : ℕ := Nat.clog 2 (2 * N * 2 ^ aleph + 1)

/-- Width of the row index register (`2N + 1` rows). -/
def idxW (N : ℕ) : ℕ := Nat.clog 2 (2 * N + 1)

/-- Extra PREPARE bits, so that `idxW + muW = gW`. -/
def muW (N aleph : ℕ) : ℕ := gW N aleph - idxW N

/-- Row weights: row `2ℓ + σ` gets `j_ℓ`, row `2N` (the identity filler) the rest. -/
def rowWeight {N : ℕ} (D : M0Data N) (aleph : ℕ) (r : Fin (2 * N + 1)) : ℕ :=
  if h : r.val < 2 * N then D.j ⟨r.val / 2, by omega⟩ else 2 ^ gW N aleph - 2 * ∑ ℓ, D.j ℓ

/-- Sign of `t_ℓ` (`+1` at zero). -/
noncomputable def rowSign {N : ℕ} (D : M0Data N) (ℓ : Fin N) : ℝ :=
  if D.t ℓ < 0 then -1 else 1

/-- Row operators: `-sgn(t_ℓ) R_{ℓσ}` on row `2ℓ + σ`, the identity on the filler. -/
noncomputable def rowOp {N : ℕ} (D : M0Data N) (beth : ℕ) (r : Fin (2 * N + 1)) :
    Operator (2 ^ (2 * N)) :=
  if h : r.val < 2 * N then
    ((-rowSign D ⟨r.val / 2, by omega⟩ : ℝ) : ℂ) •
      orbitalReflection N (givensLeaf beth (D.k ⟨r.val / 2, by omega⟩)) ⟨r.val % 2, by omega⟩
  else 1

/-- Block-encoding normalization. -/
noncomputable def alphaD {N : ℕ} (D : M0Data N) (aleph : ℕ) : ℝ :=
  if 0 < lamRepD D then qD D aleph / 2 * 2 ^ gW N aleph else 1

/-- Identity offset: `Σ t - f q / 2` with filler weight `f`, or `-1` when all `t` vanish. -/
noncomputable def offsetD {N : ℕ} (D : M0Data N) (aleph : ℕ) : ℝ :=
  if 0 < lamRepD D then
    ∑ ℓ, D.t ℓ - ((2 ^ gW N aleph - 2 * ∑ ℓ, D.j ℓ : ℕ) : ℝ) * qD D aleph / 2
  else -1

/-! ## Arithmetic facts -/

theorem lamRepD_nonneg {N : ℕ} (D : M0Data N) : 0 ≤ lamRepD D :=
  Finset.sum_nonneg (fun i _ => abs_nonneg (D.t i))

theorem N_pos_of_lamRepD_pos {N : ℕ} (D : M0Data N) (h : 0 < lamRepD D) : 0 < N := by
  rcases Nat.eq_zero_or_pos N with rfl | hN
  · simp [lamRepD] at h
  · exact hN

private theorem sum_range_two_mul {V : Type*} [AddCommMonoid V] (G : ℕ → V) (n : ℕ) :
    ∑ i ∈ Finset.range (2 * n), G i = ∑ ℓ ∈ Finset.range n, (G (2 * ℓ) + G (2 * ℓ + 1)) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [show 2 * (n + 1) = 2 * n + 1 + 1 by ring]
    simp only [Finset.sum_range_succ]
    rw [ih]
    abel

theorem sum_fin_two_mul {V : Type*} [AddCommMonoid V] (n : ℕ) (F : Fin (2 * n) → V) :
    ∑ i, F i = ∑ ℓ : Fin n, (F ⟨2 * ℓ.val, by have := ℓ.isLt; omega⟩ +
      F ⟨2 * ℓ.val + 1, by have := ℓ.isLt; omega⟩) := by
  classical
  let G : ℕ → V := fun i => if h : i < 2 * n then F ⟨i, h⟩ else 0
  have h1 : ∑ i, F i = ∑ i : Fin (2 * n), G i.val :=
    Finset.sum_congr rfl (fun i _ => by simp [G, i.isLt])
  have h2 : ∑ ℓ : Fin n, (F ⟨2 * ℓ.val, by have := ℓ.isLt; omega⟩ +
      F ⟨2 * ℓ.val + 1, by have := ℓ.isLt; omega⟩) =
      ∑ ℓ : Fin n, (G (2 * ℓ.val) + G (2 * ℓ.val + 1)) := by
    refine Finset.sum_congr rfl (fun ℓ _ => ?_)
    have a1 : 2 * ℓ.val < 2 * n := by have := ℓ.isLt; omega
    have a2 : 2 * ℓ.val + 1 < 2 * n := by have := ℓ.isLt; omega
    simp [G, a1, a2]
  rw [h1, h2, Fin.sum_univ_eq_sum_range G (2 * n), sum_range_two_mul]
  exact (Fin.sum_univ_eq_sum_range (fun ℓ => G (2 * ℓ) + G (2 * ℓ + 1)) n).symm

theorem rowWeight_castSucc {N : ℕ} (D : M0Data N) (aleph : ℕ) (i : Fin (2 * N)) (ℓ : Fin N)
    (h : i.val / 2 = ℓ.val) : rowWeight D aleph i.castSucc = D.j ℓ := by
  have hi : (i.castSucc).val < 2 * N := i.isLt
  unfold rowWeight
  rw [dif_pos hi]
  congr 1
  exact Fin.ext h

theorem rowOp_castSucc {N : ℕ} (D : M0Data N) (beth : ℕ) (i : Fin (2 * N)) (ℓ : Fin N)
    (σ : Fin 2) (h1 : i.val / 2 = ℓ.val) (h2 : i.val % 2 = σ.val) :
    rowOp D beth i.castSucc = ((-rowSign D ℓ : ℝ) : ℂ) •
      orbitalReflection N (givensLeaf beth (D.k ℓ)) σ := by
  have hi : (i.castSucc).val < 2 * N := i.isLt
  have e1 : ℓ = ⟨(i.castSucc).val / 2, by omega⟩ := Fin.ext h1.symm
  have e2 : σ = ⟨(i.castSucc).val % 2, by omega⟩ := Fin.ext h2.symm
  unfold rowOp
  rw [dif_pos hi, e1, e2]

theorem rowWeight_last {N : ℕ} (D : M0Data N) (aleph : ℕ) :
    rowWeight D aleph (Fin.last (2 * N)) = 2 ^ gW N aleph - 2 * ∑ ℓ, D.j ℓ := by
  unfold rowWeight
  rw [dif_neg (by simp)]

theorem rowOp_last {N : ℕ} (D : M0Data N) (beth : ℕ) :
    rowOp D beth (Fin.last (2 * N)) = 1 := by
  unfold rowOp
  rw [dif_neg (by simp)]

theorem sum_j_eq {N : ℕ} {thc : THCFactorization N 0} {aleph beth : ℕ} {lam : ℝ}
    {D : M0Data N} (hD : M0Facts thc aleph beth lam D.t D.k D.j) (hpos : 0 < lamRepD D) :
    ∑ ℓ, D.j ℓ = N * 2 ^ aleph := by
  obtain ⟨-, -, h3, -⟩ := hD
  have hN : 0 < N := N_pos_of_lamRepD_pos D hpos
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  have hd : (0 : ℝ) < (N : ℝ) * 2 ^ aleph := by positivity
  have hS : lamRepD D = ∑ ℓ, (D.j ℓ : ℝ) * qD D aleph :=
    Finset.sum_congr rfl (fun ℓ _ => h3 ℓ)
  rw [← Finset.sum_mul] at hS
  have hq : qD D aleph * ((N : ℝ) * 2 ^ aleph) = lamRepD D := by
    unfold qD
    field_simp
  have hqpos : 0 < qD D aleph := div_pos hpos hd
  have h5 : (∑ ℓ, (D.j ℓ : ℝ)) * qD D aleph = ((N : ℝ) * 2 ^ aleph) * qD D aleph := by
    rw [← hS]
    linarith [hq]
  have key : (∑ ℓ, (D.j ℓ : ℝ)) = (N : ℝ) * 2 ^ aleph := mul_right_cancel₀ hqpos.ne' h5
  have h6 : ((∑ ℓ, D.j ℓ : ℕ) : ℝ) = ((N * 2 ^ aleph : ℕ) : ℝ) := by
    push_cast
    exact key
  exact_mod_cast h6

theorem two_sum_j_le {N : ℕ} {thc : THCFactorization N 0} {aleph beth : ℕ} {lam : ℝ}
    {D : M0Data N} (hD : M0Facts thc aleph beth lam D.t D.k D.j) :
    2 * ∑ ℓ, D.j ℓ < 2 ^ gW N aleph := by
  have hge : 2 * N * 2 ^ aleph + 1 ≤ 2 ^ gW N aleph := Nat.le_pow_clog (by norm_num) _
  by_cases hpos : 0 < lamRepD D
  · have h := sum_j_eq hD hpos
    have e : 2 * N * 2 ^ aleph = 2 * (N * 2 ^ aleph) := by ring
    rw [h]
    omega
  · have hS0 : lamRepD D = 0 := le_antisymm (not_lt.mp hpos) (lamRepD_nonneg D)
    have h : ∑ ℓ, D.j ℓ = 0 := Finset.sum_eq_zero (fun ℓ _ => hD.2.2.2 hS0 ℓ)
    have hp : 0 < 2 ^ gW N aleph := pow_pos (by norm_num) _
    rw [h]
    omega

theorem rows_le_pow_idx (N : ℕ) : 2 * N + 1 ≤ 2 ^ idxW N := by
  unfold idxW
  exact Nat.le_pow_clog (by norm_num) _

theorem idxW_le_gW (N aleph : ℕ) : idxW N ≤ gW N aleph := by
  unfold idxW gW
  apply Nat.clog_mono_right
  have : 2 * N * 1 ≤ 2 * N * 2 ^ aleph := Nat.mul_le_mul_left _ Nat.one_le_two_pow
  omega

theorem idxW_add_muW (N aleph : ℕ) : idxW N + muW N aleph = gW N aleph := by
  unfold muW
  have := idxW_le_gW N aleph
  omega

theorem pow_gW_le {N : ℕ} (hN : 0 < N) (aleph : ℕ) : 2 ^ gW N aleph ≤ 4 * N * 2 ^ aleph := by
  have hpos : 0 < 2 * N * 2 ^ aleph := by positivity
  have hx : 1 < 2 * N * 2 ^ aleph + 1 := by omega
  have h1 : 2 ^ (gW N aleph - 1) < 2 * N * 2 ^ aleph + 1 :=
    Nat.pow_pred_clog_lt_self (by norm_num) hx
  have hg : 0 < gW N aleph := Nat.clog_pos (by norm_num) hx
  have h2 : 2 ^ gW N aleph = 2 * 2 ^ (gW N aleph - 1) := by
    rw [← pow_succ']
    congr 1
    omega
  have e : 4 * N * 2 ^ aleph = 2 * (2 * N * 2 ^ aleph) := by ring
  rw [h2, e]
  omega

theorem sum_rowWeight {N : ℕ} {thc : THCFactorization N 0} {aleph beth : ℕ} {lam : ℝ}
    {D : M0Data N} (hD : M0Facts thc aleph beth lam D.t D.k D.j) :
    ∑ r, rowWeight D aleph r = 2 ^ (idxW N + muW N aleph) := by
  rw [idxW_add_muW, Fin.sum_univ_castSucc]
  have hlast := rowWeight_last D aleph
  have hrows : ∑ i : Fin (2 * N), rowWeight D aleph i.castSucc = 2 * ∑ ℓ, D.j ℓ := by
    rw [sum_fin_two_mul]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun ℓ _ => ?_)
    rw [rowWeight_castSucc D aleph _ ℓ (by show 2 * ℓ.val / 2 = ℓ.val; omega),
      rowWeight_castSucc D aleph _ ℓ (by show (2 * ℓ.val + 1) / 2 = ℓ.val; omega)]
    ring
  rw [hrows, hlast]
  have := two_sum_j_le hD
  omega

theorem alphaD_pos {N : ℕ} (D : M0Data N) (aleph : ℕ) : 0 < alphaD D aleph := by
  unfold alphaD
  split_ifs with h
  · have hN : 0 < N := N_pos_of_lamRepD_pos D h
    have hNr : (0 : ℝ) < N := by exact_mod_cast hN
    have hq : 0 < qD D aleph := div_pos h (by positivity)
    exact mul_pos (half_pos hq) (by positivity)
  · exact one_pos

theorem alphaD_le {N : ℕ} {thc : THCFactorization N 0} {aleph beth : ℕ} {lam : ℝ}
    {D : M0Data N} (hD : M0Facts thc aleph beth lam D.t D.k D.j) :
    alphaD D aleph ≤ max 1 (2 * lam) := by
  have hS_le : lamRepD D ≤ lam := hD.2.1
  unfold alphaD
  split_ifs with h
  · have hN : 0 < N := N_pos_of_lamRepD_pos D h
    have hNr : (0 : ℝ) < N := by exact_mod_cast hN
    have hd : (0 : ℝ) < (N : ℝ) * 2 ^ aleph := by positivity
    have hq : 0 ≤ qD D aleph := div_nonneg h.le hd.le
    have hpow : ((2 : ℝ) ^ gW N aleph) ≤ 4 * N * 2 ^ aleph := by
      exact_mod_cast pow_gW_le hN aleph
    calc qD D aleph / 2 * 2 ^ gW N aleph ≤ qD D aleph / 2 * (4 * N * 2 ^ aleph) :=
          mul_le_mul_of_nonneg_left hpow (by positivity)
      _ = 2 * lamRepD D := by
          unfold qD
          field_simp
          ring
      _ ≤ max 1 (2 * lam) := le_trans (by linarith) (le_max_right _ _)
  · exact le_max_left _ _

theorem qpeWalkSteps_mono {α β : ℝ} (ε : ℝ) (hα : 0 ≤ α) (hαβ : α ≤ β) :
    qpeWalkSteps α ε ≤ qpeWalkSteps β ε := by
  unfold qpeWalkSteps
  by_cases hε : 0 < ε
  · apply Nat.ceil_mono
    have hπ : 0 ≤ Real.pi := Real.pi_pos.le
    have h2ε : 0 < 2 * ε := by positivity
    exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hαβ hπ) h2ε.le
  · have hε' : ε ≤ 0 := not_lt.mp hε
    have h1 : (Real.pi * α) / (2 * ε) ≤ 0 :=
      div_nonpos_iff.mpr (Or.inl ⟨mul_nonneg Real.pi_pos.le hα, by linarith⟩)
    rw [Nat.ceil_eq_zero.mpr h1]
    exact Nat.zero_le _

/-! ## Operator facts -/

theorem rowOp_conjTranspose {N : ℕ} (D : M0Data N) (beth : ℕ) (r : Fin (2 * N + 1)) :
    (rowOp D beth r)ᴴ = rowOp D beth r := by
  have hR : ∀ (χ : Fin N → ℝ) (σ : Fin 2),
      (orbitalReflection N χ σ)ᴴ = orbitalReflection N χ σ := by
    intro χ σ
    unfold orbitalReflection
    rw [Matrix.conjTranspose_sub, Matrix.conjTranspose_one, Matrix.conjTranspose_smul,
      orbitalNumberOp_conjTranspose]
    simp
  unfold rowOp
  split_ifs with h
  · rw [Matrix.conjTranspose_smul, hR]
    simp
  · exact Matrix.conjTranspose_one

/-- The exact LCU: the weighted row sum is `α⁻¹ (H - c 1)` with `H` the one-body Hamiltonian. -/
theorem blockSum_eq {N : ℕ} {thc : THCFactorization N 0} {aleph beth : ℕ} {lam : ℝ}
    {D : M0Data N} (hD : M0Facts thc aleph beth lam D.t D.k D.j) :
    ∑ r, (((rowWeight D aleph r : ℝ) / 2 ^ gW N aleph : ℝ) : ℂ) • rowOp D beth r =
      ((alphaD D aleph)⁻¹ : ℂ) •
        (oneBodyHamiltonian thc.h1eMod - (offsetD D aleph : ℂ) • 1) := by
  obtain ⟨h1, -, h3, h4⟩ := hD
  have hH : oneBodyHamiltonian thc.h1eMod =
      ((∑ ℓ, D.t ℓ : ℝ) : ℂ) • (1 : Operator (2 ^ (2 * N))) -
        ∑ ℓ, ∑ σ : Fin 2, ((D.t ℓ / 2 : ℝ) : ℂ) •
          orbitalReflection N (givensLeaf beth (D.k ℓ)) σ := by
    rw [h1]
    exact QC14.OneBodyRank.oneBodyHamiltonian_eq_reflections D.t
      (fun ℓ => givensLeaf beth (D.k ℓ))
  have hLHS : ∑ r, (((rowWeight D aleph r : ℝ) / 2 ^ gW N aleph : ℝ) : ℂ) • rowOp D beth r =
      (∑ ℓ, ∑ σ : Fin 2, (((D.j ℓ : ℝ) / 2 ^ gW N aleph : ℝ) : ℂ) •
          (((-rowSign D ℓ : ℝ) : ℂ) •
            orbitalReflection N (givensLeaf beth (D.k ℓ)) σ)) +
        ((((2 ^ gW N aleph - 2 * ∑ ℓ, D.j ℓ : ℕ) : ℝ) / 2 ^ gW N aleph : ℝ) : ℂ) •
          (1 : Operator (2 ^ (2 * N))) := by
    rw [Fin.sum_univ_castSucc, sum_fin_two_mul]
    congr 1
    · refine Finset.sum_congr rfl (fun ℓ _ => ?_)
      rw [Fin.sum_univ_two]
      have hl := ℓ.isLt
      rw [rowWeight_castSucc D aleph ⟨2 * ℓ.val, by omega⟩ ℓ
          (by show 2 * ℓ.val / 2 = ℓ.val; omega),
        rowOp_castSucc D beth ⟨2 * ℓ.val, by omega⟩ ℓ 0
          (by show 2 * ℓ.val / 2 = ℓ.val; omega) (by show 2 * ℓ.val % 2 = 0; omega),
        rowWeight_castSucc D aleph ⟨2 * ℓ.val + 1, by omega⟩ ℓ
          (by show (2 * ℓ.val + 1) / 2 = ℓ.val; omega),
        rowOp_castSucc D beth ⟨2 * ℓ.val + 1, by omega⟩ ℓ 1
          (by show (2 * ℓ.val + 1) / 2 = ℓ.val; omega)
          (by show (2 * ℓ.val + 1) % 2 = 1; omega)]
    · rw [rowWeight_last, rowOp_last]
  by_cases hpos : 0 < lamRepD D
  · -- generic case
    have hN : 0 < N := N_pos_of_lamRepD_pos D hpos
    have hNr : (0 : ℝ) < N := by exact_mod_cast hN
    have hd : (0 : ℝ) < (N : ℝ) * 2 ^ aleph := by positivity
    have hq : 0 < qD D aleph := div_pos hpos hd
    have h2g : (2 : ℝ) ^ gW N aleph ≠ 0 := by positivity
    have hqne : qD D aleph ≠ 0 := hq.ne'
    have hα : alphaD D aleph = qD D aleph / 2 * 2 ^ gW N aleph := by
      unfold alphaD
      rw [if_pos hpos]
    have hoff : offsetD D aleph = ∑ ℓ, D.t ℓ -
        ((2 ^ gW N aleph - 2 * ∑ ℓ, D.j ℓ : ℕ) : ℝ) * qD D aleph / 2 := by
      unfold offsetD
      rw [if_pos hpos]
    have ht : ∀ ℓ, D.t ℓ = rowSign D ℓ * D.j ℓ * qD D aleph := by
      intro ℓ
      have hj : |D.t ℓ| = D.j ℓ * qD D aleph := h3 ℓ
      unfold rowSign
      split_ifs with hneg
      · rw [abs_of_neg hneg] at hj
        linarith
      · rw [abs_of_nonneg (not_lt.mp hneg)] at hj
        linarith
    have hαpos := alphaD_pos D aleph
    have hreal : ∀ ℓ, ((D.j ℓ : ℝ) / 2 ^ gW N aleph) * (-rowSign D ℓ) =
        -((alphaD D aleph)⁻¹ * (D.t ℓ / 2)) := by
      intro ℓ
      rw [hα, ht ℓ]
      field_simp
    have hfill : (alphaD D aleph)⁻¹ *
        (((2 ^ gW N aleph - 2 * ∑ ℓ, D.j ℓ : ℕ) : ℝ) * qD D aleph / 2) =
        ((2 ^ gW N aleph - 2 * ∑ ℓ, D.j ℓ : ℕ) : ℝ) / 2 ^ gW N aleph := by
      rw [hα]
      field_simp
    have hαc : ((alphaD D aleph : ℝ) : ℂ)⁻¹ = (((alphaD D aleph)⁻¹ : ℝ) : ℂ) :=
      (Complex.ofReal_inv _).symm
    have hrowC : ∀ ℓ, (((D.j ℓ : ℝ) / 2 ^ gW N aleph : ℝ) : ℂ) * ((-rowSign D ℓ : ℝ) : ℂ) =
        -(((alphaD D aleph : ℝ) : ℂ)⁻¹ * ((D.t ℓ / 2 : ℝ) : ℂ)) := by
      intro ℓ
      rw [hαc]
      have := congrArg (fun x : ℝ => (x : ℂ)) (hreal ℓ)
      first
        | exact_mod_cast hreal ℓ
        | simpa only [Complex.ofReal_mul, Complex.ofReal_neg] using this
    have hfillC : ((alphaD D aleph : ℝ) : ℂ)⁻¹ *
        (((((2 ^ gW N aleph - 2 * ∑ ℓ, D.j ℓ : ℕ) : ℝ) * qD D aleph / 2 : ℝ)) : ℂ) =
        ((((2 ^ gW N aleph - 2 * ∑ ℓ, D.j ℓ : ℕ) : ℝ) / 2 ^ gW N aleph : ℝ) : ℂ) := by
      rw [hαc, ← Complex.ofReal_mul, hfill]
    have hbody : ((∑ ℓ, D.t ℓ : ℝ) : ℂ) • (1 : Operator (2 ^ (2 * N))) -
        (∑ ℓ, ∑ σ : Fin 2, ((D.t ℓ / 2 : ℝ) : ℂ) •
          orbitalReflection N (givensLeaf beth (D.k ℓ)) σ) -
        (offsetD D aleph : ℂ) • (1 : Operator (2 ^ (2 * N))) =
        (((((2 ^ gW N aleph - 2 * ∑ ℓ, D.j ℓ : ℕ) : ℝ) * qD D aleph / 2 : ℝ)) : ℂ) •
          (1 : Operator (2 ^ (2 * N))) -
        ∑ ℓ, ∑ σ : Fin 2, ((D.t ℓ / 2 : ℝ) : ℂ) •
          orbitalReflection N (givensLeaf beth (D.k ℓ)) σ := by
      rw [hoff]
      push_cast
      module
    have hterm : ∀ ℓ, ∑ σ : Fin 2, (((D.j ℓ : ℝ) / 2 ^ gW N aleph : ℝ) : ℂ) •
          (((-rowSign D ℓ : ℝ) : ℂ) • orbitalReflection N (givensLeaf beth (D.k ℓ)) σ) =
        -(∑ σ : Fin 2, ((alphaD D aleph : ℝ) : ℂ)⁻¹ • (((D.t ℓ / 2 : ℝ) : ℂ) •
          orbitalReflection N (givensLeaf beth (D.k ℓ)) σ)) := by
      intro ℓ
      rw [← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl (fun σ _ => ?_)
      simp only [smul_smul]
      rw [hrowC ℓ, neg_smul]
    have hsum : (∑ ℓ, ∑ σ : Fin 2, (((D.j ℓ : ℝ) / 2 ^ gW N aleph : ℝ) : ℂ) •
          (((-rowSign D ℓ : ℝ) : ℂ) • orbitalReflection N (givensLeaf beth (D.k ℓ)) σ)) =
        -(((alphaD D aleph : ℝ) : ℂ)⁻¹ • ∑ ℓ, ∑ σ : Fin 2, ((D.t ℓ / 2 : ℝ) : ℂ) •
          orbitalReflection N (givensLeaf beth (D.k ℓ)) σ) := by
      simp only [Finset.smul_sum]
      rw [← Finset.sum_neg_distrib]
      exact Finset.sum_congr rfl (fun ℓ _ => hterm ℓ)
    have hone : ((((2 ^ gW N aleph - 2 * ∑ ℓ, D.j ℓ : ℕ) : ℝ) / 2 ^ gW N aleph : ℝ) : ℂ) •
          (1 : Operator (2 ^ (2 * N))) =
        ((alphaD D aleph : ℝ) : ℂ)⁻¹ • ((((((2 ^ gW N aleph - 2 * ∑ ℓ, D.j ℓ : ℕ) : ℝ) *
          qD D aleph / 2 : ℝ)) : ℂ) • (1 : Operator (2 ^ (2 * N)))) := by
      rw [smul_smul, hfillC]
    rw [hLHS, hH, hbody, hsum, hone, smul_sub]
    abel
  · -- all coefficients vanish
    have hS0 : lamRepD D = 0 := le_antisymm (not_lt.mp hpos) (lamRepD_nonneg D)
    have ht0 : ∀ ℓ, D.t ℓ = 0 := fun ℓ =>
      abs_eq_zero.mp ((Finset.sum_eq_zero_iff_of_nonneg (fun i _ => abs_nonneg (D.t i))).1 hS0 ℓ
        (Finset.mem_univ _))
    have hj0 : ∀ ℓ, D.j ℓ = 0 := h4 hS0
    have hH0 : oneBodyHamiltonian thc.h1eMod = 0 := by
      rw [hH]
      simp [ht0]
    have hrows0 : ∀ i : Fin (2 * N), rowWeight D aleph i.castSucc = 0 := by
      intro i
      unfold rowWeight
      rw [dif_pos (show (i.castSucc).val < 2 * N from i.isLt)]
      exact hj0 _
    have hlast : rowWeight D aleph (Fin.last (2 * N)) = 2 ^ gW N aleph := by
      rw [rowWeight_last]
      simp [hj0]
    have hα1 : alphaD D aleph = 1 := by
      unfold alphaD
      rw [if_neg hpos]
    have hoff1 : offsetD D aleph = -1 := by
      unfold offsetD
      rw [if_neg hpos]
    have hdiv : (((2 ^ gW N aleph : ℕ) : ℝ) / 2 ^ gW N aleph : ℝ) = 1 := by
      push_cast
      exact div_self (by positivity)
    rw [Fin.sum_univ_castSucc]
    simp only [hrows0, Nat.cast_zero, zero_div, Complex.ofReal_zero, zero_smul,
      Finset.sum_const_zero, zero_add]
    rw [hlast, rowOp_last, hα1, hoff1, hH0, hdiv]
    simp


end QC14.WeightsM0


/-! Inlined from lane module `THC/WeightsC.lean`. -/

namespace QC14.WeightsC

open QuantumComputation QuantumComputation.Specs Finset Matrix
open QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.OrbitalBridge
  (orbitalReflection)
open QC14.SelectL QC14.TwoBodyAlgebra
open scoped Matrix

/-! ## Extraction from `IsRounded` -/

/-- `d = N + M(M+1)/2`, as in `IsRounded`. -/
def dC (N M : ℕ) : ℕ := N + M * (M + 1) / 2

/-- The rounding data: one-body coefficients and angles, two-body angles, integer weights. -/
structure CData (N M : ℕ) where
  t : Fin N → ℝ
  k : Fin N → Fin N → ℤ
  k2 : Fin M → Fin N → ℤ
  j1 : Fin N → ℕ
  j2 : Fin M → Fin M → ℕ

/-- `lamRep = Σ |t| + (1/2) Σ |ζ|`. -/
noncomputable def lamRepC {N M : ℕ} (thc : THCFactorization N M) (t : Fin N → ℝ) : ℝ :=
  ∑ ℓ, |t ℓ| + 2⁻¹ * ∑ μ, ∑ ν, |thc.zeta μ ν|

/-- The rounding unit `q = lamRep / (d 2^aleph)`. -/
noncomputable def qC {N M : ℕ} (thc : THCFactorization N M) (t : Fin N → ℝ) (aleph : ℕ) : ℝ :=
  lamRepC thc t / ((dC N M : ℝ) * 2 ^ aleph)

/-- What `IsRounded` says, with the integer weights chosen (zero when `lamRep = 0`). -/
def CFacts {N M : ℕ} (thc : THCFactorization N M) (aleph beth : ℕ) (lam : ℝ) (D : CData N M) :
    Prop :=
  (∀ μ, thc.chi μ = givensLeaf beth (D.k2 μ)) ∧
  thcShiftedOneBody thc =
    ∑ ℓ, D.t ℓ • vecMulVec (givensLeaf beth (D.k ℓ)) (givensLeaf beth (D.k ℓ)) ∧
  lamRepC thc D.t ≤ lam ∧
  (∀ ℓ, |D.t ℓ| = D.j1 ℓ * qC thc D.t aleph) ∧
  (∀ μ ν, μ < ν → |thc.zeta μ ν| = D.j2 μ ν * qC thc D.t aleph) ∧
  (∀ μ, |thc.zeta μ μ| = 2 * D.j2 μ μ * qC thc D.t aleph) ∧
  (lamRepC thc D.t = 0 → (∀ ℓ, D.j1 ℓ = 0) ∧ ∀ μ ν, D.j2 μ ν = 0)

theorem exists_cFacts {N M : ℕ} (thc : THCFactorization N M) {aleph beth : ℕ} {lam : ℝ}
    (hround : thc.IsRounded aleph beth lam) : ∃ D, CFacts thc aleph beth lam D := by
  obtain ⟨h0, t, k, h⟩ := hround
  obtain ⟨h1, h2, h3, h4, h5⟩ := h
  choose k2 hk2 using h0
  have hS' : lamRepC thc t = ∑ ℓ, |t ℓ| + 2⁻¹ * ∑ μ, ∑ ν, |thc.zeta μ ν| := rfl
  by_cases hS : lamRepC thc t = 0
  · have hs1 : 0 ≤ ∑ ℓ, |t ℓ| := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have hs2 : 0 ≤ ∑ μ, ∑ ν, |thc.zeta μ ν| :=
      Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _))
    have ht0 : ∀ ℓ, |t ℓ| = 0 := fun ℓ =>
      (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => abs_nonneg (t i))).1 (by linarith) ℓ
        (Finset.mem_univ _)
    have hz0 : ∀ μ ν, |thc.zeta μ ν| = 0 := by
      intro μ ν
      have h1' : ∑ μ, ∑ ν, |thc.zeta μ ν| = 0 := by linarith
      have := (Finset.sum_eq_zero_iff_of_nonneg
        (fun i _ => Finset.sum_nonneg (fun j _ => abs_nonneg (thc.zeta i j)))).1 h1' μ
        (Finset.mem_univ _)
      exact (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => abs_nonneg (thc.zeta μ j))).1 this ν
        (Finset.mem_univ _)
    refine ⟨⟨t, k, k2, fun _ => 0, fun _ _ => 0⟩, hk2, h1, h2, ?_, ?_, ?_, fun _ => ⟨fun _ => rfl,
      fun _ _ => rfl⟩⟩
    · intro ℓ; simp [ht0]
    · intro μ ν _; simp [hz0]
    · intro μ; simp [hz0]
  · choose j1 hj1 using h3
    choose j2' hj2' using h4
    choose jd hjd using h5
    refine ⟨⟨t, k, k2, j1, fun μ ν => if h : μ < ν then j2' μ ν h else if μ = ν then jd μ else 0⟩,
      hk2, h1, h2, fun ℓ => hj1 ℓ, ?_, ?_, fun h => absurd h hS⟩
    · intro μ ν hμν
      show |thc.zeta μ ν| = ((if h : μ < ν then j2' μ ν h else if μ = ν then jd μ else 0 : ℕ) : ℝ)
        * qC thc t aleph
      rw [dif_pos hμν]
      exact hj2' μ ν hμν
    · intro μ
      show |thc.zeta μ μ| = 2 * ((if h : μ < μ then j2' μ μ h else if μ = μ then jd μ else 0 : ℕ) : ℝ)
        * qC thc t aleph
      rw [dif_neg (lt_irrefl μ), if_pos rfl]
      exact hjd μ

open scoped Classical in
/-- The rounding data chosen from `IsRounded` (all zero when it fails). -/
noncomputable def cData {N M : ℕ} (thc : THCFactorization N M) (aleph beth : ℕ) (lam : ℝ) :
    CData N M :=
  if h : ∃ D, CFacts thc aleph beth lam D then h.choose else ⟨0, 0, 0, 0, 0⟩

theorem cData_facts {N M : ℕ} (thc : THCFactorization N M) {aleph beth : ℕ} {lam : ℝ}
    (hround : thc.IsRounded aleph beth lam) :
    CFacts thc aleph beth lam (cData thc aleph beth lam) := by
  unfold cData
  rw [dif_pos (exists_cFacts thc hround)]
  exact (exists_cFacts thc hround).choose_spec

/-! ## Sizes and the index encoding -/

/-- Width of one row register: `2(N + M) + 1` rows. -/
def bIC (N M : ℕ) : ℕ := Nat.clog 2 (2 * (N + M) + 1)

/-- Width of the PREPARE index `A ++ B ++ z`. -/
def idxC (N M : ℕ) : ℕ := 2 * bIC N M + 1

/-- Garbage width: the weights sum to `2^gC`, and `gC ≥ idxC + 1` (PREPARE runs phase one's
`pickF` over the index `A ++ B ++ z ++ o`, `idxC + 1` bits, with `o = 0` on every row). -/
def gC (N M aleph : ℕ) : ℕ := max (idxC N M + 1) (Nat.clog 2 (4 * dC N M * 2 ^ aleph))

/-- Extra PREPARE bits, so that `(idxC + 1) + muC = gC`. -/
def muC (N M aleph : ℕ) : ℕ := gC N M aleph - (idxC N M + 1)

/-- The identity row `I = 2(N + M)`. -/
abbrev rowI (N M : ℕ) : ℕ := 2 * (N + M)

theorem rows_le_bIC (N M : ℕ) : 2 * (N + M) + 1 ≤ 2 ^ bIC N M := by
  unfold bIC
  exact Nat.le_pow_clog (by norm_num) _

theorem idxC_add_muC (N M aleph : ℕ) : idxC N M + 1 + muC N M aleph = gC N M aleph := by
  have : idxC N M + 1 ≤ gC N M aleph := le_max_left _ _
  unfold muC
  omega

theorem four_d_le_pow_gC (N M aleph : ℕ) : 4 * dC N M * 2 ^ aleph ≤ 2 ^ gC N M aleph := by
  have h1 : 4 * dC N M * 2 ^ aleph ≤ 2 ^ Nat.clog 2 (4 * dC N M * 2 ^ aleph) :=
    Nat.le_pow_clog (by norm_num) _
  exact h1.trans (Nat.pow_le_pow_right (by norm_num) (le_max_right _ _))

/-- Row `A` of an index value (low `bIC` bits). -/
def idxA {N M : ℕ} (x : Fin (2 ^ idxC N M)) : Fin (2 ^ bIC N M) :=
  ⟨x.val % 2 ^ bIC N M, Nat.mod_lt _ (Nat.two_pow_pos _)⟩

/-- Row `B` of an index value (middle `bIC` bits). -/
def idxB {N M : ℕ} (x : Fin (2 ^ idxC N M)) : Fin (2 ^ bIC N M) :=
  ⟨x.val / 2 ^ bIC N M % 2 ^ bIC N M, Nat.mod_lt _ (Nat.two_pow_pos _)⟩

/-- Sign bit of an index value (top bit). -/
def idxZ {N M : ℕ} (x : Fin (2 ^ idxC N M)) : Bool :=
  decide (2 ^ (2 * bIC N M) ≤ x.val)

/-- Little-endian encoding `A ++ B ++ z`. -/
def encC {N M : ℕ} (A B : Fin (2 ^ bIC N M)) (z : Bool) : Fin (2 ^ idxC N M) :=
  ⟨A.val + 2 ^ bIC N M * B.val + 2 ^ (2 * bIC N M) * (if z then 1 else 0), by
    have hA := A.2
    have hB := B.2
    have h1 : A.val + 2 ^ bIC N M * B.val < 2 ^ (2 * bIC N M) := by
      have : A.val + 2 ^ bIC N M * B.val < 2 ^ bIC N M * (B.val + 1) := by
        rw [Nat.mul_succ]; omega
      calc A.val + 2 ^ bIC N M * B.val < 2 ^ bIC N M * (B.val + 1) := this
        _ ≤ 2 ^ bIC N M * 2 ^ bIC N M := Nat.mul_le_mul_left _ hB
        _ = 2 ^ (2 * bIC N M) := by rw [← pow_add]; ring_nf
    have h2 : 2 ^ idxC N M = 2 ^ (2 * bIC N M) + 2 ^ (2 * bIC N M) := by
      unfold idxC; rw [pow_succ]; ring
    rw [h2]
    split_ifs <;> omega⟩

private theorem pow_two_mul_bIC (N M : ℕ) :
    2 ^ (2 * bIC N M) = 2 ^ bIC N M * 2 ^ bIC N M := by
  rw [two_mul, pow_add]

private theorem encC_val_false {N M : ℕ} (A B : Fin (2 ^ bIC N M)) :
    (encC A B false).val = A.val + 2 ^ bIC N M * B.val := by
  show A.val + 2 ^ bIC N M * B.val + 2 ^ (2 * bIC N M) * (if false = true then 1 else 0) = _
  simp

private theorem encC_val_true {N M : ℕ} (A B : Fin (2 ^ bIC N M)) :
    (encC A B true).val = A.val + 2 ^ bIC N M * B.val + 2 ^ (2 * bIC N M) := by
  show A.val + 2 ^ bIC N M * B.val + 2 ^ (2 * bIC N M) * (if true = true then 1 else 0) = _
  simp

private theorem low_lt {N M : ℕ} (A B : Fin (2 ^ bIC N M)) :
    A.val + 2 ^ bIC N M * B.val < 2 ^ (2 * bIC N M) := by
  have hA := A.2
  have hB := B.2
  rw [pow_two_mul_bIC]
  calc A.val + 2 ^ bIC N M * B.val < 2 ^ bIC N M * (B.val + 1) := by rw [Nat.mul_succ]; omega
    _ ≤ 2 ^ bIC N M * 2 ^ bIC N M := Nat.mul_le_mul_left _ hB

private theorem div_decomp (X P : ℕ) (hP : 0 < P) (hX : X < 2 * (P * P)) :
    X = X % P + P * (X / P % P) + P * P * (if P * P ≤ X then 1 else 0) := by
  have e1 := Nat.mod_add_div X P
  have e2 := Nat.mod_add_div (X / P) P
  have hq : X / P / P < 2 := by
    rw [Nat.div_lt_iff_lt_mul hP, Nat.div_lt_iff_lt_mul hP]; nlinarith
  have hq2 : (1 ≤ X / P / P) ↔ P * P ≤ X := by
    rw [Nat.le_div_iff_mul_le hP, Nat.le_div_iff_mul_le hP]
    constructor <;> intro h <;> nlinarith
  rw [← e2] at e1
  split_ifs with h
  · have h3 : X / P / P = 1 := Nat.le_antisymm (Nat.lt_succ_iff.mp hq) (hq2.2 h)
    rw [h3] at e1
    nlinarith
  · have h3 : X / P / P = 0 := Nat.lt_one_iff.mp (not_le.mp (mt hq2.1 h))
    rw [h3] at e1
    nlinarith

theorem idxA_encC {N M : ℕ} (A B : Fin (2 ^ bIC N M)) (z : Bool) : idxA (encC A B z) = A := by
  apply Fin.ext
  have hv : (encC A B z).val = A.val + 2 ^ bIC N M * (B.val + 2 ^ bIC N M * (if z then 1 else 0)) := by
    show A.val + 2 ^ bIC N M * B.val + 2 ^ (2 * bIC N M) * (if z then 1 else 0) = _
    rw [pow_two_mul_bIC]; ring
  show (encC A B z).val % 2 ^ bIC N M = A.val
  rw [hv, Nat.add_mul_mod_self_left]
  exact Nat.mod_eq_of_lt A.2

theorem idxB_encC {N M : ℕ} (A B : Fin (2 ^ bIC N M)) (z : Bool) : idxB (encC A B z) = B := by
  apply Fin.ext
  have hv : (encC A B z).val = A.val + 2 ^ bIC N M * (B.val + 2 ^ bIC N M * (if z then 1 else 0)) := by
    show A.val + 2 ^ bIC N M * B.val + 2 ^ (2 * bIC N M) * (if z then 1 else 0) = _
    rw [pow_two_mul_bIC]; ring
  show (encC A B z).val / 2 ^ bIC N M % 2 ^ bIC N M = B.val
  rw [hv, Nat.add_mul_div_left _ _ (Nat.two_pow_pos _), Nat.div_eq_of_lt A.2, zero_add,
    Nat.add_mul_mod_self_left]
  exact Nat.mod_eq_of_lt B.2

theorem idxZ_encC {N M : ℕ} (A B : Fin (2 ^ bIC N M)) (z : Bool) : idxZ (encC A B z) = z := by
  have h := low_lt A B
  unfold idxZ
  cases z
  · rw [encC_val_false]
    exact decide_eq_false (by omega)
  · rw [encC_val_true]
    exact decide_eq_true (by omega)

theorem encC_idx {N M : ℕ} (x : Fin (2 ^ idxC N M)) : encC (idxA x) (idxB x) (idxZ x) = x := by
  apply Fin.ext
  have hx := x.2
  have h2 : 2 ^ idxC N M = 2 * (2 ^ bIC N M * 2 ^ bIC N M) := by
    unfold idxC; rw [pow_succ, pow_two_mul_bIC]; ring
  have key := div_decomp x.val (2 ^ bIC N M) (Nat.two_pow_pos _) (by rw [← h2]; exact hx)
  show x.val % 2 ^ bIC N M + 2 ^ bIC N M * (x.val / 2 ^ bIC N M % 2 ^ bIC N M) +
    2 ^ (2 * bIC N M) * (if idxZ x then 1 else 0) = x.val
  have hz : (if idxZ x then 1 else 0) = (if 2 ^ bIC N M * 2 ^ bIC N M ≤ x.val then 1 else 0) := by
    unfold idxZ; rw [pow_two_mul_bIC]; simp
  rw [hz, pow_two_mul_bIC]
  exact key.symm

/-- Sums over index values are sums over triples. -/
theorem sum_idx_eq {N M : ℕ} {V : Type*} [AddCommMonoid V] (f : Fin (2 ^ idxC N M) → V) :
    ∑ x, f x = ∑ A : Fin (2 ^ bIC N M), ∑ B : Fin (2 ^ bIC N M), ∑ z : Bool, f (encC A B z) := by
  let e : (Fin (2 ^ bIC N M) × Fin (2 ^ bIC N M) × Bool) ≃ Fin (2 ^ idxC N M) :=
    { toFun := fun p => encC p.1 p.2.1 p.2.2
      invFun := fun x => (idxA x, idxB x, idxZ x)
      left_inv := fun ⟨A, B, z⟩ => by simp [idxA_encC, idxB_encC, idxZ_encC]
      right_inv := fun x => encC_idx x }
  refine (Equiv.sum_comp e f).symm.trans ?_
  rw [Fintype.sum_prod_type]
  refine Finset.sum_congr rfl (fun A _ => ?_)
  rw [Fintype.sum_prod_type]
  all_goals rfl

/-! ## Weights -/

/-- Sum of the non-filler weights: `4 Σ j1 + 4 Σ_{μ<ν} j2 + 2 Σ_μ j2_{μμ}`. -/
def coreSum {N M : ℕ} (D : CData N M) : ℕ :=
  4 * ∑ ℓ, D.j1 ℓ + 4 * ∑ μ, ∑ ν, (if μ < ν then D.j2 μ ν else 0) + 2 * ∑ μ, D.j2 μ μ

/-- The filler weight `2^g - coreSum`. -/
def fillC {N M : ℕ} (D : CData N M) (aleph : ℕ) : ℕ := 2 ^ gC N M aleph - coreSum D

/-- Weight of the triple `(A, B, z)` (rows as naturals). -/
noncomputable def pairW {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (A B : ℕ) (z : Bool) : ℕ :=
  if hA : A < 2 * N then
    (if B = rowI N M ∧ z = decide (0 ≤ D.t ⟨A / 2, by omega⟩) then
      2 * D.j1 ⟨A / 2, by omega⟩ else 0)
  else if hAB : A < B ∧ B < 2 * (N + M) then
    (if z = decide (thc.zeta ⟨A / 2 - N, by omega⟩ ⟨B / 2 - N, by omega⟩ < 0) then
      (if A / 2 < B / 2 then D.j2 ⟨A / 2 - N, by omega⟩ ⟨B / 2 - N, by omega⟩
        else 2 * D.j2 ⟨A / 2 - N, by omega⟩ ⟨A / 2 - N, by omega⟩)
      else 0)
  else if A = rowI N M ∧ B = rowI N M ∧ z = false then fillC D aleph else 0

/-- Weight of an index value. -/
noncomputable def flatW {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (x : Fin (2 ^ idxC N M)) : ℕ :=
  pairW thc D aleph (idxA x).val (idxB x).val (idxZ x)

theorem lamRepC_nonneg {N M : ℕ} (thc : THCFactorization N M) (t : Fin N → ℝ) :
    0 ≤ lamRepC thc t := by
  unfold lamRepC
  have h1 : 0 ≤ ∑ ℓ, |t ℓ| := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
  have h2 : 0 ≤ ∑ μ, ∑ ν, |thc.zeta μ ν| :=
    Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _))
  have := mul_nonneg (by norm_num : (0 : ℝ) ≤ 2⁻¹) h2
  linarith

theorem dC_pos_of_lamRepC_pos {N M : ℕ} (thc : THCFactorization N M) (t : Fin N → ℝ)
    (h : 0 < lamRepC thc t) : 0 < dC N M := by
  rcases Nat.eq_zero_or_pos N with rfl | hN
  · rcases Nat.eq_zero_or_pos M with rfl | hM
    · simp [lamRepC] at h
    · unfold dC
      have h2 : 2 ≤ M * (M + 1) := by nlinarith
      have := Nat.div_pos h2 (by norm_num : 0 < 2)
      omega
  · unfold dC; omega

private theorem sum_sym_split {M : ℕ} (g : Fin M → Fin M → ℝ) (hsym : ∀ a b, g a b = g b a) :
    ∑ μ, ∑ ν, g μ ν = 2 * ∑ μ, ∑ ν, (if μ < ν then g μ ν else 0) + ∑ μ, g μ μ := by
  have h1 : ∀ μ ν, g μ ν = (if μ < ν then g μ ν else 0) + (if ν < μ then g μ ν else 0) +
      (if μ = ν then g μ ν else 0) := by
    intro μ ν
    rcases lt_trichotomy μ ν with h | h | h
    · simp [h, h.ne, not_lt.2 h.le]
    · subst h; simp
    · simp [h, h.ne', not_lt.2 h.le]
  have h2 : ∑ μ, ∑ ν, (if ν < μ then g μ ν else 0) = ∑ μ, ∑ ν, (if μ < ν then g μ ν else 0) := by
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
    rw [hsym b a]
  calc ∑ μ, ∑ ν, g μ ν
      = ∑ μ, ∑ ν, ((if μ < ν then g μ ν else 0) + (if ν < μ then g μ ν else 0) +
          (if μ = ν then g μ ν else 0)) :=
        Finset.sum_congr rfl (fun μ _ => Finset.sum_congr rfl (fun ν _ => h1 μ ν))
    _ = _ := by
        simp only [Finset.sum_add_distrib, h2, Finset.sum_ite_eq, Finset.mem_univ, if_true]
        ring

theorem sum_j_eq_dC {N M : ℕ} {thc : THCFactorization N M} {aleph beth : ℕ} {lam : ℝ}
    {D : CData N M} (hD : CFacts thc aleph beth lam D) (hpos : 0 < lamRepC thc D.t) :
    ∑ ℓ, D.j1 ℓ + ∑ μ, ∑ ν, (if μ < ν then D.j2 μ ν else 0) + ∑ μ, D.j2 μ μ =
      dC N M * 2 ^ aleph := by
  obtain ⟨-, -, -, ht, hz1, hz2, -⟩ := hD
  have hd : (0 : ℝ) < dC N M := by exact_mod_cast dC_pos_of_lamRepC_pos thc D.t hpos
  have hdr : (0 : ℝ) < (dC N M : ℝ) * 2 ^ aleph := by positivity
  have hq : 0 < qC thc D.t aleph := div_pos hpos hdr
  have hq' : qC thc D.t aleph * ((dC N M : ℝ) * 2 ^ aleph) = lamRepC thc D.t := by
    unfold qC; field_simp
  have hsym : ∀ μ ν, |thc.zeta μ ν| = |thc.zeta ν μ| := fun μ ν => by
    rw [thc.zeta_symm.apply μ ν]
  have hlam : lamRepC thc D.t = ∑ ℓ, |D.t ℓ| + 2⁻¹ * ∑ μ, ∑ ν, |thc.zeta μ ν| := rfl
  have hS1 : ∑ ℓ, |D.t ℓ| = (∑ ℓ, (D.j1 ℓ : ℝ)) * qC thc D.t aleph := by
    rw [Finset.sum_mul]; exact Finset.sum_congr rfl (fun ℓ _ => ht ℓ)
  have hS2 : ∑ μ, ∑ ν, (if μ < ν then |thc.zeta μ ν| else 0) =
      (∑ μ, ∑ ν, if μ < ν then (D.j2 μ ν : ℝ) else 0) * qC thc D.t aleph := by
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl (fun ν _ => ?_)
    split_ifs with h
    · exact hz1 μ ν h
    · simp
  have hS3 : ∑ μ, |thc.zeta μ μ| = 2 * (∑ μ, (D.j2 μ μ : ℝ)) * qC thc D.t aleph := by
    rw [Finset.mul_sum, Finset.sum_mul]
    exact Finset.sum_congr rfl (fun μ _ => hz2 μ)
  have hsplit : ∑ μ, ∑ ν, |thc.zeta μ ν| =
      2 * ∑ μ, ∑ ν, (if μ < ν then |thc.zeta μ ν| else 0) + ∑ μ, |thc.zeta μ μ| :=
    sum_sym_split (fun μ ν => |thc.zeta μ ν|) hsym
  have hmain : lamRepC thc D.t =
      ((∑ ℓ, (D.j1 ℓ : ℝ)) + (∑ μ, ∑ ν, if μ < ν then (D.j2 μ ν : ℝ) else 0) +
        ∑ μ, (D.j2 μ μ : ℝ)) * qC thc D.t aleph := by
    rw [hlam, hsplit, hS1, hS2, hS3]; ring
  have key : ((∑ ℓ, (D.j1 ℓ : ℝ)) + (∑ μ, ∑ ν, if μ < ν then (D.j2 μ ν : ℝ) else 0) +
        ∑ μ, (D.j2 μ μ : ℝ)) = (dC N M : ℝ) * 2 ^ aleph := by
    refine mul_right_cancel₀ hq.ne' ?_
    calc _ = lamRepC thc D.t := hmain.symm
      _ = qC thc D.t aleph * ((dC N M : ℝ) * 2 ^ aleph) := hq'.symm
      _ = _ := mul_comm _ _
  have h6 : ((∑ ℓ, D.j1 ℓ + ∑ μ, ∑ ν, (if μ < ν then D.j2 μ ν else 0) + ∑ μ, D.j2 μ μ : ℕ) : ℝ) =
      ((dC N M * 2 ^ aleph : ℕ) : ℝ) := by
    push_cast
    exact key
  exact_mod_cast h6

theorem coreSum_le {N M : ℕ} {thc : THCFactorization N M} {aleph beth : ℕ} {lam : ℝ}
    {D : CData N M} (hD : CFacts thc aleph beth lam D) :
    coreSum D ≤ 4 * dC N M * 2 ^ aleph := by
  by_cases hpos : 0 < lamRepC thc D.t
  · have h := sum_j_eq_dC hD hpos
    have e : 4 * dC N M * 2 ^ aleph = 4 * (dC N M * 2 ^ aleph) := by ring
    rw [e, ← h]
    unfold coreSum
    omega
  · have h0 : lamRepC thc D.t = 0 := le_antisymm (not_lt.mp hpos) (lamRepC_nonneg _ _)
    obtain ⟨hj1, hj2⟩ := hD.2.2.2.2.2.2 h0
    have : coreSum D = 0 := by simp [coreSum, hj1, hj2]
    omega

/-- Weight of the two-body row pair `a < b`: `j2_{μν}` for `μ < ν`, `2 j2_{μμ}` for `μ = ν`
(`μ = a / 2`, `ν = b / 2`). -/
def twoWt {N M : ℕ} (D : CData N M) (a b : Fin (2 * M)) : ℕ :=
  if a.val / 2 < b.val / 2 then D.j2 ⟨a.val / 2, by omega⟩ ⟨b.val / 2, by omega⟩
    else 2 * D.j2 ⟨a.val / 2, by omega⟩ ⟨a.val / 2, by omega⟩

/-- Sign bit of the two-body row pair `(a, b)`. -/
noncomputable def twoZ {N M : ℕ} (thc : THCFactorization N M) (a b : Fin (2 * M)) : Bool :=
  decide (thc.zeta ⟨a.val / 2, by omega⟩ ⟨b.val / 2, by omega⟩ < 0)

/-! ### Decomposition of the triple sum by rows -/

section Decomp

variable {N M : ℕ}

private theorem rowI_eq : rowI N M = 2 * (N + M) := rfl

private theorem pairW_one' (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) {A : ℕ}
    (hA : A < 2 * N) (ℓ : Fin N) (hl : A / 2 = ℓ.val) (B : ℕ) (z : Bool) :
    pairW thc D aleph A B z =
      if B = rowI N M ∧ z = decide (0 ≤ D.t ℓ) then 2 * D.j1 ℓ else 0 := by
  unfold pairW
  rw [dif_pos hA]
  have e : (⟨A / 2, by omega⟩ : Fin N) = ℓ := Fin.ext hl
  rw [e]

private theorem pairW_two' (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) (a b : ℕ)
    (hab : a < b) (hb : b < 2 * M) (z : Bool) :
    pairW thc D aleph (2 * N + a) (2 * N + b) z =
      if z = decide (thc.zeta ⟨a / 2, by omega⟩ ⟨b / 2, by omega⟩ < 0) then
        (if a / 2 < b / 2 then D.j2 ⟨a / 2, by omega⟩ ⟨b / 2, by omega⟩
          else 2 * D.j2 ⟨a / 2, by omega⟩ ⟨a / 2, by omega⟩) else 0 := by
  unfold pairW
  rw [dif_neg (by omega), dif_pos ⟨by omega, by omega⟩]
  have e1 : (⟨(2 * N + a) / 2 - N, by omega⟩ : Fin M) = ⟨a / 2, by omega⟩ :=
    Fin.ext (by show (2 * N + a) / 2 - N = a / 2; omega)
  have e2 : (⟨(2 * N + b) / 2 - N, by omega⟩ : Fin M) = ⟨b / 2, by omega⟩ :=
    Fin.ext (by show (2 * N + b) / 2 - N = b / 2; omega)
  rw [e1, e2]
  by_cases h3 : a / 2 < b / 2
  · rw [if_pos h3, if_pos (by omega : (2 * N + a) / 2 < (2 * N + b) / 2)]
  · rw [if_neg h3, if_neg (by omega : ¬ ((2 * N + a) / 2 < (2 * N + b) / 2))]

private theorem pairW_off (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) {A B : ℕ}
    (hA1 : 2 * N ≤ A) (hA2 : A < 2 * (N + M)) (hB : ¬ (A < B ∧ B < 2 * (N + M))) (z : Bool) :
    pairW thc D aleph A B z = 0 := by
  unfold pairW
  rw [dif_neg (by omega), dif_neg hB, if_neg]
  intro h
  have := rowI_eq (N := N) (M := M)
  omega

private theorem pairW_gt (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) {A : ℕ}
    (hA : rowI N M < A) (B : ℕ) (z : Bool) : pairW thc D aleph A B z = 0 := by
  have := rowI_eq (N := N) (M := M)
  unfold pairW
  rw [dif_neg (by omega), dif_neg (by omega), if_neg]
  intro h
  omega

private theorem pairW_fill (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) {A : ℕ}
    (hA : A = rowI N M) (B : ℕ) (z : Bool) :
    pairW thc D aleph A B z = if B = rowI N M ∧ z = false then fillC D aleph else 0 := by
  have := rowI_eq (N := N) (M := M)
  unfold pairW
  rw [dif_neg (by omega), dif_neg (by omega)]
  subst hA
  simp

private theorem sum_bool_ite {V : Type*} [AddCommMonoid V] (c : Bool) (w : ℕ) (g : Bool → V) :
    ∑ z : Bool, (if z = c then w else 0) • g z = w • g c := by
  cases c <;> simp [Fintype.sum_bool]

private theorem sum_bool_ite2 {V : Type*} [AddCommMonoid V] (p : Prop) [Decidable p] (c : Bool)
    (w : ℕ) (g : Bool → V) :
    ∑ z : Bool, (if p ∧ z = c then w else 0) • g z = if p then w • g c else 0 := by
  by_cases hp : p
  · simp only [hp, true_and, ite_true]
    exact sum_bool_ite c w g
  · simp [hp]

/-- The weight-times-`G` sum over one first row. -/
private noncomputable def rowTot {V : Type*} [AddCommMonoid V] (thc : THCFactorization N M)
    (D : CData N M) (aleph : ℕ) (G : ℕ → ℕ → Bool → V) (A : ℕ) : V :=
  ∑ B ∈ Finset.range (2 ^ bIC N M), ∑ z : Bool, pairW thc D aleph A B z • G A B z

private theorem rowTot_gt {V : Type*} [AddCommMonoid V] (thc : THCFactorization N M)
    (D : CData N M) (aleph : ℕ) (G : ℕ → ℕ → Bool → V) {A : ℕ} (hA : rowI N M < A) :
    rowTot thc D aleph G A = 0 := by
  unfold rowTot
  exact Finset.sum_eq_zero (fun B _ => Finset.sum_eq_zero (fun z _ => by
    rw [pairW_gt thc D aleph hA, zero_smul]))

private theorem rowTot_one {V : Type*} [AddCommMonoid V] (thc : THCFactorization N M)
    (D : CData N M) (aleph : ℕ) (G : ℕ → ℕ → Bool → V) {A : ℕ} (hA : A < 2 * N) (ℓ : Fin N)
    (hl : A / 2 = ℓ.val) :
    rowTot thc D aleph G A = (2 * D.j1 ℓ) • G A (rowI N M) (decide (0 ≤ D.t ℓ)) := by
  have hI : rowI N M < 2 ^ bIC N M := by have := rows_le_bIC N M; rw [rowI_eq]; omega
  unfold rowTot
  have hz : ∀ B, ∑ z : Bool, pairW thc D aleph A B z • G A B z =
      if B = rowI N M then (2 * D.j1 ℓ) • G A B (decide (0 ≤ D.t ℓ)) else 0 := by
    intro B
    simp only [pairW_one' thc D aleph hA ℓ hl]
    exact sum_bool_ite2 (B = rowI N M) _ _ (fun z => G A B z)
  rw [Finset.sum_congr rfl (fun B _ => hz B), Finset.sum_ite_eq', if_pos (Finset.mem_range.2 hI)]

private theorem rowTot_fill {V : Type*} [AddCommMonoid V] (thc : THCFactorization N M)
    (D : CData N M) (aleph : ℕ) (G : ℕ → ℕ → Bool → V) {A : ℕ} (hA : A = rowI N M) :
    rowTot thc D aleph G A = fillC D aleph • G A (rowI N M) false := by
  have hI : rowI N M < 2 ^ bIC N M := by have := rows_le_bIC N M; rw [rowI_eq]; omega
  unfold rowTot
  have hz : ∀ B, ∑ z : Bool, pairW thc D aleph A B z • G A B z =
      if B = rowI N M then fillC D aleph • G A B false else 0 := by
    intro B
    simp only [pairW_fill thc D aleph hA]
    exact sum_bool_ite2 (B = rowI N M) _ _ (fun z => G A B z)
  rw [Finset.sum_congr rfl (fun B _ => hz B), Finset.sum_ite_eq', if_pos (Finset.mem_range.2 hI)]

private theorem rowTot_two {V : Type*} [AddCommMonoid V] (thc : THCFactorization N M)
    (D : CData N M) (aleph : ℕ) (G : ℕ → ℕ → Bool → V) (a : Fin (2 * M)) :
    rowTot thc D aleph G (2 * N + a.val) =
      ∑ b : Fin (2 * M), if a.val < b.val then
        twoWt D a b • G (2 * N + a.val) (2 * N + b.val) (twoZ thc a b) else 0 := by
  have ha := a.isLt
  have hP : 2 * N + 2 * M ≤ 2 ^ bIC N M := by have := rows_le_bIC N M; omega
  let f : ℕ → V := fun B => ∑ z : Bool,
    pairW thc D aleph (2 * N + a.val) B z • G (2 * N + a.val) B z
  have hf0 : ∀ B, (¬ (2 * N + a.val < B ∧ B < 2 * (N + M))) → f B = 0 := by
    intro B hB
    exact Finset.sum_eq_zero (fun z _ => by
      rw [pairW_off thc D aleph (by omega) (by omega) hB, zero_smul])
  have s1 : ∑ B ∈ Finset.range (2 ^ bIC N M), f B = ∑ B ∈ Finset.range (2 * N + 2 * M), f B :=
    (Finset.sum_subset (Finset.range_subset_range.2 hP) (fun B _ hB => hf0 B (by
      simp only [Finset.mem_range] at hB; omega))).symm
  have s2 : ∑ B ∈ Finset.range (2 * N + 2 * M), f B = ∑ b ∈ Finset.range (2 * M), f (2 * N + b) := by
    rw [Finset.sum_range_add, Finset.sum_eq_zero (fun B hB => hf0 B (by
      simp only [Finset.mem_range] at hB; omega)), zero_add]
  have s3 : ∑ b ∈ Finset.range (2 * M), f (2 * N + b) = ∑ b : Fin (2 * M), f (2 * N + b.val) :=
    Finset.sum_range (fun b => f (2 * N + b))
  show ∑ B ∈ Finset.range (2 ^ bIC N M), f B = _
  rw [s1, s2, s3]
  refine Finset.sum_congr rfl (fun b _ => ?_)
  have hb := b.isLt
  by_cases hab : a.val < b.val
  · rw [if_pos hab]
    show ∑ z : Bool, pairW thc D aleph (2 * N + a.val) (2 * N + b.val) z •
      G (2 * N + a.val) (2 * N + b.val) z = _
    simp only [pairW_two' thc D aleph a.val b.val hab hb]
    exact sum_bool_ite _ _ (fun z => G (2 * N + a.val) (2 * N + b.val) z)
  · rw [if_neg hab]
    exact hf0 _ (by omega)

/-- The weighted triple sum splits into the one-body, two-body and filler families. -/
theorem pairW_sum_decomp {V : Type*} [AddCommMonoid V] (thc : THCFactorization N M)
    (D : CData N M) (aleph : ℕ) (G : ℕ → ℕ → Bool → V) :
    ∑ A : Fin (2 ^ bIC N M), ∑ B : Fin (2 ^ bIC N M), ∑ z : Bool,
        pairW thc D aleph A.val B.val z • G A.val B.val z =
      (∑ ℓ : Fin N, ((2 * D.j1 ℓ) • G (2 * ℓ.val) (rowI N M) (decide (0 ≤ D.t ℓ)) +
        (2 * D.j1 ℓ) • G (2 * ℓ.val + 1) (rowI N M) (decide (0 ≤ D.t ℓ)))) +
      (∑ a : Fin (2 * M), ∑ b : Fin (2 * M), if a.val < b.val then
        twoWt D a b • G (2 * N + a.val) (2 * N + b.val) (twoZ thc a b) else 0) +
      fillC D aleph • G (rowI N M) (rowI N M) false := by
  have hI : rowI N M < 2 ^ bIC N M := by have := rows_le_bIC N M; rw [rowI_eq]; omega
  have step1 : (∑ A : Fin (2 ^ bIC N M), ∑ B : Fin (2 ^ bIC N M), ∑ z : Bool,
      pairW thc D aleph A.val B.val z • G A.val B.val z) =
      ∑ A ∈ Finset.range (2 ^ bIC N M), rowTot thc D aleph G A := by
    rw [Finset.sum_range]
    exact Finset.sum_congr rfl (fun A _ =>
      (Finset.sum_range (fun B => ∑ z : Bool, pairW thc D aleph A.val B z • G A.val B z)).symm)
  have step2 : ∑ A ∈ Finset.range (2 ^ bIC N M), rowTot thc D aleph G A =
      ∑ A ∈ Finset.range (rowI N M + 1), rowTot thc D aleph G A := by
    symm
    apply Finset.sum_subset (Finset.range_subset_range.2 (by omega))
    intro A _ hA
    simp only [Finset.mem_range, not_lt] at hA
    exact rowTot_gt thc D aleph G (by omega)
  have e : rowI N M + 1 = 2 * N + (2 * M + 1) := by rw [rowI_eq]; ring
  rw [step1, step2, e, Finset.sum_range_add, Finset.sum_range_succ]
  have h1 : ∑ A ∈ Finset.range (2 * N), rowTot thc D aleph G A =
      ∑ ℓ : Fin N, ((2 * D.j1 ℓ) • G (2 * ℓ.val) (rowI N M) (decide (0 ≤ D.t ℓ)) +
        (2 * D.j1 ℓ) • G (2 * ℓ.val + 1) (rowI N M) (decide (0 ≤ D.t ℓ))) := by
    rw [Finset.sum_range, QC14.WeightsM0.sum_fin_two_mul]
    refine Finset.sum_congr rfl (fun ℓ _ => ?_)
    have hl := ℓ.isLt
    have e1 := rowTot_one thc D aleph G (A := 2 * ℓ.val) (by omega) ℓ (by omega)
    have e2 := rowTot_one thc D aleph G (A := 2 * ℓ.val + 1) (by omega) ℓ (by omega)
    exact congrArg₂ (· + ·) e1 e2
  have h2 : ∑ x ∈ Finset.range (2 * M), rowTot thc D aleph G (2 * N + x) =
      ∑ a : Fin (2 * M), ∑ b : Fin (2 * M), if a.val < b.val then
        twoWt D a b • G (2 * N + a.val) (2 * N + b.val) (twoZ thc a b) else 0 := by
    rw [Finset.sum_range]
    exact Finset.sum_congr rfl (fun a _ => rowTot_two thc D aleph G a)
  have h3 : rowTot thc D aleph G (2 * N + 2 * M) = fillC D aleph • G (rowI N M) (rowI N M) false := by
    have hA : 2 * N + 2 * M = rowI N M := by rw [rowI_eq]; ring
    rw [rowTot_fill thc D aleph G hA, hA]
  rw [h1, h2, h3, add_assoc]

end Decomp

/-! ### Counting the two-body weights -/

/-- Generic `2 × 2` regrouping of a double sum over `Fin (2 * M)`. -/
theorem sum_sum_fin_two_mul {V : Type*} [AddCommMonoid V] (M : ℕ) (Φ : Fin (2 * M) → Fin (2 * M) → V) :
    ∑ a, ∑ b, Φ a b = ∑ μ : Fin M, ∑ ν : Fin M,
      (Φ ⟨2 * μ.val, by omega⟩ ⟨2 * ν.val, by omega⟩ +
        Φ ⟨2 * μ.val, by omega⟩ ⟨2 * ν.val + 1, by omega⟩ +
        Φ ⟨2 * μ.val + 1, by omega⟩ ⟨2 * ν.val, by omega⟩ +
        Φ ⟨2 * μ.val + 1, by omega⟩ ⟨2 * ν.val + 1, by omega⟩) := by
  rw [QC14.WeightsM0.sum_fin_two_mul]
  refine Finset.sum_congr rfl (fun μ _ => ?_)
  rw [QC14.WeightsM0.sum_fin_two_mul, QC14.WeightsM0.sum_fin_two_mul, ← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl (fun ν _ => by abel)

private theorem twoWt_eval {N M : ℕ} (D : CData N M) (a b : Fin (2 * M)) (μ ν : Fin M)
    (ha : a.val / 2 = μ.val) (hb : b.val / 2 = ν.val) :
    twoWt D a b = if μ < ν then D.j2 μ ν else 2 * D.j2 μ μ := by
  unfold twoWt
  have e1 : (⟨a.val / 2, by omega⟩ : Fin M) = μ := Fin.ext ha
  have e2 : (⟨b.val / 2, by omega⟩ : Fin M) = ν := Fin.ext hb
  rw [e1, e2]
  by_cases h : μ < ν
  · rw [if_pos (by have : μ.val < ν.val := h; omega), if_pos h]
  · rw [if_neg (by have : ¬ μ.val < ν.val := h; omega), if_neg h]

/-- `twoWt` on the pair of rows `(a, b)` when `a < b`, else `0`. -/
private def phiW {N M : ℕ} (D : CData N M) (a b : Fin (2 * M)) : ℕ :=
  if a.val < b.val then twoWt D a b else 0

private theorem phiW_eval {N M : ℕ} (D : CData N M) (a b : Fin (2 * M)) (μ ν : Fin M)
    (ha : a.val / 2 = μ.val) (hb : b.val / 2 = ν.val) :
    phiW D a b = if μ < ν then D.j2 μ ν else if μ = ν ∧ a.val < b.val then 2 * D.j2 μ μ else 0 := by
  unfold phiW
  rw [twoWt_eval D a b μ ν ha hb]
  by_cases h1 : μ < ν
  · have : a.val < b.val := by have : μ.val < ν.val := h1; omega
    rw [if_pos this, if_pos h1, if_pos h1]
  · by_cases h2 : a.val < b.val
    · have hμν : μ = ν := Fin.ext (by have : ¬ μ.val < ν.val := h1; omega)
      subst hμν
      rw [if_pos h2, if_neg h1, if_neg h1, if_pos ⟨rfl, h2⟩]
    · rw [if_neg h2, if_neg h1, if_neg (fun h => h2 h.2)]

private theorem quad_eval {N M : ℕ} (D : CData N M) (μ ν : Fin M) :
    phiW D ⟨2 * μ.val, by omega⟩ ⟨2 * ν.val, by omega⟩ +
      phiW D ⟨2 * μ.val, by omega⟩ ⟨2 * ν.val + 1, by omega⟩ +
      phiW D ⟨2 * μ.val + 1, by omega⟩ ⟨2 * ν.val, by omega⟩ +
      phiW D ⟨2 * μ.val + 1, by omega⟩ ⟨2 * ν.val + 1, by omega⟩ =
    4 * (if μ < ν then D.j2 μ ν else 0) + (if μ = ν then 2 * D.j2 μ μ else 0) := by
  have p00 := phiW_eval D ⟨2 * μ.val, by omega⟩ ⟨2 * ν.val, by omega⟩ μ ν
    (by show 2 * μ.val / 2 = μ.val; omega) (by show 2 * ν.val / 2 = ν.val; omega)
  have p01 := phiW_eval D ⟨2 * μ.val, by omega⟩ ⟨2 * ν.val + 1, by omega⟩ μ ν
    (by show 2 * μ.val / 2 = μ.val; omega) (by show (2 * ν.val + 1) / 2 = ν.val; omega)
  have p10 := phiW_eval D ⟨2 * μ.val + 1, by omega⟩ ⟨2 * ν.val, by omega⟩ μ ν
    (by show (2 * μ.val + 1) / 2 = μ.val; omega) (by show 2 * ν.val / 2 = ν.val; omega)
  have p11 := phiW_eval D ⟨2 * μ.val + 1, by omega⟩ ⟨2 * ν.val + 1, by omega⟩ μ ν
    (by show (2 * μ.val + 1) / 2 = μ.val; omega) (by show (2 * ν.val + 1) / 2 = ν.val; omega)
  rw [p00, p01, p10, p11]
  by_cases h1 : μ < ν
  · have hne : μ ≠ ν := ne_of_lt h1
    simp [h1, hne]
    omega
  · by_cases h2 : μ = ν
    · subst h2
      simp
    · simp [h1, h2]

private theorem two_sum_eval {N M : ℕ} (D : CData N M) :
    ∑ a : Fin (2 * M), ∑ b : Fin (2 * M), phiW D a b =
      4 * ∑ μ, ∑ ν, (if μ < ν then D.j2 μ ν else 0) + 2 * ∑ μ, D.j2 μ μ := by
  rw [sum_sum_fin_two_mul]
  simp only [quad_eval, Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_ite_eq,
    Finset.mem_univ, if_true]

theorem sum_flatW {N M : ℕ} {thc : THCFactorization N M} {aleph beth : ℕ} {lam : ℝ}
    {D : CData N M} (hD : CFacts thc aleph beth lam D) :
    ∑ x, flatW thc D aleph x = 2 ^ gC N M aleph := by
  have h := pairW_sum_decomp thc D aleph (fun _ _ _ => (1 : ℕ))
  simp only [smul_eq_mul, mul_one] at h
  have e : ∀ (A B : Fin (2 ^ bIC N M)) (z : Bool),
      flatW thc D aleph (encC A B z) = pairW thc D aleph A.val B.val z := by
    intro A B z
    unfold flatW
    rw [idxA_encC, idxB_encC, idxZ_encC]
  rw [sum_idx_eq]
  simp only [e]
  rw [h]
  have htwo := two_sum_eval D
  simp only [phiW] at htwo
  have hone : ∑ ℓ : Fin N, (2 * D.j1 ℓ + 2 * D.j1 ℓ) = 4 * ∑ ℓ, D.j1 ℓ := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun ℓ _ => by ring)
  rw [hone, htwo]
  have hc : coreSum D ≤ 2 ^ gC N M aleph := (coreSum_le hD).trans (four_d_le_pow_gC N M aleph)
  unfold fillC
  unfold coreSum at hc ⊢
  omega

/-! ## Normalization and offset -/

/-- Block-encoding normalization `α = (q/4) 2^g` (or `1` when `lamRep = 0`). -/
noncomputable def alphaC {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) :
    ℝ :=
  if 0 < lamRepC thc D.t then qC thc D.t aleph / 4 * 2 ^ gC N M aleph else 1

/-- Identity offset `Σ t - (1/2) Σ ζ + (1/4) Σ_μ ζ_{μμ} - (q/4) fill` (or `-1`). -/
noncomputable def offsetC {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) :
    ℝ :=
  if 0 < lamRepC thc D.t then
    (∑ ℓ, D.t ℓ - 2⁻¹ * ∑ μ, ∑ ν, thc.zeta μ ν + 4⁻¹ * ∑ μ, thc.zeta μ μ) -
      (fillC D aleph : ℝ) * qC thc D.t aleph / 4
  else -1

theorem alphaC_pos {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) :
    0 < alphaC thc D aleph := by
  unfold alphaC
  split_ifs with h
  · have hd : (0 : ℝ) < dC N M := by exact_mod_cast dC_pos_of_lamRepC_pos thc D.t h
    have hq : 0 < qC thc D.t aleph := div_pos h (by positivity)
    exact mul_pos (div_pos hq (by norm_num)) (by positivity)
  · exact one_pos

/-- `α ≤ max 1 (κ lam)` with the data-independent `κ = 2^g / (4 d 2^aleph)` (`κ ≤ 2` once
`2^(idxC + 1) ≤ 8 d 2^aleph`). -/
theorem alphaC_le {N M : ℕ} {thc : THCFactorization N M} {aleph beth : ℕ} {lam : ℝ}
    {D : CData N M} (hD : CFacts thc aleph beth lam D) :
    alphaC thc D aleph ≤
      max 1 ((2 : ℝ) ^ gC N M aleph / (4 * (dC N M : ℝ) * 2 ^ aleph) * lam) := by
  have hS_le : lamRepC thc D.t ≤ lam := hD.2.2.1
  unfold alphaC
  split_ifs with h
  · have hd : (0 : ℝ) < dC N M := by exact_mod_cast dC_pos_of_lamRepC_pos thc D.t h
    have hκ : 0 ≤ (2 : ℝ) ^ gC N M aleph / (4 * (dC N M : ℝ) * 2 ^ aleph) := by positivity
    calc qC thc D.t aleph / 4 * 2 ^ gC N M aleph
        = (2 : ℝ) ^ gC N M aleph / (4 * (dC N M : ℝ) * 2 ^ aleph) * lamRepC thc D.t := by
          unfold qC; field_simp
      _ ≤ (2 : ℝ) ^ gC N M aleph / (4 * (dC N M : ℝ) * 2 ^ aleph) * lam :=
          mul_le_mul_of_nonneg_left hS_le hκ
      _ ≤ _ := le_max_right _ _
  · exact le_max_left _ _

/-! ## Operators -/

/-- All `L = N + M` leaf angles: one-body then two-body. -/
def kAll {N M : ℕ} (D : CData N M) : Fin (N + M) → Fin N → ℤ := Fin.append D.k D.k2

/-- Row operator `V_A` (C1's `selWL`, no sign bits). -/
noncomputable def VC {N M : ℕ} (D : CData N M) (beth : ℕ) (A : Fin (2 ^ bIC N M)) :
    Operator (2 ^ (2 * N)) :=
  selWL beth (bIC N M) (kAll D) (fun _ ↦ false) A

/-- Operator of an index value: `(-1)^z (V_A V_B + V_B V_A) / 2`. -/
noncomputable def pairOpC {N M : ℕ} (D : CData N M) (beth : ℕ) (x : Fin (2 ^ idxC N M)) :
    Operator (2 ^ (2 * N)) :=
  ((if idxZ x then (-1 : ℂ) else 1) * 2⁻¹) •
    (VC D beth (idxA x) * VC D beth (idxB x) + VC D beth (idxB x) * VC D beth (idxA x))

theorem VC_conjTranspose {N M : ℕ} [NeZero N] (D : CData N M) (beth : ℕ)
    (A : Fin (2 ^ bIC N M)) : (VC D beth A)ᴴ = VC D beth A := by
  unfold VC
  exact selWL_conjTranspose _ _ _ _ _

theorem VC_mul_self {N M : ℕ} [NeZero N] (D : CData N M) (beth : ℕ) (A : Fin (2 ^ bIC N M)) :
    VC D beth A * VC D beth A = 1 := by
  unfold VC
  exact selWL_mul_self _ _ _ _ _

private theorem selWL_row {N M : ℕ} (D : CData N M) (beth : ℕ) (r : ℕ) (hr : r < 2 * (N + M))
    (hr' : r < 2 ^ bIC N M) (i : Fin (N + M)) (σ : Fin 2) (hi : r / 2 = i.val)
    (hs : r % 2 = σ.val) :
    selWL beth (bIC N M) (kAll D) (fun _ ↦ false) ⟨r, hr'⟩ =
      orbitalReflection N (givensLeaf beth (kAll D i)) σ := by
  unfold selWL
  rw [dif_pos hr]
  unfold rowVL
  have key : ∀ (i' : Fin (N + M)) (σ' : Fin 2), i' = i → σ' = σ →
      (if (false : Bool) then (-1 : ℂ) else 1) •
        orbitalReflection N (givensLeaf beth (kAll D i')) σ' =
      orbitalReflection N (givensLeaf beth (kAll D i)) σ := by
    rintro _ _ rfl rfl
    simp
  exact key _ _ (Fin.ext hi) (Fin.ext hs)

/-- One-body row `2ℓ + σ` is the reflection of leaf `u_ℓ`. -/
theorem VC_one {N M : ℕ} (D : CData N M) (beth : ℕ) (ℓ : Fin N) (σ : Fin 2) :
    VC D beth ⟨2 * ℓ.val + σ.val, by have := rows_le_bIC N M; omega⟩ =
      orbitalReflection N (givensLeaf beth (D.k ℓ)) σ := by
  have hl := ℓ.isLt
  have hσ := σ.isLt
  have h := selWL_row D beth (2 * ℓ.val + σ.val) (by omega) (by have := rows_le_bIC N M; omega)
    (Fin.castAdd M ℓ) σ (by show (2 * ℓ.val + σ.val) / 2 = ℓ.val; omega) (by omega)
  have e : kAll D (Fin.castAdd M ℓ) = D.k ℓ := Fin.append_left D.k D.k2 ℓ
  unfold VC
  rw [h, e]

/-- Two-body row `2(N + μ) + σ` is C2's `twoRow` (given the leaf facts). -/
theorem VC_two {N M : ℕ} {thc : THCFactorization N M} {beth : ℕ} {D : CData N M}
    (hk2 : ∀ μ, thc.chi μ = givensLeaf beth (D.k2 μ)) (a : Fin (2 * M)) :
    VC D beth ⟨2 * N + a.val, by have := rows_le_bIC N M; omega⟩ = twoRow thc a := by
  have ha := a.isLt
  have h := selWL_row D beth (2 * N + a.val) (by omega) (by have := rows_le_bIC N M; omega)
    (Fin.natAdd N ⟨a.val / 2, by omega⟩) ⟨a.val % 2, by omega⟩
    (by show (2 * N + a.val) / 2 = N + a.val / 2; omega)
    (by show (2 * N + a.val) % 2 = a.val % 2; omega)
  have e : kAll D (Fin.natAdd N ⟨a.val / 2, by omega⟩) = D.k2 ⟨a.val / 2, by omega⟩ :=
    Fin.append_right D.k D.k2 _
  unfold VC
  rw [h, e]
  unfold twoRow
  rw [hk2]

/-- Rows from `I = 2(N + M)` on are the identity. -/
theorem VC_ge {N M : ℕ} (D : CData N M) (beth : ℕ) (A : Fin (2 ^ bIC N M))
    (hA : rowI N M ≤ A.val) : VC D beth A = 1 := by
  have hA' : 2 * (N + M) ≤ A.val := hA
  unfold VC selWL
  rw [dif_neg (by omega)]

/-! ## Assembly helpers -/

/-- `VC` indexed by a natural number (identity outside the table). -/
private noncomputable def VCn {N M : ℕ} (D : CData N M) (beth n : ℕ) : Operator (2 ^ (2 * N)) :=
  if h : n < 2 ^ bIC N M then VC D beth ⟨n, h⟩ else 1

private theorem VCn_fin {N M : ℕ} (D : CData N M) (beth : ℕ) (A : Fin (2 ^ bIC N M)) :
    VCn D beth A.val = VC D beth A := by
  unfold VCn; rw [dif_pos A.2]

private theorem VCn_ge {N M : ℕ} [NeZero N] (D : CData N M) (beth n : ℕ) (h : rowI N M ≤ n) :
    VCn D beth n = 1 := by
  unfold VCn
  split_ifs with h'
  · exact VC_ge D beth ⟨n, h'⟩ h
  · rfl

private theorem VCn_one {N M : ℕ} (D : CData N M) (beth : ℕ) (ℓ : Fin N) (σ : Fin 2) :
    VCn D beth (2 * ℓ.val + σ.val) = orbitalReflection N (givensLeaf beth (D.k ℓ)) σ := by
  have := rows_le_bIC N M
  have := ℓ.isLt
  have := σ.isLt
  unfold VCn
  rw [dif_pos (by omega)]
  exact VC_one D beth ℓ σ

private theorem VCn_two {N M : ℕ} {thc : THCFactorization N M} {beth : ℕ} {D : CData N M}
    (hk2 : ∀ μ, thc.chi μ = givensLeaf beth (D.k2 μ)) (a : Fin (2 * M)) :
    VCn D beth (2 * N + a.val) = twoRow thc a := by
  have := rows_le_bIC N M
  have := a.isLt
  unfold VCn
  rw [dif_pos (by omega)]
  exact VC_two hk2 a

private def sgnR (z : Bool) : ℝ := if z then -1 else 1

/-- Pair operator of the triple `(A, B, z)` with the `2^-g` factor and `1/2` included. -/
private noncomputable def GC {N M : ℕ} (D : CData N M) (beth g : ℕ) (A B : ℕ) (z : Bool) :
    Operator (2 ^ (2 * N)) :=
  ((((2 : ℝ) ^ g)⁻¹ * sgnR z / 2 : ℝ) : ℂ) • (VCn D beth A * VCn D beth B + VCn D beth B * VCn D beth A)

private theorem lhs_eq {N M : ℕ} [NeZero N] (thc : THCFactorization N M) (D : CData N M)
    (aleph beth : ℕ) :
    ∑ x, (((flatW thc D aleph x : ℝ) / 2 ^ gC N M aleph : ℝ) : ℂ) • pairOpC D beth x =
      ∑ A : Fin (2 ^ bIC N M), ∑ B : Fin (2 ^ bIC N M), ∑ z : Bool,
        pairW thc D aleph A.val B.val z • GC D beth (gC N M aleph) A.val B.val z := by
  rw [sum_idx_eq]
  refine Finset.sum_congr rfl (fun A _ => Finset.sum_congr rfl (fun B _ =>
    Finset.sum_congr rfl (fun z _ => ?_)))
  have e : flatW thc D aleph (encC A B z) = pairW thc D aleph A.val B.val z := by
    unfold flatW; rw [idxA_encC, idxB_encC, idxZ_encC]
  rw [e]
  unfold pairOpC GC
  rw [idxA_encC, idxB_encC, idxZ_encC, VCn_fin, VCn_fin, ← Nat.cast_smul_eq_nsmul ℂ]
  simp only [smul_smul]
  congr 1
  cases z <;> simp [sgnR] <;> ring

private theorem GC_one {N M : ℕ} [NeZero N] (D : CData N M) (beth g : ℕ) (ℓ : Fin N) (σ : Fin 2)
    (z : Bool) :
    GC D beth g (2 * ℓ.val + σ.val) (rowI N M) z =
      ((((2 : ℝ) ^ g)⁻¹ * sgnR z : ℝ) : ℂ) • orbitalReflection N (givensLeaf beth (D.k ℓ)) σ := by
  unfold GC
  rw [VCn_one, VCn_ge D beth _ le_rfl]
  simp only [mul_one, one_mul]
  rw [← two_smul ℂ, smul_smul]
  congr 1
  push_cast
  ring

private theorem GC_one0 {N M : ℕ} [NeZero N] (D : CData N M) (beth g : ℕ) (ℓ : Fin N) (z : Bool) :
    GC D beth g (2 * ℓ.val) (rowI N M) z =
      ((((2 : ℝ) ^ g)⁻¹ * sgnR z : ℝ) : ℂ) • orbitalReflection N (givensLeaf beth (D.k ℓ)) 0 :=
  GC_one D beth g ℓ 0 z

private theorem GC_one1 {N M : ℕ} [NeZero N] (D : CData N M) (beth g : ℕ) (ℓ : Fin N) (z : Bool) :
    GC D beth g (2 * ℓ.val + 1) (rowI N M) z =
      ((((2 : ℝ) ^ g)⁻¹ * sgnR z : ℝ) : ℂ) • orbitalReflection N (givensLeaf beth (D.k ℓ)) 1 :=
  GC_one D beth g ℓ 1 z

private theorem GC_two {N M : ℕ} {thc : THCFactorization N M} {beth : ℕ} {D : CData N M}
    (hk2 : ∀ μ, thc.chi μ = givensLeaf beth (D.k2 μ)) (g : ℕ) (a b : Fin (2 * M)) (z : Bool) :
    GC D beth g (2 * N + a.val) (2 * N + b.val) z =
      ((((2 : ℝ) ^ g)⁻¹ * sgnR z / 2 : ℝ) : ℂ) •
        (twoRow thc a * twoRow thc b + twoRow thc b * twoRow thc a) := by
  unfold GC
  rw [VCn_two hk2, VCn_two hk2]

private theorem GC_fill {N M : ℕ} [NeZero N] (D : CData N M) (beth g : ℕ) :
    GC D beth g (rowI N M) (rowI N M) false =
      ((((2 : ℝ) ^ g)⁻¹ : ℝ) : ℂ) • (1 : Operator (2 ^ (2 * N))) := by
  unfold GC
  rw [VCn_ge D beth _ le_rfl]
  simp only [mul_one]
  rw [← two_smul ℂ, smul_smul]
  congr 1
  simp only [sgnR]
  push_cast
  ring

private theorem twoWt_zero {N M : ℕ} {D : CData N M} (e2 : ∀ μ ν, D.j2 μ ν = 0) (a b : Fin (2 * M)) :
    twoWt D a b = 0 := by
  unfold twoWt
  split_ifs <;> simp [e2]

private theorem sc1 {q G j t : ℝ} (hq : 0 < q) (hG : 0 < G) (h : |t| = j * q) :
    (2 * j) * (G⁻¹ * sgnR (decide (0 ≤ t))) = -((q / 4 * G)⁻¹ * (t / 2)) := by
  have hq' := hq.ne'
  have hG' := hG.ne'
  by_cases ht : 0 ≤ t
  · rw [show sgnR (decide (0 ≤ t)) = -1 by simp [sgnR, ht]]
    have ht' : t = j * q := by rw [abs_of_nonneg ht] at h; exact h
    subst ht'
    field_simp
    ring
  · rw [show sgnR (decide (0 ≤ t)) = 1 by simp [sgnR, ht]]
    have ht' : t = -(j * q) := by rw [abs_of_neg (not_le.1 ht)] at h; linarith
    subst ht'
    field_simp
    ring

private theorem sc2 {q G w ζ : ℝ} (hq : 0 < q) (hG : 0 < G) (h : |ζ| = w * q) :
    w * (G⁻¹ * sgnR (decide (ζ < 0)) / 2) = (q / 4 * G)⁻¹ * (ζ / 8) := by
  have hq' := hq.ne'
  have hG' := hG.ne'
  by_cases ht : ζ < 0
  · rw [show sgnR (decide (ζ < 0)) = -1 by simp [sgnR, ht]]
    have ht' : ζ = -(w * q) := by rw [abs_of_neg ht] at h; linarith
    subst ht'
    field_simp
    ring
  · rw [show sgnR (decide (ζ < 0)) = 1 by simp [sgnR, ht]]
    have ht' : ζ = w * q := by rw [abs_of_nonneg (not_lt.1 ht)] at h; exact h
    subst ht'
    field_simp
    ring

private theorem sc3 {q G f : ℝ} (hq : 0 < q) (hG : 0 < G) :
    f * G⁻¹ = (q / 4 * G)⁻¹ * (f * q / 4) := by
  have hq' := hq.ne'
  have hG' := hG.ne'
  field_simp

private theorem twoWt_abs {N M : ℕ} {thc : THCFactorization N M} {aleph : ℕ} {D : CData N M}
    (h5 : ∀ μ ν, μ < ν → |thc.zeta μ ν| = D.j2 μ ν * qC thc D.t aleph)
    (h6 : ∀ μ, |thc.zeta μ μ| = 2 * D.j2 μ μ * qC thc D.t aleph)
    (a b : Fin (2 * M)) (hab : a.val < b.val) :
    |zeta2 thc a b| = (twoWt D a b : ℝ) * qC thc D.t aleph := by
  have ha := a.isLt
  have hb := b.isLt
  unfold twoWt zeta2
  split_ifs with h
  · exact h5 _ _ h
  · have hμ : (⟨b.val / 2, by omega⟩ : Fin M) = ⟨a.val / 2, by omega⟩ := Fin.ext (by simp; omega)
    rw [hμ, h6]
    push_cast
    ring

/-! ## The exact LCU -/

/-- The weighted pair sum is `α⁻¹ (thcHamiltonian - c' 1)`. -/
theorem blockSumC_eq {N M : ℕ} [NeZero N] {thc : THCFactorization N M} {aleph beth : ℕ}
    {lam : ℝ} {D : CData N M} (hD : CFacts thc aleph beth lam D) :
    ∑ x, (((flatW thc D aleph x : ℝ) / 2 ^ gC N M aleph : ℝ) : ℂ) • pairOpC D beth x =
      ((alphaC thc D aleph)⁻¹ : ℂ) •
        (thcHamiltonian thc - (offsetC thc D aleph : ℂ) • 1) := by
  obtain ⟨hk2, hT, hS, h4, h5, h6, h7⟩ := hD
  have hsq : ∀ a, twoRow thc a * twoRow thc a = 1 := by
    intro a
    have := VC_mul_self D beth ⟨2 * N + a.val, by
      have := rows_le_bIC N M; have := a.isLt; omega⟩
    rwa [VC_two hk2 a] at this
  rw [lhs_eq, pairW_sum_decomp thc D aleph (GC D beth (gC N M aleph)),
    thcHamiltonian_rows thc D.t (fun ℓ => givensLeaf beth (D.k ℓ)) hT hsq]
  beta_reduce
  by_cases hpos : 0 < lamRepC thc D.t
  · have hd : (0 : ℝ) < dC N M := by exact_mod_cast dC_pos_of_lamRepC_pos thc D.t hpos
    have hq : 0 < qC thc D.t aleph := div_pos hpos (by positivity)
    have hG : (0 : ℝ) < 2 ^ gC N M aleph := by positivity
    have hα : alphaC thc D aleph = qC thc D.t aleph / 4 * 2 ^ gC N M aleph := by
      unfold alphaC; rw [if_pos hpos]
    have hoff : offsetC thc D aleph =
        (∑ ℓ, D.t ℓ - 2⁻¹ * ∑ μ, ∑ ν, thc.zeta μ ν + 4⁻¹ * ∑ μ, thc.zeta μ μ) -
          (fillC D aleph : ℝ) * qC thc D.t aleph / 4 := by
      unfold offsetC; rw [if_pos hpos]
    rw [hα, hoff]
    have h1 : (∑ ℓ : Fin N, ((2 * D.j1 ℓ) • GC D beth (gC N M aleph) (2 * ℓ.val) (rowI N M)
          (decide (0 ≤ D.t ℓ)) +
        (2 * D.j1 ℓ) • GC D beth (gC N M aleph) (2 * ℓ.val + 1) (rowI N M)
          (decide (0 ≤ D.t ℓ)))) =
        ((qC thc D.t aleph / 4 * 2 ^ gC N M aleph : ℝ) : ℂ)⁻¹ •
          -(∑ ℓ, ∑ σ : Fin 2, ((D.t ℓ / 2 : ℝ) : ℂ) •
            orbitalReflection N (givensLeaf beth (D.k ℓ)) σ) := by
      rw [smul_neg, Finset.smul_sum, ← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl (fun ℓ _ => ?_)
      have hs : ((2 * D.j1 ℓ : ℕ) : ℂ) * ((((2 : ℝ) ^ gC N M aleph)⁻¹ *
          sgnR (decide (0 ≤ D.t ℓ)) : ℝ) : ℂ) =
          -(((qC thc D.t aleph / 4 * 2 ^ gC N M aleph : ℝ) : ℂ)⁻¹ * ((D.t ℓ / 2 : ℝ) : ℂ)) := by
        have := sc1 hq hG (h4 ℓ)
        exact_mod_cast this
      rw [Finset.smul_sum, Fin.sum_univ_two, GC_one0, GC_one1,
        ← Nat.cast_smul_eq_nsmul ℂ, ← Nat.cast_smul_eq_nsmul ℂ]
      simp only [smul_smul]
      rw [hs]
      module
    have h2 : (∑ a : Fin (2 * M), ∑ b : Fin (2 * M), if a.val < b.val then
          twoWt D a b • GC D beth (gC N M aleph) (2 * N + a.val) (2 * N + b.val) (twoZ thc a b)
          else 0) =
        ((qC thc D.t aleph / 4 * 2 ^ gC N M aleph : ℝ) : ℂ)⁻¹ •
          ∑ a : Fin (2 * M), ∑ b : Fin (2 * M), if a < b then
            ((zeta2 thc a b / 8 : ℝ) : ℂ) •
              (twoRow thc a * twoRow thc b + twoRow thc b * twoRow thc a) else 0 := by
      rw [Finset.smul_sum]
      refine Finset.sum_congr rfl (fun a _ => ?_)
      rw [Finset.smul_sum]
      refine Finset.sum_congr rfl (fun b _ => ?_)
      by_cases hab : a < b
      · have hab' : a.val < b.val := hab
        rw [if_pos hab', if_pos hab, GC_two hk2, ← Nat.cast_smul_eq_nsmul ℂ]
        simp only [smul_smul]
        congr 1
        have e : twoZ thc a b = decide (zeta2 thc a b < 0) := rfl
        rw [e]
        have := sc2 hq hG (twoWt_abs h5 h6 a b hab')
        exact_mod_cast this
      · rw [if_neg (show ¬ a.val < b.val from hab), if_neg hab, smul_zero]
    have h3 : fillC D aleph • GC D beth (gC N M aleph) (rowI N M) (rowI N M) false =
        ((qC thc D.t aleph / 4 * 2 ^ gC N M aleph : ℝ) : ℂ)⁻¹ •
          ((((∑ ℓ, D.t ℓ - 2⁻¹ * ∑ μ, ∑ ν, thc.zeta μ ν + 4⁻¹ * ∑ μ, thc.zeta μ μ : ℝ)) : ℂ) •
            (1 : Operator (2 ^ (2 * N))) -
          ((((∑ ℓ, D.t ℓ - 2⁻¹ * ∑ μ, ∑ ν, thc.zeta μ ν + 4⁻¹ * ∑ μ, thc.zeta μ μ) -
            (fillC D aleph : ℝ) * qC thc D.t aleph / 4 : ℝ)) : ℂ) • (1 : Operator (2 ^ (2 * N)))) := by
      rw [← sub_smul, ← Complex.ofReal_sub, sub_sub_cancel, GC_fill,
        ← Nat.cast_smul_eq_nsmul ℂ, smul_smul, smul_smul]
      congr 1
      have := sc3 (f := (fillC D aleph : ℝ)) hq hG
      exact_mod_cast this
    rw [h1, h2, h3]
    module
  · have hS0 : lamRepC thc D.t = 0 := le_antisymm (not_lt.1 hpos) (lamRepC_nonneg thc D.t)
    obtain ⟨e1, e2⟩ := h7 hS0
    have hα : alphaC thc D aleph = 1 := by unfold alphaC; rw [if_neg hpos]
    have hoff : offsetC thc D aleph = -1 := by unfold offsetC; rw [if_neg hpos]
    have hs1 : 0 ≤ ∑ ℓ, |D.t ℓ| := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have hs2 : 0 ≤ ∑ μ, ∑ ν, |thc.zeta μ ν| :=
      Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _))
    have hS' : lamRepC thc D.t = ∑ ℓ, |D.t ℓ| + 2⁻¹ * ∑ μ, ∑ ν, |thc.zeta μ ν| := rfl
    have ht0 : ∀ ℓ, D.t ℓ = 0 := fun ℓ =>
      abs_eq_zero.1 ((Finset.sum_eq_zero_iff_of_nonneg (fun i _ => abs_nonneg (D.t i))).1
        (by linarith) ℓ (Finset.mem_univ _))
    have hz0 : ∀ μ ν, thc.zeta μ ν = 0 := by
      intro μ ν
      have hsum : ∑ μ', ∑ ν', |thc.zeta μ' ν'| = 0 := by linarith
      have hrow : ∑ ν', |thc.zeta μ ν'| = 0 :=
        (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => Finset.sum_nonneg
          (fun j _ => abs_nonneg (thc.zeta i j)))).1 hsum μ (Finset.mem_univ _)
      exact abs_eq_zero.1 ((Finset.sum_eq_zero_iff_of_nonneg
        (fun j _ => abs_nonneg (thc.zeta μ j))).1 hrow ν (Finset.mem_univ _))
    have hfill : fillC D aleph = 2 ^ gC N M aleph := by
      unfold fillC coreSum; simp [e1, e2]
    rw [hα, hoff]
    have hL1 : (∑ ℓ : Fin N, ((2 * D.j1 ℓ) • GC D beth (gC N M aleph) (2 * ℓ.val) (rowI N M)
          (decide (0 ≤ D.t ℓ)) +
        (2 * D.j1 ℓ) • GC D beth (gC N M aleph) (2 * ℓ.val + 1) (rowI N M)
          (decide (0 ≤ D.t ℓ)))) = 0 :=
      Finset.sum_eq_zero (fun ℓ _ => by simp [e1])
    have hL2 : (∑ a : Fin (2 * M), ∑ b : Fin (2 * M), if a.val < b.val then
          twoWt D a b • GC D beth (gC N M aleph) (2 * N + a.val) (2 * N + b.val) (twoZ thc a b)
          else 0) = 0 :=
      Finset.sum_eq_zero (fun a _ => Finset.sum_eq_zero (fun b _ => by simp [twoWt_zero e2]))
    rw [hL1, hL2, hfill, GC_fill, ← Nat.cast_smul_eq_nsmul ℂ, smul_smul]
    simp [ht0, hz0, zeta2]

end QC14.WeightsC


/-! Inlined from lane module `THC/AliasTable.lean`. -/

namespace QC14
open QuantumComputation QuantumComputation.Specs Finset QC14.WeightsC

/-! ## Vose's table -/

-- Ported from QC7_alias notes/aliasprep/work/Alias.lean (commit f1a647e)
namespace AliasPort

/-- Vose's algorithm on a list `S` of active slots with residual masses `r`, by recursion on a fuel
bound (the number of active slots). -/
def aliasBuild (M : ℕ) : ℕ → List ℕ → (ℕ → ℕ) → (ℕ → ℕ × ℕ)
  | 0, _, _ => fun i => (0, i)
  | k + 1, S, r =>
    match S.find? (fun j => decide (r j ≤ M)) with
    | none => fun i => (0, i)
    | some s =>
      match (S.erase s).find? (fun j => decide (M ≤ r j)) with
      | none => Function.update (aliasBuild M k (S.erase s) r) s (0, s)
      | some l =>
        Function.update
          (aliasBuild M k (S.erase s) (Function.update r l (r l + r s - M))) s
          (if r s < M then (r s, l) else (0, s))

/-- Alias table for `N` slots, each of `M` sub-slots, for counts `m j` (j < N) summing to `N * M`.
Entry `i` is `(K_i, a_i)`: sub-slot `s` of slot `i` goes to `i` if `s < K_i`, else to `a_i`. -/
def aliasTable (M N : ℕ) (m : ℕ → ℕ) : ℕ → ℕ × ℕ :=
  aliasBuild M N (List.range N) m

def aliasOut (M N : ℕ) (m : ℕ → ℕ) (i s : ℕ) : ℕ :=
  if s < (aliasTable M N m i).1 then i else (aliasTable M N m i).2

/-- Number of sub-slots of slot `i` sent to `j`. -/
def contrib (M : ℕ) (T : ℕ → ℕ × ℕ) (i j : ℕ) : ℕ :=
  (if i = j then (T i).1 else 0) + (if (T i).2 = j then M - (T i).1 else 0)

def Good (M : ℕ) (S : List ℕ) (r : ℕ → ℕ) (T : ℕ → ℕ × ℕ) : Prop :=
  (∀ i ∈ S, (T i).1 < M ∧ (T i).2 ∈ S) ∧
    ∀ j ∈ S, r j = (S.map (fun i ↦ contrib M T i j)).sum

lemma sum_erase (S : List ℕ) (s : ℕ) (hs : s ∈ S) (f : ℕ → ℕ) :
    (S.map f).sum = f s + ((S.erase s).map f).sum := by
  have := ((List.perm_cons_erase hs).map f).sum_eq
  simpa using this

lemma sum_lt_of_lt (M : ℕ) (r : ℕ → ℕ) : ∀ S : List ℕ, S ≠ [] → (∀ j ∈ S, r j < M) →
    (S.map r).sum < S.length * M := by
  intro S
  induction S with
  | nil => simp
  | cons a t ih =>
    intro _ h
    have ha := h a (by simp)
    have h2 : ∀ j ∈ t, r j < M := fun j hj ↦ h j (by simp [hj])
    by_cases ht : t = []
    · subst ht; simpa using ha
    · have := ih ht h2
      simp only [List.map_cons, List.sum_cons, List.length_cons]
      nlinarith

lemma sum_gt_of_gt (M : ℕ) (r : ℕ → ℕ) : ∀ S : List ℕ, S ≠ [] → (∀ j ∈ S, M < r j) →
    S.length * M < (S.map r).sum := by
  intro S
  induction S with
  | nil => simp
  | cons a t ih =>
    intro _ h
    have ha := h a (by simp)
    have h2 : ∀ j ∈ t, M < r j := fun j hj ↦ h j (by simp [hj])
    by_cases ht : t = []
    · subst ht; simpa using ha
    · have := ih ht h2
      simp only [List.map_cons, List.sum_cons, List.length_cons]
      nlinarith

lemma good_step (M : ℕ) (S : List ℕ) (r r' : ℕ → ℕ) (T' : ℕ → ℕ × ℕ) (s : ℕ) (e : ℕ × ℕ)
    (hnd : S.Nodup) (hs : s ∈ S) (hG : Good M (S.erase s) r' T')
    (he1 : e.1 < M) (he2 : e.2 ∈ S)
    (hr1 : ∀ j ∈ S.erase s, r j = r' j + if e.2 = j then M - e.1 else 0)
    (hr2 : r s = e.1 + if e.2 = s then M - e.1 else 0) :
    Good M S r (Function.update T' s e) := by
  have hne : ∀ i ∈ S.erase s, i ≠ s := fun i hi ↦ ((hnd.mem_erase_iff).1 hi).1
  refine ⟨?_, ?_⟩
  · intro i hi
    by_cases his : i = s
    · subst his; simpa using And.intro he1 he2
    · have hi' : i ∈ S.erase s := (hnd.mem_erase_iff).2 ⟨his, hi⟩
      have := hG.1 i hi'
      simp only [Function.update_of_ne his]
      exact ⟨this.1, List.mem_of_mem_erase this.2⟩
  · intro j hj
    rw [sum_erase S s hs]
    have hcongr : ((S.erase s).map (fun i ↦ contrib M (Function.update T' s e) i j)).sum
        = ((S.erase s).map (fun i ↦ contrib M T' i j)).sum := by
      congr 1
      apply List.map_congr_left
      intro i hi
      simp [contrib, Function.update_of_ne (hne i hi)]
    rw [hcongr]
    by_cases hjs : j = s
    · subst hjs
      have h0 : ((S.erase j).map (fun i ↦ contrib M T' i j)).sum = 0 := by
        apply List.sum_eq_zero
        intro x hx
        obtain ⟨i, hi, rfl⟩ := List.mem_map.1 hx
        have h2 := (hG.1 i hi).2
        have hij := hne i hi
        have h3 : (T' i).2 ≠ j := fun h ↦ hne _ h2 h
        simp [contrib, hij, h3]
      rw [h0, hr2]
      simp [contrib]
    · have hj' : j ∈ S.erase s := (hnd.mem_erase_iff).2 ⟨hjs, hj⟩
      have h1 := hG.2 j hj'
      have h2 := hr1 j hj'
      rw [← h1] at *
      rw [h2]
      simp [contrib, Ne.symm hjs]
      omega

theorem build_good (M : ℕ) (hM : 0 < M) : ∀ (k : ℕ) (S : List ℕ) (r : ℕ → ℕ), S.Nodup →
    S.length = k → (S.map r).sum = k * M → Good M S r (aliasBuild M k S r) := by
  intro k
  induction k with
  | zero =>
    intro S r _ hlen _
    have : S = [] := List.length_eq_zero_iff.1 hlen
    subst this
    simp [Good]
  | succ k ih =>
    intro S r hnd hlen hsum
    have hne : S ≠ [] := by
      rintro rfl; simp at hlen
    have hex : ∃ s ∈ S, r s ≤ M := by
      by_contra h
      push Not at h
      have := sum_gt_of_gt M r S hne h
      rw [hlen, hsum] at this
      exact lt_irrefl _ this
    simp only [aliasBuild]
    split
    · rename_i hs
      exfalso
      obtain ⟨j, hj, hjr⟩ := hex
      have := List.find?_eq_none.1 hs j hj
      simp [hjr] at this
    · rename_i s hs
      have hsS : s ∈ S := List.mem_of_find?_eq_some hs
      have hsr : r s ≤ M := by simpa using List.find?_some hs
      have hndE : (S.erase s).Nodup := hnd.erase s
      have hlenE : (S.erase s).length = k := by
        rw [List.length_erase_of_mem hsS, hlen]; rfl
      have hsumS := sum_erase S s hsS r
      have hsM : (k + 1) * M = k * M + M := by ring
      split
      · rename_i hl
        have hk : k = 0 := by
          by_contra hk0
          have hneE : S.erase s ≠ [] := by
            intro h; rw [h] at hlenE; simp at hlenE; omega
          have hlt : ∀ j ∈ S.erase s, r j < M := by
            intro j hj
            have := List.find?_eq_none.1 hl j hj
            simpa using this
          have := sum_lt_of_lt M r _ hneE hlt
          rw [hlenE] at this
          omega
        subst hk
        have hE : S.erase s = [] := List.length_eq_zero_iff.1 hlenE
        have hrs : r s = M := by
          rw [hE] at hsumS
          simp at hsumS hsum
          omega
        have hG := ih (S.erase s) r hndE hlenE (by rw [hE]; simp)
        refine good_step M S r r _ s (0, s) hnd hsS hG (by simpa using hM) hsS ?_ ?_
        · intro j hj; rw [hE] at hj; simp at hj
        · simp [hrs]
      · rename_i l hl
        have hlE : l ∈ S.erase s := List.mem_of_find?_eq_some hl
        have hlM : M ≤ r l := by simpa using List.find?_some hl
        have hls : l ≠ s := ((hnd.mem_erase_iff).1 hlE).1
        have hlS : l ∈ S := List.mem_of_mem_erase hlE
        have hsumE := sum_erase (S.erase s) l hlE r
        have hsumE' := sum_erase (S.erase s) l hlE (Function.update r l (r l + r s - M))
        have hndEE : ((S.erase s).erase l).Nodup := hndE.erase l
        have hW : (((S.erase s).erase l).map (Function.update r l (r l + r s - M))).sum
            = (((S.erase s).erase l).map r).sum := by
          congr 1
          apply List.map_congr_left
          intro j hj
          have : j ≠ l := ((hndE.mem_erase_iff).1 hj).1
          simp [Function.update_of_ne this]
        have hsum' : ((S.erase s).map (Function.update r l (r l + r s - M))).sum = k * M := by
          rw [hsumE', hW]
          simp only [Function.update_self]
          omega
        have hG := ih (S.erase s) (Function.update r l (r l + r s - M)) hndE hlenE hsum'
        have hrl : ∀ j ∈ S.erase s, Function.update r l (r l + r s - M) j
            = if j = l then r l + r s - M else r j := by
          intro j _
          by_cases h : j = l
          · subst h; simp
          · simp [h]
        by_cases hlt : r s < M
        · simp only [hlt, ite_true]
          refine good_step M S r _ _ s (r s, l) hnd hsS hG hlt hlS ?_ ?_
          · intro j hj
            rw [hrl j hj]
            by_cases h : j = l
            · subst h; simp; omega
            · simp [h, Ne.symm h]
          · simp [hls]
        · simp only [hlt, ite_false]
          have hrs : r s = M := by omega
          refine good_step M S r _ _ s (0, s) hnd hsS hG (by simpa using hM) hsS ?_ ?_
          · intro j hj
            rw [hrl j hj]
            have hjs : s ≠ j := (Ne.symm ((hnd.mem_erase_iff).1 hj).1)
            by_cases h : j = l
            · subst h; simp [hjs]; omega
            · simp [h, hjs]
          · simp [hrs]

lemma list_range_sum (f : ℕ → ℕ) (N : ℕ) : ((List.range N).map f).sum = ∑ i ∈ range N, f i := by
  induction N with
  | zero => simp
  | succ n ih => rw [List.range_succ, List.map_append, List.sum_append, ih, Finset.sum_range_succ]; simp

lemma aliasTable_good (M N : ℕ) (m : ℕ → ℕ) (hM : 0 < M)
    (hsum : ∑ j ∈ range N, m j = N * M) :
    Good M (List.range N) m (aliasTable M N m) :=
  build_good M hM N (List.range N) m (List.nodup_range) (by simp)
    (by rw [list_range_sum]; exact hsum)

theorem aliasTable_lt (M N : ℕ) (m : ℕ → ℕ) (hM : 0 < M) (hsum : ∑ j ∈ range N, m j = N * M)
    (i : ℕ) (hi : i < N) : (aliasTable M N m i).1 < M ∧ (aliasTable M N m i).2 < N := by
  have := (aliasTable_good M N m hM hsum).1 i (List.mem_range.2 hi)
  simpa using this

lemma card_row (M N : ℕ) (m : ℕ → ℕ) (i j : ℕ) (hK : (aliasTable M N m i).1 ≤ M) :
    ((range M).filter (fun s ↦ aliasOut M N m i s = j)).card = contrib M (aliasTable M N m) i j := by
  rw [Finset.card_filter, ← Finset.sum_range_add_sum_Ico _ hK]
  have h1 : ∑ s ∈ range (aliasTable M N m i).1, (if aliasOut M N m i s = j then 1 else 0)
      = if i = j then (aliasTable M N m i).1 else 0 := by
    rw [Finset.sum_congr rfl (g := fun _ ↦ if i = j then 1 else 0)]
    · simp
    · intro s hs
      have := Finset.mem_range.1 hs
      simp [aliasOut, this]
  have h2 : ∑ s ∈ Ico (aliasTable M N m i).1 M, (if aliasOut M N m i s = j then 1 else 0)
      = if (aliasTable M N m i).2 = j then M - (aliasTable M N m i).1 else 0 := by
    rw [Finset.sum_congr rfl (g := fun _ ↦ if (aliasTable M N m i).2 = j then 1 else 0)]
    · simp
    · intro s hs
      have := (Finset.mem_Ico.1 hs).1
      simp [aliasOut, not_lt.2 this]
  rw [h1, h2]
  rfl

theorem aliasOut_card (M N : ℕ) (m : ℕ → ℕ) (hM : 0 < M) (hsum : ∑ j ∈ range N, m j = N * M)
    (j : ℕ) (hj : j < N) :
    ((range N ×ˢ range M).filter (fun p ↦ aliasOut M N m p.1 p.2 = j)).card = m j := by
  have hG := (aliasTable_good M N m hM hsum).2 j (List.mem_range.2 hj)
  rw [hG, list_range_sum, Finset.card_filter, Finset.sum_product]
  apply Finset.sum_congr rfl
  intro i hi
  rw [← Finset.card_filter]
  exact card_row M N m i j (aliasTable_lt M N m hM hsum i (Finset.mem_range.1 hi)).1.le


end AliasPort

/-! ## Generic alias fibre function -/

/-- Slot of a garbage value: the low `s` bits. -/
def aliasSlot {g s : ℕ} (σ : Fin (2 ^ g)) : Fin (2 ^ s) :=
  ⟨σ.val % 2 ^ s, Nat.mod_lt _ (Nat.two_pow_pos _)⟩

/-- Sub-slot of a garbage value: the high `g − s` bits. -/
def aliasSub {g s : ℕ} (σ : Fin (2 ^ g)) : ℕ := σ.val / 2 ^ s

/-- Alias fibre function: sub-slots below the keep value go to `ind`, the rest to `alt`. -/
def aliasF {L g s : ℕ} (ind alt : Fin (2 ^ s) → Fin L) (K : Fin (2 ^ s) → ℕ)
    (σ : Fin (2 ^ g)) : Fin L :=
  if aliasSub (s := s) σ < K (aliasSlot σ) then ind (aliasSlot σ) else alt (aliasSlot σ)

/-- Exact alias tables exist for natural weights summing to `2^g` with support at most `2^s`. -/
theorem exists_alias {L g s : ℕ} (w : Fin L → ℕ) (hsum : ∑ y, w y = 2 ^ g) (hs : s ≤ g)
    (hsupp : (univ.filter fun y ↦ w y ≠ 0).card ≤ 2 ^ s) :
    ∃ (ind alt : Fin (2 ^ s) → Fin L) (K : Fin (2 ^ s) → ℕ), (∀ x, K x < 2 ^ (g - s)) ∧
      ∀ y, (univ.filter fun σ : Fin (2 ^ g) ↦ aliasF ind alt K σ = y).card = w y := by
  classical
  set S : Finset (Fin L) := univ.filter fun y ↦ w y ≠ 0 with hS
  have hL : 0 < L := by
    rcases Nat.eq_zero_or_pos L with rfl | h
    · have := Nat.two_pow_pos g
      simp at hsum
      omega
    · exact h
  have hpos : 0 < 2 ^ s := Nat.two_pow_pos _
  have hM : 0 < 2 ^ (g - s) := Nat.two_pow_pos _
  have hgs : 2 ^ s * 2 ^ (g - s) = 2 ^ g := by rw [← pow_add]; congr 1; omega
  let y0 : Fin L := ⟨0, hL⟩
  obtain ⟨e0⟩ : Nonempty ({y // y ∈ S} ↪ Fin (2 ^ s)) :=
    Function.Embedding.nonempty_of_card_le (by simpa using hsupp)
  let e : Fin L → Fin (2 ^ s) := fun y ↦ if h : y ∈ S then e0 ⟨y, h⟩ else ⟨0, hpos⟩
  have he : ∀ y ∈ S, ∀ y' ∈ S, e y = e y' → y = y' := by
    intro y hy y' hy' h
    have h1 : e y = e0 ⟨y, hy⟩ := dif_pos hy
    have h2 : e y' = e0 ⟨y', hy'⟩ := dif_pos hy'
    rw [h1, h2] at h
    exact congrArg Subtype.val (e0.injective h)
  let m : Fin (2 ^ s) → ℕ := fun i ↦ ∑ y ∈ S.filter (fun y ↦ e y = i), w y
  have hm_sum : ∑ i, m i = 2 ^ g := by
    calc ∑ i, m i = ∑ y ∈ S, w y :=
          Finset.sum_fiberwise_of_maps_to (s := S) (t := univ) (g := e)
            (fun _ _ ↦ mem_univ _) w
      _ = ∑ y, w y := Finset.sum_filter_ne_zero _
      _ = 2 ^ g := hsum
  let ind : Fin (2 ^ s) → Fin L := fun i ↦ if h : ∃ y ∈ S, e y = i then h.choose else y0
  have hind : ∀ y ∈ S, ind (e y) = y := by
    intro y hy
    have h : ∃ y' ∈ S, e y' = e y := ⟨y, hy, rfl⟩
    have h1 : ind (e y) = h.choose := dif_pos h
    rw [h1]
    exact he _ h.choose_spec.1 y hy h.choose_spec.2
  let mN : ℕ → ℕ := fun i ↦ if h : i < 2 ^ s then m ⟨i, h⟩ else 0
  have hmN : ∀ i : Fin (2 ^ s), mN i.val = m i := fun i ↦ by
    simp only [mN, dif_pos i.2]
  have hsumN : ∑ j ∈ range (2 ^ s), mN j = 2 ^ s * 2 ^ (g - s) := by
    rw [hgs, ← hm_sum, Finset.sum_range]
    exact Finset.sum_congr rfl fun i _ ↦ hmN i
  let sl : ℕ → Fin (2 ^ s) := fun a ↦ ⟨a % 2 ^ s, Nat.mod_lt _ hpos⟩
  have hsl : ∀ i : Fin (2 ^ s), sl i.val = i := fun i ↦ Fin.ext (Nat.mod_eq_of_lt i.2)
  let T := AliasPort.aliasTable (2 ^ (g - s)) (2 ^ s) mN
  have hlt := AliasPort.aliasTable_lt (2 ^ (g - s)) (2 ^ s) mN hM hsumN
  refine ⟨ind, fun i ↦ ind (sl (T i.val).2), fun i ↦ (T i.val).1,
    fun i ↦ (hlt i.val i.2).1, ?_⟩
  intro y
  -- Step 1: the fibre function through the ported output
  have hF : ∀ σ : Fin (2 ^ g), aliasF ind (fun i ↦ ind (sl (T i.val).2)) (fun i ↦ (T i.val).1) σ
      = ind (sl (AliasPort.aliasOut (2 ^ (g - s)) (2 ^ s) mN (σ.val % 2 ^ s) (σ.val / 2 ^ s))) := by
    intro σ
    unfold aliasF AliasPort.aliasOut
    split_ifs with h1 h2 h2
    · congr 1
      apply Fin.ext
      simp [sl, aliasSlot]
    · exact absurd h1 h2
    · exact absurd h2 h1
    · rfl
  -- Step 2: transfer to pairs (slot, sub-slot)
  have hcard1 : (univ.filter fun σ : Fin (2 ^ g) ↦
        aliasF ind (fun i ↦ ind (sl (T i.val).2)) (fun i ↦ (T i.val).1) σ = y).card =
      ((range (2 ^ s) ×ˢ range (2 ^ (g - s))).filter fun p ↦
        ind (sl (AliasPort.aliasOut (2 ^ (g - s)) (2 ^ s) mN p.1 p.2)) = y).card := by
    refine Finset.card_bij (fun σ _ ↦ (σ.val % 2 ^ s, σ.val / 2 ^ s)) ?_ ?_ ?_
    · intro σ hσ
      rw [mem_filter] at hσ ⊢
      refine ⟨?_, by rw [← hF]; exact hσ.2⟩
      rw [mem_product, mem_range, mem_range]
      refine ⟨Nat.mod_lt _ hpos, Nat.div_lt_of_lt_mul ?_⟩
      rw [hgs]; exact σ.2
    · intro σ _ σ' _ h
      rw [Prod.mk.injEq] at h
      apply Fin.ext
      rw [← Nat.mod_add_div σ.val (2 ^ s), ← Nat.mod_add_div σ'.val (2 ^ s), h.1, h.2]
    · intro p hp
      rw [mem_filter, mem_product, mem_range, mem_range] at hp
      have hb : p.1 + 2 ^ s * p.2 < 2 ^ g := by
        rw [← hgs]
        calc p.1 + 2 ^ s * p.2 < 2 ^ s + 2 ^ s * p.2 := by omega
          _ = 2 ^ s * (p.2 + 1) := by ring
          _ ≤ 2 ^ s * 2 ^ (g - s) := Nat.mul_le_mul_left _ hp.1.2
      refine ⟨⟨p.1 + 2 ^ s * p.2, hb⟩, ?_, ?_⟩
      · rw [mem_filter]
        refine ⟨mem_univ _, ?_⟩
        rw [hF]
        simp only [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hp.1.1,
          Nat.add_mul_div_left _ _ hpos, Nat.div_eq_of_lt hp.1.1, zero_add]
        exact hp.2
      · simp only [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hp.1.1,
          Nat.add_mul_div_left _ _ hpos, Nat.div_eq_of_lt hp.1.1, zero_add]
  -- Step 3: sum over the output slots
  have hcard2 : ((range (2 ^ s) ×ˢ range (2 ^ (g - s))).filter fun p ↦
        ind (sl (AliasPort.aliasOut (2 ^ (g - s)) (2 ^ s) mN p.1 p.2)) = y).card =
      ∑ j ∈ range (2 ^ s), if ind (sl j) = y then mN j else 0 := by
    rw [Finset.card_eq_sum_card_fiberwise
      (f := fun p : ℕ × ℕ ↦ AliasPort.aliasOut (2 ^ (g - s)) (2 ^ s) mN p.1 p.2)
      (t := range (2 ^ s))]
    · refine Finset.sum_congr rfl fun j hj ↦ ?_
      rw [Finset.filter_filter]
      by_cases hy : ind (sl j) = y
      · rw [if_pos hy,
          ← AliasPort.aliasOut_card (2 ^ (g - s)) (2 ^ s) mN hM hsumN j (mem_range.1 hj)]
        congr 1
        apply Finset.filter_congr
        intro p _
        constructor
        · exact fun h ↦ h.2
        · intro h; exact ⟨by rw [h]; exact hy, h⟩
      · rw [if_neg hy]
        apply Finset.card_eq_zero.2
        apply Finset.filter_eq_empty_iff.2
        intro p _ h
        exact hy (by rw [← h.2]; exact h.1)
    · intro p hp
      rw [Finset.mem_coe, mem_filter, mem_product, mem_range, mem_range] at hp
      rw [Finset.mem_coe, mem_range]
      have := AliasPort.aliasTable_lt (2 ^ (g - s)) (2 ^ s) mN hM hsumN
      -- aliasOut is either the slot itself or its alias, both below `2 ^ s`
      show AliasPort.aliasOut (2 ^ (g - s)) (2 ^ s) mN p.1 p.2 < 2 ^ s
      unfold AliasPort.aliasOut
      split_ifs
      · exact hp.1.1
      · exact (this p.1 hp.1.1).2
  -- Step 4: back to slots as `Fin`
  have hcard3 : (∑ j ∈ range (2 ^ s), if ind (sl j) = y then mN j else 0) =
      ∑ i : Fin (2 ^ s), if ind i = y then m i else 0 := by
    rw [Finset.sum_range]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [hsl i, hmN i]
  -- Step 5: group the slot masses by support point
  have hper : ∀ i : Fin (2 ^ s), (if ind i = y then m i else 0) =
      ∑ y' ∈ S.filter (fun y' ↦ e y' = i), if y' = y then w y' else 0 := by
    intro i
    have hk : ∀ y' ∈ S.filter (fun y' ↦ e y' = i), ind i = y' := fun y' hy' ↦ by
      rw [mem_filter] at hy'
      rw [← hy'.2]
      exact hind y' hy'.1
    by_cases h : ind i = y
    · rw [if_pos h]
      refine Finset.sum_congr rfl fun y' hy' ↦ ?_
      rw [if_pos ((hk y' hy').symm.trans h)]
    · rw [if_neg h]
      symm
      apply Finset.sum_eq_zero
      intro y' hy'
      rw [if_neg (fun hh ↦ h ((hk y' hy').trans hh))]
  have hfin : (∑ i : Fin (2 ^ s), if ind i = y then m i else 0) = w y := by
    rw [Finset.sum_congr rfl fun i _ ↦ hper i,
      Finset.sum_fiberwise_of_maps_to (s := S) (t := univ) (g := e) (fun _ _ ↦ mem_univ _)
        (fun y' ↦ if y' = y then w y' else 0)]
    rw [Finset.sum_ite_eq' S y w]
    by_cases hy : y ∈ S
    · rw [if_pos hy]
    · rw [if_neg hy]
      have : ¬ w y ≠ 0 := fun h' ↦ hy (by rw [hS, mem_filter]; exact ⟨mem_univ _, h'⟩)
      exact (not_not.1 this).symm
  rw [hcard1, hcard2, hcard3, hfin]

/-! ## The THC instance -/

/-- Support bound for the spin-resolved pair weights: `2N + M(2M−1) + 1`. -/
def nSupp (N M : ℕ) : ℕ := 2 * N + M * (2 * M - 1) + 1

/-- Slot bits of the alias PREPARE. -/
def sA (N M : ℕ) : ℕ := Nat.clog 2 (nSupp N M)

theorem nSupp_le_pow_sA (N M : ℕ) : nSupp N M ≤ 2 ^ sA N M :=
  Nat.le_pow_clog (by norm_num) _

theorem sA_le_gC (N M aleph : ℕ) : sA N M ≤ gC N M aleph := by
  rcases Nat.eq_zero_or_pos (N + M) with h | h
  · have hN : N = 0 := by omega
    have hM : M = 0 := by omega
    subst hN hM
    simp [sA, nSupp]
  · have hq : 2 * (M * (M + 1) / 2) = M * (M + 1) :=
      Nat.two_mul_div_two_of_even (Nat.even_mul_succ_self M)
    have hd : dC N M = N + M * (M + 1) / 2 := rfl
    have hle : nSupp N M ≤ 4 * dC N M * 2 ^ aleph := by
      have h2 : 1 ≤ 2 ^ aleph := Nat.one_le_two_pow
      refine le_trans ?_ (Nat.le_mul_of_pos_right _ h2)
      rw [hd]
      unfold nSupp
      rcases M with _ | k
      · simp at hq ⊢
        omega
      · have : 2 * (k + 1) - 1 = 2 * k + 1 := by omega
        rw [this]
        nlinarith [hq]
    calc sA N M ≤ Nat.clog 2 (4 * dC N M * 2 ^ aleph) := Nat.clog_mono_right 2 hle
      _ ≤ gC N M aleph := le_max_right _ _

/-- Row set and sign of a nonzero pair weight: the sign is determined by the rows. -/
noncomputable def zOf {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (A B : ℕ) : Bool :=
  if hA : A < 2 * N then decide (0 ≤ D.t ⟨A / 2, by omega⟩)
  else if hAB : A < B ∧ B < 2 * (N + M) then
    decide (thc.zeta ⟨A / 2 - N, by omega⟩ ⟨B / 2 - N, by omega⟩ < 0)
  else false

theorem pairW_ne_zero {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    {A B : ℕ} {z : Bool} (h : pairW thc D aleph A B z ≠ 0) :
    ((A < 2 * N ∧ B = rowI N M) ∨ (2 * N ≤ A ∧ A < B ∧ B < 2 * (N + M)) ∨
      (A = rowI N M ∧ B = rowI N M)) ∧ z = zOf thc D A B := by
  unfold pairW at h
  unfold zOf
  by_cases h1 : A < 2 * N
  · rw [dif_pos h1] at h ⊢
    by_cases hc : B = rowI N M ∧ z = decide (0 ≤ D.t ⟨A / 2, by omega⟩)
    · exact ⟨Or.inl ⟨h1, hc.1⟩, hc.2⟩
    · rw [if_neg hc] at h
      exact absurd rfl h
  · rw [dif_neg h1] at h ⊢
    by_cases h2 : A < B ∧ B < 2 * (N + M)
    · rw [dif_pos h2] at h ⊢
      by_cases hc : z = decide (thc.zeta ⟨A / 2 - N, by omega⟩ ⟨B / 2 - N, by omega⟩ < 0)
      · exact ⟨Or.inr (Or.inl ⟨by omega, h2.1, h2.2⟩), hc⟩
      · rw [if_neg hc] at h
        exact absurd rfl h
    · rw [dif_neg h2] at h ⊢
      by_cases hc : A = rowI N M ∧ B = rowI N M ∧ z = false
      · exact ⟨Or.inr (Or.inr ⟨hc.1, hc.2.1⟩), hc.2.2⟩
      · rw [if_neg hc] at h
        exact absurd rfl h

theorem support_flatW {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) :
    (univ.filter fun x ↦ flatW thc D aleph x ≠ 0).card ≤ nSupp N M := by
  classical
  have hrow : rowI N M = 2 * (N + M) := rfl
  let P2 : Finset (ℕ × ℕ) :=
    ((range (2 * M)).sigma fun k ↦ range k).image fun p ↦ (2 * N + p.2, 2 * N + p.1)
  let P : Finset (ℕ × ℕ) :=
    range (2 * N) ×ˢ {rowI N M} ∪ P2 ∪ {(rowI N M, rowI N M)}
  have hP2 : P2.card ≤ M * (2 * M - 1) := by
    refine Finset.card_image_le.trans ?_
    rw [Finset.card_sigma]
    simp only [Finset.card_range]
    rw [Finset.sum_range_id]
    have : 2 * M * (2 * M - 1) = 2 * (M * (2 * M - 1)) := by ring
    rw [this, Nat.mul_div_cancel_left _ (by norm_num)]
  have hPc : P.card ≤ nSupp N M := by
    calc P.card ≤ (range (2 * N) ×ˢ {rowI N M} ∪ P2).card + ({(rowI N M, rowI N M)} :
          Finset (ℕ × ℕ)).card := Finset.card_union_le _ _
      _ ≤ ((range (2 * N) ×ˢ {rowI N M}).card + P2.card) + 1 := by
          have := Finset.card_union_le (range (2 * N) ×ˢ {rowI N M}) P2
          simp only [Finset.card_singleton]
          omega
      _ ≤ nSupp N M := by
          simp only [Finset.card_product, Finset.card_range, Finset.card_singleton, mul_one]
          unfold nSupp
          omega
  refine le_trans (Finset.card_le_card_of_injOn
    (fun x ↦ (((idxA x).val, (idxB x).val) : ℕ × ℕ)) ?_ ?_) hPc
  · intro x hx
    rw [Finset.mem_coe, mem_filter] at hx
    have hc := (pairW_ne_zero thc D aleph hx.2).1
    simp only [P, P2, Finset.mem_coe, mem_union, mem_product, mem_range, mem_singleton, mem_image,
      Finset.mem_sigma, Prod.mk.injEq]
    rcases hc with hc | hc | hc
    · exact Or.inl (Or.inl ⟨hc.1, hc.2⟩)
    · refine Or.inl (Or.inr ⟨⟨(idxB x).val - 2 * N, (idxA x).val - 2 * N⟩, ?_, ?_, ?_⟩)
      · simp only [hrow] at hc ⊢
        refine ⟨by omega, by omega⟩
      · dsimp only
        omega
      · dsimp only
        omega
    · exact Or.inr ⟨hc.1, hc.2⟩
  · intro x hx x' hx' h
    rw [Finset.mem_coe, mem_filter] at hx hx'
    have h1 := (pairW_ne_zero thc D aleph hx.2).2
    have h2 := (pairW_ne_zero thc D aleph hx'.2).2
    simp only [Prod.mk.injEq] at h
    have hA : idxA x = idxA x' := Fin.ext h.1
    have hB : idxB x = idxB x' := Fin.ext h.2
    have hz : idxZ x = idxZ x' := by
      rw [h1, h2, hA, hB]
    rw [← encC_idx x, ← encC_idx x', hA, hB, hz]

/-- Exact alias tables for the pair weights at `s = sA`, `g = gC`. -/
theorem exists_alias_flatW {N M : ℕ} {thc : THCFactorization N M} {aleph beth : ℕ} {lam : ℝ}
    {D : CData N M} (hD : CFacts thc aleph beth lam D) :
    ∃ (ind alt : Fin (2 ^ sA N M) → Fin (2 ^ idxC N M)) (K : Fin (2 ^ sA N M) → ℕ),
      (∀ x, K x < 2 ^ (gC N M aleph - sA N M)) ∧
      ∀ y, (univ.filter fun σ : Fin (2 ^ gC N M aleph) ↦ aliasF ind alt K σ = y).card =
        flatW thc D aleph y :=
  exists_alias (flatW thc D aleph) (sum_flatW hD) (sA_le_gC N M aleph)
    ((support_flatW thc D aleph).trans (nSupp_le_pow_sA N M))

end QC14


/-! Inlined from lane module `THC/BlockCircuit.lean`. -/

namespace QC14
open QuantumComputation QuantumComputation.Specs Matrix Operator Circuit Finset
open PrepareImpl SelectPauliImpl SelectPauliSteps

/-- Index and garbage wires inside the data register. -/
abbrev blkA (N b g : ℕ) : QRegister (b + g) (N + (b + g)) := QRegister.block N (b + g) le_rfl
/-- System and index wires inside the data register. -/
abbrev blkS (N b g : ℕ) : QRegister (N + b) (N + (b + g)) := QRegister.block 0 (N + b) (by omega)
/-- System wires inside the data register. -/
abbrev blkSys (N b g : ℕ) : QRegister N (N + (b + g)) := QRegister.block 0 N (by omega)

/-- The PREPARE baseline's unitary for the fibre function `F`. -/
noncomputable def prepU (b g : ℕ) (F : Fin (2 ^ g) → Fin (2 ^ b)) : Unitary (2 ^ (b + g)) :=
  selectPauliUnitary g b (2 ^ g) (tblOf b g F) * (hPre b g g le_rfl).eval

/-- `U = A† S A`. -/
noncomputable def blockU (N b g : ℕ) (F : Fin (2 ^ g) → Fin (2 ^ b)) {L : ℕ}
    (tbl : SelectPauliTable L N) : Unitary (2 ^ (N + (b + g))) :=
  star ((blkA N b g).embedUnitary (prepU b g F)) *
    (blkS N b g).embedUnitary (selectPauliUnitary b N (2 ^ b) (tblExt b N L tbl)) *
    (blkA N b g).embedUnitary (prepU b g F)


/-! ### Self-adjointness helpers -/

theorem embedUnitary_star' {k m : ℕ} (r : QRegister k m) (U : Unitary (2 ^ k)) :
    r.embedUnitary (star U) = star (r.embedUnitary U) := by
  apply Subtype.ext
  rw [QRegister.embedUnitary_val, Unitary.coe_star, Unitary.coe_star, QRegister.embedUnitary_val,
    Matrix.star_eq_conjTranspose, Matrix.star_eq_conjTranspose, QRegister.embedMatrix_conjTranspose]

theorem star_pauli (p : SelectPauli.Pauli) : star p.unitary = p.unitary := by
  apply Subtype.ext
  rw [Unitary.coe_star, Matrix.star_eq_conjTranspose]
  cases p
  · simp [SelectPauli.Pauli.unitary]
  all_goals
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [SelectPauli.Pauli.unitary, Qubit.X, Qubit.Y, Qubit.Z, Matrix.conjTranspose_apply]

theorem list_prod_selfAdjoint {M : Type*} [Monoid M] [StarMul M] :
    ∀ (l : List M), l.Pairwise Commute → (∀ x ∈ l, IsSelfAdjoint x) → IsSelfAdjoint l.prod
  | [], _, _ => by simp
  | a :: l, hp, hs => by
    rw [List.prod_cons]
    have hl := list_prod_selfAdjoint l (List.pairwise_cons.1 hp).2
      (fun x hx ↦ hs x (List.mem_cons_of_mem _ hx))
    have ha := hs a (by simp)
    have hc : Commute a l.prod :=
      Commute.list_prod_right l a (fun x hx ↦ (List.pairwise_cons.1 hp).1 x hx)
    exact (IsSelfAdjoint.commute_iff ha hl).1 hc

theorem star_selectPauliString {N : ℕ} (row : Fin N → SelectPauli.Pauli) :
    star (selectPauliString row) = selectPauliString row := by
  unfold selectPauliString
  refine (list_prod_selfAdjoint _ ?_ ?_).star_eq
  · rw [List.pairwise_ofFn]
    intro i j hij
    refine Subtype.ext ?_
    exact QRegister.embedMatrix_comm_of_disjoint _ _
      (QRegister.singleton_disjoint (ne_of_lt hij)) _ _
  · intro x hx
    obtain ⟨q, hq⟩ := List.mem_ofFn.1 hx
    subst hq
    show star _ = _
    rw [← embedUnitary_star', star_pauli]

theorem star_selectPauliSign (N : ℕ) (s : Bool) : star (selectPauliSign N s) = selectPauliSign N s := by
  cases s
  · simp [selectPauliSign]
  · apply Subtype.ext
    simp [selectPauliSign, Unitary.coe_star]

theorem selectPauliSign_commute (N : ℕ) (s : Bool) (X : Unitary (2 ^ N)) :
    Commute (selectPauliSign N s) X := by
  cases s
  · simp [selectPauliSign]
  · refine Subtype.ext ?_
    show (selectPauliSign N true).1 * X.1 = X.1 * (selectPauliSign N true).1
    simp [selectPauliSign]

theorem star_selectPauliTerm {N : ℕ} (t : Bool × (Fin N → SelectPauli.Pauli)) :
    star (selectPauliTerm t) = selectPauliTerm t := by
  rw [selectPauliTerm, star_mul, star_selectPauliString, star_selectPauliSign]
  exact (selectPauliSign_commute N t.1 _).eq.symm

theorem star_selectPauliBlock (b N L : ℕ) (tbl : SelectPauliTable L N) (j : Fin (2 ^ b)) :
    star (selectPauliBlock b N L tbl j) = selectPauliBlock b N L tbl j := by
  unfold selectPauliBlock
  split_ifs
  · exact star_selectPauliTerm _
  · exact star_one _

theorem star_selectPauliUnitary (b N L : ℕ) (tbl : SelectPauliTable L N) :
    star (selectPauliUnitary b N L tbl) = selectPauliUnitary b N L tbl := by
  apply Subtype.ext
  rw [Unitary.coe_star, Matrix.star_eq_conjTranspose]
  unfold selectPauliUnitary selectPauliBlockDiagonal
  simp only
  rw [Matrix.conjTranspose_submatrix, blockDiagonal_conjTranspose]
  congr 2
  funext k
  have := congrArg Subtype.val (star_selectPauliBlock b N L tbl k)
  rwa [Unitary.coe_star, Matrix.star_eq_conjTranspose] at this

/-! ### Clean-subspace helpers -/

theorem localIdx_eq_zero_iff {k m : ℕ} (r : QRegister k m) (β : BitAssignment m) :
    localIdx r β = 0 ↔ ∀ i, β (r i) = 0 := by
  constructor
  · intro h i
    exact SelectPauliBridge.bits_zero_of_localIdx_eq_zero r β h i
  · intro h
    have h' : (fun i ↦ β (r i)) = basisBits k 0 := by
      rw [basisBits_zero]; funext i; exact h i
    show (basisBits k).symm (fun i ↦ β (r i)) = 0
    rw [h']
    exact (basisBits k).symm_apply_apply 0

theorem localIdx_slice_zero {k m : ℕ} (r : QRegister k m) (a w : ℕ) (h : a + w ≤ k)
    (β : BitAssignment m) (h0 : localIdx r β = 0) : localIdx (r.slice a w h) β = 0 := by
  rw [localIdx_eq_zero_iff] at h0 ⊢
  intro i
  exact h0 _

theorem clean_ext {m k : ℕ} (rAnc : QRegister k m) (X Y : Matrix (Fin (2 ^ m)) (Fin (2 ^ m)) ℂ)
    (h : ∀ β, localIdx rAnc β = 0 → X.mulVec (ket β) = Y.mulVec (ket β)) :
    X * rAnc.basisOutcomeProjector 0 = Y * rAnc.basisOutcomeProjector 0 := by
  apply matrix_ext_ket
  intro β
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, basisOutcomeProjector_mulVec_ket]
  by_cases h0 : localIdx rAnc β = 0
  · rw [if_pos h0]; exact h β h0
  · rw [if_neg h0, Matrix.mulVec_zero, Matrix.mulVec_zero]

theorem chain_clean {M : Type*} [Semigroup M] {Q C₁ C₂ E₁ E₂ : M}
    (h₁ : C₁ * Q = E₁ * Q) (h₂ : C₂ * Q = E₂ * Q) (hc : E₁ * Q = Q * E₁) :
    C₂ * C₁ * Q = E₂ * E₁ * Q := by
  calc C₂ * C₁ * Q = C₂ * (C₁ * Q) := mul_assoc _ _ _
    _ = C₂ * (Q * E₁) := by rw [h₁, hc]
    _ = (C₂ * Q) * E₁ := (mul_assoc _ _ _).symm
    _ = E₂ * (Q * E₁) := by rw [h₂, mul_assoc]
    _ = E₂ * (E₁ * Q) := by rw [hc]
    _ = E₂ * E₁ * Q := (mul_assoc _ _ _).symm

theorem inv_clean {M : Type*} [Monoid M] {Q C Ci A u : M}
    (h : C * Q = A * Q) (hu : Q * u = u * Q) (hAu : A * u = 1) (hC : Ci * C = 1) :
    Ci * Q = u * Q := by
  have h1 : C * (u * Q) = Q := by
    calc C * (u * Q) = C * (Q * u) := by rw [hu]
      _ = (C * Q) * u := (mul_assoc _ _ _).symm
      _ = A * (Q * u) := by rw [h, mul_assoc]
      _ = A * (u * Q) := by rw [hu]
      _ = (A * u) * Q := (mul_assoc _ _ _).symm
      _ = Q := by rw [hAu, one_mul]
  calc Ci * Q = Ci * (C * (u * Q)) := by rw [h1]
    _ = (Ci * C) * (u * Q) := (mul_assoc _ _ _).symm
    _ = u * Q := by rw [hC, one_mul]

/-- Exact index probabilities of the prepared state. -/
theorem prepU_prob (b g : ℕ) (F : Fin (2 ^ g) → Fin (2 ^ b)) (j : Fin (2 ^ b)) :
    prepareIndexProb b g (fun y ↦ (prepU b g F).1 y 0) j =
      ((univ.filter fun σ ↦ F σ = j).card : ℝ) / 2 ^ g := by
  have h0 : ket (0 : BitAssignment (b + g)) = basisState (0 : Fin (2 ^ (b + g))) := by
    simp only [ket]
    congr 1
    exact (basisBits (b + g)).symm_apply_eq.2 (basisBits_zero _).symm
  have hfs := final_state b g F
  rw [h0, Matrix.mulVec_mulVec] at hfs
  have hfun : (fun y ↦ (prepU b g F).1 y 0) = ((Real.sqrt (1 / 2) : ℂ) ^ g) •
      ∑ σ : Fin (2 ^ g), basisState (selectPauliDataEquiv g b (σ, F σ)) := by
    rw [← hfs]
    funext y
    exact (mulVec_basisState _ _ _).symm
  rw [hfun]
  exact prob_formula b g F j

/-- `U` is Hermitian (every SELECT row is a signed Pauli string). -/
theorem blockU_herm (N b g : ℕ) (F : Fin (2 ^ g) → Fin (2 ^ b)) {L : ℕ}
    (tbl : SelectPauliTable L N) :
    (blockU N b g F tbl).1ᴴ = (blockU N b g F tbl).1 := by
  have hS : star ((blkS N b g).embedUnitary
      (selectPauliUnitary b N (2 ^ b) (tblExt b N L tbl))) =
      (blkS N b g).embedUnitary (selectPauliUnitary b N (2 ^ b) (tblExt b N L tbl)) := by
    rw [← embedUnitary_star', star_selectPauliUnitary]
  have h : star (blockU N b g F tbl) = blockU N b g F tbl := by
    unfold blockU
    rw [star_mul, star_mul, star_star, hS]
    exact (mul_assoc _ _ _).symm
  have := congrArg Subtype.val h
  rwa [Unitary.coe_star, Matrix.star_eq_conjTranspose] at this

/-! ### Top-left block helpers -/

theorem localIdx_congr {k m : ℕ} (r s : QRegister k m) (h : ∀ i, r i = s i)
    (β : BitAssignment m) : localIdx r β = localIdx s β := by
  show (basisBits k).symm (fun i ↦ β (r i)) = (basisBits k).symm (fun i ↦ β (s i))
  simp only [h]

theorem selectPauliTerm_I (N : ℕ) :
    selectPauliTerm (N := N) (false, fun _ ↦ SelectPauli.Pauli.I) = 1 := by
  unfold selectPauliTerm selectPauliString
  simp [selectPauliSign, SelectPauli.Pauli.unitary]

theorem selectPauliBlock_ext (b N L : ℕ) (tbl : SelectPauliTable L N) (j : Fin (2 ^ b)) :
    selectPauliBlock b N (2 ^ b) (tblExt b N L tbl) j = selectPauliBlock b N L tbl j := by
  unfold selectPauliBlock
  by_cases h : j.val < L
  · rw [dif_pos j.2, dif_pos h]; simp [tblExt, h]
  · rw [dif_pos j.2, dif_neg h]; simp only [tblExt, dif_neg h]; exact selectPauliTerm_I N

theorem sel_decomp (N b g : ℕ) (tblE : SelectPauliTable (2 ^ b) N) :
    (blkS N b g).embedMatrix (selectPauliUnitary b N (2 ^ b) tblE).1 =
      ∑ j : Fin (2 ^ b), ((blkS N b g).slice N b (by omega)).basisOutcomeProjector j *
        (blkSys N b g).embedMatrix (selectPauliBlock b N (2 ^ b) tblE j).1 := by
  apply matrix_ext_ket
  intro β
  set ri := (blkS N b g).slice N b (by omega) with hri
  set j₀ : Fin (2 ^ b) := localIdx ri β with hj₀
  set x₀ : Fin (2 ^ N) := localIdx (blkSys N b g) β with hx₀
  have hx₀' : localIdx ((blkS N b g).slice 0 N (by omega)) β = x₀ :=
    localIdx_congr _ _ (fun i ↦ Fin.ext (by simp [QRegister.slice_apply])) β
  have hidx : localIdx (blkS N b g) β = selectPauliDataEquiv b N (j₀, x₀) := by
    apply Fin.ext
    rw [localIdx_val_split (blkS N b g) N b rfl β, selectPauliDataEquiv_val, hx₀']
  have hbj : ∀ i : Fin b, β (ri i) = basisBits b j₀ i := fun i ↦ by
    have h1 : (basisBits b).symm (fun i ↦ β (ri i)) = j₀ := rfl
    exact congrFun ((basisBits b).symm_apply_eq.1 h1) i
  have hdis : (blkSys N b g).DisjointWires ri := by
    rw [QRegister.disjoint_iff]
    intro i j hij
    have := congrArg Fin.val hij
    simp [hri] at this
    omega
  have hnot : ∀ i, ri i ∉ Set.range (blkSys N b g).wires :=
    fun i ⟨i', h⟩ ↦ hdis.ne i' i h
  have hloc : ∀ γ, localIdx ri (writeReg β (blkSys N b g) γ) = j₀ := fun γ ↦ by
    show (basisBits b).symm (fun i ↦ writeReg β (blkSys N b g) γ (ri i)) = _
    have : (fun i ↦ writeReg β (blkSys N b g) γ (ri i)) = fun i ↦ β (ri i) :=
      funext fun i ↦ writeReg_apply_of_not_mem _ _ _ _ (hnot i)
    rw [this]
  have hK : ∀ y : Fin (2 ^ N), writeReg β (blkS N b g)
      (basisBits (N + b) (selectPauliDataEquiv b N (j₀, y))) =
      writeReg β (blkSys N b g) (basisBits N y) := fun y ↦ by
    funext w
    by_cases hw : w ∈ Set.range (blkS N b g).wires
    · obtain ⟨i, rfl⟩ := hw
      have hi' : (blkS N b g).wires i = (blkS N b g) i := rfl
      rw [hi', writeReg_apply_reg, basisBits_dataEquiv]
      by_cases hi : i.val < N
      · rw [dif_pos hi]
        have hs : (blkS N b g) i = (blkSys N b g) ⟨i.val, hi⟩ := Fin.ext (by simp)
        rw [hs, writeReg_apply_reg]
      · rw [dif_neg hi]
        have hs : (blkS N b g) i = ri ⟨i.val - N, by omega⟩ :=
          Fin.ext (by simp [hri, QRegister.slice_apply]; omega)
        rw [hs, writeReg_apply_of_not_mem _ _ _ _ (hnot _), hbj]
    · rw [writeReg_apply_of_not_mem _ _ _ _ hw, writeReg_apply_of_not_mem]
      rintro ⟨i, hi⟩
      exact hw ⟨⟨i.val, by omega⟩, by rw [← hi]; exact Fin.ext (by simp)⟩
  have hblk : selectPauliBlock b N (2 ^ b) tblE j₀ = selectPauliTerm (tblE ⟨j₀.val, j₀.2⟩) :=
    dif_pos j₀.2
  have hent : ∀ (j' : Fin (2 ^ b)) (y : Fin (2 ^ N)),
      (selectPauliUnitary b N (2 ^ b) tblE).1 (selectPauliDataEquiv b N (j', y))
        (selectPauliDataEquiv b N (j₀, x₀)) =
      if j' = j₀ then (selectPauliBlock b N (2 ^ b) tblE j₀).1 y x₀ else 0 := by
    intro j' y
    rw [← mulVec_basisState (selectPauliUnitary b N (2 ^ b) tblE).1
      (selectPauliDataEquiv b N (j₀, x₀)) (selectPauliDataEquiv b N (j', y)),
      selectPauliUnitary_mulVec_basisState b N (2 ^ b) tblE j₀ j₀.2 x₀, hblk]
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, basisState_apply,
      Equiv.apply_eq_iff_eq, Prod.mk.injEq]
    by_cases hj : j' = j₀
    · subst hj; simp
    · simp [hj]
  have hS : ((blkS N b g).embedMatrix (selectPauliUnitary b N (2 ^ b) tblE).1).mulVec (ket β) =
      ∑ y : Fin (2 ^ N), (selectPauliBlock b N (2 ^ b) tblE j₀).1 y x₀ •
        ket (writeReg β (blkSys N b g) (basisBits N y)) := by
    rw [embedMatrix_mulVec_ket, hidx, ← (selectPauliDataEquiv b N).sum_comp,
      Fintype.sum_prod_type]
    simp only [hent, ite_smul, zero_smul]
    rw [Finset.sum_eq_single j₀ (fun j' _ hj' ↦ by simp [hj']) (by simp)]
    simp only [if_true]
    exact Finset.sum_congr rfl fun y _ ↦ by rw [hK y]
  have hT : ∀ j' : Fin (2 ^ b),
      ((blkSys N b g).embedMatrix (selectPauliBlock b N (2 ^ b) tblE j').1).mulVec (ket β) =
      ∑ y, (selectPauliBlock b N (2 ^ b) tblE j').1 y x₀ •
        ket (writeReg β (blkSys N b g) (basisBits N y)) :=
    fun j' ↦ embedMatrix_mulVec_ket _ _ _
  rw [hS, Matrix.sum_mulVec]
  simp only [← Matrix.mulVec_mulVec, hT, Matrix.mulVec_sum, Matrix.mulVec_smul,
    basisOutcomeProjector_mulVec_ket, hloc]
  rw [Finset.sum_eq_single j₀ (fun j' _ hj' ↦ by simp [Ne.symm hj']) (by simp)]
  simp

theorem idx_diag (N b g : ℕ) (j : Fin (2 ^ b)) :
    ((blkS N b g).slice N b (by omega)).basisOutcomeProjector j =
      (blkA N b g).embedMatrix (Matrix.diagonal fun y : Fin (2 ^ (b + g)) ↦
        if y.val % 2 ^ b = j.val then (1 : ℂ) else 0) := by
  rw [QRegister.basisOutcomeProjector_eq_diagonal, QRegister.embedMatrix_diagonal]
  congr 1
  funext glob
  obtain ⟨β, rfl⟩ := (basisBits (N + (b + g))).symm.surjective glob
  have hext : ∀ {k : ℕ} (r : QRegister k (N + (b + g))),
      r.extractIndex ((basisBits (N + (b + g))).symm β) = localIdx r β := fun r ↦ by
    simp [QRegister.extractIndex]
  have h1 : localIdx ((blkS N b g).slice N b (by omega)) β =
      localIdx ((blkA N b g).slice 0 b (by omega)) β :=
    localIdx_congr _ _ (fun i ↦ Fin.ext (by simp)) β
  have h2 := localIdx_val_split (blkA N b g) b g rfl β
  have h3 : ((localIdx (blkA N b g) β : Fin _) : ℕ) % 2 ^ b =
      (localIdx ((blkA N b g).slice 0 b (by omega)) β : ℕ) := by
    rw [h2, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (localIdx _ β).2]
  simp only [hext, h1, h3, Fin.ext_iff]

theorem prep_prob_block (b g : ℕ) (F : Fin (2 ^ g) → Fin (2 ^ b)) (j : Fin (2 ^ b)) :
    compProj (0 : Fin (2 ^ (b + g))) * (prepU b g F).1ᴴ *
        Matrix.diagonal (fun y : Fin (2 ^ (b + g)) ↦
          if y.val % 2 ^ b = j.val then (1 : ℂ) else 0) * (prepU b g F).1 * compProj 0 =
      ((prepareIndexProb b g (fun y ↦ (prepU b g F).1 y 0) j : ℝ) : ℂ) • compProj 0 := by
  set u := (prepU b g F).1 with hu
  set D : Matrix (Fin (2 ^ (b + g))) (Fin (2 ^ (b + g))) ℂ := Matrix.diagonal (fun y : Fin (2 ^ (b + g)) ↦
          if y.val % 2 ^ b = j.val then (1 : ℂ) else 0) with hD
  have hmod : ∀ (j' : Fin (2 ^ b)) (x : Fin (2 ^ g)),
      ((prepareDataEquiv b g (j', x)).val % 2 ^ b = j.val) ↔ j' = j := by
    intro j' x
    rw [prepareDataEquiv_val, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt j'.2, Fin.ext_iff]
  have hX : (uᴴ * (D * u)) 0 0 =
      ((prepareIndexProb b g (fun y ↦ u y 0) j : ℝ) : ℂ) := by
    rw [Matrix.mul_apply]
    simp only [hD, Matrix.diagonal_mul, Matrix.conjTranspose_apply]
    unfold prepareIndexProb
    push_cast
    rw [← (prepareDataEquiv b g).sum_comp, Fintype.sum_prod_type]
    simp only [hmod]
    rw [Finset.sum_eq_single j (fun j' _ hj' ↦ by simp [hj']) (by simp)]
    refine Finset.sum_congr rfl fun x _ ↦ ?_
    simp [Complex.conj_mul']
  have e : compProj (0 : Fin (2 ^ (b + g))) * uᴴ * D * u * compProj 0 =
      compProj 0 * (uᴴ * (D * u)) * compProj 0 := by simp only [Matrix.mul_assoc]
  rw [e]
  unfold compProj
  rw [Matrix.single_mul_mul_single, hX, Matrix.smul_single]
  simp

/-- Top-left block of `U`. -/
theorem blockU_block (N b g : ℕ) (F : Fin (2 ^ g) → Fin (2 ^ b)) {L : ℕ}
    (tbl : SelectPauliTable L N) (hLb : L ≤ 2 ^ b) :
    (blkA N b g).basisOutcomeProjector 0 * (blockU N b g F tbl).1 *
        (blkA N b g).basisOutcomeProjector 0 =
      (blkA N b g).basisOutcomeProjector 0 *
        (blkSys N b g).embedMatrix (∑ j : Fin (2 ^ b),
          ((prepareIndexProb b g (fun y ↦ (prepU b g F).1 y 0) j : ℝ) : ℂ) •
            (selectPauliBlock b N L tbl j).1) *
        (blkA N b g).basisOutcomeProjector 0 := by
  set P := (blkA N b g).basisOutcomeProjector 0 with hP
  set A := (blkA N b g).embedMatrix (prepU b g F).1 with hA
  set T : Fin (2 ^ b) → Matrix (Fin (2 ^ (N + (b + g)))) (Fin (2 ^ (N + (b + g)))) ℂ :=
    fun j ↦ (blkSys N b g).embedMatrix (selectPauliBlock b N (2 ^ b) (tblExt b N L tbl) j).1
    with hT
  set D : Fin (2 ^ b) → Matrix (Fin (2 ^ (N + (b + g)))) (Fin (2 ^ (N + (b + g)))) ℂ :=
    fun j ↦ (blkA N b g).embedMatrix (Matrix.diagonal fun y : Fin (2 ^ (b + g)) ↦
      if y.val % 2 ^ b = j.val then (1 : ℂ) else 0) with hD
  set p : Fin (2 ^ b) → ℂ :=
    fun j ↦ ((prepareIndexProb b g (fun y ↦ (prepU b g F).1 y 0) j : ℝ) : ℂ) with hp
  have hdSA : (blkSys N b g).DisjointWires (blkA N b g) := by
    rw [QRegister.disjoint_iff]
    intro i j h
    have := congrArg Fin.val h
    simp at this
    omega
  have hTA : ∀ j, T j * A = A * T j := fun j ↦
    QRegister.embedMatrix_comm_of_disjoint _ _ hdSA _ _
  have hTP : ∀ j, T j * P = P * T j := fun j ↦
    QRegister.embedMatrix_comm_of_disjoint _ _ hdSA _ _
  have hPP : P * P = P := QRegister.basisOutcomeProjector_mul_self _ 0
  have hUv : (blockU N b g F tbl).1 = Aᴴ * (∑ j, D j * T j) * A := by
    have hsel := sel_decomp N b g (tblExt b N L tbl)
    simp only [idx_diag] at hsel
    unfold blockU
    show (star ((blkA N b g).embedUnitary (prepU b g F))).1 *
      ((blkS N b g).embedUnitary (selectPauliUnitary b N (2 ^ b) (tblExt b N L tbl))).1 *
      ((blkA N b g).embedUnitary (prepU b g F)).1 = _
    rw [Unitary.coe_star, Matrix.star_eq_conjTranspose, QRegister.embedUnitary_val,
      QRegister.embedUnitary_val (blkS N b g), hsel]
  have hcore : ∀ j, P * Aᴴ * D j * A * P = p j • P := by
    intro j
    calc P * Aᴴ * D j * A * P
        = (blkA N b g).embedMatrix (compProj (0 : Fin (2 ^ (b + g))) * (prepU b g F).1ᴴ *
          Matrix.diagonal (fun y : Fin (2 ^ (b + g)) ↦
            if y.val % 2 ^ b = j.val then (1 : ℂ) else 0) * (prepU b g F).1 * compProj 0) := by
          simp only [QRegister.embedMatrix_mul, QRegister.embedMatrix_conjTranspose]; rfl
      _ = p j • P := by rw [prep_prob_block, QRegister.embedMatrix_smul]; rfl
  have key : ∀ j, P * (Aᴴ * (D j * T j) * A) * P = p j • (P * T j) := by
    intro j
    calc P * (Aᴴ * (D j * T j) * A) * P
        = P * Aᴴ * D j * (T j * A) * P := by simp only [Matrix.mul_assoc]
      _ = P * Aᴴ * D j * (A * T j) * P := by rw [hTA j]
      _ = (P * Aᴴ * D j * A) * (T j * P) := by simp only [Matrix.mul_assoc]
      _ = (P * Aᴴ * D j * A) * (P * T j) := by rw [hTP j]
      _ = (P * Aᴴ * D j * A * P) * T j := by simp only [Matrix.mul_assoc]
      _ = p j • (P * T j) := by rw [hcore j, Matrix.smul_mul]
  have hsum_eq : (∑ j : Fin (2 ^ b), ((prepareIndexProb b g (fun y ↦ (prepU b g F).1 y 0) j : ℝ) : ℂ) •
      (selectPauliBlock b N L tbl j).1) =
      ∑ j : Fin (2 ^ b), p j • (selectPauliBlock b N (2 ^ b) (tblExt b N L tbl) j).1 :=
    Finset.sum_congr rfl fun j _ ↦ by rw [selectPauliBlock_ext]
  have hrhs : P * (blkSys N b g).embedMatrix (∑ j : Fin (2 ^ b),
      p j • (selectPauliBlock b N (2 ^ b) (tblExt b N L tbl) j).1) * P =
      ∑ j, p j • (P * T j) := by
    simp only [QRegister.embedMatrix_sum, QRegister.embedMatrix_smul, Finset.mul_sum,
      Finset.sum_mul, Matrix.mul_smul, Matrix.smul_mul]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    show p j • (P * T j * P) = p j • (P * T j)
    rw [Matrix.mul_assoc, hTP j, ← Matrix.mul_assoc, hPP]
  rw [hsum_eq, hrhs, hUv]
  simp only [Finset.mul_sum, Finset.sum_mul, key]

variable {n : ℕ}

/-- PREPARE stage on the index and garbage wires. -/
def prepC {N b g : ℕ} (F : Fin (2 ^ g) → Fin (2 ^ b)) (rData : QRegister (N + (b + g)) n)
    (rAnc : QRegister (b + g + 1) n) (hd : ∀ i j, rData i ≠ rAnc j) : Circuit n :=
  Circuit.seq ((hPre b g g le_rfl).onRegister (rData.slice N (b + g) le_rfl))
    ((mkWires (b := g) (N := b) (rData.slice N (b + g) le_rfl)
      (rAnc.slice 0 (g + 1) (by omega)) (fun i j ↦ hd _ _)).full (tblOf b g F))

/-- SELECT stage on the system and index wires. -/
def selC {N b g L : ℕ} (tbl : SelectPauliTable L N) (rData : QRegister (N + (b + g)) n)
    (rAnc : QRegister (b + g + 1) n) (hd : ∀ i j, rData i ≠ rAnc j) : Circuit n :=
  (mkWires (b := b) (N := N) (rData.slice 0 (N + b) (by omega))
    (rAnc.slice 0 (b + 1) (by omega)) (fun i j ↦ hd _ _)).full tbl

/-- `PREPARE; SELECT; PREPARE†`. -/
def blockC {N b g L : ℕ} (F : Fin (2 ^ g) → Fin (2 ^ b)) (tbl : SelectPauliTable L N)
    (rData : QRegister (N + (b + g)) n) (rAnc : QRegister (b + g + 1) n)
    (hd : ∀ i j, rData i ≠ rAnc j) : Circuit n :=
  Circuit.seq (prepC F rData rAnc hd)
    (Circuit.seq (selC tbl rData rAnc hd) (prepC F rData rAnc hd).inverse)

/-- Exact action on clean scratch. -/
theorem blockC_CE {N b g L : ℕ} (hLb : L ≤ 2 ^ b) (F : Fin (2 ^ g) → Fin (2 ^ b))
    (tbl : SelectPauliTable L N) (rData : QRegister (N + (b + g)) n)
    (rAnc : QRegister (b + g + 1) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    (blockC F tbl rData rAnc hd).eval.1 * rAnc.basisOutcomeProjector 0 =
      (rData.embedUnitary (blockU N b g F tbl)).1 * rAnc.basisOutcomeProjector 0 := by
  have hdD : rData.DisjointWires rAnc := QRegister.disjoint_iff.2 hd
  set Q := rAnc.basisOutcomeProjector 0 with hQ
  set A' : Unitary (2 ^ n) := rData.embedUnitary ((blkA N b g).embedUnitary (prepU b g F)) with hA'
  set S' : Unitary (2 ^ n) := rData.embedUnitary ((blkS N b g).embedUnitary
    (selectPauliUnitary b N (2 ^ b) (tblExt b N L tbl))) with hS'
  have hCQ : (prepC F rData rAnc hd).eval.1 * Q = A'.1 * Q := by
    apply clean_ext
    intro β h0
    have h0' := localIdx_slice_zero rAnc 0 (g + 1) (by omega) β h0
    have hdP : (rData.slice N (b + g) le_rfl).DisjointWires (rAnc.slice 0 (g + 1) (by omega)) :=
      QRegister.disjoint_iff.2 (fun i j ↦ hd _ _)
    have hE : A' = (rData.slice N (b + g) le_rfl).embedUnitary
          (selectPauliUnitary g b (2 ^ g) (tblOf b g F)) *
        (rData.slice N (b + g) le_rfl).embedUnitary (hPre b g g le_rfl).eval := by
      rw [hA', ← QRegister.embedUnitary_compose, prepU, QRegister.embedUnitary_mul]
    rw [hE]
    unfold prepC
    rw [Circuit.eval_seq, Circuit.eval_onRegister, mulVec_mul_unitary, mulVec_mul_unitary]
    exact clean_key b g (tblOf b g F) (rData.slice N (b + g) le_rfl)
      (rAnc.slice 0 (g + 1) (by omega)) hdP _ β h0'
  have hSQ : (selC tbl rData rAnc hd).eval.1 * Q = S'.1 * Q := by
    apply clean_ext
    intro β h0
    have h0' := localIdx_slice_zero rAnc 0 (b + 1) (by omega) β h0
    have hdS : (rData.slice 0 (N + b) (by omega)).DisjointWires (rAnc.slice 0 (b + 1) (by omega)) :=
      QRegister.disjoint_iff.2 (fun i j ↦ hd _ _)
    have hE : S' = (rData.slice 0 (N + b) (by omega)).embedUnitary
        (selectPauliUnitary b N (2 ^ b) (tblExt b N L tbl)) := by
      rw [hS', ← QRegister.embedUnitary_compose]
    rw [hE]
    exact hkey_main hLb tbl (rData.slice 0 (N + b) (by omega)) (rAnc.slice 0 (b + 1) (by omega))
      hdS β h0'
  have hcA : A'.1 * Q = Q * A'.1 := (CleanSubroutineBridge.embed_comm_proj rData rAnc hdD _).symm
  have hcS : S'.1 * Q = Q * S'.1 := (CleanSubroutineBridge.embed_comm_proj rData rAnc hdD _).symm
  have hcAi : (star A').1 * Q = Q * (star A').1 := by
    rw [hA', ← embedUnitary_star']
    exact (CleanSubroutineBridge.embed_comm_proj rData rAnc hdD _).symm
  have hCi : (prepC F rData rAnc hd).inverse.eval.1 * (prepC F rData rAnc hd).eval.1 = 1 := by
    rw [Circuit.eval_inverse]
    exact congrArg Subtype.val (inv_mul_cancel (prepC F rData rAnc hd).eval)
  have hAu : A'.1 * (star A').1 = 1 := by
    have : A' * star A' = 1 := by rw [Unitary.star_eq_inv, mul_inv_cancel A']
    exact congrArg Subtype.val this
  have hInv : (prepC F rData rAnc hd).inverse.eval.1 * Q = (star A').1 * Q :=
    inv_clean hCQ hcAi.symm hAu hCi
  have hc2 : S'.1 * A'.1 * Q = Q * (S'.1 * A'.1) := by
    calc S'.1 * A'.1 * Q = S'.1 * (A'.1 * Q) := mul_assoc _ _ _
      _ = S'.1 * (Q * A'.1) := by rw [hcA]
      _ = (S'.1 * Q) * A'.1 := (mul_assoc _ _ _).symm
      _ = (Q * S'.1) * A'.1 := by rw [hcS]
      _ = Q * (S'.1 * A'.1) := mul_assoc _ _ _
  have step1 := chain_clean hCQ hSQ hcA
  have step2 := chain_clean step1 hInv hc2
  have key : (prepC F rData rAnc hd).inverse.eval.1 * (selC tbl rData rAnc hd).eval.1 *
      (prepC F rData rAnc hd).eval.1 * Q = (star A').1 * S'.1 * A'.1 * Q := by
    simpa only [mul_assoc] using step2
  have hEU : rData.embedUnitary (blockU N b g F tbl) = star A' * S' * A' := by
    unfold blockU
    rw [QRegister.embedUnitary_mul, QRegister.embedUnitary_mul, embedUnitary_star']
  rw [hEU]
  unfold blockC
  rw [Circuit.eval_seq, Circuit.eval_seq]
  exact key

/-- Gate counts: two PREPAREs and one SELECT. -/
theorem blockC_count {N b g L : ℕ} (F : Fin (2 ^ g) → Fin (2 ^ b))
    (tbl : SelectPauliTable L N) (rData : QRegister (N + (b + g)) n)
    (rAnc : QRegister (b + g + 1) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    (blockC F tbl rData rAnc hd).count PrimitiveGate.TOFF = 0 ∧
      (blockC F tbl rData rAnc hd).count PrimitiveGate.T ≤ 2 * (8 * g * 2 ^ g) + 8 * b * L := by
  have hp : (prepC F rData rAnc hd).count PrimitiveGate.TOFF = 0 ∧
      (prepC F rData rAnc hd).count PrimitiveGate.T ≤ 8 * g * 2 ^ g :=
    count_prog b g (tblOf b g F) (rData.slice N (b + g) le_rfl)
      (rAnc.slice 0 (g + 1) (by omega)) (fun i j ↦ hd _ _)
  have hs : (selC tbl rData rAnc hd).count PrimitiveGate.T ≤ 8 * b * L ∧
      (selC tbl rData rAnc hd).count PrimitiveGate.TOFF = 0 :=
    Wires.count_full _ tbl
  have hiT : ∀ c : Circuit n, c.inverse.count PrimitiveGate.T = c.count PrimitiveGate.T :=
    fun c ↦ Circuit.count_inverse_of_ne _ (by simp) (by simp) c
  have hiO : ∀ c : Circuit n, c.inverse.count PrimitiveGate.TOFF = c.count PrimitiveGate.TOFF :=
    fun c ↦ Circuit.count_inverse_of_ne _ (by simp) (by simp) c
  simp only [blockC, Circuit.count_seq, hiT, hiO]
  omega

end QC14


