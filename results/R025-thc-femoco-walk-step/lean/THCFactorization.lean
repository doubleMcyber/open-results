/-- A scratch register whose wires are all wires of a larger one: `CatKet` transfers. -/
theorem pqCatKet_sub {Var : Type} [DecidableEq Var] {k m m' b : ℕ}
    {rT : QRegister k n} {rS : QRegister m n} {rS' : QRegister m' n} {rCat : QRegister b n}
    {hsc : rS.DisjointWires rCat} {hsc' : rS'.DisjointWires rCat} {P : QProg Var (2 ^ n)}
    {U : Unitary (2 ^ k)} (hw : ∀ i, ∃ j, rS i = rS' j)
    (h : CatKet rT rS rCat hsc P U) : CatKet rT rS' rCat hsc' P U := by
  refine catKet_mono_scratch (fun β h0 ↦ ?_) h
  have hz := eq_zero_of_localIdx_eq_zero _ β h0
  apply localIdx_eq_zero_of_forall
  intro i
  induction i using Fin.addCases with
  | left a =>
      rw [QRegister.concat_apply_left]
      obtain ⟨j, hj⟩ := hw a
      rw [hj]
      have := hz (Fin.castAdd b j)
      rwa [QRegister.concat_apply_left] at this
  | right c =>
      rw [QRegister.concat_apply_right]
      have := hz (Fin.natAdd m' c)
      rwa [QRegister.concat_apply_right] at this

/-- Disjointness transfers to a register whose wires are wires of the first. -/
theorem pqDisj_sub {k m m' : ℕ} {rS : QRegister m n} {rS' : QRegister m' n} {X : QRegister k n}
    (hw : ∀ i, ∃ j, rS i = rS' j) (h : rS'.DisjointWires X) : rS.DisjointWires X := by
  rw [QRegister.disjoint_iff] at h ⊢
  intro i j
  obtain ⟨i', hi'⟩ := hw i
  rw [hi']
  exact h i' j

theorem pqConcat_wires {a b c : ℕ} {r : QRegister a n} {s : QRegister b n} {t : QRegister c n}
    {h : r.DisjointWires s} (hr : ∀ i, ∃ j, r i = t j) (hs : ∀ i, ∃ j, s i = t j) :
    ∀ i, ∃ j, r.concat s h i = t j := by
  intro i
  induction i using Fin.addCases with
  | left x => rw [QRegister.concat_apply_left]; exact hr x
  | right x => rw [QRegister.concat_apply_right]; exact hs x

theorem pqSlice_wires {k : ℕ} (r : QRegister k n) (o w : ℕ) (h : o + w ≤ k) :
    ∀ i, ∃ j, r.slice o w h i = r j :=
  fun i ↦ ⟨_, QRegister.slice_apply r o w h i⟩

/-- `1 ≤ bIC` for `N ≠ 0`. -/
theorem pqBIC_pos {N M : ℕ} (hN : N ≠ 0) : 1 ≤ bIC N M := by
  have h := rows_le_bIC N M
  by_contra h0
  have h1 : bIC N M = 0 := by omega
  rw [h1] at h
  simp at h
  omega

/-! ## The pair SELECT -/

/-- `selectQ` on system ++ `A`, `SWAP(A, B) X_o`, `selectQ`, `Z_z`. -/
noncomputable def pairSelProgramQ {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ} (D : CData N M)
    (hbI : 1 ≤ bIC N M) (rSI : QRegister (2 * N + bP N M) n)
    (rS : QRegister (selQScr N (bIC N M) beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rSI.DisjointWires (rS.concat rCat hsc)) :
    DynamicCircuit Var n :=
  .seq (selectQ v beth hbI (kAll D) (fun _ ↦ false) (rSI.compose (regSA N M)) rS rCat hsc
      (hdisj.compose_left _))
    (.seq (.circuit ((swapXLoc N M).onRegister (rSI.compose (idxReg N (bP N M)))))
      (.seq (selectQ v beth hbI (kAll D) (fun _ ↦ false) (rSI.compose (regSA N M)) rS rCat hsc
          (hdisj.compose_left _))
        (.circuit ((zLoc N M).onRegister (rSI.compose (idxReg N (bP N M)))))))

theorem pairSelQ_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    (hb : 2 ≤ beth) {N M : ℕ} [NeZero N] (D : CData N M) (hbI : 1 ≤ bIC N M)
    (rSI : QRegister (2 * N + bP N M) n) (rS : QRegister (selQScr N (bIC N M) beth) n)
    (rCat : QRegister beth n) (hsc : rS.DisjointWires rCat)
    (hdisj : rSI.DisjointWires (rS.concat rCat hsc)) :
    ∃ S : Unitary (2 ^ (2 * N + bP N M)),
      S.1 = pairSelOp D beth ∧
      CatKet rSI rS rCat hsc (pairSelProgramQ v beth D hbI rSI rS rCat hsc hdisj).compile S := by
  have h2L : 2 * (N + M) ≤ 2 ^ bIC N M := by have := rows_le_bIC N M; omega
  obtain ⟨U, hUval, hSel⟩ := selectQ_catKet v beth hb hbI (kAll D) (fun _ ↦ false) h2L
    (rSI.compose (regSA N M)) rS rCat hsc (hdisj.compose_left _)
  have hS1 := CatKet.compose (outer := rSI) (regSA N M) hSel
  have hX := CatKet.compose (outer := rSI) (idxReg N (bP N M))
    (CatKet.circuit (Var := Var) (rSI.compose (idxReg N (bP N M))) rS rCat hsc (swapXLoc N M))
  have hZ := CatKet.compose (outer := rSI) (idxReg N (bP N M))
    (CatKet.circuit (Var := Var) (rSI.compose (idxReg N (bP N M))) rS rCat hsc (zLoc N M))
  have h := CatKet.seq hdisj hS1 (CatKet.seq hdisj hX (CatKet.seq hdisj hS1 hZ))
  refine ⟨(idxReg N (bP N M)).embedUnitary (zLoc N M).eval * (regSA N M).embedUnitary U *
    (idxReg N (bP N M)).embedUnitary (swapXLoc N M).eval * (regSA N M).embedUnitary U, ?_, ?_⟩
  · rw [pairSelOp_factor]
    change ((idxReg N (bP N M)).embedUnitary (zLoc N M).eval).1 *
      ((regSA N M).embedUnitary U).1 * ((idxReg N (bP N M)).embedUnitary (swapXLoc N M).eval).1 *
      ((regSA N M).embedUnitary U).1 = _
    simp only [QRegister.embedUnitary_val]
    rw [swapXLoc_eval, zLoc_eval, hUval]
    simp only [selA]
  · simp only [pairSelProgramQ, DynamicCircuit.compile_seq, DynamicCircuit.compile_circuit]
    exact h

/-- Copies of the private counts in `PairProgram`. -/
theorem pqSwapLoc_count (N M : ℕ) (m : ℕ) (h : m ≤ bIC N M) :
    (swapLoc N M m h).count PrimitiveGate.TOFF = 0 ∧ (swapLoc N M m h).count PrimitiveGate.T = 0 := by
  induction m with
  | zero => simp [swapLoc]
  | succ m ih =>
    obtain ⟨h1, h2⟩ := ih (by omega)
    simp [swapLoc, h1, h2]

theorem pqSwapXLoc_count (N M : ℕ) :
    (swapXLoc N M).count PrimitiveGate.TOFF = 0 ∧ (swapXLoc N M).count PrimitiveGate.T = 0 := by
  obtain ⟨h1, h2⟩ := pqSwapLoc_count N M (bIC N M) le_rfl
  simp [swapXLoc, h1, h2]

theorem pqZLoc_count (N M : ℕ) :
    (zLoc N M).count PrimitiveGate.TOFF = 0 ∧ (zLoc N M).count PrimitiveGate.T = 0 := by
  simp [zLoc]

/-- Per pair SELECT: `2 (16 (N − 1)(beth − 1) + 16 N + 8 · 2^bIC)` (P4.2 signed kicks). -/
abbrev selTQ (N M beth : ℕ) : ℕ := 2 * (16 * (N - 1) * (beth - 1) + 16 * N + 8 * 2 ^ bIC N M)

theorem pairSelQ_count {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ} [NeZero N] (D : CData N M)
    (hbI : 1 ≤ bIC N M) (rSI : QRegister (2 * N + bP N M) n)
    (rS : QRegister (selQScr N (bIC N M) beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rSI.DisjointWires (rS.concat rCat hsc)) :
    (pairSelProgramQ v beth D hbI rSI rS rCat hsc hdisj).count PrimitiveGate.TOFF = 0 ∧
      (pairSelProgramQ v beth D hbI rSI rS rCat hsc hdisj).count PrimitiveGate.T ≤
        selTQ N M beth := by
  have hs := selectQ_count v beth hbI (kAll D) (fun _ ↦ false) (rSI.compose (regSA N M)) rS rCat
    hsc (hdisj.compose_left _)
  obtain ⟨hx1, hx2⟩ := pqSwapXLoc_count N M
  obtain ⟨hz1, hz2⟩ := pqZLoc_count N M
  simp only [pairSelProgramQ, DynamicCircuit.count, Circuit.count_onRegister, selTQ]
  omega

/-! ## The whole program -/

/-- Scratch: the PREPARE chain, then the SELECT scratch. -/
abbrev scratchQ (N M aleph beth : ℕ) : ℕ := ancP N M aleph + selQScr N (bIC N M) beth

theorem pqAnc_le (N M aleph beth : ℕ) : 0 + ancP N M aleph ≤ scratchQ N M aleph beth := by
  unfold scratchQ; omega

/-- Disjointness facts of the SELECT call, from those of the whole program. -/
theorem pqSel_disj {N M aleph beth : ℕ}
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchQ N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc)) :
    ∃ hsc' : (rS.slice (ancP N M aleph) (selQScr N (bIC N M) beth) le_rfl).DisjointWires rCat,
      (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph))).DisjointWires
        ((rS.slice (ancP N M aleph) (selQScr N (bIC N M) beth) le_rfl).concat rCat hsc') := by
  refine ⟨pqDisj_sub (pqSlice_wires rS _ _ _) hsc, ?_⟩
  apply QRegister.DisjointWires.compose_left
  have hr : ∀ i, ∃ j, rS.slice (ancP N M aleph) (selQScr N (bIC N M) beth) le_rfl i =
      (rS.concat rCat hsc) j :=
    fun i ↦ ⟨Fin.castAdd beth ⟨ancP N M aleph + i.val, by unfold scratchQ; omega⟩,
      by rw [QRegister.concat_apply_left]; rfl⟩
  have hs : ∀ i, ∃ j, rCat i = (rS.concat rCat hsc) j :=
    fun i ↦ ⟨Fin.natAdd (scratchQ N M aleph beth) i, by rw [QRegister.concat_apply_right]⟩
  exact QRegister.disjoint_comm.mp
    (pqDisj_sub (pqConcat_wires hr hs) (QRegister.disjoint_comm.mp hdisj))

/-- `PREPARE; SELECT; PREPARE†` with the lookup SELECT. -/
noncomputable def pairProgramQ {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ}
    (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) (hbI : 1 ≤ bIC N M)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchQ N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc)) :
    DynamicCircuit Var n :=
  have hd : ∀ i j, rData i ≠ rS.slice 0 (ancP N M aleph) (pqAnc_le N M aleph beth) j :=
    fun i _ ↦ QRegister.disjoint_iff.1 (disjoint_cat rData rS rCat hsc hdisj).2 i _
  .seq (.circuit (pairPrepA thc D aleph rData _ hd))
    (.seq (pairSelProgramQ v beth D hbI (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
        (rS.slice (ancP N M aleph) (selQScr N (bIC N M) beth) le_rfl) rCat
        (pqSel_disj rData rS rCat hsc hdisj).1 (pqSel_disj rData rS rCat hsc hdisj).2)
      (.circuit (pairPrepA thc D aleph rData _ hd).inverse))

theorem pair_catKetQ {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    (hb : 2 ≤ beth) {N M : ℕ} [NeZero N] (thc : THCFactorization N M) (D : CData N M)
    (aleph : ℕ) (hbI : 1 ≤ bIC N M) (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchQ N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc)) :
    ∃ S : Unitary (2 ^ (2 * N + bP N M)),
      S.1 = pairSelOp D beth ∧
      CatKet rData rS rCat hsc
        (pairProgramQ v beth thc D aleph hbI rData rS rCat hsc hdisj).compile
        (lcuQ N (bP N M) (gP N M aleph) (pairPrepU thc D aleph) S) := by
  have hd : ∀ i j, rData i ≠ rS.slice 0 (ancP N M aleph) (pqAnc_le N M aleph beth) j :=
    fun i _ ↦ QRegister.disjoint_iff.1 (disjoint_cat rData rS rCat hsc hdisj).2 i _
  obtain ⟨hsc', hdisj'⟩ := pqSel_disj rData rS rCat hsc hdisj
  obtain ⟨S, hSval, hSel⟩ := pairSelQ_catKet v beth hb D hbI
    (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
    (rS.slice (ancP N M aleph) (selQScr N (bIC N M) beth) le_rfl) rCat hsc' hdisj'
  have hSel2 := CatKet.compose (blkS (2 * N) (bP N M) (gP N M aleph)) hSel
  have hSel3 : CatKet rData rS rCat hsc _ _ := pqCatKet_sub (pqSlice_wires rS _ _ _) hSel2
  have hz : ∀ β, localIdx rS β = 0 →
      localIdx (rS.slice 0 (ancP N M aleph) (pqAnc_le N M aleph beth)) β = 0 := by
    intro β h0
    apply localIdx_eq_zero_of_forall
    intro i
    rw [QRegister.slice_apply]
    exact eq_zero_of_localIdx_eq_zero _ β h0 _
  have hPrep := catKet_circuit_ket (Var := Var) rData rS rCat hsc
    (pairPrepA thc D aleph rData _ hd)
    ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (pairPrepU thc D aleph))
    (fun β h0 ↦ pairPrepA_ket thc D aleph rData _ hd β (hz β h0))
  have hInvK := catKet_circuit_ket (Var := Var) rData rS rCat hsc
    (pairPrepA thc D aleph rData _ hd).inverse
    (star ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (pairPrepU thc D aleph)))
    (fun β h0 ↦ pairPrepAinv_ket thc D aleph rData _ hd β (hz β h0))
  refine ⟨S, hSval, ?_⟩
  unfold lcuQ
  simp only [pairProgramQ, DynamicCircuit.compile_seq]
  exact CatKet.seq hdisj hPrep (CatKet.seq hdisj hSel3 hInvK)

theorem pair_countQ {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ} [NeZero N]
    (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) (hbI : 1 ≤ bIC N M)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchQ N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc)) :
    (pairProgramQ v beth thc D aleph hbI rData rS rCat hsc hdisj).count PrimitiveGate.TOFF = 0 ∧
      (pairProgramQ v beth thc D aleph hbI rData rS rCat hsc hdisj).count PrimitiveGate.T ≤
        2 * prepTA N M aleph + selTQ N M beth := by
  have hd : ∀ i j, rData i ≠ rS.slice 0 (ancP N M aleph) (pqAnc_le N M aleph beth) j :=
    fun i _ ↦ QRegister.disjoint_iff.1 (disjoint_cat rData rS rCat hsc hdisj).2 i _
  have hp := pairPrepA_count thc D aleph rData _ hd
  have hs := pairSelQ_count v beth D hbI (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
    (rS.slice (ancP N M aleph) (selQScr N (bIC N M) beth) le_rfl) rCat
    (pqSel_disj rData rS rCat hsc hdisj).1 (pqSel_disj rData rS rCat hsc hdisj).2
  have hiT : ∀ c : Circuit n, c.inverse.count PrimitiveGate.T = c.count PrimitiveGate.T :=
    fun c ↦ Circuit.count_inverse_of_ne _ (by simp) (by simp) c
  have hiO : ∀ c : Circuit n, c.inverse.count PrimitiveGate.TOFF = c.count PrimitiveGate.TOFF :=
    fun c ↦ Circuit.count_inverse_of_ne _ (by simp) (by simp) c
  simp only [pairProgramQ, DynamicCircuit.count, hiT, hiO]
  omega

end QC14.PairProgramQ


/-! Inlined from lane module `THC/M0Heff.lean`. -/

namespace QC14
open QuantumComputation QuantumComputation.Specs Finset Matrix
open scoped Matrix

/-- Sign `+1` for `x ≥ 0`, `-1` otherwise. -/
noncomputable def sgn (x : ℝ) : ℝ := if 0 ≤ x then 1 else -1

/-- The rounded one-body matrix realized by the circuit. -/
noncomputable def hRnd {N : ℕ} (D R : ℕ) (h : Matrix (Fin N) (Fin N) ℝ) :
    Matrix (Fin N) (Fin N) ℝ :=
  fun p q ↦ sgn (h p q) * (4 * R * wt D R (h p q) / D)

theorem hRnd_symm {N : ℕ} (D R : ℕ) {h : Matrix (Fin N) (Fin N) ℝ} (hs : h.IsSymm) :
    (hRnd D R h).IsSymm := by
  unfold Matrix.IsSymm
  ext p q
  simp only [Matrix.transpose_apply, hRnd]
  rw [hs.apply p q]

/-- The SELECT table entry of a row (`true` is the sign `-1`). -/
noncomputable def rowTerm {N : ℕ} (h : Matrix (Fin N) (Fin N) ℝ) :
    Row N → Bool × (Fin (2 * N) → SelectPauli.Pauli)
  | none => (false, fun _ ↦ .I)
  | some (σ, p, q, x) =>
    (if p = q then decide (0 ≤ h p p) else decide (h p q < 0), pRow N (σ, p, q, x))

/-- The SELECT table on `L = 4N² + 1` rows. -/
noncomputable def tblM0 {N : ℕ} (h : Matrix (Fin N) (Fin N) ℝ) :
    SelectPauliTable (4 * N ^ 2 + 1) (2 * N) :=
  fun j ↦ rowTerm h ((rowEquiv N).symm j)

/-- The effective Hamiltonian. -/
noncomputable def heffM0 {N : ℕ} (D R : ℕ) (h : Matrix (Fin N) (Fin N) ℝ) :
    Operator (2 ^ (2 * N)) :=
  ((h.trace : ℝ) : ℂ) • (1 : Operator (2 ^ (2 * N))) +
    ∑ r : RowIdx N, ((coef (hRnd D R h) r : ℝ) : ℂ) • (selectPauliString (pRow N r)).1

/-- The offset `c = tr h - R k_filler / D`. -/
noncomputable def offM0 {N : ℕ} (D R : ℕ) (h : Matrix (Fin N) (Fin N) ℝ) : ℝ :=
  h.trace - R * (rowWt D R h none : ℝ) / D

theorem heff_eq_oneBody {N : ℕ} (D R : ℕ) {h : Matrix (Fin N) (Fin N) ℝ} (hs : h.IsSymm) :
    heffM0 D R h = oneBodyHamiltonian (hRnd D R h) +
      (((h.trace - (hRnd D R h).trace : ℝ)) : ℂ) • (1 : Operator (2 ^ (2 * N))) := by
  rw [oneBody_eq_rows _ (hRnd_symm D R hs)]
  unfold heffM0
  push_cast
  module

theorem heff_comm_sector {N : ℕ} (D R : ℕ) {h : Matrix (Fin N) (Fin N) ℝ} (hs : h.IsSymm)
    (η : ℕ) :
    heffM0 D R h * electronSectorProjector (2 * N) η =
      electronSectorProjector (2 * N) η * heffM0 D R h := by
  rw [heff_eq_oneBody D R hs, add_mul, mul_add, oneBody_comm_sector]
  simp only [Matrix.smul_mul, Matrix.mul_smul, one_mul, mul_one]

open scoped Matrix.Norms.L2Operator in
theorem abs_sgn_err {D R : ℕ} (hD : 0 < D) (hR : 0 < R) (x : ℝ) :
    |sgn x * (4 * R * wt D R x / D) / 4 - x / 4| ≤ (R : ℝ) / D := by
  have h := wt_err D R hD hR x
  unfold sgn
  split_ifs with hx
  · have e : 1 * (4 * R * (wt D R x : ℝ) / D) / 4 - x / 4 = R * wt D R x / D - |x| / 4 := by
      rw [abs_of_nonneg hx]; ring
    rw [e]; exact h
  · have e : -1 * (4 * R * (wt D R x : ℝ) / D) / 4 - x / 4 =
        -(R * wt D R x / D - |x| / 4) := by
      rw [abs_of_neg (not_le.mp hx)]; ring
    rw [e, abs_neg]; exact h

open scoped Matrix.Norms.L2Operator in
theorem heff_close {N : ℕ} {D R : ℕ} (hD : 0 < D) (hR : 0 < R)
    {h : Matrix (Fin N) (Fin N) ℝ} (hs : h.IsSymm) :
    ‖heffM0 D R h - oneBodyHamiltonian h‖ ≤ 4 * N ^ 2 * ((R : ℝ) / D) := by
  have hrow : ∀ r : RowIdx N, |coef (hRnd D R h) r - coef h r| ≤ (R : ℝ) / D := by
    rintro ⟨σ, p, q, x⟩
    have key := abs_sgn_err hD hR (h p q)
    by_cases hpq : p = q
    · subst hpq
      have e : coef (hRnd D R h) (σ, p, p, x) - coef h (σ, p, p, x) =
          -(sgn (h p p) * (4 * R * wt D R (h p p) / D) / 4 - h p p / 4) := by
        simp only [coef, hRnd, eq_self_iff_true, if_true]; ring
      rw [e, abs_neg]; exact key
    · have e : coef (hRnd D R h) (σ, p, q, x) - coef h (σ, p, q, x) =
          sgn (h p q) * (4 * R * wt D R (h p q) / D) / 4 - h p q / 4 := by
        simp only [coef, hRnd, if_neg hpq]
      rw [e]; exact key
  have hdiff : heffM0 D R h - oneBodyHamiltonian h =
      ∑ r : RowIdx N, (((coef (hRnd D R h) r - coef h r : ℝ)) : ℂ) •
        (selectPauliString (pRow N r)).1 := by
    rw [oneBody_eq_rows h hs]
    unfold heffM0
    simp only [Complex.ofReal_sub, sub_smul, Finset.sum_sub_distrib]
    abel
  rw [hdiff]
  refine (norm_rows_le (fun r ↦ coef (hRnd D R h) r - coef h r)).trans ?_
  calc ∑ r : RowIdx N, |coef (hRnd D R h) r - coef h r| ≤ ∑ _r : RowIdx N, (R : ℝ) / D :=
        Finset.sum_le_sum fun r _ ↦ hrow r
    _ = 4 * N ^ 2 * ((R : ℝ) / D) := by
        have hc : Fintype.card (RowIdx N) = 4 * N ^ 2 := by
          simp only [RowIdx, Fintype.card_prod, Fintype.card_fin]; ring
        rw [Finset.sum_const, Finset.card_univ, hc, nsmul_eq_mul]
        push_cast; ring

/-- The block of `PREP† · SELECT · PREP` on the zero ancilla state, as a matrix identity. -/
theorem block_sum {N b : ℕ} (hLb : 4 * N ^ 2 + 1 ≤ 2 ^ b) {h : Matrix (Fin N) (Fin N) ℝ}
    {lam : ℝ} (hb : ∀ p q, |h p q| ≤ lam) {D : ℕ} (hD : 0 < D) (p : Fin (2 ^ b) → ℝ)
    (hp0 : ∀ j : Fin (2 ^ b), 4 * N ^ 2 + 1 ≤ j.val → p j = 0)
    (hp : ∀ (j : Fin (2 ^ b)) (hj : j.val < 4 * N ^ 2 + 1),
      p j = (finWt D (capR N lam) h ⟨j.val, hj⟩ : ℝ) / D) :
    ∑ j : Fin (2 ^ b), ((p j : ℝ) : ℂ) • (selectPauliBlock b (2 * N) (4 * N ^ 2 + 1) (tblM0 h) j).1 =
      ((capR N lam : ℝ) : ℂ)⁻¹ •
        (heffM0 D (capR N lam) h - ((offM0 D (capR N lam) h : ℝ) : ℂ) • 1) := by
  set R := capR N lam with hRdef
  have hRpos : (0 : ℝ) < R := by
    have : 1 ≤ R := by simp [hRdef, capR]
    exact_mod_cast this
  have hRne : (R : ℝ) ≠ 0 := hRpos.ne'
  have hRc : ((R : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hRne
  have hDne : (D : ℝ) ≠ 0 := by exact_mod_cast hD.ne'
  have hsign : ∀ s : Bool, (selectPauliSign (2 * N) s).1 = if s then (-1 : Operator (2 ^ (2 * N))) else 1 := by
    intro s; cases s <;> simp [selectPauliSign]
  have hone : (selectPauliString (fun _ : Fin (2 * N) ↦ SelectPauli.Pauli.I)).1 = 1 := by
    have : selectPauliString (fun _ : Fin (2 * N) ↦ SelectPauli.Pauli.I) = 1 := by
      unfold selectPauliString
      have : ∀ q : Fin (2 * N), (QRegister.singleton q).embedUnitary
          (SelectPauli.Pauli.I).unitary = 1 := fun q ↦ QRegister.embedUnitary_one _
      simp [this]
    rw [this]; rfl
  -- reindex the left sum over `Fin (2^b)` to `Fin L`
  set F : Fin (2 ^ b) → Operator (2 ^ (2 * N)) := fun j ↦
    ((p j : ℝ) : ℂ) • (selectPauliBlock b (2 * N) (4 * N ^ 2 + 1) (tblM0 h) j).1 with hF
  have hsplit : ∑ j : Fin (2 ^ b), F j = ∑ i : Fin (4 * N ^ 2 + 1), F (Fin.castLE hLb i) := by
    rw [← Finset.sum_image (f := F) (s := Finset.univ) (g := Fin.castLE hLb)
      (fun a _ c _ hac ↦ Fin.castLE_injective _ hac)]
    symm
    apply Finset.sum_subset (Finset.subset_univ _)
    intro j _ hj
    have hge : 4 * N ^ 2 + 1 ≤ j.val := by
      by_contra hlt
      exact hj (Finset.mem_image.2 ⟨⟨j.val, by omega⟩, Finset.mem_univ _, by ext; simp⟩)
    simp [hF, hp0 j hge]
  have hterm : ∀ i : Fin (4 * N ^ 2 + 1), F (Fin.castLE hLb i) =
      (((rowWt D R h ((rowEquiv N).symm i) : ℝ) / D : ℝ) : ℂ) •
        (selectPauliTerm (rowTerm h ((rowEquiv N).symm i))).1 := by
    intro i
    have hj : (Fin.castLE hLb i).val < 4 * N ^ 2 + 1 := i.2
    simp only [hF, selectPauliBlock, dif_pos hj]
    have hi : (⟨(Fin.castLE hLb i).val, hj⟩ : Fin (4 * N ^ 2 + 1)) = i := Fin.ext rfl
    rw [hp _ hj, hi]
    rfl
  rw [hsplit, Finset.sum_congr rfl fun i _ ↦ hterm i,
    ← Equiv.sum_comp (rowEquiv N) (fun i ↦ _), Fintype.sum_option]
  simp only [Equiv.symm_apply_apply]
  have hDc : (D : ℂ) ≠ 0 := by exact_mod_cast hDne
  have hRc' : (R : ℂ) ≠ 0 := by exact_mod_cast hRne
  have hnone : (selectPauliTerm (rowTerm h none)).1 = 1 := by
    show (selectPauliSign (2 * N) false * selectPauliString (fun _ : Fin (2 * N) ↦ SelectPauli.Pauli.I)).1 = 1
    rw [Submonoid.coe_mul, hsign, hone]
    simp
  have hsome : ∀ (σ : Fin 2) (p q : Fin N) (x : Fin 2),
      (((rowWt D R h (some (σ, p, q, x)) : ℝ) / D : ℝ) : ℂ) •
          (selectPauliTerm (rowTerm h (some (σ, p, q, x)))).1 =
        ((R : ℂ)⁻¹ * ((coef (hRnd D R h) (σ, p, q, x) : ℝ) : ℂ)) •
          (selectPauliString (pRow N (σ, p, q, x))).1 := by
    intro σ p q x
    have hsd : (selectPauliTerm (rowTerm h (some (σ, p, q, x)))).1 =
        (if (if p = q then decide (0 ≤ h p p) else decide (h p q < 0)) = true then
          (-1 : Operator (2 ^ (2 * N))) else 1) * (selectPauliString (pRow N (σ, p, q, x))).1 := by
      show (selectPauliSign (2 * N) _ * selectPauliString _).1 = _
      rw [Submonoid.coe_mul, hsign]
      rfl
    rw [hsd]
    show (((wt D R (h p q) : ℝ) / D : ℝ) : ℂ) • _ = _
    by_cases hpq : p = q
    · subst hpq
      by_cases h0 : 0 ≤ h p p
      · have hs : (if (if p = p then decide (0 ≤ h p p) else decide (h p p < 0)) = true then
            (-1 : Operator (2 ^ (2 * N))) else 1) = -1 := by simp [h0]
        have e : coef (hRnd D R h) (σ, p, p, x) = -(4 * R * wt D R (h p p) / D) / 4 := by
          simp [coef, hRnd, sgn, h0]
        rw [hs, e, neg_one_mul, smul_neg, ← neg_smul]
        congr 1
        push_cast
        field_simp
      · have hs : (if (if p = p then decide (0 ≤ h p p) else decide (h p p < 0)) = true then
            (-1 : Operator (2 ^ (2 * N))) else 1) = 1 := by simp [h0]
        have e : coef (hRnd D R h) (σ, p, p, x) = (4 * R * wt D R (h p p) / D) / 4 := by
          simp [coef, hRnd, sgn, h0]
        rw [hs, e, one_mul]
        congr 1
        push_cast
        field_simp
    · by_cases h0 : h p q < 0
      · have hs : (if (if p = q then decide (0 ≤ h p p) else decide (h p q < 0)) = true then
            (-1 : Operator (2 ^ (2 * N))) else 1) = -1 := by simp [hpq, h0]
        have e : coef (hRnd D R h) (σ, p, q, x) = -(4 * R * wt D R (h p q) / D) / 4 := by
          simp [coef, hRnd, sgn, h0, hpq, not_le.mpr h0]
        rw [hs, e, neg_one_mul, smul_neg, ← neg_smul]
        congr 1
        push_cast
        field_simp
      · have hs : (if (if p = q then decide (0 ≤ h p p) else decide (h p q < 0)) = true then
            (-1 : Operator (2 ^ (2 * N))) else 1) = 1 := by simp [hpq, h0]
        have e : coef (hRnd D R h) (σ, p, q, x) = (4 * R * wt D R (h p q) / D) / 4 := by
          simp [coef, hRnd, sgn, h0, hpq, not_lt.mp h0]
        rw [hs, e, one_mul]
        congr 1
        push_cast
        field_simp
  have hrhs : ((R : ℝ) : ℂ)⁻¹ • (heffM0 D R h - ((offM0 D R h : ℝ) : ℂ) • 1) =
      (((rowWt D R h none : ℝ) / D : ℝ) : ℂ) • (1 : Operator (2 ^ (2 * N))) +
        ∑ r : RowIdx N, ((R : ℂ)⁻¹ * ((coef (hRnd D R h) r : ℝ) : ℂ)) •
          (selectPauliString (pRow N r)).1 := by
    have e1 : ((R : ℝ) : ℂ)⁻¹ • ∑ r : RowIdx N, ((coef (hRnd D R h) r : ℝ) : ℂ) •
        (selectPauliString (pRow N r)).1 =
        ∑ r : RowIdx N, ((R : ℂ)⁻¹ * ((coef (hRnd D R h) r : ℝ) : ℂ)) •
          (selectPauliString (pRow N r)).1 := by
      rw [Finset.smul_sum]
      simp only [smul_smul, Complex.ofReal_natCast]
    unfold heffM0 offM0
    rw [smul_sub, smul_add, e1]
    simp only [smul_smul]
    push_cast
    match_scalars <;> first | done | (field_simp; try ring)
  rw [hnone, hrhs]
  congr 1
  refine Finset.sum_congr rfl fun r _ ↦ ?_
  obtain ⟨σ, p, q, x⟩ := r
  exact hsome σ p q x

end QC14


/-! Inlined from lane module `THC/CatalystZero.lean`. -/

namespace QC14
open QuantumComputation QuantumComputation.Specs Matrix Operator Circuit

theorem disj_of_concat_left {n k m b : ℕ} {rT : QRegister k n} {rS : QRegister m n}
    {rC : QRegister b n} {hsc : rS.DisjointWires rC}
    (hdisj : rT.DisjointWires (rS.concat rC hsc)) : rT.DisjointWires rS := by
  unfold QRegister.DisjointWires at hdisj ⊢
  rw [Set.disjoint_left] at hdisj ⊢
  rintro w hw ⟨i, rfl⟩
  exact hdisj hw ⟨Fin.castAdd b i, QRegister.concat_apply_left rS rC hsc i⟩

theorem catalytic_zero_of_CE {Var : Type} [DecidableEq Var] {n k m : ℕ}
    (rT : QRegister k n) (rS : QRegister m n) (rC : QRegister 0 n)
    (hsc : rS.DisjointWires rC) (hdisj : rT.DisjointWires (rS.concat rC hsc))
    (U : Unitary (2 ^ k)) (c : Circuit n)
    (hCE : c.eval.1 * rS.basisOutcomeProjector 0 =
      (rT.embedUnitary U).1 * rS.basisOutcomeProjector 0) :
    RealizesCatalyticSubroutine rT rS rC hsc hdisj U
      (DynamicCircuit.circuit (Var := Var) c).compile := by
  intro V hV
  have hfin : ∀ i j : Fin (2 ^ 0), i = j := fun i j ↦
    Fin.ext (by have := i.2; have := j.2; simp at *)
  have hV1 : V = 1 := by
    apply Subtype.ext
    ext i j
    rw [hfin i 0, hfin j 0, hV 0]
    simp [phaseGradientState]
  subst hV1
  have : NeZero (2 ^ n) := ⟨by positivity⟩
  simp only [inv_one, QRegister.embedUnitary_one]
  refine CleanSubroutineBridge.realizesCleanSubroutine_of_lowerKraus_ket (R := _) rT
    (rS.concat rC hsc) hdisj U
    ((SelectPauliSteps.lowerKraus_qAssign (Var := Var) 1).qSeq
      ((SelectPauliSteps.lowerKraus_circuit (Var := Var) c).qSeq
        (SelectPauliSteps.lowerKraus_qAssign (Var := Var) 1))) ?_
  intro β hβ
  have hS : SelectPauliSteps.localIdx rS β = 0 := by
    have h0 : (fun i ↦ β (rS i)) = 0 := funext fun i ↦ by
      have := SelectPauliBridge.bits_zero_of_localIdx_eq_zero (rS.concat rC hsc) β hβ
        (Fin.castAdd 0 i)
      rwa [QRegister.concat_apply_left] at this
    simp only [SelectPauliSteps.localIdx]
    rw [h0]
    exact basisBits_symm_zero m
  have h1 : (c.eval.1 * rS.basisOutcomeProjector 0) *ᵥ SelectPauliSteps.ket β =
      ((rT.embedUnitary U).1 * rS.basisOutcomeProjector 0) *ᵥ SelectPauliSteps.ket β := by
    rw [hCE]
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
    SelectPauliSteps.basisOutcomeProjector_mulVec_ket, if_pos hS] at h1
  simpa using h1

end QC14


/-! Inlined from lane module `THC/M0Assembly.lean`. -/

namespace QC14
open QuantumComputation QuantumComputation.Specs Matrix Operator Circuit Finset

/-- Garbage width `g = b + μ`. -/
noncomputable def gOf (N : ℕ) (lamMax ε : ℝ) : ℕ := bOf N + muOf N lamMax ε
/-- Block-encoding ancillas `b + g`. -/
noncomputable def blockAncM0 (N : ℕ) (lamMax ε : ℝ) : ℕ := bOf N + gOf N lamMax ε
/-- Weight denominator `D = 2^g`. -/
noncomputable def dOf (N : ℕ) (lamMax ε : ℝ) : ℕ := 2 ^ gOf N lamMax ε

/-- Fibre function of the integer weights. -/
noncomputable def fM0 {N : ℕ} (h : Matrix (Fin N) (Fin N) ℝ) (lamMax ε : ℝ) :
    Fin (2 ^ gOf N lamMax ε) → Fin (2 ^ bOf N) :=
  PrepareImpl.pickF (bOf N) (4 * N ^ 2 + 1) (muOf N lamMax ε)
    (natW (finWt (dOf N lamMax ε) (capR N lamMax) h))

/-- The block-encoding unitary. -/
noncomputable def uM0 {N : ℕ} (h : Matrix (Fin N) (Fin N) ℝ) (lamMax ε : ℝ) :
    Unitary (2 ^ (2 * N + blockAncM0 N lamMax ε)) :=
  blockU (2 * N) (bOf N) (gOf N lamMax ε) (fM0 h lamMax ε) (tblM0 h)

/-- The program (the identity if the registers overlap, which the spec's hypotheses exclude). -/
noncomputable def progM0 {N n : ℕ} (h : Matrix (Fin N) (Fin N) ℝ) (lamMax ε : ℝ)
    (rActive : QRegister (2 * N + blockAncM0 N lamMax ε) n)
    (rScratch : QRegister (blockAncM0 N lamMax ε + 1) n) : Circuit n :=
  if hd : ∀ i j, rActive i ≠ rScratch j then
    blockC (N := 2 * N) (b := bOf N) (g := gOf N lamMax ε) (fM0 h lamMax ε) (tblM0 h)
      rActive rScratch hd
  else .identity

/-- Per-step `T` count bound: two PREPAREs and one SELECT on `L = 4N² + 1` rows. -/
noncomputable def stepT (N : ℕ) (lamMax ε : ℝ) : ℕ :=
  2 * (8 * gOf N lamMax ε * 2 ^ gOf N lamMax ε) + 8 * bOf N * (4 * N ^ 2 + 1)

/-- Total `T` cost over the phase-estimation walk steps at `α = R`. -/
noncomputable def tCostM0 (N : ℕ) (lamMax ε εQPE : ℝ) : ℕ :=
  qpeWalkSteps (capR N lamMax : ℝ) εQPE * stepT N lamMax ε

/-! ## Ingredients -/

/-- At `M = 0` the THC Hamiltonian is the one-body term. -/
theorem thcHamiltonian_M0 {N : ℕ} (thc : THCFactorization N 0) :
    thcHamiltonian thc = oneBodyHamiltonian thc.h1eMod := by
  unfold thcHamiltonian
  simp

/-- Exact index probabilities: `finWt / D` on the `L` rows, `0` beyond. -/
theorem prob_fM0 {N : ℕ} {h : Matrix (Fin N) (Fin N) ℝ} {lamMax : ℝ}
    (hb : ∀ p q, |h p q| ≤ lamMax) (ε : ℝ) (j : Fin (2 ^ bOf N)) :
    prepareIndexProb (bOf N) (gOf N lamMax ε)
        (fun y ↦ (prepU (bOf N) (gOf N lamMax ε) (fM0 h lamMax ε)).1 y 0) j =
      if hj : j.val < 4 * N ^ 2 + 1 then
        (finWt (dOf N lamMax ε) (capR N lamMax) h ⟨j.val, hj⟩ : ℝ) / dOf N lamMax ε
      else 0 := by
  have hk : ∑ j, finWt (dOf N lamMax ε) (capR N lamMax) h j = 2 ^ (bOf N + muOf N lamMax ε) :=
    sum_finWt h hb (dOf N lamMax ε)
  have hDc : ((dOf N lamMax ε : ℕ) : ℝ) = 2 ^ gOf N lamMax ε := by simp [dOf]
  rw [prepU_prob]
  split_ifs with hj
  · have hc : (univ.filter fun σ : Fin (2 ^ gOf N lamMax ε) ↦ fM0 h lamMax ε σ = j).card =
        finWt (dOf N lamMax ε) (capR N lamMax) h ⟨j.val, hj⟩ :=
      fibre_card_natW (b := bOf N) (μ := muOf N lamMax ε) (rows_le_pow N) _ hk j hj
    rw [hc, hDc]
  · have hc : (univ.filter fun σ : Fin (2 ^ gOf N lamMax ε) ↦ fM0 h lamMax ε σ = j).card = 0 :=
      fibre_card_natW_ge (b := bOf N) (μ := muOf N lamMax ε) (rows_le_pow N) _ hk j
        (not_lt.mp hj)
    rw [hc]
    simp

/-- The block-encoding property of `uM0`. -/
theorem block_M0 {N : ℕ} {h : Matrix (Fin N) (Fin N) ℝ} {lamMax : ℝ}
    (hb : ∀ p q, |h p q| ≤ lamMax) (ε : ℝ) :
    IsQubitizedBlockEncodingUnitary (capR N lamMax : ℝ)
      (heffM0 (dOf N lamMax ε) (capR N lamMax) h -
        ((offM0 (dOf N lamMax ε) (capR N lamMax) h : ℝ) : ℂ) • (1 : Operator (2 ^ (2 * N))))
      (uM0 h lamMax ε) := by
  have hD : 0 < dOf N lamMax ε := by unfold dOf; positivity
  have hR : (0 : ℝ) < (capR N lamMax : ℝ) := by unfold capR; positivity
  refine ⟨hR, blockU_herm (2 * N) (bOf N) (gOf N lamMax ε) (fM0 h lamMax ε) (tblM0 h), ?_⟩
  obtain ⟨p, hp⟩ : ∃ p : Fin (2 ^ bOf N) → ℝ, ∀ j,
      prepareIndexProb (bOf N) (gOf N lamMax ε)
        (fun y ↦ (prepU (bOf N) (gOf N lamMax ε) (fM0 h lamMax ε)).1 y 0) j = p j :=
    ⟨fun j ↦ _, fun _ ↦ rfl⟩
  have key := blockU_block (2 * N) (bOf N) (gOf N lamMax ε) (fM0 h lamMax ε) (tblM0 h)
    (rows_le_pow N)
  simp only [hp] at key
  rw [block_sum (rows_le_pow N) hb hD p ?_ ?_, QRegister.embedMatrix_smul, Matrix.mul_smul,
    Matrix.smul_mul] at key
  · exact key
  · intro j hj
    rw [← hp, prob_fM0 hb ε, dif_neg (not_lt.mpr hj)]
  · intro j hj
    rw [← hp, prob_fM0 hb ε, dif_pos hj]

/-- `Heff` agrees with the THC Hamiltonian on every electron sector. -/
theorem agrees_M0 {N : ℕ} (thc : THCFactorization N 0) {aleph beth : ℕ} {lamMax : ℝ}
    (hround : thc.IsRounded aleph beth lamMax) (η : ℕ) {ε : ℝ} (hε : 0 < ε) :
    AgreesOnElectronSector N η
      (heffM0 (dOf N lamMax ε) (capR N lamMax) thc.h1eMod) (thcHamiltonian thc) ε := by
  have hs := thc.h1eMod_symm
  have hD : 0 < dOf N lamMax ε := by unfold dOf; positivity
  have hR : 0 < capR N lamMax := by unfold capR; omega
  refine ⟨heff_comm_sector _ _ hs η, ?_⟩
  rw [thcHamiltonian_M0 thc]
  refine (norm_sector_le η _).trans ((heff_close hD hR hs).trans ?_)
  have hDc : ((dOf N lamMax ε : ℕ) : ℝ) = 2 ^ (bOf N + muOf N lamMax ε) := by
    simp [dOf, gOf]
  rw [hDc]
  exact total_err_le N lamMax hε (bOf N)

/-- The program realizes `uM0` with clean scratch and the zero-width catalyst. -/
theorem realizes_M0 {Var : Type} [DecidableEq Var] {N : ℕ} {h : Matrix (Fin N) (Fin N) ℝ}
    {lamMax : ℝ} (ε : ℝ) {n : ℕ}
    (rActive : QRegister (2 * N + blockAncM0 N lamMax ε) n)
    (rScratch : QRegister (blockAncM0 N lamMax ε + 1) n) (rCat : QRegister 0 n)
    (hsc : rScratch.DisjointWires rCat)
    (hdisj : rActive.DisjointWires (rScratch.concat rCat hsc)) :
    RealizesCatalyticSubroutine rActive rScratch rCat hsc hdisj (uM0 h lamMax ε)
      (DynamicCircuit.circuit (Var := Var) (progM0 h lamMax ε rActive rScratch)).compile := by
  have hd : ∀ i j, rActive i ≠ rScratch j := fun i j ↦ (disj_of_concat_left hdisj).ne i j
  unfold progM0
  rw [dif_pos hd]
  exact catalytic_zero_of_CE rActive rScratch rCat hsc hdisj _ _
    (blockC_CE (rows_le_pow N) (fM0 h lamMax ε) (tblM0 h) rActive rScratch hd)

/-- Gate counts of the program. -/
theorem count_M0 {N n : ℕ} (h : Matrix (Fin N) (Fin N) ℝ) (lamMax ε : ℝ)
    (rActive : QRegister (2 * N + blockAncM0 N lamMax ε) n)
    (rScratch : QRegister (blockAncM0 N lamMax ε + 1) n) :
    (progM0 h lamMax ε rActive rScratch).count PrimitiveGate.TOFF = 0 ∧
      (progM0 h lamMax ε rActive rScratch).count PrimitiveGate.T ≤ stepT N lamMax ε := by
  unfold progM0
  split_ifs with hd
  · exact blockC_count (N := 2 * N) (b := bOf N) (g := gOf N lamMax ε) (fM0 h lamMax ε)
      (tblM0 h) rActive rScratch hd
  · simp [Circuit.count_identity]

/-! ## The spec theorems at `M = 0`, against the lane definitions -/

theorem thc_correctness_M0 {Var : Type} [DecidableEq Var]
    {N : ℕ} (thc : THCFactorization N 0) (η aleph beth : ℕ) (lamMax εSynth : ℝ)
    (hround : thc.IsRounded aleph beth lamMax) (hη : η ≤ 2 * N) (hεSynth : 0 < εSynth) :
    ∃ (U : Unitary (2 ^ (2 * N + blockAncM0 N lamMax εSynth)))
      (Heff : Operator (2 ^ (2 * N))),
      IsQubitizedBlockEncodingUnitary
        (capR N lamMax : ℝ)
        (Heff - ((offM0 (dOf N lamMax εSynth) (capR N lamMax) thc.h1eMod : ℝ) : ℂ) •
          (1 : Operator (2 ^ (2 * N)))) U ∧
      AgreesOnElectronSector N η Heff (thcHamiltonian thc) εSynth ∧
      ∀ {n : ℕ}
        (rActive : QRegister (2 * N + blockAncM0 N lamMax εSynth) n)
        (rScratch : QRegister (blockAncM0 N lamMax εSynth + 1) n)
        (rCat : QRegister 0 n)
        (hsc : rScratch.DisjointWires rCat)
        (hdisj : rActive.DisjointWires (rScratch.concat rCat hsc)),
        RealizesCatalyticSubroutine rActive rScratch rCat hsc hdisj U
          (DynamicCircuit.circuit (Var := Var)
            (progM0 thc.h1eMod lamMax εSynth rActive rScratch)).compile := by
  exact ⟨uM0 thc.h1eMod lamMax εSynth, heffM0 (dOf N lamMax εSynth) (capR N lamMax) thc.h1eMod,
    block_M0 (abs_h1eMod_le thc hround) _, agrees_M0 thc hround η hεSynth,
    fun rActive rScratch rCat hsc hdisj ↦
      realizes_M0 (Var := Var) εSynth rActive rScratch rCat hsc hdisj⟩

theorem thc_t_cost_M0 {Var : Type}
    {N : ℕ} (thc : THCFactorization N 0) (η aleph beth : ℕ) (lamMax εSynth εQPE : ℝ)
    (hround : thc.IsRounded aleph beth lamMax) {n : ℕ}
    (rActive : QRegister (2 * N + blockAncM0 N lamMax εSynth) n)
    (rScratch : QRegister (blockAncM0 N lamMax εSynth + 1) n)
    (rCat : QRegister 0 n) :
    let P := DynamicCircuit.circuit (Var := Var) (progM0 thc.h1eMod lamMax εSynth rActive rScratch)
    P.count PrimitiveGate.TOFF = 0 ∧
      qpeWalkSteps (capR N lamMax : ℝ) εQPE * P.count PrimitiveGate.T ≤
        tCostM0 N lamMax εSynth εQPE := by
  intro P
  have hc := count_M0 thc.h1eMod lamMax εSynth rActive rScratch
  have e1 : P.count PrimitiveGate.TOFF =
      (progM0 thc.h1eMod lamMax εSynth rActive rScratch).count PrimitiveGate.TOFF := rfl
  have e2 : P.count PrimitiveGate.T =
      (progM0 thc.h1eMod lamMax εSynth rActive rScratch).count PrimitiveGate.T := rfl
  rw [e1, e2]
  exact ⟨hc.1, Nat.mul_le_mul_left _ hc.2⟩

end QC14


/-! Inlined from lane module `THC/AssemblyB.lean`. -/

namespace QC14.AssemblyB

open QuantumComputation QuantumComputation.Specs Matrix Finset
open QuantumComputation.Specs.ArcsinImpl
open Operator QProg Function
open QC14.Catalytic QC14.GivensPlane QC14.RowProgram QC14.SelectRows QC14.BlockLCU
open QC14.WeightsM0
open scoped Matrix

variable {n : ℕ}

/-! ## Sizes -/

/-- Garbage width `g = idxW + muW`. -/
abbrev garbB (N aleph : ℕ) : ℕ := idxW N + muW N aleph
/-- Block-encoding ancillas `b + g`. -/
abbrev blockAncB (N aleph : ℕ) : ℕ := idxW N + garbB N aleph
/-- Scratch: the chain register (`b + g + 1`) then the kick scratch (`2 beth`). -/
abbrev scratchB (N aleph beth : ℕ) : ℕ := (blockAncB N aleph + 1) + 2 * beth

theorem rows_le_idx (N : ℕ) : 2 * N ≤ 2 ^ idxW N := by
  have := rows_le_pow_idx N
  first
    | omega
    | exact le_trans (Nat.le_succ _) this

/-! ## Data -/

/-- Sign bits: `s ℓ = true` iff `t ℓ ≥ 0`, so `(-1)^{s ℓ} = -rowSign ℓ`. -/
noncomputable def signB {N : ℕ} (D : M0Data N) : Fin N → Bool := fun ℓ ↦ decide (0 ≤ D.t ℓ)

/-- Fibre function of the integer row weights. -/
noncomputable def fB {N : ℕ} (D : M0Data N) (aleph : ℕ) : Fin (2 ^ garbB N aleph) → Fin (2 ^ idxW N) :=
  PrepareImpl.pickF (idxW N) (2 * N + 1) (muW N aleph) (natW (rowWeight D aleph))

/-- The SELECT unitary. -/
noncomputable def selB {N : ℕ} (D : M0Data N) (aleph beth : ℕ) : Unitary (2 ^ (2 * N + idxW N)) :=
  ⟨selectOp N (idxW N) beth D.k (signB D) (rows_le_idx N),
    selectOp_mem N (idxW N) beth D.k (signB D) (rows_le_idx N)⟩

/-- The block-encoding unitary. -/
noncomputable def uB {N : ℕ} (thc : THCFactorization N 0) (aleph beth : ℕ) (lam : ℝ) :
    Unitary (2 ^ (2 * N + blockAncB N aleph)) :=
  lcuU N (idxW N) (garbB N aleph) (fB (m0Data thc aleph beth lam) aleph)
    (selB (m0Data thc aleph beth lam) aleph beth)

/-- Normalization. -/
noncomputable def alphaB {N : ℕ} (thc : THCFactorization N 0) (aleph beth : ℕ) (lam : ℝ) : ℝ :=
  alphaD (m0Data thc aleph beth lam) aleph

/-- Identity offset. -/
noncomputable def offsetB {N : ℕ} (thc : THCFactorization N 0) (aleph beth : ℕ) (lam : ℝ) : ℝ :=
  offsetD (m0Data thc aleph beth lam) aleph

open Classical in
/-- The program (the identity if the registers overlap, which the spec's hypotheses exclude). -/
noncomputable def progB {Var : Type} (v : Var) {N : ℕ} (thc : THCFactorization N 0)
    (aleph beth : ℕ) (lam : ℝ) (rActive : QRegister (2 * N + blockAncB N aleph) n)
    (rScratch : QRegister (scratchB N aleph beth) n) (rCat : QRegister beth n) :
    DynamicCircuit Var n :=
  if h : (∀ i j, rActive i ≠ rScratch j) ∧ rCat.DisjointWires rActive then
    lcuProgram v beth (fB (m0Data thc aleph beth lam) aleph) (m0Data thc aleph beth lam).k
      (signB (m0Data thc aleph beth lam)) rActive
      (rScratch.slice 0 (blockAncB N aleph + 1) (by unfold scratchB; omega))
      (rScratch.slice (blockAncB N aleph + 1) (2 * beth) le_rfl) rCat
      (fun i j ↦ h.1 _ _) h.2
  else .circuit .identity

/-- Per-step `T` count. -/
def stepTB (N aleph beth : ℕ) : ℕ :=
  2 * (8 * garbB N aleph * 2 ^ garbB N aleph) + 2 * N * (16 * (N - 1) * (beth - 1) + 8 * idxW N)

/-- Total `T` cost: walk steps at the data-independent bound `max 1 (2 lamMax)` on `α`. -/
noncomputable def tCostB (N aleph beth : ℕ) (lamMax εQPE : ℝ) : ℕ :=
  qpeWalkSteps (max 1 (2 * lamMax)) εQPE * stepTB N aleph beth

/-! ## Ingredients -/

/-- Sum over a prefix of a `Fin` index set (copy of the private helper in `SelectRows`). -/
private theorem sum_fin_extend' {M : Type*} [AddCommMonoid M] {a b : ℕ} (h : a ≤ b)
    (f : Fin a → M) (g : Fin b → M) (hg : ∀ j : Fin b, a ≤ j.val → g j = 0)
    (hfg : ∀ i : Fin a, f i = g (Fin.castLE h i)) : ∑ i, f i = ∑ j, g j := by
  rw [← Finset.sum_subset (Finset.subset_univ (Finset.univ.image (Fin.castLE h)))
    (fun j _ hj ↦ hg j (by
      by_contra hlt
      exact hj (Finset.mem_image.mpr ⟨⟨j.val, by omega⟩, Finset.mem_univ _,
        Fin.ext (by first | rfl | simp)⟩))),
    Finset.sum_image (fun x _ y _ hxy ↦ Fin.castLE_injective h hxy)]
  exact Finset.sum_congr rfl fun i _ ↦ hfg i

private theorem sign_eq {N : ℕ} (D : M0Data N) (ℓ : Fin N) :
    (if signB D ℓ then (-1 : ℂ) else 1) = ((-rowSign D ℓ : ℝ) : ℂ) := by
  unfold signB rowSign
  by_cases h : D.t ℓ < 0
  · have h' : ¬ (0 ≤ D.t ℓ) := not_le.mpr h
    first
      | (simp [h, h']; done)
      | (split_ifs <;> simp_all)
  · have h' : 0 ≤ D.t ℓ := not_lt.mp h
    first
      | (simp [h, h']; done)
      | (split_ifs <;> simp_all)

private theorem rowOp_eq_selW {N : ℕ} (D : M0Data N) (beth : ℕ) (r : Fin (2 * N + 1)) :
    rowOp D beth r =
      selW beth (idxW N) D.k (signB D) (Fin.castLE (rows_le_pow_idx N) r) := by
  unfold rowOp selW
  by_cases h : r.val < 2 * N
  · have h' : (Fin.castLE (rows_le_pow_idx N) r).val < 2 * N := h
    rw [dif_pos h, dif_pos h']
    rw [← sign_eq D ⟨r.val / 2, by omega⟩] <;> rfl
  · have h' : ¬ (Fin.castLE (rows_le_pow_idx N) r).val < 2 * N := h
    rw [dif_neg h, dif_neg h']

private theorem concat_slices_ex {n a k : ℕ} (r : QRegister (a + k) n)
    (hAK : (r.slice 0 a (by omega)).DisjointWires (r.slice a k le_rfl)) (i : Fin (a + k)) :
    ∃ i' : Fin (a + k),
      ((r.slice 0 a (by omega)).concat (r.slice a k le_rfl) hAK) i = r i' := by
  induction i using Fin.addCases with
  | left x =>
    refine ⟨⟨0 + x.val, by omega⟩, ?_⟩
    rw [QRegister.concat_apply_left] <;> rfl
  | right x =>
    refine ⟨⟨a + x.val, by omega⟩, ?_⟩
    rw [QRegister.concat_apply_right] <;> rfl

/-- Exact index probabilities: `rowWeight / 2^gW` on the `2N + 1` rows, `0` beyond. -/
theorem fibre_fB {N : ℕ} {thc : THCFactorization N 0} {aleph beth : ℕ} {lam : ℝ}
    {D : M0Data N} (hD : M0Facts thc aleph beth lam D.t D.k D.j) (j : Fin (2 ^ idxW N)) :
    (((univ.filter fun σ ↦ fB D aleph σ = j).card : ℝ) / 2 ^ garbB N aleph) =
      if hj : j.val < 2 * N + 1 then (rowWeight D aleph ⟨j.val, hj⟩ : ℝ) / 2 ^ gW N aleph
      else 0 := by
  have hk : ∑ r, rowWeight D aleph r = 2 ^ (idxW N + muW N aleph) := sum_rowWeight hD
  have hg : (2 : ℝ) ^ garbB N aleph = 2 ^ gW N aleph := by
    show (2 : ℝ) ^ (idxW N + muW N aleph) = 2 ^ gW N aleph
    rw [idxW_add_muW]
  split_ifs with hj
  · have hc : (univ.filter fun σ : Fin (2 ^ garbB N aleph) ↦ fB D aleph σ = j).card =
        rowWeight D aleph ⟨j.val, hj⟩ :=
      fibre_card_natW (b := idxW N) (μ := muW N aleph) (rows_le_pow_idx N) (rowWeight D aleph)
        hk j hj
    rw [hc, hg]
  · have hc : (univ.filter fun σ : Fin (2 ^ garbB N aleph) ↦ fB D aleph σ = j).card = 0 :=
      fibre_card_natW_ge (b := idxW N) (μ := muW N aleph) (rows_le_pow_idx N)
        (rowWeight D aleph) hk j (not_lt.mp hj)
    rw [hc]
    simp

/-- The B5 block sum is the B1 row sum. -/
theorem blockSum_selW {N : ℕ} {thc : THCFactorization N 0} {aleph beth : ℕ} {lam : ℝ}
    {D : M0Data N} (hD : M0Facts thc aleph beth lam D.t D.k D.j) :
    ∑ j : Fin (2 ^ idxW N), ((((univ.filter fun σ ↦ fB D aleph σ = j).card : ℝ) /
        2 ^ garbB N aleph : ℝ) : ℂ) • selW beth (idxW N) D.k (signB D) j =
      ((alphaD D aleph)⁻¹ : ℂ) • (oneBodyHamiltonian thc.h1eMod - (offsetD D aleph : ℂ) • 1) := by
  refine Eq.trans ?_ (blockSum_eq hD)
  have hle : 2 * N + 1 ≤ 2 ^ idxW N := rows_le_pow_idx N
  calc _ = ∑ j : Fin (2 ^ idxW N),
        ((if hj : j.val < 2 * N + 1 then
            (rowWeight D aleph ⟨j.val, hj⟩ : ℝ) / 2 ^ gW N aleph else 0 : ℝ) : ℂ) •
          selW beth (idxW N) D.k (signB D) j :=
        Finset.sum_congr rfl fun j _ ↦ by rw [fibre_fB hD j]
    _ = ∑ r : Fin (2 * N + 1), (((rowWeight D aleph r : ℝ) / 2 ^ gW N aleph : ℝ) : ℂ) •
          rowOp D beth r := by
        refine (sum_fin_extend' hle _ _ ?_ ?_).symm
        · intro j hj
          rw [dif_neg (not_lt.mpr hj)]
          simp
        · intro r
          have hr : (Fin.castLE hle r).val < 2 * N + 1 := r.isLt
          have e : rowOp D beth r =
              selW beth (idxW N) D.k (signB D) (Fin.castLE hle r) := rowOp_eq_selW D beth r
          rw [dif_pos hr, e] <;> rfl

private theorem block_aux {N : ℕ} {thc : THCFactorization N 0} {aleph beth : ℕ} {lam : ℝ}
    {D : M0Data N} (hD : M0Facts thc aleph beth lam D.t D.k D.j) :
    IsQubitizedBlockEncodingUnitary (alphaD D aleph)
      (thcHamiltonian thc - (offsetD D aleph : ℂ) • (1 : Operator (2 ^ (2 * N))))
      (lcuU N (idxW N) (garbB N aleph) (fB D aleph) (selB D aleph beth)) := by
  have hS := selectOp_eq_sum N (idxW N) beth D.k (signB D) (rows_le_idx N)
  have hW : ∀ j, (selW beth (idxW N) D.k (signB D) j)ᴴ = selW beth (idxW N) D.k (signB D) j :=
    fun j ↦ selW_conjTranspose beth (idxW N) D.k (signB D) j
  refine ⟨alphaD_pos D aleph, lcuU_herm N (idxW N) (garbB N aleph) (fB D aleph)
    (selB D aleph beth) (selW beth (idxW N) D.k (signB D)) hS hW, ?_⟩
  have key := lcuU_block N (idxW N) (garbB N aleph) (fB D aleph) (selB D aleph beth)
    (selW beth (idxW N) D.k (signB D)) hS
  first
    | rw [blockSum_selW hD] at key
    | erw [blockSum_selW hD] at key
  rw [QRegister.embedMatrix_smul, Matrix.mul_smul, Matrix.smul_mul] at key
  rw [thcHamiltonian_M0 thc]
  exact key

theorem block_B {N : ℕ} (thc : THCFactorization N 0) {aleph beth : ℕ} {lam : ℝ}
    (hround : thc.IsRounded aleph beth lam) :
    IsQubitizedBlockEncodingUnitary (alphaB thc aleph beth lam)
      (thcHamiltonian thc - (offsetB thc aleph beth lam : ℂ) • (1 : Operator (2 ^ (2 * N))))
      (uB thc aleph beth lam) :=
  block_aux (D := m0Data thc aleph beth lam) (m0Data_facts thc hround)

open scoped Matrix.Norms.L2Operator in
theorem agrees_B {N : ℕ} (thc : THCFactorization N 0) (η : ℕ) {ε : ℝ} (hε : 0 ≤ ε) :
    AgreesOnElectronSector N η (thcHamiltonian thc) (thcHamiltonian thc) ε := by
  refine ⟨?_, ?_⟩
  · rw [thcHamiltonian_M0 thc]
    exact oneBody_comm_sector thc.h1eMod η
  · first
      | (simp only [sub_self, mul_zero, zero_mul, norm_zero]; exact hε)
      | simpa using hε

theorem realizes_B {Var : Type} [DecidableEq Var] (v : Var) {N : ℕ} (thc : THCFactorization N 0)
    (aleph beth : ℕ) (lam : ℝ) (rActive : QRegister (2 * N + blockAncB N aleph) n)
    (rScratch : QRegister (scratchB N aleph beth) n) (rCat : QRegister beth n)
    (hsc : rScratch.DisjointWires rCat) (hdisj : rActive.DisjointWires (rScratch.concat rCat hsc)) :
    RealizesCatalyticSubroutine rActive rScratch rCat hsc hdisj (uB thc aleph beth lam)
      (progB v thc aleph beth lam rActive rScratch rCat).compile := by
  haveI : NeZero (2 ^ n) := ⟨by positivity⟩
  have hd : ∀ i j, rActive i ≠ rScratch j := fun i j ↦ (disj_of_concat_left hdisj).ne i j
  have hcD : rCat.DisjointWires rActive :=
    QRegister.disjoint_comm.mp (disjoint_cat rActive rScratch rCat hsc hdisj).1
  have hc : (∀ i j, rActive i ≠ rScratch j) ∧ rCat.DisjointWires rActive := ⟨hd, hcD⟩
  have h1 : 0 + (blockAncB N aleph + 1) ≤ scratchB N aleph beth := by unfold scratchB; omega
  have h2 : blockAncB N aleph + 1 + 2 * beth ≤ scratchB N aleph beth := le_rfl
  have hAK : (rScratch.slice 0 (blockAncB N aleph + 1) h1).DisjointWires
      (rScratch.slice (blockAncB N aleph + 1) (2 * beth) h2) :=
    QRegister.slice_disjoint_of_le rScratch 0 (blockAncB N aleph + 1) (blockAncB N aleph + 1)
      (2 * beth) h1 h2 (by omega)
  have hex := concat_slices_ex (a := blockAncB N aleph + 1) (k := 2 * beth) rScratch hAK
  have hsc' : ((rScratch.slice 0 (blockAncB N aleph + 1) h1).concat
      (rScratch.slice (blockAncB N aleph + 1) (2 * beth) h2) hAK).DisjointWires rCat := by
    rw [QRegister.disjoint_iff]
    intro i j
    obtain ⟨i', hi'⟩ := hex i
    rw [hi']
    exact hsc.ne i' j
  have hdisj' : rActive.DisjointWires (((rScratch.slice 0 (blockAncB N aleph + 1) h1).concat
      (rScratch.slice (blockAncB N aleph + 1) (2 * beth) h2) hAK).concat rCat hsc') := by
    rw [QRegister.disjoint_iff]
    intro i j
    induction j using Fin.addCases with
    | left a =>
        rw [QRegister.concat_apply_left]
        obtain ⟨a', ha'⟩ := hex a
        rw [ha']
        exact hd i a'
    | right c =>
        rw [QRegister.concat_apply_right]
        have := QRegister.disjoint_iff.1 hdisj i (Fin.natAdd (scratchB N aleph beth) c)
        rwa [QRegister.concat_apply_right] at this
  have hsub : ∀ β, localIdx (rScratch.concat rCat hsc) β = 0 →
      localIdx (((rScratch.slice 0 (blockAncB N aleph + 1) h1).concat
        (rScratch.slice (blockAncB N aleph + 1) (2 * beth) h2) hAK).concat rCat hsc') β = 0 := by
    intro β h0
    have hz := eq_zero_of_localIdx_eq_zero _ β h0
    apply localIdx_eq_zero_of_forall
    intro i
    induction i using Fin.addCases with
    | left a =>
        rw [QRegister.concat_apply_left]
        obtain ⟨a', ha'⟩ := hex a
        rw [ha']
        have := hz (Fin.castAdd beth a')
        rwa [QRegister.concat_apply_left] at this
    | right c =>
        rw [QRegister.concat_apply_right]
        have := hz (Fin.natAdd (scratchB N aleph beth) c)
        rwa [QRegister.concat_apply_right] at this
  obtain ⟨S, hS, hcat⟩ := lcu_catKet (Var := Var) v beth (N := N) (b := idxW N)
    (g := garbB N aleph) (fB (m0Data thc aleph beth lam) aleph) (m0Data thc aleph beth lam).k
    (signB (m0Data thc aleph beth lam)) (rows_le_idx N) rActive
    (rScratch.slice 0 (blockAncB N aleph + 1) h1)
    (rScratch.slice (blockAncB N aleph + 1) (2 * beth) h2) rCat (fun i j ↦ hd i _) hcD hAK hsc'
    hdisj'
  obtain rfl : S = selB (m0Data thc aleph beth lam) aleph beth := Subtype.ext hS
  unfold progB
  rw [dif_pos hc]
  refine CatKet.catalytic ?_ hdisj
  exact catKet_mono_scratch hsub hcat

theorem count_B {Var : Type} (v : Var) {N : ℕ} (thc : THCFactorization N 0) (aleph beth : ℕ)
    (lam : ℝ) (rActive : QRegister (2 * N + blockAncB N aleph) n)
    (rScratch : QRegister (scratchB N aleph beth) n) (rCat : QRegister beth n) :
    (progB v thc aleph beth lam rActive rScratch rCat).count PrimitiveGate.TOFF = 0 ∧
      (progB v thc aleph beth lam rActive rScratch rCat).count PrimitiveGate.T ≤
        stepTB N aleph beth := by
  unfold progB
  split_ifs with hd
  · have h := lcu_count v beth (fB (m0Data thc aleph beth lam) aleph)
      (m0Data thc aleph beth lam).k (signB (m0Data thc aleph beth lam)) rActive
      (rScratch.slice 0 (blockAncB N aleph + 1) (by unfold scratchB; omega))
      (rScratch.slice (blockAncB N aleph + 1) (2 * beth) le_rfl) rCat (fun i j ↦ hd.1 _ _) hd.2
    unfold stepTB
    exact h
  · exact ⟨by simp [DynamicCircuit.count, Circuit.count_identity],
      by simp [DynamicCircuit.count, Circuit.count_identity]⟩

/-! ## The spec theorems at `M = 0`, against the lane definitions -/

theorem thc_correctness_B {Var : Type} [DecidableEq Var] (v : Var)
    {N : ℕ} (thc : THCFactorization N 0) (η aleph beth : ℕ) (lamMax εSynth : ℝ)
    (hround : thc.IsRounded aleph beth lamMax) (hη : η ≤ 2 * N) (hεSynth : 0 < εSynth) :
    ∃ (U : Unitary (2 ^ (2 * N + blockAncB N aleph))) (Heff : Operator (2 ^ (2 * N))),
      IsQubitizedBlockEncodingUnitary (alphaB thc aleph beth lamMax)
        (Heff - (offsetB thc aleph beth lamMax : ℂ) • (1 : Operator (2 ^ (2 * N)))) U ∧
      AgreesOnElectronSector N η Heff (thcHamiltonian thc) εSynth ∧
      ∀ {n : ℕ}
        (rActive : QRegister (2 * N + blockAncB N aleph) n)
        (rScratch : QRegister (scratchB N aleph beth) n)
        (rCat : QRegister beth n)
        (hsc : rScratch.DisjointWires rCat)
        (hdisj : rActive.DisjointWires (rScratch.concat rCat hsc)),
        RealizesCatalyticSubroutine rActive rScratch rCat hsc hdisj U
          (progB v thc aleph beth lamMax rActive rScratch rCat).compile :=
  ⟨uB thc aleph beth lamMax, thcHamiltonian thc, block_B thc hround,
    agrees_B thc η hεSynth.le,
    fun rActive rScratch rCat hsc hdisj ↦
      realizes_B v thc aleph beth lamMax rActive rScratch rCat hsc hdisj⟩

theorem thc_t_cost_B {Var : Type} (v : Var)
    {N : ℕ} (thc : THCFactorization N 0) (η aleph beth : ℕ) (lamMax εSynth εQPE : ℝ)
    (hround : thc.IsRounded aleph beth lamMax) {n : ℕ}
    (rActive : QRegister (2 * N + blockAncB N aleph) n)
    (rScratch : QRegister (scratchB N aleph beth) n)
    (rCat : QRegister beth n) :
    let P := progB v thc aleph beth lamMax rActive rScratch rCat
    P.count PrimitiveGate.TOFF = 0 ∧
      qpeWalkSteps (alphaB thc aleph beth lamMax) εQPE * P.count PrimitiveGate.T ≤
        tCostB N aleph beth lamMax εQPE := by
  intro P
  have hc := count_B v thc aleph beth lamMax rActive rScratch rCat
  refine ⟨hc.1, ?_⟩
  have hD := m0Data_facts thc hround
  have h1 : qpeWalkSteps (alphaB thc aleph beth lamMax) εQPE ≤
      qpeWalkSteps (max 1 (2 * lamMax)) εQPE :=
    qpeWalkSteps_mono εQPE (alphaD_pos (m0Data thc aleph beth lamMax) aleph).le (alphaD_le hD)
  unfold tCostB
  exact Nat.mul_le_mul h1 hc.2

end QC14.AssemblyB



/-! Inlined from lane module `THC/AssemblyC.lean`. -/

namespace QC14.AssemblyC

open QuantumComputation QuantumComputation.Specs Matrix Finset
open QuantumComputation.Specs.ArcsinImpl
open Operator QProg Function
open QC14.Catalytic QC14.GivensPlane QC14.RowProgram QC14.SelectRows QC14.SelectL QC14.BlockLCU QC14.WeightsC
open QC14.PairBlock QC14.PairPrep QC14.PairProgram QC14.AliasProgram QC14.TwoBodyAlgebra
open QC14.PairProgramQ QC14.SelectQ
open QC14.WeightsM0 (qpeWalkSteps_mono)
open scoped Matrix

variable {n : ℕ}

/-! ## Sizes -/

/-- Block-encoding ancillas `bP + gP`. -/
abbrev blockAncC (N M aleph : ℕ) : ℕ := bP N M + gP N M aleph
/-- Scratch: the chain register (`ancP = max (bP + gP + 1) (aliasAnc bP gP sA)`) then the
SELECT scratch (`selQScr N bIC beth`). -/
abbrev scratchC (N M aleph beth : ℕ) : ℕ := scratchQ N M aleph beth

theorem scratchC_kick (N M aleph beth : ℕ) : ancP N M aleph + 2 * beth ≤ scratchC N M aleph beth := by
  unfold scratchC scratchQ selQScr; omega

/-! ## Data -/

/-- The block-encoding unitary (`1` when `N = 0`). -/
noncomputable def uC {N M : ℕ} (thc : THCFactorization N M) (aleph beth : ℕ) (lam : ℝ) :
    Unitary (2 ^ (2 * N + blockAncC N M aleph)) :=
  if h : N = 0 then 1 else
    haveI : NeZero N := ⟨h⟩
    lcuQ N (bP N M) (gP N M aleph) (pairPrepU thc (cData thc aleph beth lam) aleph)
      (pairSelU (cData thc aleph beth lam) beth)

/-- Normalization. -/
noncomputable def alphaCS {N M : ℕ} (thc : THCFactorization N M) (aleph beth : ℕ) (lam : ℝ) :
    ℝ :=
  if N = 0 then 1 else alphaC thc (cData thc aleph beth lam) aleph

/-- Identity offset. -/
noncomputable def offsetCS {N M : ℕ} (thc : THCFactorization N M) (aleph beth : ℕ) (lam : ℝ) :
    ℝ :=
  if N = 0 then -1 else offsetC thc (cData thc aleph beth lam) aleph

open Classical in
/-- The program (the identity if `N = 0` or the registers overlap; the spec's hypotheses exclude
the overlap). -/
noncomputable def progC {Var : Type} (v : Var) {N M : ℕ} (thc : THCFactorization N M)
    (aleph beth : ℕ) (lam : ℝ) (rActive : QRegister (2 * N + blockAncC N M aleph) n)
    (rScratch : QRegister (scratchC N M aleph beth) n) (rCat : QRegister beth n) :
    DynamicCircuit Var n :=
  if h : N ≠ 0 ∧ ∃ hsc : rScratch.DisjointWires rCat,
      rActive.DisjointWires (rScratch.concat rCat hsc) then
    if 2 ≤ beth then
      pairProgramQ v beth thc (cData thc aleph beth lam) aleph (pqBIC_pos h.1) rActive rScratch
        rCat h.2.1 h.2.2
    else
      pairProgramA v beth thc (cData thc aleph beth lam) aleph rActive
        (rScratch.slice 0 (ancP N M aleph) (pqAnc_le N M aleph beth))
        (rScratch.slice (ancP N M aleph) (2 * beth) (scratchC_kick N M aleph beth)) rCat
        (fun i _ ↦ QRegister.disjoint_iff.1 (disjoint_cat rActive rScratch rCat h.2.1 h.2.2).2 i _)
        (QRegister.disjoint_comm.mp (disjoint_cat rActive rScratch rCat h.2.1 h.2.2).1)
  else .circuit .identity

/-- Per-step `T` count. -/
def stepTC (N M aleph beth : ℕ) : ℕ :=
  2 * (16 * 2 ^ sA N M + 32 * (gP N M aleph - sA N M + 1) + 16 * bP N M + 8 * bIC N M) +
    if 2 ≤ beth then 2 * (16 * (N - 1) * (beth - 1) + 16 * N + 8 * 2 ^ bIC N M)
    else 2 * (2 * (N + M) * (16 * (N - 1) * (beth - 1) + 8 * bIC N M))

/-- Data-independent factor in `α ≤ max 1 (κ lam)`. -/
noncomputable def kappaC (N M aleph : ℕ) : ℝ :=
  (2 : ℝ) ^ gC N M aleph / (4 * (dC N M : ℝ) * 2 ^ aleph)

/-- Total `T` cost: walk steps at the bound `max 1 (κ lamMax)` on `α`. -/
noncomputable def tCostC (N M aleph beth : ℕ) (lamMax εQPE : ℝ) : ℕ :=
  qpeWalkSteps (max 1 (kappaC N M aleph * lamMax)) εQPE * stepTC N M aleph beth

/-! ## `N = 0` -/

/-- With no orbitals there are no leaves (`chi_norm`). -/
theorem M_eq_zero_of_N0 {M : ℕ} (thc : THCFactorization 0 M) : M = 0 := by
  by_contra h
  have := thc.chi_norm ⟨0, Nat.pos_of_ne_zero h⟩
  simp at this

theorem thcHamiltonian_N0 {M : ℕ} (thc : THCFactorization 0 M) : thcHamiltonian thc = 0 := by
  obtain rfl := M_eq_zero_of_N0 thc
  unfold thcHamiltonian oneBodyHamiltonian
  simp

/-! ## Ingredients -/

theorem alphaCS_pos {N M : ℕ} (thc : THCFactorization N M) (aleph beth : ℕ) (lam : ℝ) :
    0 < alphaCS thc aleph beth lam := by
  unfold alphaCS
  split_ifs
  · exact one_pos
  · exact alphaC_pos _ _ _

theorem alphaCS_le {N M : ℕ} (thc : THCFactorization N M) {aleph beth : ℕ} {lam : ℝ}
    (hround : thc.IsRounded aleph beth lam) :
    alphaCS thc aleph beth lam ≤ max 1 (kappaC N M aleph * lam) := by
  unfold alphaCS
  split_ifs
  · exact le_max_left _ _
  · have h := alphaC_le (cData_facts thc hround)
    unfold kappaC
    exact h

theorem block_C {N M : ℕ} (thc : THCFactorization N M) {aleph beth : ℕ} {lam : ℝ}
    (hround : thc.IsRounded aleph beth lam) :
    IsQubitizedBlockEncodingUnitary (alphaCS thc aleph beth lam)
      (thcHamiltonian thc - (offsetCS thc aleph beth lam : ℂ) • (1 : Operator (2 ^ (2 * N))))
      (uC thc aleph beth lam) := by
  by_cases hN : N = 0
  · have key : ∀ (m : ℕ) (A : Operator (2 ^ (2 * N))), A = 1 →
        IsQubitizedBlockEncodingUnitary (m := m) 1 A (1 : Unitary (2 ^ (2 * N + m))) := by
      intro m A hA
      subst hA
      refine ⟨one_pos, ?_, ?_⟩
      · simp
      · simp [QRegister.embedMatrix_one]
    have ha : alphaCS thc aleph beth lam = 1 := by unfold alphaCS; exact if_pos hN
    have ho : offsetCS thc aleph beth lam = -1 := by unfold offsetCS; exact if_pos hN
    have hu : uC thc aleph beth lam = 1 := by unfold uC; exact dif_pos hN
    have hH : thcHamiltonian thc - ((offsetCS thc aleph beth lam : ℝ) : ℂ) •
        (1 : Operator (2 ^ (2 * N))) = 1 := by
      subst hN
      rw [thcHamiltonian_N0 thc, ho]
      simp
    rw [ha, hu]
    exact key _ _ hH
  · haveI : NeZero N := ⟨hN⟩
    have ha : alphaCS thc aleph beth lam = alphaC thc (cData thc aleph beth lam) aleph := by
      unfold alphaCS; exact if_neg hN
    have ho : offsetCS thc aleph beth lam = offsetC thc (cData thc aleph beth lam) aleph := by
      unfold offsetCS; exact if_neg hN
    have hu : uC thc aleph beth lam =
        lcuQ N (bP N M) (gP N M aleph) (pairPrepU thc (cData thc aleph beth lam) aleph)
          (pairSelU (cData thc aleph beth lam) beth) := by
      unfold uC; exact dif_neg hN
    have hD := cData_facts thc hround
    rw [ha, ho, hu]
    refine ⟨alphaC_pos _ _ _, pair_herm thc _ aleph beth, ?_⟩
    have key := pair_block hD
    rw [QRegister.embedMatrix_smul, Matrix.mul_smul, Matrix.smul_mul] at key
    exact key

open scoped Matrix.Norms.L2Operator in
theorem agrees_C {N M : ℕ} (thc : THCFactorization N M) (η : ℕ) {ε : ℝ} (hε : 0 ≤ ε) :
    AgreesOnElectronSector N η (thcHamiltonian thc) (thcHamiltonian thc) ε := by
  refine ⟨thcHamiltonian_comm_sector thc η, ?_⟩
  first
    | (simp only [sub_self, mul_zero, zero_mul, norm_zero]; exact hε)
    | simpa using hε

theorem realizes_C {Var : Type} [DecidableEq Var] (v : Var) {N M : ℕ}
    (thc : THCFactorization N M) (aleph beth : ℕ) (lam : ℝ)
    (rActive : QRegister (2 * N + blockAncC N M aleph) n)
    (rScratch : QRegister (scratchC N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rScratch.DisjointWires rCat) (hdisj : rActive.DisjointWires (rScratch.concat rCat hsc)) :
    RealizesCatalyticSubroutine rActive rScratch rCat hsc hdisj (uC thc aleph beth lam)
      (progC v thc aleph beth lam rActive rScratch rCat).compile := by
  haveI : NeZero (2 ^ n) := ⟨by positivity⟩
  have hd : ∀ i j, rActive i ≠ rScratch j := fun i j ↦ (disj_of_concat_left hdisj).ne i j
  have hcD : rCat.DisjointWires rActive :=
    QRegister.disjoint_comm.mp (disjoint_cat rActive rScratch rCat hsc hdisj).1
  by_cases hN : N = 0
  · have hu : uC thc aleph beth lam = 1 := by unfold uC; exact dif_pos hN
    have hp : progC v thc aleph beth lam rActive rScratch rCat = .circuit .identity := by
      unfold progC
      exact dif_neg fun h' ↦ h'.1 hN
    rw [hu, hp]
    exact CatKet.catalytic (catKet_circuit_ket (Var := Var) rActive rScratch rCat hsc
      Circuit.identity 1 (fun β _ ↦ by simp)) hdisj
  haveI : NeZero N := ⟨hN⟩
  have hc : N ≠ 0 ∧ ∃ hsc : rScratch.DisjointWires rCat,
      rActive.DisjointWires (rScratch.concat rCat hsc) := ⟨hN, hsc, hdisj⟩
  have hu : uC thc aleph beth lam =
      lcuQ N (bP N M) (gP N M aleph) (pairPrepU thc (cData thc aleph beth lam) aleph)
        (pairSelU (cData thc aleph beth lam) beth) := by
    unfold uC; exact dif_neg hN
  unfold progC
  rw [dif_pos hc, hu]
  refine CatKet.catalytic ?_ hdisj
  by_cases hb : 2 ≤ beth
  · rw [if_pos hb]
    obtain ⟨S, hS, hcat⟩ := pair_catKetQ (Var := Var) v beth hb thc (cData thc aleph beth lam)
      aleph (pqBIC_pos hN) rActive rScratch rCat hsc hdisj
    obtain rfl : S = pairSelU (cData thc aleph beth lam) beth := Subtype.ext hS
    exact hcat
  · rw [if_neg hb]
    have h1 := pqAnc_le N M aleph beth
    have h2 := scratchC_kick N M aleph beth
    have hAK : (rScratch.slice 0 (ancP N M aleph) h1).DisjointWires
        (rScratch.slice (ancP N M aleph) (2 * beth) h2) :=
      QRegister.slice_disjoint_of_le rScratch 0 (ancP N M aleph) (ancP N M aleph)
        (2 * beth) h1 h2 (by omega)
    have hw : ∀ i, ∃ j, ((rScratch.slice 0 (ancP N M aleph) h1).concat
        (rScratch.slice (ancP N M aleph) (2 * beth) h2) hAK) i = rScratch j :=
      pqConcat_wires (pqSlice_wires _ _ _ _) (pqSlice_wires _ _ _ _)
    have hsc' : ((rScratch.slice 0 (ancP N M aleph) h1).concat
        (rScratch.slice (ancP N M aleph) (2 * beth) h2) hAK).DisjointWires rCat :=
      pqDisj_sub hw hsc
    have hdisj' : rActive.DisjointWires (((rScratch.slice 0 (ancP N M aleph) h1).concat
        (rScratch.slice (ancP N M aleph) (2 * beth) h2) hAK).concat rCat hsc') := by
      have hw2 : ∀ i, ∃ j, (((rScratch.slice 0 (ancP N M aleph) h1).concat
          (rScratch.slice (ancP N M aleph) (2 * beth) h2) hAK).concat rCat hsc') i =
            (rScratch.concat rCat hsc) j :=
        pqConcat_wires (fun i ↦ by
            obtain ⟨j, hj⟩ := hw i
            exact ⟨Fin.castAdd beth j, by rw [QRegister.concat_apply_left]; exact hj⟩)
          (fun i ↦ ⟨Fin.natAdd (scratchC N M aleph beth) i, by
            rw [QRegister.concat_apply_right]⟩)
      exact QRegister.disjoint_comm.mp (pqDisj_sub hw2 (QRegister.disjoint_comm.mp hdisj))
    obtain ⟨S, hS, hcat⟩ := pair_catKetA (Var := Var) v beth thc (cData thc aleph beth lam)
      aleph rActive (rScratch.slice 0 (ancP N M aleph) h1)
      (rScratch.slice (ancP N M aleph) (2 * beth) h2) rCat
      (fun i j ↦ QRegister.disjoint_iff.1 (disjoint_cat rActive rScratch rCat hsc hdisj).2 i _)
      (QRegister.disjoint_comm.mp (disjoint_cat rActive rScratch rCat hsc hdisj).1) hAK hsc'
      hdisj'
    obtain rfl : S = pairSelU (cData thc aleph beth lam) beth := Subtype.ext hS
    exact pqCatKet_sub hw hcat

theorem count_C {Var : Type} (v : Var) {N M : ℕ} (thc : THCFactorization N M) (aleph beth : ℕ)
    (lam : ℝ) (rActive : QRegister (2 * N + blockAncC N M aleph) n)
    (rScratch : QRegister (scratchC N M aleph beth) n) (rCat : QRegister beth n) :
    (progC v thc aleph beth lam rActive rScratch rCat).count PrimitiveGate.TOFF = 0 ∧
      (progC v thc aleph beth lam rActive rScratch rCat).count PrimitiveGate.T ≤
        stepTC N M aleph beth := by
  unfold progC
  split_ifs with h hb
  · haveI : NeZero N := ⟨h.1⟩
    have hc := pair_countQ v beth thc (cData thc aleph beth lam) aleph (pqBIC_pos h.1) rActive
      rScratch rCat h.2.1 h.2.2
    unfold stepTC
    rw [if_pos hb]
    exact hc
  · haveI : NeZero N := ⟨h.1⟩
    have hc := pair_countA v beth thc (cData thc aleph beth lam) aleph rActive
      (rScratch.slice 0 (ancP N M aleph) (pqAnc_le N M aleph beth))
      (rScratch.slice (ancP N M aleph) (2 * beth) (scratchC_kick N M aleph beth)) rCat
      (fun i _ ↦ QRegister.disjoint_iff.1 (disjoint_cat rActive rScratch rCat h.2.1 h.2.2).2 i _)
      (QRegister.disjoint_comm.mp (disjoint_cat rActive rScratch rCat h.2.1 h.2.2).1)
    unfold stepTC
    rw [if_neg hb]
    exact hc
  · exact ⟨by simp [DynamicCircuit.count, Circuit.count_identity],
      by simp [DynamicCircuit.count, Circuit.count_identity]⟩

/-! ## The spec theorems for every `M`, against the lane definitions -/

theorem thc_correctness_C {Var : Type} [DecidableEq Var] (v : Var)
    {N M : ℕ} (thc : THCFactorization N M) (η aleph beth : ℕ) (lamMax εSynth : ℝ)
    (hround : thc.IsRounded aleph beth lamMax) (hη : η ≤ 2 * N) (hεSynth : 0 < εSynth) :
    ∃ (U : Unitary (2 ^ (2 * N + blockAncC N M aleph))) (Heff : Operator (2 ^ (2 * N))),
      IsQubitizedBlockEncodingUnitary (alphaCS thc aleph beth lamMax)
        (Heff - (offsetCS thc aleph beth lamMax : ℂ) • (1 : Operator (2 ^ (2 * N)))) U ∧
      AgreesOnElectronSector N η Heff (thcHamiltonian thc) εSynth ∧
      ∀ {n : ℕ}
        (rActive : QRegister (2 * N + blockAncC N M aleph) n)
        (rScratch : QRegister (scratchC N M aleph beth) n)
        (rCat : QRegister beth n)
        (hsc : rScratch.DisjointWires rCat)
        (hdisj : rActive.DisjointWires (rScratch.concat rCat hsc)),
        RealizesCatalyticSubroutine rActive rScratch rCat hsc hdisj U
          (progC v thc aleph beth lamMax rActive rScratch rCat).compile :=
  ⟨uC thc aleph beth lamMax, thcHamiltonian thc, block_C thc hround,
    agrees_C thc η hεSynth.le,
    fun rActive rScratch rCat hsc hdisj ↦
      realizes_C v thc aleph beth lamMax rActive rScratch rCat hsc hdisj⟩

theorem thc_t_cost_C {Var : Type} (v : Var)
    {N M : ℕ} (thc : THCFactorization N M) (η aleph beth : ℕ) (lamMax εSynth εQPE : ℝ)
    (hround : thc.IsRounded aleph beth lamMax) {n : ℕ}
    (rActive : QRegister (2 * N + blockAncC N M aleph) n)
    (rScratch : QRegister (scratchC N M aleph beth) n)
    (rCat : QRegister beth n) :
    let P := progC v thc aleph beth lamMax rActive rScratch rCat
    P.count PrimitiveGate.TOFF = 0 ∧
      qpeWalkSteps (alphaCS thc aleph beth lamMax) εQPE * P.count PrimitiveGate.T ≤
        tCostC N M aleph beth lamMax εQPE := by
  intro P
  have hc := count_C v thc aleph beth lamMax rActive rScratch rCat
  refine ⟨hc.1, ?_⟩
  have h1 : qpeWalkSteps (alphaCS thc aleph beth lamMax) εQPE ≤
      qpeWalkSteps (max 1 (kappaC N M aleph * lamMax)) εQPE :=
    qpeWalkSteps_mono εQPE (alphaCS_pos thc aleph beth lamMax).le (alphaCS_le thc hround)
  unfold tCostC
  exact Nat.mul_le_mul h1 hc.2

end QC14.AssemblyC


/-! Inlined from lane module `THC/LookupKraus.lean`. -/

namespace QC14.LookupKraus

section

open QuantumComputation QuantumComputation.Specs
open Operator Matrix QProg Function
open TableLookupSteps SelectSwapImpl MbuImpl Mbl2Impl
open scoped Matrix ComplexOrder MatrixOrder

variable {n : ℕ}

/-- Measure the listed target wires, passing their outcome mask to the phase leaf. -/
def lkMbuTree {Var : Type} {w : ℕ} (v : Var) (T : Fin w → Wire n)
    (leaf : (Fin w → ZMod 2) → DynamicCircuit Var n) :
    List (Fin w) → (Fin w → ZMod 2) → DynamicCircuit Var n
  | [], r => leaf r
  | i :: is, r =>
    .seq (.circuit (Circuit.H (T i))) (.seq (.measure v (QRegister.singleton (T i)))
      (.qIf (fun σ ↦ σ v = 1)
        (.seq (.circuit (Circuit.X (T i)))
          (lkMbuTree v T leaf is (fun j ↦ r j + if j = i then 1 else 0)))
        (lkMbuTree v T leaf is r)))

theorem lkMbuTree_eq {w : ℕ} (v : TableLookup.Var) (T : Fin w → Wire n)
    (leaf : (Fin w → ZMod 2) → DynamicCircuit TableLookup.Var n)
    (is : List (Fin w)) (r : Fin w → ZMod 2) :
    lkMbuTree v T leaf is r = MbuImpl.mbuTree v T leaf is r := by
  induction is generalizing r with
  | nil => rfl
  | cons i is ih => simp only [lkMbuTree, MbuImpl.mbuTree, ih] -- CHECK

theorem lkMbuTree_kraus {Var : Type} {w : ℕ} [DecidableEq Var] [NeZero (2 ^ n)]
    (v : Var) (T : Fin w → Wire n)
    (leaf : (Fin w → ZMod 2) → DynamicCircuit Var n)
    (dd : Fin w → BitAssignment n → ZMod 2) (Good : BitAssignment n → Prop)
    (hT : Function.Injective T)
    (hGood : ∀ γ i a, Good γ → Good (update γ (T i) a))
    (hdd : ∀ γ i j a, dd j (update γ (T i) a) = dd j γ)
    (hleaf : ∀ r, ∃ L, LowerKraus (leaf r).compile L ∧ ∀ γ, Good γ →
        L.mulVec (ket γ) = bitSign (∑ j, r j * dd j γ) • ket γ) :
    ∀ (is : List (Fin w)), is.Nodup → ∀ r, ∃ R, LowerKraus (lkMbuTree v T leaf is r).compile R ∧
      ∀ β, Good β → R.mulVec (ket β) =
        if (∀ i ∈ is, β (T i) = dd i β) then
          bitSign (∑ j, r j * dd j β) • ket (zeroL T is β) else 0 := by
  intro is
  induction is with
  | nil =>
    intro _ r
    obtain ⟨L, hK, hL⟩ := hleaf r
    refine ⟨L, hK, fun β hβ ↦ ?_⟩
    simp [zeroL, hL β hβ]
  | cons i is ih =>
    intro hnd r
    have hnd' := List.nodup_cons.mp hnd
    obtain ⟨R_G, hKG, hRG⟩ := ih hnd'.2 r
    obtain ⟨R_S, hKS, hRS⟩ := ih hnd'.2 (fun j ↦ r j + if j = i then 1 else 0)
    refine ⟨(sqrtHalf • (R_G * (QRegister.singleton (T i)).basisOutcomeProjector 0 +
        (R_S * (Circuit.X (T i)).eval.1) * (QRegister.singleton (T i)).basisOutcomeProjector 1)) *
        (Circuit.H (T i)).eval.1, ?_, ?_⟩
    · exact (lowerKraus_circuit (Circuit.H (T i))).qSeq
        (lowerKraus_measure_singleton_qIf2 v (T i)
          ((lowerKraus_circuit (Circuit.X (T i))).qSeq hKS) hKG) -- CHECK
    · intro β hβ
      have hne : ∀ j ∈ is, T j ≠ T i := fun j hj h ↦ hnd'.1 (hT h ▸ hj)
      have hβ0 : Good (update β (T i) 0) := hGood _ _ _ hβ
      have hH := ket_H (T i) β
      have hX : (Circuit.X (T i)).eval.1.mulVec (ket (update β (T i) 1)) =
          ket (update β (T i) 0) := by
        rw [ket_X, update_self, update_idem, one_add_one_zmod2]
      have hQ : (∀ j ∈ is, (update β (T i) 0) (T j) = dd j (update β (T i) 0)) ↔
          (∀ j ∈ is, β (T j) = dd j β) := by
        refine forall₂_congr fun j hj ↦ ?_
        rw [update_of_ne (hne j hj), hdd]
      have hsum : ∑ j, (r j + if j = i then 1 else 0) * dd j (update β (T i) 0) =
          ∑ j, r j * dd j β + dd i β := by
        simp only [hdd]
        exact sum_mask_step r i (fun j ↦ dd j β)
      have hsumr : ∑ j, r j * dd j (update β (T i) 0) = ∑ j, r j * dd j β := by
        simp only [hdd]
      have hRG0 := hRG _ hβ0
      have hRS0 := hRS _ hβ0
      rw [hsum] at hRS0
      rw [hsumr] at hRG0
      simp only [← Matrix.mulVec_mulVec, hH, Matrix.mulVec_smul, Matrix.smul_mulVec,
        Matrix.add_mulVec, Matrix.mulVec_add, ket_projector_zero, ket_projector_one, update_self,
        hX, ↓reduceIte, one_ne_zero, zero_ne_one, Matrix.mulVec_zero, add_zero, zero_add]
      by_cases hq : ∀ j ∈ is, β (T j) = dd j β
      · rw [if_pos (hQ.mpr hq)] at hRG0 hRS0
        rw [hRG0, hRS0, bitSign_add, mul_comm (bitSign (∑ j, r j * dd j β)) (bitSign (dd i β)),
          mul_smul]
        rw [Step.unand_scalar]
        simp only [List.mem_cons, forall_eq_or_imp, hq, and_true, zeroL]
        by_cases hb : β (T i) = dd i β <;> simp [hb] <;> (intro x hx h; exact absurd (hq x hx) h)
      · rw [if_neg (fun h ↦ hq (hQ.mp h))] at hRG0 hRS0
        rw [hRG0, hRS0]
        simp only [List.mem_cons, forall_eq_or_imp, hq, and_false, smul_zero, add_zero]
        simp

theorem lkMbuTree_count {Var : Type} {w : ℕ} (v : Var) (T : Fin w → Wire n)
    (leaf : (Fin w → ZMod 2) → DynamicCircuit Var n) {k : ℕ} (g : PrimitiveGate k) (b : ℕ)
    (hH : ∀ q : Wire n, (Circuit.H q).count g = 0) (hX : ∀ q : Wire n, (Circuit.X q).count g = 0)
    (hl : ∀ r, (leaf r).count g ≤ b) :
    ∀ (is : List (Fin w)) r, (lkMbuTree v T leaf is r).count g ≤ b := by
  intro is
  induction is with
  | nil => intro r; exact hl r
  | cons i is ih =>
    intro r
    simp only [lkMbuTree, DynamicCircuit.count, hH, hX, zero_add]
    exact Nat.max_le.mpr ⟨by simpa using ih (fun j ↦ r j + if j = i then 1 else 0), ih r⟩

/-- Compute the parity bit, apply its phase, and erase it. -/
def lkLeafCirc {Var : Type} (v : Var) (m s : ℕ) (f : ℕ → ℕ)
    (rXl : QRegister s n) (rXh rW : QRegister (m - s) n)
    (rD : QRegister (2 ^ s * 1) n) (ci : Wire n) : DynamicCircuit Var n :=
  .seq (compileList v (leafC m s f rXl rXh rW rD ci))
    (.seq (.circuit (Circuit.Z (dataBlock s 1 rD 0 0)))
      (compileList v (leafU m s f rXl rXh rW rD ci)))

theorem lkLeafCirc_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)]
    (v : Var) (m s : ℕ) (f : ℕ → ℕ)
    (rXl : QRegister s n) (rXh rW : QRegister (m - s) n)
    (rD : QRegister (2 ^ s * 1) n) (ci : Wire n)
    (hDl : rD.DisjointWires rXl) (hDh : rD.DisjointWires rXh) (hDW : rD.DisjointWires rW)
    (hhW : rXh.DisjointWires rW) (hiD : ci ∉ Set.range rD.wires)
    (hiXl : ci ∉ Set.range rXl.wires) :
    ∃ L, LowerKraus (lkLeafCirc v m s f rXl rXh rW rD ci).compile L ∧
      ∀ β : BitAssignment n, (∀ i, β (rD i) = 0) → (∀ i, β (rW i) = 0) → β ci = 0 →
        L.mulVec (ket β) = bitSign (tableBits 1 f
          ((localIdx rXl β : ℕ) + 2 ^ s * (localIdx rXh β : ℕ)) 0) • ket β := by
  obtain ⟨RC, hKC, hRC, -⟩ := exists_lowerKraus_compileList v
    (leafC m s f rXl rXh rW rD ci)
  obtain ⟨RU, hKU, hRU, -⟩ := exists_lowerKraus_compileList v
    (leafU m s f rXl rXh rW rD ci)
  refine ⟨RU * (Circuit.Z (dataBlock s 1 rD 0 0)).eval.1 * RC, ?_, ?_⟩
  · exact hKC.qSeq ((lowerKraus_circuit _).qSeq hKU)
  · intro β hD hW hci
    obtain ⟨β2, h1, h2, h3⟩ := runList_leaf m s f rXl rXh rW rD ci hDl hDh hDW hhW hiD hiXl β
      hD hW hci
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hRC _ _ h1, ket_Z, h2,
      Matrix.mulVec_smul, hRU _ _ h3]

theorem lkLeafCirc_count_T {Var : Type} (v : Var) (m s : ℕ) (hs : s ≤ m) (f : ℕ → ℕ)
    (rXl : QRegister s n) (rXh rW : QRegister (m - s) n)
    (rD : QRegister (2 ^ s * 1) n) (ci : Wire n) :
    (lkLeafCirc v m s f rXl rXh rW rD ci).count PrimitiveGate.T ≤ ssT m 1 s := by
  have hC := count_T_compileList v (leafC m s f rXl rXh rW rD ci)
  have hU := count_T_compileList v (leafU m s f rXl rXh rW rD ci)
  have h1 : ac (lookupSteps (2 ^ s * 1) rD (m - s) none rXh rW (wideTab s 1 f)) ≤
      2 ^ (m - s) - 1 := andCount_lookupSteps _ _ _ _ _ _ _
  have h2 := ac_swapTree ci 1 (dataBlock s 1 rD) s rXl
  have h3 : ac ((swapTree ci 1 (dataBlock s 1 rD) s rXl).reverse.map Step.inv) + 1 =
      2 ^ s * 1 := aci_swapTree ci 1 (dataBlock s 1 rD) s rXl
  have eC : ((leafC m s f rXl rXh rW rD ci).map Step.andCount).sum =
      ac (lookupSteps (2 ^ s * 1) rD (m - s) none rXh rW (wideTab s 1 f)) +
        ac (swapTree ci 1 (dataBlock s 1 rD) s rXl) := ac_append _ _
  have eU : ((leafU m s f rXl rXh rW rD ci).map Step.andCount).sum =
      ac ((swapTree ci 1 (dataBlock s 1 rD) s rXl).reverse.map Step.inv) +
        ac (lookupSteps (2 ^ s * 1) rD (m - s) none rXh rW (wideTab s 1 f)) := ac_append _ _
  have h4 : 8 * (2 ^ s - 1) * 1 + 8 = 8 * (2 ^ s * 1) := by
    obtain ⟨k, hk⟩ : ∃ k, 2 ^ s = k + 1 := ⟨2 ^ s - 1, by have := @Nat.one_le_two_pow s; omega⟩
    rw [hk, Nat.add_sub_cancel]
    ring
  have hz : (Circuit.Z (dataBlock s 1 rD 0 0)).count PrimitiveGate.T = 0 := by simp
  simp only [lkLeafCirc, DynamicCircuit.count, hz] at *
  unfold ssT
  rw [eC] at hC
  rw [eU] at hU
  omega

theorem lkLeafCirc_count_TOFF {Var : Type} (v : Var) (m s : ℕ) (f : ℕ → ℕ)
    (rXl : QRegister s n) (rXh rW : QRegister (m - s) n)
    (rD : QRegister (2 ^ s * 1) n) (ci : Wire n) :
    (lkLeafCirc v m s f rXl rXh rW rD ci).count PrimitiveGate.TOFF = 0 := by
  have hz : (Circuit.Z (dataBlock s 1 rD 0 0)).count PrimitiveGate.TOFF = 0 := by simp
  simp only [lkLeafCirc, DynamicCircuit.count, hz, count_TOFF_compileList]

/-- The phase leaf on the second workspace of the select-swap lookup. -/
def lkMbl2Leaf {Var : Type} (v : Var) (p : LookupParams) (s s2 : ℕ)
    (hs : s ≤ p.m) (hs2 : s2 ≤ p.m)
    (data : LookupTable p) (rData : QRegister (p.m + p.w) n) {N : ℕ} (rAnc : QRegister N n)
    (hN : 2 ^ s * p.w + (p.m - s) + 1 + (2 ^ s2 * 1 + (p.m - s2) + 1) ≤ N)
    (r : Fin (2 ^ s * p.w) → ZMod 2) : DynamicCircuit Var n :=
  lkLeafCirc v p.m s2 (gTab2 p s (fTab data) r)
    ((rData.slice p.w p.m (by omega)).slice 0 s2 (by omega))
    ((rData.slice p.w p.m (by omega)).slice s2 (p.m - s2) (by omega))
    (rAnc.slice (2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1) (p.m - s2) (by omega))
    (rAnc.slice (2 ^ s * p.w + (p.m - s) + 1) (2 ^ s2 * 1) (by omega))
    (rAnc ⟨2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1 + (p.m - s2), by omega⟩)

end

