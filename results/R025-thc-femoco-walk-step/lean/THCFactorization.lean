variable {n : ℕ}

/-! ## Index-projector helpers (the public ones come from `QC14.SelectRows`) -/

private theorem idxProj_conjTranspose (N bI r : ℕ) (hr : r < 2 ^ bI) :
    (idxProj N bI r hr)ᴴ = idxProj N bI r hr :=
  QRegister.basisOutcomeProjector_conjTranspose _ _

private theorem idxProj_comm_X (N bI r : ℕ) (hr : r < 2 ^ bI) (A : Operator (2 ^ (2 * N))) :
    idxProj N bI r hr * ((sysReg N bI).embedMatrix A - 1) =
      ((sysReg N bI).embedMatrix A - 1) * idxProj N bI r hr := by
  rw [Matrix.mul_sub, Matrix.sub_mul, idxProj_comm_sys, Matrix.mul_one, Matrix.one_mul]

private theorem sum_mul_sum' {M : Type*} [NonUnitalNonAssocSemiring M] {ι : Type*} [Fintype ι]
    (T : ι → M) : (∑ j, T j) * (∑ j, T j) = ∑ i, ∑ j, T i * T j := by
  rw [Finset.sum_mul]
  exact Finset.sum_congr rfl fun i _ ↦ by rw [Finset.mul_sum]

private theorem T_mul (N bI : ℕ) (i j : Fin (2 ^ bI)) (A B : Operator (2 ^ (2 * N))) :
    idxProj N bI i.val i.2 * (sysReg N bI).embedMatrix A *
        (idxProj N bI j.val j.2 * (sysReg N bI).embedMatrix B) =
      (idxProj N bI i.val i.2 * idxProj N bI j.val j.2) * (sysReg N bI).embedMatrix (A * B) := by
  rw [QRegister.embedMatrix_mul]
  calc _ = idxProj N bI i.val i.2 * ((sysReg N bI).embedMatrix A * idxProj N bI j.val j.2) *
          (sysReg N bI).embedMatrix B := by simp only [Matrix.mul_assoc]
    _ = idxProj N bI i.val i.2 * (idxProj N bI j.val j.2 * (sysReg N bI).embedMatrix A) *
          (sysReg N bI).embedMatrix B := by rw [← idxProj_comm_sys N bI j.val j.2 A]
    _ = _ := by simp only [Matrix.mul_assoc]

/-! ## The orbital reflection is Hermitian and squares to one -/

private theorem s_neg_one_pow (e : ℕ) : ((-1 : ℂ) ^ e) * (-1 : ℂ) ^ e = 1 := by
  rw [← mul_pow]; norm_num

private theorem s_sign_mul_self (N : ℕ) (σ : Fin 2) :
    diagonal (parityFixSign N σ) * diagonal (parityFixSign N σ) = 1 := by
  rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
  congr 1
  funext i
  exact s_neg_one_pow _

private theorem s_sign_conjTranspose (N : ℕ) (σ : Fin 2) :
    (diagonal (parityFixSign N σ))ᴴ = diagonal (parityFixSign N σ) := by
  rw [Matrix.diagonal_conjTranspose]
  congr 1
  funext i
  simp [parityFixSign, star_pow]

private theorem herm_sq_embed {k m : ℕ} (r : QRegister k m)
    (Z : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ) (hh : Zᴴ = Z) (hs : Z * Z = 1) :
    (r.embedMatrix Z)ᴴ = r.embedMatrix Z ∧ r.embedMatrix Z * r.embedMatrix Z = 1 := by
  refine ⟨?_, ?_⟩
  · rw [← QRegister.embedMatrix_conjTranspose, hh]
  · rw [← QRegister.embedMatrix_mul, hs, QRegister.embedMatrix_one]

private theorem zq_h : (Qubit.Z.1 : Matrix (Fin (2 ^ 1)) (Fin (2 ^ 1)) ℂ)ᴴ = Qubit.Z.1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Qubit.Z]

private theorem zq_s : (Qubit.Z.1 : Matrix (Fin (2 ^ 1)) (Fin (2 ^ 1)) ℂ) * Qubit.Z.1 = 1 := by
  first
    | exact congrArg Subtype.val Qubit.Z_sq
    | (ext i j
       fin_cases i <;> fin_cases j <;> simp [Qubit.Z, Matrix.mul_apply, Fin.sum_univ_two])

private theorem embZ (N : ℕ) (w : Wire N) :
    ((QRegister.singleton w).embedMatrix Qubit.Z.1)ᴴ = (QRegister.singleton w).embedMatrix Qubit.Z.1 ∧
      (QRegister.singleton w).embedMatrix Qubit.Z.1 * (QRegister.singleton w).embedMatrix Qubit.Z.1 = 1 :=
  herm_sq_embed _ _ zq_h zq_s

private theorem refl_abstract {d : Type*} [Fintype d] [DecidableEq d] (D A B C : Matrix d d ℂ)
    (hDD : D * D = 1) (hDh : Dᴴ = D) (hBB : B * B = 1) (hBh : Bᴴ = B)
    (hA : Aᴴ = C) (hCA : C * A = 1) (hAC : A * C = 1) :
    (D * A * B * (C * D))ᴴ = D * A * B * (C * D) ∧
      (D * A * B * (C * D)) * (D * A * B * (C * D)) = 1 := by
  have hC : Cᴴ = A := by rw [← hA, Matrix.conjTranspose_conjTranspose]
  constructor
  · simp only [Matrix.conjTranspose_mul, hDh, hBh, hA, hC]
    simp only [Matrix.mul_assoc]
  · calc D * A * B * (C * D) * (D * A * B * (C * D))
        = D * A * B * (C * (D * D) * A) * B * (C * D) := by simp only [Matrix.mul_assoc]
      _ = D * A * B * (C * A) * B * (C * D) := by rw [hDD, Matrix.mul_one]
      _ = D * A * (B * B) * (C * D) := by
          rw [hCA]; simp only [Matrix.mul_one, Matrix.mul_assoc]
      _ = D * (A * C) * D := by
          rw [hBB]; simp only [Matrix.mul_one, Matrix.mul_assoc]
      _ = 1 := by rw [hAC, Matrix.mul_one, hDD]

private theorem refl_core {N : ℕ} (σ : Fin 2) (U Zm : Operator (2 ^ N))
    (R : Operator (2 ^ (2 * N))) (hUU : U * Uᴴ = 1) (hUU' : Uᴴ * U = 1) (hZh : Zmᴴ = Zm)
    (hZZ : Zm * Zm = 1)
    (hR : R = diagonal (parityFixSign N σ) * (spinReg N σ).embedMatrix (Uᴴ * Zm * U) *
      diagonal (parityFixSign N σ)) :
    Rᴴ = R ∧ R * R = 1 := by
  have hA : ((spinReg N σ).embedMatrix Uᴴ)ᴴ = (spinReg N σ).embedMatrix U := by
    rw [← QRegister.embedMatrix_conjTranspose, Matrix.conjTranspose_conjTranspose]
  have hCA : (spinReg N σ).embedMatrix U * (spinReg N σ).embedMatrix Uᴴ = 1 := by
    rw [← QRegister.embedMatrix_mul, hUU, QRegister.embedMatrix_one]
  have hAC : (spinReg N σ).embedMatrix Uᴴ * (spinReg N σ).embedMatrix U = 1 := by
    rw [← QRegister.embedMatrix_mul, hUU', QRegister.embedMatrix_one]
  obtain ⟨hBh, hBB⟩ := herm_sq_embed (spinReg N σ) Zm hZh hZZ
  have hR' : R = diagonal (parityFixSign N σ) * (spinReg N σ).embedMatrix Uᴴ *
      (spinReg N σ).embedMatrix Zm *
      ((spinReg N σ).embedMatrix U * diagonal (parityFixSign N σ)) := by
    rw [hR, QRegister.embedMatrix_mul, QRegister.embedMatrix_mul]
    simp only [Matrix.mul_assoc]
  rw [hR']
  exact refl_abstract _ _ _ _ (s_sign_mul_self N σ) (s_sign_conjTranspose N σ) hBB hBh hA hCA hAC

theorem orbitalReflection_leaf_herm_sq (N : ℕ) [NeZero N] (beth : ℕ) (k : Fin N → ℤ) (σ : Fin 2) :
    (orbitalReflection N (givensLeaf beth k) σ)ᴴ = orbitalReflection N (givensLeaf beth k) σ ∧
      orbitalReflection N (givensLeaf beth k) σ * orbitalReflection N (givensLeaf beth k) σ = 1 := by
  have hz := givensCascadeUnitary_conj_pauliZ0 N beth k
  simp only at hz
  have hUU : (givensCascadeUnitary N beth k).1 * (givensCascadeUnitary N beth k).1ᴴ = 1 := by
    rw [← Matrix.star_eq_conjTranspose]
    exact (givensCascadeUnitary N beth k).2.2
  have hUU' : (givensCascadeUnitary N beth k).1ᴴ * (givensCascadeUnitary N beth k).1 = 1 := by
    rw [← Matrix.star_eq_conjTranspose]
    exact (givensCascadeUnitary N beth k).2.1
  have hR := orbitalReflection_eq_parityFix N (givensLeaf beth k) σ
  rw [← hz] at hR
  exact refl_core σ _ _ _ hUU hUU' (embZ N _).1 (embZ N _).2 hR

/-! ## Rows and the SELECT operator -/

/-- Row `r = 2ℓ + σ`: `(-1)^{s ℓ} R_{k ℓ, σ}`. -/
noncomputable def rowVL {N L : ℕ} (beth : ℕ) (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (r : Fin (2 * L)) : Operator (2 ^ (2 * N)) :=
  (if s ⟨r.val / 2, by omega⟩ then (-1 : ℂ) else 1) •
    orbitalReflection N (givensLeaf beth (k ⟨r.val / 2, by omega⟩)) ⟨r.val % 2, by omega⟩

private theorem sum_fin_extend {M : Type*} [AddCommMonoid M] {a b : ℕ} (h : a ≤ b)
    (f : Fin a → M) (g : Fin b → M) (hg : ∀ j : Fin b, a ≤ j.val → g j = 0)
    (hfg : ∀ i : Fin a, f i = g (Fin.castLE h i)) : ∑ i, f i = ∑ j, g j := by
  rw [← Finset.sum_subset (Finset.subset_univ (Finset.univ.image (Fin.castLE h)))
    (fun j _ hj ↦ hg j (by
      by_contra hlt
      exact hj (Finset.mem_image.mpr ⟨⟨j.val, by omega⟩, Finset.mem_univ _,
        Fin.ext (by first | rfl | simp)⟩))),
    Finset.sum_image (fun x _ y _ hxy ↦ Fin.castLE_injective h hxy)]
  exact Finset.sum_congr rfl fun i _ ↦ hfg i

/-- The block operator for index value `j`: `rowVL j` for `j < 2L`, else the identity. -/
noncomputable def selWL {N L : ℕ} (beth bI : ℕ) (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (j : Fin (2 ^ bI)) : Operator (2 ^ (2 * N)) :=
  if h : j.val < 2 * L then rowVL beth k s ⟨j.val, h⟩ else 1

private theorem rowVL_herm_sq {N L : ℕ} [NeZero N] (beth : ℕ) (k : Fin L → Fin N → ℤ)
    (s : Fin L → Bool) (r : Fin (2 * L)) :
    (rowVL beth k s r)ᴴ = rowVL beth k s r ∧ rowVL beth k s r * rowVL beth k s r = 1 := by
  obtain ⟨h1, h2⟩ := orbitalReflection_leaf_herm_sq N beth (k ⟨r.val / 2, by omega⟩)
    ⟨r.val % 2, by omega⟩
  unfold rowVL
  constructor
  · split_ifs <;> simp [Matrix.conjTranspose_smul, h1]
  · split_ifs <;> simp [Matrix.smul_mul, Matrix.mul_smul, smul_smul, h2]

theorem selWL_conjTranspose {N L : ℕ} [NeZero N] (beth bI : ℕ) (k : Fin L → Fin N → ℤ)
    (s : Fin L → Bool) (j : Fin (2 ^ bI)) : (selWL beth bI k s j)ᴴ = selWL beth bI k s j := by
  unfold selWL
  by_cases h : j.val < 2 * L
  · rw [dif_pos h]
    exact (rowVL_herm_sq beth k s _).1
  · rw [dif_neg h]
    exact Matrix.conjTranspose_one

theorem selWL_mul_self {N L : ℕ} [NeZero N] (beth bI : ℕ) (k : Fin L → Fin N → ℤ)
    (s : Fin L → Bool) (j : Fin (2 ^ bI)) : selWL beth bI k s j * selWL beth bI k s j = 1 := by
  unfold selWL
  by_cases h : j.val < 2 * L
  · rw [dif_pos h]
    exact (rowVL_herm_sq beth k s _).2
  · rw [dif_neg h]
    exact Matrix.one_mul _

/-- `1 + Σ_{r < m} P_r (sys V_r - 1)`. -/
noncomputable def selectPrefixOpL (N L bI beth : ℕ) (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (h2L : 2 * L ≤ 2 ^ bI) (m : ℕ) : Operator (2 ^ (2 * N + bI)) :=
  1 + ∑ r ∈ univ.filter (fun r : Fin (2 * L) ↦ r.val < m),
    idxProj N bI r.val (by omega) * ((sysReg N bI).embedMatrix (rowVL beth k s r) - 1)

/-- The SELECT operator `1 + Σ_r P_r (sys V_r - 1)`. -/
noncomputable def selectOpL (N L bI beth : ℕ) (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (h2L : 2 * L ≤ 2 ^ bI) : Operator (2 ^ (2 * N + bI)) :=
  selectPrefixOpL N L bI beth k s h2L (2 * L)

theorem selectOpL_eq_sum (N L bI beth : ℕ) (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (h2L : 2 * L ≤ 2 ^ bI) :
    selectOpL N L bI beth k s h2L =
      ∑ j : Fin (2 ^ bI), idxProj N bI j.val j.2 * (sysReg N bI).embedMatrix (selWL beth bI k s j) := by
  have hsum : ∑ j : Fin (2 ^ bI),
        idxProj N bI j.val j.2 * (sysReg N bI).embedMatrix (selWL beth bI k s j) =
      1 + ∑ j : Fin (2 ^ bI),
        idxProj N bI j.val j.2 * ((sysReg N bI).embedMatrix (selWL beth bI k s j) - 1) := by
    calc _ = ∑ j : Fin (2 ^ bI), (idxProj N bI j.val j.2 +
            idxProj N bI j.val j.2 * ((sysReg N bI).embedMatrix (selWL beth bI k s j) - 1)) :=
          Finset.sum_congr rfl fun j _ ↦ by rw [Matrix.mul_sub, Matrix.mul_one]; abel
      _ = (∑ j : Fin (2 ^ bI), idxProj N bI j.val j.2) + ∑ j : Fin (2 ^ bI),
            idxProj N bI j.val j.2 * ((sysReg N bI).embedMatrix (selWL beth bI k s j) - 1) :=
          Finset.sum_add_distrib
      _ = _ := by rw [sum_idxProj]
  rw [hsum]
  have hfilt : (univ.filter (fun r : Fin (2 * L) ↦ r.val < 2 * L)) = univ :=
    Finset.filter_true_of_mem fun r _ ↦ r.2
  unfold selectOpL selectPrefixOpL
  rw [hfilt]
  congr 1
  refine sum_fin_extend h2L _ _ ?_ ?_
  · intro j hj
    show idxProj N bI j.val j.2 * ((sysReg N bI).embedMatrix (selWL beth bI k s j) - 1) = 0
    have hn : ¬ j.val < 2 * L := by omega
    have h1 : selWL beth bI k s j = 1 := dif_neg hn
    rw [h1, QRegister.embedMatrix_one, sub_self, Matrix.mul_zero]
  · intro i
    have hlt : (Fin.castLE h2L i).val < 2 * L := i.2
    have e : selWL beth bI k s (Fin.castLE h2L i) = rowVL beth k s i := by
      exact dif_pos hlt
    exact congrArg (fun X ↦ idxProj N bI i.val (by omega) * ((sysReg N bI).embedMatrix X - 1))
      e.symm

theorem selectOpL_mem (N L bI beth : ℕ) [NeZero N] (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (h2L : 2 * L ≤ 2 ^ bI) :
    selectOpL N L bI beth k s h2L ∈ Matrix.unitaryGroup (Fin (2 ^ (2 * N + bI))) ℂ := by
  rw [selectOpL_eq_sum, Matrix.mem_unitaryGroup_iff, Matrix.star_eq_conjTranspose]
  have hh : (∑ j : Fin (2 ^ bI),
        idxProj N bI j.val j.2 * (sysReg N bI).embedMatrix (selWL beth bI k s j))ᴴ =
      ∑ j : Fin (2 ^ bI),
        idxProj N bI j.val j.2 * (sysReg N bI).embedMatrix (selWL beth bI k s j) := by
    rw [Matrix.conjTranspose_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [Matrix.conjTranspose_mul, ← QRegister.embedMatrix_conjTranspose, selWL_conjTranspose,
      idxProj_conjTranspose]
    exact (idxProj_comm_sys N bI j.val j.2 _).symm
  have hdiag : ∀ i : Fin (2 ^ bI), ∑ j : Fin (2 ^ bI),
      (idxProj N bI i.val i.2 * (sysReg N bI).embedMatrix (selWL beth bI k s i)) *
        (idxProj N bI j.val j.2 * (sysReg N bI).embedMatrix (selWL beth bI k s j)) =
      idxProj N bI i.val i.2 := by
    intro i
    rw [Finset.sum_eq_single i]
    · rw [T_mul, idxProj_mul_self, selWL_mul_self, QRegister.embedMatrix_one, Matrix.mul_one]
    · intro j _ hj
      rw [T_mul, idxProj_mul_of_ne N bI i.val j.val i.2 j.2 (fun h ↦ hj (Fin.ext h.symm)),
        Matrix.zero_mul]
    · intro h
      exact absurd (Finset.mem_univ i) h
  rw [hh]
  exact (sum_mul_sum' _).trans ((Finset.sum_congr rfl fun i _ ↦ hdiag i).trans (sum_idxProj N bI))

private theorem prod_zero {M : Type*} [Ring M] (Pm Pr Xm Xr : M) (hc : Pr * Xm = Xm * Pr)
    (h0 : Pm * Pr = 0) : Pm * Xm * (Pr * Xr) = 0 := by
  calc Pm * Xm * (Pr * Xr) = Pm * (Xm * Pr) * Xr := by simp only [mul_assoc]
    _ = Pm * (Pr * Xm) * Xr := by rw [hc]
    _ = (Pm * Pr) * Xm * Xr := by simp only [mul_assoc]
    _ = 0 := by rw [h0]; simp

private theorem one_add_mul {M : Type*} [Ring M] (A B : M) (h : A * B = 0) :
    (1 + A) * (1 + B) = 1 + (A + B) := by
  calc (1 + A) * (1 + B) = 1 + A + B + A * B := by
        noncomm_ring
    _ = 1 + (A + B) := by rw [h]; abel

/-- One more row: `ctrlOp m V_m * prefix(m) = prefix(m+1)`. -/
theorem ctrlOp_mul_selectPrefixOpL (N L bI beth : ℕ) (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (h2L : 2 * L ≤ 2 ^ bI) (m : ℕ) (hm : m < 2 * L) :
    ctrlOp N bI m (by omega) (rowVL beth k s ⟨m, hm⟩) * selectPrefixOpL N L bI beth k s h2L m =
      selectPrefixOpL N L bI beth k s h2L (m + 1) := by
  have hF : (univ.filter (fun r : Fin (2 * L) ↦ r.val < m + 1)) =
      insert (⟨m, hm⟩ : Fin (2 * L)) (univ.filter (fun r : Fin (2 * L) ↦ r.val < m)) := by
    ext r
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert, Fin.ext_iff,
      Fin.val_mk]
    omega
  have hnot : (⟨m, hm⟩ : Fin (2 * L)) ∉ (univ.filter (fun r : Fin (2 * L) ↦ r.val < m)) := by
    simp
  have hAB : (idxProj N bI m (by omega) * ((sysReg N bI).embedMatrix (rowVL beth k s ⟨m, hm⟩) - 1)) *
      ∑ r ∈ univ.filter (fun r : Fin (2 * L) ↦ r.val < m),
        idxProj N bI r.val (by omega) * ((sysReg N bI).embedMatrix (rowVL beth k s r) - 1) = 0 := by
    rw [Finset.mul_sum]
    apply Finset.sum_eq_zero
    intro r hr
    have hrm : r.val ≠ m := by
      have := (Finset.mem_filter.mp hr).2
      omega
    exact prod_zero _ _ _ _ (idxProj_comm_X N bI r.val (by omega) _)
      (idxProj_mul_of_ne N bI m r.val (by omega) (by omega) (Ne.symm hrm))
  unfold selectPrefixOpL ctrlOp
  rw [hF, Finset.sum_insert hnot]
  exact one_add_mul _ _ hAB

/-! ## The SELECT program -/

/-- Rows `0, …, m-1` in sequence. For `N = 0` the program is the identity. -/
noncomputable def selectPrefixL {Var : Type} (v : Var) (beth : ℕ) {N L bI : ℕ}
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rA : QRegister (bI + 1) n) (rK : QRegister (2 * beth) n) (rCat : QRegister beth n)
    (hTA : ∀ i j, rTI i ≠ rA j) (hcT : rCat.DisjointWires rTI) :
    (m : ℕ) → m ≤ 2 * L → DynamicCircuit Var n
  | 0, _ => .circuit .identity
  | m + 1, h =>
      if hN : N = 0 then .circuit .identity else
        haveI : NeZero N := ⟨hN⟩
        .seq (selectPrefixL v beth k s rTI rA rK rCat hTA hcT m (by omega))
          (rowProgram v beth (k ⟨m / 2, by omega⟩) ⟨m % 2, by omega⟩ m (s ⟨m / 2, by omega⟩)
            rTI rA rK rCat hTA hcT)

/-- SELECT: all `2L` rows. -/
noncomputable def selectL {Var : Type} (v : Var) (beth : ℕ) {N L bI : ℕ}
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rA : QRegister (bI + 1) n) (rK : QRegister (2 * beth) n) (rCat : QRegister beth n)
    (hTA : ∀ i j, rTI i ≠ rA j) (hcT : rCat.DisjointWires rTI) : DynamicCircuit Var n :=
  selectPrefixL v beth k s rTI rA rK rCat hTA hcT (2 * L) le_rfl

private theorem selectPrefixL_succ {Var : Type} (v : Var) (beth : ℕ) {N L bI : ℕ} [NeZero N]
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rA : QRegister (bI + 1) n) (rK : QRegister (2 * beth) n) (rCat : QRegister beth n)
    (hTA : ∀ i j, rTI i ≠ rA j) (hcT : rCat.DisjointWires rTI) (m : ℕ) (h : m + 1 ≤ 2 * L) :
    selectPrefixL v beth k s rTI rA rK rCat hTA hcT (m + 1) h =
      .seq (selectPrefixL v beth k s rTI rA rK rCat hTA hcT m (by omega))
        (rowProgram v beth (k ⟨m / 2, by omega⟩) ⟨m % 2, by omega⟩ m (s ⟨m / 2, by omega⟩)
          rTI rA rK rCat hTA hcT) := by
  have hN : ¬ N = 0 := NeZero.ne N
  rw [selectPrefixL, dif_neg hN]

theorem selectPrefixL_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var)
    (beth : ℕ) {N L bI : ℕ} [NeZero N] (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (h2L : 2 * L ≤ 2 ^ bI) (rTI : QRegister (2 * N + bI) n) (rA : QRegister (bI + 1) n)
    (rK : QRegister (2 * beth) n) (rCat : QRegister beth n) (hTA : ∀ i j, rTI i ≠ rA j)
    (hcT : rCat.DisjointWires rTI) (hAK : rA.DisjointWires rK)
    (hsc : (rA.concat rK hAK).DisjointWires rCat)
    (hdisj : rTI.DisjointWires ((rA.concat rK hAK).concat rCat hsc)) (m : ℕ) (hm : m ≤ 2 * L) :
    ∃ U : Unitary (2 ^ (2 * N + bI)),
      U.1 = selectPrefixOpL N L bI beth k s h2L m ∧
      CatKet rTI (rA.concat rK hAK) rCat hsc
        (selectPrefixL v beth k s rTI rA rK rCat hTA hcT m hm).compile U := by
  induction m with
  | zero =>
      have h := CatKet.circuit (Var := Var) rTI (rA.concat rK hAK) rCat hsc
        (Circuit.identity : Circuit (2 * N + bI))
      refine ⟨Circuit.eval Circuit.identity, ?_, ?_⟩
      · simp [selectPrefixOpL]
      · have e : selectPrefixL v beth k s rTI rA rK rCat hTA hcT 0 hm =
            .circuit Circuit.identity := rfl
        rw [e]
        simp only [DynamicCircuit.compile_circuit]
        exact h
  | succ m ih =>
      obtain ⟨Up, hUp, hcp⟩ := ih (by omega)
      obtain ⟨Ur, hUr, hcr⟩ := row_catKet v beth (k ⟨m / 2, by omega⟩) ⟨m % 2, by omega⟩ m
        (by omega) (s ⟨m / 2, by omega⟩) rTI rA rK rCat hTA hcT hAK hsc hdisj
      refine ⟨Ur * Up, ?_, ?_⟩
      · have e : (Ur * Up).1 = Ur.1 * Up.1 := rfl
        rw [e, hUr, hUp]
        exact ctrlOp_mul_selectPrefixOpL N L bI beth k s h2L m (by omega)
      · rw [selectPrefixL_succ v beth k s rTI rA rK rCat hTA hcT m hm]
        simp only [DynamicCircuit.compile_seq]
        exact CatKet.seq hdisj hcp hcr

theorem selectL_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var)
    (beth : ℕ) {N L bI : ℕ} [NeZero N] (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (h2L : 2 * L ≤ 2 ^ bI) (rTI : QRegister (2 * N + bI) n) (rA : QRegister (bI + 1) n)
    (rK : QRegister (2 * beth) n) (rCat : QRegister beth n) (hTA : ∀ i j, rTI i ≠ rA j)
    (hcT : rCat.DisjointWires rTI) (hAK : rA.DisjointWires rK)
    (hsc : (rA.concat rK hAK).DisjointWires rCat)
    (hdisj : rTI.DisjointWires ((rA.concat rK hAK).concat rCat hsc)) :
    ∃ U : Unitary (2 ^ (2 * N + bI)),
      U.1 = selectOpL N L bI beth k s h2L ∧
      CatKet rTI (rA.concat rK hAK) rCat hsc
        (selectL v beth k s rTI rA rK rCat hTA hcT).compile U :=
  selectPrefixL_catKet v beth k s h2L rTI rA rK rCat hTA hcT hAK hsc hdisj (2 * L) le_rfl

private theorem selectPrefixL_count {Var : Type} (v : Var) (beth : ℕ) {N L bI : ℕ} [NeZero N]
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rA : QRegister (bI + 1) n) (rK : QRegister (2 * beth) n) (rCat : QRegister beth n)
    (hTA : ∀ i j, rTI i ≠ rA j) (hcT : rCat.DisjointWires rTI) (m : ℕ) (hm : m ≤ 2 * L) :
    (selectPrefixL v beth k s rTI rA rK rCat hTA hcT m hm).count PrimitiveGate.TOFF = 0 ∧
      (selectPrefixL v beth k s rTI rA rK rCat hTA hcT m hm).count PrimitiveGate.T ≤
        m * (16 * (N - 1) * (beth - 1) + 8 * bI) := by
  induction m with
  | zero =>
      have e : selectPrefixL v beth k s rTI rA rK rCat hTA hcT 0 hm =
          .circuit Circuit.identity := rfl
      rw [e]
      exact ⟨by simp [DynamicCircuit.count, Circuit.count_identity],
        by simp [DynamicCircuit.count, Circuit.count_identity]⟩
  | succ m ih =>
      obtain ⟨h1, h2⟩ := ih (by omega)
      obtain ⟨r1, r2⟩ := row_count v beth (k ⟨m / 2, by omega⟩) ⟨m % 2, by omega⟩ m
        (s ⟨m / 2, by omega⟩) rTI rA rK rCat hTA hcT
      rw [selectPrefixL_succ v beth k s rTI rA rK rCat hTA hcT m hm]
      simp only [DynamicCircuit.count]
      refine ⟨by omega, ?_⟩
      calc _ ≤ m * (16 * (N - 1) * (beth - 1) + 8 * bI) +
            (16 * (N - 1) * (beth - 1) + 8 * bI) := Nat.add_le_add h2 r2
        _ = (m + 1) * (16 * (N - 1) * (beth - 1) + 8 * bI) := by ring

theorem selectL_count {Var : Type} (v : Var) (beth : ℕ) {N L bI : ℕ} [NeZero N]
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rA : QRegister (bI + 1) n) (rK : QRegister (2 * beth) n) (rCat : QRegister beth n)
    (hTA : ∀ i j, rTI i ≠ rA j) (hcT : rCat.DisjointWires rTI) :
    (selectL v beth k s rTI rA rK rCat hTA hcT).count PrimitiveGate.TOFF = 0 ∧
      (selectL v beth k s rTI rA rK rCat hTA hcT).count PrimitiveGate.T ≤
        2 * L * (16 * (N - 1) * (beth - 1) + 8 * bI) :=
  selectPrefixL_count v beth k s rTI rA rK rCat hTA hcT (2 * L) le_rfl

/-- With `L = N` leaves the operator is the one of `QC14.SelectRows`. -/
theorem selectOpL_self (N bI beth : ℕ) (k : Fin N → Fin N → ℤ) (s : Fin N → Bool)
    (h : 2 * N ≤ 2 ^ bI) :
    selectOpL N N bI beth k s h = QC14.SelectRows.selectOp N bI beth k s h := rfl


end QC14.SelectL


