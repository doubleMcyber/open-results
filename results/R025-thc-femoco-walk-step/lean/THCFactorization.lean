    zeta2 thc a b = zeta2 thc b a := by
  unfold zeta2
  exact (thc.zeta_symm.apply _ _).symm

/-! ### Abstract algebra over a ring with a `ℂ`-algebra structure -/

private lemma center_abs {A : Type*} [Ring A] [Algebra ℂ A] {K : ℕ}
    (w : Fin K → Fin K → ℂ) (hw : ∀ i j, w i j = w j i) (n : Fin K → A) :
    (2 : ℂ)⁻¹ • ∑ i, ∑ j, w i j • (n i * n j) =
      (2 : ℂ)⁻¹ • ∑ i, ∑ j, w i j • n i - ((8 : ℂ)⁻¹ * ∑ i, ∑ j, w i j) • (1 : A) +
