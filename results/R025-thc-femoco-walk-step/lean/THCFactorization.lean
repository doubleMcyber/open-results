  have htr : ∑ σ : Fin 2, ∑ p : Fin N, ((g p p : ℂ) * (2 : ℂ)⁻¹) •
        (1 : Matrix (Fin (2 ^ (2 * N))) (Fin (2 ^ (2 * N))) ℂ) =
