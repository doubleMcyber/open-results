theorem selectR_count {Var : Type} (v : Var) (beth : ℕ) {N L bI : ℕ} [NeZero N] (hbI : 1 ≤ bI)
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selRScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    (selectR v beth hbI k s rTI rS rCat hsc hdisj).count PrimitiveGate.TOFF = 0 ∧
      (selectR v beth hbI k s rTI rS rCat hsc hdisj).count PrimitiveGate.T ≤
        16 * (N - 1) * (beth - 1) + 16 * N + selLkT bI (N * beth + 2) := by
