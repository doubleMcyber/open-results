variable {n : ℕ}

/-- `T` of the live-data alias PREPARE and PREPARE† together: one select-swap load, one measured
unlookup, the comparator gadgets of `aliasTM` twice. -/
def aliasTL (b g s : ℕ) : ℕ :=
  mbl2T s (b + (b + (g - s))) (lkSplit s (b + (b + (g - s)))) (s / 2) + ssT s 1 (s / 2) +
    2 * (32 * (g - s + 1) + 16 * b)

/-- `T` of one walk step of `pairProgramLR`: PREPARE and PREPARE† (`aliasTL`), the `CSWAP` tail
twice, SELECT. -/
abbrev pairTLR (N M aleph beth : ℕ) : ℕ :=
  aliasTL (bP N M) (gP N M aleph) (sA N M) + 2 * (8 * bIC N M) + selTR N M beth

/-- Scratch of the live-data pair program (worker-defined). -/
def scratchLR (N M aleph beth : ℕ) : ℕ :=
  ancPM N M aleph + selRScr N (bIC N M) beth + bP N M

/-- The live-data scratch contains the measured program's scratch (needed by `AssemblyE` for the
`beth < 2` branch). -/
theorem scratchLR_ge (N M aleph beth : ℕ) : scratchM N M aleph beth ≤ scratchLR N M aleph beth := by
  unfold scratchM scratchLR selRScr
  omega

/-! ### Layout

`rS` = PREPARE chain (`ancPM` wires, its first `aliasAncM` wires are the alias scratch) ++ SELECT
scratch (`selRScr`) ++ `Areg` (`bP` wires). `plDA` is `rData` with its index wires replaced by
`Areg`; the alias gadgets of `AliasCircuitM` run on `plDA`, so the load word `tt1` lands in
`(Areg, D, Kreg)` and the `b` Toffolis of `tofW` target `Areg`. After the gadgets `b` CNOTs
`index ⊕= Areg` copy the alias output into the index. -/

section Layout

open QC14.AliasCircuit QC14.LookupKraus

variable {N M aleph beth : ℕ}

theorem plAnc_le (N M aleph beth : ℕ) : 0 + ancPM N M aleph ≤ scratchLR N M aleph beth := by
  unfold scratchLR; omega

theorem plSel_le (N M aleph beth : ℕ) :
    ancPM N M aleph + selRScr N (bIC N M) beth ≤ scratchLR N M aleph beth := by
  unfold scratchLR; omega

theorem plA_le (N M aleph beth : ℕ) :
    ancPM N M aleph + selRScr N (bIC N M) beth + bP N M ≤ scratchLR N M aleph beth := by
  unfold scratchLR; omega

abbrev plAnc (rS : QRegister (scratchLR N M aleph beth) n) : QRegister (ancPM N M aleph) n :=
  rS.slice 0 (ancPM N M aleph) (plAnc_le N M aleph beth)

abbrev plSelS (rS : QRegister (scratchLR N M aleph beth) n) :
    QRegister (selRScr N (bIC N M) beth) n :=
  rS.slice (ancPM N M aleph) (selRScr N (bIC N M) beth) (plSel_le N M aleph beth)

abbrev plA (rS : QRegister (scratchLR N M aleph beth) n) : QRegister (bP N M) n :=
  rS.slice (ancPM N M aleph + selRScr N (bIC N M) beth) (bP N M) (plA_le N M aleph beth)

abbrev plAl (rS : QRegister (scratchLR N M aleph beth) n) :
    QRegister (aliasAncM (bP N M) (gP N M aleph) (sA N M)) n :=
  (plAnc rS).slice 0 _ (pmAlias_le N M aleph)

/-- The index wires of `rData`. -/
abbrev plI (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n) : QRegister (bP N M) n :=
  rData.slice (2 * N) (bP N M) (by omega)

theorem pl_inj {k : ℕ} (r : QRegister k n) {a c : ℕ} {ha : a < k} {hc : c < k}
    (h : r ⟨a, ha⟩ = r ⟨c, hc⟩) : a = c :=
  congrArg Fin.val (r.wires.injective h)

/-- `rData` with the index wires replaced by `Areg`. -/
def plDA (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchLR N M aleph beth) n) (hdR : ∀ i j, rData i ≠ rS j) :
    QRegister (2 * N + (bP N M + gP N M aleph)) n where
  wires := ⟨fun i ↦ if h : 2 * N ≤ i.val ∧ i.val < 2 * N + bP N M then
      rS ⟨ancPM N M aleph + selRScr N (bIC N M) beth + (i.val - 2 * N), by
        have := plA_le N M aleph beth; omega⟩
    else rData i, by
      intro i j hij
      dsimp only at hij
      by_cases hi : 2 * N ≤ i.val ∧ i.val < 2 * N + bP N M <;>
        by_cases hj : 2 * N ≤ j.val ∧ j.val < 2 * N + bP N M
      · rw [dif_pos hi, dif_pos hj] at hij
        have := pl_inj rS hij
        apply Fin.ext; omega
      · rw [dif_pos hi, dif_neg hj] at hij
        exact absurd hij.symm (hdR _ _)
      · rw [dif_neg hi, dif_pos hj] at hij
        exact absurd hij (hdR _ _)
      · rw [dif_neg hi, dif_neg hj] at hij
        exact rData.wires.injective hij⟩

variable (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
  (rS : QRegister (scratchLR N M aleph beth) n) (hdR : ∀ i j, rData i ≠ rS j)

theorem plDA_apply (i : Fin (2 * N + (bP N M + gP N M aleph))) :
    plDA rData rS hdR i = if h : 2 * N ≤ i.val ∧ i.val < 2 * N + bP N M then
      rS ⟨ancPM N M aleph + selRScr N (bIC N M) beth + (i.val - 2 * N), by
        have := plA_le N M aleph beth; omega⟩
    else rData i := rfl

theorem plDA_A (q : Fin (bP N M)) :
    plDA rData rS hdR ⟨2 * N + q.val, by have := q.isLt; omega⟩ = plA rS q := by
  rw [plDA_apply, dif_pos (show 2 * N ≤ 2 * N + q.val ∧ 2 * N + q.val < 2 * N + bP N M from
    ⟨by omega, by have := q.isLt; omega⟩), QRegister.slice_apply]
  exact congrArg rS (Fin.ext (by simp))

theorem plDA_R (i : Fin (2 * N + (bP N M + gP N M aleph)))
    (h : ¬ (2 * N ≤ i.val ∧ i.val < 2 * N + bP N M)) : plDA rData rS hdR i = rData i := by
  rw [plDA_apply, dif_neg h]

theorem plHd : ∀ i j, plDA rData rS hdR i ≠ amBase (plAl rS) j := by
  intro i j h
  rw [plDA_apply] at h
  split_ifs at h with hi
  · have h2 := pl_inj rS h
    have h3 := j.isLt
    have h4 := pmAlias_le N M aleph
    have h5 := aliasAnc_le_M (bP N M) (gP N M aleph) (sA N M)
    omega
  · exact hdR _ _ h

theorem plHdM : ∀ i j, plDA rData rS hdR i ≠ plAl rS j := by
  intro i j h
  rw [plDA_apply] at h
  split_ifs at h with hi
  · have h2 := pl_inj rS h
    have h3 := j.isLt
    have h4 := pmAlias_le N M aleph
    omega
  · exact hdR _ _ h

/-- Placement of the alias gadgets: `posOf` on `plDA`. -/
abbrev plPos : ℕ → Wire n := posOf (plDA rData rS hdR) (amBase (plAl rS))

theorem plPos_inj : ∀ p q, p < Lay.tot (2 * N) (bP N M) (gP N M aleph) →
    q < Lay.tot (2 * N) (bP N M) (gP N M aleph) → plPos rData rS hdR p = plPos rData rS hdR q →
      p = q :=
  posOf_inj _ _ (plHd rData rS hdR)

abbrev plW1 := Lay.W1 (sA_le_gP N M aleph) (plPos rData rS hdR) (plPos_inj rData rS hdR)
abbrev plW2 := Lay.W2 (sA_le_gP N M aleph) (plPos rData rS hdR) (plPos_inj rData rS hdR)

/-- The comparator gadgets and the `b` Toffolis (targets `Areg`). -/
abbrev plMid : Circuit n :=
  amMiddle (sA_le_gP N M aleph) (plPos rData rS hdR) (plPos_inj rData rS hdR)

end Layout

/-- `b` CNOTs `I ⊕= A`, wire by wire. -/
def plCx {k : ℕ} (A I : QRegister k n) (h : ∀ i j, A i ≠ I j) : ℕ → Circuit n
  | 0 => .identity
  | m + 1 => .seq (plCx A I h m)
      (if hm : m < k then Circuit.CNOT (A ⟨m, hm⟩) (I ⟨m, hm⟩) (h _ _) else .identity)

theorem plCx_count {k : ℕ} (A I : QRegister k n) (h : ∀ i j, A i ≠ I j) (m : ℕ) :
    (plCx A I h m).count PrimitiveGate.TOFF = 0 ∧ (plCx A I h m).count PrimitiveGate.T = 0 := by
  induction m with
  | zero => exact ⟨rfl, rfl⟩
  | succ m ih =>
    simp only [plCx, Circuit.count_seq, ih.1, ih.2, Nat.zero_add]
    split_ifs <;> simp

section Program

open QC14.AliasCircuit QC14.LookupKraus

variable {N M aleph beth : ℕ}

/-- The live-data PREPARE: `amH`, the load of `tt1` into `(Areg, D, Kreg)`, the gadgets,
`index ⊕= Areg`, the tail. -/
noncomputable def pairPrepL {Var : Type} (v : Var) (thc : THCFactorization N M) (D : CData N M)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchLR N M aleph beth) n) (hdR : ∀ i j, rData i ≠ rS j) :
    DynamicCircuit Var n :=
  .seq (.circuit (amH rData))
    (.seq (amLoad v (plW1 rData rS hdR)
        (Lay.tt1 (g := gP N M aleph) (indP thc D aleph) (altP thc D aleph) (aliasTabs thc D aleph).2.2)
        (amScratch (plAl rS)))
      (.circuit (.seq (plMid rData rS hdR)
        (.seq (plCx (plA rS) (plI rData) (fun _ _ h ↦ hdR _ _ h.symm) (bP N M))
          (pmTail rData (plAnc rS) (fun _ _ ↦ hdR _ _))))))

/-- The live-data PREPARE†: the tail's inverse, `index ⊕= Areg`, the gadgets' inverse, one
measured unlookup of the whole word, `amH`. -/
noncomputable def pairPrepLinv {Var : Type} (v : Var) (thc : THCFactorization N M) (D : CData N M)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchLR N M aleph beth) n) (hdR : ∀ i j, rData i ≠ rS j) :
    DynamicCircuit Var n :=
  .seq (.circuit (.seq (pmTail rData (plAnc rS) (fun _ _ ↦ hdR _ _)).inverse
      (.seq (plCx (plA rS) (plI rData) (fun _ _ h ↦ hdR _ _ h.symm) (bP N M))
        (plMid rData rS hdR).inverse)))
    (.seq (amUnload v (plW1 rData rS hdR)
        (Lay.tt1 (g := gP N M aleph) (indP thc D aleph) (altP thc D aleph) (aliasTabs thc D aleph).2.2)
        (amScratch (plAl rS)))
      (.circuit (amH rData)))

theorem plSel_disj {N M aleph beth : ℕ}
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchLR N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc)) :
    ∃ hsc' : (plSelS rS).DisjointWires rCat,
      (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph))).DisjointWires
        ((plSelS rS).concat rCat hsc') := by
  refine ⟨pqDisj_sub (pqSlice_wires rS _ _ _) hsc, ?_⟩
  apply QRegister.DisjointWires.compose_left
  have hr : ∀ i, ∃ j, plSelS rS i = (rS.concat rCat hsc) j :=
    fun i ↦ ⟨Fin.castAdd beth ⟨ancPM N M aleph + i.val, by unfold scratchLR; omega⟩,
      by rw [QRegister.concat_apply_left]; rfl⟩
  have hs : ∀ i, ∃ j, rCat i = (rS.concat rCat hsc) j :=
    fun i ↦ ⟨Fin.natAdd (scratchLR N M aleph beth) i, by rw [QRegister.concat_apply_right]⟩
  exact QRegister.disjoint_comm.mp
    (pqDisj_sub (pqConcat_wires hr hs) (QRegister.disjoint_comm.mp hdisj))

theorem plDR {N M aleph beth : ℕ}
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchLR N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc)) :
    ∀ i j, rData i ≠ rS j :=
  fun i j ↦ QRegister.disjoint_iff.1 (disjoint_cat rData rS rCat hsc hdisj).2 i j

end Program

/-- `pairPrepL ; pairSelProgramR ; pairPrepLinv` (worker-defined; see the module docstring). -/
noncomputable def pairProgramLR {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ}
    (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) (hbI : 1 ≤ bIC N M)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchLR N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc)) :
    DynamicCircuit Var n :=
  .seq (pairPrepL v thc D rData rS (plDR rData rS rCat hsc hdisj))
    (.seq (pairSelProgramR v beth D hbI (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
        (plSelS rS) rCat (plSel_disj rData rS rCat hsc hdisj).1 (plSel_disj rData rS rCat hsc hdisj).2)
      (pairPrepLinv v thc D rData rS (plDR rData rS rCat hsc hdisj)))

section Count

open QC14.AliasCircuit QC14.LookupKraus

variable {N M aleph beth : ℕ}

theorem plMid_count (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchLR N M aleph beth) n) (hdR : ∀ i j, rData i ≠ rS j) :
    (plMid rData rS hdR).count PrimitiveGate.TOFF = 0 ∧
      (plMid rData rS hdR).count PrimitiveGate.T ≤
        32 * (gP N M aleph - sA N M + 1) + 16 * bP N M := by
  obtain ⟨hCmpO, hCmpT⟩ := CmpW.cmp_count (Lay.cmpW (sA_le_gP N M aleph) (plPos rData rS hdR)
    (plPos_inj rData rS hdR))
  obtain ⟨hTofO, hTofT⟩ := TofW.chain_count (Lay.tofW (sA_le_gP N M aleph) (plPos rData rS hdR)
    (plPos_inj rData rS hdR)) (bP N M)
  simp only [plMid, amMiddle, Circuit.count_seq]
  omega

theorem pairPrepL_count {Var : Type} (v : Var) (thc : THCFactorization N M) (D : CData N M)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchLR N M aleph beth) n) (hdR : ∀ i j, rData i ≠ rS j) :
    (pairPrepL v thc D rData rS hdR).count PrimitiveGate.TOFF = 0 ∧
      (pairPrepL v thc D rData rS hdR).count PrimitiveGate.T ≤
        mbl2T (sA N M) (amWord (bP N M) (gP N M aleph) (sA N M))
          (lkSplit (sA N M) (amWord (bP N M) (gP N M aleph) (sA N M))) (sA N M / 2) +
        (32 * (gP N M aleph - sA N M + 1) + 16 * bP N M) + 8 * bIC N M := by
  have hT := PrepareImpl.count_hPre (bP N M) (gP N M aleph) (gP N M aleph) le_rfl
    PrimitiveGate.T (by simp)
  have hO := PrepareImpl.count_hPre (bP N M) (gP N M aleph) (gP N M aleph) le_rfl
    PrimitiveGate.TOFF (by simp)
  obtain ⟨hLO, hLT⟩ : (amLoad v (plW1 rData rS hdR) (Lay.tt1 (g := gP N M aleph) (indP thc D aleph)
      (altP thc D aleph) (aliasTabs thc D aleph).2.2) (amScratch (plAl rS)) : DynamicCircuit Var n).count
        PrimitiveGate.TOFF = 0 ∧
      (amLoad v (plW1 rData rS hdR) (Lay.tt1 (g := gP N M aleph) (indP thc D aleph)
      (altP thc D aleph) (aliasTabs thc D aleph).2.2) (amScratch (plAl rS)) : DynamicCircuit Var n).count
        PrimitiveGate.T ≤ mbl2T (sA N M) (amWord (bP N M) (gP N M aleph) (sA N M))
          (lkSplit (sA N M) (amWord (bP N M) (gP N M aleph) (sA N M))) (sA N M / 2) :=
    lkMbl2Prog_count v (amParams (sA N M) (amWord (bP N M) (gP N M aleph) (sA N M)))
    (lkSplit (sA N M) _) (sA N M / 2)
    (by change lkSplit (sA N M) _ ≤ sA N M; unfold lkSplit; omega) (by change sA N M / 2 ≤ sA N M; omega)
    (amTable (Lay.tt1 (g := gP N M aleph) (indP thc D aleph) (altP thc D aleph)
      (aliasTabs thc D aleph).2.2)) (amReg (plW1 rData rS hdR)) (amScratch (plAl rS)) le_rfl
  obtain ⟨hMO, hMT⟩ := plMid_count rData rS hdR
  obtain ⟨hCO, hCT⟩ := plCx_count (plA rS) (plI rData) (fun _ _ h ↦ hdR _ _ h.symm) (bP N M)
  obtain ⟨hTO, hTT⟩ := pmTail_count rData (plAnc rS) (fun _ _ ↦ hdR _ _)
  simp only [pairPrepL, DynamicCircuit.count, amH, Circuit.count_onRegister, Circuit.count_seq]
  constructor <;> omega

theorem pairPrepLinv_count {Var : Type} (v : Var) (thc : THCFactorization N M) (D : CData N M)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchLR N M aleph beth) n) (hdR : ∀ i j, rData i ≠ rS j) :
    (pairPrepLinv v thc D rData rS hdR).count PrimitiveGate.TOFF = 0 ∧
      (pairPrepLinv v thc D rData rS hdR).count PrimitiveGate.T ≤
        ssT (sA N M) 1 (sA N M / 2) +
        (32 * (gP N M aleph - sA N M + 1) + 16 * bP N M) + 8 * bIC N M := by
  have hT := PrepareImpl.count_hPre (bP N M) (gP N M aleph) (gP N M aleph) le_rfl
    PrimitiveGate.T (by simp)
  have hO := PrepareImpl.count_hPre (bP N M) (gP N M aleph) (gP N M aleph) le_rfl
    PrimitiveGate.TOFF (by simp)
  obtain ⟨hUO, hUT⟩ : (amUnload v (plW1 rData rS hdR) (Lay.tt1 (g := gP N M aleph) (indP thc D aleph)
      (altP thc D aleph) (aliasTabs thc D aleph).2.2) (amScratch (plAl rS)) : DynamicCircuit Var n).count
        PrimitiveGate.TOFF = 0 ∧
      (amUnload v (plW1 rData rS hdR) (Lay.tt1 (g := gP N M aleph) (indP thc D aleph)
      (altP thc D aleph) (aliasTabs thc D aleph).2.2) (amScratch (plAl rS)) : DynamicCircuit Var n).count
        PrimitiveGate.T ≤ ssT (sA N M) 1 (sA N M / 2) :=
    lkMbuProg_count v (amParams (sA N M) (amWord (bP N M) (gP N M aleph) (sA N M)))
    (sA N M / 2) (by change sA N M / 2 ≤ sA N M; omega)
    (amTable (Lay.tt1 (g := gP N M aleph) (indP thc D aleph) (altP thc D aleph)
      (aliasTabs thc D aleph).2.2)) (amReg (plW1 rData rS hdR)) (amScratch (plAl rS))
    (amUnloadWork_le (sA N M) (amWord (bP N M) (gP N M aleph) (sA N M)))
  obtain ⟨hMO, hMT⟩ := plMid_count rData rS hdR
  obtain ⟨hCO, hCT⟩ := plCx_count (plA rS) (plI rData) (fun _ _ h ↦ hdR _ _ h.symm) (bP N M)
  obtain ⟨hTO, hTT⟩ := pmTail_count rData (plAnc rS) (fun _ _ ↦ hdR _ _)
  simp only [pairPrepLinv, DynamicCircuit.count, amH, Circuit.count_onRegister, Circuit.count_seq,
    Circuit.count_inverse_of_ne PrimitiveGate.T (by simp) (by simp),
    Circuit.count_inverse_of_ne PrimitiveGate.TOFF (by simp) (by simp)]
  constructor <;> omega

end Count

/-! ### Basis-ket facts for the CNOT layer -/

theorem pl_update (f : BitAssignment n) (t : Wire n) (c : ZMod 2) :
    Function.update f t (f t + c) = f + Pi.single t c := by
  funext w
  by_cases hw : w = t
  · subst hw; simp
  · simp [Function.update_of_ne hw, Pi.single_apply, hw]

theorem pl_sum_succ {k m : ℕ} (hm : m < k) (F : Fin k → BitAssignment n) :
    (∑ q : Fin k, if q.val < m + 1 then F q else 0) =
      (∑ q : Fin k, if q.val < m then F q else 0) + F ⟨m, hm⟩ := by
  have e : ∀ q : Fin k, (if q.val < m + 1 then F q else 0) =
      (if q.val < m then F q else 0) + (if q = ⟨m, hm⟩ then F q else 0) := by
    intro q
    by_cases h1 : q.val < m
    · rw [if_pos (by omega), if_pos h1, if_neg (fun e ↦ by rw [e] at h1; exact lt_irrefl _ h1),
        add_zero]
    · by_cases h2 : q.val = m
      · rw [if_pos (by omega), if_neg h1, if_pos (Fin.ext h2), zero_add]
      · rw [if_neg (by omega), if_neg h1, if_neg (fun e ↦ h2 (by rw [e])), add_zero]
  rw [Finset.sum_congr rfl (fun q _ ↦ e q), Finset.sum_add_distrib]
  simp

theorem plCx_ket {k : ℕ} (A I : QRegister k n) (h : ∀ i j, A i ≠ I j) (m : ℕ)
    (η : BitAssignment n) :
    (plCx A I h m).eval.1 *ᵥ ket η =
      ket (η + ∑ q : Fin k,
        if q.val < m then (Pi.single (I q) (η (A q)) : BitAssignment n) else 0) := by
  induction m with
  | zero =>
    have e : (∑ q : Fin k, if q.val < 0 then (Pi.single (I q) (η (A q)) : BitAssignment n)
        else 0) = 0 := Finset.sum_eq_zero fun q _ ↦ if_neg (Nat.not_lt_zero _)
    rw [e, add_zero, plCx, Circuit.eval_identity]
    exact Matrix.one_mulVec _
  | succ m ih =>
    rw [plCx, seq_mulVec, ih]
    split_ifs with hm
    · have hA : (η + ∑ q : Fin k, if q.val < m then (Pi.single (I q) (η (A q)) : BitAssignment n)
          else 0) (A ⟨m, hm⟩) = η (A ⟨m, hm⟩) := by
        rw [Pi.add_apply, Finset.sum_apply, Finset.sum_eq_zero, add_zero]
        intro q _
        split_ifs
        · rw [Pi.single_apply, if_neg (h _ _)]
        · rfl
      rw [ket_CNOT, hA, pl_update,
        pl_sum_succ hm (fun q ↦ (Pi.single (I q) (η (A q)) : BitAssignment n)), add_assoc]
    · have e : ∀ q : Fin k,
          (if q.val < m + 1 then (Pi.single (I q) (η (A q)) : BitAssignment n) else 0) =
            if q.val < m then Pi.single (I q) (η (A q)) else 0 := by
        intro q; have := q.isLt; rw [if_pos (by omega), if_pos (by omega)]
      rw [Finset.sum_congr rfl (fun q _ ↦ e q), Circuit.eval_identity]
      exact Matrix.one_mulVec _

/-- A basis permutation as a matrix. -/
noncomputable def plPM (G : BitAssignment n → BitAssignment n) :
    Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ :=
  Matrix.of fun i j ↦ if i = (basisBits n).symm (G (basisBits n j)) then 1 else 0

theorem pl_ket_single (β : BitAssignment n) :
    ket β = (Pi.single ((basisBits n).symm β) 1 : Fin (2 ^ n) → ℂ) := by
  rw [single_eq_ket, Equiv.apply_symm_apply]

theorem plPM_ket (G : BitAssignment n → BitAssignment n) (η : BitAssignment n) :
    plPM G *ᵥ ket η = ket (G η) := by
  rw [pl_ket_single, pl_ket_single, Matrix.mulVec_single_one]
  funext i
  simp [plPM, Pi.single_apply]

/-! ### The garbage map

After PREPARE the alias scratch holds `G η = amFlip W2 tt2 (η + Areg ⊕ aliasF σ)`: `Areg` holds the
alias output, `(D, Kreg)` the second-lookup word of the slot. `G η = η + Φ η` with `Φ η`
supported on `Areg ∪ D ∪ Kreg` and depending only on the slot wires. -/

/-! ### Linearity helpers -/

theorem plLinK {k t : ℕ} (rT : QRegister t n) (rA : QRegister k n) (hd : rT.DisjointWires rA)
    (Y Z : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ)
    (h : ∀ ζ, localIdx rA ζ = 0 → Y *ᵥ ket ζ = Z *ᵥ ket ζ) (U : Unitary (2 ^ t))
    (η : BitAssignment n) (hη : localIdx rA η = 0) :
    Y *ᵥ ((rT.embedUnitary U).1 *ᵥ ket η) = Z *ᵥ ((rT.embedUnitary U).1 *ᵥ ket η) := by
  rw [QRegister.embedUnitary_val, embedMatrix_mulVec_ket, Matrix.mulVec_sum, Matrix.mulVec_sum]
  refine Finset.sum_congr rfl fun l _ ↦ ?_
  rw [Matrix.mulVec_smul, Matrix.mulVec_smul,
    h _ (by rw [localIdx_writeReg_of_disjoint η rT rA hd]; exact hη)]

theorem plCat {m b : ℕ} (rS : QRegister m n) (rCat : QRegister b n) (hsc : rS.DisjointWires rCat)
    (A B : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ)
    (h : ∀ η, localIdx rS η = 0 → A *ᵥ ket η = B *ᵥ ket η) (β : BitAssignment n)
    (hβ : localIdx (rS.concat rCat hsc) β = 0) :
    A *ᵥ catalystKet rCat β = B *ᵥ catalystKet rCat β := by
  have h0 := (localIdx_concat_zero rS rCat hsc β hβ).1
  have hCS := QRegister.disjoint_comm.mp hsc
  unfold catalystKet
  rw [Matrix.mulVec_sum, Matrix.mulVec_sum]
  refine Finset.sum_congr rfl fun y _ ↦ ?_
  rw [Matrix.mulVec_smul, Matrix.mulVec_smul,
    h _ (by rw [localIdx_writeReg_of_disjoint β rCat rS hCS]; exact h0)]

theorem plLin {k m b : ℕ} (rT : QRegister k n) (rS : QRegister m n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (hdisj : rT.DisjointWires (rS.concat rCat hsc))
    (A B : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ)
    (h : ∀ γ, localIdx (rS.concat rCat hsc) γ = 0 →
      A *ᵥ catalystKet rCat γ = B *ᵥ catalystKet rCat γ) (U : Unitary (2 ^ k))
    (β : BitAssignment n) (hβ : localIdx (rS.concat rCat hsc) β = 0) :
    A *ᵥ ((rT.embedUnitary U).1 *ᵥ catalystKet rCat β) =
      B *ᵥ ((rT.embedUnitary U).1 *ᵥ catalystKet rCat β) := by
  obtain ⟨hTC, -⟩ := disjoint_cat rT rS rCat hsc hdisj
  rw [embed_catalystKet rT rCat hTC U β, Matrix.mulVec_sum, Matrix.mulVec_sum]
  refine Finset.sum_congr rfl fun l _ ↦ ?_
  rw [Matrix.mulVec_smul, Matrix.mulVec_smul,
    h _ (by rw [localIdx_writeReg_of_disjoint β rT _ hdisj]; exact hβ)]

section Garbage

open QC14.AliasCircuit QC14.LookupKraus

noncomputable abbrev plT1 {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) :=
  Lay.tt1 (g := gP N M aleph) (indP thc D aleph) (altP thc D aleph) (aliasTabs thc D aleph).2.2

noncomputable abbrev plT2 {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) :=
  Lay.tt2 (g := gP N M aleph) (indP thc D aleph) (altP thc D aleph) (aliasTabs thc D aleph).2.2

variable {N M aleph beth : ℕ} (thc : THCFactorization N M) (D : CData N M)
  (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
  (rS : QRegister (scratchLR N M aleph beth) n) (hdR : ∀ i j, rData i ≠ rS j)

theorem plPos_ne {p q : ℕ} (hp : p < Lay.tot (2 * N) (bP N M) (gP N M aleph))
    (hq : q < Lay.tot (2 * N) (bP N M) (gP N M aleph)) (h : p ≠ q) :
    plPos rData rS hdR p ≠ plPos rData rS hdR q :=
  fun e ↦ h (plPos_inj rData rS hdR p q hp hq e)

theorem plPos_pSl (i : ℕ) (hi : i < gP N M aleph) :
    plPos rData rS hdR (Lay.pSl (2 * N) (bP N M) i) = rData ⟨2 * N + (bP N M + i), by omega⟩ := by
  have h1 : Lay.pSl (2 * N) (bP N M) i < 2 * N + (bP N M + gP N M aleph) := by
    unfold Lay.pSl; omega
  refine (posOf_data (plDA rData rS hdR) (amBase (plAl rS)) h1).trans ?_
  rw [plDA_R rData rS hdR _ (by simp only [Lay.pSl]; omega)]
  exact congrArg rData (Fin.ext (by
    show Lay.pSl (2 * N) (bP N M) i = 2 * N + (bP N M + i); unfold Lay.pSl; omega))

theorem plPos_pIdx (q : Fin (bP N M)) :
    plPos rData rS hdR (Lay.pIdx (2 * N) q.val) = plA rS q :=
  (posOf_data (plDA rData rS hdR) (amBase (plAl rS))
    (by unfold Lay.pIdx; have := q.isLt; omega)).trans (plDA_A rData rS hdR q)

theorem plR_pIdx (q : Fin (bP N M)) :
    posOf rData (amBase (plAl rS)) (Lay.pIdx (2 * N) q.val) = plI rData q :=
  posOf_data rData (amBase (plAl rS)) (by unfold Lay.pIdx; have := q.isLt; omega)

theorem plR_pSl (i : ℕ) (hi : i < gP N M aleph) :
    posOf rData (amBase (plAl rS)) (Lay.pSl (2 * N) (bP N M) i) =
      plPos rData rS hdR (Lay.pSl (2 * N) (bP N M) i) := by
  rw [plPos_pSl rData rS hdR i hi]
  refine (posOf_data rData (amBase (plAl rS)) (by unfold Lay.pSl; omega)).trans ?_
  exact congrArg rData (Fin.ext (by
    show Lay.pSl (2 * N) (bP N M) i = 2 * N + (bP N M + i); unfold Lay.pSl; omega))

theorem plT2_ge (i : Fin (bP N M + (gP N M aleph - sA N M))) :
    2 * N + (bP N M + gP N M aleph) ≤ Lay.t2 (2 * N) (bP N M) (gP N M aleph) (sA N M) i.val := by
  unfold Lay.t2 Lay.pD Lay.pK; split_ifs <;> omega

theorem plSw_rS (i : Fin (bP N M + (gP N M aleph - sA N M))) :
    ∃ j, (plW2 rData rS hdR).sw i = rS j :=
  ⟨_, posOf_anc (plDA rData rS hdR) (amBase (plAl rS)) (plT2_ge i)
    (Lay.t2_lt (sA_le_gP N M aleph) i.isLt)⟩

/-- Wires the garbage map neither reads nor writes. -/
def plAv (w : Wire n) : Prop :=
  (∀ i : Fin (gP N M aleph), w ≠ plPos rData rS hdR (Lay.pSl (2 * N) (bP N M) i.val)) ∧
    (∀ q, w ≠ plA rS q) ∧ (∀ i, w ≠ (plW2 rData rS hdR).sw i)

theorem plAv_data (j : Fin (2 * N + (bP N M + gP N M aleph))) (hj : j.val < 2 * N + bP N M) :
    plAv rData rS hdR (rData j) := by
  refine ⟨fun i ↦ ?_, fun q ↦ hdR _ _, fun i ↦ ?_⟩
  · rw [plPos_pSl rData rS hdR i.val i.isLt]
    intro e
    have := pl_inj rData e
    omega
  · obtain ⟨j', e⟩ := plSw_rS rData rS hdR i
    rw [e]; exact hdR _ _

theorem plAv_out (w : Wire n) (h1 : ∀ j, w ≠ rS j) (h2 : ∀ j, w ≠ rData j) :
    plAv rData rS hdR w := by
  refine ⟨fun i ↦ ?_, fun q ↦ h1 _, fun i ↦ ?_⟩
  · rw [plPos_pSl rData rS hdR i.val i.isLt]; exact h2 _
  · obtain ⟨j', e⟩ := plSw_rS rData rS hdR i
    rw [e]; exact h1 _

theorem plAv_pCh (j : ℕ) (hj : j < sA N M + 1) :
    plAv rData rS hdR (plPos rData rS hdR (Lay.pCh (2 * N) (bP N M) (gP N M aleph) j)) := by
  have hs := sA_le_gP N M aleph
  have hc : Lay.pCh (2 * N) (bP N M) (gP N M aleph) j < Lay.tot (2 * N) (bP N M) (gP N M aleph) := by
    unfold Lay.pCh Lay.tot; omega
  refine ⟨fun i ↦ ?_, fun q ↦ ?_, fun i ↦ ?_⟩
  · exact plPos_ne rData rS hdR hc (by have := i.isLt; unfold Lay.pSl Lay.tot; omega)
      (by have := i.isLt; unfold Lay.pSl Lay.pCh; omega)
  · rw [← plPos_pIdx rData rS hdR q]
    exact plPos_ne rData rS hdR hc (by have := q.isLt; unfold Lay.pIdx Lay.tot; omega)
      (by have := q.isLt; unfold Lay.pIdx Lay.pCh; omega)
  · exact plPos_ne rData rS hdR hc (Lay.t2_lt hs i.isLt)
      (by unfold Lay.t2 Lay.pD Lay.pK Lay.pCh; split_ifs <;> omega)

/-- The slot value, read in the `plDA` frame. -/
noncomputable def plSig (η : BitAssignment n) : Fin (2 ^ gP N M aleph) :=
  (basisBits (gP N M aleph)).symm fun i ↦ η (plPos rData rS hdR (Lay.pSl (2 * N) (bP N M) i.val))

theorem plSig_bit (η : BitAssignment n) (i : ℕ) (hi : i < gP N M aleph) :
    η (plPos rData rS hdR (Lay.pSl (2 * N) (bP N M) i)) = bitN (plSig rData rS hdR η).val i := by
  have e := basisBits_eq_div_mod (gP N M aleph) (plSig rData rS hdR η) ⟨i, hi⟩
  simpa only [plSig, Equiv.apply_symm_apply, bitN] using e

/-- Bit `q` of the alias output of the slot. -/
noncomputable def plBit (η : BitAssignment n) (q : Fin (bP N M)) : ZMod 2 :=
  bitN (aliasF (indP thc D aleph) (altP thc D aleph) (aliasTabs thc D aleph).2.2
    (plSig rData rS hdR η)).val q.val

/-- The alias output, on `Areg`. -/
noncomputable def plDel (η : BitAssignment n) : BitAssignment n :=
  ∑ q : Fin (bP N M), Pi.single (plA rS q) (plBit thc D rData rS hdR η q)

/-- The alias output, on the index. -/
noncomputable def plDelR (η : BitAssignment n) : BitAssignment n :=
  ∑ q : Fin (bP N M), Pi.single (plI rData q) (plBit thc D rData rS hdR η q)

/-- The garbage map. -/
noncomputable def plG (η : BitAssignment n) : BitAssignment n :=
  amFlip (plW2 rData rS hdR) (plT2 thc D aleph) (η + plDel thc D rData rS hdR η)

noncomputable def plPhi (η : BitAssignment n) : BitAssignment n :=
  plDel thc D rData rS hdR η +
    (plW2 rData rS hdR).sysAdd (xrow (plT2 thc D aleph (amRow (plW2 rData rS hdR) η)))

theorem plDel_off (η : BitAssignment n) (w : Wire n) (h : ∀ q, w ≠ plA rS q) :
    plDel thc D rData rS hdR η w = 0 := by
  unfold plDel
  rw [Finset.sum_apply]
  exact Finset.sum_eq_zero fun q _ ↦ by rw [Pi.single_apply, if_neg (h q)]

theorem plDelR_off (η : BitAssignment n) (w : Wire n) (h : ∀ q, w ≠ plI rData q) :
    plDelR thc D rData rS hdR η w = 0 := by
  unfold plDelR
  rw [Finset.sum_apply]
  exact Finset.sum_eq_zero fun q _ ↦ by rw [Pi.single_apply, if_neg (h q)]

theorem plPhi_off (η : BitAssignment n) (w : Wire n) (hw : plAv rData rS hdR w) :
    plPhi thc D rData rS hdR η w = 0 := by
  unfold plPhi
  rw [Pi.add_apply, plDel_off thc D rData rS hdR η w hw.2.1,
    (plW2 rData rS hdR).sysAdd_other _ w hw.2.2, add_zero]

theorem plXw_A (i : Fin (sA N M)) (q : Fin (bP N M)) : (plW2 rData rS hdR).xw i ≠ plA rS q := by
  have hs := sA_le_gP N M aleph
  rw [← plPos_pIdx rData rS hdR q]
  exact plPos_ne rData rS hdR (by have := i.isLt; unfold Lay.pSl Lay.tot; omega)
    (by have := q.isLt; unfold Lay.pIdx Lay.tot; omega)
    (by have := q.isLt; unfold Lay.pSl Lay.pIdx; omega)

theorem plG_eq (η : BitAssignment n) :
    plG thc D rData rS hdR η = η + plPhi thc D rData rS hdR η := by
  have e : amRow (plW2 rData rS hdR) (η + plDel thc D rData rS hdR η) =
      amRow (plW2 rData rS hdR) η := by
    unfold amRow
    congr 1
    funext i
    rw [Pi.add_apply, plDel_off thc D rData rS hdR η _ (plXw_A rData rS hdR i), add_zero]
  unfold plG amFlip plPhi
  rw [e, add_assoc]

theorem plPhi_congr (η η' : BitAssignment n)
    (h : ∀ i : Fin (gP N M aleph), η (plPos rData rS hdR (Lay.pSl (2 * N) (bP N M) i.val)) =
      η' (plPos rData rS hdR (Lay.pSl (2 * N) (bP N M) i.val))) :
    plPhi thc D rData rS hdR η = plPhi thc D rData rS hdR η' := by
  have hs := sA_le_gP N M aleph
  have h1 : plSig rData rS hdR η = plSig rData rS hdR η' := by
    unfold plSig; congr 1; funext i; exact h i
  have h2 : amRow (plW2 rData rS hdR) η = amRow (plW2 rData rS hdR) η' := by
    unfold amRow; congr 1; funext i; exact h ⟨i.val, by have := i.isLt; omega⟩
  unfold plPhi plDel plBit
  rw [h1, h2]

theorem plG_add (η δ : BitAssignment n)
    (hδ : ∀ i : Fin (gP N M aleph), δ (plPos rData rS hdR (Lay.pSl (2 * N) (bP N M) i.val)) = 0) :
    plG thc D rData rS hdR (η + δ) = plG thc D rData rS hdR η + δ := by
  rw [plG_eq, plG_eq, plPhi_congr thc D rData rS hdR (η + δ) η
    (fun i ↦ by rw [Pi.add_apply, hδ i, add_zero])]
  exact add_right_comm _ _ _

theorem plG_write {k : ℕ} (r : QRegister k n) (hr : ∀ i, plAv rData rS hdR (r i))
    (x : BitAssignment k) (η : BitAssignment n) :
    plG thc D rData rS hdR (writeReg η r x) = writeReg (plG thc D rData rS hdR η) r x := by
  have hsl : ∀ i : Fin (gP N M aleph),
      writeReg η r x (plPos rData rS hdR (Lay.pSl (2 * N) (bP N M) i.val)) =
        η (plPos rData rS hdR (Lay.pSl (2 * N) (bP N M) i.val)) := fun i ↦
    writeReg_apply_of_not_mem _ _ _ _ (by rintro ⟨j, hj⟩; exact (hr j).1 i hj)
  rw [plG_eq, plG_eq, plPhi_congr thc D rData rS hdR _ η hsl]
  funext w
  by_cases hw : w ∈ Set.range r.wires
  · obtain ⟨j, rfl⟩ := hw
    rw [Pi.add_apply, plPhi_off thc D rData rS hdR η _ (hr j), add_zero]
    exact (writeReg_apply_reg η r x j).trans (writeReg_apply_reg _ r x j).symm
  · rw [Pi.add_apply, writeReg_apply_of_not_mem _ _ _ _ hw, writeReg_apply_of_not_mem _ _ _ _ hw,
      Pi.add_apply]

theorem plG_loc {k : ℕ} (r : QRegister k n) (hr : ∀ i, plAv rData rS hdR (r i))
    (η : BitAssignment n) : localIdx r (plG thc D rData rS hdR η) = localIdx r η := by
  show (basisBits k).symm (fun i ↦ plG thc D rData rS hdR η (r i)) =
    (basisBits k).symm (fun i ↦ η (r i))
  congr 1
  funext i
  rw [plG_eq, Pi.add_apply, plPhi_off thc D rData rS hdR η _ (hr i), add_zero]

/-- The garbage map as a matrix. -/
noncomputable abbrev plX : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ :=
  plPM (plG thc D rData rS hdR)

theorem plX_ket (η : BitAssignment n) :
    plX thc D rData rS hdR *ᵥ ket η = ket (plG thc D rData rS hdR η) :=
  plPM_ket _ η

theorem plX_comm {k : ℕ} (r : QRegister k n) (hr : ∀ i, plAv rData rS hdR (r i))
    (U : Unitary (2 ^ k)) :
    (r.embedUnitary U).1 * plX thc D rData rS hdR = plX thc D rData rS hdR * (r.embedUnitary U).1 := by
  apply matrix_ext_ket
  intro β
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, plX_ket, QRegister.embedUnitary_val,
    embedMatrix_mulVec_ket, embedMatrix_mulVec_ket, Matrix.mulVec_sum, plG_loc thc D rData rS hdR r hr]
  refine Finset.sum_congr rfl fun l _ ↦ ?_
  rw [Matrix.mulVec_smul, plX_ket, plG_write thc D rData rS hdR r hr]

theorem plX_circ (c : Circuit n) (hc : ∀ w ∈ c.support, plAv rData rS hdR w) :
    c.eval.1 * plX thc D rData rS hdR = plX thc D rData rS hdR * c.eval.1 := by
  induction c with
  | identity => simp
  | gate g r =>
    exact plX_comm thc D rData rS hdR r (fun i ↦ hc _ ((QRegister.mem_image r _).2 ⟨i, rfl⟩)) g.eval
  | seq c₁ c₂ ih₁ ih₂ =>
    have h1 := ih₁ (fun w hw ↦ hc w (Finset.mem_union_left _ hw))
    have h2 := ih₂ (fun w hw ↦ hc w (Finset.mem_union_right _ hw))
    show c₂.eval.1 * c₁.eval.1 * _ = _ * (c₂.eval.1 * c₁.eval.1)
    rw [mul_assoc, h1, ← mul_assoc, h2, mul_assoc]

theorem plX_cat {b : ℕ} (rCat : QRegister b n) (hr : ∀ i, plAv rData rS hdR (rCat i))
    (γ : BitAssignment n) :
    plX thc D rData rS hdR *ᵥ catalystKet rCat γ = catalystKet rCat (plG thc D rData rS hdR γ) := by
  unfold catalystKet
  rw [Matrix.mulVec_sum]
  refine Finset.sum_congr rfl fun y _ ↦ ?_
  rw [Matrix.mulVec_smul, plX_ket, plG_write thc D rData rS hdR rCat hr]

/-- `G` on `Areg` for an `Areg`-clean input is the alias output. -/
theorem plG_A (ζ : BitAssignment n) (hζ : ∀ q, ζ (plA rS q) = 0) (q : Fin (bP N M)) :
    plG thc D rData rS hdR ζ (plA rS q) = plBit thc D rData rS hdR ζ q := by
  have hs := sA_le_gP N M aleph
  have hsw : ∀ i, plA rS q ≠ (plW2 rData rS hdR).sw i := by
    intro i
    rw [← plPos_pIdx rData rS hdR q]
    exact plPos_ne rData rS hdR (by have := q.isLt; unfold Lay.pIdx Lay.tot; omega)
      (Lay.t2_lt hs i.isLt) (by have := q.isLt; unfold Lay.t2 Lay.pD Lay.pK Lay.pIdx; split_ifs <;> omega)
  rw [plG_eq]
  unfold plPhi
  rw [Pi.add_apply, Pi.add_apply, hζ, zero_add, (plW2 rData rS hdR).sysAdd_other _ _ hsw, add_zero]
  unfold plDel
  rw [Finset.sum_apply, Finset.sum_eq_single q]
  · simp
  · intro q' _ hq'
    rw [Pi.single_apply, if_neg (fun e ↦ hq' ((plA rS).wires.injective e).symm)]
  · simp

theorem plCx_G (ζ : BitAssignment n) (hζ : ∀ q, ζ (plA rS q) = 0) :
    (plCx (plA rS) (plI rData) (fun _ _ h ↦ hdR _ _ h.symm) (bP N M)).eval.1 *ᵥ
        ket (plG thc D rData rS hdR ζ) =
      ket (plG thc D rData rS hdR ζ + plDelR thc D rData rS hdR ζ) := by
  rw [plCx_ket]
  refine congrArg (fun x ↦ ket (plG thc D rData rS hdR ζ + x)) ?_
  unfold plDelR
  refine Finset.sum_congr rfl fun q _ ↦ ?_
  rw [if_pos q.isLt, plG_A thc D rData rS hdR ζ hζ q]

theorem plCl (ζ : BitAssignment n) (hζ : localIdx (plAl rS) ζ = 0) (p : ℕ)
    (hp : 2 * N + (bP N M + gP N M aleph) ≤ p) (hl : p < Lay.tot (2 * N) (bP N M) (gP N M aleph)) :
    ζ (plPos rData rS hdR p) = 0 :=
  amPos_clean (plDA rData rS hdR) (plAl rS) ζ hζ hp hl

theorem plMid_ket (ζ : BitAssignment n) (hζ : localIdx (plAl rS) ζ = 0) :
    (plMid rData rS hdR).eval.1 *ᵥ ket (amFlip (plW1 rData rS hdR) (plT1 thc D aleph) ζ) =
      ket (plG thc D rData rS hdR ζ) := by
  have hs := sA_le_gP N M aleph
  have he := Lay.core_ket hs (plPos rData rS hdR) (plPos_inj rData rS hdR) (indP thc D aleph)
    (altP thc D aleph) (aliasTabs thc D aleph).2.2 (aliasTabs_K_lt thc D aleph) ζ
    (plSig rData rS hdR ζ) (plCl rData rS hdR ζ hζ) (plSig_bit rData rS hdR ζ)
  have hsum : (∑ q : Fin (bP N M), (Pi.single (plPos rData rS hdR (Lay.pIdx (2 * N) q.val))
      (bitN (aliasF (indP thc D aleph) (altP thc D aleph) (aliasTabs thc D aleph).2.2
        (plSig rData rS hdR ζ)).val q.val) : BitAssignment n)) = plDel thc D rData rS hdR ζ := by
    unfold plDel plBit
    refine Finset.sum_congr rfl fun q _ ↦ ?_
    rw [plPos_pIdx]
  rw [hsum] at he
  have hδ : ∀ j, plG thc D rData rS hdR ζ ((plW2 rData rS hdR).aw j) = 0 := by
    intro j
    have hj := j.isLt
    unfold plG amFlip
    rw [Pi.add_apply, (plW2 rData rS hdR).sysAdd_sa, add_zero, Pi.add_apply,
      plDel_off thc D rData rS hdR ζ ((plW2 rData rS hdR).aw j)
        (plAv_pCh rData rS hdR j.val j.isLt).2.1, add_zero]
    exact plCl rData rS hdR ζ hζ (Lay.pCh (2 * N) (bP N M) (gP N M aleph) j.val)
      (by unfold Lay.pCh; omega) (by unfold Lay.pCh Lay.tot; omega)
  have hlast : (QC14.UnaryLookup.ulookup (plW2 rData rS hdR) (plT2 thc D aleph)).eval.1 *ᵥ
      ket (plG thc D rData rS hdR ζ) = ket (ζ + plDel thc D rData rS hdR ζ) :=
    (amUnary _ _ _ hδ).trans (congrArg ket (amFlip_flip _ _ _))
  have hfirst := amUnary (plW1 rData rS hdR) (plT1 thc D aleph) ζ (fun j ↦ by
    have hj := j.isLt
    exact plCl rData rS hdR ζ hζ (Lay.pCh (2 * N) (bP N M) (gP N M aleph) j.val)
      (by unfold Lay.pCh; omega) (by unfold Lay.pCh Lay.tot; omega))
  let last := QC14.UnaryLookup.ulookup (plW2 rData rS hdR) (plT2 thc D aleph)
  have hseq : last.eval.1 *ᵥ ((plMid rData rS hdR).eval.1 *ᵥ
      ket (amFlip (plW1 rData rS hdR) (plT1 thc D aleph) ζ)) =
        ket (ζ + plDel thc D rData rS hdR ζ) := by
    rw [← hfirst]
    simpa only [Lay.core, last, amMiddle, plMid, seq_mulVec, plW1, plW2, plPos, plT1, plT2] using he
  have e := congrArg (fun z : Fin (2 ^ n) → ℂ ↦ last.inverse.eval.1 *ᵥ z) (hseq.trans hlast.symm)
  exact (SelectPauliImpl.inv_mulVec last _).symm.trans (e.trans (SelectPauliImpl.inv_mulVec last _))

/-- The old core on `rData` (index as target) adds the alias output to the index. -/
theorem plSel_ket (ζ : BitAssignment n) (hζ : localIdx (plAl rS) ζ = 0) :
    ((rData.slice (2 * N) (bP N M + gP N M aleph) le_rfl).embedUnitary
      (selectPauliUnitary (gP N M aleph) (bP N M) (2 ^ gP N M aleph)
        (PrepareImpl.tblOf (bP N M) (gP N M aleph)
          (aliasF (indP thc D aleph) (altP thc D aleph) (aliasTabs thc D aleph).2.2)))).1 *ᵥ ket ζ =
      ket (ζ + plDelR thc D rData rS hdR ζ) := by
  have hs := sA_le_gP N M aleph
  have hd' : ∀ i j, rData i ≠ amBase (plAl rS) j := fun i j ↦ hdR _ _
  rw [← core_eq_sel hs _ _ _ (aliasTabs_K_lt thc D aleph) rData (amBase (plAl rS)) hd' ζ
    (QC14.localIdx_slice_zero (plAl rS) _ _ _ ζ hζ)]
  have hg : ∀ i, i < gP N M aleph → ζ (posOf rData (amBase (plAl rS)) (Lay.pSl (2 * N) (bP N M) i)) =
      bitN (plSig rData rS hdR ζ).val i := fun i hi ↦ by
    rw [plR_pSl rData rS hdR i hi]; exact plSig_bit rData rS hdR ζ i hi
  rw [Lay.core_ket hs _ _ _ _ _ (aliasTabs_K_lt thc D aleph) ζ (plSig rData rS hdR ζ)
    (fun p hp hl ↦ amPos_clean rData (plAl rS) ζ hζ hp hl) hg]
  refine congrArg (fun x ↦ ket (ζ + x)) ?_
  unfold plDelR plBit
  refine Finset.sum_congr rfl fun q _ ↦ ?_
  rw [plR_pIdx]

theorem plHd1 : (amReg (plW1 rData rS hdR)).DisjointWires (amScratch (plAl rS)) := by
  have hs := sA_le_gP N M aleph
  exact amReg_disjoint (plW1 rData rS hdR) _
    (fun i j ↦ amPos_work (plDA rData rS hdR) (plAl rS) (plHdM rData rS hdR) (Lay.t1_lt hs i.isLt) j)
    (fun i j ↦ amPos_work (plDA rData rS hdR) (plAl rS) (plHdM rData rS hdR)
      (by have := i.isLt; unfold Lay.pSl Lay.tot; omega) j)


/-! ### Clean helpers and the tail -/

theorem plA_z (η : BitAssignment n) (hη : localIdx rS η = 0) (q : Fin (bP N M)) :
    η (plA rS q) = 0 :=
  eq_zero_of_localIdx_eq_zero (plA rS) η (QC14.localIdx_slice_zero rS _ _ _ η hη) q

theorem plAl_cl (η : BitAssignment n) (hη : localIdx rS η = 0) : localIdx (plAl rS) η = 0 :=
  QC14.localIdx_slice_zero (plAnc rS) _ _ _ η (QC14.localIdx_slice_zero rS _ _ _ η hη)

theorem plShift_cl (ζ : BitAssignment n) (hζ : localIdx rS ζ = 0) :
    localIdx rS (ζ + plDelR thc D rData rS hdR ζ) = 0 :=
  localIdx_eq_zero_of_forall _ _ fun j ↦ by
    rw [Pi.add_apply, plDelR_off thc D rData rS hdR ζ _ (fun q e ↦ hdR _ _ e.symm), add_zero]
    exact eq_zero_of_localIdx_eq_zero _ ζ hζ j

theorem plDelR_slot (η : BitAssignment n) (i : Fin (gP N M aleph)) :
    plDelR thc D rData rS hdR η (plPos rData rS hdR (Lay.pSl (2 * N) (bP N M) i.val)) = 0 := by
  rw [plPos_pSl rData rS hdR i.val i.isLt]
  exact plDelR_off thc D rData rS hdR η _ (fun q e ↦ by
    have h1 := pl_inj rData e
    have := q.isLt
    omega)

theorem plSw1_cl (γ : BitAssignment n) (hγ : localIdx rS γ = 0)
    (i : Fin (bP N M + (bP N M + (gP N M aleph - sA N M)))) :
    γ ((plW1 rData rS hdR).sw i) = 0 := by
  have hs := sA_le_gP N M aleph
  change γ (plPos rData rS hdR (Lay.t1 (2 * N) (bP N M) (gP N M aleph) (sA N M) i.val)) = 0
  by_cases hi : i.val < bP N M
  · have e : Lay.t1 (2 * N) (bP N M) (gP N M aleph) (sA N M) i.val =
        Lay.pIdx (2 * N) (⟨i.val, hi⟩ : Fin (bP N M)).val := by
      unfold Lay.t1; rw [if_pos hi]
    rw [e, plPos_pIdx]
    exact plA_z rS γ hγ _
  · exact plCl rData rS hdR γ (plAl_cl rS γ hγ) _
      (by unfold Lay.t1 Lay.pD Lay.pK; split_ifs <;> omega) (Lay.t1_lt hs i.isLt)

theorem plAv_rS (j : ℕ) (h : j < scratchLR N M aleph beth)
    (h1 : j < ancPM N M aleph + selRScr N (bIC N M) beth)
    (h2 : j = 0 ∨ aliasAnc (bP N M) (gP N M aleph) (sA N M) ≤ j) :
    plAv rData rS hdR (rS ⟨j, h⟩) := by
  refine ⟨fun i ↦ ?_, fun q ↦ ?_, fun i ↦ ?_⟩
  · rw [plPos_pSl rData rS hdR i.val i.isLt]
    exact fun e ↦ hdR _ _ e.symm
  · intro e
    have h3 := pl_inj rS (e.trans (QRegister.slice_apply _ _ _ _ q))
    have := q.isLt
    omega
  · intro e
    have e' : rS ⟨j, h⟩ = posOf (plDA rData rS hdR) (amBase (plAl rS))
        (Lay.t2 (2 * N) (bP N M) (gP N M aleph) (sA N M) i.val) := e
    rw [posOf_anc (plDA rData rS hdR) (amBase (plAl rS)) (plT2_ge i)
      (Lay.t2_lt (sA_le_gP N M aleph) i.isLt)] at e'
    have h3 : j = 0 + (0 + (0 + (Lay.t2 (2 * N) (bP N M) (gP N M aleph) (sA N M) i.val -
        (2 * N + (bP N M + gP N M aleph))))) := pl_inj rS e'
    have h4 : 2 * N + (bP N M + gP N M aleph) + 1 ≤
        Lay.t2 (2 * N) (bP N M) (gP N M aleph) (sA N M) i.val := by
      unfold Lay.t2 Lay.pD Lay.pK; split_ifs <;> omega
    have h5 : Lay.t2 (2 * N) (bP N M) (gP N M aleph) (sA N M) i.val <
        Lay.tot (2 * N) (bP N M) (gP N M aleph) := Lay.t2_lt (sA_le_gP N M aleph) i.isLt
    unfold Lay.tot at h5
    unfold aliasAnc at h2
    omega

abbrev plTl : Circuit n := pmTail rData (plAnc rS) (fun _ _ ↦ hdR _ _)

abbrev plCxc : Circuit n := plCx (plA rS) (plI rData) (fun _ _ h ↦ hdR _ _ h.symm) (bP N M)

theorem plTail_av : ∀ w ∈ (plTl rData rS hdR).support, plAv rData rS hdR w := by
  intro w hw
  simp only [plTl, pmTail, Circuit.support_seq, Finset.mem_union] at hw
  rcases hw with h | h
  · obtain ⟨i, rfl⟩ := (QRegister.mem_image _ _).1 h
    have hb : bP N M = idxC N M + 1 := rfl
    exact plAv_data rData rS hdR ⟨2 * N + idxC N M, by omega⟩
      (by show 2 * N + idxC N M < 2 * N + bP N M; omega)
  · obtain ⟨i, rfl⟩ := (QRegister.mem_image _ _).1 (Circuit.support_onRegister_subset _ _ h)
    induction i using Fin.addCases with
    | left j =>
      unfold cswReg
      rw [QRegister.concat_apply_left]
      exact plAv_data rData rS hdR _ (by show 2 * N + j.val < 2 * N + bP N M; have := j.isLt; omega)
    | right j =>
      unfold cswReg
      rw [QRegister.concat_apply_right]
      have := j.isLt
      have hA : 1 ≤ ancPM N M aleph := le_trans (Nat.le_add_left 1 _) (le_max_left _ _)
      exact plAv_rS rData rS hdR (0 + (0 + (0 + j.val))) (by unfold scratchLR; omega) (by omega)
        (Or.inl (by omega))

theorem plX_circ_vec (c : Circuit n) (hc : ∀ w ∈ c.support, plAv rData rS hdR w)
    (v : Fin (2 ^ n) → ℂ) :
    c.eval.1 *ᵥ (plX thc D rData rS hdR *ᵥ v) = plX thc D rData rS hdR *ᵥ (c.eval.1 *ᵥ v) := by
  rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, plX_circ thc D rData rS hdR c hc]

/-! ### PREPARE and PREPARE† on basis kets -/

theorem plF1 {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) :
    ∃ R, LowerKraus (pairPrepL v thc D rData rS hdR).compile R ∧
      ∀ η, localIdx rS η = 0 → R *ᵥ ket η =
        (plX thc D rData rS hdR * (rData.embedUnitary ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
          (pairPrepU thc D aleph))).1) *ᵥ ket η := by
  obtain ⟨L, hL, hLk⟩ := amLoad_kraus v (plW1 rData rS hdR) (plT1 thc D aleph)
    (amScratch (plAl rS)) (plHd1 rData rS hdR)
  refine ⟨_, (lowerKraus_circuit (Var := Var) (amH rData)).qSeq (hL.qSeq
    (lowerKraus_circuit (Var := Var) (Circuit.seq (plMid rData rS hdR)
      (.seq (plCxc rData rS hdR) (plTl rData rS hdR))))), ?_⟩
  intro η hη
  let B := blkA (2 * N) (bP N M) (gP N M aleph)
  let r := rData.slice (2 * N) (bP N M + gP N M aleph) le_rfl
  let S := selectPauliUnitary (gP N M aleph) (bP N M) (2 ^ gP N M aleph)
    (PrepareImpl.tblOf (bP N M) (gP N M aleph)
      (aliasF (indP thc D aleph) (altP thc D aleph) (aliasTabs thc D aleph).2.2))
  let H := (PrepareImpl.hPre (bP N M) (gP N M aleph) (gP N M aleph) le_rfl).eval
  let T := pmTailU N M aleph
  have hPU : pairPrepU thc D aleph = T * (S * H) := rfl
  have he : (amH rData).eval = r.embedUnitary H := Circuit.eval_onRegister _ _
  have key : ∀ ζ, localIdx rS ζ = 0 →
      ((Circuit.seq (plMid rData rS hdR) (.seq (plCxc rData rS hdR) (plTl rData rS hdR))).eval.1 * L)
        *ᵥ ket ζ = (plX thc D rData rS hdR * ((rData.embedUnitary (B.embedUnitary T)).1 *
          (r.embedUnitary S).1)) *ᵥ ket ζ := by
    intro ζ hζ
    have hal := plAl_cl rS ζ hζ
    simp only [← Matrix.mulVec_mulVec]
    rw [hLk ζ (QC14.localIdx_slice_zero (plAl rS) _ _ _ ζ hal), seq_mulVec, seq_mulVec,
      plMid_ket thc D rData rS hdR ζ hal, plCx_G thc D rData rS hdR ζ (plA_z rS ζ hζ),
      plSel_ket thc D rData rS hdR ζ hal,
      ← pmTail_ket rData (plAnc rS) (fun _ _ ↦ hdR _ _) _
        (QC14.localIdx_slice_zero rS _ _ _ _ (plShift_cl thc D rData rS hdR ζ hζ)),
      ← plX_circ_vec thc D rData rS hdR _ (plTail_av rData rS hdR), plX_ket,
      plG_add thc D rData rS hdR ζ _ (plDelR_slot thc D rData rS hdR ζ)]
  have hlin := plLinK r rS (QRegister.disjoint_iff.2 (fun _ _ ↦ hdR _ _)) _ _ key H η hη
  have hR : (rData.embedUnitary (B.embedUnitary (pairPrepU thc D aleph))).1 =
      (rData.embedUnitary (B.embedUnitary T)).1 * ((r.embedUnitary S).1 * (r.embedUnitary H).1) := by
    rw [hPU, QRegister.embedUnitary_mul, QRegister.embedUnitary_mul, QRegister.embedUnitary_mul,
      QRegister.embedUnitary_mul, ← QRegister.embedUnitary_compose rData B S,
      ← QRegister.embedUnitary_compose rData B H]
    rfl
  change (_ * L * (amH rData).eval.1) *ᵥ ket η = _
  rw [he, hR]
  simp only [← Matrix.mulVec_mulVec] at hlin ⊢
  exact hlin

theorem plF2 {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) :
    ∃ R, LowerKraus (pairPrepLinv v thc D rData rS hdR).compile R ∧
      ∀ η, localIdx rS η = 0 → (R * plX thc D rData rS hdR) *ᵥ ket η =
        (rData.embedUnitary (star ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
          (pairPrepU thc D aleph)))).1 *ᵥ ket η := by
  obtain ⟨U, hU, hUk⟩ := amUnload_kraus v (plW1 rData rS hdR) (plT1 thc D aleph)
    (amScratch (plAl rS)) (plHd1 rData rS hdR)
  refine ⟨_, (lowerKraus_circuit (Var := Var) (Circuit.seq (plTl rData rS hdR).inverse
    (.seq (plCxc rData rS hdR) (plMid rData rS hdR).inverse))).qSeq
      (hU.qSeq (lowerKraus_circuit (Var := Var) (amH rData))), ?_⟩
  intro η hη
  let B := blkA (2 * N) (bP N M) (gP N M aleph)
  let r := rData.slice (2 * N) (bP N M + gP N M aleph) le_rfl
  let S := selectPauliUnitary (gP N M aleph) (bP N M) (2 ^ gP N M aleph)
    (PrepareImpl.tblOf (bP N M) (gP N M aleph)
      (aliasF (indP thc D aleph) (altP thc D aleph) (aliasTabs thc D aleph).2.2))
  let H := (PrepareImpl.hPre (bP N M) (gP N M aleph) (gP N M aleph) le_rfl).eval
  let T := pmTailU N M aleph
  have hPU : pairPrepU thc D aleph = T * (S * H) := rfl
  have he : (amH rData).eval = r.embedUnitary H := Circuit.eval_onRegister _ _
  have key : ∀ ζ, localIdx rS ζ = 0 →
      ((amH rData).eval.1 * U * (Circuit.seq (plCxc rData rS hdR) (plMid rData rS hdR).inverse).eval.1 *
        plX thc D rData rS hdR) *ᵥ ket ζ = ((r.embedUnitary H).1 * (r.embedUnitary S).1) *ᵥ ket ζ := by
    intro ζ hζ
    have hal := plAl_cl rS ζ hζ
    have hζ' := plShift_cl thc D rData rS hdR ζ hζ
    have hal' := plAl_cl rS _ hζ'
    simp only [← Matrix.mulVec_mulVec]
    rw [plX_ket, seq_mulVec, plCx_G thc D rData rS hdR ζ (plA_z rS ζ hζ),
      ← plG_add thc D rData rS hdR ζ _ (plDelR_slot thc D rData rS hdR ζ),
      ← plMid_ket thc D rData rS hdR _ hal', SelectPauliImpl.inv_mulVec,
      hUk _ (QC14.localIdx_slice_zero (plAl rS) _ _ _ _ hal')
        (plSw1_cl rData rS hdR _ hζ'), he, plSel_ket thc D rData rS hdR ζ hal]
  have hlin := plLinK rData rS (QRegister.disjoint_iff.2 hdR) _ _ key (star (B.embedUnitary T)) η hη
  have hSs : star (B.embedUnitary S) = B.embedUnitary S := by
    rw [← QC14.embedUnitary_star', QC14.star_selectPauliUnitary]
  have hHs : star (B.embedUnitary H) = B.embedUnitary H := by
    rw [← QC14.embedUnitary_star', amHStar]
  have hR : (rData.embedUnitary (star (B.embedUnitary (pairPrepU thc D aleph)))).1 =
      (r.embedUnitary H).1 * (r.embedUnitary S).1 * (rData.embedUnitary (star (B.embedUnitary T))).1 := by
    rw [hPU, QRegister.embedUnitary_mul, QRegister.embedUnitary_mul, star_mul, star_mul, hSs, hHs,
      QRegister.embedUnitary_mul, QRegister.embedUnitary_mul,
      ← QRegister.embedUnitary_compose rData B S, ← QRegister.embedUnitary_compose rData B H]
    rfl
  have hTinv : ∀ w ∈ (plTl rData rS hdR).inverse.support, plAv rData rS hdR w := fun w hw ↦
    plTail_av rData rS hdR w (by rwa [Circuit.support_inverse] at hw)
  rw [hR]
  simp only [← Matrix.mulVec_mulVec] at hlin ⊢
  rw [← hlin]
  change (amH rData).eval.1 *ᵥ (U *ᵥ ((Circuit.seq (plTl rData rS hdR).inverse
    (.seq (plCxc rData rS hdR) (plMid rData rS hdR).inverse)).eval.1 *ᵥ
      (plX thc D rData rS hdR *ᵥ ket η))) = _
  rw [seq_mulVec, plX_circ_vec thc D rData rS hdR _ hTinv,
    pmTailInv_ket rData (plAnc rS) (fun _ _ ↦ hdR _ _) η (QC14.localIdx_slice_zero rS _ _ _ η hη)]

/-! ### The SELECT step through the garbage -/

theorem plSelX {Var : Type} [DecidableEq Var] {P : QProg Var (2 ^ n)} (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc))
    (hsc' : (plSelS rS).DisjointWires rCat) (S : Unitary (2 ^ (2 * N + bP N M)))
    (h : CatKet rData (plSelS rS) rCat hsc' P ((blkS (2 * N) (bP N M) (gP N M aleph)).embedUnitary S)) :
    ∃ R, LowerKraus P R ∧ ∀ γ, localIdx (rS.concat rCat hsc) γ = 0 →
      (R * plX thc D rData rS hdR) *ᵥ catalystKet rCat γ =
        (plX thc D rData rS hdR *
          (rData.embedUnitary ((blkS (2 * N) (bP N M) (gP N M aleph)).embedUnitary S)).1) *ᵥ
            catalystKet rCat γ := by
  obtain ⟨R, hR, hk⟩ := h
  refine ⟨R, hR, fun γ hγ ↦ ?_⟩
  obtain ⟨hTC, -⟩ := disjoint_cat rData rS rCat hsc hdisj
  have hcav : ∀ i, plAv rData rS hdR (rCat i) := fun i ↦
    plAv_out rData rS hdR _ (fun j e ↦ QRegister.disjoint_iff.1 hsc j i e.symm)
      (fun j e ↦ QRegister.disjoint_iff.1 hTC j i e.symm)
  have hz := eq_zero_of_localIdx_eq_zero _ γ hγ
  have hzS : ∀ j, γ (rS j) = 0 := fun j ↦ by
    have := hz (Fin.castAdd beth j); rwa [QRegister.concat_apply_left] at this
  have hzC : ∀ j, γ (rCat j) = 0 := fun j ↦ by
    have := hz (Fin.natAdd (scratchLR N M aleph beth) j); rwa [QRegister.concat_apply_right] at this
  have hav : ∀ i, plAv rData rS hdR (((plSelS rS).concat rCat hsc') i) := by
    intro i
    induction i using Fin.addCases with
    | left j =>
      rw [QRegister.concat_apply_left]
      have := j.isLt
      have := aliasAnc_le_M (bP N M) (gP N M aleph) (sA N M)
      have := pmAlias_le N M aleph
      exact plAv_rS rData rS hdR (ancPM N M aleph + j.val) (by unfold scratchLR; omega) (by omega)
        (Or.inr (by omega))
    | right j =>
      rw [QRegister.concat_apply_right]
      exact hcav j
  have hcl : localIdx ((plSelS rS).concat rCat hsc') (plG thc D rData rS hdR γ) = 0 := by
    rw [plG_loc thc D rData rS hdR _ hav]
    refine localIdx_eq_zero_of_forall _ _ fun i ↦ ?_
    induction i using Fin.addCases with
    | left j => rw [QRegister.concat_apply_left]; exact hzS _
    | right j => rw [QRegister.concat_apply_right]; exact hzC j
  have hdav : ∀ i, plAv rData rS hdR ((rData.compose (blkS (2 * N) (bP N M) (gP N M aleph))) i) :=
    fun i ↦ plAv_data rData rS hdR _ (by show 0 + i.val < 2 * N + bP N M; have := i.isLt; omega)
  have hcomm : (rData.embedUnitary ((blkS (2 * N) (bP N M) (gP N M aleph)).embedUnitary S)).1 *
      plX thc D rData rS hdR = plX thc D rData rS hdR *
        (rData.embedUnitary ((blkS (2 * N) (bP N M) (gP N M aleph)).embedUnitary S)).1 := by
    rw [← QRegister.embedUnitary_compose]
    exact plX_comm thc D rData rS hdR _ hdav S
  rw [← hcomm]
  simp only [← Matrix.mulVec_mulVec]
  rw [plX_cat thc D rData rS hdR rCat hcav, hk _ hcl]

end Garbage


theorem pair_catKetLR {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    (hb : 2 ≤ beth) {N M : ℕ} [NeZero N] (thc : THCFactorization N M) (D : CData N M)
    (aleph : ℕ) (hbI : 1 ≤ bIC N M) (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchLR N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc)) :
    ∃ S : Unitary (2 ^ (2 * N + bP N M)),
      S.1 = pairSelOp D beth ∧
      CatKet rData rS rCat hsc
        (pairProgramLR v beth thc D aleph hbI rData rS rCat hsc hdisj).compile
        (lcuQ N (bP N M) (gP N M aleph) (pairPrepU thc D aleph) S) := by
  have hdR := plDR rData rS rCat hsc hdisj
  obtain ⟨hsc', hdisj'⟩ := plSel_disj rData rS rCat hsc hdisj
  obtain ⟨S, hSval, hSel⟩ := pairSelR_catKet v beth hb D hbI
    (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph))) (plSelS rS) rCat hsc' hdisj'
  obtain ⟨RS, hRS, hkS⟩ := plSelX thc D rData rS hdR rCat hsc hdisj hsc' S (CatKet.compose _ hSel)
  obtain ⟨RP, hRP, hkP⟩ := plF1 thc D rData rS hdR (Var := Var) v
  obtain ⟨RI, hRI, hkI⟩ := plF2 thc D rData rS hdR (Var := Var) v
  refine ⟨S, hSval, ?_⟩
  unfold lcuQ CatKet
  simp only [pairProgramLR, DynamicCircuit.compile_seq]
  refine ⟨_, hRP.qSeq (hRS.qSeq hRI), fun β hβ ↦ ?_⟩
  let A := (blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (pairPrepU thc D aleph)
  let Sb := (blkS (2 * N) (bP N M) (gP N M aleph)).embedUnitary S
  have hm : ∀ {d : ℕ} (U V : Unitary d), (U * V).1 = U.1 * V.1 := fun _ _ ↦ rfl
  have hP := plCat rS rCat hsc _ _ hkP β hβ
  have hS := plLin rData rS rCat hsc hdisj _ _ hkS A β hβ
  have hI := plLin rData rS rCat hsc hdisj _ _ (fun γ hγ ↦ plCat rS rCat hsc _ _ hkI γ hγ)
    (Sb * A) β hβ
  simp only [QRegister.embedUnitary_mul, hm, ← Matrix.mulVec_mulVec] at hP hS hI ⊢
  rw [hP, hS, hI]

theorem pair_countLR {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ} [NeZero N]
    (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) (hbI : 1 ≤ bIC N M)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchLR N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc)) :
    (pairProgramLR v beth thc D aleph hbI rData rS rCat hsc hdisj).count PrimitiveGate.TOFF = 0 ∧
      (pairProgramLR v beth thc D aleph hbI rData rS rCat hsc hdisj).count PrimitiveGate.T ≤
        pairTLR N M aleph beth := by
  have hdR := plDR rData rS rCat hsc hdisj
  have hp := pairPrepL_count v thc D rData rS hdR
  have hs := pairSelR_count v beth D hbI (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
    (plSelS rS) rCat (plSel_disj rData rS rCat hsc hdisj).1 (plSel_disj rData rS rCat hsc hdisj).2
  have hi := pairPrepLinv_count v thc D rData rS hdR
  have hp2 : (pairPrepL v thc D rData rS hdR).count PrimitiveGate.T ≤
      mbl2T (sA N M) (bP N M + (bP N M + (gP N M aleph - sA N M)))
        (lkSplit (sA N M) (bP N M + (bP N M + (gP N M aleph - sA N M)))) (sA N M / 2) +
      (32 * (gP N M aleph - sA N M + 1) + 16 * bP N M) + 8 * bIC N M := hp.2
  simp only [pairProgramLR, DynamicCircuit.count, pairTLR, aliasTL]
  omega

end QC14.PairProgramLR


/-! Inlined from lane module `THC/PairProgramS.lean`. -/

namespace QC14.PairProgramS

open QuantumComputation QuantumComputation.Specs Matrix Finset Operator QProg
open QuantumComputation.Specs.ArcsinImpl
open QC14.WeightsC QC14.PairBlock QC14.PairPrep QC14.PairProgramM
open QC14.Catalytic QC14.GivensPlane QC14.SelectR QC14.PairSelR
open QC14.SpatialAlias QC14.AliasCircuitM QC14.AliasCircuitS
open scoped Matrix

def pairTS (N M a beth : ℕ) : ℕ :=
  aliasTS N M a + 2 * (8 * bIC N M) + selTR N M beth

def coreWorkS (N M a : ℕ) : ℕ :=
  let m := slotBitsS N M
  max (ancPM N M a) (max (amWork m (wordBitsS N M a) + (m + 1)) (decWorkS N M a))

def scratchS (N M a beth : ℕ) : ℕ :=
  coreWorkS N M a + wordBitsS N M a + selRScr N (bIC N M) beth

theorem scratchS_ge (N M a beth : ℕ) : scratchM N M a beth ≤ scratchS N M a beth := by
  have h : ancPM N M a ≤ coreWorkS N M a := le_max_left _ _
  unfold scratchM scratchS selRScr
  omega

abbrev DataS (N M a n : ℕ) := QRegister (2 * N + (bP N M + gP N M a)) n
abbrev WorkS (N M a beth n : ℕ) := QRegister (scratchS N M a beth) n

variable {n N M a beth : ℕ}

/-- Only the lookup word survives the decoder. The other slices can overlap in time. -/
structure PartsS (N M a n : ℕ) where
  wires : SelectPauliImpl.Wires (slotBitsS N M) (wordBitsS N M a) n
  lk : QRegister (amWork (slotBitsS N M) (wordBitsS N M a)) n
  idx : QRegister (bP N M) n
  seed : QRegister (gP N M a) n
  raw : QRegister (wordBitsS N M a) n
  tmp : QRegister (decWorkS N M a) n
  dd : DecDisj idx seed raw tmp

/-! ### Layout (worker-defined)

`r` = core (`coreWorkS`) ++ raw word (`wordBitsS`) ++ SELECT scratch. Inside the core the lookup
work `lk` and its address-ancilla slot `aw` sit side by side; the decoder work `tmp`, the tail
ancilla and the clean helper of the ideal SELECT reuse the low core wires. The address wires are
the seed bits `2 .. 2 + m` and the lookup target is the raw word. -/

theorem psSlot_le (N M a : ℕ) : 2 + slotBitsS N M ≤ gP N M a := by
  rw [gP_eq]
  have h4 := four_d_le_pow_gC N M a
  have hi : idxC N M + 1 ≤ gC N M a := le_max_left _ _
  unfold slotBitsS
  rcases Nat.eq_zero_or_pos (Nat.clog 2 (dC N M)) with h0 | hpos
  · rw [h0]; unfold idxC at hi; omega
  · have hd : 1 < dC N M := by
      by_contra hc
      rw [Nat.clog_of_right_le_one (by omega)] at hpos
      exact absurd hpos (lt_irrefl 0)
    have hlt := Nat.pow_pred_clog_lt_self (b := 2) (by norm_num) hd
    rw [Nat.pred_eq_sub_one] at hlt
    have h5 : 4 * dC N M ≤ 4 * dC N M * 2 ^ a := Nat.le_mul_of_pos_right _ (Nat.two_pow_pos a)
    by_contra hc
    have h6 : 2 ^ gC N M a ≤ 2 ^ (Nat.clog 2 (dC N M) - 1 + 2) :=
      Nat.pow_le_pow_right (by norm_num) (by omega)
    have h7 : 2 ^ (Nat.clog 2 (dC N M) - 1 + 2) = 2 ^ (Nat.clog 2 (dC N M) - 1) * 4 := by
      rw [pow_add]; norm_num
    omega

theorem psCore_le (N M a beth : ℕ) : coreWorkS N M a ≤ scratchS N M a beth := by
  unfold scratchS; omega

theorem psAncC (N M a : ℕ) : ancPM N M a ≤ coreWorkS N M a := le_max_left _ _

theorem psAmC (N M a : ℕ) :
    amWork (slotBitsS N M) (wordBitsS N M a) + (slotBitsS N M + 1) ≤ coreWorkS N M a := by
  unfold coreWorkS; exact le_trans (le_max_left _ _) (le_max_right _ _)

theorem psTmpC (N M a : ℕ) : decWorkS N M a ≤ coreWorkS N M a := by
  unfold coreWorkS; exact le_trans (le_max_right _ _) (le_max_right _ _)

theorem psAnc_le (N M a beth : ℕ) : 0 + ancPM N M a ≤ scratchS N M a beth := by
  have := psAncC N M a; have := psCore_le N M a beth; omega

theorem psLk_le (N M a beth : ℕ) :
    0 + amWork (slotBitsS N M) (wordBitsS N M a) ≤ scratchS N M a beth := by
  have := psAmC N M a; have := psCore_le N M a beth; omega

theorem psAw_le (N M a beth : ℕ) :
    amWork (slotBitsS N M) (wordBitsS N M a) + (slotBitsS N M + 1) ≤ scratchS N M a beth := by
  have := psAmC N M a; have := psCore_le N M a beth; omega

theorem psTmp_le (N M a beth : ℕ) : 0 + decWorkS N M a ≤ scratchS N M a beth := by
  have := psTmpC N M a; have := psCore_le N M a beth; omega

theorem psHelp_le (N M a beth : ℕ) : 0 + (gP N M a + 1) ≤ scratchS N M a beth := by
  have := pmBase_le N M a; have := psAncC N M a; have := psCore_le N M a beth; omega

theorem psRaw_le (N M a beth : ℕ) :
    coreWorkS N M a + wordBitsS N M a ≤ scratchS N M a beth := by
  unfold scratchS; omega

/-- The PREPARE register `index ++ seed` of the data. -/
abbrev psI (d : DataS N M a n) : QRegister (bP N M + gP N M a) n :=
  d.slice (2 * N) (bP N M + gP N M a) le_rfl

abbrev psIdx (d : DataS N M a n) : QRegister (bP N M) n := d.slice (2 * N) (bP N M) (by omega)

abbrev psSeed (d : DataS N M a n) : QRegister (gP N M a) n := (psI d).slice (bP N M) (gP N M a) le_rfl

abbrev psAnc (r : WorkS N M a beth n) : QRegister (ancPM N M a) n :=
  r.slice 0 (ancPM N M a) (psAnc_le N M a beth)

abbrev psLk (r : WorkS N M a beth n) : QRegister (amWork (slotBitsS N M) (wordBitsS N M a)) n :=
  r.slice 0 _ (psLk_le N M a beth)

abbrev psAw (r : WorkS N M a beth n) : QRegister (slotBitsS N M + 1) n :=
  r.slice (amWork (slotBitsS N M) (wordBitsS N M a)) (slotBitsS N M + 1) (psAw_le N M a beth)

abbrev psTmp (r : WorkS N M a beth n) : QRegister (decWorkS N M a) n :=
  r.slice 0 (decWorkS N M a) (psTmp_le N M a beth)

abbrev psHelp (r : WorkS N M a beth n) : QRegister (gP N M a + 1) n :=
  r.slice 0 (gP N M a + 1) (psHelp_le N M a beth)

abbrev psRaw (r : WorkS N M a beth n) : QRegister (wordBitsS N M a) n :=
  r.slice (coreWorkS N M a) (wordBitsS N M a) (psRaw_le N M a beth)

theorem ps_ne {k : ℕ} (r : QRegister k n) {x y : ℕ} {hx : x < k} {hy : y < k} (h : x ≠ y) :
    r ⟨x, hx⟩ ≠ r ⟨y, hy⟩ := fun e ↦ h (PairProgramLR.pl_inj r e)

theorem psNe {k : ℕ} (r : QRegister k n) (x y : Fin k) (h : x.val ≠ y.val) : r x ≠ r y :=
  fun e ↦ h (congrArg Fin.val (r.wires.injective e))

theorem psBit {k : ℕ} (r : QRegister k n) (β : BitAssignment n) (i : Fin k) :
    β (r i) = basisBits k (localIdx r β) i := by
  rw [Equiv.apply_symm_apply]

/-- Lookup wires: target = raw word, address = seed bits `2 .. 2 + m`. -/
def psW (d : DataS N M a n) (r : WorkS N M a beth n) (hd : ∀ i j, d i ≠ r j) :
    SelectPauliImpl.Wires (slotBitsS N M) (wordBitsS N M a) n where
  sw j := psRaw r j
  xw i := psSeed d ⟨2 + i.val, by have := psSlot_le N M a; omega⟩
  aw k := psAw r k
  sw_inj := fun _ _ h ↦ (psRaw r).wires.injective h
  xw_inj := fun x y h ↦ by
    have h2 := congrArg Fin.val ((psSeed d).wires.injective h)
    change 2 + x.val = 2 + y.val at h2
    exact Fin.ext (by omega)
  aw_inj := fun _ _ h ↦ (psAw r).wires.injective h
  sx := fun _ _ e ↦ hd _ _ e.symm
  sa := fun q k ↦ psNe r _ _ (by
    change coreWorkS N M a + q.val ≠ amWork (slotBitsS N M) (wordBitsS N M a) + k.val
    have := k.isLt; have := psAmC N M a; omega)
  xa := fun _ _ ↦ hd _ _

theorem psDD (d : DataS N M a n) (r : WorkS N M a beth n) (hd : ∀ i j, d i ≠ r j) :
    DecDisj (psIdx d) (psSeed d) (psRaw r) (psTmp r) where
  iseed := QRegister.disjoint_iff.2 fun i j ↦ psNe d _ _ (by
    change 2 * N + i.val ≠ 2 * N + (bP N M + j.val); have := i.isLt; omega)
  iraw := QRegister.disjoint_iff.2 fun _ _ ↦ hd _ _
  iwork := QRegister.disjoint_iff.2 fun _ _ ↦ hd _ _
  sr := QRegister.disjoint_iff.2 fun _ _ ↦ hd _ _
  sw := QRegister.disjoint_iff.2 fun _ _ ↦ hd _ _
  rwires := QRegister.disjoint_iff.2 fun i j ↦ psNe r _ _ (by
    change coreWorkS N M a + i.val ≠ 0 + j.val; have := j.isLt; have := psTmpC N M a; omega)

theorem psHd1 (d : DataS N M a n) (r : WorkS N M a beth n) (hd : ∀ i j, d i ≠ r j) :
    (amReg (psW d r hd)).DisjointWires (psLk r) :=
  amReg_disjoint _ _ (fun i j ↦ psNe r _ _ (by
    change coreWorkS N M a + i.val ≠ 0 + j.val; have := j.isLt; have := psAmC N M a; omega))
    (fun _ _ ↦ hd _ _)

theorem psSlot (d : DataS N M a n) (r : WorkS N M a beth n) (hd : ∀ i j, d i ≠ r j)
    (β : BitAssignment n) : amRow (psW d r hd) β = slotS N M (localIdx (psSeed d) β).val := by
  apply (basisBits (slotBitsS N M)).injective
  funext i
  have h1 : basisBits (slotBitsS N M) (amRow (psW d r hd) β) i =
      β (psSeed d ⟨2 + i.val, by have := psSlot_le N M a; omega⟩) := by
    unfold amRow; rw [Equiv.apply_symm_apply]; rfl
  have e : ∀ x : ℕ, (x / 4 % 2 ^ slotBitsS N M).testBit i.val = x.testBit (2 + i.val) := by
    intro x
    rw [Nat.testBit_mod_two_pow, show (4 : ℕ) = 2 ^ 2 by norm_num, Nat.testBit_div_two_pow,
      decide_eq_true i.isLt, Bool.true_and, Nat.add_comm]
  rw [h1, psBit (psSeed d) β, basisBits_eq_testBit, basisBits_eq_testBit,
    show (slotS N M (localIdx (psSeed d) β).val).val =
      (localIdx (psSeed d) β).val / 4 % 2 ^ slotBitsS N M from rfl, e]

def partsS [NeZero N] (d : DataS N M a n) (r : WorkS N M a beth n)
    (hd : ∀ i j, d i ≠ r j) : PartsS N M a n where
  wires := psW d r hd
  lk := psLk r
  idx := psIdx d
  seed := psSeed d
  raw := psRaw r
  tmp := psTmp r
  dd := psDD d r hd

-- CHECK: ties the physical lookup to the same seed and raw word used by decodeS.
theorem partsS_lookup [NeZero N] (d : DataS N M a n) (r : WorkS N M a beth n)
    (hd : ∀ i j, d i ≠ r j) :
    let p := partsS d r hd
    (∀ β, amRow p.wires β = slotS N M (localIdx p.seed β).val) ∧
      (∀ j, p.wires.sw j = p.raw j) ∧ (amReg p.wires).DisjointWires p.lk :=
  ⟨psSlot d r hd, fun _ ↦ rfl, psHd1 d r hd⟩

def tailS (d : DataS N M a n) (r : WorkS N M a beth n) (hd : ∀ i j, d i ≠ r j) : Circuit n :=
  pmTail d (psAnc r) (fun _ _ ↦ hd _ _)

def selSliceS (r : WorkS N M a beth n) : QRegister (selRScr N (bIC N M) beth) n :=
  r.slice (coreWorkS N M a + wordBitsS N M a) _ le_rfl

theorem selDisjS (d : DataS N M a n) (r : WorkS N M a beth n) (c : QRegister beth n)
    (hsc : r.DisjointWires c) (hd : d.DisjointWires (r.concat c hsc)) :
    ∃ h : (selSliceS r).DisjointWires c,
      (d.compose (blkS (2*N) (bP N M) (gP N M a))).DisjointWires ((selSliceS r).concat c h) := by
  refine ⟨PairProgramQ.pqDisj_sub (PairProgramQ.pqSlice_wires r _ _ _) hsc, ?_⟩
  apply QRegister.DisjointWires.compose_left
  have hr : ∀ i, ∃ j, selSliceS r i = (r.concat c hsc) j :=
    fun i ↦ ⟨Fin.castAdd beth ⟨coreWorkS N M a + wordBitsS N M a + i.val,
      by have := i.isLt; unfold scratchS; omega⟩, by rw [QRegister.concat_apply_left]; rfl⟩
  have hs : ∀ i, ∃ j, c i = (r.concat c hsc) j :=
    fun i ↦ ⟨Fin.natAdd (scratchS N M a beth) i, by rw [QRegister.concat_apply_right]⟩
  exact QRegister.disjoint_comm.mp
    (PairProgramQ.pqDisj_sub (PairProgramQ.pqConcat_wires hr hs) (QRegister.disjoint_comm.mp hd))

noncomputable def prepLegS {Var : Type} [NeZero N] (v : Var) (undo : Bool)
    (thc : THCFactorization N M) (D : CData N M) (d : DataS N M a n)
    (r : WorkS N M a beth n) (hd : ∀ i j, d i ≠ r j) : DynamicCircuit Var n :=
  let p := partsS d r hd
  let decode := decodeS p.idx p.seed p.raw p.tmp p.dd
  let gates := Circuit.seq decode (tailS d r hd)
  let tab := tableS thc D a
  if undo then
    .seq (.circuit gates.inverse) (.seq (amUnload v p.wires tab p.lk) (.circuit (amH d)))
  else
    .seq (.circuit (amH d)) (.seq (amLoad v p.wires tab p.lk) (.circuit gates))

noncomputable abbrev liveS [NeZero N] (thc : THCFactorization N M) (D : CData N M)
    (d : DataS N M a n) (r : WorkS N M a beth n) (hd : ∀ i j, d i ≠ r j) :=
  PairProgramLR.plPM (amFlip (psW d r hd) (tableS thc D a))

/-! ### The garbage map `amFlip` (generic in the wires and the table) -/

section Garbage

open QC14.AliasCircuit PairProgramLR

variable {s w : ℕ} (W : SelectPauliImpl.Wires s w n) (tab : Fin (2 ^ s) → BitAssignment w)

/-- A wire that is neither a lookup address nor a lookup target. -/
abbrev psAv (x : Wire n) : Prop := (∀ i, x ≠ W.xw i) ∧ (∀ j, x ≠ W.sw j)

theorem psFlip_off (β : BitAssignment n) (x : Wire n) (h : ∀ j, x ≠ W.sw j) :
    amFlip W tab β x = β x := by
  unfold amFlip
  rw [Pi.add_apply, W.sysAdd_other _ _ h, add_zero]

theorem psRow_congr (η η' : BitAssignment n) (h : ∀ i, η (W.xw i) = η' (W.xw i)) :
    amRow W η = amRow W η' := by
  unfold amRow; congr 1; funext i; exact h i

theorem psFlip_add (η δ : BitAssignment n) (hδ : ∀ i, δ (W.xw i) = 0) :
    amFlip W tab (η + δ) = amFlip W tab η + δ := by
  unfold amFlip
  rw [psRow_congr W (η + δ) η (fun i ↦ by rw [Pi.add_apply, hδ i, add_zero])]
  exact add_right_comm _ _ _

theorem psFlip_write {k : ℕ} (r : QRegister k n) (hr : ∀ i, psAv W (r i)) (x : BitAssignment k)
    (η : BitAssignment n) : amFlip W tab (writeReg η r x) = writeReg (amFlip W tab η) r x := by
  have hrow : amRow W (writeReg η r x) = amRow W η :=
    psRow_congr W _ _ fun i ↦
      writeReg_apply_of_not_mem _ _ _ _ (by rintro ⟨j, hj⟩; exact (hr j).1 i hj)
  funext y
  by_cases hy : y ∈ Set.range r.wires
  · obtain ⟨j, rfl⟩ := hy
    rw [psFlip_off W tab _ _ (hr j).2]
    exact (writeReg_apply_reg η r x j).trans (writeReg_apply_reg _ r x j).symm
  · unfold amFlip
    rw [hrow, Pi.add_apply, writeReg_apply_of_not_mem _ _ _ _ hy,
      writeReg_apply_of_not_mem _ _ _ _ hy, Pi.add_apply]

theorem psFlip_loc {k : ℕ} (r : QRegister k n) (hr : ∀ i, psAv W (r i)) (η : BitAssignment n) :
    localIdx r (amFlip W tab η) = localIdx r η := by
  show (basisBits k).symm (fun i ↦ amFlip W tab η (r i)) = (basisBits k).symm (fun i ↦ η (r i))
  congr 1
  funext i
  exact psFlip_off W tab η _ (hr i).2

theorem psX_comm {k : ℕ} (r : QRegister k n) (hr : ∀ i, psAv W (r i)) (U : Unitary (2 ^ k)) :
    (r.embedUnitary U).1 * plPM (amFlip W tab) = plPM (amFlip W tab) * (r.embedUnitary U).1 := by
  apply matrix_ext_ket
  intro β
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, plPM_ket, QRegister.embedUnitary_val,
    embedMatrix_mulVec_ket, embedMatrix_mulVec_ket, Matrix.mulVec_sum, psFlip_loc W tab r hr]
  refine Finset.sum_congr rfl fun l _ ↦ ?_
  rw [Matrix.mulVec_smul, plPM_ket, psFlip_write W tab r hr]

theorem psX_circ (c : Circuit n) (hc : ∀ x ∈ c.support, psAv W x) :
    c.eval.1 * plPM (amFlip W tab) = plPM (amFlip W tab) * c.eval.1 := by
  induction c with
  | identity => simp
  | gate g r =>
    exact psX_comm W tab r (fun i ↦ hc _ ((QRegister.mem_image r _).2 ⟨i, rfl⟩)) g.eval
  | seq c₁ c₂ ih₁ ih₂ =>
    have h1 := ih₁ (fun x hx ↦ hc x (Finset.mem_union_left _ hx))
    have h2 := ih₂ (fun x hx ↦ hc x (Finset.mem_union_right _ hx))
    show c₂.eval.1 * c₁.eval.1 * _ = _ * (c₂.eval.1 * c₁.eval.1)
    rw [mul_assoc, h1, ← mul_assoc, h2, mul_assoc]

theorem psX_vec (c : Circuit n) (hc : ∀ x ∈ c.support, psAv W x) (v : Fin (2 ^ n) → ℂ) :
    c.eval.1 *ᵥ (plPM (amFlip W tab) *ᵥ v) = plPM (amFlip W tab) *ᵥ (c.eval.1 *ᵥ v) := by
  rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, psX_circ W tab c hc]

theorem psX_cat {b : ℕ} (rCat : QRegister b n) (hr : ∀ i, psAv W (rCat i)) (γ : BitAssignment n) :
    plPM (amFlip W tab) *ᵥ catalystKet rCat γ = catalystKet rCat (amFlip W tab γ) := by
  unfold catalystKet
  rw [Matrix.mulVec_sum]
  refine Finset.sum_congr rfl fun y _ ↦ ?_
  rw [Matrix.mulVec_smul, plPM_ket, psFlip_write W tab rCat hr]

theorem psZ2 (ζ δ : BitAssignment n) : ζ + δ + δ = ζ := by
  funext x
  rw [Pi.add_apply, Pi.add_apply, add_assoc]
  have h : ∀ z : ZMod 2, z + z = 0 := by decide
  rw [h, add_zero]

theorem psBits_val {k x : ℕ} (hx : x < 2 ^ k) :
    (basisBits k).symm (fun j ↦ AliasCircuit.bitN x j.val) = ⟨x, hx⟩ := by
  rw [Equiv.symm_apply_eq]
  funext j
  rw [basisBits_eq_div_mod]
  rfl

end Garbage

/-! ### Wire facts for the spatial layout -/

section Wires

variable (d : DataS N M a n) (r : WorkS N M a beth n) (hd : ∀ i j, d i ≠ r j)

theorem psW_xw (i : Fin (slotBitsS N M)) :
    (psW d r hd).xw i = psSeed d ⟨2 + i.val, by have := psSlot_le N M a; omega⟩ := rfl

theorem psW_sw (j : Fin (wordBitsS N M a)) : (psW d r hd).sw j = psRaw r j := rfl

theorem psAv_d (j : ℕ) (hj : j < 2 * N + bP N M) : psAv (psW d r hd) (d ⟨j, by omega⟩) :=
  ⟨fun i ↦ by
    rw [psW_xw]
    exact psNe d _ _ (by change j ≠ 2 * N + (bP N M + (2 + i.val)); omega),
   fun q ↦ by rw [psW_sw]; exact hd _ _⟩

theorem psAv_r (j : ℕ) (hj : j < scratchS N M a beth)
    (hn : j < coreWorkS N M a ∨ coreWorkS N M a + wordBitsS N M a ≤ j) :
    psAv (psW d r hd) (r ⟨j, hj⟩) :=
  ⟨fun i ↦ by rw [psW_xw]; exact fun e ↦ hd _ _ e.symm,
   fun q ↦ by
    rw [psW_sw]
    exact psNe r _ _ (by change j ≠ coreWorkS N M a + q.val; have := q.isLt; omega)⟩

theorem psTail_av : ∀ x ∈ (tailS d r hd).support, psAv (psW d r hd) x := by
  intro x hx
  simp only [tailS, pmTail, Circuit.support_seq, Finset.mem_union] at hx
  rcases hx with h | h
  · obtain ⟨i, rfl⟩ := (QRegister.mem_image _ _).1 h
    have hb : bP N M = idxC N M + 1 := rfl
    exact psAv_d d r hd (2 * N + idxC N M) (by omega)
  · obtain ⟨i, rfl⟩ := (QRegister.mem_image _ _).1 (Circuit.support_onRegister_subset _ _ h)
    induction i using Fin.addCases with
    | left j =>
      unfold QC14.PairProgram.cswReg
      rw [QRegister.concat_apply_left]
      exact psAv_d d r hd (2 * N + j.val) (by have := j.isLt; omega)
    | right j =>
      unfold QC14.PairProgram.cswReg
      rw [QRegister.concat_apply_right]
      have := j.isLt
      have := pmBase_le N M a
      have := psAncC N M a
      have := psCore_le N M a beth
      exact psAv_r d r hd (0 + (0 + (0 + j.val))) (by omega) (Or.inl (by omega))

theorem psTail_ket (β : BitAssignment n) (h0 : localIdx r β = 0) :
    (tailS d r hd).eval.1 *ᵥ ket β =
      (d.embedUnitary ((blkA (2 * N) (bP N M) (gP N M a)).embedUnitary (pmTailU N M a))).1 *ᵥ
        ket β :=
  pmTail_ket d (psAnc r) (fun _ _ ↦ hd _ _) β (QC14.localIdx_slice_zero r _ _ _ β h0)

theorem psTailInv_ket (β : BitAssignment n) (h0 : localIdx r β = 0) :
    (tailS d r hd).inverse.eval.1 *ᵥ ket β =
      (d.embedUnitary (star ((blkA (2 * N) (bP N M) (gP N M a)).embedUnitary
        (pmTailU N M a)))).1 *ᵥ ket β :=
  pmTailInv_ket d (psAnc r) (fun _ _ ↦ hd _ _) β (QC14.localIdx_slice_zero r _ _ _ β h0)

end Wires

/-! ### The ideal SELECT table and the decoder on basis kets -/

section Kets

variable [NeZero N] (thc : THCFactorization N M) (D : CData N M) (d : DataS N M a n)

/-- The index word that the ideal SELECT table XORs in, read from the seed. -/
noncomputable def psDel (ζ : BitAssignment n) : BitAssignment n :=
  ∑ q : Fin (bP N M), Pi.single (psIdx d q)
    (AliasCircuit.bitN (spatialF thc D a (localIdx (psSeed d) ζ)).val q.val)

theorem psDel_off (ζ : BitAssignment n) (x : Wire n) (h : ∀ q, x ≠ psIdx d q) :
    psDel thc D d ζ x = 0 := by
  unfold psDel
  rw [Finset.sum_apply]
  exact Finset.sum_eq_zero fun q _ ↦ by rw [Pi.single_apply, if_neg (h q)]

theorem psDel_seed (ζ : BitAssignment n) (i : Fin (gP N M a)) : psDel thc D d ζ (psSeed d i) = 0 :=
  psDel_off thc D d ζ _ fun q ↦ psNe d _ _ (by
    change 2 * N + (bP N M + i.val) ≠ 2 * N + q.val; have := q.isLt; omega)

theorem psDel_add (ζ δ : BitAssignment n) (h : ∀ i, δ (psSeed d i) = 0) :
    psDel thc D d (ζ + δ) = psDel thc D d ζ := by
  have e : localIdx (psSeed d) (ζ + δ) = localIdx (psSeed d) ζ := by
    show (basisBits _).symm (fun i ↦ (ζ + δ) (psSeed d i)) =
      (basisBits _).symm (fun i ↦ ζ (psSeed d i))
    congr 1; funext i; rw [Pi.add_apply, h i, add_zero]
  unfold psDel; rw [e]

variable (r : WorkS N M a beth n) (hd : ∀ i j, d i ≠ r j)

include hd in
theorem psDel_r (ζ : BitAssignment n) (j : Fin (scratchS N M a beth)) : psDel thc D d ζ (r j) = 0 :=
  psDel_off thc D d ζ _ fun q e ↦ hd _ _ e.symm

theorem psDel_xw (ζ : BitAssignment n) (i : Fin (slotBitsS N M)) :
    psDel thc D d ζ ((psW d r hd).xw i) = 0 := by
  rw [psW_xw]; exact psDel_seed thc D d ζ _

include hd in
theorem psSel (ζ : BitAssignment n) (hζ : localIdx (psHelp r) ζ = 0) :
    ((psI d).embedUnitary (selectPauliUnitary (gP N M a) (bP N M) (2 ^ gP N M a)
      (PrepareImpl.tblOf (bP N M) (gP N M a) (spatialF thc D a)))).1 *ᵥ ket ζ =
      ket (ζ + psDel thc D d ζ) := by
  classical
  have hz : ∀ j, ζ (psHelp r j) = 0 := (QC14.localIdx_eq_zero_iff _ _).1 hζ
  have hdP : (psI d).DisjointWires (psHelp r) := QRegister.disjoint_iff.2 (fun _ _ ↦ hd _ _)
  have hk : (psHelp r).basisOutcomeProjector 0 *ᵥ ket ζ = ket ζ := by
    rw [TableLookupSteps.basisOutcomeProjector_mulVec_ket, if_pos hζ]
  have hS := congrArg (fun A : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ ↦ A *ᵥ ket ζ)
    (PrepareImpl.sel_clean (bP N M) (gP N M a)
      (PrepareImpl.tblOf (bP N M) (gP N M a) (spatialF thc D a)) (psI d) (psHelp r) hdP)
  simp only [← Matrix.mulVec_mulVec, hk] at hS
  rw [← hS]
  have hx : ∀ i : Fin (gP N M a),
      ζ (psSeed d i) = AliasCircuit.bitN (localIdx (psSeed d) ζ).val i.val := fun i ↦ by
    rw [psBit (psSeed d) ζ i, basisBits_eq_div_mod]; rfl
  refine Eq.trans (AliasCircuit.lookup_ket
    (SelectPauliImpl.mkWires (b := gP N M a) (N := bP N M) (psI d) (psHelp r) hdP.ne)
    (fun j q ↦ basisBits (bP N M) (spatialF thc D a j) q) (localIdx (psSeed d) ζ) ζ
    (fun k ↦ hz k) (fun i ↦ hx i)) ?_
  rw [AliasCircuit.sysAdd_xrow]
  unfold psDel
  refine congrArg ket (congrArg (ζ + ·) (Finset.sum_congr rfl (fun q _ ↦ ?_)))
  rw [basisBits_eq_div_mod]; rfl

theorem psDec (ζ : BitAssignment n) (hζ : localIdx r ζ = 0) :
    (decodeS (psIdx d) (psSeed d) (psRaw r) (psTmp r) (psDD d r hd)).eval.1 *ᵥ
      ket (amFlip (psW d r hd) (tableS thc D a) ζ) =
      ket (amFlip (psW d r hd) (tableS thc D a) ζ + psDel thc D d ζ) := by
  have hz : ∀ j, ζ (r j) = 0 := (QC14.localIdx_eq_zero_iff _ _).1 hζ
  have htmp : localIdx (psTmp r) (amFlip (psW d r hd) (tableS thc D a) ζ) = 0 :=
    localIdx_eq_zero_of_forall _ _ fun j ↦ by
      have := j.isLt; have := psTmpC N M a; have := psCore_le N M a beth
      change amFlip (psW d r hd) (tableS thc D a) ζ (r ⟨0 + j.val, by omega⟩) = 0
      rw [psFlip_off (psW d r hd) (tableS thc D a) ζ _
        (psAv_r d r hd (0 + j.val) (by omega) (Or.inl (by omega))).2]
      exact hz _
  have hseed : localIdx (psSeed d) (amFlip (psW d r hd) (tableS thc D a) ζ) =
      localIdx (psSeed d) ζ := by
    show (basisBits _).symm (fun i ↦ amFlip (psW d r hd) (tableS thc D a) ζ (psSeed d i)) =
      (basisBits _).symm (fun i ↦ ζ (psSeed d i))
    congr 1; funext i
    exact psFlip_off _ _ ζ _ (fun j ↦ by rw [psW_sw]; exact hd _ _)
  have hR := rowWordS_spec thc D a (localIdx (psSeed d) ζ)
  have hraw : (localIdx (psRaw r) (amFlip (psW d r hd) (tableS thc D a) ζ)).val =
      rowWordS thc D a (slotS N M (localIdx (psSeed d) ζ).val) := by
    have e : localIdx (psRaw r) (amFlip (psW d r hd) (tableS thc D a) ζ) =
        (basisBits _).symm (fun j ↦
          AliasCircuit.bitN (rowWordS thc D a (slotS N M (localIdx (psSeed d) ζ).val)) j.val) := by
      show (basisBits _).symm (fun j ↦ amFlip (psW d r hd) (tableS thc D a) ζ ((psW d r hd).sw j)) = _
      congr 1; funext j
      unfold amFlip
      rw [Pi.add_apply, AliasCircuit.lookup_sysAdd_sw, psSlot d r hd ζ,
        show ζ ((psW d r hd).sw j) = 0 from hz _, zero_add]
      rfl
    rw [e, psBits_val hR.1]
  rw [decodeS_ket (psIdx d) (psSeed d) (psRaw r) (psTmp r) (psDD d r hd) _ htmp, hseed, hraw, hR.2]
  rfl

end Kets

/-! ### PREPARE and PREPARE† through the garbage -/

section Legs

variable [NeZero N] (thc : THCFactorization N M) (D : CData N M) (d : DataS N M a n)
  (r : WorkS N M a beth n) (hd : ∀ i j, d i ≠ r j)

theorem psFwd {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) :
    ∃ F, LowerKraus (prepLegS v false thc D d r hd).compile F ∧
      ∀ η, localIdx r η = 0 → F *ᵥ ket η =
        (liveS thc D d r hd * (d.embedUnitary ((blkA (2 * N) (bP N M) (gP N M a)).embedUnitary
          (orientedPrep (spatialF thc D a)))).1) *ᵥ ket η := by
  obtain ⟨L, hL, hLk⟩ := amLoad_kraus v (psW d r hd) (tableS thc D a) (psLk r) (psHd1 d r hd)
  let dec := decodeS (psIdx d) (psSeed d) (psRaw r) (psTmp r) (psDD d r hd)
  refine ⟨_, (lowerKraus_circuit (Var := Var) (amH d)).qSeq (hL.qSeq
    (lowerKraus_circuit (Var := Var) (Circuit.seq dec (tailS d r hd)))), ?_⟩
  intro η hη
  let B := blkA (2 * N) (bP N M) (gP N M a)
  let S := selectPauliUnitary (gP N M a) (bP N M) (2 ^ gP N M a)
    (PrepareImpl.tblOf (bP N M) (gP N M a) (spatialF thc D a))
  let H := (PrepareImpl.hPre (bP N M) (gP N M a) (gP N M a) le_rfl).eval
  let T := pmTailU N M a
  have hPU : orientedPrep (spatialF thc D a) = T * (S * H) := rfl
  have he : (amH d).eval = (psI d).embedUnitary H := Circuit.eval_onRegister _ _
  have key : ∀ ζ, localIdx r ζ = 0 →
      ((Circuit.seq dec (tailS d r hd)).eval.1 * L) *ᵥ ket ζ =
        (liveS thc D d r hd * ((d.embedUnitary (B.embedUnitary T)).1 *
          ((psI d).embedUnitary S).1)) *ᵥ ket ζ := by
    intro ζ hζ
    have hz : ∀ j, ζ (r j) = 0 := (QC14.localIdx_eq_zero_iff _ _).1 hζ
    have hζ' : localIdx r (ζ + psDel thc D d ζ) = 0 :=
      localIdx_eq_zero_of_forall _ _ fun j ↦ by rw [Pi.add_apply, hz, psDel_r thc D d r hd, add_zero]
    simp only [← Matrix.mulVec_mulVec]
    rw [hLk ζ (QC14.localIdx_slice_zero r _ _ _ ζ hζ), seq_mulVec, psDec thc D d r hd ζ hζ,
      psSel thc D d r hd ζ (QC14.localIdx_slice_zero r _ _ _ ζ hζ),
      ← psFlip_add (psW d r hd) (tableS thc D a) ζ _ (psDel_xw thc D d r hd ζ),
      ← PairProgramLR.plPM_ket (amFlip (psW d r hd) (tableS thc D a)) (ζ + psDel thc D d ζ),
      psX_vec (psW d r hd) (tableS thc D a) _ (psTail_av d r hd),
      psTail_ket d r hd _ hζ']
  have hlin := PairProgramLR.plLinK (psI d) r (QRegister.disjoint_iff.2 (fun _ _ ↦ hd _ _))
    _ _ key H η hη
  have hR : (d.embedUnitary (B.embedUnitary (orientedPrep (spatialF thc D a)))).1 =
      (d.embedUnitary (B.embedUnitary T)).1 *
        (((psI d).embedUnitary S).1 * ((psI d).embedUnitary H).1) := by
    rw [hPU, QRegister.embedUnitary_mul, QRegister.embedUnitary_mul, QRegister.embedUnitary_mul,
      QRegister.embedUnitary_mul, ← QRegister.embedUnitary_compose d B S,
      ← QRegister.embedUnitary_compose d B H]
    rfl
  change (_ * L * (amH d).eval.1) *ᵥ ket η = _
  rw [he, hR]
  simp only [← Matrix.mulVec_mulVec] at hlin ⊢
  exact hlin

theorem psInv {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) :
    ∃ I, LowerKraus (prepLegS v true thc D d r hd).compile I ∧
      ∀ η, localIdx r η = 0 → (I * liveS thc D d r hd) *ᵥ ket η =
        (d.embedUnitary (star ((blkA (2 * N) (bP N M) (gP N M a)).embedUnitary
          (orientedPrep (spatialF thc D a))))).1 *ᵥ ket η := by
  obtain ⟨U, hU, hUk⟩ := amUnload_kraus v (psW d r hd) (tableS thc D a) (psLk r) (psHd1 d r hd)
  let dec := decodeS (psIdx d) (psSeed d) (psRaw r) (psTmp r) (psDD d r hd)
  refine ⟨_, (lowerKraus_circuit (Var := Var) (Circuit.seq dec (tailS d r hd)).inverse).qSeq
      (hU.qSeq (lowerKraus_circuit (Var := Var) (amH d))), ?_⟩
  intro η hη
  let B := blkA (2 * N) (bP N M) (gP N M a)
  let S := selectPauliUnitary (gP N M a) (bP N M) (2 ^ gP N M a)
    (PrepareImpl.tblOf (bP N M) (gP N M a) (spatialF thc D a))
  let H := (PrepareImpl.hPre (bP N M) (gP N M a) (gP N M a) le_rfl).eval
  let T := pmTailU N M a
  have hPU : orientedPrep (spatialF thc D a) = T * (S * H) := rfl
  have he : (amH d).eval = (psI d).embedUnitary H := Circuit.eval_onRegister _ _
  have key : ∀ ζ, localIdx r ζ = 0 →
      ((amH d).eval.1 * U * dec.inverse.eval.1 * liveS thc D d r hd) *ᵥ ket ζ =
        (((psI d).embedUnitary H).1 * ((psI d).embedUnitary S).1) *ᵥ ket ζ := by
    intro ζ hζ
    have hz : ∀ j, ζ (r j) = 0 := (QC14.localIdx_eq_zero_iff _ _).1 hζ
    have hz' : ∀ j, (ζ + psDel thc D d ζ) (r j) = 0 := fun j ↦ by
      rw [Pi.add_apply, hz, psDel_r thc D d r hd, add_zero]
    have hζ' : localIdx r (ζ + psDel thc D d ζ) = 0 := localIdx_eq_zero_of_forall _ _ hz'
    have hflip : amFlip (psW d r hd) (tableS thc D a) ζ =
        amFlip (psW d r hd) (tableS thc D a) (ζ + psDel thc D d ζ) +
          psDel thc D d (ζ + psDel thc D d ζ) := by
      rw [psDel_add thc D d ζ _ (psDel_seed thc D d ζ),
        ← psFlip_add (psW d r hd) (tableS thc D a) _ _ (psDel_xw thc D d r hd ζ), psZ2]
    simp only [← Matrix.mulVec_mulVec]
    rw [PairProgramLR.plPM_ket, hflip, ← psDec thc D d r hd _ hζ', SelectPauliImpl.inv_mulVec,
      hUk _ (QC14.localIdx_slice_zero r _ _ _ _ hζ') (fun i ↦ by rw [psW_sw]; exact hz' _), he,
      psSel thc D d r hd ζ (QC14.localIdx_slice_zero r _ _ _ ζ hζ)]
  have hlin := PairProgramLR.plLinK d r (QRegister.disjoint_iff.2 hd) _ _ key
    (star (B.embedUnitary T)) η hη
  have hSs : star (B.embedUnitary S) = B.embedUnitary S := by
    rw [← QC14.embedUnitary_star', QC14.star_selectPauliUnitary]
  have hHs : star (B.embedUnitary H) = B.embedUnitary H := by
    rw [← QC14.embedUnitary_star', amHStar]
  have hR : (d.embedUnitary (star (B.embedUnitary (orientedPrep (spatialF thc D a))))).1 =
      ((psI d).embedUnitary H).1 * ((psI d).embedUnitary S).1 *
        (d.embedUnitary (star (B.embedUnitary T))).1 := by
    rw [hPU, QRegister.embedUnitary_mul, QRegister.embedUnitary_mul, star_mul, star_mul, hSs, hHs,
      QRegister.embedUnitary_mul, QRegister.embedUnitary_mul,
      ← QRegister.embedUnitary_compose d B S, ← QRegister.embedUnitary_compose d B H]
    rfl
  have hTinv : ∀ x ∈ (tailS d r hd).inverse.support, psAv (psW d r hd) x := fun x hx ↦
    psTail_av d r hd x (by rwa [Circuit.support_inverse] at hx)
  rw [hR]
  simp only [← Matrix.mulVec_mulVec] at hlin ⊢
  rw [← hlin]
  change (amH d).eval.1 *ᵥ (U *ᵥ ((Circuit.seq (tailS d r hd).inverse dec.inverse).eval.1 *ᵥ
      (liveS thc D d r hd *ᵥ ket η))) = _
  rw [seq_mulVec, psX_vec (psW d r hd) (tableS thc D a) _ hTinv, psTailInv_ket d r hd η hη]

/-! ### The SELECT step through the garbage -/

theorem psSelX {Var : Type} [DecidableEq Var] {P : QProg Var (2 ^ n)} (c : QRegister beth n)
    (hsc : r.DisjointWires c) (hdisj : d.DisjointWires (r.concat c hsc))
    (hsc' : (selSliceS r).DisjointWires c) (S : Unitary (2 ^ (2 * N + bP N M)))
    (h : CatKet d (selSliceS r) c hsc' P ((blkS (2 * N) (bP N M) (gP N M a)).embedUnitary S)) :
    ∃ R, LowerKraus P R ∧ ∀ γ, localIdx (r.concat c hsc) γ = 0 →
      (R * liveS thc D d r hd) *ᵥ catalystKet c γ =
        (liveS thc D d r hd *
          (d.embedUnitary ((blkS (2 * N) (bP N M) (gP N M a)).embedUnitary S)).1) *ᵥ
            catalystKet c γ := by
  obtain ⟨R, hR, hk⟩ := h
  refine ⟨R, hR, fun γ hγ ↦ ?_⟩
  obtain ⟨hTC, -⟩ := disjoint_cat d r c hsc hdisj
  have hcav : ∀ i, psAv (psW d r hd) (c i) := fun i ↦
    ⟨fun j e ↦ by rw [psW_xw] at e; exact QRegister.disjoint_iff.1 hTC _ i e.symm,
     fun j e ↦ by rw [psW_sw] at e; exact QRegister.disjoint_iff.1 hsc _ i e.symm⟩
  have hz := eq_zero_of_localIdx_eq_zero _ γ hγ
  have hzS : ∀ j, γ (r j) = 0 := fun j ↦ by
    have := hz (Fin.castAdd beth j); rwa [QRegister.concat_apply_left] at this
  have hzC : ∀ j, γ (c j) = 0 := fun j ↦ by
    have := hz (Fin.natAdd (scratchS N M a beth) j); rwa [QRegister.concat_apply_right] at this
  have hav : ∀ i, psAv (psW d r hd) (((selSliceS r).concat c hsc') i) := by
    intro i
    induction i using Fin.addCases with
    | left j =>
      rw [QRegister.concat_apply_left]
      have := j.isLt
      exact psAv_r d r hd (coreWorkS N M a + wordBitsS N M a + j.val)
        (by unfold scratchS; omega) (Or.inr (by omega))
    | right j =>
      rw [QRegister.concat_apply_right]
      exact hcav j
  have hcl : localIdx ((selSliceS r).concat c hsc') (amFlip (psW d r hd) (tableS thc D a) γ) = 0 := by
    rw [psFlip_loc _ _ _ hav]
    refine localIdx_eq_zero_of_forall _ _ fun i ↦ ?_
    induction i using Fin.addCases with
    | left j => rw [QRegister.concat_apply_left]; exact hzS _
    | right j => rw [QRegister.concat_apply_right]; exact hzC j
  have hdav : ∀ i, psAv (psW d r hd) ((d.compose (blkS (2 * N) (bP N M) (gP N M a))) i) :=
    fun i ↦ psAv_d d r hd (0 + i.val) (by have := i.isLt; omega)
  have hcomm : (d.embedUnitary ((blkS (2 * N) (bP N M) (gP N M a)).embedUnitary S)).1 *
      liveS thc D d r hd = liveS thc D d r hd *
        (d.embedUnitary ((blkS (2 * N) (bP N M) (gP N M a)).embedUnitary S)).1 := by
    rw [← QRegister.embedUnitary_compose]
    exact psX_comm _ _ _ hdav S
  rw [← hcomm]
  simp only [← Matrix.mulVec_mulVec]
  rw [psX_cat _ _ c hcav, hk _ hcl]

end Legs

-- CHECK: exact forward and valid-image inverse contracts; no equality of prepared columns suffices.
theorem prepLegS_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] [NeZero N]
    (v : Var) (thc : THCFactorization N M) (D : CData N M) (d : DataS N M a n)
    (r : WorkS N M a beth n) (hd : ∀ i j, d i ≠ r j) :
    let A := (blkA (2*N) (bP N M) (gP N M a)).embedUnitary (orientedPrep (spatialF thc D a))
    let X := liveS thc D d r hd
    ∃ F I, LowerKraus (prepLegS v false thc D d r hd).compile F ∧
      LowerKraus (prepLegS v true thc D d r hd).compile I ∧
      ∀ β, localIdx r β = 0 →
        (F *ᵥ ket β = (X * (d.embedUnitary A).1) *ᵥ ket β) ∧
        ((I * X) *ᵥ ket β = (d.embedUnitary (star A)).1 *ᵥ ket β) := by
  intro A X
  obtain ⟨F, hF, hkF⟩ := psFwd thc D d r hd v
  obtain ⟨I, hI, hkI⟩ := psInv thc D d r hd v
  exact ⟨F, I, hF, hI, fun β hβ ↦ ⟨hkF β hβ, hkI β hβ⟩⟩

noncomputable def pairProgramS {Var : Type} [NeZero N] (v : Var) (beth : ℕ)
    (thc : THCFactorization N M) (D : CData N M) (a : ℕ) (hbI : 1 ≤ bIC N M)
    (d : DataS N M a n) (r : WorkS N M a beth n) (c : QRegister beth n)
    (hsc : r.DisjointWires c) (hd : d.DisjointWires (r.concat c hsc)) : DynamicCircuit Var n :=
  let dr := fun i j ↦ (disj_of_concat_left hd).ne i j
  let sep := selDisjS d r c hsc hd
  .seq (prepLegS v false thc D d r dr)
    (.seq (pairSelProgramR v beth D hbI (d.compose (blkS (2*N) (bP N M) (gP N M a)))
        (selSliceS r) c sep.1 sep.2)
      (prepLegS v true thc D d r dr))

-- CHECK: replaces pair_catKetLR at the assembly boundary.
theorem pair_catKetS {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var)
    (beth : ℕ) (hb : 2 ≤ beth) [NeZero N] (thc : THCFactorization N M) (D : CData N M)
    (a : ℕ) (hbI : 1 ≤ bIC N M) (d : DataS N M a n) (r : WorkS N M a beth n)
    (c : QRegister beth n) (hsc : r.DisjointWires c) (hd : d.DisjointWires (r.concat c hsc)) :
    ∃ S : Unitary (2 ^ (2*N + bP N M)), S.1 = pairSelOp D beth ∧
      CatKet d r c hsc (pairProgramS v beth thc D a hbI d r c hsc hd).compile
        (lcuQ N (bP N M) (gP N M a) (orientedPrep (spatialF thc D a)) S) := by
  have hdR : ∀ i j, d i ≠ r j := fun i j ↦ (disj_of_concat_left hd).ne i j
  obtain ⟨hsc', hdisj'⟩ := selDisjS d r c hsc hd
  obtain ⟨S, hSval, hSel⟩ := pairSelR_catKet v beth hb D hbI
    (d.compose (blkS (2 * N) (bP N M) (gP N M a))) (selSliceS r) c hsc' hdisj'
  obtain ⟨RS, hRS, hkS⟩ := psSelX thc D d r hdR c hsc hd hsc' S (CatKet.compose _ hSel)
  obtain ⟨RP, RI, hRP, hRI, hk⟩ := prepLegS_kraus v thc D d r hdR
  refine ⟨S, hSval, ?_⟩
  unfold lcuQ CatKet
  simp only [pairProgramS, DynamicCircuit.compile_seq]
  refine ⟨_, hRP.qSeq (hRS.qSeq hRI), fun β hβ ↦ ?_⟩
  let A := (blkA (2 * N) (bP N M) (gP N M a)).embedUnitary (orientedPrep (spatialF thc D a))
  let Sb := (blkS (2 * N) (bP N M) (gP N M a)).embedUnitary S
  have hm : ∀ {k : ℕ} (U V : Unitary k), (U * V).1 = U.1 * V.1 := fun _ _ ↦ rfl
  have hP := PairProgramLR.plCat r c hsc _ _ (fun η hη ↦ (hk η hη).1) β hβ
  have hS := PairProgramLR.plLin d r c hsc hd _ _ hkS A β hβ
  have hI := PairProgramLR.plLin d r c hsc hd _ _
    (fun γ hγ ↦ PairProgramLR.plCat r c hsc _ _ (fun η hη ↦ (hk η hη).2) γ hγ) (Sb * A) β hβ
  simp only [QRegister.embedUnitary_mul, hm, ← Matrix.mulVec_mulVec] at hP hS hI ⊢
  rw [hP, hS, hI]

section Count

open QC14.AliasCircuit QC14.LookupKraus TableLookupSteps SelectSwapImpl Mbl2Impl

theorem psFwd_count {Var : Type} [NeZero N] (v : Var) (thc : THCFactorization N M) (D : CData N M)
    (d : DataS N M a n) (r : WorkS N M a beth n) (hd : ∀ i j, d i ≠ r j) :
    (prepLegS v false thc D d r hd).count PrimitiveGate.TOFF = 0 ∧
      (prepLegS v false thc D d r hd).count PrimitiveGate.T ≤
        mbl2T (slotBitsS N M) (wordBitsS N M a) (lkSplit (slotBitsS N M) (wordBitsS N M a))
          (slotBitsS N M / 2) + decodeTS N M a + 8 * bIC N M := by
  have hT := PrepareImpl.count_hPre (bP N M) (gP N M a) (gP N M a) le_rfl PrimitiveGate.T (by simp)
  have hO := PrepareImpl.count_hPre (bP N M) (gP N M a) (gP N M a) le_rfl PrimitiveGate.TOFF
    (by simp)
  obtain ⟨hLO, hLT⟩ : (amLoad v (psW d r hd) (tableS thc D a) (psLk r) : DynamicCircuit Var n).count
        PrimitiveGate.TOFF = 0 ∧
      (amLoad v (psW d r hd) (tableS thc D a) (psLk r) : DynamicCircuit Var n).count
        PrimitiveGate.T ≤ mbl2T (slotBitsS N M) (wordBitsS N M a)
          (lkSplit (slotBitsS N M) (wordBitsS N M a)) (slotBitsS N M / 2) :=
    lkMbl2Prog_count v (amParams (slotBitsS N M) (wordBitsS N M a))
      (lkSplit (slotBitsS N M) _) (slotBitsS N M / 2)
      (by change lkSplit (slotBitsS N M) _ ≤ slotBitsS N M; unfold lkSplit; omega)
      (by change slotBitsS N M / 2 ≤ slotBitsS N M; omega)
      (amTable (tableS thc D a)) (amReg (psW d r hd)) (psLk r) le_rfl
  obtain ⟨hDO, hDT⟩ := decodeS_count (psIdx d) (psSeed d) (psRaw r) (psTmp r) (psDD d r hd)
  obtain ⟨hTO, hTT⟩ := pmTail_count d (psAnc r) (fun _ _ ↦ hd _ _)
  simp only [prepLegS, partsS, tailS, Bool.false_eq_true, ↓reduceIte, DynamicCircuit.count, amH,
    Circuit.count_onRegister, Circuit.count_seq]
  constructor <;> omega

theorem psInv_count {Var : Type} [NeZero N] (v : Var) (thc : THCFactorization N M) (D : CData N M)
    (d : DataS N M a n) (r : WorkS N M a beth n) (hd : ∀ i j, d i ≠ r j) :
    (prepLegS v true thc D d r hd).count PrimitiveGate.TOFF = 0 ∧
      (prepLegS v true thc D d r hd).count PrimitiveGate.T ≤
        ssT (slotBitsS N M) 1 (slotBitsS N M / 2) + decodeTS N M a + 8 * bIC N M := by
  have hT := PrepareImpl.count_hPre (bP N M) (gP N M a) (gP N M a) le_rfl PrimitiveGate.T (by simp)
  have hO := PrepareImpl.count_hPre (bP N M) (gP N M a) (gP N M a) le_rfl PrimitiveGate.TOFF
    (by simp)
  obtain ⟨hUO, hUT⟩ : (amUnload v (psW d r hd) (tableS thc D a) (psLk r) :
        DynamicCircuit Var n).count PrimitiveGate.TOFF = 0 ∧
      (amUnload v (psW d r hd) (tableS thc D a) (psLk r) : DynamicCircuit Var n).count
        PrimitiveGate.T ≤ ssT (slotBitsS N M) 1 (slotBitsS N M / 2) :=
    lkMbuProg_count v (amParams (slotBitsS N M) (wordBitsS N M a)) (slotBitsS N M / 2)
      (by change slotBitsS N M / 2 ≤ slotBitsS N M; omega)
      (amTable (tableS thc D a)) (amReg (psW d r hd)) (psLk r)
      (amUnloadWork_le (slotBitsS N M) (wordBitsS N M a))
  obtain ⟨hDO, hDT⟩ := decodeS_count (psIdx d) (psSeed d) (psRaw r) (psTmp r) (psDD d r hd)
  obtain ⟨hTO, hTT⟩ := pmTail_count d (psAnc r) (fun _ _ ↦ hd _ _)
  simp only [prepLegS, partsS, tailS, ↓reduceIte, DynamicCircuit.count, amH,
    Circuit.count_onRegister, Circuit.count_seq,
    Circuit.count_inverse_of_ne PrimitiveGate.T (by simp) (by simp),
    Circuit.count_inverse_of_ne PrimitiveGate.TOFF (by simp) (by simp)]
  constructor <;> omega

end Count

theorem pair_countS {Var : Type} (v : Var) (beth : ℕ) [NeZero N]
    (thc : THCFactorization N M) (D : CData N M) (a : ℕ) (hbI : 1 ≤ bIC N M)
    (d : DataS N M a n) (r : WorkS N M a beth n) (c : QRegister beth n)
    (hsc : r.DisjointWires c) (hd : d.DisjointWires (r.concat c hsc)) :
    let P := pairProgramS v beth thc D a hbI d r c hsc hd
    P.count PrimitiveGate.TOFF = 0 ∧ P.count PrimitiveGate.T ≤ pairTS N M a beth := by
  have hp := psFwd_count v thc D d r (fun i j ↦ (disj_of_concat_left hd).ne i j)
  have hi := psInv_count v thc D d r (fun i j ↦ (disj_of_concat_left hd).ne i j)
  have hs := pairSelR_count v beth D hbI (d.compose (blkS (2*N) (bP N M) (gP N M a)))
    (selSliceS r) c (selDisjS d r c hsc hd).1 (selDisjS d r c hsc hd).2
  simp only [pairProgramS, DynamicCircuit.count, pairTS, aliasTS]
  constructor <;> omega

end QC14.PairProgramS


/-! Inlined from lane module `THC/AssemblyG.lean`. -/

namespace QC14.AssemblyG

open QuantumComputation QuantumComputation.Specs Matrix Finset
open QuantumComputation.Specs.ArcsinImpl
open Operator QProg Function
open QC14.Catalytic QC14.GivensPlane QC14.RowProgram QC14.SelectRows QC14.SelectL QC14.BlockLCU QC14.WeightsC
open QC14.PairBlock QC14.PairPrep QC14.PairProgram QC14.AliasProgram QC14.TwoBodyAlgebra
open QC14.PairProgramQ QC14.SelectQ QC14.PairProgramM QC14.PairProgramS QC14.SpatialAlias QC14.AssemblyC
open QC14.WeightsM0 (qpeWalkSteps_mono)
open scoped Matrix

variable {n : ℕ}

/-- Shared work, live spatial word and SELECT scratch. -/
abbrev scratchG (N M aleph beth : ℕ) : ℕ := scratchS N M aleph beth

theorem scratchG_anc (N M aleph beth : ℕ) : 0 + ancP N M aleph ≤ scratchG N M aleph beth := by
  have := ancP_le_M N M aleph
  have := scratchS_ge N M aleph beth
  unfold scratchG; unfold scratchM at *; omega

theorem scratchG_kick (N M aleph beth : ℕ) : ancP N M aleph + 2 * beth ≤ scratchG N M aleph beth := by
  have := ancP_le_M N M aleph
  have := scratchS_ge N M aleph beth
  unfold scratchG; unfold scratchM selQScr at *; omega

open Classical in
noncomputable def uG {N M : ℕ} (thc : THCFactorization N M) (aleph beth : ℕ) (lam : ℝ) :
    Unitary (2 ^ (2 * N + blockAncC N M aleph)) :=
  if h : N ≠ 0 ∧ 2 ≤ beth then
    haveI : NeZero N := ⟨h.1⟩
    let D := cData thc aleph beth lam
    lcuQ N (bP N M) (gP N M aleph) (orientedPrep (spatialF thc D aleph)) (pairSelU D beth)
  else uC thc aleph beth lam

open Classical in
/-- The program (the identity if `N = 0` or the registers overlap). -/
noncomputable def progG {Var : Type} (v : Var) {N M : ℕ} (thc : THCFactorization N M)
    (aleph beth : ℕ) (lam : ℝ) (rActive : QRegister (2 * N + blockAncC N M aleph) n)
    (rScratch : QRegister (scratchG N M aleph beth) n) (rCat : QRegister beth n) :
    DynamicCircuit Var n :=
  if h : N ≠ 0 ∧ ∃ hsc : rScratch.DisjointWires rCat,
      rActive.DisjointWires (rScratch.concat rCat hsc) then
    haveI : NeZero N := ⟨h.1⟩
    if 2 ≤ beth then
      pairProgramS v beth thc (cData thc aleph beth lam) aleph (pqBIC_pos h.1) rActive rScratch
        rCat h.2.1 h.2.2
    else
      pairProgramA v beth thc (cData thc aleph beth lam) aleph rActive
        (rScratch.slice 0 (ancP N M aleph) (scratchG_anc N M aleph beth))
        (rScratch.slice (ancP N M aleph) (2 * beth) (scratchG_kick N M aleph beth)) rCat
        (fun i _ ↦ QRegister.disjoint_iff.1 (disjoint_cat rActive rScratch rCat h.2.1 h.2.2).2 i _)
        (QRegister.disjoint_comm.mp (disjoint_cat rActive rScratch rCat h.2.1 h.2.2).1)
  else .circuit .identity

/-- Per-step `T` count. -/
def stepTG (N M aleph beth : ℕ) : ℕ :=
  if 2 ≤ beth then pairTS N M aleph beth
  else 2 * (16 * 2 ^ sA N M + 32 * (gP N M aleph - sA N M + 1) + 16 * bP N M + 8 * bIC N M) +
    2 * (2 * (N + M) * (16 * (N - 1) * (beth - 1) + 8 * bIC N M))


/-- Total `T` cost: walk steps at the bound `max 1 (κ lamMax)` on `α`. -/
noncomputable def tCostG (N M aleph beth : ℕ) (lamMax εQPE : ℝ) : ℕ :=
  qpeWalkSteps (max 1 (kappaC N M aleph * lamMax)) εQPE * stepTG N M aleph beth

-- CHECK: spatial_block and spatial_herm apply only in the spatial branch.
theorem block_G {N M : ℕ} (thc : THCFactorization N M) {aleph beth : ℕ} {lam : ℝ}
    (hround : thc.IsRounded aleph beth lam) :
    IsQubitizedBlockEncodingUnitary (alphaCS thc aleph beth lam)
      (thcHamiltonian thc - (offsetCS thc aleph beth lam : ℂ) • (1 : Operator (2 ^ (2 * N))))
      (uG thc aleph beth lam) := by
  by_cases h : N ≠ 0 ∧ 2 ≤ beth
  · haveI : NeZero N := ⟨h.1⟩
    have ha : alphaCS thc aleph beth lam = alphaC thc (cData thc aleph beth lam) aleph := by
      unfold alphaCS; exact if_neg h.1
    have ho : offsetCS thc aleph beth lam = offsetC thc (cData thc aleph beth lam) aleph := by
      unfold offsetCS; exact if_neg h.1
    have hu : uG thc aleph beth lam =
        lcuQ N (bP N M) (gP N M aleph) (orientedPrep (spatialF thc (cData thc aleph beth lam) aleph))
          (pairSelU (cData thc aleph beth lam) beth) := by
      unfold uG; exact dif_pos h
    have hD := cData_facts thc hround
    rw [ha, ho, hu]
    refine ⟨alphaC_pos _ _ _, spatial_herm thc _ aleph beth, ?_⟩
    have key := spatial_block hD
    rw [QRegister.embedMatrix_smul, Matrix.mul_smul, Matrix.smul_mul] at key
    exact key
  · have hu : uG thc aleph beth lam = uC thc aleph beth lam := by
      unfold uG; exact dif_neg h
    rw [hu]
    exact block_C thc hround

-- CHECK: use the same beth split for the program and its witness.
theorem realizes_G {Var : Type} [DecidableEq Var] (v : Var) {N M : ℕ}
    (thc : THCFactorization N M) (aleph beth : ℕ) (lam : ℝ)
    (rActive : QRegister (2 * N + blockAncC N M aleph) n)
    (rScratch : QRegister (scratchG N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rScratch.DisjointWires rCat) (hdisj : rActive.DisjointWires (rScratch.concat rCat hsc)) :
    RealizesCatalyticSubroutine rActive rScratch rCat hsc hdisj (uG thc aleph beth lam)
      (progG v thc aleph beth lam rActive rScratch rCat).compile := by
  haveI : NeZero (2 ^ n) := ⟨by positivity⟩
  by_cases hN : N = 0
  · have hu : uG thc aleph beth lam = 1 := by
      unfold uG
      rw [dif_neg (fun h ↦ h.1 hN)]
      unfold uC
      exact dif_pos hN
    have hp : progG v thc aleph beth lam rActive rScratch rCat = .circuit .identity := by
      unfold progG
      exact dif_neg fun h' ↦ h'.1 hN
    rw [hu, hp]
    exact CatKet.catalytic (catKet_circuit_ket (Var := Var) rActive rScratch rCat hsc
      Circuit.identity 1 (fun β _ ↦ by simp)) hdisj
  haveI : NeZero N := ⟨hN⟩
  have hc : N ≠ 0 ∧ ∃ hsc : rScratch.DisjointWires rCat,
      rActive.DisjointWires (rScratch.concat rCat hsc) := ⟨hN, hsc, hdisj⟩
  unfold progG
  rw [dif_pos hc]
  by_cases hb : 2 ≤ beth
  · have hu : uG thc aleph beth lam =
        lcuQ N (bP N M) (gP N M aleph) (orientedPrep (spatialF thc (cData thc aleph beth lam) aleph))
          (pairSelU (cData thc aleph beth lam) beth) := by
      unfold uG; exact dif_pos ⟨hN, hb⟩
    rw [if_pos hb, hu]
    refine CatKet.catalytic ?_ hdisj
    obtain ⟨S, hS, hcat⟩ := pair_catKetS (Var := Var) v beth hb thc (cData thc aleph beth lam)
      aleph (pqBIC_pos hN) rActive rScratch rCat hsc hdisj
    obtain rfl : S = pairSelU (cData thc aleph beth lam) beth := Subtype.ext hS
    exact hcat
  · have hu : uG thc aleph beth lam =
        lcuQ N (bP N M) (gP N M aleph) (pairPrepU thc (cData thc aleph beth lam) aleph)
          (pairSelU (cData thc aleph beth lam) beth) := by
      unfold uG
      rw [dif_neg (fun h ↦ hb h.2)]
      unfold uC
      exact dif_neg hN
    rw [if_neg hb, hu]
    refine CatKet.catalytic ?_ hdisj
    have h1 := scratchG_anc N M aleph beth
    have h2 := scratchG_kick N M aleph beth
    have hAK : (rScratch.slice 0 (ancP N M aleph) h1).DisjointWires
        (rScratch.slice (ancP N M aleph) (2 * beth) h2) :=
      QRegister.slice_disjoint_of_le rScratch 0 (ancP N M aleph) (ancP N M aleph)
        (2 * beth) h1 h2 (by omega)
    have hw : ∀ i, ∃ j, ((rScratch.slice 0 (ancP N M aleph) h1).concat
        (rScratch.slice (ancP N M aleph) (2 * beth) h2) hAK) i = rScratch j :=
      pqConcat_wires (pqSlice_wires _ _ _ _) (pqSlice_wires _ _ _ _)
    have hsc' : ((rScratch.slice 0 (ancP N M aleph) h1).concat
        (rScratch.slice (ancP N M aleph) (2 * beth) h2) hAK).DisjointWires rCat :=
      pqDisj_sub hw hsc
    have hdisj' : rActive.DisjointWires (((rScratch.slice 0 (ancP N M aleph) h1).concat
        (rScratch.slice (ancP N M aleph) (2 * beth) h2) hAK).concat rCat hsc') := by
      have hw2 : ∀ i, ∃ j, (((rScratch.slice 0 (ancP N M aleph) h1).concat
          (rScratch.slice (ancP N M aleph) (2 * beth) h2) hAK).concat rCat hsc') i =
            (rScratch.concat rCat hsc) j :=
        pqConcat_wires (fun i ↦ by
            obtain ⟨j, hj⟩ := hw i
            exact ⟨Fin.castAdd beth j, by rw [QRegister.concat_apply_left]; exact hj⟩)
          (fun i ↦ ⟨Fin.natAdd (scratchG N M aleph beth) i, by
            rw [QRegister.concat_apply_right]⟩)
      exact QRegister.disjoint_comm.mp (pqDisj_sub hw2 (QRegister.disjoint_comm.mp hdisj))
    obtain ⟨S, hS, hcat⟩ := pair_catKetA (Var := Var) v beth thc (cData thc aleph beth lam)
      aleph rActive (rScratch.slice 0 (ancP N M aleph) h1)
      (rScratch.slice (ancP N M aleph) (2 * beth) h2) rCat
      (fun i j ↦ QRegister.disjoint_iff.1 (disjoint_cat rActive rScratch rCat hsc hdisj).2 i _)
      (QRegister.disjoint_comm.mp (disjoint_cat rActive rScratch rCat hsc hdisj).1) hAK hsc'
      hdisj'
    obtain rfl : S = pairSelU (cData thc aleph beth lam) beth := Subtype.ext hS
    exact pqCatKet_sub hw hcat

theorem count_G {Var : Type} (v : Var) {N M : ℕ} (thc : THCFactorization N M) (aleph beth : ℕ)
    (lam : ℝ) (rActive : QRegister (2 * N + blockAncC N M aleph) n)
    (rScratch : QRegister (scratchG N M aleph beth) n) (rCat : QRegister beth n) :
    (progG v thc aleph beth lam rActive rScratch rCat).count PrimitiveGate.TOFF = 0 ∧
      (progG v thc aleph beth lam rActive rScratch rCat).count PrimitiveGate.T ≤
        stepTG N M aleph beth := by
  unfold progG
  split_ifs with h hb
  · haveI : NeZero N := ⟨h.1⟩
    have hc := pair_countS v beth thc (cData thc aleph beth lam) aleph (pqBIC_pos h.1) rActive
      rScratch rCat h.2.1 h.2.2
    unfold stepTG
    rw [if_pos hb]
    exact hc
  · haveI : NeZero N := ⟨h.1⟩
    have hc := pair_countA v beth thc (cData thc aleph beth lam) aleph rActive
      (rScratch.slice 0 (ancP N M aleph) (scratchG_anc N M aleph beth))
      (rScratch.slice (ancP N M aleph) (2 * beth) (scratchG_kick N M aleph beth)) rCat
      (fun i _ ↦ QRegister.disjoint_iff.1 (disjoint_cat rActive rScratch rCat h.2.1 h.2.2).2 i _)
      (QRegister.disjoint_comm.mp (disjoint_cat rActive rScratch rCat h.2.1 h.2.2).1)
    unfold stepTG
    rw [if_neg hb]
    exact hc
  · exact ⟨by simp [DynamicCircuit.count, Circuit.count_identity],
      by simp [DynamicCircuit.count, Circuit.count_identity]⟩

theorem thc_correctness_G {Var : Type} [DecidableEq Var] (v : Var)
    {N M : ℕ} (thc : THCFactorization N M) (η aleph beth : ℕ) (lamMax εSynth : ℝ)
    (hround : thc.IsRounded aleph beth lamMax) (hη : η ≤ 2 * N) (hεSynth : 0 < εSynth) :
    ∃ (U : Unitary (2 ^ (2 * N + blockAncC N M aleph))) (Heff : Operator (2 ^ (2 * N))),
      IsQubitizedBlockEncodingUnitary (alphaCS thc aleph beth lamMax)
        (Heff - (offsetCS thc aleph beth lamMax : ℂ) • (1 : Operator (2 ^ (2 * N)))) U ∧
      AgreesOnElectronSector N η Heff (thcHamiltonian thc) εSynth ∧
      ∀ {n : ℕ}
        (rActive : QRegister (2 * N + blockAncC N M aleph) n)
        (rScratch : QRegister (scratchG N M aleph beth) n)
        (rCat : QRegister beth n)
        (hsc : rScratch.DisjointWires rCat)
        (hdisj : rActive.DisjointWires (rScratch.concat rCat hsc)),
        RealizesCatalyticSubroutine rActive rScratch rCat hsc hdisj U
          (progG v thc aleph beth lamMax rActive rScratch rCat).compile :=
  ⟨uG thc aleph beth lamMax, thcHamiltonian thc, block_G thc hround,
    agrees_C thc η hεSynth.le,
    fun rActive rScratch rCat hsc hdisj ↦
      realizes_G v thc aleph beth lamMax rActive rScratch rCat hsc hdisj⟩

theorem thc_t_cost_G {Var : Type} (v : Var)
    {N M : ℕ} (thc : THCFactorization N M) (η aleph beth : ℕ) (lamMax εSynth εQPE : ℝ)
    (hround : thc.IsRounded aleph beth lamMax) {n : ℕ}
    (rActive : QRegister (2 * N + blockAncC N M aleph) n)
    (rScratch : QRegister (scratchG N M aleph beth) n)
    (rCat : QRegister beth n) :
    let P := progG v thc aleph beth lamMax rActive rScratch rCat
    P.count PrimitiveGate.TOFF = 0 ∧
      qpeWalkSteps (alphaCS thc aleph beth lamMax) εQPE * P.count PrimitiveGate.T ≤
        tCostG N M aleph beth lamMax εQPE := by
  intro P
  have hc := count_G v thc aleph beth lamMax rActive rScratch rCat
  refine ⟨hc.1, ?_⟩
  have h1 : qpeWalkSteps (alphaCS thc aleph beth lamMax) εQPE ≤
      qpeWalkSteps (max 1 (kappaC N M aleph * lamMax)) εQPE :=
    qpeWalkSteps_mono εQPE (alphaCS_pos thc aleph beth lamMax).le (alphaCS_le thc hround)
  unfold tCostG
  exact Nat.mul_le_mul h1 hc.2

end QC14.AssemblyG


namespace QuantumComputation.Specs

open Operator Matrix Circuit
open scoped Matrix Real

noncomputable section

/-!
## Part 4: Parameterized THC Block-Encoding Subroutine
-/

/-- By default we allow only a single variable. -/
inductive THCFactorization.Var where | v deriving DecidableEq, Inhabited

open THCFactorization (Var)
open THCFactorization.Var (v)

/-- Number of block-encoding ancilla qubits used by `thcCandidateProgram`. -/
def thcBlockAncillas (N M aleph beth : ℕ) (lamMax εSynth : ℝ) : ℕ := QC14.AssemblyC.blockAncC N M aleph

/-- Number of clean scratch ancilla qubits (e.g. for QROM outputs and adders), returned to `|0⟩`
at the end of each step, used by `thcCandidateProgram`. -/
def thcScratchAncillas (N M aleph beth : ℕ) (lamMax εSynth : ℝ) : ℕ := QC14.AssemblyG.scratchG N M aleph beth

/-- Number of qubits `b` of the phase-gradient catalyst used by `thcCandidateProgram`. -/
def thcCatalystQubits (N M aleph beth : ℕ) (lamMax εSynth : ℝ) : ℕ := beth

/-- Total logical qubits $2N + m_{\text{block}} + m_{\text{scratch}} + b$ of `thcCandidateProgram`.
Unlike Lee et al. (2021), Table III, this excludes the phase-estimation control register. -/
abbrev thcTotalLogicalQubits (N M aleph beth : ℕ) (lamMax εSynth : ℝ) : ℕ :=
  2 * N + thcBlockAncillas N M aleph beth lamMax εSynth +
    thcScratchAncillas N M aleph beth lamMax εSynth + thcCatalystQubits N M aleph beth lamMax εSynth

/-- Claimed subnormalization $\alpha$ of the block-encoding built by `thcCandidateProgram`. -/
noncomputable def thcCandidateAlpha {N M : ℕ} (thc : THCFactorization N M)
    (η aleph beth : ℕ) (lamMax εSynth : ℝ) : ℝ := QC14.AssemblyC.alphaCS thc aleph beth lamMax

/-- Claimed energy offset $c$ of the block-encoding built by `thcCandidateProgram`. -/
noncomputable def thcCandidateOffset {N M : ℕ} (thc : THCFactorization N M)
    (η aleph beth : ℕ) (lamMax εSynth : ℝ) : ℝ := QC14.AssemblyC.offsetCS thc aleph beth lamMax

/-- Candidate circuit for the self-inverse block-encoding unitary of `thc` on the active register
`rActive` (`2 * N` system qubits followed by the block-encoding ancillas), using clean scratch
ancillas `rScratch` and the phase-gradient catalyst `rCat`. -/
def thcCandidateProgram {N M n : ℕ} (thc : THCFactorization N M)
    (η aleph beth : ℕ) (lamMax εSynth : ℝ)
    (rActive : QRegister (2 * N + thcBlockAncillas N M aleph beth lamMax εSynth) n)
    (rScratch : QRegister (thcScratchAncillas N M aleph beth lamMax εSynth) n)
    (rCat : QRegister (thcCatalystQubits N M aleph beth lamMax εSynth) n) :
    DynamicCircuit Var n := QC14.AssemblyG.progG v thc aleph beth lamMax rActive rScratch rCat

/-- For any THC factorization rounded to `aleph`/`beth` bits with LCU 1-norm at most `lamMax`,
and `η ≤ 2 * N`, `thcCandidateProgram` realizes, with clean scratch and a restored phase-gradient
catalyst, a self-inverse unitary `U` block-encoding `(Heff - c • 1) / α`, with `α` and `c` given
by `thcCandidateAlpha` and `thcCandidateOffset`, where `Heff` preserves and agrees with
`thcHamiltonian thc` on the `η`-electron sector within `εSynth`. -/
theorem thc_correctness
    {N M : ℕ} (thc : THCFactorization N M) (η aleph beth : ℕ) (lamMax εSynth : ℝ)
    (hround : thc.IsRounded aleph beth lamMax) (hη : η ≤ 2 * N) (hεSynth : 0 < εSynth) :
    ∃ (U : Unitary (2 ^ (2 * N + thcBlockAncillas N M aleph beth lamMax εSynth)))
      (Heff : Operator (2 ^ (2 * N))),
      IsQubitizedBlockEncodingUnitary
        (thcCandidateAlpha thc η aleph beth lamMax εSynth)
        (Heff - (thcCandidateOffset thc η aleph beth lamMax εSynth : ℂ) •
          (1 : Operator (2 ^ (2 * N)))) U ∧
      AgreesOnElectronSector N η Heff (thcHamiltonian thc) εSynth ∧
      ∀ {n : ℕ}
        (rActive : QRegister (2 * N + thcBlockAncillas N M aleph beth lamMax εSynth) n)
        (rScratch : QRegister (thcScratchAncillas N M aleph beth lamMax εSynth) n)
        (rCat : QRegister (thcCatalystQubits N M aleph beth lamMax εSynth) n)
        (hsc : rScratch.DisjointWires rCat)
        (hdisj : rActive.DisjointWires (rScratch.concat rCat hsc)),
        RealizesCatalyticSubroutine rActive rScratch rCat hsc hdisj U
          (thcCandidateProgram thc η aleph beth lamMax εSynth rActive rScratch rCat).compile := by
  exact QC14.AssemblyG.thc_correctness_G v thc η aleph beth lamMax εSynth hround hη hεSynth

/-!
## Part 5: `T`-Count Cost Target
-/

/-- Claimed total `T` count of qubitized phase estimation to accuracy `εQPE` with
`thcCandidateProgram`, for `η` electrons and rank-`M` THC factorizations of `N` spatial orbitals
rounded to `aleph`/`beth` bits with LCU 1-norm at most `lamMax`, at synthesis tolerance `εSynth`.

Worked example (Lee et al. 2021, Table III, with `εQPE = 1e-3` Ha from their Eq. 25): their THC
circuit uses `5.3e9` Toffolis, i.e. `2.12e10` `T` gates at `4` `T` gates per Toffoli, and `2142`
logical qubits for the Reiher et al. FeMoco active space (`N = 54`, `η = 54`) with `M = 350`,
`aleph = 10`, `beth = 16` and `lamMax = 306.3` Ha, and `3.2e10` Toffolis (`1.28e11` `T` gates) and
`2196` qubits for the Li et al. one (`N = 76`, `η = 113`) with `M = 450`, `aleph = 10`,
`beth = 20` and `lamMax = 1201.5` Ha. Their qubit counts include the phase-estimation control
register, which `thcTotalLogicalQubits` excludes. -/
noncomputable def thcTCost (N M η aleph beth : ℕ) (lamMax εSynth εQPE : ℝ) : ℕ := QC14.AssemblyG.tCostG N M aleph beth lamMax εQPE

/-- On every rank-`M` THC factorization rounded to `aleph`/`beth` bits with LCU 1-norm at most
`lamMax`, `thcCandidateProgram` uses no `TOFF` gates, and its `T` count over the `qpeWalkSteps`
walk steps of phase estimation to accuracy `εQPE` is at most `thcTCost`. -/
theorem thc_t_cost
    {N M : ℕ} (thc : THCFactorization N M) (η aleph beth : ℕ) (lamMax εSynth εQPE : ℝ)
    (hround : thc.IsRounded aleph beth lamMax) {n : ℕ}
    (rActive : QRegister (2 * N + thcBlockAncillas N M aleph beth lamMax εSynth) n)
    (rScratch : QRegister (thcScratchAncillas N M aleph beth lamMax εSynth) n)
    (rCat : QRegister (thcCatalystQubits N M aleph beth lamMax εSynth) n) :
    let P := thcCandidateProgram thc η aleph beth lamMax εSynth rActive rScratch rCat
    P.count PrimitiveGate.TOFF = 0 ∧
      qpeWalkSteps (thcCandidateAlpha thc η aleph beth lamMax εSynth) εQPE *
        P.count PrimitiveGate.T ≤ thcTCost N M η aleph beth lamMax εSynth εQPE := by
  exact QC14.AssemblyG.thc_t_cost_G v thc η aleph beth lamMax εSynth εQPE hround rActive rScratch rCat

end

end QuantumComputation.Specs
