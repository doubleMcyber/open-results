variable {n : ℕ}

/-- Chain register of the measured pair PREPARE. -/
abbrev ancPM (N M aleph : ℕ) : ℕ :=
  max (bP N M + gP N M aleph + 1) (aliasAncM (bP N M) (gP N M aleph) (sA N M))

/-- Scratch of the pair program: PREPARE chain, then SELECT scratch. -/
abbrev scratchM (N M aleph beth : ℕ) : ℕ := ancPM N M aleph + selQScr N (bIC N M) beth

/-- `T` of one measured pair PREPARE (alias PREPARE plus `CSWAP`). -/
abbrev prepTM (N M aleph : ℕ) : ℕ := aliasTM (bP N M) (gP N M aleph) (sA N M) + 8 * bIC N M

theorem ancP_le_M (N M aleph : ℕ) : ancP N M aleph ≤ ancPM N M aleph := by
  exact max_le_max (le_refl _) (aliasAnc_le_M _ _ _)

theorem pmAlias_le (N M aleph : ℕ) :
    0 + aliasAncM (bP N M) (gP N M aleph) (sA N M) ≤ ancPM N M aleph := by
  rw [Nat.zero_add]
  exact le_max_right _ _

theorem pmBase_le (N M aleph : ℕ) :
    0 + (bP N M + gP N M aleph + 1) ≤ ancPM N M aleph := by
  rw [Nat.zero_add]
  exact le_max_left _ _

def pmTail {N M aleph : ℕ} (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancPM N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j) : Circuit n :=
  .seq ((Circuit.H (⟨idxC N M, by simp only [idxC, bP]; omega⟩ :
        Wire (bP N M + gP N M aleph))).onRegister
        (rData.slice (2 * N) (bP N M + gP N M aleph) le_rfl))
      ((cswapLoc N M (bIC N M) le_rfl).onRegister
        (cswReg rData (rAnc.slice 0 _ (pmBase_le N M aleph)) (fun _ _ ↦ hd _ _)))

noncomputable def pmTailU (N M aleph : ℕ) :=
  permutationUnitary (cswapPerm N M (gP N M aleph)) * hO N M (gP N M aleph)

noncomputable def pairPrepM {Var : Type} (v : Var) {N M : ℕ} (thc : THCFactorization N M)
    (D : CData N M) (aleph : ℕ) (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancPM N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    DynamicCircuit Var n :=
  .seq (aliasPrepM v (sA_le_gP N M aleph) (indP thc D aleph) (altP thc D aleph)
      (aliasTabs thc D aleph).2.2 rData (rAnc.slice 0 _ (pmAlias_le N M aleph)) (fun _ _ ↦ hd _ _))
    (.circuit (pmTail rData rAnc hd))

noncomputable def pairPrepMinv {Var : Type} (v : Var) {N M : ℕ} (thc : THCFactorization N M)
    (D : CData N M) (aleph : ℕ) (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancPM N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    DynamicCircuit Var n :=
  .seq (.circuit (pmTail rData rAnc hd).inverse)
    (aliasPrepMinv v (sA_le_gP N M aleph) (indP thc D aleph) (altP thc D aleph)
      (aliasTabs thc D aleph).2.2 rData (rAnc.slice 0 _ (pmAlias_le N M aleph)) (fun _ _ ↦ hd _ _))

theorem pmTail_ket {N M aleph : ℕ} (d : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (a : QRegister (ancPM N M aleph) n) (hd : ∀ i j, d i ≠ a j)
    (β : BitAssignment n) (h0 : localIdx a β = 0) :
    (pmTail d a hd).eval.1 *ᵥ ket β =
      (d.embedUnitary ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
        (pmTailU N M aleph))).1 *ᵥ ket β := by
  let r := d.slice (2 * N) (bP N M + gP N M aleph) le_rfl
  let H := (Circuit.H (⟨idxC N M, by simp only [idxC, bP]; omega⟩ :
    Wire (bP N M + gP N M aleph))).onRegister r
  let C := (cswapLoc N M (bIC N M) le_rfl).onRegister
    (cswReg d (a.slice 0 _ (pmBase_le N M aleph)) (fun _ _ ↦ hd _ _))
  have hH : H.eval = r.embedUnitary (hO N M (gP N M aleph)) := Circuit.eval_onRegister _ _
  have hC (γ : BitAssignment n) (hz : localIdx a γ = 0) :=
    cswap_clean d (a.slice 0 _ (pmBase_le N M aleph)) (fun _ _ ↦ hd _ _) γ
      (QC14.localIdx_slice_zero a 0 _ (pmBase_le N M aleph) γ hz)
  rw [← QRegister.embedUnitary_compose]
  change (Circuit.seq H C).eval.1 *ᵥ ket β = (r.embedUnitary (pmTailU N M aleph)).1 *ᵥ ket β -- CHECK
  rw [Circuit.eval_seq]
  exact amChainKet r a (QRegister.disjoint_iff.2 (fun _ _ ↦ hd _ _)) H.eval.1 C.eval.1
    (hO N M (gP N M aleph)) (permutationUnitary (cswapPerm N M (gP N M aleph)))
    (fun γ _ ↦ congrArg (fun U : Unitary (2 ^ n) ↦ U.1 *ᵥ ket γ) hH) hC β h0

theorem pmTailInv_ket {N M aleph : ℕ} (d : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (a : QRegister (ancPM N M aleph) n) (hd : ∀ i j, d i ≠ a j)
    (β : BitAssignment n) (h0 : localIdx a β = 0) :
    (pmTail d a hd).inverse.eval.1 *ᵥ ket β =
      (d.embedUnitary (star ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
        (pmTailU N M aleph)))).1 *ᵥ ket β := by
  rw [QC14.embedUnitary_star']
  refine QC14.PairProgram.inv_ket a (pmTail d a hd).eval (pmTail d a hd).inverse.eval _
    (pmTail_ket d a hd) ?_ ?_ β h0
  · rw [← QC14.embedUnitary_star']
    exact (CleanSubroutineBridge.embed_comm_proj d a (QRegister.disjoint_iff.2 hd) _).symm
  · rw [Circuit.eval_inverse]
    exact congrArg Subtype.val (inv_mul_cancel (pmTail d a hd).eval)

theorem pairPrepM_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) {N M : ℕ}
    (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancPM N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    ∃ R : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ,
      LowerKraus (pairPrepM v thc D aleph rData rAnc hd).compile R ∧
      ∀ β, localIdx rAnc β = 0 →
        R *ᵥ ket β = (rData.embedUnitary ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
          (pairPrepU thc D aleph))).1 *ᵥ ket β := by
  let U := prepU (bP N M) (gP N M aleph) (fP thc D aleph)
  let B := blkA (2 * N) (bP N M) (gP N M aleph)
  let T := pmTailU N M aleph
  have e : B.embedUnitary (pairPrepU thc D aleph) = B.embedUnitary T * B.embedUnitary U :=
    QRegister.embedUnitary_mul B T U
  obtain ⟨A, hA, hket⟩ := aliasPrepM_kraus v (sA_le_gP N M aleph) (indP thc D aleph)
    (altP thc D aleph) (aliasTabs thc D aleph).2.2 (aliasTabs_K_lt thc D aleph)
    rData (rAnc.slice 0 _ (pmAlias_le N M aleph)) (fun _ _ ↦ hd _ _)
  have hz (γ : BitAssignment n) (h : localIdx rAnc γ = 0) :=
    QC14.localIdx_slice_zero rAnc 0 _ (pmAlias_le N M aleph) γ h
  refine ⟨_, hA.qSeq (lowerKraus_circuit (Var := Var) (pmTail rData rAnc hd)), ?_⟩
  intro β h0
  change _ = (rData.embedUnitary (B.embedUnitary (pairPrepU thc D aleph))).1 *ᵥ ket β
  rw [e]
  exact amChainKet rData rAnc (QRegister.disjoint_iff.2 hd) A _ (B.embedUnitary U)
    (B.embedUnitary T) (fun γ h ↦ hket γ (hz γ h)) (pmTail_ket rData rAnc hd) β h0

theorem pairPrepMinv_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) {N M : ℕ}
    (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancPM N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    ∃ R : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ,
      LowerKraus (pairPrepMinv v thc D aleph rData rAnc hd).compile R ∧
      ∀ β, localIdx rAnc β = 0 →
        R *ᵥ ket β = (rData.embedUnitary (star ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
          (pairPrepU thc D aleph)))).1 *ᵥ ket β := by
  let U := prepU (bP N M) (gP N M aleph) (fP thc D aleph)
  let B := blkA (2 * N) (bP N M) (gP N M aleph)
  let T := pmTailU N M aleph
  have e : B.embedUnitary (pairPrepU thc D aleph) = B.embedUnitary T * B.embedUnitary U :=
    QRegister.embedUnitary_mul B T U
  obtain ⟨A, hA, hket⟩ := aliasPrepMinv_kraus v (sA_le_gP N M aleph) (indP thc D aleph)
    (altP thc D aleph) (aliasTabs thc D aleph).2.2 (aliasTabs_K_lt thc D aleph)
    rData (rAnc.slice 0 _ (pmAlias_le N M aleph)) (fun _ _ ↦ hd _ _)
  have hz (γ : BitAssignment n) (h : localIdx rAnc γ = 0) :=
    QC14.localIdx_slice_zero rAnc 0 _ (pmAlias_le N M aleph) γ h
  refine ⟨_, (lowerKraus_circuit (Var := Var) (pmTail rData rAnc hd).inverse).qSeq hA, ?_⟩
  intro β h0
  rw [show (blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (pairPrepU thc D aleph) =
    B.embedUnitary T * B.embedUnitary U from e, star_mul]
  exact amChainKet rData rAnc (QRegister.disjoint_iff.2 hd) _ A
    (star (B.embedUnitary T)) (star (B.embedUnitary U)) (pmTailInv_ket rData rAnc hd)
    (fun γ h ↦ hket γ (hz γ h)) β h0

theorem pmTail_count {N M aleph : ℕ} (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancPM N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    (pmTail rData rAnc hd).count PrimitiveGate.TOFF = 0 ∧
    (pmTail rData rAnc hd).count PrimitiveGate.T ≤ 8 * bIC N M := by
  obtain ⟨hO, hT⟩ := cswapLoc_count N M (bIC N M) le_rfl
  simpa [pmTail, Circuit.count_seq, Circuit.count_onRegister] using And.intro hO (le_of_eq hT)

theorem pairPrepM_count {Var : Type} (v : Var) {N M : ℕ} (thc : THCFactorization N M)
    (D : CData N M) (aleph : ℕ) (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancPM N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    (pairPrepM v thc D aleph rData rAnc hd).count PrimitiveGate.TOFF = 0 ∧
      (pairPrepM v thc D aleph rData rAnc hd).count PrimitiveGate.T ≤ prepTM N M aleph := by
  have ha := aliasPrepM_count v (sA_le_gP N M aleph) (indP thc D aleph) (altP thc D aleph)
      (aliasTabs thc D aleph).2.2 rData (rAnc.slice 0 _ (pmAlias_le N M aleph)) (fun _ _ ↦ hd _ _)
  have ht := pmTail_count rData rAnc hd
  simp only [pairPrepM, DynamicCircuit.count, prepTM]
  constructor <;> omega

theorem pairPrepMinv_count {Var : Type} (v : Var) {N M : ℕ} (thc : THCFactorization N M)
    (D : CData N M) (aleph : ℕ) (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancPM N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    (pairPrepMinv v thc D aleph rData rAnc hd).count PrimitiveGate.TOFF = 0 ∧
      (pairPrepMinv v thc D aleph rData rAnc hd).count PrimitiveGate.T ≤ prepTM N M aleph := by
  have ha := aliasPrepMinv_count v (sA_le_gP N M aleph) (indP thc D aleph) (altP thc D aleph)
      (aliasTabs thc D aleph).2.2 rData (rAnc.slice 0 _ (pmAlias_le N M aleph)) (fun _ _ ↦ hd _ _)
  have ht := pmTail_count rData rAnc hd
  simp only [pairPrepMinv, DynamicCircuit.count, prepTM, Circuit.count_inverse_of_ne PrimitiveGate.T (by simp) (by simp),
    Circuit.count_inverse_of_ne PrimitiveGate.TOFF (by simp) (by simp)]
  constructor <;> omega

theorem pmAnc_le (N M aleph beth : ℕ) : 0 + ancPM N M aleph ≤ scratchM N M aleph beth := by
  unfold scratchM; omega

/-- Disjointness facts of the SELECT call, from those of the whole program. -/
theorem pmSel_disj {N M aleph beth : ℕ}
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchM N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc)) :
    ∃ hsc' : (rS.slice (ancPM N M aleph) (selQScr N (bIC N M) beth) le_rfl).DisjointWires rCat,
      (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph))).DisjointWires
        ((rS.slice (ancPM N M aleph) (selQScr N (bIC N M) beth) le_rfl).concat rCat hsc') := by
  refine ⟨pqDisj_sub (pqSlice_wires rS _ _ _) hsc, ?_⟩
  apply QRegister.DisjointWires.compose_left
  have hr : ∀ i, ∃ j, rS.slice (ancPM N M aleph) (selQScr N (bIC N M) beth) le_rfl i =
      (rS.concat rCat hsc) j :=
    fun i ↦ ⟨Fin.castAdd beth ⟨ancPM N M aleph + i.val, by unfold scratchM; omega⟩,
      by rw [QRegister.concat_apply_left]; rfl⟩
  have hs : ∀ i, ∃ j, rCat i = (rS.concat rCat hsc) j :=
    fun i ↦ ⟨Fin.natAdd (scratchM N M aleph beth) i, by rw [QRegister.concat_apply_right]⟩
  exact QRegister.disjoint_comm.mp
    (pqDisj_sub (pqConcat_wires hr hs) (QRegister.disjoint_comm.mp hdisj))

/-- `pairPrepM ; pairSelProgramQ ; pairPrepMinv` (worker-defined). -/
noncomputable def pairProgramM {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ}
    (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) (hbI : 1 ≤ bIC N M)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchM N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc)) :
    DynamicCircuit Var n :=
  have hd : ∀ i j, rData i ≠ rS.slice 0 (ancPM N M aleph) (pmAnc_le N M aleph beth) j :=
    fun i _ ↦ QRegister.disjoint_iff.1 (disjoint_cat rData rS rCat hsc hdisj).2 i _
  .seq (pairPrepM v thc D aleph rData _ hd)
    (.seq (pairSelProgramQ v beth D hbI (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
        (rS.slice (ancPM N M aleph) (selQScr N (bIC N M) beth) le_rfl) rCat
        (pmSel_disj rData rS rCat hsc hdisj).1 (pmSel_disj rData rS rCat hsc hdisj).2)
      (pairPrepMinv v thc D aleph rData _ hd))

theorem pair_catKetM {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    (hb : 2 ≤ beth) {N M : ℕ} [NeZero N] (thc : THCFactorization N M) (D : CData N M)
    (aleph : ℕ) (hbI : 1 ≤ bIC N M) (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchM N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc)) :
    ∃ S : Unitary (2 ^ (2 * N + bP N M)),
      S.1 = pairSelOp D beth ∧
      CatKet rData rS rCat hsc
        (pairProgramM v beth thc D aleph hbI rData rS rCat hsc hdisj).compile
        (lcuQ N (bP N M) (gP N M aleph) (pairPrepU thc D aleph) S) := by
  have hd : ∀ i j, rData i ≠ rS.slice 0 (ancPM N M aleph) (pmAnc_le N M aleph beth) j :=
    fun i _ ↦ QRegister.disjoint_iff.1 (disjoint_cat rData rS rCat hsc hdisj).2 i _
  obtain ⟨hsc', hdisj'⟩ := pmSel_disj rData rS rCat hsc hdisj
  obtain ⟨S, hSval, hSel⟩ := pairSelQ_catKet v beth hb D hbI
    (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
    (rS.slice (ancPM N M aleph) (selQScr N (bIC N M) beth) le_rfl) rCat hsc' hdisj'
  have hSel2 := CatKet.compose (blkS (2 * N) (bP N M) (gP N M aleph)) hSel
  have hSel3 : CatKet rData rS rCat hsc _ _ := pqCatKet_sub (pqSlice_wires rS _ _ _) hSel2
  have hz : ∀ β, localIdx rS β = 0 →
      localIdx (rS.slice 0 (ancPM N M aleph) (pmAnc_le N M aleph beth)) β = 0 := by
    intro β h0
    apply localIdx_eq_zero_of_forall
    intro i
    rw [QRegister.slice_apply]
    exact eq_zero_of_localIdx_eq_zero _ β h0 _
  obtain ⟨R, hR, hK⟩ := pairPrepM_kraus v thc D aleph rData _ hd
  obtain ⟨Ri, hRi, hKi⟩ := pairPrepMinv_kraus v thc D aleph rData _ hd
  have hPrep := QC14.LookupKraus.lkCatKet_of_kraus rData rS rCat hsc
    ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (pairPrepU thc D aleph)) hR
    (fun β h0 ↦ hK β (hz β h0))
  have hInvK := QC14.LookupKraus.lkCatKet_of_kraus rData rS rCat hsc
    (star ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (pairPrepU thc D aleph))) hRi
    (fun β h0 ↦ hKi β (hz β h0))
  refine ⟨S, hSval, ?_⟩
  unfold lcuQ
  simp only [pairProgramM, DynamicCircuit.compile_seq]
  exact CatKet.seq hdisj hPrep (CatKet.seq hdisj hSel3 hInvK)

theorem pair_countM {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ} [NeZero N]
    (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ) (hbI : 1 ≤ bIC N M)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rS : QRegister (scratchM N M aleph beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rData.DisjointWires (rS.concat rCat hsc)) :
    (pairProgramM v beth thc D aleph hbI rData rS rCat hsc hdisj).count PrimitiveGate.TOFF = 0 ∧
      (pairProgramM v beth thc D aleph hbI rData rS rCat hsc hdisj).count PrimitiveGate.T ≤
        2 * prepTM N M aleph + selTQ N M beth := by
  have hd : ∀ i j, rData i ≠ rS.slice 0 (ancPM N M aleph) (pmAnc_le N M aleph beth) j :=
    fun i _ ↦ QRegister.disjoint_iff.1 (disjoint_cat rData rS rCat hsc hdisj).2 i _
  have hp := pairPrepM_count v thc D aleph rData _ hd
  have hs := pairSelQ_count v beth D hbI (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
    (rS.slice (ancPM N M aleph) (selQScr N (bIC N M) beth) le_rfl) rCat
    (pmSel_disj rData rS rCat hsc hdisj).1 (pmSel_disj rData rS rCat hsc hdisj).2
  have hi := pairPrepMinv_count v thc D aleph rData _ hd
  simp only [pairProgramM, DynamicCircuit.count]
  omega

end QC14.PairProgramM


/-! Inlined from lane module `THC/SelectR.lean`. -/

namespace QC14.SelectR

open QuantumComputation QuantumComputation.Specs Matrix Finset
open QuantumComputation.Specs.ArcsinImpl
open QuantumComputation.Specs.SelectSwapImpl QuantumComputation.Specs.Mbl2Impl
open Operator QProg Function
open QC14.Catalytic QC14.GivensPlane QC14.GivensCascade QC14.SpinBlock QC14.RowProgram
open QC14.SelectRows QC14.SelectL QC14.RegCascade QC14.RegKickS QC14.SelectQ QC14.LookupKraus
open QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.GivensOps
open QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.OrbitalBridge
open scoped Matrix

variable {n : ℕ}

/-- `T` of the measured lookup (`s = 0`, `s2 = (bI − 1) / 2`) plus the measured unlookup
(split `(bI − 1) / 2`) of a `w`-bit table on `bI − 1` address bits. -/
def selLkT (bI w : ℕ) : ℕ :=
  mbl2T (bI - 1) w 0 ((bI - 1) / 2) + ssT (bI - 1) 1 ((bI - 1) / 2)

/-- Lookup ancilla: the `s = 0` select-swap copy `w`, the address scratch, the flag, and the
`s2 = (bI − 1) / 2` clean-up scratch. -/
def selLkScr (N bI beth : ℕ) : ℕ :=
  (N * beth + 2) + (bI - 1) + 1 + (2 ^ ((bI - 1) / 2) + (bI - 1 - (bI - 1) / 2) + 1)

/-- Scratch size: `selQScr` then the lookup ancilla. -/
def selRScr (N bI beth : ℕ) : ℕ := selQScr N bI beth + selLkScr N bI beth

/-- Scratch wires of the `SelectQ` part. -/
def srQ {N bI beth : ℕ} (rS : QRegister (selRScr N bI beth) n) : QRegister (selQScr N bI beth) n :=
  rS.slice 0 (selQScr N bI beth) (by unfold selRScr; omega)

/-- The lookup ancilla. -/
def srL {N bI beth : ℕ} (rS : QRegister (selRScr N bI beth) n) : QRegister (selLkScr N bI beth) n :=
  rS.slice (selQScr N bI beth) (selLkScr N bI beth) (by unfold selRScr; exact le_rfl)

theorem srQ_apply {N bI beth : ℕ} (rS : QRegister (selRScr N bI beth) n)
    (i : Fin (selQScr N bI beth)) :
    srQ rS i = rS ⟨i.val, by unfold selRScr; omega⟩ := by
  rw [srQ, QRegister.slice_apply]; congr 1; exact Fin.ext (Nat.zero_add _)

theorem srL_apply {N bI beth : ℕ} (rS : QRegister (selRScr N bI beth) n)
    (i : Fin (selLkScr N bI beth)) :
    srL rS i = rS ⟨selQScr N bI beth + i.val, by unfold selRScr; omega⟩ :=
  QRegister.slice_apply _ _ _ _ _

theorem srHsc {N bI beth : ℕ} {rS : QRegister (selRScr N bI beth) n} {rCat : QRegister beth n}
    (hsc : rS.DisjointWires rCat) : (srQ rS).DisjointWires rCat :=
  QRegister.disjoint_iff.2 fun i j h ↦ QRegister.disjoint_iff.1 hsc _ j ((srQ_apply rS i).symm.trans h)

theorem srRTI_ne {N bI beth : ℕ} {rTI : QRegister (2 * N + bI) n}
    {rS : QRegister (selRScr N bI beth) n} {rCat : QRegister beth n}
    {hsc : rS.DisjointWires rCat} (hdisj : rTI.DisjointWires (rS.concat rCat hsc))
    (i : Fin (2 * N + bI)) (j : Fin (selRScr N bI beth)) : rTI i ≠ rS j := by
  intro h
  have := QRegister.disjoint_iff.1 hdisj i (Fin.castAdd beth j)
  rw [QRegister.concat_apply_left] at this
  exact this h

theorem srHdisj {N bI beth : ℕ} {rTI : QRegister (2 * N + bI) n}
    {rS : QRegister (selRScr N bI beth) n} {rCat : QRegister beth n}
    {hsc : rS.DisjointWires rCat} (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    rTI.DisjointWires ((srQ rS).concat rCat (srHsc hsc)) := by
  apply QRegister.disjoint_iff.2
  intro i j
  induction j using Fin.addCases with
  | left a =>
      rw [QRegister.concat_apply_left, srQ_apply]
      exact srRTI_ne hdisj i _
  | right c =>
      rw [QRegister.concat_apply_right]
      have := QRegister.disjoint_iff.1 hdisj i (Fin.natAdd _ c)
      rwa [QRegister.concat_apply_right] at this

/-- The lookup wires: those of `SelectQ.sqWires` on the `selQScr` slice. -/
abbrev srW {N bI beth : ℕ} (hbI : 1 ≤ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selRScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    SelectPauliImpl.Wires (bI - 1) (N * beth + 2) n :=
  sqWires hbI rTI (srQ rS) rCat (srHsc hsc) (srHdisj hdisj)

/-- Lookup parameters: `2^(bI−1)` entries, `bI − 1` address bits, `N · beth + 2` bit words. -/
abbrev srP (N bI beth : ℕ) : LookupParams := QC14.AliasCircuitM.amParams (bI - 1) (N * beth + 2)

/-- The table `sqTab` as a `LookupTable`. -/
noncomputable abbrev srTab {N L : ℕ} (beth bI : ℕ) (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) :
    LookupTable (srP N bI beth) :=
  QC14.AliasCircuitM.amTable (sqTab beth bI k s)

theorem srHN1 (N bI beth : ℕ) :
    2 ^ 0 * (srP N bI beth).w + ((srP N bI beth).m - 0) + 1 +
      (2 ^ ((bI - 1) / 2) * 1 + ((srP N bI beth).m - (bI - 1) / 2) + 1) ≤ selLkScr N bI beth := by
  show 2 ^ 0 * (N * beth + 2) + (bI - 1 - 0) + 1 +
      (2 ^ ((bI - 1) / 2) * 1 + (bI - 1 - (bI - 1) / 2) + 1) ≤ selLkScr N bI beth
  unfold selLkScr
  simp only [pow_zero, one_mul, Nat.sub_zero, mul_one, le_refl]

theorem srHN2 (N bI beth : ℕ) :
    2 ^ ((bI - 1) / 2) * 1 + ((srP N bI beth).m - (bI - 1) / 2) + 1 ≤ selLkScr N bI beth := by
  show 2 ^ ((bI - 1) / 2) * 1 + (bI - 1 - (bI - 1) / 2) + 1 ≤ selLkScr N bI beth
  unfold selLkScr
  omega

theorem srD {N bI beth : ℕ} (hbI : 1 ≤ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selRScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    (QC14.AliasCircuitM.amReg (srW hbI rTI rS rCat hsc hdisj)).DisjointWires (srL rS) := by
  apply QC14.AliasCircuitM.amReg_disjoint
  · intro i j h
    have h' : sqRX (srQ rS) i = srL rS j := h
    rw [sqRX_apply, srQ_apply, srL_apply] at h'
    have h1 : i.val = selQScr N bI beth + j.val := congrArg Fin.val (rS.wires.injective h')
    have := i.isLt
    have := sqLe1 N bI beth
    omega
  · intro i j h
    rw [srL_apply] at h
    exact srRTI_ne hdisj _ _ h

/-- The measured lookup (`s = 0`). -/
noncomputable def srLoad {Var : Type} (v : Var) (beth : ℕ) {N L bI : ℕ} (hbI : 1 ≤ bI)
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selRScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    DynamicCircuit Var n :=
  lkMbl2Prog v (srP N bI beth) 0 ((bI - 1) / 2) (Nat.zero_le _) (Nat.div_le_self _ _)
    (srTab beth bI k s) (QC14.AliasCircuitM.amReg (srW hbI rTI rS rCat hsc hdisj)) (srL rS)
    (srHN1 N bI beth)

/-- The measured unlookup. -/
noncomputable def srUnload {Var : Type} (v : Var) (beth : ℕ) {N L bI : ℕ} (hbI : 1 ≤ bI)
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selRScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    DynamicCircuit Var n :=
  lkMbuProg v (srP N bI beth) ((bI - 1) / 2) (Nat.div_le_self _ _)
    (srTab beth bI k s) (QC14.AliasCircuitM.amReg (srW hbI rTI rS rCat hsc hdisj)) (srL rS)
    (srHN2 N bI beth)


/-! ## Kraus facts of the load and the unload -/

theorem srLoad_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    {N L bI : ℕ} (hbI : 1 ≤ bI)
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selRScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    ∃ R, LowerKraus (srLoad v beth hbI k s rTI rS rCat hsc hdisj).compile R ∧
      ∀ γ, localIdx (srL rS) γ = 0 →
        R *ᵥ ket γ = ket (QC14.AliasCircuitM.amFlip (srW hbI rTI rS rCat hsc hdisj) (sqTab beth bI k s) γ) := by
  obtain ⟨R, hR, h⟩ := lkMbl2Prog_kraus v (srP N bI beth) 0 ((bI - 1) / 2) (Nat.zero_le _)
    (Nat.div_le_self _ _) (srTab beth bI k s) (QC14.AliasCircuitM.amReg (srW hbI rTI rS rCat hsc hdisj)) (srL rS)
    (srHN1 N bI beth) (srD hbI rTI rS rCat hsc hdisj)
  exact ⟨R, hR, fun β hz ↦ (h β hz).trans
    (congrArg ket (QC14.AliasCircuitM.amWrite _ (sqTab beth bI k s) β))⟩

theorem srUnload_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    {N L bI : ℕ} (hbI : 1 ≤ bI)
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selRScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    ∃ R, LowerKraus (srUnload v beth hbI k s rTI rS rCat hsc hdisj).compile R ∧
      ∀ γ, localIdx (srL rS) γ = 0 → (∀ i, γ ((srW hbI rTI rS rCat hsc hdisj).sw i) = 0) →
        R *ᵥ ket (QC14.AliasCircuitM.amFlip (srW hbI rTI rS rCat hsc hdisj) (sqTab beth bI k s) γ) = ket γ := by
  obtain ⟨R, hR, h⟩ := lkMbuProg_kraus v (srP N bI beth) ((bI - 1) / 2) (Nat.div_le_self _ _)
    (srTab beth bI k s) (QC14.AliasCircuitM.amReg (srW hbI rTI rS rCat hsc hdisj)) (srL rS) (srHN2 N bI beth) (srD hbI rTI rS rCat hsc hdisj)
  refine ⟨R, hR, ?_⟩
  intro γ hz ht
  have hc : localIdx (srL rS) (QC14.AliasCircuitM.amFlip (srW hbI rTI rS rCat hsc hdisj) (sqTab beth bI k s) γ) = 0 := by
    apply (QC14.localIdx_eq_zero_iff _ _).2
    intro j
    change γ (srL rS j) + (srW hbI rTI rS rCat hsc hdisj).sysAdd _ (srL rS j) = 0
    have htDisj : (TableLookupImpl.targetReg (srP N bI beth)
        (QC14.AliasCircuitM.amReg (srW hbI rTI rS rCat hsc hdisj))).DisjointWires (srL rS) := (srD hbI rTI rS rCat hsc hdisj).compose_left _
    have hneq (i : Fin (N * beth + 2)) : srL rS j ≠ (srW hbI rTI rS rCat hsc hdisj).sw i :=
      fun e ↦ htDisj.ne i j ((QC14.AliasCircuitM.amTarget _ i).trans e.symm)
    rw [(srW hbI rTI rS rCat hsc hdisj).sysAdd_other _ _ hneq, add_zero]
    exact (QC14.localIdx_eq_zero_iff _ γ).1 hz j
  exact (h _ hc (QC14.AliasCircuitM.amValid _ _ γ ht)).trans
    (congrArg ket ((QC14.AliasCircuitM.amWrite _ _ _).trans
      (QC14.AliasCircuitM.amFlip_flip _ _ γ)))

theorem srFlip {N L bI beth : ℕ} (hbI : 1 ≤ bI) (k : Fin L → Fin N → ℤ) (s : Fin L → Bool)
    (rTI : QRegister (2 * N + bI) n) (rS : QRegister (selRScr N bI beth) n)
    (rCat : QRegister beth n) (hsc : rS.DisjointWires rCat)
    (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) (γ : BitAssignment n) (j : Fin (2 ^ bI))
    (hj : bdHi (k := 2 * N) (j := bI) (localIdx rTI γ) = j) :
    QC14.AliasCircuitM.amFlip (srW hbI rTI rS rCat hsc hdisj) (sqTab beth bI k s) γ =
      γ + QC14.UnaryLookup.tabAdd (srW hbI rTI rS rCat hsc hdisj) (sqTab beth bI k s ⟨j.val / 2, sqA_lt hbI j⟩) := by
  have hrow : QC14.AliasCircuitM.amRow (srW hbI rTI rS rCat hsc hdisj) γ = ⟨j.val / 2, sqA_lt hbI j⟩ := by
    unfold QC14.AliasCircuitM.amRow
    rw [Equiv.symm_apply_eq]
    funext i
    subst hj
    refine Eq.trans (congrFun ((basisBits (2 * N + bI)).apply_symm_apply (fun i ↦ γ (rTI i)))
      ⟨2 * N + 1 + i.val, by omega⟩).symm ?_
    rw [sqAddr_bits hbI _ i, basisBits_eq_div_mod]
    rfl
  unfold QC14.AliasCircuitM.amFlip
  rw [hrow, QC14.AliasCircuit.tabAdd_eq_sysAdd]

theorem srTabAdd_T {N bI beth : ℕ} (hbI : 1 ≤ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selRScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc))
    (a : Fin (N * beth + 2) → ZMod 2) (i : Fin (2 * N + bI)) :
    QC14.UnaryLookup.tabAdd (srW hbI rTI rS rCat hsc hdisj) a (rTI i) = 0 :=
  sqTabAdd_off _ _ _ fun q h ↦ srRTI_ne hdisj i _ (h.trans ((sqRX_apply _ q).trans (srQ_apply rS _)))

theorem srTabAdd_L {N bI beth : ℕ} (hbI : 1 ≤ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selRScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc))
    (a : Fin (N * beth + 2) → ZMod 2) (c : Fin (selLkScr N bI beth)) :
    QC14.UnaryLookup.tabAdd (srW hbI rTI rS rCat hsc hdisj) a (srL rS c) = 0 := by
  apply sqTabAdd_off
  intro q h
  have h' : srL rS c = sqRX (srQ rS) q := h
  rw [srL_apply, sqRX_apply, srQ_apply] at h'
  have h1 : selQScr N bI beth + c.val = q.val := congrArg Fin.val (rS.wires.injective h')
  have := q.isLt
  have := sqLe1 N bI beth
  omega

theorem srUnload_ket {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    {N L bI : ℕ} (hbI : 1 ≤ bI)
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selRScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    ∃ R, LowerKraus (srUnload v beth hbI k s rTI rS rCat hsc hdisj).compile R ∧
      ∀ γ (j : Fin (2 ^ bI)), bdHi (k := 2 * N) (j := bI) (localIdx rTI γ) = j →
        localIdx (srL rS) γ = 0 →
        (∀ q, γ (sqRX (srQ rS) q) = sqTab beth bI k s ⟨j.val / 2, sqA_lt hbI j⟩ q) →
        R *ᵥ ket γ = ket (γ + QC14.UnaryLookup.tabAdd (srW hbI rTI rS rCat hsc hdisj)
          (sqTab beth bI k s ⟨j.val / 2, sqA_lt hbI j⟩)) := by
  obtain ⟨R, hR, h⟩ := srUnload_kraus v beth hbI k s rTI rS rCat hsc hdisj
  refine ⟨R, hR, fun γ j hj hL hW ↦ ?_⟩
  obtain ⟨D, hD⟩ : ∃ D, D = QC14.UnaryLookup.tabAdd (srW hbI rTI rS rCat hsc hdisj)
      (sqTab beth bI k s ⟨j.val / 2, sqA_lt hbI j⟩) := ⟨_, rfl⟩
  rw [← hD]
  have hDT : ∀ i, D (rTI i) = 0 := fun i ↦ by rw [hD]; exact srTabAdd_T hbI rTI rS rCat hsc hdisj _ i
  have hj0 : bdHi (k := 2 * N) (j := bI) (localIdx rTI (γ + D)) = j := by
    rw [sqLocal_add rTI γ D hDT, hj]
  have hL0 : localIdx (srL rS) (γ + D) = 0 := by
    apply localIdx_eq_zero_of_forall
    intro c
    rw [Pi.add_apply, eq_zero_of_localIdx_eq_zero _ γ hL c, hD, srTabAdd_L hbI rTI rS rCat hsc hdisj, add_zero]
  have hW0 : ∀ i, (γ + D) ((srW hbI rTI rS rCat hsc hdisj).sw i) = 0 := by
    intro i
    rw [Pi.add_apply, hD, sqTabAdd_sw]
    change γ (sqRX (srQ rS) i) + _ = 0
    rw [hW i]
    exact (by decide : ∀ t : ZMod 2, t + t = 0) _
  have key := h (γ + D) hL0 hW0
  rw [srFlip hbI k s rTI rS rCat hsc hdisj _ j hj0, ← hD, add_assoc,
    show D + D = 0 from funext fun w ↦ (by decide : ∀ t : ZMod 2, t + t = 0) (D w), add_zero] at key
  exact key

/-- The SELECT program (worker-defined; see the module docstring for the construction). -/
noncomputable def selectR {Var : Type} (v : Var) (beth : ℕ) {N L bI : ℕ} (hbI : 1 ≤ bI)
    (k : Fin L → Fin N → ℤ) (s : Fin L → Bool) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selRScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    DynamicCircuit Var n :=
  if hN : 0 < N then
    .seq (srLoad v beth hbI k s rTI rS rCat hsc hdisj)
      (.seq (sqMid v beth hbI rTI (srQ rS) rCat (srHsc hsc) (srHdisj hdisj) hN)
        (srUnload v beth hbI k s rTI rS rCat hsc hdisj))
  else .circuit .identity

set_option maxHeartbeats 800000 in
/-- `selectOpL` exactly, catalyst restored, scratch clean (the statement of `selectQ_catKet`). -/
theorem selectR_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    (hb : 2 ≤ beth) {N L bI : ℕ} [NeZero N] (hbI : 1 ≤ bI) (k : Fin L → Fin N → ℤ)
    (s : Fin L → Bool) (h2L : 2 * L ≤ 2 ^ bI) (rTI : QRegister (2 * N + bI) n)
    (rS : QRegister (selRScr N bI beth) n) (rCat : QRegister beth n)
    (hsc : rS.DisjointWires rCat) (hdisj : rTI.DisjointWires (rS.concat rCat hsc)) :
    ∃ U : Unitary (2 ^ (2 * N + bI)),
      U.1 = selectOpL N L bI beth k s h2L ∧
      CatKet rTI rS rCat hsc (selectR v beth hbI k s rTI rS rCat hsc hdisj).compile U := by
  have hN : 0 < N := Nat.pos_of_ne_zero (NeZero.ne N)
  refine ⟨⟨selectOpL N L bI beth k s h2L, selectOpL_mem N L bI beth k s h2L⟩, rfl, ?_⟩
  simp only [selectR, dif_pos hN, DynamicCircuit.compile_seq]
  obtain ⟨Rm, hRm, hkm⟩ := sqMid_cat v beth hb hbI hN rTI (srQ rS) rCat (srHsc hsc)
    (srHdisj hdisj)
  obtain ⟨R1, hR1, hk1⟩ := srLoad_kraus v beth hbI k s rTI rS rCat hsc hdisj
  obtain ⟨R3, hR3, hk3⟩ := srUnload_ket v beth hbI k s rTI rS rCat hsc hdisj
  refine ⟨_, hR1.qSeq (hRm.qSeq hR3), fun β hβ ↦ ?_⟩
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
  have hz := eq_zero_of_localIdx_eq_zero rS β (localIdx_concat_zero rS rCat hsc β hβ).1
  have hC0 := eq_zero_of_localIdx_eq_zero rCat β (localIdx_concat_zero rS rCat hsc β hβ).2
  have hX0 : ∀ q, β (sqRX (srQ rS) q) = 0 := fun q ↦ by rw [sqRX_apply, srQ_apply]; exact hz _
  have hL0 : ∀ c, β (srL rS c) = 0 := fun c ↦ by rw [srL_apply]; exact hz _
  have hR0 : ∀ c, β (sqRest (srQ rS) c) = 0 := fun c ↦ by
    rw [sqRest_apply, srQ_apply]; exact hz _
  obtain ⟨hTC, hTS⟩ := disjoint_cat rTI rS rCat hsc hdisj
  have hCT := QRegister.disjoint_comm.mp hTC
  have hLnC : ∀ c, srL rS c ∉ Set.range rCat.wires := fun c ⟨i, hi⟩ ↦
    QRegister.disjoint_iff.1 hsc _ i ((srL_apply rS c).symm.trans hi.symm)
  have hLnT : ∀ c, srL rS c ∉ Set.range rTI.wires := fun c ⟨i, hi⟩ ↦
    srRTI_ne hdisj i _ (hi.trans (srL_apply rS c))
  have hXnC : ∀ q, sqRX (srQ rS) q ∉ Set.range rCat.wires := fun q ⟨i, hi⟩ ↦
    QRegister.disjoint_iff.1 hsc _ i (((sqRX_apply _ q).trans (srQ_apply rS _)).symm.trans hi.symm)
  have hXnT : ∀ q, sqRX (srQ rS) q ∉ Set.range rTI.wires := fun q ⟨i, hi⟩ ↦
    srRTI_ne hdisj i _ (hi.trans ((sqRX_apply _ q).trans (srQ_apply rS _)))
  obtain ⟨x, hx⟩ : ∃ x, localIdx rTI β = x := ⟨_, rfl⟩
  obtain ⟨δ, hδdef⟩ : ∃ δ, δ = QC14.UnaryLookup.tabAdd (srW hbI rTI rS rCat hsc hdisj)
      (sqTab beth bI k s ⟨(bdHi x).val / 2, sqA_lt hbI (bdHi x)⟩) := ⟨_, rfl⟩
  have hδT : ∀ i, δ (rTI i) = 0 := fun i ↦ by
    rw [hδdef]; exact srTabAdd_T hbI rTI rS rCat hsc hdisj _ i
  have hδL : ∀ c, δ (srL rS c) = 0 := fun c ↦ by
    rw [hδdef]; exact srTabAdd_L hbI rTI rS rCat hsc hdisj _ c
  have hδC : ∀ i, δ (rCat i) = 0 := by
    intro i
    rw [hδdef]
    exact sqTabAdd_off _ _ _ fun q h ↦
      QRegister.disjoint_iff.1 hsc _ i (((sqRX_apply _ q).trans (srQ_apply rS _)).symm.trans h.symm)
  have hδR : ∀ c, δ (sqRest (srQ rS) c) = 0 := by
    intro c
    rw [hδdef]
    apply sqTabAdd_off
    intro q h
    have h' : sqRest (srQ rS) c = sqRX (srQ rS) q := h
    rw [sqRest_apply, sqRX_apply] at h'
    have h1 : N * beth + 2 + c.val = q.val := congrArg Fin.val (sqRS_inj (srQ rS) _ _ h')
    have := q.isLt
    omega
  have hδX : ∀ q, δ (sqRX (srQ rS) q) =
      sqTab beth bI k s ⟨(bdHi x).val / 2, sqA_lt hbI (bdHi x)⟩ q := by
    intro q
    rw [hδdef]
    exact sqTabAdd_sw _ _ q
  have hstep1 : R1 *ᵥ catalystKet rCat β = catalystKet rCat (β + δ) := by
    apply sqCatMap
    intro z
    have hj : bdHi (k := 2 * N) (j := bI) (localIdx rTI (writeReg β rCat (basisBits beth z))) =
        bdHi x := by
