    oneBodyHamiltonian g =
      ((g.trace : ℝ) : ℂ) • (1 : Matrix (Fin (2 ^ (2 * N))) (Fin (2 ^ (2 * N))) ℂ) +
        ∑ r : RowIdx N, ((coef g r : ℝ) : ℂ) • (selectPauliString (pRow N r)).1 := by
  rw [oneBodyHamiltonian_eq_pauli N g hs]
