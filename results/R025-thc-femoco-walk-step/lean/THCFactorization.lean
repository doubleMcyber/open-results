namespace QC14.AliasCircuit
open QuantumComputation QuantumComputation.Specs Matrix Finset Operator
open QuantumComputation.Specs.ArcsinImpl
open QC14 (blkA prepU aliasF aliasSlot aliasSub clean_ext localIdx_slice_zero localIdx_eq_zero_iff)
open QC14.PairProgram (toffW)

variable {n : ℕ}

/-! ### Gate-level ket lemmas -/

theorem inv_ket (c : Circuit n) (β β' : BitAssignment n)
    (h : c.eval.1 *ᵥ ket β = ket β') : c.inverse.eval.1 *ᵥ ket β' = ket β := by
  have hinv : c.inverse.eval.1 * c.eval.1 = 1 := by
    rw [Circuit.eval_inverse]
    exact congrArg Subtype.val (inv_mul_cancel c.eval)
  rw [← h, Matrix.mulVec_mulVec, hinv, Matrix.one_mulVec]

theorem AND4T_inv_ket' {k : ℕ} (c₁ c₂ t : Wire k) (h₁₂ : c₁ ≠ c₂) (h₁t : c₁ ≠ t)
    (h₂t : c₂ ≠ t) (β : BitAssignment k) (ht : β t = β c₁ * β c₂) :
    (AND4T c₁ c₂ t h₁₂ h₁t h₂t).inverse.eval.1 *ᵥ ket β = ket (Function.update β t 0) := by
  have h := ket_AND4T_eq_smul c₁ c₂ t h₁₂ h₁t h₂t (Function.update β t 0)
  rw [Function.update_of_ne h₁t, Function.update_of_ne h₂t, Function.update_self,
    Function.update_idem, zero_add, ← ht, Function.update_eq_self] at h
  have h1 : cleanAndPhase (β c₁) (β c₂) 0 = 1 := by simp [cleanAndPhase]
  rw [h1, one_smul] at h
  exact inv_ket _ _ _ h

/-- `t ^= c₁ c₂` with a clean work wire. -/
theorem toffW_ket {k : ℕ} (c₁ c₂ t w : Wire k) (h₁₂ : c₁ ≠ c₂) (h₁w : c₁ ≠ w) (h₂w : c₂ ≠ w)
    (htw : t ≠ w) (h₁t : c₁ ≠ t) (h₂t : c₂ ≠ t) (β : BitAssignment k) (hw : β w = 0) :
    (toffW c₁ c₂ t w h₁₂ h₁w h₂w htw).eval.1 *ᵥ ket β =
      ket (Function.update β t (β t + β c₁ * β c₂)) := by
  have s1 : (AND4T c₁ c₂ w h₁₂ h₁w h₂w).eval.1 *ᵥ ket β =
      ket (Function.update β w (β c₁ * β c₂)) := by
    rw [ket_AND4T_eq_smul, hw]; simp [cleanAndPhase]
  have s2 : (Circuit.CNOT w t htw.symm).eval.1 *ᵥ ket (Function.update β w (β c₁ * β c₂)) =
      ket (Function.update (Function.update β w (β c₁ * β c₂)) t (β t + β c₁ * β c₂)) := by
    rw [ket_CNOT]
    simp [Function.update_of_ne htw, Function.update_of_ne htw.symm]
  have s3 : (AND4T c₁ c₂ w h₁₂ h₁w h₂w).inverse.eval.1 *ᵥ
      ket (Function.update (Function.update β w (β c₁ * β c₂)) t (β t + β c₁ * β c₂)) =
      ket (Function.update (Function.update (Function.update β w (β c₁ * β c₂)) t
        (β t + β c₁ * β c₂)) w 0) := by
    apply AND4T_inv_ket'
    simp [Function.update_of_ne htw.symm, Function.update_of_ne h₁t, Function.update_of_ne h₂t,
      Function.update_of_ne h₁w, Function.update_of_ne h₂w]
  unfold toffW
  simp only [seq_mulVec]
  rw [s1, s2, s3]
  congr 1
  funext x
  by_cases hxw : x = w
  · subst hxw; simp [Function.update_apply, htw.symm, hw]
  · by_cases hxt : x = t
    · subst hxt; simp [Function.update_apply, hxw]
    · simp [Function.update_apply, hxw, hxt]

/-! ### Borrow arithmetic -/

/-- Majority of three bits. -/
def maj (a b c : ZMod 2) : ZMod 2 := a * b + a * c + b * c

/-- Borrow into position `i` of `ρ - κ` (little-endian bit functions). -/
def borW (ρ κ : ℕ → ZMod 2) : ℕ → ZMod 2
  | 0 => 0
  | i + 1 => maj (ρ i + 1) (κ i) (borW ρ κ i)

/-- Bit `i` of `x`. -/
def bitN (x i : ℕ) : ZMod 2 := ((x / 2 ^ i % 2 : ℕ) : ZMod 2)

theorem borW_bitN (x y : ℕ) : ∀ i, borW (bitN x) (bitN y) i =
    if x % 2 ^ i < y % 2 ^ i then 1 else 0
  | 0 => by simp [borW, Nat.mod_one]
  | i + 1 => by
    have ih := borW_bitN x y i
    have hp : 0 < 2 ^ i := Nat.two_pow_pos i
    have hx : x % 2 ^ (i + 1) = x % 2 ^ i + 2 ^ i * (x / 2 ^ i % 2) := Nat.mod_pow_succ
    have hy : y % 2 ^ (i + 1) = y % 2 ^ i + 2 ^ i * (y / 2 ^ i % 2) := Nat.mod_pow_succ
    have hxl : x % 2 ^ i < 2 ^ i := Nat.mod_lt _ hp
    have hyl : y % 2 ^ i < 2 ^ i := Nat.mod_lt _ hp
    show maj (bitN x i + 1) (bitN y i) (borW (bitN x) (bitN y) i) = _
    rw [ih, hx, hy]
    unfold bitN
    generalize x % 2 ^ i = xl at *
    generalize y % 2 ^ i = yl at *
    have ha := Nat.mod_two_eq_zero_or_one (x / 2 ^ i)
    have hb := Nat.mod_two_eq_zero_or_one (y / 2 ^ i)
    generalize x / 2 ^ i % 2 = a at *
    generalize y / 2 ^ i % 2 = b at *
    generalize 2 ^ i = p at *
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl <;>
      by_cases h1 : xl < yl <;> simp [maj, h1] <;> (try split_ifs) <;> first | omega | decide

/-! ### The borrow comparator -/

/-- One borrow step: `c' ^= maj(¬r, K, c)`; `r`, `K`, `c` are restored, `w` is clean scratch. -/
def borrowStep {k : ℕ} (r K c c' w : Wire k) (hrK : r ≠ K) (hrc : r ≠ c) (hrc' : r ≠ c')
    (hrw : r ≠ w) (hKc : K ≠ c) (hKc' : K ≠ c') (hKw : K ≠ w) (hcc' : c ≠ c') (hc'w : c' ≠ w) :
    Circuit k :=
  .seq (Circuit.X r) (.seq (Circuit.CNOT c r hrc.symm) (.seq (Circuit.CNOT c K hKc.symm)
    (.seq (toffW r K c' w hrK hrw hKw hc'w) (.seq (Circuit.CNOT c c' hcc')
      (.seq (Circuit.CNOT c K hKc.symm) (.seq (Circuit.CNOT c r hrc.symm) (Circuit.X r)))))))

theorem borrowStep_ket {k : ℕ} (r K c c' w : Wire k) (hrK : r ≠ K) (hrc : r ≠ c) (hrc' : r ≠ c')
    (hrw : r ≠ w) (hKc : K ≠ c) (hKc' : K ≠ c') (hKw : K ≠ w) (hcc' : c ≠ c') (hc'w : c' ≠ w)
    (β : BitAssignment k) (hw : β w = 0) :
    (borrowStep r K c c' w hrK hrc hrc' hrw hKc hKc' hKw hcc' hc'w).eval.1 *ᵥ ket β =
      ket (Function.update β c' (β c' + maj (β r + 1) (β K) (β c))) := by
  unfold borrowStep
  simp only [seq_mulVec, ket_X, ket_CNOT]
  rw [toffW_ket r K c' w hrK hrw hKw hc'w hrc' hKc' _ ?_]
  · simp only [ket_X, ket_CNOT]
    refine congrArg ket ?_
    funext x
    have d1 := hrK.symm; have d2 := hrc.symm; have d3 := hrc'.symm
    have d4 := hKc.symm; have d5 := hKc'.symm; have d6 := hcc'.symm
    by_cases e1 : x = c'
    · simp only [e1, Function.update_apply, hrK, hrc, hrc', hKc, hKc', hcc', d1, d2, d3, d4, d5, d6,
        if_true, if_false]
      rcases bit_cases (β r) with h1 | h1 <;> rcases bit_cases (β K) with h2 | h2 <;>
        rcases bit_cases (β c) with h3 | h3 <;> simp [h1, h2, h3, maj, one_add_one_zmod2, add_assoc]
    by_cases e2 : x = r
    · simp only [e2, Function.update_apply, hrK, hrc, hrc', hKc, hKc', hcc', d1, d2, d3, d4, d5, d6,
        if_true, if_false]
      rcases bit_cases (β r) with h1 | h1 <;> rcases bit_cases (β c) with h3 | h3 <;>
        simp [h1, h3, one_add_one_zmod2]
    by_cases e3 : x = K
    · simp only [e3, Function.update_apply, hrK, hrc, hrc', hKc, hKc', hcc', d1, d2, d3, d4, d5, d6,
        if_true, if_false]
      rcases bit_cases (β K) with h2 | h2 <;> rcases bit_cases (β c) with h3 | h3 <;>
        simp [h2, h3, one_add_one_zmod2]
    simp [Function.update_apply, e1, e2, e3]
  · simp [Function.update_apply, hrw.symm, hKw.symm, hw]

theorem toffW_count {k : ℕ} (c₁ c₂ t w : Wire k) (h₁₂ : c₁ ≠ c₂) (h₁w : c₁ ≠ w) (h₂w : c₂ ≠ w)
    (htw : t ≠ w) :
    (toffW c₁ c₂ t w h₁₂ h₁w h₂w htw).count PrimitiveGate.TOFF = 0 ∧
      (toffW c₁ c₂ t w h₁₂ h₁w h₂w htw).count PrimitiveGate.T = 8 := by
  have hT : (AND4T c₁ c₂ w h₁₂ h₁w h₂w).inverse.count PrimitiveGate.T = 4 := by
    rw [Circuit.count_inverse_of_ne _ (by simp) (by simp)]
    exact count_T_AND4T _ _ _ _ _ _
  have hO : (AND4T c₁ c₂ w h₁₂ h₁w h₂w).inverse.count PrimitiveGate.TOFF = 0 := by
    rw [Circuit.count_inverse_of_ne _ (by simp) (by simp)]
    exact count_TOFF_AND4T _ _ _ _ _ _
  constructor
  · simp [toffW, hO, count_TOFF_AND4T]
  · simp [toffW, hT, count_T_AND4T]

theorem borrowStep_count {k : ℕ} (r K c c' w : Wire k) (hrK : r ≠ K) (hrc : r ≠ c) (hrc' : r ≠ c')
    (hrw : r ≠ w) (hKc : K ≠ c) (hKc' : K ≠ c') (hKw : K ≠ w) (hcc' : c ≠ c') (hc'w : c' ≠ w) :
    (borrowStep r K c c' w hrK hrc hrc' hrw hKc hKc' hKw hcc' hc'w).count PrimitiveGate.TOFF = 0 ∧
      (borrowStep r K c c' w hrK hrc hrc' hrw hKc hKc' hKw hcc' hc'w).count PrimitiveGate.T = 8 := by
  have h := toffW_count r K c' w hrK hrw hKw hc'w
  constructor
  · simp [borrowStep, h.1]
  · simp [borrowStep, h.2]

/-- Wires of a borrow comparator: operand `r` (`rf`), operand `K` (`Kf`), carries `cf 0..k`,
the flag and one work wire. -/
structure CmpW (n k : ℕ) where
  rf : ℕ → Wire n
  Kf : ℕ → Wire n
  cf : ℕ → Wire n
  fl : Wire n
  wk : Wire n
  rK : ∀ i j, i < k → j < k → rf i ≠ Kf j
  rc : ∀ i j, i < k → j ≤ k → rf i ≠ cf j
  Kc : ∀ i j, i < k → j ≤ k → Kf i ≠ cf j
  cc : ∀ i j, i ≤ k → j ≤ k → i ≠ j → cf i ≠ cf j
  rwk : ∀ i, i < k → rf i ≠ wk
  Kwk : ∀ i, i < k → Kf i ≠ wk
  cwk : ∀ j, j ≤ k → cf j ≠ wk
  fr : ∀ i, i < k → fl ≠ rf i
  fK : ∀ i, i < k → fl ≠ Kf i
  fc : ∀ j, j ≤ k → fl ≠ cf j
  fw : fl ≠ wk

namespace CmpW
variable {k : ℕ} (W : CmpW n k)

def step (i : ℕ) (hi : i < k) : Circuit n :=
  borrowStep (W.rf i) (W.Kf i) (W.cf i) (W.cf (i + 1)) W.wk (W.rK i i hi hi)
    (W.rc i i hi (by omega)) (W.rc i (i + 1) hi (by omega)) (W.rwk i hi)
    (W.Kc i i hi (by omega)) (W.Kc i (i + 1) hi (by omega)) (W.Kwk i hi)
    (W.cc i (i + 1) (by omega) (by omega) (by omega)) (W.cwk (i + 1) (by omega))

/-- The first `j` borrow steps. -/
def chain : ℕ → Circuit n
  | 0 => .identity
  | j + 1 => .seq (chain j) (if h : j < k then W.step j h else .identity)

/-- Borrow chain, then the borrow into the flag, then the chain undone. -/
def cmp : Circuit n :=
  .seq (W.chain k) (.seq (Circuit.CNOT (W.cf k) W.fl (W.fc k le_rfl).symm) (W.chain k).inverse)

/-- Classical action of one step. -/
def stepFn (r K c c' : Wire n) (β : BitAssignment n) : BitAssignment n :=
  Function.update β c' (β c' + maj (β r + 1) (β K) (β c))

/-- Classical action of the first `j` steps. -/
def chainFn : ℕ → BitAssignment n → BitAssignment n
  | 0, β => β
  | j + 1, β =>
      if j < k then stepFn (W.rf j) (W.Kf j) (W.cf j) (W.cf (j + 1)) (chainFn j β)
      else chainFn j β

theorem chainFn_other (j : ℕ) (β : BitAssignment n) (w : Wire n) (hw : ∀ i, i ≤ k → w ≠ W.cf i) :
    W.chainFn j β w = β w := by
  induction j with
  | zero => rfl
  | succ j ih =>
    unfold chainFn
    split_ifs with h
    · unfold stepFn
      rw [Function.update_of_ne (hw (j + 1) (by omega)), ih]
    · exact ih

theorem chain_ket (j : ℕ) (β : BitAssignment n) (hw : β W.wk = 0) :
    (W.chain j).eval.1 *ᵥ ket β = ket (W.chainFn j β) := by
  induction j with
  | zero => simp only [chain, chainFn, Circuit.eval_identity, Submonoid.coe_one, Matrix.one_mulVec]
  | succ j ih =>
    unfold chain chainFn
    rw [seq_mulVec, ih]
    by_cases h : j < k
    · rw [dif_pos h, if_pos h]
      have hwk : W.chainFn j β W.wk = 0 := by
        rw [chainFn_other W j β W.wk (fun i hi ↦ (W.cwk i hi).symm), hw]
      unfold step
      rw [borrowStep_ket _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hwk]
      rfl
    · rw [dif_neg h, if_neg h]
      simp only [Circuit.eval_identity, Submonoid.coe_one, Matrix.one_mulVec]

theorem chainFn_val (β : BitAssignment n) (hz : ∀ j, j ≤ k → β (W.cf j) = 0) :
    ∀ j, j ≤ k → ∀ i, i ≤ k → W.chainFn j β (W.cf i) =
      if i ≤ j then borW (fun t ↦ β (W.rf t)) (fun t ↦ β (W.Kf t)) i else 0 := by
  intro j
  induction j with
  | zero =>
    intro _ i hi
    have : i = 0 ∨ 0 < i := by omega
    rcases this with rfl | hi0
    · simp [chainFn, hz 0 (by omega), borW]
    · simp [chainFn, hz i hi, show ¬ i ≤ 0 by omega]
  | succ j ih =>
    intro hj i hi
    have ihj := ih (by omega)
    unfold chainFn
    rw [if_pos (by omega : j < k)]
    unfold stepFn
    by_cases hi1 : i = j + 1
    · subst hi1
      rw [Function.update_self, ihj (j + 1) hi, if_neg (by omega : ¬ (j + 1 ≤ j)), zero_add,
        chainFn_other W j β _ (fun t ht ↦ W.rc j t (by omega) ht),
        chainFn_other W j β _ (fun t ht ↦ W.Kc j t (by omega) ht), ihj j (by omega),
        if_pos le_rfl, if_pos le_rfl]
      rfl
    · rw [Function.update_of_ne (W.cc i (j + 1) hi (by omega) hi1), ihj i hi]
      by_cases h : i ≤ j
      · rw [if_pos h, if_pos (by omega)]
      · rw [if_neg h, if_neg (by omega)]

theorem chainFn_update (j : ℕ) (β : BitAssignment n) (x : ZMod 2) :
    W.chainFn j (Function.update β W.fl x) = Function.update (W.chainFn j β) W.fl x := by
  induction j with
  | zero => rfl
  | succ j ih =>
    unfold chainFn
    split_ifs with h
    · rw [ih]
      unfold stepFn
      funext w
      by_cases hw1 : w = W.fl
      · subst hw1
        simp [Function.update_of_ne (W.fc (j + 1) (by omega))]
      · by_cases hw2 : w = W.cf (j + 1)
        · subst hw2
          simp [Function.update_apply, (W.fc (j + 1) (by omega)).symm, (W.fr j h).symm,
            (W.fK j h).symm, (W.fc j (by omega)).symm]
        · simp [Function.update_apply, hw1, hw2, (W.fc (j + 1) (by omega)).symm, (W.fr j h).symm,
            (W.fK j h).symm, (W.fc j (by omega)).symm]
    · exact ih

theorem cmp_ket (β : BitAssignment n) (hw : β W.wk = 0) (hz : ∀ j, j ≤ k → β (W.cf j) = 0) :
    W.cmp.eval.1 *ᵥ ket β = ket (Function.update β W.fl
      (β W.fl + borW (fun t ↦ β (W.rf t)) (fun t ↦ β (W.Kf t)) k)) := by
  have hc1 := W.chain_ket k β hw
  have hcf : W.chainFn k β (W.cf k) = borW (fun t ↦ β (W.rf t)) (fun t ↦ β (W.Kf t)) k := by
    rw [W.chainFn_val β hz k le_rfl k le_rfl, if_pos le_rfl]
  have hfl : W.chainFn k β W.fl = β W.fl :=
    W.chainFn_other k β W.fl (fun i hi ↦ W.fc i hi)
  have hw2 : (Function.update β W.fl (β W.fl +
      borW (fun t ↦ β (W.rf t)) (fun t ↦ β (W.Kf t)) k)) W.wk = 0 := by
    rw [Function.update_of_ne W.fw.symm, hw]
  have hc2 := W.chain_ket k _ hw2
  rw [chainFn_update] at hc2
  have hinv := inv_ket _ _ _ hc2
  unfold cmp
  rw [seq_mulVec, hc1, seq_mulVec, ket_CNOT, hfl, hcf]
  exact hinv

end CmpW

theorem upd_add (β : BitAssignment n) (t : Wire n) (v : ZMod 2) :
    Function.update β t (β t + v) = β + Pi.single t v := by
  funext w
  by_cases h : w = t
  · subst h; simp
  · simp [Function.update_apply, h, Pi.single_apply]

/-! ### Counts of the comparator -/

theorem CmpW.chain_count {k : ℕ} (W : CmpW n k) (j : ℕ) :
    (W.chain j).count PrimitiveGate.TOFF = 0 ∧ (W.chain j).count PrimitiveGate.T ≤ 8 * j := by
  induction j with
  | zero => simp [CmpW.chain]
  | succ j ih =>
    unfold CmpW.chain
    by_cases h : j < k
    · rw [dif_pos h]
      have hs := borrowStep_count (W.rf j) (W.Kf j) (W.cf j) (W.cf (j + 1)) W.wk (W.rK j j h h)
        (W.rc j j h (by omega)) (W.rc j (j + 1) h (by omega)) (W.rwk j h)
        (W.Kc j j h (by omega)) (W.Kc j (j + 1) h (by omega)) (W.Kwk j h)
        (W.cc j (j + 1) (by omega) (by omega) (by omega)) (W.cwk (j + 1) (by omega))
      simp only [Circuit.count_seq, CmpW.step]
      omega
    · rw [dif_neg h]
      simp only [Circuit.count_seq]
      simp
      omega

theorem CmpW.cmp_count {k : ℕ} (W : CmpW n k) :
    W.cmp.count PrimitiveGate.TOFF = 0 ∧ W.cmp.count PrimitiveGate.T ≤ 16 * k := by
  have h := W.chain_count k
  have hi : (W.chain k).inverse.count PrimitiveGate.TOFF = 0 ∧
      (W.chain k).inverse.count PrimitiveGate.T = (W.chain k).count PrimitiveGate.T := by
    constructor
    · rw [Circuit.count_inverse_of_ne _ (by simp) (by simp)]; exact h.1
    · rw [Circuit.count_inverse_of_ne _ (by simp) (by simp)]
  unfold CmpW.cmp
  simp only [Circuit.count_seq]
  simp
  omega

/-! ### Lookup by an X-string table -/

open QuantumComputation.Specs.SelectPauliImpl (Wires pf pc bitsZ)
open QuantumComputation.Specs.PrepareImpl (pauliOfBit)

def xrow {N : ℕ} (a : Fin N → ZMod 2) : Fin N → SelectPauli.Pauli := fun q ↦ pauliOfBit (a q)

theorem pf_xrow {N : ℕ} (a : Fin N → ZMod 2) (q : Fin N) : pf (xrow a q) = a q := by
  unfold xrow pauliOfBit
  rcases bit_cases (a q) with h | h <;> simp [h, pf]

theorem pc_xrow {N : ℕ} (a : Fin N → ZMod 2) (q : Fin N) (y : ZMod 2) : pc (xrow a q) y = 1 := by
  unfold xrow pauliOfBit
  split_ifs <;> simp [pc]

theorem lookup_ket {s N' : ℕ} (W : Wires s N' n) (tab : Fin (2 ^ s) → Fin N' → ZMod 2)
    (x : Fin (2 ^ s)) (β : BitAssignment n) (hc : ∀ k, β (W.aw k) = 0)
    (hx : ∀ i, β (W.xw i) = bitsZ s x.val i) :
    (W.full (fun j ↦ (false, xrow (tab j)))).eval.1 *ᵥ ket β =
      ket (β + W.sysAdd (xrow (tab x))) := by
  have h := W.termList_some (le_refl _) (fun j ↦ (false, xrow (tab j))) (List.finRange (2 ^ s))
    (List.nodup_finRange _) x (List.mem_finRange _) β hc hx
  have hp : (List.map (fun q ↦ pc (xrow (tab x) q) (β (W.sw q))) (List.finRange N')).prod = 1 := by
    apply List.prod_eq_one
    intro y hy
    obtain ⟨q, _, rfl⟩ := List.mem_map.1 hy
    exact pc_xrow _ _ _
  refine Eq.trans h ?_
  dsimp only
  rw [hp]
  simp

theorem tabAdd_eq_sysAdd {s N' : ℕ} (W : Wires s N' n) (a : Fin N' → ZMod 2) :
    QC14.UnaryLookup.tabAdd W a = W.sysAdd (xrow a) := by
  unfold QC14.UnaryLookup.tabAdd QuantumComputation.Specs.SelectPauliImpl.Wires.sysAdd
  simp only [pf_xrow]

/-- The unary-iteration lookup (`THC/UnaryLookup.lean`) in the form of `lookup_ket`. -/
theorem ulookup_sys_ket {s N' : ℕ} (W : Wires s N' n) (tab : Fin (2 ^ s) → Fin N' → ZMod 2)
    (x : Fin (2 ^ s)) (β : BitAssignment n) (hc : ∀ k, β (W.aw k) = 0)
    (hx : ∀ i, β (W.xw i) = bitsZ s x.val i) :
    (QC14.UnaryLookup.ulookup W tab).eval.1 *ᵥ ket β = ket (β + W.sysAdd (xrow (tab x))) := by
  rw [QC14.UnaryLookup.ulookup_ket W tab x β hc hx, tabAdd_eq_sysAdd]

theorem lookup_sysAdd_sw {s N' : ℕ} (W : Wires s N' n) (a : Fin N' → ZMod 2) (q : Fin N') :
    W.sysAdd (xrow a) (W.sw q) = a q := by
  rw [W.sysAdd_sw, pf_xrow]

theorem lookup_count {s N' : ℕ} (W : Wires s N' n) (tab : Fin (2 ^ s) → Fin N' → ZMod 2) :
    (W.full (fun j ↦ (false, xrow (tab j)))).count PrimitiveGate.TOFF = 0 ∧
      (W.full (fun j ↦ (false, xrow (tab j)))).count PrimitiveGate.T ≤ 8 * s * 2 ^ s := by
  have h := W.count_full (fun j ↦ (false, xrow (tab j)))
  exact ⟨h.2, h.1⟩

/-! ### The Toffoli layer `index ⊕= flag · D` -/

structure TofW (n b : ℕ) where
  fl : Wire n
  Dw : ℕ → Wire n
  iw : ℕ → Wire n
  wk : Wire n
  fD : ∀ i, i < b → fl ≠ Dw i
  fi : ∀ i, i < b → fl ≠ iw i
  fw : fl ≠ wk
  Dwk : ∀ i, i < b → Dw i ≠ wk
  iwk : ∀ i, i < b → iw i ≠ wk
  Di : ∀ i j, i < b → j < b → Dw i ≠ iw j
  ii : ∀ i j, i < b → j < b → i ≠ j → iw i ≠ iw j

namespace TofW
variable {b : ℕ} (W : TofW n b)

def step (i : ℕ) (hi : i < b) : Circuit n :=
  toffW W.fl (W.Dw i) (W.iw i) W.wk (W.fD i hi) W.fw (W.Dwk i hi) (W.iwk i hi)

def chain : ℕ → Circuit n
  | 0 => .identity
  | j + 1 => .seq (chain j) (if h : j < b then W.step j h else .identity)

def fn : ℕ → BitAssignment n → BitAssignment n
  | 0, β => β
  | j + 1, β =>
      if j < b then Function.update (fn j β) (W.iw j) (fn j β (W.iw j) + fn j β W.fl * fn j β (W.Dw j))
      else fn j β

theorem fn_other (j : ℕ) (β : BitAssignment n) (w : Wire n) (hw : ∀ i, i < j → i < b → w ≠ W.iw i) :
    W.fn j β w = β w := by
  induction j with
  | zero => rfl
  | succ j ih =>
    unfold fn
    split_ifs with h
    · rw [Function.update_of_ne (hw j (by omega) h), ih (fun i hi hib ↦ hw i (by omega) hib)]
    · exact ih (fun i hi hib ↦ hw i (by omega) hib)

theorem fn_eq (j : ℕ) (β : BitAssignment n) :
    W.fn j β = β + ∑ i ∈ Finset.range j,
      if i < b then Pi.single (W.iw i) (β W.fl * β (W.Dw i)) else 0 := by
  induction j with
  | zero => simp [fn]
  | succ j ih =>
    unfold fn
    rw [Finset.sum_range_succ]
    by_cases h : j < b
    · rw [if_pos h, if_pos h,
        W.fn_other j β W.fl (fun t ht htb ↦ W.fi t htb),
        W.fn_other j β (W.Dw j) (fun t ht htb ↦ W.Di j t h htb)]
      rw [upd_add, ih, add_assoc]
    · rw [if_neg h, if_neg h, ih]
      simp [add_assoc]

theorem chain_ket (j : ℕ) (β : BitAssignment n) (hw : β W.wk = 0) :
    (W.chain j).eval.1 *ᵥ ket β = ket (W.fn j β) := by
  induction j with
  | zero =>
    simp only [chain, fn, Circuit.eval_identity, Submonoid.coe_one, Matrix.one_mulVec]
  | succ j ih =>
    unfold chain fn
    rw [seq_mulVec, ih]
    by_cases h : j < b
    · rw [dif_pos h, if_pos h]
      have hwk : W.fn j β W.wk = 0 := by
        rw [W.fn_other j β W.wk (fun i hi hib ↦ (W.iwk i hib).symm), hw]
      unfold step
      rw [toffW_ket _ _ _ _ _ _ _ _ (W.fi j h) (W.Di j j h h) _ hwk]
    · rw [dif_neg h, if_neg h]
      simp only [Circuit.eval_identity, Submonoid.coe_one, Matrix.one_mulVec]

theorem chain_count (j : ℕ) :
    (W.chain j).count PrimitiveGate.TOFF = 0 ∧ (W.chain j).count PrimitiveGate.T ≤ 8 * j := by
  induction j with
  | zero => simp [chain]
  | succ j ih =>
    unfold chain
    by_cases h : j < b
    · rw [dif_pos h]
      have hs := toffW_count W.fl (W.Dw j) (W.iw j) W.wk (W.fD j h) W.fw (W.Dwk j h) (W.iwk j h)
      simp only [Circuit.count_seq, step]
      omega
    · rw [dif_neg h]
      simp only [Circuit.count_seq]
      simp
      omega

end TofW

theorem borW_cong (ρ ρ' κ κ' : ℕ → ZMod 2) (i : ℕ) (h1 : ∀ t, t < i → ρ t = ρ' t)
    (h2 : ∀ t, t < i → κ t = κ' t) : borW ρ κ i = borW ρ' κ' i := by
  induction i with
  | zero => rfl
  | succ i ih =>
    simp only [borW]
    rw [h1 i (by omega), h2 i (by omega),
      ih (fun t ht ↦ h1 t (by omega)) (fun t ht ↦ h2 t (by omega))]

theorem bit_slot (σ s i : ℕ) (hi : i < s) : (σ % 2 ^ s) / 2 ^ i % 2 = σ / 2 ^ i % 2 := by
  have h : 2 ^ s = 2 ^ i * 2 ^ (s - i) := by rw [← pow_add]; congr 1; omega
  rw [h, Nat.mod_mul_right_div_self]
  have h2 : 2 ∣ 2 ^ (s - i) := dvd_pow_self 2 (by omega)
  exact Nat.mod_mod_of_dvd _ h2

theorem bit_sub (σ s t : ℕ) : σ / 2 ^ s / 2 ^ t % 2 = σ / 2 ^ (s + t) % 2 := by
  rw [Nat.div_div_eq_div_mul, ← pow_add]

theorem flag_val (r y k : ℕ) (hr : r < 2 ^ k) (hy : y < 2 ^ k) :
    borW (bitN r) (bitN y) k = if r < y then 1 else 0 := by
  rw [borW_bitN, Nat.mod_eq_of_lt hr, Nat.mod_eq_of_lt hy]

/-! ### Layout of the joint register

Positions `p < tot` index the data wires (`p < N + b + g`) and then the scratch wires.
`pos` maps a position to a wire and is injective on `[0, tot)`. -/

namespace Lay

def pIdx (N i : ℕ) : ℕ := N + i
def pSl (N b i : ℕ) : ℕ := N + b + i
def pSb (N b s i : ℕ) : ℕ := N + b + s + i
def pCh (N b g i : ℕ) : ℕ := N + b + g + i
def pD (N b g s i : ℕ) : ℕ := N + b + g + s + 1 + i
def pK (N b g s i : ℕ) : ℕ := N + b + g + s + 1 + b + i
def pC (N b g s j : ℕ) : ℕ := N + b + g + s + 1 + b + (g - s) + j
def pFl (N b g s : ℕ) : ℕ := N + b + g + s + 1 + b + (g - s) + (g - s) + 1
def pWk (N b g s : ℕ) : ℕ := N + b + g + s + 1 + b + (g - s) + (g - s) + 2
def tot (N b g : ℕ) : ℕ := N + (b + g) + (b + 2 * g + 4)

/-- Targets of the first lookup: index, `D`, `K`. -/
def t1 (N b g s q : ℕ) : ℕ :=
  if q < b then pIdx N q else if q < b + b then pD N b g s (q - b) else pK N b g s (q - (b + b))

/-- Targets of the second lookup: `D`, `K`. -/
def t2 (N b g s q : ℕ) : ℕ := if q < b then pD N b g s q else pK N b g s (q - b)

macro "lom" : tactic =>
  `(tactic| ((try simp only [pIdx, pSl, pSb, pCh, pD, pK, pC, pFl, pWk, tot] at *); omega))

macro "nt1" : tactic => `(tactic| (intro q hq; unfold t1; split_ifs <;> lom))
macro "nt2" : tactic => `(tactic| (intro q hq; unfold t2; split_ifs <;> lom))

variable {N b g s : ℕ}

theorem t1_lt (hs : s ≤ g) {q : ℕ} (hq : q < b + (b + (g - s))) : t1 N b g s q < tot N b g := by
  unfold t1; split_ifs <;> lom

theorem t1_inj (hs : s ≤ g) {q q' : ℕ} (hq : q < b + (b + (g - s))) (hq' : q' < b + (b + (g - s)))
    (h : t1 N b g s q = t1 N b g s q') : q = q' := by
  unfold t1 at h; split_ifs at h <;> lom

theorem t2_lt (hs : s ≤ g) {q : ℕ} (hq : q < b + (g - s)) : t2 N b g s q < tot N b g := by
  unfold t2; split_ifs <;> lom

theorem t2_inj (hs : s ≤ g) {q q' : ℕ} (hq : q < b + (g - s)) (hq' : q' < b + (g - s))
    (h : t2 N b g s q = t2 N b g s q') : q = q' := by
  unfold t2 at h; split_ifs at h <;> lom

variable (hs : s ≤ g) (pos : ℕ → Wire n)
  (hinj : ∀ p q, p < tot N b g → q < tot N b g → pos p = pos q → p = q)
include hs hinj

def W1 : Wires s (b + (b + (g - s))) n where
  sw q := pos (t1 N b g s q.val)
  xw i := pos (pSl N b i.val)
  aw i := pos (pCh N b g i.val)
  sw_inj := fun a c h ↦ Fin.ext (t1_inj hs a.2 c.2 (hinj _ _ (t1_lt hs a.2) (t1_lt hs c.2) h))
  xw_inj := fun a c h ↦ Fin.ext (by
    have := hinj _ _ (by have := a.2; lom) (by have := c.2; lom) h
    lom)
  aw_inj := fun a c h ↦ Fin.ext (by
    have := hinj _ _ (by have := a.2; lom) (by have := c.2; lom) h
    lom)
  sx := fun q i h ↦ by
    have := hinj _ _ (t1_lt hs q.2) (by have := i.2; lom) h
    have := i.2; have := q.2
    unfold t1 at *; split_ifs at * <;> lom
  sa := fun q k h ↦ by
    have := hinj _ _ (t1_lt hs q.2) (by have := k.2; lom) h
    have := k.2; have := q.2
    unfold t1 at *; split_ifs at * <;> lom
  xa := fun i k h ↦ by
    have := hinj _ _ (by have := i.2; lom) (by have := k.2; lom) h
    have := i.2; have := k.2
    lom

def W2 : Wires s (b + (g - s)) n where
  sw q := pos (t2 N b g s q.val)
  xw i := pos (pSl N b i.val)
  aw i := pos (pCh N b g i.val)
  sw_inj := fun a c h ↦ Fin.ext (t2_inj hs a.2 c.2 (hinj _ _ (t2_lt hs a.2) (t2_lt hs c.2) h))
  xw_inj := fun a c h ↦ Fin.ext (by
    have := hinj _ _ (by have := a.2; lom) (by have := c.2; lom) h
    lom)
  aw_inj := fun a c h ↦ Fin.ext (by
    have := hinj _ _ (by have := a.2; lom) (by have := c.2; lom) h
    lom)
  sx := fun q i h ↦ by
    have := hinj _ _ (t2_lt hs q.2) (by have := i.2; lom) h
    have := i.2; have := q.2
    unfold t2 at *; split_ifs at * <;> lom
  sa := fun q k h ↦ by
    have := hinj _ _ (t2_lt hs q.2) (by have := k.2; lom) h
    have := k.2; have := q.2
    unfold t2 at *; split_ifs at * <;> lom
  xa := fun i k h ↦ by
    have := hinj _ _ (by have := i.2; lom) (by have := k.2; lom) h
    have := i.2; have := k.2
    lom

def cmpW : CmpW n (g - s) where
  rf i := pos (pSb N b s i)
  Kf i := pos (pK N b g s i)
  cf j := pos (pC N b g s j)
  fl := pos (pFl N b g s)
  wk := pos (pWk N b g s)
  rK := fun i j hi hj h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  rc := fun i j hi hj h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  Kc := fun i j hi hj h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  cc := fun i j hi hj hij h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  rwk := fun i hi h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  Kwk := fun i hi h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  cwk := fun j hj h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  fr := fun i hi h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  fK := fun i hi h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  fc := fun j hj h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  fw := fun h ↦ by have := hinj _ _ (by lom) (by lom) h; lom

def tofW : TofW n b where
  fl := pos (pFl N b g s)
  Dw i := pos (pD N b g s i)
  iw i := pos (pIdx N i)
  wk := pos (pWk N b g s)
  fD := fun i hi h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  fi := fun i hi h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  fw := fun h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  Dwk := fun i hi h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  iwk := fun i hi h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  Di := fun i j hi hj h ↦ by have := hinj _ _ (by lom) (by lom) h; lom
  ii := fun i j hi hj hij h ↦ by have := hinj _ _ (by lom) (by lom) h; lom


section core
variable (ind alt : Fin (2 ^ s) → Fin (2 ^ b)) (K : Fin (2 ^ s) → ℕ)

def abit (x : Fin (2 ^ s)) (i : ℕ) : ZMod 2 := bitN (alt x).val i
def dbit (x : Fin (2 ^ s)) (i : ℕ) : ZMod 2 := bitN (ind x).val i + bitN (alt x).val i
def kbit (x : Fin (2 ^ s)) (i : ℕ) : ZMod 2 := bitN (K x) i

def tab1 (x : Fin (2 ^ s)) (q : ℕ) : ZMod 2 :=
  if q < b then abit alt x q else if q < b + b then dbit ind alt x (q - b)
  else kbit K x (q - (b + b))

def tab2 (x : Fin (2 ^ s)) (q : ℕ) : ZMod 2 :=
  if q < b then dbit ind alt x q else kbit K x (q - b)

def tt1 (x : Fin (2 ^ s)) (q : Fin (b + (b + (g - s)))) : ZMod 2 := tab1 ind alt K x q.val
def tt2 (x : Fin (2 ^ s)) (q : Fin (b + (g - s))) : ZMod 2 := tab2 ind alt K x q.val

/-- Steps 2 to 6 of the header. -/
def core : Circuit n :=
  .seq (QC14.UnaryLookup.ulookup (W1 hs pos hinj) (tt1 (g := g) ind alt K))
    (.seq (cmpW hs pos hinj).cmp
      (.seq ((tofW hs pos hinj).chain b)
        (.seq (cmpW hs pos hinj).cmp
          (QC14.UnaryLookup.ulookup (W2 hs pos hinj) (tt2 (g := g) ind alt K)))))

theorem single_ne {p a : ℕ} (hp : p < tot N b g) (ha : a < tot N b g) (hne : p ≠ a)
    (v : ZMod 2) : (Pi.single (pos a) v : BitAssignment n) (pos p) = 0 := by
  rw [Pi.single_apply, if_neg]
  intro h; exact hne (hinj _ _ hp ha h)

theorem Stof_zero (c : ℕ → ZMod 2) {p : ℕ} (hp : p < tot N b g) (hnot : ¬ (N ≤ p ∧ p < N + b)) :
    (∑ i ∈ Finset.range b, (Pi.single (pos (pIdx N i)) (c i) : BitAssignment n)) (pos p) = 0 := by
  rw [Finset.sum_apply]
  apply Finset.sum_eq_zero
  intro i hi
  rw [Finset.mem_range] at hi
  exact single_ne hs pos hinj hp (by lom) (by unfold pIdx; omega) _

theorem S1_idx (x : Fin (2 ^ s)) {i : ℕ} (hi : i < b) :
    (W1 hs pos hinj).sysAdd (xrow (tt1 (g := g) ind alt K x)) (pos (pIdx N i)) = abit alt x i := by
  have h := lookup_sysAdd_sw (W1 hs pos hinj) (tt1 (g := g) ind alt K x) ⟨i, by omega⟩
  have e : (W1 hs pos hinj).sw ⟨i, by omega⟩ = pos (pIdx N i) := by
    show pos (t1 N b g s i) = _
    rw [t1, if_pos hi]
  rw [e] at h
  rw [h]
  simp [tt1, tab1, hi]

theorem S1_D (x : Fin (2 ^ s)) {i : ℕ} (hi : i < b) :
    (W1 hs pos hinj).sysAdd (xrow (tt1 (g := g) ind alt K x)) (pos (pD N b g s i)) =
      dbit ind alt x i := by
  have h := lookup_sysAdd_sw (W1 hs pos hinj) (tt1 (g := g) ind alt K x) ⟨b + i, by omega⟩
  have e : (W1 hs pos hinj).sw ⟨b + i, by omega⟩ = pos (pD N b g s i) := by
    show pos (t1 N b g s (b + i)) = _
    rw [t1, if_neg (by omega), if_pos (by omega), Nat.add_sub_cancel_left]
  rw [e] at h
  rw [h]
  simp [tt1, tab1, show ¬ (b + i < b) by omega, show b + i < b + b by omega]

theorem S1_K (x : Fin (2 ^ s)) {i : ℕ} (hi : i < g - s) :
    (W1 hs pos hinj).sysAdd (xrow (tt1 (g := g) ind alt K x)) (pos (pK N b g s i)) =
      kbit K x i := by
  have h := lookup_sysAdd_sw (W1 hs pos hinj) (tt1 (g := g) ind alt K x) ⟨b + b + i, by omega⟩
  have e : (W1 hs pos hinj).sw ⟨b + b + i, by omega⟩ = pos (pK N b g s i) := by
    show pos (t1 N b g s (b + b + i)) = _
    rw [t1, if_neg (by omega), if_neg (by omega), Nat.add_sub_cancel_left]
  rw [e] at h
  rw [h]
  simp [tt1, tab1, show ¬ (b + b + i < b) by omega, show ¬ (b + b + i < b + b) by omega]

theorem S1_zero (x : Fin (2 ^ s)) {p : ℕ} (hp : p < tot N b g)
    (hnt : ∀ q, q < b + (b + (g - s)) → p ≠ t1 N b g s q) :
    (W1 hs pos hinj).sysAdd (xrow (tt1 (g := g) ind alt K x)) (pos p) = 0 := by
  apply (W1 hs pos hinj).sysAdd_other
  intro q hq
  exact hnt q.val q.2 (hinj _ _ hp (t1_lt hs q.2) hq)

theorem S2_D (x : Fin (2 ^ s)) {i : ℕ} (hi : i < b) :
    (W2 hs pos hinj).sysAdd (xrow (tt2 (g := g) ind alt K x)) (pos (pD N b g s i)) =
      dbit ind alt x i := by
  have h := lookup_sysAdd_sw (W2 hs pos hinj) (tt2 (g := g) ind alt K x) ⟨i, by omega⟩
  have e : (W2 hs pos hinj).sw ⟨i, by omega⟩ = pos (pD N b g s i) := by
    show pos (t2 N b g s i) = _
    rw [t2, if_pos hi]
  rw [e] at h
  rw [h]
  simp [tt2, tab2, hi]

theorem S2_K (x : Fin (2 ^ s)) {i : ℕ} (hi : i < g - s) :
    (W2 hs pos hinj).sysAdd (xrow (tt2 (g := g) ind alt K x)) (pos (pK N b g s i)) =
      kbit K x i := by
  have h := lookup_sysAdd_sw (W2 hs pos hinj) (tt2 (g := g) ind alt K x) ⟨b + i, by omega⟩
  have e : (W2 hs pos hinj).sw ⟨b + i, by omega⟩ = pos (pK N b g s i) := by
    show pos (t2 N b g s (b + i)) = _
    rw [t2, if_neg (by omega), Nat.add_sub_cancel_left]
  rw [e] at h
  rw [h]
  simp [tt2, tab2, show ¬ (b + i < b) by omega]

theorem S2_zero (x : Fin (2 ^ s)) {p : ℕ} (hp : p < tot N b g)
    (hnt : ∀ q, q < b + (g - s) → p ≠ t2 N b g s q) :
    (W2 hs pos hinj).sysAdd (xrow (tt2 (g := g) ind alt K x)) (pos p) = 0 := by
  apply (W2 hs pos hinj).sysAdd_other
  intro q hq
  exact hnt q.val q.2 (hinj _ _ hp (t2_lt hs q.2) hq)

theorem S1_eq (x : Fin (2 ^ s)) :
    (W1 hs pos hinj).sysAdd (xrow (tt1 (g := g) ind alt K x)) =
      (∑ i ∈ Finset.range b, (Pi.single (pos (pIdx N i)) (abit alt x i) : BitAssignment n)) +
      (W2 hs pos hinj).sysAdd (xrow (tt2 (g := g) ind alt K x)) := by
  unfold QuantumComputation.Specs.SelectPauliImpl.Wires.sysAdd
  simp only [pf_xrow]
  have e1 : ∑ q : Fin (b + (b + (g - s))), (Pi.single ((W1 hs pos hinj).sw q)
      (tt1 (g := g) ind alt K x q) : BitAssignment n) =
      ∑ q ∈ Finset.range (b + (b + (g - s))),
        (Pi.single (pos (t1 N b g s q)) (tab1 ind alt K x q) : BitAssignment n) :=
    Fin.sum_univ_eq_sum_range (fun q ↦ (Pi.single (pos (t1 N b g s q)) (tab1 ind alt K x q) :
      BitAssignment n)) _
  have e2 : ∑ q : Fin (b + (g - s)), (Pi.single ((W2 hs pos hinj).sw q)
      (tt2 (g := g) ind alt K x q) : BitAssignment n) =
      ∑ q ∈ Finset.range (b + (g - s)),
        (Pi.single (pos (t2 N b g s q)) (tab2 ind alt K x q) : BitAssignment n) :=
    Fin.sum_univ_eq_sum_range (fun q ↦ (Pi.single (pos (t2 N b g s q)) (tab2 ind alt K x q) :
      BitAssignment n)) _
  rw [e1, e2, Finset.sum_range_add]
  congr 1
  · apply Finset.sum_congr rfl
    intro i hi
    rw [Finset.mem_range] at hi
    simp [t1, tab1, hi]
  · apply Finset.sum_congr rfl
    intro i hi
    rw [Finset.mem_range] at hi
    have h1 : t1 N b g s (b + i) = t2 N b g s i := by
      unfold t1 t2
      by_cases h : i < b
      · rw [if_neg (by omega), if_pos (by omega), if_pos h, Nat.add_sub_cancel_left]
      · rw [if_neg (by omega), if_neg (by omega), if_neg h]
        congr 1; omega
    have h2 : tab1 ind alt K x (b + i) = tab2 ind alt K x i := by
      unfold tab1 tab2
      by_cases h : i < b
      · rw [if_neg (by omega), if_pos (by omega), if_pos h, Nat.add_sub_cancel_left]
      · rw [if_neg (by omega), if_neg (by omega), if_neg h]
        congr 1; omega
    rw [h1, h2]


theorem core_ket (hK : ∀ x, K x < 2 ^ (g - s)) (β : BitAssignment n) (σ : Fin (2 ^ g))
    (hc : ∀ p, N + (b + g) ≤ p → p < tot N b g → β (pos p) = 0)
    (hg : ∀ i, i < g → β (pos (pSl N b i)) = bitN σ.val i) :
    (core hs pos hinj ind alt K).eval.1 *ᵥ ket β =
      ket (β + ∑ q : Fin b, (Pi.single (pos (pIdx N q.val))
        (bitN (aliasF ind alt K σ).val q.val) : BitAssignment n)) := by
  classical
  obtain ⟨x, hx⟩ : ∃ x : Fin (2 ^ s), x = aliasSlot (g := g) σ := ⟨_, rfl⟩
  obtain ⟨r, hr⟩ : ∃ r : ℕ, r = σ.val / 2 ^ s := ⟨_, rfl⟩
  have hxv : x.val = σ.val % 2 ^ s := by rw [hx]; rfl
  have hrlt : r < 2 ^ (g - s) := by
    rw [hr, Nat.div_lt_iff_lt_mul (Nat.two_pow_pos _), ← pow_add, Nat.sub_add_cancel hs]
    exact σ.2
  obtain ⟨fv, hfv⟩ : ∃ fv : ZMod 2, fv = if r < K x then 1 else 0 := ⟨_, rfl⟩
  obtain ⟨S1, hS1⟩ : ∃ S1 : BitAssignment n,
      S1 = (W1 hs pos hinj).sysAdd (xrow (tt1 (g := g) ind alt K x)) := ⟨_, rfl⟩
  obtain ⟨S2, hS2⟩ : ∃ S2 : BitAssignment n,
      S2 = (W2 hs pos hinj).sysAdd (xrow (tt2 (g := g) ind alt K x)) := ⟨_, rfl⟩
  obtain ⟨P, hP⟩ : ∃ P : BitAssignment n, P = Pi.single (pos (pFl N b g s)) fv := ⟨_, rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : BitAssignment n, T = ∑ i ∈ Finset.range b,
      (Pi.single (pos (pIdx N i)) (fv * dbit ind alt x i) : BitAssignment n) := ⟨_, rfl⟩
  have hS1z : ∀ p, p < tot N b g →
      (p < N ∨ (N + b ≤ p ∧ p < pD N b g s 0) ∨ pC N b g s 0 ≤ p) → S1 (pos p) = 0 := by
    intro p hp ho
    rw [hS1]
    exact S1_zero hs pos hinj ind alt K x hp (by nt1)
  have hS2z : ∀ p, p < tot N b g →
      (p < N ∨ (N + b ≤ p ∧ p < pD N b g s 0) ∨ pC N b g s 0 ≤ p) → S2 (pos p) = 0 := by
    intro p hp ho
    rw [hS2]
    exact S2_zero hs pos hinj ind alt K x hp (by nt2)
  have hS1D : ∀ i, i < b → S1 (pos (pD N b g s i)) = dbit ind alt x i := fun i hi ↦ by
    rw [hS1]; exact S1_D hs pos hinj ind alt K x hi
  have hS1K : ∀ i, i < g - s → S1 (pos (pK N b g s i)) = kbit K x i := fun i hi ↦ by
    rw [hS1]; exact S1_K hs pos hinj ind alt K x hi
  have hP0 : ∀ p, p < tot N b g → p ≠ pFl N b g s → P (pos p) = 0 := fun p hp hne ↦ by
    rw [hP]; exact single_ne hs pos hinj hp (by lom) hne _
  have hPf : P (pos (pFl N b g s)) = fv := by rw [hP]; simp
  have hT0 : ∀ p, p < tot N b g → (p < N ∨ N + b ≤ p) → T (pos p) = 0 := fun p hp ho ↦ by
    rw [hT]; exact Stof_zero hs pos hinj _ hp (by omega)
  have hz : ∀ p, p < tot N b g → p ≠ pFl N b g s →
      (p < N ∨ (N + b ≤ p ∧ p < pD N b g s 0) ∨ pC N b g s 0 ≤ p) →
      S1 (pos p) = 0 ∧ S2 (pos p) = 0 ∧ P (pos p) = 0 ∧ T (pos p) = 0 := fun p hp hne ho ↦
    ⟨hS1z p hp ho, hS2z p hp ho, hP0 p hp hne,
      hT0 p hp (by unfold pD pC at ho; omega)⟩
  have hq : ∀ p, N + (b + g) ≤ p → p < tot N b g → p ≠ pFl N b g s →
      (pC N b g s 0 ≤ p ∨ (N + b + g ≤ p ∧ p < pD N b g s 0)) →
      β (pos p) = 0 ∧ S1 (pos p) = 0 ∧ S2 (pos p) = 0 ∧ P (pos p) = 0 ∧ T (pos p) = 0 := by
    intro p h1 h2 h3 h4
    obtain ⟨a, b', c, d⟩ := hz p h2 h3 (by simp only [pD, pC] at h4 ⊢; omega)
    exact ⟨hc p h1 h2, a, b', c, d⟩
  have hGar : ∀ p, N + b ≤ p → p < N + b + g →
      S1 (pos p) = 0 ∧ S2 (pos p) = 0 ∧ P (pos p) = 0 ∧ T (pos p) = 0 := fun p h1 h2 ↦
    hz p (by lom) (by lom) (Or.inr (Or.inl ⟨h1, by unfold pD; omega⟩))
  have hSb : ∀ t, t < g - s → β (pos (pSb N b s t)) = bitN r t := by
    intro t ht
    have e : pSb N b s t = pSl N b (s + t) := by unfold pSb pSl; omega
    rw [e, hg (s + t) (by omega), hr]
    unfold bitN
    rw [bit_sub]
  have hflagG : ∀ γ : BitAssignment n, (∀ t, t < g - s → γ (pos (pSb N b s t)) = bitN r t) →
      (∀ t, t < g - s → γ (pos (pK N b g s t)) = bitN (K x) t) →
      borW (fun t ↦ γ ((cmpW hs pos hinj).rf t)) (fun t ↦ γ ((cmpW hs pos hinj).Kf t))
        (g - s) = fv := by
    intro γ h1 h2
    have : borW (fun t ↦ γ ((cmpW hs pos hinj).rf t)) (fun t ↦ γ ((cmpW hs pos hinj).Kf t))
        (g - s) = borW (bitN r) (bitN (K x)) (g - s) :=
      borW_cong _ _ _ _ _ (fun t ht ↦ h1 t ht) (fun t ht ↦ h2 t ht)
    rw [this, flag_val r (K x) (g - s) hrlt (hK x), hfv]
  -- step 1: first lookup
  have e1 : (QC14.UnaryLookup.ulookup (W1 hs pos hinj) (tt1 (g := g) ind alt K)).eval.1 *ᵥ
      ket β = ket (β + S1) := by
    rw [hS1]
    apply ulookup_sys_ket (W1 hs pos hinj) (tt1 (g := g) ind alt K) x β
    · intro k
      exact hc _ (by have := k.2; lom) (by have := k.2; lom)
    · intro i
      have hi := i.2
      show β (pos (pSl N b i.val)) = ((x.val / 2 ^ i.val % 2 : ℕ) : ZMod 2)
      rw [hg i.val (by omega), hxv, bit_slot σ.val s i.val hi]
      rfl
  -- step 2: first comparator
  have hSb1 : ∀ t, t < g - s → (β + S1) (pos (pSb N b s t)) = bitN r t := by
    intro t ht
    obtain ⟨a, _, _, _⟩ := hGar (pSb N b s t) (by lom) (by lom)
    rw [Pi.add_apply, a, add_zero]
    exact hSb t ht
  have hK1 : ∀ t, t < g - s → (β + S1) (pos (pK N b g s t)) = bitN (K x) t := by
    intro t ht
    rw [Pi.add_apply, hc (pK N b g s t) (by lom) (by lom), hS1K t ht, zero_add]
    rfl
  have hw1 : (β + S1) ((cmpW hs pos hinj).wk) = 0 := by
    obtain ⟨a, b', _, _, _⟩ := hq (pWk N b g s) (by lom) (by lom) (by lom) (Or.inl (by lom))
    show (β + S1) (pos (pWk N b g s)) = 0
    rw [Pi.add_apply, a, b', add_zero]
  have hz1 : ∀ j, j ≤ g - s → (β + S1) ((cmpW hs pos hinj).cf j) = 0 := by
    intro j hj
    obtain ⟨a, b', _, _, _⟩ := hq (pC N b g s j) (by lom) (by lom) (by lom) (Or.inl (by lom))
    show (β + S1) (pos (pC N b g s j)) = 0
    rw [Pi.add_apply, a, b', add_zero]
  have e2 : (cmpW hs pos hinj).cmp.eval.1 *ᵥ ket (β + S1) = ket (β + S1 + P) := by
    have h := CmpW.cmp_ket (cmpW hs pos hinj) (β + S1) hw1 hz1
    rw [hflagG (β + S1) hSb1 hK1, upd_add] at h
    rw [hP]; exact h
  -- step 3: Toffoli layer
  have hγ_fl : (β + S1 + P) (pos (pFl N b g s)) = fv := by
    rw [Pi.add_apply, Pi.add_apply, hc (pFl N b g s) (by lom) (by lom),
      hS1z (pFl N b g s) (by lom) (by lom), hPf]
    simp
  have hγ_D : ∀ i, i < b → (β + S1 + P) (pos (pD N b g s i)) = dbit ind alt x i := by
    intro i hi
    rw [Pi.add_apply, Pi.add_apply, hc (pD N b g s i) (by lom) (by lom), hS1D i hi,
      hP0 (pD N b g s i) (by lom) (by lom)]
    simp
  have hwk3 : (β + S1 + P) ((tofW hs pos hinj).wk) = 0 := by
    obtain ⟨a, b', _, c, _⟩ := hq (pWk N b g s) (by lom) (by lom) (by lom) (Or.inl (by lom))
    show (β + S1 + P) (pos (pWk N b g s)) = 0
    rw [Pi.add_apply, Pi.add_apply, a, b', c]; simp
  have hfn : (tofW hs pos hinj).fn b (β + S1 + P) = β + S1 + P + T := by
    rw [TofW.fn_eq, hT]
    congr 1
    apply Finset.sum_congr rfl
    intro i hi
    rw [Finset.mem_range] at hi
    rw [if_pos hi]
    show (Pi.single (pos (pIdx N i)) ((β + S1 + P) (pos (pFl N b g s)) *
      (β + S1 + P) (pos (pD N b g s i))) : BitAssignment n) = _
    rw [hγ_fl, hγ_D i hi]
  have e3 : ((tofW hs pos hinj).chain b).eval.1 *ᵥ ket (β + S1 + P) = ket (β + S1 + P + T) := by
    rw [TofW.chain_ket _ b _ hwk3, hfn]
  -- step 4: second comparator
  have hSb3 : ∀ t, t < g - s → (β + S1 + P + T) (pos (pSb N b s t)) = bitN r t := by
    intro t ht
    obtain ⟨a, _, c, d⟩ := hGar (pSb N b s t) (by lom) (by lom)
    rw [Pi.add_apply, Pi.add_apply, Pi.add_apply, a, c, d]
    simpa using hSb t ht
  have hK3 : ∀ t, t < g - s → (β + S1 + P + T) (pos (pK N b g s t)) = bitN (K x) t := by
    intro t ht
    rw [Pi.add_apply, Pi.add_apply, Pi.add_apply, hc (pK N b g s t) (by lom) (by lom),
      hS1K t ht, hP0 (pK N b g s t) (by lom) (by lom),
      hT0 (pK N b g s t) (by lom) (Or.inr (by lom))]
    simp [kbit]
  have hw3 : (β + S1 + P + T) ((cmpW hs pos hinj).wk) = 0 := by
    obtain ⟨a, b', _, c, d⟩ := hq (pWk N b g s) (by lom) (by lom) (by lom) (Or.inl (by lom))
    show (β + S1 + P + T) (pos (pWk N b g s)) = 0
    rw [Pi.add_apply, Pi.add_apply, Pi.add_apply, a, b', c, d]; simp
  have hz3 : ∀ j, j ≤ g - s → (β + S1 + P + T) ((cmpW hs pos hinj).cf j) = 0 := by
    intro j hj
    obtain ⟨a, b', _, c, d⟩ := hq (pC N b g s j) (by lom) (by lom) (by lom) (Or.inl (by lom))
    show (β + S1 + P + T) (pos (pC N b g s j)) = 0
    rw [Pi.add_apply, Pi.add_apply, Pi.add_apply, a, b', c, d]; simp
  have e4 : (cmpW hs pos hinj).cmp.eval.1 *ᵥ ket (β + S1 + P + T) =
      ket (β + S1 + P + T + P) := by
    have h := CmpW.cmp_ket (cmpW hs pos hinj) (β + S1 + P + T) hw3 hz3
    rw [hflagG (β + S1 + P + T) hSb3 hK3, upd_add] at h
    exact h.trans (by subst hP; rfl)
  -- step 5: second lookup
  have e5 : (QC14.UnaryLookup.ulookup (W2 hs pos hinj) (tt2 (g := g) ind alt K)).eval.1 *ᵥ
      ket (β + S1 + P + T + P) = ket (β + S1 + P + T + P + S2) := by
    rw [hS2]
    apply ulookup_sys_ket (W2 hs pos hinj) (tt2 (g := g) ind alt K) x (β + S1 + P + T + P)
    · intro k
      have hk := k.2
      obtain ⟨a, b', _, c, d⟩ := hq (pCh N b g k.val) (by lom) (by lom) (by lom)
        (Or.inr ⟨by lom, by lom⟩)
      show (β + S1 + P + T + P) (pos (pCh N b g k.val)) = 0
      rw [Pi.add_apply, Pi.add_apply, Pi.add_apply, Pi.add_apply, a, b', c, d]; simp
    · intro i
      have hi := i.2
      obtain ⟨a, _, c, d⟩ := hGar (pSl N b i.val) (by lom) (by lom)
      show (β + S1 + P + T + P) (pos (pSl N b i.val)) = ((x.val / 2 ^ i.val % 2 : ℕ) : ZMod 2)
      rw [Pi.add_apply, Pi.add_apply, Pi.add_apply, Pi.add_apply, a, c, d, hg i.val (by omega),
        hxv, bit_slot σ.val s i.val hi]
      simp [bitN]
  unfold core
  rw [seq_mulVec, e1, seq_mulVec, e2, seq_mulVec, e3, seq_mulVec, e4, e5]
  -- algebra
  have hS1' : S1 = (∑ i ∈ Finset.range b,
      (Pi.single (pos (pIdx N i)) (abit alt x i) : BitAssignment n)) + S2 := by
    rw [hS1, hS2]; exact S1_eq hs pos hinj ind alt K x
  have hbit : ∀ i, abit alt x i + fv * dbit ind alt x i = bitN (aliasF ind alt K σ).val i := by
    intro i
    have hF : aliasF ind alt K σ = if r < K x then ind x else alt x := by
      rw [hx, hr]; rfl
    by_cases h : r < K x
    · simp only [hF, hfv, h, ↓reduceIte]
      have key : ∀ a c : ZMod 2, a + 1 * (c + a) = c := by decide
      exact key _ _
    · simp only [hF, hfv, h, ↓reduceIte]
      rw [zero_mul, add_zero]; rfl
  have hTg : (∑ q : Fin b, (Pi.single (pos (pIdx N q.val))
      (bitN (aliasF ind alt K σ).val q.val) : BitAssignment n)) =
      (∑ i ∈ Finset.range b, (Pi.single (pos (pIdx N i)) (abit alt x i) : BitAssignment n)) + T := by
    rw [Fin.sum_univ_eq_sum_range (fun q ↦ (Pi.single (pos (pIdx N q))
      (bitN (aliasF ind alt K σ).val q) : BitAssignment n)) b, hT, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _
    rw [← Pi.single_add, hbit]
  rw [hTg, hS1']
  congr 1
  funext p
  simp only [Pi.add_apply]
  have key : ∀ a1 a2 a3 a4 a5 : ZMod 2,
      a1 + (a2 + a3) + a4 + a5 + a4 + a3 = a1 + (a2 + a5) := by decide
  exact key _ _ _ _ _

end core

end Lay

/-- Clean scratch wires of the alias PREPARE. Wire `j` of the scratch register is position
`N + (b + g) + j` of the joint layout (`Lay`): `0..s` lookup address ancilla, `s+1..s+b`
`D`, then `g - s` wires of `Kreg`, then `g - s + 1` carries, the flag and one work wire. -/
def aliasAnc (b g s : ℕ) : ℕ := b + 2 * g + 4

theorem aliasAnc_le (b g s : ℕ) : aliasAnc b g s ≤ b + 2 * g + 4 := by
  unfold aliasAnc; omega

/-! ### Assembly -/

section assembly
open QuantumComputation.Specs.PrepareImpl QuantumComputation.Specs.SelectPauliImpl

variable {N b g s : ℕ}

/-- Joint position map: data wires, then scratch wires. -/
def posOf (rData : QRegister (N + (b + g)) n) (rAnc : QRegister (aliasAnc b g s) n)
    (p : ℕ) : Wire n :=
  if h : p < N + (b + g) then rData ⟨p, h⟩
  else if h' : p - (N + (b + g)) < aliasAnc b g s then rAnc ⟨p - (N + (b + g)), h'⟩
  else rAnc ⟨0, by unfold aliasAnc; omega⟩

theorem posOf_data (rData : QRegister (N + (b + g)) n) (rAnc : QRegister (aliasAnc b g s) n)
    {p : ℕ} (h : p < N + (b + g)) : posOf rData rAnc p = rData ⟨p, h⟩ := by
  unfold posOf; rw [dif_pos h]

theorem posOf_anc (rData : QRegister (N + (b + g)) n) (rAnc : QRegister (aliasAnc b g s) n)
    {p : ℕ} (h1 : N + (b + g) ≤ p) (h2 : p < Lay.tot N b g) :
    posOf rData rAnc p = rAnc ⟨p - (N + (b + g)), by unfold Lay.tot at h2; unfold aliasAnc; omega⟩ := by
  have h3 : p - (N + (b + g)) < aliasAnc b g s := by unfold Lay.tot at h2; unfold aliasAnc; omega
  unfold posOf
  rw [dif_neg (by omega : ¬ p < N + (b + g)), dif_pos h3]

theorem posOf_inj (rData : QRegister (N + (b + g)) n) (rAnc : QRegister (aliasAnc b g s) n)
    (hd : ∀ i j, rData i ≠ rAnc j) :
    ∀ p q, p < Lay.tot N b g → q < Lay.tot N b g → posOf rData rAnc p = posOf rData rAnc q →
      p = q := by
  intro p q hp hq h
  by_cases h1 : p < N + (b + g) <;> by_cases h2 : q < N + (b + g)
  · rw [posOf_data rData rAnc h1, posOf_data rData rAnc h2] at h
    have := rData.wires.injective h
    exact congrArg Fin.val this
  · rw [posOf_data rData rAnc h1, posOf_anc rData rAnc (by omega) hq] at h
    exact absurd h (hd _ _)
  · rw [posOf_anc rData rAnc (by omega) hp, posOf_data rData rAnc h2] at h
    exact absurd h.symm (hd _ _)
  · rw [posOf_anc rData rAnc (by omega) hp, posOf_anc rData rAnc (by omega) hq] at h
    have := rAnc.wires.injective h
    have h5 := congrArg Fin.val this
    simp only at h5
    omega

theorem rd_congr {k : ℕ} (r : QRegister k n) {a a' : ℕ} (h : a < k) (h' : a' < k) (e : a = a') :
    r ⟨a, h⟩ = r ⟨a', h'⟩ := by subst e; rfl

theorem sysAdd_xrow {s N' : ℕ} (W : Wires s N' n) (a : Fin N' → ZMod 2) :
    W.sysAdd (xrow a) = ∑ q : Fin N', (Pi.single (W.sw q) (a q) : BitAssignment n) := by
  unfold QuantumComputation.Specs.SelectPauliImpl.Wires.sysAdd
  simp only [pf_xrow]

/-- Exact action of the core on clean scratch: the SELECT-table unitary of `aliasF`. -/
theorem core_eq_sel (hs : s ≤ g) (ind alt : Fin (2 ^ s) → Fin (2 ^ b)) (K : Fin (2 ^ s) → ℕ)
    (hK : ∀ x, K x < 2 ^ (g - s)) (rData : QRegister (N + (b + g)) n)
    (rAnc : QRegister (aliasAnc b g s) n) (hd : ∀ i j, rData i ≠ rAnc j) (β : BitAssignment n)
    (h0 : localIdx rAnc β = 0) :
    (Lay.core hs (posOf rData rAnc) (posOf_inj rData rAnc hd) ind alt K).eval.1 *ᵥ ket β =
      ((rData.slice N (b + g) le_rfl).embedUnitary
        (selectPauliUnitary g b (2 ^ g) (tblOf b g (aliasF ind alt K)))).1 *ᵥ ket β := by
  classical
  have hz : ∀ j, β (rAnc j) = 0 := (localIdx_eq_zero_iff _ _).1 h0
  obtain ⟨σ, hσ⟩ : ∃ σ : Fin (2 ^ g), ∀ i (hi : i < g),
      β (rData ⟨N + (b + i), by omega⟩) = bitN σ.val i := by
    refine ⟨(basisBits g).symm (fun i ↦ β (rData ⟨N + (b + i.val), by omega⟩)), fun i hi ↦ ?_⟩
    have h := basisBits_eq_div_mod g
      ((basisBits g).symm (fun i ↦ β (rData ⟨N + (b + i.val), by omega⟩))) ⟨i, hi⟩
    rw [Equiv.apply_symm_apply] at h
    exact h
  have hck := Lay.core_ket hs (posOf rData rAnc) (posOf_inj rData rAnc hd) ind alt K hK β σ
    (fun p h1 h2 ↦ by rw [posOf_anc rData rAnc h1 h2]; exact hz _)
    (fun i hi ↦ by
      rw [posOf_data rData rAnc (by unfold Lay.pSl; omega)]
      exact (congrArg β (rd_congr rData _ _ (by unfold Lay.pSl; omega))).trans (hσ i hi))
  have hdP : (rData.slice N (b + g) le_rfl).DisjointWires
      (rAnc.slice 0 (g + 1) (by unfold aliasAnc; omega)) :=
    QRegister.disjoint_iff.2 (fun i j ↦ hd _ _)
  have h0'' := localIdx_slice_zero rAnc 0 (g + 1) (by unfold aliasAnc; omega) β h0
  have hk : (rAnc.slice 0 (g + 1) (by unfold aliasAnc; omega)).basisOutcomeProjector 0 *ᵥ
      ket β = ket β := by
    rw [basisOutcomeProjector_mulVec_ket, if_pos h0'']
  have hS : ((mkWires (b := g) (N := b) (rData.slice N (b + g) le_rfl)
      (rAnc.slice 0 (g + 1) (by unfold aliasAnc; omega)) (fun i j ↦ hd _ _)).full
        (tblOf b g (aliasF ind alt K))).eval.1 *ᵥ ket β =
      ((rData.slice N (b + g) le_rfl).embedUnitary
        (selectPauliUnitary g b (2 ^ g) (tblOf b g (aliasF ind alt K)))).1 *ᵥ ket β := by
    have h := congrArg (fun M : Matrix _ _ ℂ ↦ M *ᵥ ket β)
      (sel_clean b g (tblOf b g (aliasF ind alt K)) (rData.slice N (b + g) le_rfl)
        (rAnc.slice 0 (g + 1) (by unfold aliasAnc; omega)) hdP)
    simp only [← Matrix.mulVec_mulVec, hk] at h
    exact h
  have hL : ((mkWires (b := g) (N := b) (rData.slice N (b + g) le_rfl)
      (rAnc.slice 0 (g + 1) (by unfold aliasAnc; omega)) (fun i j ↦ hd _ _)).full
        (tblOf b g (aliasF ind alt K))).eval.1 *ᵥ ket β =
      ket (β + ∑ q : Fin b, (Pi.single (rData ⟨N + q.val, by omega⟩)
        (bitN (aliasF ind alt K σ).val q.val) : BitAssignment n)) := by
    have h := lookup_ket (mkWires (b := g) (N := b) (rData.slice N (b + g) le_rfl)
      (rAnc.slice 0 (g + 1) (by unfold aliasAnc; omega)) (fun i j ↦ hd _ _))
      (fun j q ↦ basisBits b (aliasF ind alt K j) q) σ β (fun k ↦ hz _)
      (fun i ↦ hσ i.val i.2)
    rw [sysAdd_xrow] at h
    refine Eq.trans h ?_
    refine congrArg ket (congrArg (β + ·) (Finset.sum_congr rfl (fun q _ ↦ ?_)))
    rw [basisBits_eq_div_mod b _ q] <;> rfl
  rw [hck, ← hS, hL]
  refine congrArg ket (congrArg (β + ·) (Finset.sum_congr rfl (fun q _ ↦ ?_)))
  rw [posOf_data rData rAnc (by unfold Lay.pIdx; omega)] <;> rfl

/-- The core acts as the SELECT-table unitary on any state obtained from a clean ket by a
unitary on the data register. -/
theorem core_clean (hs : s ≤ g) (ind alt : Fin (2 ^ s) → Fin (2 ^ b)) (K : Fin (2 ^ s) → ℕ)
    (hK : ∀ x, K x < 2 ^ (g - s)) (rData : QRegister (N + (b + g)) n)
    (rAnc : QRegister (aliasAnc b g s) n) (hd : ∀ i j, rData i ≠ rAnc j)
    (Hu : Unitary (2 ^ (b + g))) (β : BitAssignment n) (h0 : localIdx rAnc β = 0) :
    (Lay.core hs (posOf rData rAnc) (posOf_inj rData rAnc hd) ind alt K).eval.1 *ᵥ
        ((rData.slice N (b + g) le_rfl).embedUnitary Hu).1 *ᵥ ket β =
      ((rData.slice N (b + g) le_rfl).embedUnitary
        (selectPauliUnitary g b (2 ^ g) (tblOf b g (aliasF ind alt K)))).1 *ᵥ
        (((rData.slice N (b + g) le_rfl).embedUnitary Hu).1 *ᵥ ket β) := by
  set rD := rData.slice N (b + g) le_rfl with hrD
  have hdD : rD.DisjointWires rAnc := QRegister.disjoint_iff.2 (fun i j ↦ hd _ _)
  set Q0 := rAnc.basisOutcomeProjector 0 with hQ
  set C := (Lay.core hs (posOf rData rAnc) (posOf_inj rData rAnc hd) ind alt K).eval.1 with hC
  set S := (rD.embedUnitary (selectPauliUnitary g b (2 ^ g) (tblOf b g (aliasF ind alt K)))).1
    with hS
  have hk : Q0.mulVec (ket β) = ket β := by
    rw [hQ, basisOutcomeProjector_mulVec_ket, if_pos h0]
  have hv : Q0.mulVec ((rD.embedUnitary Hu).1.mulVec (ket β)) =
      (rD.embedUnitary Hu).1.mulVec (ket β) := by
    rw [Matrix.mulVec_mulVec, QuantumComputation.Specs.CleanSubroutineBridge.embed_comm_proj
      rD rAnc hdD Hu, ← Matrix.mulVec_mulVec, hk]
  have hs : C * Q0 = S * Q0 :=
    clean_ext rAnc C S (fun β' h0' ↦ core_eq_sel hs ind alt K hK rData rAnc hd β' h0')
  calc C.mulVec ((rD.embedUnitary Hu).1.mulVec (ket β))
      = C.mulVec (Q0.mulVec ((rD.embedUnitary Hu).1.mulVec (ket β))) := by rw [hv]
    _ = (C * Q0).mulVec ((rD.embedUnitary Hu).1.mulVec (ket β)) := by rw [Matrix.mulVec_mulVec]
    _ = (S * Q0).mulVec ((rD.embedUnitary Hu).1.mulVec (ket β)) := by rw [hs]
    _ = _ := by rw [← Matrix.mulVec_mulVec, hv]

end assembly

/-- The alias PREPARE circuit: `H` on the garbage wires, then `Lay.core`. -/
def aliasPrepC {N b g s : ℕ} (hs : s ≤ g) (ind alt : Fin (2 ^ s) → Fin (2 ^ b))
    (K : Fin (2 ^ s) → ℕ) (rData : QRegister (N + (b + g)) n)
    (rAnc : QRegister (aliasAnc b g s) n) (hd : ∀ i j, rData i ≠ rAnc j) : Circuit n :=
  Circuit.seq ((QuantumComputation.Specs.PrepareImpl.hPre b g g le_rfl).onRegister
      (rData.slice N (b + g) le_rfl))
    (Lay.core hs (posOf rData rAnc) (posOf_inj rData rAnc hd) ind alt K)

/-- Exact action on every basis ket with clean scratch (compare `BlockLCU.prepC_ket`). -/
theorem aliasPrepC_ket {N b g s : ℕ} (hs : s ≤ g) (ind alt : Fin (2 ^ s) → Fin (2 ^ b))
    (K : Fin (2 ^ s) → ℕ) (hK : ∀ x, K x < 2 ^ (g - s)) (rData : QRegister (N + (b + g)) n)
    (rAnc : QRegister (aliasAnc b g s) n) (hd : ∀ i j, rData i ≠ rAnc j) (β : BitAssignment n)
    (h0 : localIdx rAnc β = 0) :
    (aliasPrepC hs ind alt K rData rAnc hd).eval.1 *ᵥ ket β =
      (rData.embedUnitary ((blkA N b g).embedUnitary (prepU b g (aliasF ind alt K)))).1 *ᵥ
        ket β := by
  rw [← QRegister.embedUnitary_compose, prepU, QRegister.embedUnitary_mul]
  unfold aliasPrepC
  rw [Circuit.eval_seq, Circuit.eval_onRegister, QuantumComputation.Specs.PrepareImpl.mulVec_mul_unitary,
    QuantumComputation.Specs.PrepareImpl.mulVec_mul_unitary]
  exact core_clean hs ind alt K hK rData rAnc hd _ β h0

/-- No `TOFF`; two lookups over `2^s` slots, two comparators, `b` Toffolis. -/
theorem aliasPrepC_count {N b g s : ℕ} (hs : s ≤ g) (ind alt : Fin (2 ^ s) → Fin (2 ^ b))
    (K : Fin (2 ^ s) → ℕ) (rData : QRegister (N + (b + g)) n)
    (rAnc : QRegister (aliasAnc b g s) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    (aliasPrepC hs ind alt K rData rAnc hd).count PrimitiveGate.TOFF = 0 ∧
      (aliasPrepC hs ind alt K rData rAnc hd).count PrimitiveGate.T ≤
        16 * 2 ^ s + 32 * (g - s + 1) + 16 * b := by
  have hpos := posOf_inj rData rAnc hd
  have hHT : ((QuantumComputation.Specs.PrepareImpl.hPre b g g le_rfl).onRegister
      (rData.slice N (b + g) le_rfl)).count PrimitiveGate.T = 0 := by
    rw [Circuit.count_onRegister]
    exact QuantumComputation.Specs.PrepareImpl.count_hPre b g g le_rfl _ (by simp)
  have hHO : ((QuantumComputation.Specs.PrepareImpl.hPre b g g le_rfl).onRegister
      (rData.slice N (b + g) le_rfl)).count PrimitiveGate.TOFF = 0 := by
    rw [Circuit.count_onRegister]
    exact QuantumComputation.Specs.PrepareImpl.count_hPre b g g le_rfl _ (by simp)
  have h1 := QC14.UnaryLookup.ulookup_count (Lay.W1 hs (posOf rData rAnc) hpos) (Lay.tt1 (g := g) ind alt K)
  have h2 := QC14.UnaryLookup.ulookup_count (Lay.W2 hs (posOf rData rAnc) hpos) (Lay.tt2 (g := g) ind alt K)
  have hc := CmpW.cmp_count (Lay.cmpW hs (posOf rData rAnc) hpos)
  have ht := TofW.chain_count (Lay.tofW hs (posOf rData rAnc) hpos) b
  unfold aliasPrepC Lay.core
  simp only [Circuit.count_seq]
  constructor <;> omega

end QC14.AliasCircuit


/-! Inlined from lane module `THC/AliasProgram.lean`. -/

namespace QC14.AliasProgram

open QuantumComputation QuantumComputation.Specs Matrix Finset
open QuantumComputation.Specs.ArcsinImpl
open Operator QProg Function
open QC14.Catalytic QC14.GivensPlane QC14.RowProgram QC14.SelectRows QC14.SelectL QC14.BlockLCU QC14.WeightsC
open QC14.PairBlock QC14.PairPrep QC14.PairProgram QC14.AliasCircuit
open QC14 (blkA blkS blkSys prepU sA sA_le_gC)
open scoped Matrix

variable {n : ℕ}

/-- Wire bounds on the pair index (`bP = 2 bIC + 2`), as in `PairProgram`. -/
local macro "pairw" : tactic =>
  `(tactic| ((try simp only [ne_eq, Fin.ext_iff, bP, idxC] at *) <;> omega))

/-- Chain register of the pair program. -/
abbrev ancP (N M aleph : ℕ) : ℕ := max (bP N M + gP N M aleph + 1) (aliasAnc (bP N M) (gP N M aleph) (sA N M))

theorem sA_le_gP (N M aleph : ℕ) : sA N M ≤ gP N M aleph := by
  rw [gP_eq]; exact sA_le_gC N M aleph

theorem ancP_base (N M aleph : ℕ) : 0 + (bP N M + gP N M aleph + 1) ≤ ancP N M aleph := by
  rw [Nat.zero_add]; exact le_max_left _ _

theorem ancP_alias (N M aleph : ℕ) :
    0 + aliasAnc (bP N M) (gP N M aleph) (sA N M) ≤ ancP N M aleph := by
  rw [Nat.zero_add]; exact le_max_right _ _

theorem ancP_sel (N M aleph : ℕ) : 0 + (bIC N M + 1) ≤ ancP N M aleph := by
  have h := ancP_base N M aleph
  have h2 : bP N M = 2 * bIC N M + 2 := rfl
  omega

/-- The alias PREPARE stage on the first `aliasAnc` chain wires. -/
noncomputable def prepA {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancP N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j) : Circuit n :=
  aliasPrepC (sA_le_gP N M aleph) (indP thc D aleph) (altP thc D aleph)
    (aliasTabs thc D aleph).2.2 rData (rAnc.slice 0 _ (ancP_alias N M aleph)) (fun _ _ ↦ hd _ _)

/-- Alias PREPARE, `H_o`, `CSWAP(o; A, B)`. -/
noncomputable def pairPrepA {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancP N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j) : Circuit n :=
  .seq (prepA thc D aleph rData rAnc hd)
    (.seq ((Circuit.H (⟨idxC N M, by pairw⟩ : Wire (bP N M + gP N M aleph))).onRegister
        (rData.slice (2 * N) (bP N M + gP N M aleph) le_rfl))
      ((cswapLoc N M (bIC N M) le_rfl).onRegister
        (cswReg rData (rAnc.slice 0 _ (ancP_base N M aleph)) (fun _ _ ↦ hd _ _))))

theorem prepA_ket {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancP N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j)
    (β : BitAssignment n) (h0 : localIdx rAnc β = 0) :
    (prepA thc D aleph rData rAnc hd).eval.1 *ᵥ ket β =
      (rData.embedUnitary ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
        (prepU (bP N M) (gP N M aleph) (fP thc D aleph)))).1 *ᵥ ket β :=
  aliasPrepC_ket (sA_le_gP N M aleph) (indP thc D aleph) (altP thc D aleph)
    (aliasTabs thc D aleph).2.2 (aliasTabs_K_lt thc D aleph) rData _ (fun _ _ ↦ hd _ _) β
    (QC14.localIdx_slice_zero rAnc 0 _ (ancP_alias N M aleph) β h0)

/-- On kets with clean scratch, the alias pair PREPARE is the embedded `pairPrepU`. -/
theorem pairPrepA_ket {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancP N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j)
    (β : BitAssignment n) (h0 : localIdx rAnc β = 0) :
    (pairPrepA thc D aleph rData rAnc hd).eval.1 *ᵥ ket β =
      (rData.embedUnitary ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
        (pairPrepU thc D aleph))).1 *ᵥ ket β := by
  have hdD : rData.DisjointWires rAnc := QRegister.disjoint_iff.2 hd
  have e : (blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (pairPrepU thc D aleph) =
      (blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
          (permutationUnitary (cswapPerm N M (gP N M aleph))) *
        (blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (hO N M (gP N M aleph)) *
        (blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
          (prepU (bP N M) (gP N M aleph) (fP thc D aleph)) := by
    unfold pairPrepU
    rw [QRegister.embedUnitary_mul, QRegister.embedUnitary_mul]
  have hC2 : ((Circuit.H (⟨idxC N M, by pairw⟩ : Wire (bP N M + gP N M aleph))).onRegister
      (rData.slice (2 * N) (bP N M + gP N M aleph) le_rfl)).eval =
      rData.embedUnitary ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
        (hO N M (gP N M aleph))) := by
    rw [Circuit.eval_onRegister]
    show (rData.compose (blkA (2 * N) (bP N M) (gP N M aleph))).embedUnitary
      (hO N M (gP N M aleph)) = _
    rw [QRegister.embedUnitary_compose]
  rw [e]
  have := chain3_ket rData rAnc hdD
    (prepA thc D aleph rData rAnc hd).eval.1
    ((Circuit.H (⟨idxC N M, by pairw⟩ : Wire (bP N M + gP N M aleph))).onRegister
      (rData.slice (2 * N) (bP N M + gP N M aleph) le_rfl)).eval.1
    ((cswapLoc N M (bIC N M) le_rfl).onRegister
      (cswReg rData (rAnc.slice 0 _ (ancP_base N M aleph)) (fun _ _ ↦ hd _ _))).eval.1
    ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
      (prepU (bP N M) (gP N M aleph) (fP thc D aleph)))
    ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (hO N M (gP N M aleph)))
    ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
      (permutationUnitary (cswapPerm N M (gP N M aleph))))
    (fun β h0 ↦ prepA_ket thc D aleph rData rAnc hd β h0)
    (fun β _ ↦ congrArg (fun U : Unitary (2 ^ n) ↦ U.1 *ᵥ ket β) hC2)
    (fun β h0 ↦ by
      have := cswap_clean rData (rAnc.slice 0 _ (ancP_base N M aleph)) (fun _ _ ↦ hd _ _) β
        (QC14.localIdx_slice_zero rAnc 0 _ (ancP_base N M aleph) β h0)
      rwa [QRegister.embedUnitary_compose] at this)
    β h0
  unfold pairPrepA
  rw [Circuit.eval_seq, Circuit.eval_seq]
  exact this

theorem pairPrepAinv_ket {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancP N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j)
    (β : BitAssignment n) (h0 : localIdx rAnc β = 0) :
    (pairPrepA thc D aleph rData rAnc hd).inverse.eval.1 *ᵥ ket β =
      (rData.embedUnitary (star ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary
        (pairPrepU thc D aleph)))).1 *ᵥ ket β := by
  have hdD : rData.DisjointWires rAnc := QRegister.disjoint_iff.2 hd
  rw [QC14.embedUnitary_star']
  refine QC14.PairProgram.inv_ket rAnc (pairPrepA thc D aleph rData rAnc hd).eval
    (pairPrepA thc D aleph rData rAnc hd).inverse.eval _
    (fun β h0 ↦ pairPrepA_ket thc D aleph rData rAnc hd β h0) ?_ ?_ β h0
  · rw [← QC14.embedUnitary_star']
    exact (CleanSubroutineBridge.embed_comm_proj rData rAnc hdD _).symm
  · rw [Circuit.eval_inverse]
    exact congrArg Subtype.val (inv_mul_cancel (pairPrepA thc D aleph rData rAnc hd).eval)

/-- `T` count of the alias PREPARE stage plus `CSWAP`. -/
abbrev prepTA (N M aleph : ℕ) : ℕ :=
  16 * 2 ^ sA N M + 32 * (gP N M aleph - sA N M + 1) + 16 * bP N M + 8 * bIC N M

theorem pairPrepA_count {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancP N M aleph) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    (pairPrepA thc D aleph rData rAnc hd).count PrimitiveGate.TOFF = 0 ∧
      (pairPrepA thc D aleph rData rAnc hd).count PrimitiveGate.T ≤ prepTA N M aleph := by
  have hp := aliasPrepC_count (sA_le_gP N M aleph) (indP thc D aleph) (altP thc D aleph)
    (aliasTabs thc D aleph).2.2 rData (rAnc.slice 0 _ (ancP_alias N M aleph)) (fun _ _ ↦ hd _ _)
  obtain ⟨hc1, hc2⟩ := cswapLoc_count N M (bIC N M) le_rfl
  have hH1 : (Circuit.H (⟨idxC N M, by pairw⟩ : Wire (bP N M + gP N M aleph))).count
      PrimitiveGate.TOFF = 0 := by simp
  have hH2 : (Circuit.H (⟨idxC N M, by pairw⟩ : Wire (bP N M + gP N M aleph))).count
      PrimitiveGate.T = 0 := by simp
  simp only [pairPrepA, prepA, prepTA, Circuit.count_seq, Circuit.count_onRegister] at hp ⊢
  omega

/-! ## The whole program -/

/-- `PREPARE; SELECT; PREPARE†`; SELECT uses the first `bIC + 1` chain wires. -/
noncomputable def pairProgramA {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ}
    (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancP N M aleph) n) (rK : QRegister (2 * beth) n)
    (rCat : QRegister beth n) (hd : ∀ i j, rData i ≠ rAnc j) (hcD : rCat.DisjointWires rData) :
    DynamicCircuit Var n :=
  .seq (.circuit (pairPrepA thc D aleph rData rAnc hd))
    (.seq (pairSelProgram v beth D (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
        (rAnc.slice 0 (bIC N M + 1) (ancP_sel N M aleph)) rK rCat (fun i j ↦ hd _ _)
        (hcD.compose_right _))
      (.circuit (pairPrepA thc D aleph rData rAnc hd).inverse))

theorem pair_catKetA {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    {N M : ℕ} [NeZero N] (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancP N M aleph) n) (rK : QRegister (2 * beth) n)
    (rCat : QRegister beth n) (hd : ∀ i j, rData i ≠ rAnc j) (hcD : rCat.DisjointWires rData)
    (hAK : rAnc.DisjointWires rK) (hsc : (rAnc.concat rK hAK).DisjointWires rCat)
    (hdisj : rData.DisjointWires ((rAnc.concat rK hAK).concat rCat hsc)) :
    ∃ S : Unitary (2 ^ (2 * N + bP N M)),
      S.1 = pairSelOp D beth ∧
      CatKet rData (rAnc.concat rK hAK) rCat hsc
        (pairProgramA v beth thc D aleph rData rAnc rK rCat hd hcD).compile
        (lcuQ N (bP N M) (gP N M aleph) (pairPrepU thc D aleph) S) := by
  have hb : 0 + (bIC N M + 1) ≤ ancP N M aleph := ancP_sel N M aleph
  have hAK' : (rAnc.slice 0 (bIC N M + 1) hb).DisjointWires rK := hAK.compose_left _
  have hsc' : ((rAnc.slice 0 (bIC N M + 1) hb).concat rK hAK').DisjointWires rCat := by
    rw [QRegister.disjoint_iff]
    intro i j h
    obtain ⟨i', hi'⟩ := QC14.PairProgram.concat_sub2 rAnc rK hb hAK hAK' i
    exact (QRegister.disjoint_iff.1 hsc i' j) (hi'.symm.trans h)
  have hdisj' : (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph))).DisjointWires
      (((rAnc.slice 0 (bIC N M + 1) hb).concat rK hAK').concat rCat hsc') := by
    rw [QRegister.disjoint_iff]
    intro i j h
    obtain ⟨j', hj'⟩ := QC14.PairProgram.concat_sub3 rAnc rK rCat hb hAK hAK' hsc hsc' j
    exact (QRegister.disjoint_iff.1 hdisj (blkS (2 * N) (bP N M) (gP N M aleph) i) j')
      (h.trans hj')
  obtain ⟨S, hSval, hSel⟩ := pairSel_catKet v beth D
    (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
    (rAnc.slice 0 (bIC N M + 1) hb) rK rCat (fun i j ↦ hd _ _) (hcD.compose_right _) hAK' hsc'
    hdisj'
  have hSel2 := CatKet.compose (blkS (2 * N) (bP N M) (gP N M aleph)) hSel
  have hsub : ∀ β : BitAssignment n,
      localIdx ((rAnc.concat rK hAK).concat rCat hsc) β = 0 →
      localIdx (((rAnc.slice 0 (bIC N M + 1) hb).concat rK hAK').concat rCat hsc') β = 0 := by
    intro β h0
    apply localIdx_eq_zero_of_forall
    intro i
    obtain ⟨i', hi'⟩ := QC14.PairProgram.concat_sub3 rAnc rK rCat hb hAK hAK' hsc hsc' i
    rw [hi']
    exact eq_zero_of_localIdx_eq_zero _ β h0 i'
  have hSel3 := catKet_mono_scratch hsub hSel2
  have hPrep := catKet_circuit_ket (Var := Var) rData (rAnc.concat rK hAK) rCat hsc
    (pairPrepA thc D aleph rData rAnc hd)
    ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (pairPrepU thc D aleph))
    (fun β h0 ↦ pairPrepA_ket thc D aleph rData rAnc hd β
      (localIdx_concat_zero rAnc rK hAK β h0).1)
  have hInvK := catKet_circuit_ket (Var := Var) rData (rAnc.concat rK hAK) rCat hsc
    (pairPrepA thc D aleph rData rAnc hd).inverse
    (star ((blkA (2 * N) (bP N M) (gP N M aleph)).embedUnitary (pairPrepU thc D aleph)))
    (fun β h0 ↦ pairPrepAinv_ket thc D aleph rData rAnc hd β
      (localIdx_concat_zero rAnc rK hAK β h0).1)
  refine ⟨S, hSval, ?_⟩
  unfold lcuQ
  simp only [pairProgramA, DynamicCircuit.compile_seq]
  exact CatKet.seq hdisj hPrep (CatKet.seq hdisj hSel3 hInvK)

theorem pair_countA {Var : Type} (v : Var) (beth : ℕ) {N M : ℕ} [NeZero N]
    (thc : THCFactorization N M) (D : CData N M) (aleph : ℕ)
    (rData : QRegister (2 * N + (bP N M + gP N M aleph)) n)
    (rAnc : QRegister (ancP N M aleph) n) (rK : QRegister (2 * beth) n)
    (rCat : QRegister beth n) (hd : ∀ i j, rData i ≠ rAnc j) (hcD : rCat.DisjointWires rData) :
    (pairProgramA v beth thc D aleph rData rAnc rK rCat hd hcD).count PrimitiveGate.TOFF = 0 ∧
      (pairProgramA v beth thc D aleph rData rAnc rK rCat hd hcD).count PrimitiveGate.T ≤
        2 * prepTA N M aleph +
          2 * (2 * (N + M) * (16 * (N - 1) * (beth - 1) + 8 * bIC N M)) := by
  have hp := pairPrepA_count thc D aleph rData rAnc hd
  have hs := pairSel_count v beth D (rData.compose (blkS (2 * N) (bP N M) (gP N M aleph)))
    (rAnc.slice 0 (bIC N M + 1) (ancP_sel N M aleph)) rK rCat (fun i j ↦ hd _ _)
    (hcD.compose_right _)
  have hiT : ∀ c : Circuit n, c.inverse.count PrimitiveGate.T = c.count PrimitiveGate.T :=
    fun c ↦ Circuit.count_inverse_of_ne _ (by simp) (by simp) c
  have hiO : ∀ c : Circuit n, c.inverse.count PrimitiveGate.TOFF = c.count PrimitiveGate.TOFF :=
    fun c ↦ Circuit.count_inverse_of_ne _ (by simp) (by simp) c
  simp only [pairProgramA, DynamicCircuit.count, hiT, hiO]
  omega

end QC14.AliasProgram


/-! Inlined from lane module `THC/RegKick.lean`. -/

namespace QC14.RegKick
open QuantumComputation QuantumComputation.Specs Matrix
open QuantumComputation.Specs.ArcsinImpl
open QC14.Catalytic QC14.GivensPlane
open Operator QProg Function

variable {n : ℕ}

/-- The angle word: bits `1 .. b` of `j`. -/
def kickWord (b : ℕ) (j : Fin (2 ^ (b + 1))) : ℕ :=
  ∑ i : Fin b, (basisBits (b + 1) j i.succ).val * 2 ^ i.val

/-- The kick constant on target ++ word: `t · 2a`, or `t · (2^b − 2a mod 2^b)` when `neg`. -/
def kickF (b : ℕ) (neg : Bool) (j : Fin (2 ^ (b + 1))) : ℕ :=
  (basisBits (b + 1) j 0).val *
    (if neg then 2 ^ b - 2 * kickWord b j % 2 ^ b else 2 * kickWord b j)

/-! ### Mask steps -/

/-- Mask bit: `c ∧ w`, or `c ∧ ¬w = c ∧ w ⊕ c` for the complemented word. -/
def rkBit (neg : Bool) (c w : ZMod 2) : ZMod 2 :=
  c * w + if neg then c else 0

/-- One mask bit: `m := c ∧ w` (`and4t`), then `m ⊕= c` when complementing. -/
def rkMaskBit (neg : Bool) (c w m : Wire n) : List (Step n) :=
  Step.and4t c w m :: (if neg then [Step.cnot c m] else [])

/-- Undo of `rkMaskBit`. -/
def rkUnmaskBit (neg : Bool) (c w m : Wire n) : List (Step n) :=
  (if neg then [Step.cnot c m] else []) ++ [Step.unand c w m]

def rkMask (neg : Bool) : (k : ℕ) → Wire n → QRegister k n → QRegister k n → List (Step n)
  | 0, _, _, _ => []
  | k + 1, c, rW, rM => rkMaskBit neg c (rW 0) (rM 0) ++ rkMask neg k c (regTail rW) (regTail rM)

def rkUnmask (neg : Bool) : (k : ℕ) → Wire n → QRegister k n → QRegister k n → List (Step n)
  | 0, _, _, _ => []
  | k + 1, c, rW, rM =>
      rkUnmaskBit neg c (rW 0) (rM 0) ++ rkUnmask neg k c (regTail rW) (regTail rM)

theorem rkMask_run (neg : Bool) (k : ℕ) (c : Wire n) (rW rM : QRegister k n)
    (hWM : rW.DisjointWires rM) (hcW : c ∉ Set.range rW.wires) (hcM : c ∉ Set.range rM.wires)
    (β : BitAssignment n) (hclean : ∀ i, β (rM i) = 0) :
    runList (rkMask neg k c rW rM) β =
      some (writeReg β rM (fun i ↦ rkBit neg (β c) (β (rW i)))) := by
  induction k generalizing β with
  | zero =>
    rw [rkMask, runList_nil]
    congr 1
    rw [show (fun i ↦ rkBit neg (β c) (β (rW i))) = fun i ↦ β (rM i) from
      funext fun i ↦ i.elim0, writeReg_self]
  | succ k ih =>
    have hw0 : rW 0 ≠ rM 0 := hWM.ne 0 0
    have hc0w : c ≠ rW 0 := fun h ↦ hcW ⟨0, h.symm⟩
    have hc0m : c ≠ rM 0 := fun h ↦ hcM ⟨0, h.symm⟩
    have hT : rM 0 ∉ Set.range (regTail rM).wires := zero_not_mem_regTail rM
    have h0 := hclean 0
    have hfirst : runList (rkMaskBit neg c (rW 0) (rM 0)) β =
        some (update β (rM 0) (rkBit neg (β c) (β (rW 0)))) := by
      cases neg <;>
        simp [rkMaskBit, rkBit, runList_cons, Step.run, hw0, hc0w, hc0m, h0]
    obtain ⟨β1, hβ1⟩ : ∃ β1, β1 = update β (rM 0) (rkBit neg (β c) (β (rW 0))) := ⟨_, rfl⟩
    have hne : ∀ i : Fin k, rM i.succ ≠ rM 0 :=
      fun i h ↦ Fin.succ_ne_zero i (rM.wires.injective h)
    have hcl : ∀ i : Fin k, β1 (regTail rM i) = 0 := fun i ↦ by
      rw [hβ1, regTail_apply, update_of_ne (hne i)]
      exact hclean i.succ
    have h1 := ih (regTail rW) (regTail rM) ((hWM.compose_left _).compose_right _)
      (not_mem_regTail hcW) (not_mem_regTail hcM) β1 hcl
    rw [rkMask, runList_append, hfirst, ← hβ1, Option.bind_some, h1]
    congr 1
    have hγ : (fun i : Fin k ↦ rkBit neg (β1 c) (β1 (regTail rW i))) =
        fun i ↦ rkBit neg (β c) (β (rW i.succ)) := by
      funext i
      rw [hβ1, update_of_ne hc0m, regTail_apply, update_of_ne (hWM.ne i.succ 0)]
    rw [hγ, writeReg_succ β rM, hβ1, writeReg_update_of_not_mem _ _ _ hT]

theorem rkUnmask_run (neg : Bool) (k : ℕ) (c : Wire n) (rW rM : QRegister k n)
    (hWM : rW.DisjointWires rM) (hcW : c ∉ Set.range rW.wires) (hcM : c ∉ Set.range rM.wires)
    (β : BitAssignment n) (hm : ∀ i, β (rM i) = rkBit neg (β c) (β (rW i))) :
    runList (rkUnmask neg k c rW rM) β = some (writeReg β rM (fun _ ↦ 0)) := by
  induction k generalizing β with
  | zero =>
    rw [rkUnmask, runList_nil]
    congr 1
    rw [show (fun _ : Fin 0 ↦ (0 : ZMod 2)) = fun i ↦ β (rM i) from funext fun i ↦ i.elim0,
      writeReg_self]
  | succ k ih =>
    have hw0 : rW 0 ≠ rM 0 := hWM.ne 0 0
    have hc0w : c ≠ rW 0 := fun h ↦ hcW ⟨0, h.symm⟩
    have hc0m : c ≠ rM 0 := fun h ↦ hcM ⟨0, h.symm⟩
    have hT : rM 0 ∉ Set.range (regTail rM).wires := zero_not_mem_regTail rM
    have h0 := hm 0
    have hfirst : runList (rkUnmaskBit neg c (rW 0) (rM 0)) β = some (update β (rM 0) 0) := by
      cases neg <;> simp_all [rkUnmaskBit, rkBit, runList_cons, Step.run, add_add_self_zmod2]
    obtain ⟨β1, hβ1⟩ : ∃ β1, β1 = update β (rM 0) 0 := ⟨_, rfl⟩
    have hne : ∀ i : Fin k, rM i.succ ≠ rM 0 :=
      fun i h ↦ Fin.succ_ne_zero i (rM.wires.injective h)
    have hm1 : ∀ i : Fin k, β1 (regTail rM i) = rkBit neg (β1 c) (β1 (regTail rW i)) := fun i ↦ by
      rw [hβ1, regTail_apply, regTail_apply, update_of_ne (hne i), update_of_ne hc0m,
        update_of_ne (hWM.ne i.succ 0)]
      exact hm i.succ
    have h1 := ih (regTail rW) (regTail rM) ((hWM.compose_left _).compose_right _)
      (not_mem_regTail hcW) (not_mem_regTail hcM) β1 hm1
    rw [rkUnmask, runList_append, hfirst, ← hβ1, Option.bind_some, h1]
    congr 1
    rw [writeReg_succ β rM, hβ1, writeReg_update_of_not_mem _ _ _ hT]

theorem andCount_rkMask (neg : Bool) (k : ℕ) (c : Wire n) (rW rM : QRegister k n) :
    ((rkMask neg k c rW rM).map Step.andCount).sum = k := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [rkMask, List.map_append, List.sum_append, ih]
    cases neg <;> simp [rkMaskBit, Step.andCount] <;> omega

theorem andCount_rkUnmask (neg : Bool) (k : ℕ) (c : Wire n) (rW rM : QRegister k n) :
    ((rkUnmask neg k c rW rM).map Step.andCount).sum = 0 := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [rkUnmask, List.map_append, List.sum_append, ih]
    cases neg <;> simp [rkUnmaskBit, Step.andCount]

/-! ### The step list -/

/-- Register helpers for `b = K + 2`: word bits `1 .. K + 1`. -/
def rkWord {K : ℕ} (rT : QRegister (K + 2 + 1) n) : QRegister (K + 1) n :=
  rT.slice 1 (K + 1) (by omega)

/-- Mask: scratch wires `0 .. K`. -/
def rkMaskReg {K : ℕ} (rS : QRegister (2 * (K + 2)) n) : QRegister (K + 1) n :=
  rS.slice 0 (K + 1) (by omega)

/-- Ripple carries: scratch wires `K + 1 .. 2K`. -/
def rkCarry {K : ℕ} (rS : QRegister (2 * (K + 2)) n) : QRegister K n :=
  rS.slice (K + 1) K (by omega)

/-- Clean carry-in for the positive kick: scratch wire `2K + 1`. -/
def rkCiWire {K : ℕ} (rS : QRegister (2 * (K + 2)) n) : Wire n :=
  rS ⟨2 * K + 1, by omega⟩

/-- Carry-in wire: `t` for the negative kick, a clean scratch wire for the positive kick. -/
def rkCi {K : ℕ} (neg : Bool) (rT : QRegister (K + 2 + 1) n) (rS : QRegister (2 * (K + 2)) n) :
    Wire n :=
  if neg then rT 0 else rkCiWire rS

/-- The kick for `b = K + 2`: mask, ripple-add into catalyst bits `1 .. K + 1`, unmask. -/
def rkSteps (K : ℕ) (neg : Bool) (rT : QRegister (K + 2 + 1) n) (rS : QRegister (2 * (K + 2)) n)
    (rCat : QRegister (K + 2) n) : List (Step n) :=
  rkMask neg (K + 1) (rT 0) (rkWord rT) (rkMaskReg rS) ++
    rippleSteps K (rkMaskReg rS) (regTail rCat) (rkCi neg rT rS) (rkCarry rS) ++
    rkUnmask neg (K + 1) (rT 0) (rkWord rT) (rkMaskReg rS)

/-- The step list. Target `rT 0`, word `rT i.succ`, scratch `rS`, catalyst `rCat`. For `b < 2`
the list is empty (the theorems assume `2 ≤ b`). -/
def regKickSteps (b : ℕ) (neg : Bool) (rT : QRegister (b + 1) n) (rS : QRegister (2 * b) n)
    (rCat : QRegister b n) : List (Step n) :=
  match b, rT, rS, rCat with
  | 0, _, _, _ => []
  | 1, _, _, _ => []
  | K + 2, rT, rS, rCat => rkSteps K neg rT rS rCat

/-! ### Numerics -/

theorem rkZ2_cases (x : ZMod 2) : x = 0 ∨ x = 1 := by revert x; decide

theorem rkZ2_val_add_one (x : ZMod 2) : (x + 1).val + x.val = 1 := by revert x; decide

theorem rk_geom (m : ℕ) : ∑ i : Fin m, 2 ^ (i : ℕ) + 1 = 2 ^ m := by
  induction m with
  | zero => simp
  | succ m ih => rw [Fin.sum_univ_castSucc]; simp only [Fin.val_castSucc, Fin.val_last]; rw [pow_succ]; omega

/-- Value of a mask register. -/
theorem rk_mask_val (neg : Bool) (m : ℕ) (c : ZMod 2) (w : Fin m → ZMod 2) :
    ∑ i : Fin m, (rkBit neg c (w i)).val * 2 ^ (i : ℕ) =
      c.val * (if neg then 2 ^ m - 1 - ∑ i : Fin m, (w i).val * 2 ^ (i : ℕ)
        else ∑ i : Fin m, (w i).val * 2 ^ (i : ℕ)) := by
  rcases rkZ2_cases c with rfl | rfl
  · cases neg <;> simp [rkBit]
  · have h1 : (1 : ZMod 2).val = 1 := rfl
    cases neg
    · simp [rkBit, h1]
    · have hr : ∀ x : ZMod 2, rkBit true 1 x = x + 1 := fun x ↦ by simp [rkBit]
      simp only [hr, h1, one_mul, ite_true]
      have hsum : ∑ i : Fin m, (w i + 1).val * 2 ^ (i : ℕ) +
          ∑ i : Fin m, (w i).val * 2 ^ (i : ℕ) + 1 = 2 ^ m := by
        rw [← Finset.sum_add_distrib]
        have : ∀ i : Fin m, (w i + 1).val * 2 ^ (i : ℕ) + (w i).val * 2 ^ (i : ℕ) = 2 ^ (i : ℕ) :=
          fun i ↦ by rw [← add_mul, rkZ2_val_add_one, one_mul]
        simp only [this]
        exact rk_geom m
      omega

theorem rk_mod2 (P wl h : ℕ) (hwl : wl < P) (hh : h ≤ 1) :
    (2 * (wl + P * h)) % (2 * P) = 2 * wl := by
  rcases (by omega : h = 0 ∨ h = 1) with rfl | rfl
  · rw [Nat.mul_zero, Nat.add_zero]; exact Nat.mod_eq_of_lt (by omega)
  · have : 2 * (wl + P * 1) = 2 * wl + 2 * P := by ring
    rw [this, Nat.add_mod_right]; exact Nat.mod_eq_of_lt (by omega)

theorem rk_num (P u0 Cv wl h t A ci : ℕ) (neg : Bool) (hwl : wl < P) (hh : h ≤ 1) (ht : t ≤ 1)
    (hA : A = t * (if neg then P - 1 - wl else wl)) (hci : ci = if neg then t else 0) :
    (u0 + 2 * Cv + t * (if neg then 2 * P - (2 * (wl + P * h)) % (2 * P)
        else 2 * (wl + P * h))) % (2 * P) = (u0 + 2 * (A + Cv + ci)) % (2 * P) := by
  have hm := rk_mod2 P wl h hwl hh
  rcases (by omega : t = 0 ∨ t = 1) with rfl | rfl
  · subst hA hci; cases neg <;> simp
  · cases neg
    · simp only [Bool.false_eq_true, ite_false] at hA hci ⊢
      subst hA hci
      rcases (by omega : h = 0 ∨ h = 1) with rfl | rfl
      · congr 1; omega
      · have : u0 + 2 * Cv + 1 * (2 * (wl + P * 1)) = (u0 + 2 * (1 * wl + Cv + 0)) + 2 * P := by
          ring
        rw [this, Nat.add_mod_right]
    · simp only [ite_true] at hA hci ⊢
      subst hA hci
      rw [hm]
      congr 1
      omega

theorem rk_mod_split (P u0 S : ℕ) (hu : u0 ≤ 1) :
    (u0 + 2 * S) % (2 * P) = u0 + 2 * (S % P) := by
  rcases Nat.eq_zero_or_pos P with rfl | hP
  · simp
  · have h1 : u0 + 2 * S = u0 + 2 * (S % P) + 2 * P * (S / P) := by
      have := Nat.mod_add_div S P
      nlinarith
    rw [h1, Nat.add_mul_mod_self_left]
    exact Nat.mod_eq_of_lt (by have := Nat.mod_lt S hP; omega)

/-! ### Disjointness helpers -/

theorem rkDisj_slice {k m : ℕ} {r : QRegister k n} {s : QRegister m n} (h : r.DisjointWires s)
    (a b a' b' : ℕ) (ha : a + b ≤ k) (ha' : a' + b' ≤ m) :
    (r.slice a b ha).DisjointWires (s.slice a' b' ha') := by
  rw [QRegister.disjoint_iff] at h ⊢
  intro i j
  rw [QRegister.slice_apply, QRegister.slice_apply]
  exact h _ _

theorem rkDisj_slice_left {k m : ℕ} {r : QRegister k n} {s : QRegister m n}
    (h : r.DisjointWires s) (a b : ℕ) (ha : a + b ≤ k) : (r.slice a b ha).DisjointWires s := by
  rw [QRegister.disjoint_iff] at h ⊢
  intro i j
  rw [QRegister.slice_apply]
  exact h _ _

theorem rkDisj_regTail_right {k m : ℕ} {r : QRegister k n} {s : QRegister (m + 1) n}
    (h : r.DisjointWires s) : r.DisjointWires (regTail s) := by
  rw [QRegister.disjoint_iff] at h ⊢
  intro i j
  rw [regTail_apply]
  exact h _ _

/-- The word value in terms of the low `K + 1` word bits and the top word bit. -/
theorem rk_kickWord (K : ℕ) (rT : QRegister (K + 2 + 1) n) (β : BitAssignment n) :
    kickWord (K + 2) (localIdx rT β) = (localIdx (rkWord rT) β : ℕ) +
      2 ^ (K + 1) * (β (rT (Fin.last (K + 1)).succ)).val := by
  have hb : ∀ i, basisBits (K + 2 + 1) (localIdx rT β) i = β (rT i) := fun i ↦
    congrFun ((basisBits (K + 2 + 1)).apply_symm_apply _) i
  unfold kickWord
  simp only [hb]
  rw [Fin.sum_univ_castSucc, localIdx_val, mul_comm (2 ^ (K + 1))]
  congr 1
  · refine Finset.sum_congr rfl fun i _ ↦ ?_
    have : rT (Fin.castSucc i).succ = rkWord rT i :=
      congrArg rT (Fin.ext (by simp; omega))
    rw [this]
    simp

/-! ### The run lemma -/

theorem rkRun (K : ℕ) (neg : Bool) (rT : QRegister (K + 2 + 1) n)
    (rS : QRegister (2 * (K + 2)) n) (rCat : QRegister (K + 2) n)
    (hTC : rT.DisjointWires rCat) (hTS : rT.DisjointWires rS) (hsc : rS.DisjointWires rCat)
    (β : BitAssignment n) (hβ : ∀ i, β (rS i) = 0) :
    runList (rkSteps K neg rT rS rCat) β = some (writeReg β rCat (basisBits (K + 2)
      ⟨(localIdx rCat β + kickF (K + 2) neg (localIdx rT β)) % 2 ^ (K + 2),
        Nat.mod_lt _ (by positivity)⟩)) := by
  -- disjointness
  have hWM : (rkWord rT).DisjointWires (rkMaskReg rS) := rkDisj_slice hTS _ _ _ _ _ _
  have hWB : (rkWord rT).DisjointWires (regTail rCat) :=
    rkDisj_regTail_right (rkDisj_slice_left hTC _ _ _)
  have hMB : (rkMaskReg rS).DisjointWires (regTail rCat) :=
    rkDisj_regTail_right (rkDisj_slice_left hsc _ _ _)
  have hMC : (rkMaskReg rS).DisjointWires (rkCarry rS) :=
    QRegister.slice_disjoint_of_le rS 0 (K + 1) (K + 1) K (by omega) (by omega) (by omega)
  have hCB : (rkCarry rS).DisjointWires (regTail rCat) :=
    rkDisj_regTail_right (rkDisj_slice_left hsc _ _ _)
  have htW : rT 0 ∉ Set.range (rkWord rT).wires :=
    apply_not_mem_slice rT 0 1 (K + 1) (by omega) (Or.inl (by simp))
  have htM : rT 0 ∉ Set.range (rkMaskReg rS).wires :=
    not_mem_slice (not_mem_of_disjoint hTS 0) 0 (K + 1) (by omega)
  have htC : rT 0 ∉ Set.range (rkCarry rS).wires :=
    not_mem_slice (not_mem_of_disjoint hTS 0) (K + 1) K (by omega)
  have htB : rT 0 ∉ Set.range (regTail rCat).wires :=
    not_mem_regTail (not_mem_of_disjoint hTC 0)
  have hciM : rkCi neg rT rS ∉ Set.range (rkMaskReg rS).wires := by
    cases neg
    · exact apply_not_mem_slice rS ⟨2 * K + 1, by omega⟩ 0 (K + 1) (by omega)
        (Or.inr (by show 0 + (K + 1) ≤ 2 * K + 1; omega))
    · exact htM
  have hciC : rkCi neg rT rS ∉ Set.range (rkCarry rS).wires := by
    cases neg
    · exact apply_not_mem_slice rS ⟨2 * K + 1, by omega⟩ (K + 1) K (by omega)
        (Or.inr (by show K + 1 + K ≤ 2 * K + 1; omega))
    · exact htC
  have hciB : rkCi neg rT rS ∉ Set.range (regTail rCat).wires := by
    cases neg
    · exact not_mem_regTail (not_mem_of_disjoint hsc ⟨2 * K + 1, by omega⟩)
    · exact htB
  have hclM : ∀ i, β (rkMaskReg rS i) = 0 := fun i ↦ by
    rw [rkMaskReg, QRegister.slice_apply]; exact hβ _
  have hclC : ∀ i, β (rkCarry rS i) = 0 := fun i ↦ by
    rw [rkCarry, QRegister.slice_apply]; exact hβ _
  -- step 1: mask
  have h1 := rkMask_run neg (K + 1) (rT 0) (rkWord rT) (rkMaskReg rS) hWM htW htM β hclM
  obtain ⟨β1, hβ1⟩ : ∃ β1, β1 = writeReg β (rkMaskReg rS)
      (fun i ↦ rkBit neg (β (rT 0)) (β (rkWord rT i))) := ⟨_, rfl⟩
  have hclC1 : ∀ i, β1 (rkCarry rS i) = 0 := fun i ↦ by
    rw [hβ1, writeReg_apply_of_not_mem _ _ _ _
      (not_mem_of_disjoint (QRegister.disjoint_comm.mp hMC) i)]
    exact hclC i
  -- step 2: ripple add
  have hBC : (regTail rCat).DisjointWires (rkCarry rS) := QRegister.disjoint_comm.mp hCB
  have h2 := runList_rippleSteps K (rkMaskReg rS) (regTail rCat) (rkCi neg rT rS) (rkCarry rS)
    hMB hMC hBC hciM hciB hciC β1 hclC1
  obtain ⟨X, hX⟩ : ∃ X : BitAssignment (K + 1), X = basisBits (K + 1)
      ⟨((localIdx (rkMaskReg rS) β1 : ℕ) + (localIdx (regTail rCat) β1 : ℕ) +
        (β1 (rkCi neg rT rS)).val) % 2 ^ (K + 1), Nat.mod_lt _ (by positivity)⟩ := ⟨_, rfl⟩
  rw [← hX] at h2
  obtain ⟨β2, hβ2⟩ : ∃ β2, β2 = writeReg β1 (regTail rCat) X := ⟨_, rfl⟩
  have ht2 : β2 (rT 0) = β (rT 0) := by
    rw [hβ2, writeReg_apply_of_not_mem _ _ _ _ htB, hβ1, writeReg_apply_of_not_mem _ _ _ _ htM]
  have hw2 : ∀ i, β2 (rkWord rT i) = β (rkWord rT i) := fun i ↦ by
    rw [hβ2, writeReg_apply_of_not_mem _ _ _ _ (not_mem_of_disjoint hWB i), hβ1,
      writeReg_apply_of_not_mem _ _ _ _ (not_mem_of_disjoint hWM i)]
  have hm2 : ∀ i, β2 (rkMaskReg rS i) = rkBit neg (β2 (rT 0)) (β2 (rkWord rT i)) := fun i ↦ by
    rw [ht2, hw2 i, hβ2, writeReg_apply_of_not_mem _ _ _ _ (not_mem_of_disjoint hMB i), hβ1,
      writeReg_apply_reg]
  have h3 := rkUnmask_run neg (K + 1) (rT 0) (rkWord rT) (rkMaskReg rS) hWM htW htM β2 hm2
  rw [rkSteps, runList_append, runList_append, h1, ← hβ1, Option.bind_some, h2, ← hβ2,
    Option.bind_some, h3]
  have hzero : writeReg β (rkMaskReg rS) (fun _ ↦ (0 : ZMod 2)) = β := by
    rw [show (fun _ : Fin (K + 1) ↦ (0 : ZMod 2)) = fun i ↦ β (rkMaskReg rS i) from
      funext fun i ↦ (hclM i).symm, writeReg_self]
  have e1 : writeReg β2 (rkMaskReg rS) (fun _ ↦ (0 : ZMod 2)) = writeReg β (regTail rCat) X := by
    rw [hβ2, hβ1, writeReg_comm _ (regTail rCat) (rkMaskReg rS) (QRegister.disjoint_comm.mp hMB),
      writeReg_writeReg, hzero]
  rw [e1]
  congr 1
  have hsub := writeReg_eq_of_eqOn β (writeReg β (regTail rCat) X) rCat
    (fun w hw ↦ writeReg_apply_of_not_mem _ _ _ _ (fun ⟨i, h⟩ ↦
      hw ⟨i.succ, by rw [← h, regTail_apply]⟩))
  rw [← hsub]
  congr 1
  rw [show (fun i ↦ writeReg β (regTail rCat) X (rCat i)) =
    basisBits (K + 2) (localIdx rCat (writeReg β (regTail rCat) X)) from
    ((basisBits (K + 2)).apply_symm_apply _).symm]
  congr 1
  apply Fin.ext
  -- numerics
  have hpow : 2 ^ (K + 2) = 2 * 2 ^ (K + 1) := by ring
  have hu0 : (β (rCat 0)).val ≤ 1 := by have := ZMod.val_lt (β (rCat 0)); omega
  have hlocB : (localIdx (regTail rCat) β1 : ℕ) = localIdx (regTail rCat) β := by
    rw [hβ1, localIdx_writeReg_of_disjoint _ _ _ hMB]
  have hci1 : β1 (rkCi neg rT rS) = β (rkCi neg rT rS) := by
    rw [hβ1, writeReg_apply_of_not_mem _ _ _ _ hciM]
  have hA : (localIdx (rkMaskReg rS) β1 : ℕ) = (β (rT 0)).val *
      (if neg then 2 ^ (K + 1) - 1 - (localIdx (rkWord rT) β : ℕ)
        else (localIdx (rkWord rT) β : ℕ)) := by
    rw [localIdx_val (rkMaskReg rS) β1, localIdx_val (rkWord rT) β]
    simp only [hβ1, writeReg_apply_reg]
    exact rk_mask_val neg (K + 1) (β (rT 0)) (fun i ↦ β (rkWord rT i))
  have hciv : (β (rkCi neg rT rS)).val = if neg then (β (rT 0)).val else 0 := by
    cases neg
    · simp [rkCi, rkCiWire, hβ]
    · simp [rkCi]
  have hb : ∀ i, basisBits (K + 2 + 1) (localIdx rT β) i = β (rT i) := fun i ↦
    congrFun ((basisBits (K + 2 + 1)).apply_symm_apply _) i
  have hkick : kickF (K + 2) neg (localIdx rT β) = (β (rT 0)).val *
      (if neg then 2 * 2 ^ (K + 1) - (2 * ((localIdx (rkWord rT) β : ℕ) + 2 ^ (K + 1) *
          (β (rT (Fin.last (K + 1)).succ)).val)) % (2 * 2 ^ (K + 1))
        else 2 * ((localIdx (rkWord rT) β : ℕ) + 2 ^ (K + 1) *
          (β (rT (Fin.last (K + 1)).succ)).val)) := by
    unfold kickF
    rw [rk_kickWord, hb 0, hpow]
  have hnum := rk_num (2 ^ (K + 1)) (β (rCat 0)).val (localIdx (regTail rCat) β : ℕ)
    (localIdx (rkWord rT) β : ℕ) (β (rT (Fin.last (K + 1)).succ)).val (β (rT 0)).val
    (localIdx (rkMaskReg rS) β1 : ℕ) (β (rkCi neg rT rS)).val neg (localIdx (rkWord rT) β).isLt
    (by have := ZMod.val_lt (β (rT (Fin.last (K + 1)).succ)); omega)
    (by have := ZMod.val_lt (β (rT 0)); omega) hA hciv
  have hLval : (localIdx rCat (writeReg β (regTail rCat) X) : ℕ) = (β (rCat 0)).val +
      2 * (((localIdx (rkMaskReg rS) β1 : ℕ) + (localIdx (regTail rCat) β : ℕ) +
        (β (rkCi neg rT rS)).val) % 2 ^ (K + 1)) := by
    rw [localIdx_val_succ rCat, writeReg_apply_of_not_mem _ _ _ _ (zero_not_mem_regTail rCat),
      localIdx_writeReg, hX, Equiv.symm_apply_apply]
    simp only [hlocB, hci1]
  show (localIdx rCat (writeReg β (regTail rCat) X) : ℕ) =
    ((localIdx rCat β : ℕ) + kickF (K + 2) neg (localIdx rT β)) % 2 ^ (K + 2)
  rw [hLval, localIdx_val_succ rCat β, hkick, hpow, hnum, rk_mod_split _ _ _ hu0]

noncomputable def regKickProgram {Var : Type} (v : Var) (b : ℕ) (neg : Bool)
    (rT : QRegister (b + 1) n) (rS : QRegister (2 * b) n) (rCat : QRegister b n) :
    DynamicCircuit Var n :=
  compileList v (regKickSteps b neg rT rS rCat)

theorem regKick_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (b : ℕ)
    (hb : 2 ≤ b) (neg : Bool) (rT : QRegister (b + 1) n) (rS : QRegister (2 * b) n)
    (rCat : QRegister b n) (hsc : rS.DisjointWires rCat)
    (hdisj : rT.DisjointWires (rS.concat rCat hsc)) :
    CatKet rT rS rCat hsc (regKickProgram v b neg rT rS rCat).compile
      (phaseUnitary (b + 1) b (kickF b neg)) := by
  obtain ⟨K, rfl⟩ : ∃ K, b = K + 2 := ⟨b - 2, by omega⟩
  obtain ⟨hTC, hTS⟩ := disjoint_cat rT rS rCat hsc hdisj
  obtain ⟨R, hR, hk⟩ := catKet_kick_compileList v (regKickSteps (K + 2) neg rT rS rCat) rT rS rCat
    hsc hdisj (kickF (K + 2) neg) (fun β hβ ↦
      rkRun K neg rT rS rCat hTC hTS hsc β (eq_zero_of_localIdx_eq_zero rS β hβ))
  exact ⟨R, hR, hk⟩

theorem regKick_count {Var : Type} (v : Var) (b : ℕ) (neg : Bool) (rT : QRegister (b + 1) n)
    (rS : QRegister (2 * b) n) (rCat : QRegister b n) :
    (regKickProgram v b neg rT rS rCat).count PrimitiveGate.TOFF = 0 ∧
      (regKickProgram v b neg rT rS rCat).count PrimitiveGate.T ≤ 8 * b := by
  refine ⟨count_TOFF_compileList v _, ?_⟩
  refine (count_T_compileList v _).trans ?_
  match b, rT, rS, rCat with
  | 0, rT, rS, rCat => simp [regKickSteps]
  | 1, rT, rS, rCat => simp [regKickSteps]
  | K + 2, rT, rS, rCat =>
    have h : ((regKickSteps (K + 2) neg rT rS rCat).map Step.andCount).sum = 2 * K + 1 := by
      change ((rkSteps K neg rT rS rCat).map Step.andCount).sum = 2 * K + 1
      rw [rkSteps, List.map_append, List.map_append, List.sum_append, List.sum_append,
        andCount_rkMask, andCount_rippleSteps, andCount_rkUnmask]
      omega
    rw [h]
    omega

end QC14.RegKick


