    nRow thc a = orbitalNumberOp N (thc.chi μ) σ := by
  have h1 : ∀ h : a.val / 2 < M, (⟨a.val / 2, h⟩ : Fin M) = μ :=
    fun _ => Fin.ext (show a.val / 2 = μ.val by omega)
  have h2 : ∀ h : a.val % 2 < 2, (⟨a.val % 2, h⟩ : Fin 2) = σ :=
    fun _ => Fin.ext (show a.val % 2 = σ.val by omega)
  unfold nRow
  rw [h1, h2]

private lemma zeta2_eq {N M : ℕ} (thc : THCFactorization N M) (a b : Fin (2 * M))
    (μ ν : Fin M) (ha : a.val / 2 = μ.val) (hb : b.val / 2 = ν.val) :
    zeta2 thc a b = thc.zeta μ ν := by
  have h1 : ∀ h : a.val / 2 < M, (⟨a.val / 2, h⟩ : Fin M) = μ := fun _ => Fin.ext ha
  have h2 : ∀ h : b.val / 2 < M, (⟨b.val / 2, h⟩ : Fin M) = ν := fun _ => Fin.ext hb
  unfold zeta2
  rw [h1, h2]

private lemma nRow_equiv {N M : ℕ} (thc : THCFactorization N M) (μ : Fin M) (σ : Fin 2) :
    nRow thc (rowEquiv M (μ, σ)) = orbitalNumberOp N (thc.chi μ) σ :=
  nRow_eq thc _ μ σ (rowEquiv_val M μ σ)

private lemma zeta2_equiv {N M : ℕ} (thc : THCFactorization N M) (μ ν : Fin M) (σ τ : Fin 2) :
    zeta2 thc (rowEquiv M (μ, σ)) (rowEquiv M (ν, τ)) = thc.zeta μ ν :=
  zeta2_eq thc _ _ μ ν (by rw [rowEquiv_val]; omega) (by rw [rowEquiv_val]; omega)

