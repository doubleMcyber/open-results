    (srL rS) (srHN1 N bI beth)
  obtain ⟨b1, b2⟩ := lkMbuProg_count v (srP N bI beth) ((bI - 1) / 2) (Nat.div_le_self _ _)
    (srTab beth bI k s) (QC14.AliasCircuitM.amReg (srW hbI rTI rS rCat hsc hdisj)) (srL rS)
    (srHN2 N bI beth)
  have a1' : (srLoad v beth hbI k s rTI rS rCat hsc hdisj).count PrimitiveGate.TOFF = 0 := a1
  have a2' : (srLoad v beth hbI k s rTI rS rCat hsc hdisj).count PrimitiveGate.T ≤
      mbl2T (bI - 1) (N * beth + 2) 0 ((bI - 1) / 2) := a2
  have b1' : (srUnload v beth hbI k s rTI rS rCat hsc hdisj).count PrimitiveGate.TOFF = 0 := b1
  have b2' : (srUnload v beth hbI k s rTI rS rCat hsc hdisj).count PrimitiveGate.T ≤
      ssT (bI - 1) 1 ((bI - 1) / 2) := b2
  obtain ⟨w1, w2⟩ := sqCswP_count hbI rTI (srQ rS) rCat (srHsc hsc) (srHdisj hdisj) N le_rfl
  obtain ⟨c1, c2⟩ := regCascadeS_count v beth (rTI.compose (sqSys0 N bI))
    (sqWords (sqRX (srQ rS))) (sqTA rTI (srQ rS) rCat (srHsc hsc) (srHdisj hdisj)) (sqRK (srQ rS))
    rCat (N - 1) (by omega)
  obtain ⟨d1, d2⟩ := regCascadeInvS_count v beth (rTI.compose (sqSys0 N bI))
    (sqWords (sqRX (srQ rS))) (sqTA rTI (srQ rS) rCat (srHsc hsc) (srHdisj hdisj)) (sqRK (srQ rS))
    rCat (N - 1) (by omega)
  obtain ⟨p1, p2, z1, z2, g1, g2⟩ := sqClifford_count hbI rTI (srQ rS)
  simp only [selectR, dif_pos hN, sqMid, DynamicCircuit.count, sqCsw]
  unfold selLkT
  refine ⟨by omega, ?_⟩
  have e : 16 * (N - 1) * (beth - 1) = 8 * (N - 1) * (beth - 1) + 8 * (N - 1) * (beth - 1) := by
    ring
  omega

