        mul_le_mul_of_nonneg_left (norm_selectPauliString_le _) (abs_nonneg _)
    _ = |a r| := mul_one _

open QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.OrbitalBridge in
open scoped Matrix.Norms.L2Operator in
theorem norm_sector_le {N : ℕ} (η : ℕ) (A : Matrix (Fin (2 ^ (2 * N))) (Fin (2 ^ (2 * N))) ℂ) :
    ‖electronSectorProjector (2 * N) η * A * electronSectorProjector (2 * N) η‖ ≤ ‖A‖ := by
  set P := electronSectorProjector (2 * N) η with hP
  have h1 : ‖P‖ * ‖P‖ = ‖P‖ := by
    have e := CStarRing.norm_star_mul_self (x := P)
    rw [Matrix.star_eq_conjTranspose, hP, electronSectorProjector_conjTranspose,
      electronSectorProjector_mul_self] at e
    exact e.symm
  have hn := norm_nonneg P
  have h2 : ‖P‖ ≤ 1 := by nlinarith
  have h3 : ‖P‖ * ‖P‖ ≤ 1 := by nlinarith
  calc ‖P * A * P‖ ≤ ‖P * A‖ * ‖P‖ := norm_mul_le _ _
    _ ≤ ‖P‖ * ‖A‖ * ‖P‖ := by gcongr; exact norm_mul_le _ _
    _ = ‖A‖ * (‖P‖ * ‖P‖) := by ring
    _ ≤ ‖A‖ * 1 := mul_le_mul_of_nonneg_left h3 (norm_nonneg _)
    _ = ‖A‖ := mul_one _

