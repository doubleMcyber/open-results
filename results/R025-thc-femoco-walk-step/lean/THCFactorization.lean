variable {n : ℕ}

/-- A Kraus ket fact on clean scratch is a `CatKet` (the catalyst is untouched). -/
theorem lkCatKet_of_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] {k m b : ℕ}
    (rT : QRegister k n) (rS : QRegister m n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) {P : QProg Var (2 ^ n)}
    {R : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ} (U : Unitary (2 ^ k))
    (hP : ArcsinImpl.LowerKraus P R)
    (h : ∀ β, localIdx rS β = 0 → R *ᵥ ket β = (rT.embedUnitary U).1 *ᵥ ket β) :
    CatKet rT rS rCat hsc P U := by
  refine ⟨R, hP, fun β hβ ↦ ?_⟩
  have h0 := (localIdx_concat_zero rS rCat hsc β hβ).1
  have hCS := QRegister.disjoint_comm.mp hsc
  unfold catalystKet
  rw [Matrix.mulVec_sum, Matrix.mulVec_sum]
  refine Finset.sum_congr rfl fun y _ ↦ ?_
  rw [Matrix.mulVec_smul, Matrix.mulVec_smul,
    h (writeReg β rCat (basisBits b y))
      (by rw [localIdx_writeReg_of_disjoint β rCat rS hCS]; exact h0)]

/-- `Mbl2Impl.mbl2Prog` over any variable type (measurement variable `v`). -/
noncomputable def lkMbl2Prog {Var : Type} (v : Var) (p : LookupParams) (s s2 : ℕ) (hs : s ≤ p.m)
    (hs2 : s2 ≤ p.m) (data : LookupTable p) (rData : QRegister (p.m + p.w) n) {N : ℕ}
    (rAnc : QRegister N n)
    (hN : 2 ^ s * p.w + (p.m - s) + 1 + (2 ^ s2 * 1 + (p.m - s2) + 1) ≤ N) :
    DynamicCircuit Var n :=
  .seq (TableLookupSteps.compileList v (mbl2Stage1 p s hs (fTab data) rData
      (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
      (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩)))
    (lkMbuTree v (fun i ↦ rAnc.slice 0 (2 ^ s * p.w) (by omega) i)
      (lkMbl2Leaf v p s s2 hs hs2 data rData rAnc hN) (List.finRange (2 ^ s * p.w)) (fun _ ↦ 0))

theorem lkMbl2Prog_eq (p : LookupParams) (s s2 : ℕ) (hs : s ≤ p.m) (hs2 : s2 ≤ p.m)
    (data : LookupTable p) (rData : QRegister (p.m + p.w) n) {N : ℕ} (rAnc : QRegister N n)
    (hN : 2 ^ s * p.w + (p.m - s) + 1 + (2 ^ s2 * 1 + (p.m - s2) + 1) ≤ N) :
    lkMbl2Prog (TableLookup.Var.v 0) p s s2 hs hs2 data rData rAnc hN =
      mbl2Prog p s s2 hs hs2 data rData rAnc hN := by
  simp only [lkMbl2Prog, mbl2Prog, lkMbl2Leaf, mbl2Leaf, lkLeafCirc, MbuImpl.leafCirc,
    lkMbuTree_eq] <;> rfl

/-- The select-swap lookup XORs `data.extend x` into the target on every clean basis ket. -/
theorem lkMbl2Prog_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var)
    (p : LookupParams) (s s2 : ℕ) (hs : s ≤ p.m) (hs2 : s2 ≤ p.m) (data : LookupTable p)
    (rData : QRegister (p.m + p.w) n) {N : ℕ} (rAnc : QRegister N n)
    (hN : 2 ^ s * p.w + (p.m - s) + 1 + (2 ^ s2 * 1 + (p.m - s2) + 1) ≤ N)
    (hd : rData.DisjointWires rAnc) :
    ∃ R : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ,
      ArcsinImpl.LowerKraus (lkMbl2Prog v p s s2 hs hs2 data rData rAnc hN).compile R ∧
      ∀ β, localIdx rAnc β = 0 →
        R *ᵥ ket β = ket (writeReg β rData
          (basisBits (p.m + p.w) (tableXorPerm data.extend (localIdx rData β)))) := by
  change ∃ R : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ,
    TableLookupSteps.LowerKraus (lkMbl2Prog v p s s2 hs hs2 data rData rAnc hN).compile R ∧
    ∀ β, TableLookupSteps.localIdx rAnc β = 0 →
      R *ᵥ TableLookupSteps.ket β = TableLookupSteps.ket (TableLookupSteps.writeReg β rData
        (basisBits (p.m + p.w) (tableXorPerm data.extend (TableLookupSteps.localIdx rData β))))
  have hDA : ∀ {a b : ℕ} (r : QRegister a (p.m + p.w)) (r' : QRegister b N),
      (rAnc.compose r').DisjointWires (rData.compose r) := fun _ _ ↦
    QRegister.disjoint_comm.mp ((hd.compose_left _).compose_right _)
  have hXA : ∀ {a b : ℕ} (r : QRegister a p.m) (r' : QRegister b N),
      (rAnc.compose r').DisjointWires ((rData.slice p.w p.m (by omega)).compose r) :=
    fun r r' ↦ QRegister.disjoint_comm.mp
      (((hd.compose_left (QRegister.block p.w p.m (by omega))).compose_left r).compose_right r')
  have hx : ∀ γ : BitAssignment n, (TableLookupSteps.localIdx (TableLookupImpl.addrReg p rData) γ : ℕ) =
      (TableLookupSteps.localIdx (rData.slice p.w s (by omega)) γ : ℕ) +
        2 ^ s * (TableLookupSteps.localIdx (rData.slice (p.w + s) (p.m - s) (by omega)) γ : ℕ) := fun γ ↦ by
    rw [TableLookupSteps.localIdx_val_split (TableLookupImpl.addrReg p rData) s (p.m - s) (by omega)]
    simp only [TableLookupSteps.localIdx_slice_slice, add_zero]
  have hxh : ∀ γ : BitAssignment n,
      (TableLookupSteps.localIdx ((rData.slice p.w p.m (by omega)).slice 0 s2 (by omega)) γ : ℕ) +
        2 ^ s2 * (TableLookupSteps.localIdx ((rData.slice p.w p.m (by omega)).slice s2
          (p.m - s2) (by omega)) γ : ℕ) =
        (TableLookupSteps.localIdx (rData.slice p.w p.m (by omega)) γ : ℕ) := fun γ ↦
    (TableLookupSteps.localIdx_val_split (rData.slice p.w p.m (by omega)) s2 (p.m - s2)
      (by omega) γ).symm
  have hDl : (rAnc.slice 0 (2 ^ s * p.w) (by omega)).DisjointWires
      (rData.slice p.w s (by omega)) := hDA _ _
  have hDh : (rAnc.slice 0 (2 ^ s * p.w) (by omega)).DisjointWires
      (rData.slice (p.w + s) (p.m - s) (by omega)) := hDA _ _
  obtain ⟨R1, hK1, hR1, -⟩ := TableLookupSteps.exists_lowerKraus_compileList v (mbl2Stage1 p s hs (fTab data)
    rData (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
    (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩))
  obtain ⟨R2, hK2, hR2⟩ := lkMbuTree_kraus v (fun i ↦ rAnc.slice 0 (2 ^ s * p.w) (by omega) i)
    (lkMbl2Leaf v p s s2 hs hs2 data rData rAnc hN)
    (fun i γ ↦ swTab s p.w (fTab data) (TableLookupSteps.localIdx (rData.slice p.w s (by omega)) γ : ℕ)
      (TableLookupSteps.localIdx (rData.slice (p.w + s) (p.m - s) (by omega)) γ : ℕ) i)
    (fun γ ↦ ∀ k : Fin N, 2 ^ s * p.w + (p.m - s) + 1 ≤ k.val → γ (rAnc k) = 0)
    (fun i j h ↦ (rAnc.slice 0 (2 ^ s * p.w) (by omega)).wires.injective h)
    (fun γ i a h k hk ↦ by
      rw [Function.update_of_ne]
      · exact h k hk
      · intro e
        have := rAnc.wires.injective e
        have h2 : 0 + (i : ℕ) = (k : ℕ) := (congrArg Fin.val this).symm
        have h3 := i.isLt
        omega)
    (fun γ i j a ↦ by
      simp only [TableLookupSteps.localIdx_update_of_not_mem _ γ (TableLookupSteps.not_mem_of_disjoint hDl i) a,
        TableLookupSteps.localIdx_update_of_not_mem _ γ (TableLookupSteps.not_mem_of_disjoint hDh i) a])
    (fun r ↦ by
      obtain ⟨L, hL, hLk⟩ := lkLeafCirc_kraus v p.m s2 (gTab2 p s (fTab data) r)
        ((rData.slice p.w p.m (by omega)).slice 0 s2 (by omega))
        ((rData.slice p.w p.m (by omega)).slice s2 (p.m - s2) (by omega))
        (rAnc.slice (2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1) (p.m - s2) (by omega))
        (rAnc.slice (2 ^ s * p.w + (p.m - s) + 1) (2 ^ s2 * 1) (by omega))
        (rAnc ⟨2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1 + (p.m - s2), by omega⟩)
        (hXA _ _) (hXA _ _)
        (QRegister.slice_disjoint_of_le rAnc _ _ _ _ (by omega) (by omega) (by omega))
        (QRegister.disjoint_comm.mp (hXA _ _))
        (TableLookupSteps.apply_not_mem_slice rAnc _ (2 ^ s * p.w + (p.m - s) + 1) _ (by omega) (Or.inr (by simp)))
        (fun ⟨i, h⟩ ↦ ((hd.compose_left (QRegister.block p.w p.m (by omega))).compose_left
          (QRegister.block 0 s2 (by omega))).ne i _ h)
      refine ⟨L, hL, fun γ hγ ↦ ?_⟩
      have hD0 : ∀ i : Fin (2 ^ s2 * 1), γ (rAnc.slice (2 ^ s * p.w + (p.m - s) + 1)
          (2 ^ s2 * 1) (by omega) i) = 0 := fun i ↦ by
        have := i.isLt
        exact hγ ⟨2 ^ s * p.w + (p.m - s) + 1 + i, by omega⟩ (Nat.le_add_right _ _)
      have hW0 : ∀ i : Fin (p.m - s2), γ (rAnc.slice (2 ^ s * p.w + (p.m - s) + 1 +
          2 ^ s2 * 1) (p.m - s2) (by omega) i) = 0 := fun i ↦ by
        have := i.isLt
        exact hγ ⟨2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1 + i, by omega⟩
          (by change _ ≤ 2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1 + (i : ℕ); omega)
      have hc0 : γ (rAnc ⟨2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1 + (p.m - s2),
          by omega⟩) = 0 :=
        hγ _ (by change _ ≤ 2 ^ s * p.w + (p.m - s) + 1 + 2 ^ s2 * 1 + (p.m - s2); omega)
      rw [hLk γ hD0 hW0 hc0, hxh γ, gTab2_bit]
      have hx' : (TableLookupSteps.localIdx (rData.slice p.w p.m (by omega)) γ : ℕ) =
          (TableLookupSteps.localIdx (rData.slice p.w s (by omega)) γ : ℕ) +
            2 ^ s * (TableLookupSteps.localIdx (rData.slice (p.w + s) (p.m - s) (by omega)) γ : ℕ) := hx γ
      obtain ⟨hm, hdv⟩ := split_mod_div _ (TableLookupSteps.localIdx (rData.slice (p.w + s) (p.m - s)
        (by omega)) γ : ℕ) s (TableLookupSteps.localIdx (rData.slice p.w s (by omega)) γ).isLt
      rw [hx', hm, hdv])
    (List.finRange (2 ^ s * p.w)) (List.nodup_finRange _) (fun _ ↦ 0)
  refine ⟨R2 * R1, hK1.qSeq hK2, fun β h0 ↦ ?_⟩ -- CHECK
  have hclean := TableLookupSteps.eq_zero_of_localIdx_eq_zero rAnc β h0
  have hD0 : ∀ i, β (rAnc.slice 0 (2 ^ s * p.w) (by omega) i) = 0 := fun _ ↦ hclean _
  have hW0 : ∀ i, β (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega) i) = 0 := fun _ ↦ hclean _
  have hlYs : (rData.slice p.w s (by omega)).DisjointWires (rData.slice 0 p.w (by omega)) :=
    QRegister.disjoint_comm.mp
      (QRegister.slice_disjoint_of_le rData _ _ _ _ (by omega) (by omega) (by omega))
  have hhYs : (rData.slice (p.w + s) (p.m - s) (by omega)).DisjointWires
      (rData.slice 0 p.w (by omega)) :=
    QRegister.disjoint_comm.mp
      (QRegister.slice_disjoint_of_le rData _ _ _ _ (by omega) (by omega) (by omega))
  obtain ⟨β1, hrun, hfr, hY, hDc⟩ := runList_mbl2Stage1 p s hs (fTab data) rData
    (rAnc.slice 0 (2 ^ s * p.w) (by omega))
    (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega)) (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩)
    hDl hDh
    (QRegister.slice_disjoint_of_le rAnc _ _ _ _ (by omega) (by omega) (by omega)) (hDA _ _)
    hlYs
    (QRegister.disjoint_comm.mp (hDA _ _))
    (TableLookupSteps.apply_not_mem_slice rAnc _ 0 _ (by omega) (Or.inr (by simp)))
    (fun ⟨_, h⟩ ↦ hd.ne _ _ h)
    β hD0 hW0 (hclean _)
  set rD := rAnc.slice 0 (2 ^ s * p.w) (by omega) with hrD
  set rXl := rData.slice p.w s (by omega) with hrXl
  set rXh := rData.slice (p.w + s) (p.m - s) (by omega) with hrXh
  set rY := rData.slice 0 p.w (by omega) with hrY
  have hDY : rD.DisjointWires rY := hDA _ _
  have hYA : rY.DisjointWires rAnc := hd.compose_left _
  have hG : ∀ k : Fin N, 2 ^ s * p.w + (p.m - s) + 1 ≤ k.val → β1 (rAnc k) = 0 := by
    intro k hk
    rw [hfr _ (TableLookupSteps.apply_not_mem_slice rAnc k 0 _ (by omega) (Or.inr (by omega)))
      (fun ⟨i, h⟩ ↦ hYA.ne i k h)]
    exact hclean k
  have hloc : ∀ {a : ℕ} (r : QRegister a n), (∀ i, r i ∉ Set.range rD.wires) →
      (∀ i, r i ∉ Set.range rY.wires) →
      TableLookupSteps.localIdx r β1 = TableLookupSteps.localIdx r β := fun r h1 h2 ↦ by
    simp only [TableLookupSteps.localIdx]
    congr 1
    funext i
    exact hfr _ (h1 i) (h2 i)
  have hl1 : TableLookupSteps.localIdx rXl β1 = TableLookupSteps.localIdx rXl β :=
    hloc _ (fun i ↦ TableLookupSteps.not_mem_of_disjoint (QRegister.disjoint_comm.mp hDl) i)
      (fun i ↦ TableLookupSteps.not_mem_of_disjoint hlYs i)
  have hl2 : TableLookupSteps.localIdx rXh β1 = TableLookupSteps.localIdx rXh β :=
    hloc _ (fun i ↦ TableLookupSteps.not_mem_of_disjoint (QRegister.disjoint_comm.mp hDh) i)
      (fun i ↦ TableLookupSteps.not_mem_of_disjoint hhYs i)
  have hcond : ∀ i ∈ List.finRange (2 ^ s * p.w),
      β1 (rD i) = swTab s p.w (fTab data) (TableLookupSteps.localIdx rXl β1 : ℕ)
        (TableLookupSteps.localIdx rXh β1 : ℕ) i := by
    intro i _
    rw [hl1, hl2]
    exact hDc i
  rw [← Matrix.mulVec_mulVec, hR1 _ _ hrun, hR2 _ hG, if_pos hcond]
  simp only [zero_mul, Finset.sum_const_zero, TableLookupSteps.bitSign, if_true, one_smul]
  rw [MblImpl.zeroL_finRange', ← target_xor_eq data rData β]
  congr 1
  funext q
  by_cases hvD : q ∈ Set.range rD.wires
  · obtain ⟨i, rfl⟩ := hvD
    rw [TableLookupSteps.writeReg_apply_reg,
      TableLookupSteps.writeReg_apply_of_not_mem _ _ _ _ (TableLookupSteps.not_mem_of_disjoint hDY i), hD0 i]
  · by_cases hvY : q ∈ Set.range rY.wires
    · obtain ⟨i, rfl⟩ := hvY
      rw [TableLookupSteps.writeReg_apply_of_not_mem _ _ _ _
          (TableLookupSteps.not_mem_of_disjoint (QRegister.disjoint_comm.mp hDY) i),
        hY i, TableLookupSteps.writeReg_apply_reg, ← hx β]
      exact congrArg (β (rY i) + ·)
        (congrFun (hbits data _ (TableLookupSteps.localIdx (TableLookupImpl.addrReg p rData) β).isLt) i)
    · rw [TableLookupSteps.writeReg_apply_of_not_mem _ _ _ _ hvD,
        TableLookupSteps.writeReg_apply_of_not_mem _ _ _ _ hvY,
        hfr q hvD hvY]

theorem lkMbl2Prog_count {Var : Type} (v : Var) (p : LookupParams) (s s2 : ℕ) (hs : s ≤ p.m)
    (hs2 : s2 ≤ p.m) (data : LookupTable p) (rData : QRegister (p.m + p.w) n) {N : ℕ}
    (rAnc : QRegister N n)
    (hN : 2 ^ s * p.w + (p.m - s) + 1 + (2 ^ s2 * 1 + (p.m - s2) + 1) ≤ N) :
    (lkMbl2Prog v p s s2 hs hs2 data rData rAnc hN).count PrimitiveGate.TOFF = 0 ∧
      (lkMbl2Prog v p s s2 hs hs2 data rData rAnc hN).count PrimitiveGate.T ≤
        mbl2T p.m p.w s s2 := by
  constructor
  · have h3 := lkMbuTree_count v (fun i ↦ rAnc.slice 0 (2 ^ s * p.w) (by omega) i)
        (lkMbl2Leaf v p s s2 hs hs2 data rData rAnc hN) PrimitiveGate.TOFF 0
        (fun q ↦ by simp) (fun q ↦ by simp)
        (fun r ↦ (lkLeafCirc_count_TOFF v _ _ _ _ _ _ _ _).le) (List.finRange (2 ^ s * p.w))
        (fun _ ↦ 0)
    have h1 := TableLookupSteps.count_TOFF_compileList v (mbl2Stage1 p s hs (fTab data) rData
        (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
        (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩))
    unfold lkMbl2Prog
    simp only [DynamicCircuit.count]
    omega
  · unfold mbl2T
    have h1 := TableLookupSteps.count_T_compileList v (mbl2Stage1 p s hs (fTab data) rData
        (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
        (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩))
    have h2 := mbl2Stage1_ac p s hs (fTab data) rData
        (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
        (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩)
    have h3 : (lkMbuTree v (fun i ↦ rAnc.slice 0 (2 ^ s * p.w) (by omega) i)
        (lkMbl2Leaf v p s s2 hs hs2 data rData rAnc hN) (List.finRange (2 ^ s * p.w))
        (fun _ ↦ 0)).count PrimitiveGate.T ≤ ssT p.m 1 s2 :=
      lkMbuTree_count v _ _ _ _ (fun q ↦ by simp) (fun q ↦ by simp)
        (fun r ↦ lkLeafCirc_count_T v _ _ hs2 _ _ _ _ _ _) _ _
    have e : ((mbl2Stage1 p s hs (fTab data) rData
        (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
        (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩)).map TableLookupSteps.Step.andCount).sum =
        ac (mbl2Stage1 p s hs (fTab data) rData
        (rAnc.slice 0 (2 ^ s * p.w) (by omega)) (rAnc.slice (2 ^ s * p.w) (p.m - s) (by omega))
        (rAnc ⟨2 ^ s * p.w + (p.m - s), by omega⟩)) := rfl
    rw [e] at h1
    have h4 : 4 * (2 ^ s - 1) * p.w + 4 * p.w = 4 * (2 ^ s * p.w) := by
      obtain ⟨k, hk⟩ : ∃ k, 2 ^ s = k + 1 := ⟨2 ^ s - 1, by have := @Nat.one_le_two_pow s; omega⟩
      rw [hk, Nat.add_sub_cancel]
      ring
    unfold lkMbl2Prog
    simp only [DynamicCircuit.count]
    omega

/-- `MbuImpl.mbuProg` over any variable type (measurement variable `v`). -/
noncomputable def lkMbuProg {Var : Type} (v : Var) (p : LookupParams) (s : ℕ) (hs : s ≤ p.m)
    (data : LookupTable p) (rData : QRegister (p.m + p.w) n) {N : ℕ} (rAnc : QRegister N n)
    (hN : 2 ^ s * 1 + (p.m - s) + 1 ≤ N) : DynamicCircuit Var n :=
  lkMbuTree v (fun i ↦ TableLookupImpl.targetReg p rData i)
    (fun r ↦ lkLeafCirc v p.m s (MbuImpl.maskTab p data r) (rData.slice p.w s (by omega))
      (rData.slice (p.w + s) (p.m - s) (by omega))
      (rAnc.slice (2 ^ s * 1) (p.m - s) (by omega)) (rAnc.slice 0 (2 ^ s * 1) (by omega))
      (rAnc ⟨2 ^ s * 1 + (p.m - s), by omega⟩))
    (List.finRange p.w) (fun _ ↦ 0)

theorem lkMbuProg_eq (p : LookupParams) (s : ℕ) (hs : s ≤ p.m) (data : LookupTable p)
    (rData : QRegister (p.m + p.w) n) {N : ℕ} (rAnc : QRegister N n)
    (hN : 2 ^ s * 1 + (p.m - s) + 1 ≤ N) :
    lkMbuProg (TableLookup.Var.v 0) p s hs data rData rAnc hN =
      MbuImpl.mbuProg p s hs data rData rAnc hN := by
  simp only [lkMbuProg, MbuImpl.mbuProg, lkLeafCirc, MbuImpl.leafCirc, lkMbuTree_eq] <;> rfl

/-- The measured unlookup clears the target on every clean basis ket whose target holds the table
value (`unlookupValidInputs`). -/
theorem lkMbuProg_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var)
    (p : LookupParams) (s : ℕ) (hs : s ≤ p.m) (data : LookupTable p)
    (rData : QRegister (p.m + p.w) n) {N : ℕ} (rAnc : QRegister N n)
    (hN : 2 ^ s * 1 + (p.m - s) + 1 ≤ N) (hd : rData.DisjointWires rAnc) :
    ∃ R : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ,
      ArcsinImpl.LowerKraus (lkMbuProg v p s hs data rData rAnc hN).compile R ∧
      ∀ β, localIdx rAnc β = 0 → localIdx rData β ∈ unlookupValidInputs data →
        R *ᵥ ket β = ket (writeReg β rData
          (basisBits (p.m + p.w) (tableXorPerm data.extend (localIdx rData β)))) := by
  change ∃ R : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ,
    TableLookupSteps.LowerKraus (lkMbuProg v p s hs data rData rAnc hN).compile R ∧
    ∀ β, TableLookupSteps.localIdx rAnc β = 0 →
      TableLookupSteps.localIdx rData β ∈ unlookupValidInputs data →
      R *ᵥ TableLookupSteps.ket β = TableLookupSteps.ket (TableLookupSteps.writeReg β rData
        (basisBits (p.m + p.w) (tableXorPerm data.extend (TableLookupSteps.localIdx rData β))))
  have hDA : ∀ {a b : ℕ} (r : QRegister a (p.m + p.w)) (r' : QRegister b N),
      (rAnc.compose r').DisjointWires (rData.compose r) := fun _ _ ↦
    QRegister.disjoint_comm.mp ((hd.compose_left _).compose_right _)
  have hTA : (TableLookupImpl.targetReg p rData).DisjointWires rAnc := hd.compose_left _
  have hYX : (TableLookupImpl.targetReg p rData).DisjointWires (TableLookupImpl.addrReg p rData) :=
    rData.slice_disjoint_of_le 0 p.w p.w p.m _ _ (by omega)
  have hx : ∀ γ : BitAssignment n, (TableLookupSteps.localIdx (TableLookupImpl.addrReg p rData) γ : ℕ) =
      (TableLookupSteps.localIdx (rData.slice p.w s (by omega)) γ : ℕ) +
        2 ^ s * (TableLookupSteps.localIdx (rData.slice (p.w + s) (p.m - s) (by omega)) γ : ℕ) := fun γ ↦ by
    rw [TableLookupSteps.localIdx_val_split (TableLookupImpl.addrReg p rData) s (p.m - s) (by omega)]
    simp only [TableLookupSteps.localIdx_slice_slice, add_zero]
  obtain ⟨R, hK, hR⟩ := lkMbuTree_kraus v (fun i ↦ TableLookupImpl.targetReg p rData i)
    (fun r ↦ lkLeafCirc v p.m s (MbuImpl.maskTab p data r) (rData.slice p.w s (by omega))
      (rData.slice (p.w + s) (p.m - s) (by omega))
      (rAnc.slice (2 ^ s * 1) (p.m - s) (by omega)) (rAnc.slice 0 (2 ^ s * 1) (by omega))
      (rAnc ⟨2 ^ s * 1 + (p.m - s), by omega⟩))
    (fun i γ ↦ TableLookupImpl.lookupWords data (TableLookupSteps.localIdx (TableLookupImpl.addrReg p rData) γ) i)
    (fun γ ↦ TableLookupSteps.localIdx rAnc γ = 0)
    (fun i j h ↦ (TableLookupImpl.targetReg p rData).wires.injective h)
    (fun γ i a h ↦ by
      rw [TableLookupSteps.localIdx_update_of_not_mem rAnc γ (TableLookupSteps.not_mem_of_disjoint hTA i) a]
      exact h)
    (fun γ i j a ↦ by
      simp only [TableLookupSteps.localIdx_update_of_not_mem (TableLookupImpl.addrReg p rData) γ
        (TableLookupSteps.not_mem_of_disjoint hYX i) a])
    (fun r ↦ by
      obtain ⟨L, hL, hLk⟩ := lkLeafCirc_kraus v p.m s (MbuImpl.maskTab p data r)
        (rData.slice p.w s (by omega)) (rData.slice (p.w + s) (p.m - s) (by omega))
        (rAnc.slice (2 ^ s * 1) (p.m - s) (by omega)) (rAnc.slice 0 (2 ^ s * 1) (by omega))
        (rAnc ⟨2 ^ s * 1 + (p.m - s), by omega⟩)
        (hDA _ _) (hDA _ _)
        (QRegister.slice_disjoint_of_le rAnc _ _ _ _ (by omega) (by omega) (by omega))
        (QRegister.disjoint_comm.mp (hDA _ _))
        (TableLookupSteps.apply_not_mem_slice rAnc _ 0 _ (by omega) (Or.inr (by simp)))
        (fun ⟨_, h⟩ ↦ hd.ne _ _ h)
      refine ⟨L, hL, fun γ hγ ↦ ?_⟩
      have hcl := TableLookupSteps.eq_zero_of_localIdx_eq_zero rAnc γ hγ
      rw [hLk γ (fun _ ↦ hcl _) (fun _ ↦ hcl _) (hcl _), ← hx γ, MbuImpl.maskTab_bit])
    (List.finRange p.w) (List.nodup_finRange _) (fun _ ↦ 0)
  refine ⟨R, hK, fun β h0 hmem ↦ ?_⟩ -- CHECK
  rw [hR β h0, if_pos (fun i _ ↦ MbuImpl.target_eq_of_valid data rData β hmem i)]
  simp only [zero_mul, Finset.sum_const_zero, TableLookupSteps.bitSign, if_true, one_smul]
  rw [MbuImpl.zeroL_finRange, ← target_xor_eq data rData β]
  congr 2
  funext i
  rw [MbuImpl.target_eq_of_valid data rData β hmem i, CharTwo.add_self_eq_zero]

theorem lkMbuProg_count {Var : Type} (v : Var) (p : LookupParams) (s : ℕ) (hs : s ≤ p.m)
    (data : LookupTable p) (rData : QRegister (p.m + p.w) n) {N : ℕ} (rAnc : QRegister N n)
    (hN : 2 ^ s * 1 + (p.m - s) + 1 ≤ N) :
    (lkMbuProg v p s hs data rData rAnc hN).count PrimitiveGate.TOFF = 0 ∧
      (lkMbuProg v p s hs data rData rAnc hN).count PrimitiveGate.T ≤ ssT p.m 1 s := by
  constructor
  · have := lkMbuTree_count v (fun i ↦ TableLookupImpl.targetReg p rData i)
      (fun r ↦ lkLeafCirc v p.m s (MbuImpl.maskTab p data r) (rData.slice p.w s (by omega))
        (rData.slice (p.w + s) (p.m - s) (by omega))
        (rAnc.slice (2 ^ s * 1) (p.m - s) (by omega)) (rAnc.slice 0 (2 ^ s * 1) (by omega))
        (rAnc ⟨2 ^ s * 1 + (p.m - s), by omega⟩)) PrimitiveGate.TOFF 0
      (fun q ↦ by simp) (fun q ↦ by simp)
      (fun r ↦ (lkLeafCirc_count_TOFF v _ _ _ _ _ _ _ _).le) (List.finRange p.w) (fun _ ↦ 0)
    exact Nat.le_zero.mp this
  · unfold lkMbuProg
    exact lkMbuTree_count v _ _ _ _ (fun q ↦ by simp) (fun q ↦ by simp)
      (fun r ↦ lkLeafCirc_count_T v _ _ hs _ _ _ _ _ _) _ _

end QC14.LookupKraus


/-! Inlined from lane module `THC/AliasCircuitM.lean`. -/

namespace QC14.AliasCircuitM

open QuantumComputation QuantumComputation.Specs Matrix Finset Operator
open QuantumComputation.Specs.ArcsinImpl
open QuantumComputation.Specs.SelectSwapImpl QuantumComputation.Specs.Mbl2Impl
open QC14 (blkA prepU aliasF)
open QC14.AliasCircuit QC14.LookupKraus
open scoped Matrix

variable {n : ℕ}

/-- Select-swap split for a `w`-bit word over `2^m` addresses (`2^k ≈ √(2^m / w)`). -/
def lkSplit (m w : ℕ) : ℕ := (m - Nat.log 2 w) / 2

/-- `T` of the measured alias PREPARE: load, unload, two comparators, `b` Toffolis. -/
def aliasTM (b g s : ℕ) : ℕ :=
  mbl2T s (b + (b + (g - s))) (lkSplit s (b + (b + (g - s)))) (s / 2) + ssT s 1 (s / 2) +
    (32 * (g - s + 1) + 16 * b)

/-- Work register shared by the load and the measured unload. -/
def amWork (s w : ℕ) : ℕ :=
  let k := lkSplit s w
  2 ^ k * w + (s - k) + 1 + (2 ^ (s / 2) * 1 + (s - s / 2) + 1)

theorem amUnloadWork_le (s w₁ : ℕ) :
    2 ^ (s / 2) * 1 + (s - s / 2) + 1 ≤ amWork s w₁ :=
  Nat.le_add_left _ (2 ^ (lkSplit s w₁) * w₁ + (s - lkSplit s w₁) + 1)

abbrev amParams (s w : ℕ) : LookupParams := ⟨2 ^ s, s, w⟩

noncomputable def amTable {s w : ℕ} (tab : Fin (2 ^ s) → BitAssignment w) :
    LookupTable (amParams s w) := fun x ↦ (basisBits w).symm (tab x)

abbrev amWord (b g s : ℕ) := b + (b + (g - s))

/-- Scratch wires of the measured alias PREPARE (worker-defined). -/
def aliasAncM (b g s : ℕ) : ℕ :=
  aliasAnc b g s + amWork s (amWord b g s)

/-- The measured PREPARE needs at least the scratch of `aliasPrepC`. -/
theorem aliasAnc_le_M (b g s : ℕ) : aliasAnc b g s ≤ aliasAncM b g s := by
  exact Nat.le_add_right _ _

abbrev amBase {b g s : ℕ} (a : QRegister (aliasAncM b g s) n) :=
  a.slice 0 (aliasAnc b g s) (by simpa using aliasAnc_le_M b g s)

abbrev amScratch {b g s : ℕ} (a : QRegister (aliasAncM b g s) n) :=
  a.slice (aliasAnc b g s) (amWork s (amWord b g s)) le_rfl

/-- Low target and high address, even when either register is empty. -/
def amReg {s w : ℕ} (W : SelectPauliImpl.Wires s w n) : QRegister (s + w) n where
  wires := ⟨fun i ↦ if h : i.val < w then W.sw ⟨i.val, h⟩ else W.xw ⟨i.val - w, by omega⟩,
    by
      intro i j hij
      by_cases hi : i.val < w <;> by_cases hj : j.val < w <;>
        simp only [hi, hj, ↓reduceDIte] at hij -- CHECK
      · exact Fin.ext (congrArg (fun a : Fin w ↦ a.val) (W.sw_inj hij))
      · exact (W.sx _ _ hij).elim
      · exact (W.sx _ _ hij.symm).elim
      · have h := congrArg Fin.val (W.xw_inj hij)
        dsimp only at h
        apply Fin.ext
        omega⟩

def amMiddle {N b g s : ℕ} (hs : s ≤ g) (pos : ℕ → Wire n)
    (hi : ∀ p q, p < Lay.tot N b g → q < Lay.tot N b g → pos p = pos q → p = q) :
    Circuit n :=
  .seq (Lay.cmpW hs pos hi).cmp
    (.seq ((Lay.tofW hs pos hi).chain b) (Lay.cmpW hs pos hi).cmp)

noncomputable def amLoad {Var : Type} (v : Var) {s w : ℕ} (W : SelectPauliImpl.Wires s w n)
    (tab : Fin (2 ^ s) → BitAssignment w) (a : QRegister (amWork s w) n) : DynamicCircuit Var n :=
  lkMbl2Prog v (amParams s w) (lkSplit s w) (s / 2) (by change lkSplit s w ≤ s; unfold lkSplit; omega)
    (by change s / 2 ≤ s; omega) (amTable tab) (amReg W) a le_rfl

noncomputable def amUnload {Var : Type} (v : Var) {s w w₁ : ℕ} (W : SelectPauliImpl.Wires s w n)
    (tab : Fin (2 ^ s) → BitAssignment w) (a : QRegister (amWork s w₁) n) : DynamicCircuit Var n :=
  lkMbuProg v (amParams s w) (s / 2) (by change s / 2 ≤ s; omega) (amTable tab) (amReg W) a
    (amUnloadWork_le s w₁)

noncomputable def amCore {Var : Type} (v : Var) {N b g s : ℕ} (hs : s ≤ g) (pos : ℕ → Wire n)
    (hi : ∀ p q, p < Lay.tot N b g → q < Lay.tot N b g → pos p = pos q → p = q)
    (ind alt : Fin (2 ^ s) → Fin (2 ^ b)) (K : Fin (2 ^ s) → ℕ)
    (a : QRegister (amWork s (amWord b g s)) n) : DynamicCircuit Var n :=
  .seq (amLoad v (Lay.W1 hs pos hi) (Lay.tt1 (g := g) ind alt K) a)
    (.seq (.circuit (amMiddle hs pos hi))
      (amUnload v (Lay.W2 hs pos hi) (Lay.tt2 (g := g) ind alt K) a))

def amH {N b g : ℕ} (d : QRegister (N + (b + g)) n) : Circuit n :=
  (PrepareImpl.hPre b g g le_rfl).onRegister (d.slice N (b + g) le_rfl)

/-- The measured alias PREPARE (worker-defined; see the module docstring). -/
noncomputable def aliasPrepM {Var : Type} (v : Var) {N b g s : ℕ} (hs : s ≤ g)
    (ind alt : Fin (2 ^ s) → Fin (2 ^ b)) (K : Fin (2 ^ s) → ℕ)
    (rData : QRegister (N + (b + g)) n) (rAnc : QRegister (aliasAncM b g s) n)
    (hd : ∀ i j, rData i ≠ rAnc j) : DynamicCircuit Var n :=
  .seq (.circuit (amH rData)) (amCore v hs (posOf rData (amBase rAnc))
    (posOf_inj rData (amBase rAnc) (fun _ _ ↦ hd _ _)) ind alt K (amScratch rAnc))

/-- The measured inverse alias PREPARE (worker-defined; see the module docstring). -/
noncomputable def aliasPrepMinv {Var : Type} (v : Var) {N b g s : ℕ} (hs : s ≤ g)
    (ind alt : Fin (2 ^ s) → Fin (2 ^ b)) (K : Fin (2 ^ s) → ℕ)
    (rData : QRegister (N + (b + g)) n) (rAnc : QRegister (aliasAncM b g s) n)
    (hd : ∀ i j, rData i ≠ rAnc j) : DynamicCircuit Var n :=
  .seq (amCore v hs (posOf rData (amBase rAnc))
    (posOf_inj rData (amBase rAnc) (fun _ _ ↦ hd _ _)) ind alt K (amScratch rAnc)) (.circuit (amH rData))

section LookupBits

variable {s w : ℕ} (W : SelectPauliImpl.Wires s w n) (tab : Fin (2 ^ s) → BitAssignment w)

theorem amTarget (i : Fin w) :
    TableLookupImpl.targetReg (amParams s w) (amReg W) i = W.sw i := by
  change (if h : 0 + i.val < w then W.sw ⟨0 + i.val, h⟩
    else W.xw ⟨0 + i.val - w, by omega⟩) = W.sw i
  rw [dif_pos (by omega : 0 + i.val < w)] <;>
    exact congrArg W.sw (Fin.ext (Nat.zero_add i.val))

theorem amAddress (i : Fin s) :
    TableLookupImpl.addrReg (amParams s w) (amReg W) i = W.xw i := by
  change (if h : w + i.val < w then W.sw ⟨w + i.val, h⟩
    else W.xw ⟨w + i.val - w, by omega⟩) = W.xw i
  rw [dif_neg (by omega : ¬ w + i.val < w)] <;>
    exact congrArg W.xw (Fin.ext (Nat.add_sub_cancel_left w i.val))

noncomputable def amRow (β : BitAssignment n) := (basisBits s).symm (fun i ↦ β (W.xw i))

theorem amAddrRow (β : BitAssignment n) :
    TableLookupSteps.localIdx (TableLookupImpl.addrReg (amParams s w) (amReg W)) β = amRow W β := by
  unfold TableLookupSteps.localIdx amRow
  exact congrArg (basisBits s).symm (funext (fun i ↦ congrArg β (amAddress W i)))

noncomputable def amFlip (β : BitAssignment n) : BitAssignment n :=
  β + W.sysAdd (xrow (tab (amRow W β)))

theorem amRow_flip (β : BitAssignment n) : amRow W (amFlip W tab β) = amRow W β := by
  unfold amRow
  apply congrArg (basisBits s).symm
  funext i
  change β (W.xw i) + _ = _
  rw [W.sysAdd_sx, add_zero]

theorem amFlip_flip (β : BitAssignment n) : amFlip W tab (amFlip W tab β) = β := by
  change (β + W.sysAdd (xrow (tab (amRow W β)))) +
    W.sysAdd (xrow (tab (amRow W (amFlip W tab β)))) = β
  rw [amRow_flip]
  funext q
  simp only [Pi.add_apply]
  exact (by decide : ∀ a c : ZMod 2, a + c + c = a) _ _

theorem amExtend (x : Fin (2 ^ s)) :
    (amTable tab).extend x = (basisBits w).symm (tab x) := by
  change (if h : x.val < 2 ^ s then (basisBits w).symm (tab ⟨x.val, h⟩) else 0) = _
  rw [dif_pos x.isLt]

theorem amWords (x : Fin (2 ^ s)) :
    TableLookupImpl.lookupWords (amTable tab) x.val = tab x := by
  change (if h : x.val < 2 ^ s then basisBits w ((amTable tab).extend ⟨x.val, h⟩)
    else 0) = tab x
  rw [dif_pos x.isLt]
  exact (congrArg (basisBits w) (amExtend tab x)).trans ((basisBits w).apply_symm_apply (tab x))

/-- The packed lookup and the unary circuit use the same bit update. -/
theorem amWrite (β : BitAssignment n) :
    TableLookupSteps.writeReg β (amReg W) (basisBits (s + w)
      (tableXorPerm (amTable tab).extend (localIdx (amReg W) β))) = amFlip W tab β := by
  -- CHECK conversion from the table library's localIdx to the Arcsin index.
  refine (SelectSwapImpl.target_xor_eq (p := amParams s w) (amTable tab) (amReg W) β).symm.trans ?_
  let r : QRegister w n := TableLookupImpl.targetReg (amParams s w) (amReg W)
  change TableLookupSteps.writeReg β r (fun i ↦ β (r i) + TableLookupImpl.lookupWords (amTable tab)
    (TableLookupSteps.localIdx (TableLookupImpl.addrReg (amParams s w) (amReg W)) β).val i) = amFlip W tab β
  rw [amAddrRow W β, amWords tab (amRow W β)]
  funext q
  by_cases h : q ∈ Set.range r.wires
  · obtain ⟨i, rfl⟩ := h
    rw [TableLookupSteps.writeReg_apply_reg]
    change β (r i) + tab (amRow W β) i =
      β (r i) + W.sysAdd (xrow (tab (amRow W β))) (r i)
    rw [show r i = W.sw i from amTarget W i, lookup_sysAdd_sw]
  · rw [TableLookupSteps.writeReg_apply_of_not_mem _ _ _ _ h]
    change β q = β q + W.sysAdd _ q
    have hneq (i : Fin w) : q ≠ W.sw i := fun e ↦ h ⟨i, (amTarget W i).trans e.symm⟩
    rw [W.sysAdd_other _ _ hneq, add_zero]

theorem amUnary (β : BitAssignment n) (h : ∀ j, β (W.aw j) = 0) :
    (QC14.UnaryLookup.ulookup W tab).eval.1 *ᵥ ket β = ket (amFlip W tab β) := by
  refine ulookup_sys_ket W tab (amRow W β) β h ?_
  intro i
  have hx := basisBits_eq_div_mod s (amRow W β) i
  simpa only [SelectPauliImpl.bitsZ, amRow, Equiv.apply_symm_apply] using hx

/-- Flipping a zero target loads the full table value required by measured unlookup. -/
theorem amValid (γ : BitAssignment n) (hz : ∀ i, γ (W.sw i) = 0) :
    localIdx (amReg W) (amFlip W tab γ) ∈ unlookupValidInputs (amTable tab) := by
  let δ := amFlip W tab γ
  let X : Fin (2 ^ s) := TableLookupSteps.localIdx (TableLookupImpl.addrReg (amParams s w) (amReg W)) δ
  let Y : Fin (2 ^ w) := TableLookupSteps.localIdx (TableLookupImpl.targetReg (amParams s w) (amReg W)) δ
  have hv : (localIdx (amReg W) δ).val = Y.val + 2 ^ w * X.val :=
    TableLookupSteps.localIdx_val_split (amReg W) w s (Nat.add_comm w s) δ
  have hpacked : localIdx (amReg W) δ = (splitBasisEquiv s w).symm (X, Y) :=
    Fin.ext (hv.trans (TableLookupImpl.splitBasisEquiv_symm_val s w X Y).symm)
  constructor
  · exact (splitBasisEquiv s w (localIdx (amReg W) δ)).1.isLt
  · change (splitBasisEquiv s w (localIdx (amReg W) δ)).2 =
      (amTable tab).extend ((splitBasisEquiv s w (localIdx (amReg W) δ)).1)
    rw [hpacked, Equiv.apply_symm_apply] -- CHECK both projections use the same packed index.
    change Y = (amTable tab).extend X
    refine Eq.trans ?_ (amExtend tab X).symm
    have hx : X = amRow W γ := (amAddrRow W δ).trans (amRow_flip W tab γ)
    rw [hx]
    change (basisBits w).symm (fun i ↦ δ (TableLookupImpl.targetReg (amParams s w) (amReg W) i)) =
      (basisBits w).symm (tab (amRow W γ))
    apply congrArg (basisBits w).symm
    funext i
    change δ (TableLookupImpl.targetReg (amParams s w) (amReg W) i) = _
    rw [amTarget]
    change γ (W.sw i) + W.sysAdd _ (W.sw i) = _
    rw [hz, zero_add, lookup_sysAdd_sw]

end LookupBits

theorem amReg_disjoint {s w k : ℕ} (W : SelectPauliImpl.Wires s w n) (a : QRegister k n)
    (ht : ∀ i j, W.sw i ≠ a j) (hx : ∀ i j, W.xw i ≠ a j) : (amReg W).DisjointWires a := by
  apply QRegister.disjoint_iff.2
  intro i j
  change (if h : i.val < w then W.sw ⟨i.val, h⟩ else W.xw ⟨i.val - w, by omega⟩) ≠ a j
  split_ifs <;> first | exact ht _ _ | exact hx _ _

theorem amLoad_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) {s w : ℕ}
    (W : SelectPauliImpl.Wires s w n) (tab : Fin (2 ^ s) → BitAssignment w)
    (a : QRegister (amWork s w) n) (hd : (amReg W).DisjointWires a) :
    ∃ R, LowerKraus (amLoad v W tab a).compile R ∧
      ∀ β, localIdx a β = 0 → R *ᵥ ket β = ket (amFlip W tab β) := by
  obtain ⟨R, hR, h⟩ := lkMbl2Prog_kraus v (amParams s w) (lkSplit s w) (s / 2)
    (by change lkSplit s w ≤ s; unfold lkSplit; omega) (by change s / 2 ≤ s; omega)
    (amTable tab) (amReg W) a le_rfl hd
  exact ⟨R, hR, fun β hz ↦ (h β hz).trans (congrArg ket (amWrite W tab β))⟩

theorem amUnload_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) {s w w₁ : ℕ}
    (W : SelectPauliImpl.Wires s w n) (tab : Fin (2 ^ s) → BitAssignment w)
    (a : QRegister (amWork s w₁) n) (hd : (amReg W).DisjointWires a) :
    ∃ R, LowerKraus (amUnload v W tab a).compile R ∧
      ∀ γ, localIdx a γ = 0 → (∀ i, γ (W.sw i) = 0) →
        R *ᵥ ket (amFlip W tab γ) = ket γ := by
  obtain ⟨R, hR, h⟩ := lkMbuProg_kraus v (amParams s w) (s / 2) (by change s / 2 ≤ s; omega)
    (amTable tab) (amReg W) a (amUnloadWork_le s w₁) hd
  refine ⟨R, hR, ?_⟩ -- CHECK the previous run stopped before the witness's ket proof.
  intro γ hz ht
  have hc : localIdx a (amFlip W tab γ) = 0 := by
    apply (QC14.localIdx_eq_zero_iff _ _).2
    intro j
    change γ (a j) + W.sysAdd _ (a j) = 0
    have htDisj : (TableLookupImpl.targetReg (amParams s w) (amReg W)).DisjointWires a :=
      hd.compose_left _
    have hneq (i : Fin w) : a j ≠ W.sw i :=
      fun e ↦ htDisj.ne i j ((amTarget W i).trans e.symm)
    rw [W.sysAdd_other _ _ hneq, add_zero]
    exact (QC14.localIdx_eq_zero_iff a γ).1 hz j
  exact (h _ hc (amValid W tab γ ht)).trans
    (congrArg ket ((amWrite W tab _).trans (amFlip_flip W tab γ)))

section Placement

variable {N b g s : ℕ}
variable (d : QRegister (N + (b + g)) n) (a : QRegister (aliasAncM b g s) n)
variable (hd : ∀ i j, d i ≠ a j)

include hd in
theorem amPos_work {p : ℕ} (hp : p < Lay.tot N b g) (j : Fin (amWork s (amWord b g s))) :
    posOf d (amBase a) p ≠ amScratch a j := by
  by_cases h : p < N + (b + g)
  · rw [posOf_data d (amBase a) h]
    exact hd _ _
  · rw [posOf_anc d (amBase a) (by omega) hp]
    exact QRegister.disjoint_iff.1
      (a.slice_disjoint_of_le 0 (aliasAnc b g s) (aliasAnc b g s) (amWork s (amWord b g s))
        (by simpa using aliasAnc_le_M b g s) le_rfl (by omega)) _ j

theorem amPos_clean (β : BitAssignment n) (hz : localIdx a β = 0) {p : ℕ}
    (hp : N + (b + g) ≤ p) (hl : p < Lay.tot N b g) : β (posOf d (amBase a) p) = 0 := by
  rw [posOf_anc d (amBase a) hp hl]
  exact (QC14.localIdx_eq_zero_iff _ _).1 hz _

/-- The old unitary core has a basis output with every wire of the enlarged scratch clean. -/
theorem amEndpoint (hs : s ≤ g) (ind alt : Fin (2 ^ s) → Fin (2 ^ b)) (K : Fin (2 ^ s) → ℕ)
    (hK : ∀ x, K x < 2 ^ (g - s)) (β : BitAssignment n) (h0 : localIdx a β = 0) :
    ∃ γ, (Lay.core hs (posOf d (amBase a)) (posOf_inj d (amBase a) (fun _ _ ↦ hd _ _))
      ind alt K).eval.1 *ᵥ ket β = ket γ ∧ localIdx a γ = 0 := by
  classical
  let pos := posOf d (amBase a)
  let σ := (basisBits g).symm (fun i : Fin g ↦ β (pos (Lay.pSl N b i.val)))
  have hσ (i : ℕ) (hi : i < g) : β (pos (Lay.pSl N b i)) = bitN σ.val i := by
    have e := basisBits_eq_div_mod g σ ⟨i, hi⟩
    simpa only [σ, Equiv.apply_symm_apply, bitN] using e
  have he := Lay.core_ket hs pos (posOf_inj d (amBase a) (fun _ _ ↦ hd _ _))
    ind alt K hK β σ (fun p hp hl ↦ amPos_clean d a β h0 hp hl) hσ
  refine ⟨_, he, (QC14.localIdx_eq_zero_iff _ _).2 ?_⟩
  intro j
  rw [Pi.add_apply, (QC14.localIdx_eq_zero_iff _ _).1 h0 j, zero_add, Finset.sum_apply] -- CHECK
  apply Finset.sum_eq_zero
  intro q _
  have hneq : a j ≠ pos (Lay.pIdx N q.val) := by
    dsimp only [pos]
    rw [posOf_data d (amBase a) (by unfold Lay.pIdx; omega)]
    exact (hd _ _).symm
  rw [Pi.single_apply, if_neg hneq]

end Placement

theorem amCore_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) {N b g s : ℕ}
    (hs : s ≤ g) (ind alt : Fin (2 ^ s) → Fin (2 ^ b)) (K : Fin (2 ^ s) → ℕ)
    (hK : ∀ x, K x < 2 ^ (g - s)) (d : QRegister (N + (b + g)) n)
    (a : QRegister (aliasAncM b g s) n) (hd : ∀ i j, d i ≠ a j) :
    ∃ R, LowerKraus (amCore v hs (posOf d (amBase a)) (posOf_inj d (amBase a) (fun _ _ ↦ hd _ _))
      ind alt K (amScratch a)).compile R ∧ ∀ β, localIdx a β = 0 →
      R *ᵥ ket β = ((d.slice N (b + g) le_rfl).embedUnitary
        (selectPauliUnitary g b (2 ^ g) (PrepareImpl.tblOf b g (aliasF ind alt K)))).1 *ᵥ ket β := by
  let pos := posOf d (amBase a)
  have hi := posOf_inj d (amBase a) (fun _ _ ↦ hd _ _)
  let W₁ := Lay.W1 hs pos hi
  let W₂ := Lay.W2 hs pos hi
  let t₁ := Lay.tt1 (g := g) ind alt K
  let t₂ := Lay.tt2 (g := g) ind alt K
  let mid := amMiddle hs pos hi
  have hslot (i : Fin s) (j : Fin (amWork s (amWord b g s))) : pos (Lay.pSl N b i.val) ≠ amScratch a j :=
    amPos_work d a hd (by unfold Lay.pSl Lay.tot; omega) j
  have hd₁ : (amReg W₁).DisjointWires (amScratch a) := amReg_disjoint W₁ _
    (fun i j ↦ amPos_work d a hd (Lay.t1_lt hs i.isLt) j) hslot
  have hd₂ : (amReg W₂).DisjointWires (amScratch a) := amReg_disjoint W₂ _
    (fun i j ↦ amPos_work d a hd (Lay.t2_lt hs i.isLt) j) hslot
  obtain ⟨L, hL, hLk⟩ := amLoad_kraus v W₁ t₁ (amScratch a) hd₁
  obtain ⟨U, hU, hUk⟩ := amUnload_kraus v W₂ t₂ (amScratch a) hd₂
  refine ⟨_, hL.qSeq ((lowerKraus_circuit (Var := Var) mid).qSeq hU), ?_⟩
  intro β hβ
  obtain ⟨γ, hγ, hzγ⟩ := amEndpoint d a hd hs ind alt K hK β hβ
  have scratch (z : BitAssignment n) (hz : localIdx a z = 0) : localIdx (amScratch a) z = 0 :=
    QC14.localIdx_slice_zero a _ _ _ z hz
  have cleanChain (z : BitAssignment n) (hz : localIdx a z = 0) (j : Fin (s + 1)) :
      z (pos (Lay.pCh N b g j.val)) = 0 :=
    amPos_clean d a z hz (by unfold Lay.pCh; omega) (by unfold Lay.pCh Lay.tot; omega)
  have ht₂ (i : Fin (b + (g - s))) : γ (W₂.sw i) = 0 := by
    apply amPos_clean d a γ hzγ (p := Lay.t2 N b g s i.val)
    · unfold Lay.t2; split_ifs <;> simp only [Lay.pD, Lay.pK] <;> omega
    · exact Lay.t2_lt hs i.isLt
  let δ := amFlip W₂ t₂ γ
  have hδ (j : Fin (s + 1)) : δ (W₂.aw j) = 0 := by
    change γ (W₂.aw j) + W₂.sysAdd _ (W₂.aw j) = 0
    rw [W₂.sysAdd_sa, add_zero]
    exact cleanChain γ hzγ j
  have hlast : (QC14.UnaryLookup.ulookup W₂ t₂).eval.1 *ᵥ ket δ = ket γ :=
    (amUnary W₂ t₂ δ hδ).trans (congrArg ket (amFlip_flip W₂ t₂ γ))
  have hfirst := amUnary W₁ t₁ β (cleanChain β hβ)
  let last := QC14.UnaryLookup.ulookup W₂ t₂
  have hseq : last.eval.1 *ᵥ (mid.eval.1 *ᵥ ket (amFlip W₁ t₁ β)) = ket γ := by
    rw [← hfirst]
    simpa only [Lay.core, last, mid, amMiddle, seq_mulVec, W₁, W₂, t₁, t₂, pos] using hγ -- CHECK
  have hmid : mid.eval.1 *ᵥ ket (amFlip W₁ t₁ β) = ket δ := by
    have e := congrArg (fun z : Fin (2 ^ n) → ℂ ↦ last.inverse.eval.1 *ᵥ z) (hseq.trans hlast.symm)
    exact (SelectPauliImpl.inv_mulVec last _).symm.trans (e.trans (SelectPauliImpl.inv_mulVec last _))
  have ecore := core_eq_sel hs ind alt K hK d (amBase a) (fun _ _ ↦ hd _ _) β
    (QC14.localIdx_slice_zero a _ _ _ β hβ)
  rw [← ecore, hγ, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hLk β (scratch β hβ), hmid]
  exact hUk γ (scratch γ hzγ) ht₂

/-- Compose two clean-register matrix identities, including nonunitary Kraus witnesses. -/
theorem amChainKet {k t : ℕ} (r : QRegister t n) (a : QRegister k n) (hd : r.DisjointWires a)
    (X Y : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ) (U V : Unitary (2 ^ t))
    (hx : ∀ β, localIdx a β = 0 → X *ᵥ ket β = (r.embedUnitary U).1 *ᵥ ket β)
    (hy : ∀ β, localIdx a β = 0 → Y *ᵥ ket β = (r.embedUnitary V).1 *ᵥ ket β)
    (β : BitAssignment n) (hβ : localIdx a β = 0) :
    (Y * X) *ᵥ ket β = (r.embedUnitary (V * U)).1 *ᵥ ket β := by
  refine QC14.PairProgram.ket_of_clean_mul a _ _ ?_ β hβ
  rw [QRegister.embedUnitary_mul]
  exact QC14.chain_clean (QC14.clean_ext a _ _ hx) (QC14.clean_ext a _ _ hy)
    (CleanSubroutineBridge.embed_comm_proj r a hd U).symm

/-- On every basis ket with clean scratch, a Kraus bound of the measured PREPARE acts as the
embedded `prepU` (compare `aliasPrepC_ket`). -/
theorem aliasPrepM_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) {N b g s : ℕ}
    (hs : s ≤ g) (ind alt : Fin (2 ^ s) → Fin (2 ^ b)) (K : Fin (2 ^ s) → ℕ)
    (hK : ∀ x, K x < 2 ^ (g - s)) (rData : QRegister (N + (b + g)) n)
    (rAnc : QRegister (aliasAncM b g s) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    ∃ R : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ,
      LowerKraus (aliasPrepM v hs ind alt K rData rAnc hd).compile R ∧
      ∀ β, localIdx rAnc β = 0 →
        R *ᵥ ket β =
          (rData.embedUnitary ((blkA N b g).embedUnitary (prepU b g (aliasF ind alt K)))).1 *ᵥ
            ket β := by
  let r := rData.slice N (b + g) le_rfl
  let S := selectPauliUnitary g b (2 ^ g) (PrepareImpl.tblOf b g (aliasF ind alt K))
  let H := (PrepareImpl.hPre b g g le_rfl).eval
  obtain ⟨C, hC, hk⟩ := amCore_kraus v hs ind alt K hK rData rAnc hd
  refine ⟨_, (lowerKraus_circuit (Var := Var) (amH rData)).qSeq hC, ?_⟩
  intro β h0
  rw [← QRegister.embedUnitary_compose]
  have he : (amH rData).eval = r.embedUnitary H := Circuit.eval_onRegister _ _
  exact amChainKet r rAnc (QRegister.disjoint_iff.2 (fun _ _ ↦ hd _ _)) _ C H S
    (fun γ _ ↦ congrArg (fun V : Unitary (2 ^ n) ↦ V.1 *ᵥ ket γ) he) hk β h0

/-- Reversing the order of the distinct garbage Hadamards gives the same layer. -/
theorem amHStar (b g : ℕ) : star (PrepareImpl.hPre b g g le_rfl).eval =
    (PrepareImpl.hPre b g g le_rfl).eval := by
  let w (i : Fin g) : Wire (b + g) := ⟨b + i.val, by omega⟩
  unfold PrepareImpl.hPre
  simp only [Circuit.eval_sequence, List.map_ofFn]
  refine (QC14.list_prod_selfAdjoint _ ?_ ?_).star_eq -- CHECK
  · rw [List.pairwise_reverse, List.pairwise_ofFn]
    intro i j hij
    have hne : w j ≠ w i := by
      intro e
      have eqv := congrArg Fin.val e
      change b + j.val = b + i.val at eqv
      exact (ne_of_lt hij) (Fin.ext (by omega))
    apply Subtype.ext
    exact QRegister.embedMatrix_comm_of_disjoint _ _ (QRegister.singleton_disjoint hne) _ _
  · intro x hx
    obtain ⟨i, rfl⟩ := List.mem_ofFn.1 (List.mem_reverse.1 hx)
    change star (Circuit.H (w i)).eval = (Circuit.H (w i)).eval
    rw [Unitary.star_eq_inv, ← Circuit.eval_inverse] <;> rfl

/-- The same for the inverse PREPARE and `star` of the embedded `prepU`. -/
theorem aliasPrepMinv_kraus {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var)
    {N b g s : ℕ} (hs : s ≤ g) (ind alt : Fin (2 ^ s) → Fin (2 ^ b)) (K : Fin (2 ^ s) → ℕ)
    (hK : ∀ x, K x < 2 ^ (g - s)) (rData : QRegister (N + (b + g)) n)
    (rAnc : QRegister (aliasAncM b g s) n) (hd : ∀ i j, rData i ≠ rAnc j) :
    ∃ R : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ,
      LowerKraus (aliasPrepMinv v hs ind alt K rData rAnc hd).compile R ∧
      ∀ β, localIdx rAnc β = 0 →
        R *ᵥ ket β =
          (rData.embedUnitary
            (star ((blkA N b g).embedUnitary (prepU b g (aliasF ind alt K))))).1 *ᵥ ket β := by
  let r := rData.slice N (b + g) le_rfl
  let S := selectPauliUnitary g b (2 ^ g) (PrepareImpl.tblOf b g (aliasF ind alt K))
  let H := (PrepareImpl.hPre b g g le_rfl).eval
  obtain ⟨C, hC, hk⟩ := amCore_kraus v hs ind alt K hK rData rAnc hd
  refine ⟨_, hC.qSeq (lowerKraus_circuit (Var := Var) (amH rData)), ?_⟩
  intro β h0
  rw [← QC14.embedUnitary_star', ← QRegister.embedUnitary_compose, prepU, star_mul,
    QC14.star_selectPauliUnitary]
  have he : (amH rData).eval = r.embedUnitary (star H) := by
    change (amH rData).eval = r.embedUnitary (star (PrepareImpl.hPre b g g le_rfl).eval)
    exact (Circuit.eval_onRegister r (PrepareImpl.hPre b g g le_rfl)).trans
      (congrArg r.embedUnitary (amHStar b g).symm)
  exact amChainKet r rAnc (QRegister.disjoint_iff.2 (fun _ _ ↦ hd _ _)) C _ S (star H)
    hk (fun γ _ ↦ congrArg (fun V : Unitary (2 ^ n) ↦ V.1 *ᵥ ket γ) he) β h0

theorem amCore_count {Var : Type} (v : Var) {N b g s : ℕ} (hs : s ≤ g) (pos : ℕ → Wire n)
    (hi : ∀ p q, p < Lay.tot N b g → q < Lay.tot N b g → pos p = pos q → p = q)
    (ind alt : Fin (2 ^ s) → Fin (2 ^ b)) (K : Fin (2 ^ s) → ℕ)
    (a : QRegister (amWork s (amWord b g s)) n) :
    (amCore v hs pos hi ind alt K a).count PrimitiveGate.TOFF = 0 ∧
    (amCore v hs pos hi ind alt K a).count PrimitiveGate.T ≤ aliasTM b g s := by
  let load := amLoad v (Lay.W1 hs pos hi) (Lay.tt1 (g := g) ind alt K) a
  let unload := amUnload v (Lay.W2 hs pos hi) (Lay.tt2 (g := g) ind alt K) a
  obtain ⟨hLoadO, hLoadT⟩ : load.count PrimitiveGate.TOFF = 0 ∧
      load.count PrimitiveGate.T ≤ mbl2T s (amWord b g s) (lkSplit s (amWord b g s)) (s / 2) :=
    lkMbl2Prog_count v (amParams s (amWord b g s)) (lkSplit s (amWord b g s)) (s / 2)
      (by change lkSplit s _ ≤ s; unfold lkSplit; omega) (by change s / 2 ≤ s; omega)
      (amTable (Lay.tt1 (g := g) ind alt K)) (amReg (Lay.W1 hs pos hi)) a le_rfl
  obtain ⟨hUnloadO, hUnloadT⟩ : unload.count PrimitiveGate.TOFF = 0 ∧
      unload.count PrimitiveGate.T ≤ ssT s 1 (s / 2) :=
    lkMbuProg_count v (amParams s (b + (g - s))) (s / 2) (by change s / 2 ≤ s; omega)
      (amTable (Lay.tt2 (g := g) ind alt K)) (amReg (Lay.W2 hs pos hi)) a
      (amUnloadWork_le s (amWord b g s))
  obtain ⟨hCmpO, hCmpT⟩ := CmpW.cmp_count (Lay.cmpW hs pos hi)
  obtain ⟨hTofO, hTofT⟩ := TofW.chain_count (Lay.tofW hs pos hi) b
  have hcount {k : ℕ} (gate : PrimitiveGate k) :
      (amCore v hs pos hi ind alt K a).count gate = load.count gate +
        (((Lay.cmpW hs pos hi).cmp.count gate +
          (((Lay.tofW hs pos hi).chain b).count gate + (Lay.cmpW hs pos hi).cmp.count gate)) +
          unload.count gate) := rfl
  constructor
  · simp only [hcount PrimitiveGate.TOFF, hLoadO, hCmpO, hTofO, hUnloadO, Nat.zero_add]
  · rw [hcount PrimitiveGate.T]
    change _ ≤ mbl2T s (amWord b g s) (lkSplit s (amWord b g s)) (s / 2) + ssT s 1 (s / 2) +
      (32 * (g - s + 1) + 16 * b)
    omega -- CHECK composition with the specialized load and unload bounds.

theorem aliasPrepM_count {Var : Type} (v : Var) {N b g s : ℕ} (hs : s ≤ g)
    (ind alt : Fin (2 ^ s) → Fin (2 ^ b)) (K : Fin (2 ^ s) → ℕ)
    (rData : QRegister (N + (b + g)) n) (rAnc : QRegister (aliasAncM b g s) n)
    (hd : ∀ i j, rData i ≠ rAnc j) :
    (aliasPrepM v hs ind alt K rData rAnc hd).count PrimitiveGate.TOFF = 0 ∧
      (aliasPrepM v hs ind alt K rData rAnc hd).count PrimitiveGate.T ≤ aliasTM b g s := by
  have hc := amCore_count v hs (posOf rData (amBase rAnc))
    (posOf_inj rData (amBase rAnc) (fun _ _ ↦ hd _ _)) ind alt K (amScratch rAnc)
  have hT := PrepareImpl.count_hPre b g g le_rfl PrimitiveGate.T (by simp)
  have hO := PrepareImpl.count_hPre b g g le_rfl PrimitiveGate.TOFF (by simp)
  simp only [aliasPrepM, DynamicCircuit.count, amH, Circuit.count_onRegister, hT, hO,
    Nat.zero_add, Nat.add_zero]
  exact hc

theorem aliasPrepMinv_count {Var : Type} (v : Var) {N b g s : ℕ} (hs : s ≤ g)
    (ind alt : Fin (2 ^ s) → Fin (2 ^ b)) (K : Fin (2 ^ s) → ℕ)
    (rData : QRegister (N + (b + g)) n) (rAnc : QRegister (aliasAncM b g s) n)
    (hd : ∀ i j, rData i ≠ rAnc j) :
    (aliasPrepMinv v hs ind alt K rData rAnc hd).count PrimitiveGate.TOFF = 0 ∧
      (aliasPrepMinv v hs ind alt K rData rAnc hd).count PrimitiveGate.T ≤ aliasTM b g s := by
  have hc := amCore_count v hs (posOf rData (amBase rAnc))
    (posOf_inj rData (amBase rAnc) (fun _ _ ↦ hd _ _)) ind alt K (amScratch rAnc)
  have hT := PrepareImpl.count_hPre b g g le_rfl PrimitiveGate.T (by simp)
  have hO := PrepareImpl.count_hPre b g g le_rfl PrimitiveGate.TOFF (by simp)
  simp only [aliasPrepMinv, DynamicCircuit.count, amH, Circuit.count_onRegister, hT, hO,
    Nat.zero_add, Nat.add_zero]
  exact hc

end QC14.AliasCircuitM


/-! Inlined from lane module `THC/Codex/SpatialAlias.lean`. -/

namespace QC14.SpatialAlias

open QuantumComputation QuantumComputation.Specs QC14.WeightsC QC14.PairBlock Finset
open QC14.PairPrep
open Matrix Operator
open scoped Matrix

abbrev Label (N M : ℕ) := Fin N ⊕ {p : Fin M × Fin M // p.1 ≤ p.2}

def byLabel {N M : ℕ} {V : Type*} (one : Fin N → V) (two : Fin M → Fin M → V) :
    Label N M → V :=
  Sum.elim one (fun p => two p.val.1 p.val.2)

private theorem sum_labels {N M : ℕ} (one : Fin N → ℕ) (two : Fin M → Fin M → ℕ) :
    ∑ l, byLabel one two l =
      (∑ i, one i) + ∑ i, ∑ j, if i ≤ j then two i j else 0 := by
  classical
  rw [Fintype.sum_sum_type]
  congr 1
  let S := univ.filter (fun p : Fin M × Fin M => p.1 ≤ p.2)
  have hs : ∀ p : Fin M × Fin M, p ∈ S ↔ p.1 ≤ p.2 := by simp [S]
  change (∑ p : {p : Fin M × Fin M // p.1 ≤ p.2}, two p.val.1 p.val.2) = _
  rw [← Finset.sum_subtype S hs (fun p => two p.1 p.2)]
  unfold S
  rw [Finset.sum_filter, Fintype.sum_prod_type]

theorem card_label (N M : ℕ) : Fintype.card (Label N M) = dC N M := by
  classical
  have hcard : Fintype.card (Label N M) =
      ∑ l : Label N M, byLabel (fun _ => 1) (fun _ _ => 1) l := by
    have hc : ∀ l : Label N M, byLabel (fun _ => (1 : ℕ)) (fun _ _ => 1) l = 1 := by
      rintro (i | p) <;> rfl
    simp [hc]
  have hcol (j : Fin M) : (∑ i : Fin M, if i ≤ j then 1 else 0 : ℕ) = j.val + 1 := by
    have he : (univ.filter (fun i : Fin M => i ≤ j)) = Iic j := by ext i; simp
    rw [← Finset.card_filter, he, Fin.card_Iic]
  have htri : (∑ j : Fin M, (j.val + 1)) = M * (M + 1) / 2 := by
    calc
      _ = ∑ j ∈ range M, (j + 1) := (Finset.sum_range (fun j => j + 1)).symm
      _ = ∑ j ∈ range (M + 1), j := by rw [Finset.sum_range_succ'] <;> simp
      _ = _ := by rw [Finset.sum_range_id] <;> simp [Nat.mul_comm]
  rw [hcard, sum_labels]
  conv_lhs => rhs; rw [Finset.sum_comm]
  simp only [hcol, htri] <;> simp [dC]

/-- Sort first by the one-body index, then by the larger and smaller pair indices.
Restricting this order to the upper triangle puts the valid descriptors in consecutive slots. -/
def address (N M : ℕ) : Label N M ≃ Fin (dC N M) :=
  let pairKey : {p : Fin M × Fin M // p.1 ≤ p.2} ↪ Fin (M * M) :=
    (Function.Embedding.subtype _).trans
      ((Equiv.prodComm (Fin M) (Fin M)).trans finProdFinEquiv).toEmbedding
  let key : Label N M ↪ Fin (N + M * M) :=
    ((Function.Embedding.refl (Fin N)).sumMap pairKey).trans finSumFinEquiv.toEmbedding
  letI : LinearOrder (Label N M) := LinearOrder.lift' key key.injective
  (Fintype.orderIsoFinOfCardEq (Label N M) (card_label N M)).toEquiv.symm

def mass {N M : ℕ} (D : CData N M) : Label N M → ℕ := byLabel D.j1 D.j2

def tableMass {N M : ℕ} (D : CData N M) (i : ℕ) : ℕ :=
  if hi : i < dC N M then mass D ((address N M).symm ⟨i, hi⟩) else 0

private theorem total_tableMass {N M a b : ℕ} {lam : ℝ} {thc : THCFactorization N M}
    {D : CData N M} (hD : CFacts thc a b lam D) (hp : 0 < lamRepC thc D.t) :
    ∑ i ∈ range (dC N M), tableMass D i = dC N M * 2 ^ a := by
  have hsplit (i j : Fin M) :
      (if i ≤ j then D.j2 i j else 0) =
        (if i < j then D.j2 i j else 0) + (if i = j then D.j2 i i else 0) := by
    rcases lt_trichotomy i j with h | rfl | h
    · simp [h.le, h, h.ne]
    · simp
    · simp [not_le.mpr h, not_lt.mpr h.le, h.ne']
  calc
    _ = ∑ i : Fin (dC N M), mass D ((address N M).symm i) := by
      rw [Finset.sum_range]; exact Finset.sum_congr rfl fun i _ => dif_pos i.isLt
    _ = ∑ l, mass D l := Equiv.sum_comp (address N M).symm (mass D)
    _ = _ := by
      rw [mass, sum_labels]
      simp only [hsplit, Finset.sum_add_distrib, Finset.sum_ite_eq, mem_univ, if_true]
      rw [← add_assoc]
      exact sum_j_eq_dC hD hp

abbrev halfWidth (N M a : ℕ) := gC N M a - 2
abbrev slots (N M : ℕ) := 2 ^ Nat.clog 2 (dC N M)

private theorem width_eq (N M a : ℕ) : halfWidth N M a + 2 = gC N M a := by
  have h : idxC N M + 1 ≤ gC N M a := le_max_left _ _
  unfold idxC at h
  unfold halfWidth
  omega

private theorem rectangle_fits {N M a : ℕ} (hd : 0 < dC N M) :
    slots N M * 2 ^ a ≤ 2 ^ halfWidth N M a := by
  have hrect : dC N M * 2 ^ a ≤ 2 ^ halfWidth N M a := by
    refine Nat.le_of_mul_le_mul_left ?_ (by decide : 0 < 4)
    calc
      4 * (dC N M * 2 ^ a) = 4 * dC N M * 2 ^ a := (Nat.mul_assoc _ _ _).symm
      _ ≤ 2 ^ gC N M a := four_d_le_pow_gC N M a
      _ = 4 * 2 ^ halfWidth N M a := by
        rw [← width_eq N M a, pow_add]
        exact Nat.mul_comm _ _
  have hk : 2 ^ a ≤ dC N M * 2 ^ a :=
    calc 2 ^ a = 1 * 2 ^ a := (one_mul _).symm
      _ ≤ dC N M * 2 ^ a := Nat.mul_le_mul_right (2 ^ a) (show 1 ≤ dC N M from hd)
  have ha : a ≤ halfWidth N M a := (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).1 (hk.trans hrect)
  have he : 2 ^ (halfWidth N M a - a) * 2 ^ a = 2 ^ halfWidth N M a := by
    rw [← pow_add, Nat.sub_add_cancel ha]
  rw [← he] at hrect ⊢
  have hd' := Nat.le_of_mul_le_mul_right hrect (Nat.two_pow_pos a)
  exact Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (by decide : 0 < 2)
    ((Nat.clog_le_iff_le_pow (by decide : 1 < 2)).2 hd'))

def labelAt (N M i : ℕ) : Option (Label N M) :=
  if hi : i < dC N M then some ((address N M).symm ⟨i, hi⟩) else none

private theorem labelAt_eq {N M : ℕ} (i : ℕ) (l : Label N M) :
    labelAt N M i = some l ↔ i = ((address N M) l).val := by
  by_cases hi : i < dC N M
  · simp only [labelAt, dif_pos hi, Option.some.injEq]
    constructor
    · intro he
      simpa using congrArg (fun k => ((address N M) k).val) he
    · intro he
      exact (address N M).symm_apply_eq.mpr (Fin.ext he)
  · have hn : i ≠ ((address N M) l).val := by have := ((address N M) l).isLt; omega
    simp [labelAt, hi, hn]

/-- The low address bits choose one spatial record. Excess ticket bits and unused addresses pad. -/
noncomputable def tag {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (a : ℕ)
    (r : Fin (2 ^ halfWidth N M a)) : Option (Label N M) :=
  let i := r.val % slots N M
  let t := r.val / slots N M
  if 0 < lamRepC thc D.t ∧ i < dC N M ∧ t < 2 ^ a then
    labelAt N M (AliasPort.aliasOut (2 ^ a) (dC N M) (tableMass D) i t)
  else none

theorem spatial_table_bounds {N M a b : ℕ} {lam : ℝ} {thc : THCFactorization N M}
    {D : CData N M} (hD : CFacts thc a b lam D) (hp : 0 < lamRepC thc D.t)
    (i : Fin (dC N M)) :
    let entry := AliasPort.aliasTable (2 ^ a) (dC N M) (tableMass D) i.val
    entry.1 < 2 ^ a ∧ entry.2 < dC N M :=
  AliasPort.aliasTable_lt _ _ _ (Nat.two_pow_pos _) (total_tableMass hD hp) i.val i.isLt

private theorem card_rectangle {P d K Q : ℕ} (hP : 0 < P) (hd : d ≤ P) (hQ : P * K ≤ Q)
    (win : ℕ → ℕ → Prop) [DecidableRel win] :
    (univ.filter fun r : Fin Q => r.val % P < d ∧ r.val / P < K ∧ win (r.val % P) (r.val / P)).card =
      ((range d ×ˢ range K).filter fun p => win p.1 p.2).card := by
  refine Finset.card_bij (fun r _ => (r.val % P, r.val / P)) ?_ ?_ ?_
  · intro r hr
    obtain ⟨_, hi, ht, hw⟩ := mem_filter.mp hr
    exact mem_filter.mpr ⟨mem_product.mpr ⟨mem_range.mpr hi, mem_range.mpr ht⟩, hw⟩
  · intro r _ r' _ h
    rw [Prod.mk.injEq] at h
    apply Fin.ext
    rw [← Nat.mod_add_div r.val P, ← Nat.mod_add_div r'.val P, h.1, h.2]
  · intro p hp
    rw [mem_filter, mem_product, mem_range, mem_range] at hp
    have hi := lt_of_lt_of_le hp.1.1 hd
    have hb : p.1 + P * p.2 < Q := calc
      _ < P + P * p.2 := by omega
      _ = P * (p.2 + 1) := by ring
      _ ≤ P * K := Nat.mul_le_mul_left _ hp.1.2
      _ ≤ Q := hQ
    refine ⟨⟨p.1 + P * p.2, hb⟩, ?_, ?_⟩
    · apply mem_filter.mpr
      refine ⟨mem_univ _, ?_⟩
      simpa only [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hi, Nat.add_mul_div_left _ _ hP,
        Nat.div_eq_of_lt hi, zero_add] using (show p.1 < d ∧ p.2 < K ∧ win p.1 p.2 from
          ⟨hp.1.1, hp.1.2, hp.2⟩)
    · simp only [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hi, Nat.add_mul_div_left _ _ hP,
        Nat.div_eq_of_lt hi, zero_add]

theorem card_tag {N M a b : ℕ} {lam : ℝ} {thc : THCFactorization N M} {D : CData N M}
    (hD : CFacts thc a b lam D) (l : Label N M) :
    (univ.filter fun r => tag thc D a r = some l).card = mass D l := by
  classical
  by_cases hp : 0 < lamRepC thc D.t
  · let K := 2 ^ a
    let j := ((address N M) l).val
    let win := fun i t => AliasPort.aliasOut K (dC N M) (tableMass D) i t = j
    have hiff (r : Fin (2 ^ halfWidth N M a)) :
        tag thc D a r = some l ↔ r.val % slots N M < dC N M ∧ r.val / slots N M < K ∧
          win (r.val % slots N M) (r.val / slots N M) := by
      by_cases hi : r.val % slots N M < dC N M
      · by_cases ht : r.val / slots N M < 2 ^ a
        · simp [tag, hp, hi, ht, K, j, win, labelAt_eq]
        · simp [tag, hp, hi, ht, K]
      · simp [tag, hp, hi]
    simp only [hiff]
    rw [card_rectangle (Nat.two_pow_pos _) (Nat.le_pow_clog (by decide : 1 < 2) _)
      (rectangle_fits (a := a) (dC_pos_of_lamRepC_pos thc D.t hp)) win]
    have hc := AliasPort.aliasOut_card K (dC N M) (tableMass D) (Nat.two_pow_pos _)
      (total_tableMass hD hp) j ((address N M) l).isLt
    exact hc.trans (by simp [tableMass, j, dif_pos ((address N M) l).isLt])
  · have hzero := le_antisymm (not_lt.mp hp) (lamRepC_nonneg thc D.t)
    obtain ⟨h1, h2⟩ := hD.2.2.2.2.2.2 hzero
    rcases l with i | p <;> simp [tag, hp, mass, byLabel, h1, h2]

/-- Evaluate a row-pair observable on a two-body descriptor and two spin bits. -/
noncomputable def twoValue {N M : ℕ} {V : Type*} (thc : THCFactorization N M)
    (G : ℕ → ℕ → Bool → V) (i j : Fin M) (s t : Fin 2) : V :=
  let A := 2 * N + 2 * i.val
  let z := decide (thc.zeta i j < 0)
  if i = j then
    if s = t then G (rowI N M) (rowI N M) false else G A (A + 1) z
  else G (2 * N + (2 * i.val + s.val)) (2 * N + (2 * j.val + t.val)) z

noncomputable def readRows {N M : ℕ} {V : Type*} (thc : THCFactorization N M) (D : CData N M)
    (G : ℕ → ℕ → Bool → V) (l : Option (Label N M)) (s t : Fin 2) : V :=
  match l with
  | none => G (rowI N M) (rowI N M) false
  | some (.inl i) => G (2 * i.val + s.val) (rowI N M) (decide (0 ≤ D.t i))
  | some (.inr p) => twoValue thc G p.val.1 p.val.2 s t

/-- Total extension for use as the natural-row test in `pairW_sum_decomp`. -/
def pack (N M A B : ℕ) (z : Bool) : Fin (2 ^ idxC N M) :=
  encC ⟨A % 2 ^ bIC N M, Nat.mod_lt _ (Nat.two_pow_pos _)⟩
    ⟨B % 2 ^ bIC N M, Nat.mod_lt _ (Nat.two_pow_pos _)⟩ z

private theorem pack_fin {N M : ℕ} (A B : Fin (2 ^ bIC N M)) (z : Bool) :
    pack N M A.val B.val z = encC A B z := by
  unfold pack
  have ha : (⟨A.val % 2 ^ bIC N M, Nat.mod_lt _ (Nat.two_pow_pos _)⟩ : Fin (2 ^ bIC N M)) = A :=
    Fin.ext (Nat.mod_eq_of_lt A.isLt)
  have hb : (⟨B.val % 2 ^ bIC N M, Nat.mod_lt _ (Nat.two_pow_pos _)⟩ : Fin (2 ^ bIC N M)) = B :=
    Fin.ext (Nat.mod_eq_of_lt B.isLt)
  rw [ha, hb]

/-- Flatten (spatial seed, spin 1, spin 2) by ordinary binary place values. -/
def seedEquiv (N M a : ℕ) :
    Fin (2 ^ halfWidth N M a) × (Fin 2 × Fin 2) ≃ Fin (2 ^ gP N M a) :=
  (Equiv.prodCongr (Equiv.refl _) finProdFinEquiv).trans
    (finProdFinEquiv.trans (finCongr (by
      calc
        2 ^ halfWidth N M a * (2 * 2) = 2 ^ (halfWidth N M a + 2) := (pow_add 2 _ 2).symm
        _ = 2 ^ gP N M a := by rw [width_eq, gP_eq])))

noncomputable def spatialF {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (a : ℕ)
    (w : Fin (2 ^ gP N M a)) : Fin (2 ^ bP N M) :=
  let p := (seedEquiv N M a).symm w
  encP (readRows thc D (pack N M) (tag thc D a p.1) p.2.1 p.2.2) false

theorem spatialF_clear {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (a : ℕ)
    (w : Fin (2 ^ gP N M a)) : oP (spatialF thc D a w) = false :=
  oP_encP _ false

private theorem sum_over_fibres {S L V : Type*} [AddCommMonoid V] [Fintype S] [Fintype L] [DecidableEq L]
    (F : S → L) (K : L → V) :
    ∑ w, K (F w) = ∑ y, (univ.filter fun w => F w = y).card • K y := by
  simpa only [Finset.sum_const] using (Finset.sum_fiberwise' univ F K).symm

private def spinRow {M : ℕ} (i : Fin M) (s : Fin 2) : Fin (2 * M) :=
  ⟨2 * i.val + s.val, by have := i.isLt; have := s.isLt; omega⟩

private theorem spin_grid (M : ℕ) (f : Fin (2 * M) → Fin (2 * M) → ℕ) :
    ∑ a, ∑ b, f a b =
      ∑ i : Fin M, ∑ j : Fin M, ∑ s : Fin 2, ∑ t : Fin 2, f (spinRow i s) (spinRow j t) := by
  rw [sum_sum_fin_two_mul]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  simp only [Fin.sum_univ_two, spinRow, Fin.val_zero, Fin.val_one, Nat.add_zero] <;> omega

private noncomputable def orderedTerm {N M : ℕ} (thc : THCFactorization N M) (D : CData N M)
    (G : ℕ → ℕ → Bool → ℕ) (a b : Fin (2 * M)) : ℕ :=
  if a.val < b.val then twoWt D a b * G (2 * N + a.val) (2 * N + b.val) (twoZ thc a b)
  else 0

private theorem term_at_spin {N M : ℕ} (thc : THCFactorization N M) (D : CData N M)
    (G : ℕ → ℕ → Bool → ℕ) (i j : Fin M) (s t : Fin 2) :
    orderedTerm thc D G (spinRow i s) (spinRow j t) =
      (if i < j then D.j2 i j else 2 * D.j2 i i) *
      (if i < j ∨ i = j ∧ s < t then
        G (2 * N + (2 * i.val + s.val)) (2 * N + (2 * j.val + t.val)) (decide (thc.zeta i j < 0))
       else 0) := by
  have half (k : Fin M) (u : Fin 2) : (spinRow k u).val / 2 = k.val := by
    change (2 * k.val + u.val) / 2 = k.val
    have := u.isLt
    omega
  have pick (k : Fin M) (u : Fin 2) :
      (⟨(spinRow k u).val / 2, by have := (spinRow k u).isLt; omega⟩ : Fin M) = k :=
    Fin.ext (half k u)
  have hlt : (spinRow i s).val < (spinRow j t).val ↔ i < j ∨ i = j ∧ s < t := by
    change 2 * i.val + s.val < 2 * j.val + t.val ↔ i.val < j.val ∨ i = j ∧ s.val < t.val
    rw [← Fin.val_inj]
    have := s.isLt
    have := t.isLt
    omega
  unfold orderedTerm twoWt twoZ
  simp only [pick, half, hlt]
  by_cases h : i < j ∨ i = j ∧ s < t
  · simp only [if_pos h] <;> rfl
  · simp [h]

private theorem spin_pair {N M : ℕ} (thc : THCFactorization N M) (D : CData N M)
    (G : ℕ → ℕ → Bool → ℕ) (hG : G (rowI N M) (rowI N M) false = 0) (i j : Fin M) :
    (if i ≤ j then D.j2 i j * ∑ s : Fin 2, ∑ t : Fin 2, twoValue thc G i j s t else 0) =
      ∑ s : Fin 2, ∑ t : Fin 2, orderedTerm thc D G (spinRow i s) (spinRow j t) := by
  simp only [term_at_spin]
  rcases lt_trichotomy i j with h | rfl | h
  · simp [h, h.le, h.ne, twoValue] <;> ring
  · have h01 : (0 : Fin 2) < 1 := by decide
    simp [Fin.sum_univ_two, twoValue, hG, Nat.add_assoc, h01, not_lt.mpr h01.le] <;> ring
  · simp [not_le.mpr h, not_lt.mpr h.le, h.ne']

private theorem flat_observable {N M : ℕ} (thc : THCFactorization N M) (D : CData N M)
    (a : ℕ) (f : Fin (2 ^ idxC N M) → ℕ) :
    ∑ y, flatW thc D a y * f y =
      ∑ A : Fin (2 ^ bIC N M), ∑ B : Fin (2 ^ bIC N M), ∑ z : Bool,
        pairW thc D a A.val B.val z • f (pack N M A.val B.val z) := by
  rw [sum_idx_eq (fun y => flatW thc D a y * f y)]
  simp only [flatW, idxA_encC, idxB_encC, idxZ_encC, pack_fin, Nat.nsmul_eq_mul]

private theorem centered_weights {N M : ℕ} (thc : THCFactorization N M) (D : CData N M)
    (a : ℕ) (f : Fin (2 ^ idxC N M) → ℕ) (hf : f (pack N M (rowI N M) (rowI N M) false) = 0) :
    ∑ l : Label N M, mass D l * ∑ s : Fin 2, ∑ t : Fin 2,
        readRows thc D (fun A B z => f (pack N M A B z)) (some l) s t =
      ∑ y, flatW thc D a y * f y := by
  let G := fun A B z => f (pack N M A B z)
  let one := fun i : Fin N => D.j1 i * ∑ s : Fin 2, ∑ _t : Fin 2,
    G (2 * i.val + s.val) (rowI N M) (decide (0 ≤ D.t i))
  let two := fun i j : Fin M => D.j2 i j * ∑ s : Fin 2, ∑ t : Fin 2, twoValue thc G i j s t
  have hcase (l : Label N M) :
      mass D l * (∑ s : Fin 2, ∑ t : Fin 2, readRows thc D G (some l) s t) = byLabel one two l := by
    rcases l with i | p <;> rfl
  change (∑ l, mass D l * (∑ s : Fin 2, ∑ t : Fin 2, readRows thc D G (some l) s t)) = _
  simp only [hcase]
  rw [sum_labels, flat_observable, pairW_sum_decomp thc D a G]
  simp only [Nat.nsmul_eq_mul, show G (rowI N M) (rowI N M) false = 0 from hf, mul_zero, add_zero]
  congr 1
  · apply Finset.sum_congr rfl
    intro i _
    simp [one, Fin.sum_univ_two] <;> ring
  · change (∑ i, ∑ j, if i ≤ j then two i j else 0) = ∑ u, ∑ v, orderedTerm thc D G u v
    rw [spin_grid M (orderedTerm thc D G)]
    exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => spin_pair thc D G hf i j

private theorem read_map {N M : ℕ} (thc : THCFactorization N M) (D : CData N M)
    (f : Fin (2 ^ idxC N M) → ℕ) (l : Option (Label N M)) (s t : Fin 2) :
    f (readRows thc D (pack N M) l s t) =
      readRows thc D (fun A B z => f (pack N M A B z)) l s t := by
  rcases l with _ | (i | p)
  · rfl
  · rfl
  · simp only [readRows, twoValue]; split_ifs <;> rfl

private theorem centered_seed {N M a b : ℕ} {lam : ℝ} {thc : THCFactorization N M}
    {D : CData N M} (hD : CFacts thc a b lam D) (f : Fin (2 ^ idxC N M) → ℕ)
    (hf : f (pack N M (rowI N M) (rowI N M) false) = 0) :
    ∑ w, f (loP (spatialF thc D a w)) = ∑ y, flatW thc D a y * f y := by
  let G := fun A B z => f (pack N M A B z)
  let k := fun l : Option (Label N M) =>
    ∑ s : Fin 2, ∑ t : Fin 2, readRows thc D G l s t
  have hk : k none = 0 := by simp [k, readRows, G, hf]
  calc
    _ = ∑ r, k (tag thc D a r) := by
      rw [← Equiv.sum_comp (seedEquiv N M a) (fun w => f (loP (spatialF thc D a w)))]
      simp only [spatialF, Equiv.symm_apply_apply, loP_encP, Fintype.sum_prod_type, read_map] <;> rfl
    _ = ∑ l : Label N M, mass D l * k (some l) := by
      rw [sum_over_fibres (tag thc D a) k, Fintype.sum_option]
      simp only [Nat.nsmul_eq_mul, hk, mul_zero, zero_add, card_tag hD]
    _ = _ := centered_weights thc D a f hf

/-- PROPOSED P4.4b fibre statement. The table in this particular loader ranges over spatial
descriptors and its keep threshold fits in `a` bits whenever a record is used. -/
theorem card_spatialF {N M a b : ℕ} {lam : ℝ} {thc : THCFactorization N M}
    {D : CData N M} (hD : CFacts thc a b lam D) (y : Fin (2 ^ idxC N M)) :
    (univ.filter fun w => spatialF thc D a w = encP y false).card = flatW thc D a y := by
  classical
  let F := fun w : Fin (2 ^ gP N M a) => loP (spatialF thc D a w)
  let n := fun z : Fin (2 ^ idxC N M) => (univ.filter fun w => F w = z).card
  let pad := pack N M (rowI N M) (rowI N M) false
  have hoff (z : Fin (2 ^ idxC N M)) (hz : z ≠ pad) : n z = flatW thc D a z := by
    have he := centered_seed hD (fun k => if k = z then 1 else 0) (if_neg hz.symm)
    simpa only [n, F, Finset.card_filter, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
      mem_univ, if_true] using he
  have hall : n y = flatW thc D a y := by
    by_cases hy : y = pad
    · have hs : ∑ z, n z = ∑ z, flatW thc D a z := by
        have h := sum_over_fibres F (fun _ => (1 : ℕ))
        simpa [n, Nat.nsmul_eq_mul, sum_flatW hD, gP_eq] using h.symm
      rw [← Finset.sum_erase_add _ n (mem_univ y), ← Finset.sum_erase_add _ (flatW thc D a)
        (mem_univ y)] at hs
      have ht : ∑ z ∈ univ.erase y, n z = ∑ z ∈ univ.erase y, flatW thc D a z :=
        Finset.sum_congr rfl fun z hz => hoff z (fun e => (mem_erase.mp hz).1 (e.trans hy.symm))
      omega
    · exact hoff y hy
  have he (w : Fin (2 ^ gP N M a)) : spatialF thc D a w = encP y false ↔ F w = y := by
    constructor
    · intro e
      change loP (spatialF thc D a w) = y
      rw [e, loP_encP]
    · intro e
      calc
        spatialF thc D a w = encP (F w) false := by
          simpa only [F, spatialF_clear] using (encP_loP (spatialF thc D a w)).symm
        _ = encP y false := congrArg (fun u => encP u false) e
  simpa only [he] using (show (univ.filter fun w => F w = y).card = flatW thc D a y from hall)

/- The column argument below generalizes PairPrep.pairPrep_vec and PairPrep.pairPrepU_col
to a loader with an initially clear orientation bit. Its gate lemmas are imported unchanged. -/
open PrepareImpl SelectPauliImpl SelectPauliSteps

noncomputable def orientedPrep {N M g : ℕ} (F : Fin (2 ^ g) → Fin (2 ^ bP N M)) :
    Unitary (2 ^ (bP N M + g)) :=
  permutationUnitary (cswapPerm N M g) * hO N M g * prepU (bP N M) g F

private theorem oriented_vec {N M g : ℕ} (F : Fin (2 ^ g) → Fin (2 ^ bP N M))
    (hF : ∀ w, F w = encP (loP (F w)) false) :
    (orientedPrep F).1 *ᵥ basisState 0 =
      ((Real.sqrt (1 / 2) : ℂ) ^ (g + 1)) •
        ∑ σ, (basisState (prepareDataEquiv (bP N M) g
                (encP (loP (F σ)) false, σ)) +
              basisState (prepareDataEquiv (bP N M) g
                (encP (swapAB (loP (F σ))) true, σ))) := by
  have h1 : (orientedPrep F).1 *ᵥ basisState 0 =
      (permutationUnitary (cswapPerm N M g)).1 *ᵥ
        ((hO N M g).1 *ᵥ
          ((prepU (bP N M) g F).1 *ᵥ basisState 0)) := by
    rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec]; rfl
  have hstep : ∀ σ : Fin (2 ^ g),
      (hO N M g).1 *ᵥ
        basisState (prepareDataEquiv (bP N M) g (F σ, σ)) =
      (Real.sqrt (1 / 2) : ℂ) •
        (basisState (prepareDataEquiv (bP N M) g
            (encP (loP (F σ)) false, σ)) +
          basisState (prepareDataEquiv (bP N M) g
            (encP (loP (F σ)) true, σ))) := by
    intro σ
    obtain ⟨y, hy⟩ : ∃ y, F σ = encP y false := ⟨_, hF σ⟩
    rw [hy, loP_encP]
    exact PairPrep.hO_basis _ _ (PairPrep.pd_bit y σ) (PairPrep.pd_add y σ)
  rw [h1, PairPrep.prepU_col, Matrix.mulVec_smul, Matrix.mulVec_sum]
  simp only [hstep]
  rw [Matrix.mulVec_smul, Matrix.mulVec_sum]
  simp only [Matrix.mulVec_smul, Matrix.mulVec_add, PairPrep.perm_basis, PairPrep.cswapPerm_pd, PairPrep.cswapIdx_false,
    PairPrep.cswapIdx_true]
  simp only [← Finset.smul_sum, smul_smul, pow_succ]

/-- Column zero of the oriented loader for any initially clear orientation bit. -/
private theorem oriented_col {N M g : ℕ} (F : Fin (2 ^ g) → Fin (2 ^ bP N M))
    (hF : ∀ w, F w = encP (loP (F w)) false) (x : Fin (2 ^ bP N M))
    (σ : Fin (2 ^ g)) :
    (orientedPrep F).1 (prepareDataEquiv (bP N M) g (x, σ)) 0 =
      (Real.sqrt (1 / 2) : ℂ) ^ (g + 1) *
        (if F σ = encP (if oP x then swapAB (loP x) else loP x) false
          then 1 else 0) := by
  have key : ((if x = F σ then 1 else 0) +
      (if x = encP (swapAB (loP (F σ))) true then 1 else 0) : ℂ) =
      if F σ = encP (if oP x then swapAB (loP x) else loP x) false
        then 1 else 0 := by
    obtain ⟨y, hy⟩ : ∃ y, F σ = encP y false := ⟨_, hF σ⟩
    obtain ⟨lx, ox, rfl⟩ : ∃ lx ox, x = encP lx ox := ⟨loP x, oP x, (encP_loP x).symm⟩
    have e : (y = swapAB lx) ↔ (lx = swapAB y) :=
      ⟨fun h => by rw [h, swapAB_swapAB], fun h => by rw [h, swapAB_swapAB]⟩
    rw [hy]
    cases ox
    · simp [oP_encP, loP_encP, PairPrep.encP_inj]
      exact if_congr eq_comm rfl rfl
    · simp [oP_encP, loP_encP, PairPrep.encP_inj, e]
  have hent : (orientedPrep F).1 (prepareDataEquiv (bP N M) g (x, σ)) 0 =
      ((orientedPrep F).1 *ᵥ basisState 0)
        (prepareDataEquiv (bP N M) g (x, σ)) :=
    (mulVec_basisState _ _ _).symm
  rw [hent, oriented_vec F hF]
  simp only [Pi.smul_apply, Finset.sum_apply, Pi.add_apply, basisState_apply, smul_eq_mul,
    Equiv.apply_eq_iff_eq, Prod.mk.injEq]
  congr 1
  rw [Finset.sum_eq_single σ]
  · rw [← hF σ]
    simp only [and_true]
    exact key
  · intro σ' _ hne
    simp [Ne.symm hne]
  · intro h; exact absurd (mem_univ _) h

private theorem same_redAmp {N M a b : ℕ} {lam : ℝ} {thc : THCFactorization N M}
    {D : CData N M} (hD : CFacts thc a b lam D) (u v : Fin (2 ^ bP N M)) :
    redAmp (bP N M) (gP N M a) (orientedPrep (spatialF thc D a)) u v =
      redAmp (bP N M) (gP N M a) (pairPrepU thc D a) u v := by
  classical
  let F := spatialF thc D a
  let old := fP thc D a
  have hF (w) : F w = encP (loP (F w)) false := by
    simpa only [F, spatialF_clear] using (encP_loP (F w)).symm
  let amp := fun (x : Fin (2 ^ bP N M)) (y : Fin (2 ^ idxC N M)) =>
    (Real.sqrt (1 / 2) : ℂ) ^ (gP N M a + 1) *
      (if encP (N := N) (M := M) y false = encP (if oP x then swapAB (loP x) else loP x) false then 1 else 0)
  let K := fun y => star (amp u y) * amp v y
  have hcol (x w) :
      (orientedPrep F).1 (prepareDataEquiv (bP N M) (gP N M a) (x,w)) 0 = amp x (loP (F w)) := by
    simpa only [amp, ← hF w] using oriented_col F hF x w
  have hold (x w) :
      (pairPrepU thc D a).1 (prepareDataEquiv (bP N M) (gP N M a) (x,w)) 0 =
        amp x (loP (old w)) := by
    simpa only [amp, old, ← fP_eq_encP hD w] using pairPrepU_col hD x w
  have hist (y : Fin (2 ^ idxC N M)) :
      (univ.filter fun w => loP (F w) = y).card = (univ.filter fun w => loP (old w) = y).card := by
    have aux (f : Fin (2 ^ gP N M a) → Fin (2 ^ bP N M))
        (hf : ∀ w, f w = encP (loP (f w)) false) (w) : loP (f w) = y ↔ f w = encP y false := by
      constructor
      · intro e
        exact (hf w).trans (congrArg (fun k => encP k false) e)
      · intro e
        simpa only [loP_encP] using congrArg loP e
    calc
      _ = (univ.filter fun w => F w = encP y false).card := by simp only [aux F hF]
      _ = flatW thc D a y := card_spatialF hD y
      _ = (univ.filter fun w => old w = encP y false).card := (card_fP hD y).symm
      _ = _ := by simp only [aux old (fP_eq_encP hD)]
  change redAmp _ _ (orientedPrep F) u v = redAmp _ _ (pairPrepU thc D a) u v
  unfold redAmp
  simp only [hcol, hold]
  change (∑ w, K (loP (F w))) = ∑ w, K (loP (old w))
  exact (sum_over_fibres (fun w => loP (F w)) K).trans
    ((Finset.sum_congr rfl fun y _ => congrArg (fun n : ℕ => n • K y) (hist y)).trans
      (sum_over_fibres (fun w => loP (old w)) K).symm)

/-- Top-left block of `Q† S Q`: exactly `α⁻¹ (thcHamiltonian - c' 1)` on the system. -/
theorem spatial_block {N M : ℕ} [NeZero N] {thc : THCFactorization N M} {aleph beth : ℕ}
    {lam : ℝ} {D : CData N M} (hD : CFacts thc aleph beth lam D) :
    (blkA (2 * N) (bP N M) (gP N M aleph)).basisOutcomeProjector 0 *
        (lcuQ N (bP N M) (gP N M aleph) (orientedPrep (spatialF thc D aleph)) (pairSelU D beth)).1 *
        (blkA (2 * N) (bP N M) (gP N M aleph)).basisOutcomeProjector 0 =
      (blkA (2 * N) (bP N M) (gP N M aleph)).basisOutcomeProjector 0 *
        (blkSys (2 * N) (bP N M) (gP N M aleph)).embedMatrix
          (((alphaC thc D aleph)⁻¹ : ℂ) • (thcHamiltonian thc - (offsetC thc D aleph : ℂ) • 1)) *
        (blkA (2 * N) (bP N M) (gP N M aleph)).basisOutcomeProjector 0 := by
  rw [lcuQ_block_map N (bP N M) (gP N M aleph) (orientedPrep (spatialF thc D aleph)) (pairSelU D beth)
    swapP (selPW D beth) rfl]
  simp only [same_redAmp hD]
  rw [pair_sum_eq hD, blockSumC_eq hD]

/-- `Q† S Q` is Hermitian. -/
theorem spatial_herm {N M : ℕ} [NeZero N] (thc : THCFactorization N M) (D : CData N M)
    (aleph beth : ℕ) :
    (lcuQ N (bP N M) (gP N M aleph) (orientedPrep (spatialF thc D aleph)) (pairSelU D beth)).1ᴴ =
      (lcuQ N (bP N M) (gP N M aleph) (orientedPrep (spatialF thc D aleph)) (pairSelU D beth)).1 := by
  exact lcuQ_herm N (bP N M) (gP N M aleph) _ (pairSelU D beth) (pairSelOp_conjTranspose D beth)

end QC14.SpatialAlias


/-! Inlined from lane module `THC/AliasCircuitS.lean`. -/

namespace QC14.AliasCircuitS

open QuantumComputation QuantumComputation.Specs Matrix Finset Operator
open QuantumComputation.Specs.ArcsinImpl
open QuantumComputation.Specs.SelectSwapImpl QuantumComputation.Specs.Mbl2Impl
open QC14.WeightsC QC14.PairBlock QC14.PairPrep QC14.SpatialAlias QC14.AliasCircuitM

def slotBitsS (N M : ℕ) := Nat.clog 2 (dC N M)
def highBitsS (N M : ℕ) := bIC N M - 1
def descBitsS (N M : ℕ) := 2 * highBitsS N M + 4
def wordBitsS (N M a : ℕ) := 2 * descBitsS N M + a
def extraS (N M a : ℕ) := halfWidth N M a - slotBitsS N M - a
def decWorkS (N M a : ℕ) := descBitsS N M + a + extraS N M a + 12

/-- One pass computing the flags and selected descriptor on clean scratch. -/
def computeTS (N M a : ℕ) : ℕ :=
  16 * a + 8 * (descBitsS N M + 3 + extraS N M a)

/-- V, controlled output XORs, V inverse. -/
def decodeTS (N M a : ℕ) : ℕ :=
  2 * computeTS N M a + 8 * (2 * highBitsS N M + 3)

/-- One load, one measured unlookup, and two decoder calls per walk. -/
def aliasTS (N M a : ℕ) : ℕ :=
  let m := slotBitsS N M
  let w := wordBitsS N M a
  mbl2T m w (lkSplit m w) (m / 2) + ssT m 1 (m / 2) + 2 * decodeTS N M a

def bnS (b : Bool) : ℕ := if b then 1 else 0

/-- The absent label is encoded by the all-zero descriptor. -/
noncomputable def descS {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) :
    Option (Label N M) → ℕ := by
  classical
  let base := N + M
  let H := 2 ^ highBitsS N M
  let encode := fun (A B : ℕ) (z spinA off diag : Bool) =>
    Nat.xor A base + H * Nat.xor B base +
      H ^ 2 * (bnS z + 2 * bnS spinA + 4 * bnS off + 8 * bnS diag)
  exact fun
    | none => 0
    | some (.inl i) => encode i.val base (decide (0 ≤ D.t i)) true false false
    | some (.inr p) =>
      let i := p.val.1
      let j := p.val.2
      encode (N + i.val) (N + j.val) (decide (thc.zeta i j < 0))
        (decide (i ≠ j)) (decide (i ≠ j)) (decide (i = j))

open Classical in
noncomputable def rowWordS {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (a : ℕ)
    (x : Fin (2 ^ slotBitsS N M)) : ℕ :=
  if 0 < lamRepC thc D.t ∧ x.val < dC N M then
    let entry := AliasPort.aliasTable (2 ^ a) (dC N M) (tableMass D) x.val
    let p := descS thc D (labelAt N M x.val)
    let alt := if entry.1 < 2 ^ a then descS thc D (labelAt N M entry.2) else p
    let k := if entry.1 < 2 ^ a then entry.1 else 0
    let scale := 2 ^ descBitsS N M
    alt + scale * Nat.xor p alt + scale ^ 2 * k
  else 0

noncomputable def tableS {N M : ℕ} (thc : THCFactorization N M) (D : CData N M) (a : ℕ)
    (x : Fin (2 ^ slotBitsS N M)) : BitAssignment (wordBitsS N M a) :=
  fun j ↦ AliasCircuit.bitN (rowWordS thc D a x) j.val

def slotS (N M σ : ℕ) : Fin (2 ^ slotBitsS N M) :=
  ⟨σ / 4 % 2 ^ slotBitsS N M, Nat.mod_lt _ (Nat.two_pow_pos _)⟩

/-- Logical action on a valid-width word. seed = t + 2*s + 4*(slot + 2^m*ticket). -/
def outNatS (N M a word seed : ℕ) : ℕ :=
  let h := highBitsS N M
  let scale := 2 ^ descBitsS N M
  let ticket := seed / 2 ^ (2 + slotBitsS N M)
  let alt := word % scale
  let delta := word / scale % scale
  let k := word / scale ^ 2 % 2 ^ a
  let c := if ticket % 2 ^ a < k then Nat.xor alt delta else alt
  let s := seed.testBit 1
  let t := seed.testBit 0
  let diag := c.testBit (2 * h + 3)
  let enable := ticket < 2 ^ a ∧ ¬ (diag = true ∧ s = t)
  let base := N + M
  let A := if enable then 2 * Nat.xor base (c % 2 ^ h) + bnS (s && c.testBit (2*h+1)) else 2 * base
  let B := if enable then 2 * Nat.xor base (c / 2 ^ h % 2 ^ h) +
      Nat.xor (bnS (t && c.testBit (2*h+2))) (bnS diag) else 2 * base
  let z := if enable then bnS (c.testBit (2*h)) else 0
  A + 2 ^ bIC N M * B + 2 ^ (2 * bIC N M) * z

-- CHECK A0: All new declarations await the lead's cluster elaboration.
/-- The two row halves have one low spin wire apiece. -/
theorem acsWidth (N M : ℕ) [NeZero N] :
    bIC N M = highBitsS N M + 1 ∧ N + M < 2 ^ highBitsS N M := by
  have hr := rows_le_bIC N M
  have hn := NeZero.pos N
  have hk : bIC N M ≠ 0 := by
    intro e
    rw [e, pow_zero] at hr
    omega
  have he : bIC N M = highBitsS N M + 1 := by unfold highBitsS; omega
  rw [he, pow_succ] at hr
  exact ⟨he, by omega⟩

theorem acsSeedWidth (N M a : ℕ) [NeZero N] :
    gP N M a = 2 + slotBitsS N M + a + extraS N M a := by
  have hn := NeZero.pos N
  have hd : 0 < dC N M := by unfold dC; omega
  have hg : idxC N M + 1 ≤ gC N M a := le_max_left _ _
  have he : halfWidth N M a + 2 = gC N M a := by
    unfold idxC at hg
    unfold halfWidth
    omega
  have hrect : dC N M * 2 ^ a ≤ 2 ^ halfWidth N M a := by
    refine Nat.le_of_mul_le_mul_left ?_ (by decide : 0 < 4)
    calc
      4 * (dC N M * 2 ^ a) = 4 * dC N M * 2 ^ a := by ring
      _ ≤ 2 ^ gC N M a := four_d_le_pow_gC _ _ _
      _ = 4 * 2 ^ halfWidth N M a := by rw [← he, pow_add]; ring
  have ha' : 2 ^ a ≤ 2 ^ halfWidth N M a :=
    (show 2 ^ a ≤ dC N M * 2 ^ a by simpa using Nat.mul_le_mul_right (2^a) hd).trans hrect
  have ha := (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).1 ha'
  have hp : 2 ^ halfWidth N M a = 2 ^ (halfWidth N M a - a) * 2 ^ a := by
    rw [← pow_add, Nat.sub_add_cancel ha]
  rw [hp] at hrect
  have hs : slotBitsS N M ≤ halfWidth N M a - a :=
    (Nat.clog_le_iff_le_pow (by decide : 1 < 2)).2
      (Nat.le_of_mul_le_mul_right hrect (Nat.two_pow_pos a))
  rw [gP_eq]
  unfold extraS
  omega

/-- Split the packed seed through the same equivalence as spatialF. -/
theorem acsSeed {N M a : ℕ} (σ : Fin (2 ^ gP N M a)) :
    let p := (seedEquiv N M a).symm σ
    p.1.val = σ.val / 4 ∧ p.2.1.val = σ.val / 2 % 2 ∧ p.2.2.val = σ.val % 2 := by
  -- CHECK S1: finCongr preserves the forward mixed-radix value definitionally.
  obtain ⟨⟨r,s,t⟩, rfl⟩ := (seedEquiv N M a).surjective σ
  simp only [Equiv.symm_apply_apply]
  change r.val = (t.val + 2*s.val + 4*r.val)/4 ∧
    s.val = (t.val + 2*s.val + 4*r.val)/2%2 ∧ t.val = (t.val + 2*s.val + 4*r.val)%2
  have := s.isLt
  have := t.isLt
  omega

def acsPack3 (h x y k : ℕ) := x + 2^h * y + (2^h)^2 * k

theorem acsFields {h x y k : ℕ} (hx : x < 2^h) (hy : y < 2^h) :
    acsPack3 h x y k % 2^h = x ∧ acsPack3 h x y k / 2^h % 2^h = y ∧
    acsPack3 h x y k / (2^h)^2 = k := by
  have hp := Nat.two_pow_pos h
  have e : acsPack3 h x y k = x + 2^h * (y + 2^h * k) := by unfold acsPack3; ring
  -- CHECK F1: reduce the three fields using the positive-field division rules.
  rw [e]
  simp only [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hx, Nat.mod_eq_of_lt hy,
    pow_two, ← Nat.div_div_eq_div_mul, Nat.add_mul_div_left _ _ hp,
    Nat.div_eq_of_lt hx, Nat.div_eq_of_lt hy, zero_add, and_self]

theorem acsPackLt {h x y k b : ℕ} (hx : x < 2^h) (hy : y < 2^h) (hk : k < 2^b) :
    acsPack3 h x y k < 2^(2*h+b) := by
  have top := (acsFields (k := k) hx hy).2.2
  rw [← top, Nat.div_lt_iff_lt_mul (by positivity : 0 < (2^h)^2)] at hk
  simpa [two_mul, pow_add, pow_two, Nat.mul_comm, Nat.mul_assoc, Nat.mul_left_comm] using hk

theorem acsXorCancel (a b : ℕ) : Nat.xor a (Nat.xor b a) = b := by
  change a ^^^ (b ^^^ a) = b
  rw [Nat.xor_comm b a, ← Nat.xor_assoc, Nat.xor_self, Nat.zero_xor]

def acsFlags (z sa off d : Bool) := bnS z + 2*bnS sa + 4*bnS off + 8*bnS d

theorem acsFlagBits (z sa off d : Bool) :
    let f := acsFlags z sa off d
    f < 2^4 ∧ f.testBit 0 = z ∧ f.testBit 1 = sa ∧ f.testBit 2 = off ∧ f.testBit 3 = d := by
  cases z <;> cases sa <;> cases off <;> cases d <;> decide

def acsEncode (h J A B : ℕ) (z sa off d : Bool) :=
  acsPack3 h (Nat.xor A J) (Nat.xor B J) (acsFlags z sa off d)

def acsChosen (L a w ticket : ℕ) :=
  if ticket % 2^a < w / (2^L)^2 % 2^a then Nat.xor (w % 2^L) (w / 2^L % 2^L)
  else w % 2^L

def acsEmit (N M c : ℕ) (s t ok : Bool) :=
  let h := highBitsS N M
  let d := c.testBit (2*h+3)
  let en := ok = true ∧ ¬ (d = true ∧ s = t)
  let J := N+M
  let A := if en then 2 * Nat.xor J (c % 2^h) + bnS (s && c.testBit (2*h+1)) else 2*J
  let B := if en then 2 * Nat.xor J (c / 2^h % 2^h) +
    Nat.xor (bnS (t && c.testBit (2*h+2))) (bnS d) else 2*J
  A + 2^(bIC N M)*B + 2^(2*bIC N M)*(if en then bnS (c.testBit (2*h)) else 0)

theorem acsOut (N M a w σ : ℕ) :
    let tkt := σ / 2^(2+slotBitsS N M)
    outNatS N M a w σ = acsEmit N M (acsChosen (descBitsS N M) a w tkt)
      (σ.testBit 1) (σ.testBit 0) (decide (tkt < 2^a)) := by
  simp only [outNatS, acsChosen, acsEmit, decide_eq_true_eq]

theorem acsEncodeLt {h J A B : ℕ} (hJ : J < 2^h) (hA : A < 2^h) (hB : B < 2^h)
    (z sa off d : Bool) : acsEncode h J A B z sa off d < 2^(2*h+4) :=
  acsPackLt (Nat.xor_lt_two_pow hA hJ) (Nat.xor_lt_two_pow hB hJ) (acsFlagBits z sa off d).1

theorem acsDescLt {N M : ℕ} [NeZero N] (thc : THCFactorization N M) (D : CData N M)
    (l : Option (Label N M)) : descS thc D l < 2 ^ descBitsS N M := by
  have hJ := (acsWidth N M).2
  rcases l with _ | (i | ⟨⟨i,j⟩, hij⟩)
  · exact Nat.two_pow_pos _
  · exact acsEncodeLt hJ (by have := i.isLt; omega) hJ _ _ _ _
  · exact acsEncodeLt hJ (by have := i.isLt; omega) (by have := j.isLt; omega) _ _ _ _

theorem acsEmitEncode {N M A B : ℕ} [NeZero N]
    (hA : A < 2^highBitsS N M) (hB : B < 2^highBitsS N M) (z sa off d s t ok : Bool) :
    let en := ok = true ∧ ¬ (d = true ∧ s = t)
    acsEmit N M (acsEncode (highBitsS N M) (N+M) A B z sa off d) s t ok =
      (if en then 2*A+bnS (s && sa) else rowI N M) +
      2^(bIC N M)*(if en then 2*B+Nat.xor (bnS (t && off)) (bnS d) else rowI N M) +
      2^(2*bIC N M)*(if en then bnS z else 0) := by
  let h := highBitsS N M
  let c := acsEncode h (N+M) A B z sa off d
  obtain ⟨lo,mid,top⟩ := acsFields (k := acsFlags z sa off d)
    (Nat.xor_lt_two_pow hA (acsWidth N M).2) (Nat.xor_lt_two_pow hB (acsWidth N M).2)
  change c % 2^h = _ at lo
  change c / 2^h % 2^h = _ at mid
  change c / (2^h)^2 = _ at top
  have hp : (2^h)^2 = 2^(2*h) := by rw [two_mul, pow_add, pow_two]
  rw [hp] at top
  have bit (i : ℕ) : c.testBit (2*h+i) = (acsFlags z sa off d).testBit i := by
    rw [Nat.add_comm (2*h), ← Nat.testBit_div_two_pow, top]
  obtain ⟨_,z0,s1,o2,d3⟩ := acsFlagBits z sa off d
  change acsEmit N M c s t ok = _
  unfold acsEmit
  refold_let h
  have b0 : c.testBit (2*h) = z := by simpa only [Nat.add_zero, z0] using bit 0
  have xa : Nat.xor (N+M) (A ^^^ (N+M)) = A := acsXorCancel _ _
  have xb : Nat.xor (N+M) (B ^^^ (N+M)) = B := acsXorCancel _ _
  simp only [lo, mid, xa, xb, b0, bit 1, bit 2, bit 3, s1, o2, d3, rowI]

theorem acsPackVal {N M A B : ℕ} (hA : A < 2^bIC N M) (hB : B < 2^bIC N M) (z : Bool) :
    (encP (pack N M A B z) false).val =
    A + 2^(bIC N M)*B + 2^(2*bIC N M)*bnS z := by
  simp [encP, pack, encC, hA, hB, Nat.mod_eq_of_lt, bnS]

theorem acsEmitRows {N M : ℕ} [NeZero N] (thc : THCFactorization N M) (D : CData N M)
    (l : Option (Label N M)) (s t : Fin 2) (ok : Bool) :
    acsEmit N M (descS thc D l) (decide (s.val = 1)) (decide (t.val = 1)) ok =
    (encP (readRows thc D (pack N M) (if ok then l else none) s t) false).val := by
  classical
  have hJ := (acsWidth N M).2
  have hr := rows_le_bIC N M
  have hI : rowI N M < 2^bIC N M := by unfold rowI; omega
  have hnull : descS thc D none = acsEncode (highBitsS N M) (N+M) (N+M) (N+M)
      false false false false := by simp [descS, acsEncode, acsPack3, acsFlags, bnS, Nat.xor_self]
  rcases l with _ | (i | ⟨⟨i,j⟩, hij⟩)
  · rw [hnull, acsEmitEncode hJ hJ]
    cases ok <;> simp [readRows, acsPackVal hI hI, bnS, rowI]
  · have hi := i.isLt
    have ed : descS thc D (some (.inl i)) =
        acsEncode (highBitsS N M) (N+M) i.val (N+M) (decide (0 ≤ D.t i)) true false false := rfl
    rw [ed, acsEmitEncode (N := N) (M := M) (A := i.val) (by omega) hJ]
    fin_cases s <;> cases ok <;>
      simp (disch := omega) [readRows, acsPackVal, bnS, rowI]
  · have hi := i.isLt
    have hj := j.isLt
    have ed : descS thc D (some (.inr ⟨(i,j),hij⟩)) =
        acsEncode (highBitsS N M) (N+M) (N+i.val) (N+j.val) (decide (thc.zeta i j < 0))
          (decide (i≠j)) (decide (i≠j)) (decide (i=j)) := rfl
    rw [ed, acsEmitEncode (N := N) (M := M) (A := N+i.val) (B := N+j.val) (by omega) (by omega)]
    -- CHECK E2: normalize the twoValue row addresses before reducing pack.
    by_cases hij' : i = j <;> fin_cases s <;> fin_cases t <;> cases ok <;>
      simp (disch := omega) [readRows, twoValue, hij', acsPackVal, rowI, bnS,
        Nat.mul_add, Nat.add_assoc] <;> omega

theorem acsChosenPack {L a p b k ticket : ℕ} (hp : p < 2^L) (hb : b < 2^L) (hk : k < 2^a) :
    acsChosen L a (acsPack3 L b (Nat.xor p b) k) ticket =
      if ticket % 2^a < k then p else b := by
  obtain ⟨h0,h1,h2⟩ := acsFields (y := Nat.xor p b) (k := k) hb (Nat.xor_lt_two_pow hp hb)
  simp only [acsChosen, h0,h1,h2,Nat.mod_eq_of_lt hk,acsXorCancel]

-- CHECK: column-wise identification holds for arbitrary D by rowWordS normalization.
theorem rowWordS_spec {N M : ℕ} [NeZero N] (thc : THCFactorization N M)
    (D : CData N M) (a : ℕ) (σ : Fin (2 ^ gP N M a)) :
    rowWordS thc D a (slotS N M σ.val) < 2 ^ wordBitsS N M a ∧
    outNatS N M a (rowWordS thc D a (slotS N M σ.val)) σ.val = (spatialF thc D a σ).val := by
  classical
  let p := (seedEquiv N M a).symm σ
  let x := slotS N M σ.val
  let u := σ.val / 2^(2+slotBitsS N M)
  let L := descBitsS N M
  let w := rowWordS thc D a x
  let tab := AliasPort.aliasTable (2^a) (dC N M) (tableMass D) x.val
  let pri := labelAt N M x.val
  let alt := labelAt N M tab.2
  obtain ⟨hr,hs,ht⟩ := acsSeed σ
  have hx : p.1.val % slots N M = x.val := by rw [hr] <;> rfl
  have hu : p.1.val / slots N M = u := by
    rw [hr, Nat.div_div_eq_div_mul]
    simp only [u, pow_add, slotBitsS, slots] <;> rfl
  have hsb : σ.val.testBit 1 = decide (p.2.1.val = 1) := by rw [hs, Nat.testBit_eq_decide_div_mod_eq] <;> rfl
  have htb : σ.val.testBit 0 = decide (p.2.2.val = 1) := by rw [ht, Nat.testBit_zero]
  let ok := decide (u < 2^a)
  have eval (l : Option (Label N M)) :
      acsEmit N M (descS thc D l) (σ.val.testBit 1) (σ.val.testBit 0) ok =
      (encP (readRows thc D (pack N M) (if ok then l else none) p.2.1 p.2.2) false).val := by
    rw [hsb, htb]; exact acsEmitRows thc D l _ _ _
  by_cases valid : 0 < lamRepC thc D.t ∧ x.val < dC N M
  · let normAlt := if tab.1 < 2^a then alt else pri
    let k := if tab.1 < 2^a then tab.1 else 0
    have hk : k < 2^a := by dsimp [k]; split <;> first | assumption | exact Nat.two_pow_pos _
    have hw : w = acsPack3 L (descS thc D normAlt)
        (Nat.xor (descS thc D pri) (descS thc D normAlt)) k := by
      simp only [w, rowWordS, if_pos valid]
      refold_let tab pri alt
      by_cases e : tab.1 < 2^a <;> simp [e, acsPack3, normAlt, k, L]
    have hpri := acsDescLt thc D pri
    have halt := acsDescLt thc D normAlt
    change w < 2^(2*L+a) ∧ outNatS N M a w σ.val = _
    constructor
    · rw [hw]; exact acsPackLt halt (Nat.xor_lt_two_pow hpri halt) hk
    · rw [acsOut, hw, acsChosenPack hpri halt hk]
      change acsEmit N M (if u % 2^a < k then descS thc D pri else descS thc D normAlt)
        _ _ ok = _
      -- CHECK R1: identify the threshold-normalized choice with the actual alias tag.
      rw [← apply_ite (descS thc D), eval]
      change (encP (readRows _ _ _ _ _ _) false).val =
        (encP (readRows _ _ _ (tag thc D a p.1) _ _) false).val
      have e : (if ok then (if u % 2^a < k then pri else normAlt) else none) = tag thc D a p.1 := by
        unfold tag
        rw [hx, hu]
        by_cases hu' : u < 2^a
        · by_cases hth : tab.1 < 2^a
          · have hout : AliasPort.aliasOut (2^a) (dC N M) (tableMass D) x.val u =
                (if u < tab.1 then x.val else tab.2) := rfl
            have hvalid : 0 < lamRepC thc D.t ∧ x.val < dC N M ∧ u < 2^a :=
              ⟨valid.1, valid.2, hu'⟩
            simp only [ok, decide_eq_true_eq, if_pos hu', if_pos hvalid, Nat.mod_eq_of_lt hu',
              k, normAlt, if_pos hth, hout]
            by_cases keep : u < tab.1
            · simp only [if_pos keep, pri]
            · simp only [if_neg keep, alt]
          · have hlt : u < tab.1 := by omega
            simp [ok, hu', k, normAlt, hth, valid.1, valid.2, AliasPort.aliasOut, pri, tab,
              show u < (AliasPort.aliasTable (2^a) (dC N M) (tableMass D) x.val).1 from hlt]
        · simp [ok, hu']
      rw [e]
  · have hw : w = 0 := by simp [w, rowWordS, valid]
    have hn : tag thc D a p.1 = none := by
      unfold tag; rw [hx, hu]; exact if_neg (fun h ↦ valid ⟨h.1,h.2.1⟩)
    constructor
    · change w < _; rw [hw]; exact Nat.two_pow_pos _
    · change outNatS N M a w σ.val = (encP (readRows _ _ _ (tag thc D a p.1) _ _) false).val
      rw [hw, hn, acsOut]
      simpa [acsChosen, descS, ok, u] using eval none

section Decoder
variable {n N M a : ℕ} [NeZero N]
variable (idx : QRegister (bP N M) n) (seed : QRegister (gP N M a) n)
  (raw : QRegister (wordBitsS N M a) n) (work : QRegister (decWorkS N M a) n)

/-- CHECK: all four slices are distinct, including the shared clean toffW wire. -/
structure DecDisj : Prop where
  iseed : idx.DisjointWires seed
  iraw : idx.DisjointWires raw
  iwork : idx.DisjointWires work
  sr : seed.DisjointWires raw
  sw : seed.DisjointWires work
  rwires : raw.DisjointWires work

inductive acsPin where
  | I (j : ℕ) | S (j : ℕ) | R (j : ℕ) | W (j : ℕ)
  deriving DecidableEq

def acsValid (N M a : ℕ) : acsPin → Prop
  | .I j => j < bP N M
  | .S j => j < gP N M a
  | .R j => j < wordBitsS N M a
  | .W j => j < decWorkS N M a

def acsAt {k n : ℕ} (r : QRegister k n) (j : ℕ) (hk : 0 < k) :=
  r ⟨j % k, Nat.mod_lt _ hk⟩

def acsPlace : acsPin → Wire n
  | .I j => acsAt idx j (by unfold bP; omega)
  | .S j => acsAt seed j (by rw [acsSeedWidth]; omega)
  | .R j => acsAt raw j (by unfold wordBitsS descBitsS; omega)
  | .W j => acsAt work j (by unfold decWorkS; omega)

theorem acsApart (hd : DecDisj idx seed raw work) {u v : acsPin}
    (hu : acsValid N M a u) (hv : acsValid N M a v) (hne : u ≠ v) :
    acsPlace idx seed raw work u ≠ acsPlace idx seed raw work v := by
  -- CHECK P1: reduce register coercions and use the six disjointness fields.
  cases u <;> cases v <;> simp only [acsValid] at hu hv <;> unfold acsPlace acsAt <;>
    first
    | exact hd.iseed.ne _ _
    | exact (hd.iseed.ne _ _).symm
    | exact hd.iraw.ne _ _
    | exact (hd.iraw.ne _ _).symm
    | exact hd.iwork.ne _ _
    | exact (hd.iwork.ne _ _).symm
    | exact hd.sr.ne _ _
    | exact (hd.sr.ne _ _).symm
    | exact hd.sw.ne _ _
    | exact (hd.sw.ne _ _).symm
    | exact hd.rwires.ne _ _
    | exact (hd.rwires.ne _ _).symm
    | intro e
      apply hne
      congr 1
      first
      | simpa [Nat.mod_eq_of_lt hu, Nat.mod_eq_of_lt hv] using congrArg Fin.val (idx.wires.injective e)
      | simpa [Nat.mod_eq_of_lt hu, Nat.mod_eq_of_lt hv] using congrArg Fin.val (seed.wires.injective e)
      | simpa [Nat.mod_eq_of_lt hu, Nat.mod_eq_of_lt hv] using congrArg Fin.val (raw.wires.injective e)
      | simpa [Nat.mod_eq_of_lt hu, Nat.mod_eq_of_lt hv] using congrArg Fin.val (work.wires.injective e)

/-- Active scratch cells end just before the clean Toffoli helper. Carries follow it. -/
def acsEnd (N M a : ℕ) := descBitsS N M + 5 + extraS N M a

def acsCmp (hd : DecDisj idx seed raw work) : AliasCircuit.CmpW n a := by
  let p := acsPlace idx seed raw work
  let m := slotBitsS N M
  let L := descBitsS N M
  let E := acsEnd N M a
  have hs := acsSeedWidth N M a
  refine {
    rf := fun i => p (.S (2+m+i))
    Kf := fun i => p (.R (2*L+i))
    cf := fun i => p (.W (E+1+i))
    fl := p (.W 0)
    wk := p (.W E)
    rK := fun i j hi hj => ?_, rc := fun i j hi hj => ?_, Kc := fun i j hi hj => ?_
    cc := fun i j hi hj hn => ?_, rwk := fun i hi => ?_, Kwk := fun i hi => ?_
    cwk := fun j hj => ?_, fr := fun i hi => ?_, fK := fun i hi => ?_
    fc := fun j hj => ?_, fw := ?_ }
  all_goals
    apply acsApart idx seed raw work hd <;>
      simp [acsValid, m, L, E, acsEnd, wordBitsS, decWorkS] at * <;> omega

inductive acsTerm where
  | x | cx (u : acsPin) | cc (u v : acsPin)

def acsTermVal (f : acsPin → ZMod 2) : acsTerm → ZMod 2
  | .x => 1
  | .cx u => f u
  | .cc u v => f u * f v

def acsTermCost : acsTerm → ℕ
  | .cc _ _ => 8
  | _ => 0

def acsTermGate (p : acsPin → Wire n) (t w : Wire n) : acsTerm → Circuit n
  | .x => Circuit.X t
  | .cx u => if h : p u ≠ t then Circuit.CNOT (p u) t h else .identity
  | .cc u v =>
    if h : p u ≠ p v ∧ p u ≠ w ∧ p v ≠ w ∧ t ≠ w then
      PairProgram.toffW (p u) (p v) t w h.1 h.2.1 h.2.2.1 h.2.2.2
    else .identity

def acsLine (p : acsPin → Wire n) (t w : Wire n) : List acsTerm → Circuit n
  | [] => .identity
  | g :: gs => .seq (acsTermGate p t w g) (acsLine p t w gs)

/-- Every control has its reference value on the physical wire and is distinct from the target. -/
def acsReady (p : acsPin → Wire n) (t w : Wire n) (β : BitAssignment n) (f : acsPin → ZMod 2) :
    acsTerm → Prop
  | .x => True
  | .cx u => p u ≠ t ∧ β (p u) = f u
  | .cc u v => (p u ≠ t ∧ β (p u) = f u) ∧ (p v ≠ t ∧ β (p v) = f v) ∧
      p u ≠ p v ∧ p u ≠ w ∧ p v ≠ w

theorem acsLineKet (p : acsPin → Wire n) (t w : Wire n) (f : acsPin → ZMod 2)
    (gs : List acsTerm) (β : BitAssignment n) (hw : β w = 0) (htw : t ≠ w)
    (hr : ∀ g ∈ gs, acsReady p t w β f g) :
    (acsLine p t w gs).eval.1 *ᵥ ket β =
      ket (Function.update β t (β t + (gs.map (acsTermVal f)).sum)) := by
  induction gs generalizing β with
  | nil =>
    simp only [acsLine, Circuit.eval_identity, Submonoid.coe_one, Matrix.one_mulVec,
      List.map_nil, List.sum_nil, add_zero, Function.update_eq_self]
  | cons g gs ih =>
    have hg := hr g (by simp)
    let β' := Function.update β t (β t + acsTermVal f g)
    have hfirst : (acsTermGate p t w g).eval.1 *ᵥ ket β = ket β' := by
      cases g with
      | x => simpa [acsTermGate, β', acsTermVal, add_comm] using ket_X t β
      | cx u => simpa [acsTermGate, hg.1, β', acsTermVal, hg.2, add_comm] using ket_CNOT (p u) t hg.1 β
      | cc u v =>
        obtain ⟨⟨hut,hu⟩,⟨hvt,hv⟩,huv,huw,hvw⟩ := hg
        simpa [acsTermGate, huv, huw, hvw, htw, β', acsTermVal, hu, hv] using
          AliasCircuit.toffW_ket (p u) (p v) t w huv huw hvw htw hut hvt β hw
    have hrest : ∀ q ∈ gs, acsReady p t w β' f q := by
      intro q hq
      have h := hr q (List.mem_cons_of_mem _ hq)
      cases q with
      | x => trivial
      | cx u => exact ⟨h.1, by simpa [β', Function.update_of_ne h.1] using h.2⟩
      | cc u v =>
        obtain ⟨⟨hut,hu⟩,⟨hvt,hv⟩,rest⟩ := h
        exact ⟨⟨hut, by simpa [β', Function.update_of_ne hut] using hu⟩,
          ⟨hvt, by simpa [β', Function.update_of_ne hvt] using hv⟩, rest⟩
    rw [acsLine, seq_mulVec, hfirst, ih β' (by simpa [β', Function.update_of_ne htw.symm] using hw) hrest]
    simp [β', Function.update_idem, add_assoc]

theorem acsLineCount (p : acsPin → Wire n) (t w : Wire n) (gs : List acsTerm) :
    (acsLine p t w gs).count PrimitiveGate.TOFF = 0 ∧
    (acsLine p t w gs).count PrimitiveGate.T ≤ (gs.map acsTermCost).sum := by
  induction gs with
  | nil => simp [acsLine]
  | cons g gs ih =>
    obtain ⟨hO,hT⟩ := ih
    suffices h : (acsTermGate p t w g).count PrimitiveGate.TOFF = 0 ∧
        (acsTermGate p t w g).count PrimitiveGate.T ≤ acsTermCost g by
      constructor
      · simp only [acsLine, Circuit.count_seq, h.1, hO, zero_add]
      · simp only [acsLine, Circuit.count_seq, List.map_cons, List.sum_cons]
        exact Nat.add_le_add h.2 hT
    cases g with
    | x => simp [acsTermGate, acsTermCost]
    | cx u =>
      by_cases h : p u ≠ t
      · simp only [acsTermGate, dif_pos h, acsTermCost] <;> simp
      · simp only [acsTermGate, dif_neg h, acsTermCost] <;> simp
    | cc u v =>
      by_cases h : p u ≠ p v ∧ p u ≠ w ∧ p v ≠ w ∧ t ≠ w
      · simp only [acsTermGate, dif_pos h, acsTermCost]
        obtain ⟨ho,ht⟩ := AliasCircuit.toffW_count (p u) (p v) t w h.1 h.2.1 h.2.2.1 h.2.2.2
        exact ⟨ho, ht.le⟩
      · simp only [acsTermGate, dif_neg h, acsTermCost] <;> simp

/-- Cell zero holds the comparator result. Cells 1..L hold the chosen descriptor.
The next cells are spin equality, spin A, spin B, and the successive enable flags. -/
def acsOps (h L m a j : ℕ) : List acsTerm :=
  if j ≤ L then [.cx (.R (j-1)), .cc (.W 0) (.R (L+(j-1)))]
  else if j = L+1 then [.x, .cx (.S 0), .cx (.S 1)]
  else if j = L+2 then [.cc (.S 1) (.W (1+(2*h+1)))]
  else if j = L+3 then [.cx (.W (1+(2*h+3))), .cc (.S 0) (.W (1+(2*h+2)))]
  else if j = L+4 then [.x, .cc (.W (1+(2*h+3))) (.W (L+1))]
  else [.cx (.W (j-1)), .cc (.W (j-1)) (.S (2+m+a+(j-(L+5))))]

def acsOutSrc (h L k j : ℕ) : ℕ :=
  if j = 0 then L+2 else if j < k then 1+(j-1)
  else if j = k then L+3 else if j < 2*k then 1+(h+(j-k-1)) else 1+2*h

def acsBaseBit (J k j : ℕ) : Bool :=
  if j < k then (2*J).testBit j else if j < 2*k then (2*J).testBit (j-k) else false

def acsWrites (N M a j : ℕ) : List acsTerm :=
  let h := highBitsS N M
  let k := bIC N M
  let l := descBitsS N M
  let g := acsTerm.cc (.W (l+4+extraS N M a)) (.W (acsOutSrc h l k j))
  if acsBaseBit (N+M) k j then [.x,g] else [g]

def acsLoop (step : ℕ → Circuit n) : ℕ → Circuit n
  | 0 => .identity
  | j+1 => .seq (acsLoop step j) (step j)

def acsStep (hd : DecDisj idx seed raw work) (j : ℕ) : Circuit n :=
  let p := acsPlace idx seed raw work
  if j = 0 then (acsCmp idx seed raw work hd).cmp else
    acsLine p (p (.W j)) (p (.W (acsEnd N M a)))
      (acsOps (highBitsS N M) (descBitsS N M) (slotBitsS N M) a j)

def acsWrite (j : ℕ) : Circuit n :=
  let p := acsPlace idx seed raw work
  acsLine p (p (.I j)) (p (.W (acsEnd N M a))) (acsWrites N M a j)

def decodeS {n N M a : ℕ} [NeZero N] (idx : QRegister (bP N M) n)
    (seed : QRegister (gP N M a) n) (raw : QRegister (wordBitsS N M a) n)
    (work : QRegister (decWorkS N M a) n) (hd : DecDisj idx seed raw work) : Circuit n := by
  let V := acsLoop (acsStep idx seed raw work hd) (acsEnd N M a)
  let O := acsLoop (acsWrite idx seed raw work) (2*bIC N M+1)
  exact .seq V (.seq O V.inverse)

variable (hd : DecDisj idx seed raw work)

def acsB (b : Bool) : ZMod 2 := if b then 1 else 0

theorem acsBit (x j : ℕ) : AliasCircuit.bitN x j = acsB (x.testBit j) := by
  unfold AliasCircuit.bitN
  rw [← Nat.toNat_testBit]
  cases x.testBit j <;> rfl

theorem acsBoolAnd (u v : Bool) : acsB (u && v) = acsB u * acsB v := by
  cases u <;> cases v <;> decide

theorem acsBoolXor (u v : Bool) : acsB (u ^^ v) = acsB u + acsB v := by
  cases u <;> cases v <;> decide

theorem acsBoolEq (s t : Bool) : acsB (s == t) = 1 + (acsB t + acsB s) := by
  cases s <;> cases t <;> decide

theorem acsBoolNot (b : Bool) : acsB (!b) = 1 + acsB b := by cases b <;> decide

theorem acsBoolKeep (b v : Bool) : acsB (b && !v) = acsB b + acsB b * acsB v := by
  cases b <;> cases v <;> decide

def acsFlag (L m a w σ : ℕ) :=
  decide (σ / 2^(2+m) % 2^a < w / (2^L)^2 % 2^a)

def acsC (L m a w σ : ℕ) := acsChosen L a w (σ / 2^(2+m))

theorem acsCBit {L m a w σ j : ℕ} (hj : j < L) :
    acsB ((acsC L m a w σ).testBit j) = acsB (w.testBit j) +
      acsB (acsFlag L m a w σ) * acsB (w.testBit (L+j)) := by
  unfold acsC acsChosen acsFlag
  split <;> rename_i h
  · simp [h, Nat.testBit_mod_two_pow, hj, Nat.testBit_div_two_pow, Nat.add_comm j L,
      acsBoolXor, show acsB true = 1 from rfl]
  · simp [h, Nat.testBit_mod_two_pow, hj, show acsB false = 0 from rfl]

def acsClear (x i : ℕ) := decide (x % 2^i = 0)

theorem acsClearSucc (x i : ℕ) : acsClear x (i+1) = (acsClear x i && !x.testBit i) := by
  have hp := Nat.two_pow_pos i
  have hb := Nat.mod_two_eq_zero_or_one (x / 2^i)
  simp only [acsClear, Nat.mod_pow_succ, Nat.testBit_eq_decide_div_mod_eq,
    Nat.add_eq_zero_iff, Nat.mul_eq_zero, Nat.ne_of_gt hp, false_or]
  rcases hb with h | h <;> simp [h]

def acsLive (h c : ℕ) (s t : Bool) := !(c.testBit (2*h+3) && (s == t))

def acsWorkBit (h L m a w σ j : ℕ) : Bool :=
  let c := acsC L m a w σ
  let s := σ.testBit 1
  let t := σ.testBit 0
  if j = 0 then acsFlag L m a w σ else if j ≤ L then c.testBit (j-1)
  else if j = L+1 then s == t
  else if j = L+2 then s && c.testBit (2*h+1)
  else if j = L+3 then (t && c.testBit (2*h+2)) ^^ c.testBit (2*h+3)
  else acsLive h c s t && acsClear (σ / 2^(2+m+a)) (j-(L+4))

def acsRef (N M a w σ : ℕ) : acsPin → ZMod 2
  | .W j => acsB (acsWorkBit (highBitsS N M) (descBitsS N M) (slotBitsS N M) a w σ j)
  | .S j => acsB (σ.testBit j)
  | .R j => acsB (w.testBit j)
  | .I _ => 0

theorem acsCell (N M a w σ j : ℕ) (hj : 0 < j) :
    ((acsOps (highBitsS N M) (descBitsS N M) (slotBitsS N M) a j).map
      (acsTermVal (acsRef N M a w σ))).sum = acsRef N M a w σ (.W j) := by
  let h := highBitsS N M
  let L := descBitsS N M
  let m := slotBitsS N M
  let c := acsC L m a w σ
  let f := acsRef N M a w σ
  -- CHECK W1: the instruction list reads only earlier scratch cells.
  have hL : L = 2*h+4 := rfl
  have f0 : f (.W 0) = acsB (acsFlag L m a w σ) := by simp [f, acsRef, acsWorkBit, L, m]
  have fs (i : ℕ) : f (.S i) = acsB (σ.testBit i) := rfl
  have fd (i : ℕ) (hi : i < L) : f (.W (1+i)) = acsB (c.testBit i) := by
    change acsB (acsWorkBit h L m a w σ (1+i)) = _
    simp only [acsWorkBit, if_neg (by omega : 1+i ≠ 0), if_pos (by omega : 1+i ≤ L),
      show 1+i-1=i by omega, c]
  have fe : f (.W (L+1)) = acsB ((σ.testBit 1) == (σ.testBit 0)) := by
    change acsB (acsWorkBit h L m a w σ (L+1)) = _
    simp (disch := omega) [acsWorkBit]
  have fa : f (.W (L+2)) = acsB ((σ.testBit 1) && c.testBit (2*h+1)) := by
    change acsB (acsWorkBit h L m a w σ (L+2)) = _
    simp (disch := omega) [acsWorkBit, c]
  have fb : f (.W (L+3)) =
      acsB (((σ.testBit 0) && c.testBit (2*h+2)) ^^ c.testBit (2*h+3)) := by
    change acsB (acsWorkBit h L m a w σ (L+3)) = _
    simp (disch := omega) [acsWorkBit, c]
  have fg : f (.W (L+4)) = acsB (acsLive h c (σ.testBit 1) (σ.testBit 0)) := by
    change acsB (acsWorkBit h L m a w σ (L+4)) = _
    simp (disch := omega) [acsWorkBit, acsClear, Nat.mod_one, c]
  change ((acsOps h L m a j).map (acsTermVal f)).sum = f (.W j)
  by_cases h1 : j ≤ L
  · have hd : j = 1+(j-1) := by omega
    have hv := fd (j-1) (by omega)
    rw [← hd] at hv
    simp only [acsOps, if_pos h1, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
      add_zero, acsTermVal, f0, hv]
    exact (acsCBit (L := L) (m := m) (a := a) (w := w) (σ := σ) (by omega : j-1 < L)).symm
  · by_cases h2 : j = L+1
    · subst j
      simp (disch := omega) [acsOps, fe, fs, acsTermVal, acsBoolEq]
    by_cases h3 : j = L+2
    · subst j
      simp (disch := omega) [acsOps, acsTermVal, fd, fa, fs, acsBoolAnd]
    by_cases h4 : j = L+3
    · subst j
      simp only [acsOps, if_neg h1, if_neg h2, if_neg h3, if_pos rfl, ↓reduceIte, List.map_cons,
        List.map_nil, List.sum_cons, List.sum_nil, add_zero, acsTermVal, fb, fs,
        fd (2*h+3) (by omega), fd (2*h+2) (by omega), acsBoolXor, acsBoolAnd]
      exact add_comm _ _
    by_cases h5 : j = L+4
    · subst j
      simp only [acsOps, if_neg h1, if_neg h2, if_neg h3, if_neg h4, if_pos rfl, ↓reduceIte,
        List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero, acsTermVal,
        fd (2*h+3) (by omega), fe, fg, acsLive, acsBoolNot, acsBoolAnd]
    · let d := j-(L+5)
      let x := σ / 2^(2+m+a)
      let live := acsLive h c (σ.testBit 1) (σ.testBit 0)
      have hv (q : ℕ) (hq : L+4 ≤ q) :
          f (.W q) = acsB (live && acsClear x (q-(L+4))) := by
        simp only [f, acsRef, acsWorkBit]
        refold_let L
        simp only [if_neg (by omega : q ≠ 0), if_neg (by omega : ¬ q ≤ L),
          if_neg (by omega : q ≠ L+1), if_neg (by omega : q ≠ L+2), if_neg (by omega : q ≠ L+3)]
        rfl
      have ex : σ.testBit (2+m+a+d) = x.testBit d := by
        rw [Nat.add_comm (2+m+a), ← Nat.testBit_div_two_pow]
      have q1 : j-1-(L+4) = d := by dsimp [d]; omega
      have q2 : j-(L+4) = d+1 := by dsimp [d]; omega
      simp only [acsOps, if_neg h1, if_neg h2, if_neg h3, if_neg h4, if_neg h5,
        List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero, acsTermVal,
        hv _ (by omega : L+4 ≤ j-1), hv _ (by omega : L+4 ≤ j), q1, q2, acsClearSucc]
      change acsB (live && acsClear x d) + acsB (live && acsClear x d) *
        acsB (σ.testBit (2+m+a+d)) = _
      rw [ex, ← acsBoolKeep, Bool.and_assoc]

/-- Every control is an input or an already computed scratch bit. -/
def acsReadAt (N M a j : ℕ) : acsPin → Prop
  | .S i => i < gP N M a
  | .R i => i < wordBitsS N M a
  | .W i => i < j
  | .I _ => False

def acsLegal (P : acsPin → Prop) : acsTerm → Prop
  | .x => True
  | .cx u => P u
  | .cc u v => P u ∧ P v ∧ u ≠ v

theorem acsOpsLegal (N M a j : ℕ) [NeZero N] (hj : 0 < j) (he : j < acsEnd N M a) :
    ∀ g ∈ acsOps (highBitsS N M) (descBitsS N M) (slotBitsS N M) a j,
      acsLegal (acsReadAt N M a j) g := by
  have hs := acsSeedWidth N M a
  unfold acsOps
  split_ifs <;> simp [acsLegal, acsReadAt, acsEnd, wordBitsS, descBitsS] at * <;> omega

theorem acsWritesLegal (N M a j : ℕ) [NeZero N] (hj : j < 2*bIC N M+1) :
    ∀ g ∈ acsWrites N M a j, acsLegal (acsReadAt N M a (acsEnd N M a)) g := by
  have hk := (acsWidth N M).1
  let L := descBitsS N M
  let src := acsOutSrc (highBitsS N M) L (bIC N M) j
  have hs : src ≤ L+3 := by
    dsimp only [src, acsOutSrc]
    have hL : L = 2 * highBitsS N M + 4 := rfl
    split_ifs <;> omega
  let flag := L+4+extraS N M a
  have hflag : flag < acsEnd N M a := by
    change L+4+extraS N M a < L+5+extraS N M a
    omega
  have hlt : src < flag := by dsimp only [flag]; omega
  have hg : acsLegal (acsReadAt N M a (acsEnd N M a)) (.cc (.W flag) (.W src)) :=
    ⟨hflag, hlt.trans hflag, fun e => (Nat.ne_of_lt hlt) (acsPin.W.inj e).symm⟩
  have hx : acsLegal (acsReadAt N M a (acsEnd N M a)) .x := trivial
  intro g hm
  cases hb : acsBaseBit (N+M) (bIC N M) j with
  | false =>
    have e : g = .cc (.W flag) (.W src) := by simpa [acsWrites, hb, flag, src, L] using hm
    exact e.symm ▸ hg
  | true =>
    have e : g = .x ∨ g = .cc (.W flag) (.W src) := by
      simpa [acsWrites, hb, flag, src, L] using hm
    rcases e with rfl | rfl
    · exact hx
    · exact hg

theorem acsNatXor (s t : Bool) : Nat.xor (bnS s) (bnS t) = bnS (s ^^ t) := by
  cases s <;> cases t <;> decide

theorem acsNatBit (s : Bool) (j : ℕ) : (bnS s).testBit j = (s && decide (j=0)) := by
  cases s <;> cases j <;> simp [bnS, Nat.testBit_succ]

theorem acsPackedBit {k A B : ℕ} (hA : A < 2^k) (hB : B < 2^k) (z : Bool) (j : ℕ) :
    (A+2^k*B+2^(2*k)*bnS z).testBit j =
      if j < k then A.testBit j else if j < 2*k then B.testBit (j-k)
      else z && decide (j=2*k) := by
  have e : A+2^k*B+2^(2*k)*bnS z = 2^k*(2^k*bnS z+B)+A := by rw [two_mul, pow_add]; ring
  rw [e, Nat.testBit_two_pow_mul_add _ hA]
  by_cases h : j < k
  · simp [h]
  · rw [if_neg h, if_neg h, Nat.testBit_two_pow_mul_add _ hB]
    have h' : j-k < k ↔ j < 2*k := by omega
    by_cases h2 : j < 2*k
    · simp [h', h2]
    · have h3 : j-k-k = 0 ↔ j=2*k := by omega
      simp [h', h2, acsNatBit, h3]

theorem acsRowBit (J x j : ℕ) (en lo : Bool) :
    (if en then 2*Nat.xor J x+bnS lo else 2*J).testBit j =
      ((2*J).testBit j ^^ (en && (if j=0 then lo else x.testBit (j-1)))) := by
  cases en with
  | false => simp
  | true =>
    have hb : bnS lo < 2^1 := by cases lo <;> decide
    have h0 : (0:ℕ) < 2^1 := by decide
    have a := Nat.testBit_two_pow_mul_add (Nat.xor J x) hb j
    have b := Nat.testBit_two_pow_mul_add J h0 j
    simp only [Nat.reducePow, Nat.add_zero] at a b
    simp only [if_true, Bool.true_and, a, b]
    by_cases e : j=0
    · subst j; cases lo <;> simp [bnS]
    · simp [show ¬ j < 1 by omega, e, Nat.testBit_xor]

def acsMask (h k c j : ℕ) (s t : Bool) :=
  if j=0 then s && c.testBit (2*h+1) else if j<k then c.testBit (j-1)
  else if j=k then (t && c.testBit (2*h+2)) ^^ c.testBit (2*h+3)
  else if j<2*k then c.testBit (h+(j-k-1)) else c.testBit (2*h)

theorem acsRowBound {h J : ℕ} (hJ : J < 2^h) (x : ℕ) (l : Bool) :
    2 * Nat.xor J (x % 2^h) + bnS l < 2^(h+1) := by
  have hx : Nat.xor J (x % 2^h) < 2^h :=
    Nat.xor_lt_two_pow hJ (Nat.mod_lt x (Nat.two_pow_pos h))
  have hl : bnS l ≤ 1 := by cases l <;> decide
  rw [pow_succ]
  omega

theorem acsEmitBit {N M : ℕ} [NeZero N] (c j : ℕ) (s t ok : Bool) (hj : j < 2*bIC N M+1) :
    let h := highBitsS N M
    let k := bIC N M
    (acsEmit N M c s t ok).testBit j = (acsBaseBit (N+M) k j ^^
      ((ok && acsLive h c s t) && acsMask h k c j s t)) := by
  let h := highBitsS N M
  let k := bIC N M
  let J := N+M
  let d := c.testBit (2*h+3)
  let en := ok && acsLive h c s t
  let alo := s && c.testBit (2*h+1)
  let blo := (t && c.testBit (2*h+2)) ^^ d
  let A := if en then 2*Nat.xor J (c % 2^h)+bnS alo else 2*J
  let B := if en then 2*Nat.xor J (c / 2^h % 2^h)+bnS blo else 2*J
  have hk : k = h+1 := (acsWidth N M).1
  have hJ : J < 2^h := (acsWidth N M).2
  have hr (x : ℕ) (l : Bool) : (if en then 2*Nat.xor J (x%2^h)+bnS l else 2*J) < 2^k := by
    rw [hk]
    split
    · exact acsRowBound hJ x l
    · rw [pow_succ]; omega
  -- CHECK O2: both row fields fit k bits before their sign bit is extracted.
  have hen : (ok = true ∧ ¬ (d=true ∧ s=t)) ↔ en = true := by
    dsimp [en, acsLive]; refold_let d
    cases ok <;> cases d <;> cases s <;> cases t <;> decide
  have he : acsEmit N M c s t ok = A+2^k*B+2^(2*k)*bnS (en && c.testBit (2*h)) := by
    have hcond : (ok = true ∧ ¬ (c.testBit (2 * highBitsS N M + 3) = true ∧ s = t)) =
        (en = true) := propext hen
    simp only [acsEmit, hcond, acsNatXor]
    change A + 2^k*B + 2^(2*k)*(if en then bnS (c.testBit (2*h)) else 0) = _
    have hz (u v : Bool) : (if u then bnS v else 0) = bnS (u && v) := by
      cases u <;> rfl
    rw [hz]
  rw [he, acsPackedBit (hr c alo) (hr (c/2^h) blo)]
  change (if j<k then A.testBit j else if j<2*k then B.testBit (j-k) else
    (en && c.testBit (2*h)) && decide (j=2*k)) = (acsBaseBit J k j ^^ (en && acsMask h k c j s t))
  by_cases ja : j < k
  · by_cases j0 : j=0
    · simp only [acsBaseBit, acsMask, if_pos ja, A, acsRowBit, if_pos j0, alo]
    · have hm : (c % 2^h).testBit (j-1) = c.testBit (j-1) := by
        simp [Nat.testBit_mod_two_pow, show j-1<h by omega]
      simp only [acsBaseBit, acsMask, if_pos ja, A, acsRowBit, if_neg j0, hm]
  · by_cases jb : j < 2*k
    · have j0 : j ≠ 0 := by omega
      by_cases jk : j=k
      · have jlo : j-k=0 := by omega
        simp only [acsBaseBit, acsMask, if_neg j0, if_neg ja, if_pos jb, if_pos jk,
          B, acsRowBit, if_pos jlo, blo, d]
      · have jhi : j-k≠0 := by omega
        have hm : (c / 2^h % 2^h).testBit (j-k-1) = c.testBit (h+(j-k-1)) := by
          simp only [Nat.testBit_mod_two_pow, decide_eq_true (by omega : j-k-1<h),
            Bool.true_and, Nat.testBit_div_two_pow, Nat.add_comm (j-k-1) h]
        simp only [acsBaseBit, acsMask, if_neg j0, if_neg ja, if_pos jb, if_neg jk,
          B, acsRowBit, if_neg jhi, hm]
    · have je : j=2*k := by change j < 2*k+1 at hj; omega
      have j0 : j≠0 := by omega
      have jk : j≠k := by omega
      simp only [acsBaseBit, acsMask, if_neg ja, if_neg jb, if_neg j0, if_neg jk,
        decide_eq_true je, Bool.and_true, Bool.false_xor]

theorem acsLast (N M a w σ : ℕ) [NeZero N] (hσ : σ < 2^gP N M a) :
    acsWorkBit (highBitsS N M) (descBitsS N M) (slotBitsS N M) a w σ
        (descBitsS N M+4+extraS N M a) =
      (decide (σ / 2^(2+slotBitsS N M) < 2^a) &&
        acsLive (highBitsS N M) (acsC (descBitsS N M) (slotBitsS N M) a w σ)
          (σ.testBit 1) (σ.testBit 0)) := by
  let m := slotBitsS N M
  let e := extraS N M a
  let L := descBitsS N M
  let x := σ / 2^(2+m+a)
  have hx : x < 2^e := by
    apply (Nat.div_lt_iff_lt_mul (Nat.two_pow_pos _)).2
    rw [Nat.mul_comm, ← pow_add]; simpa only [acsSeedWidth N M a] using hσ
  have hx0 : x = 0 ↔ σ / 2^(2+m) < 2^a := by
    dsimp [x]
    rw [pow_add, ← Nat.div_div_eq_div_mul]
    exact Nat.div_eq_zero_iff_lt (Nat.two_pow_pos _)
  have s0 : L+4+e ≠ 0 := by omega
  have s1 : ¬ L+4+e ≤ L := by omega
  have s2 : L+4+e ≠ L+1 := by omega
  have s3 : L+4+e ≠ L+2 := by omega
  have s4 : L+4+e ≠ L+3 := by omega
  simp only [acsWorkBit]; refold_let L e m x
  simp only [if_neg s0, if_neg s1, if_neg s2, if_neg s3, if_neg s4,
    show L+4+e-(L+4)=e by omega, acsClear, Nat.mod_eq_of_lt hx, hx0, Bool.and_comm]

theorem acsMaskSrc (N M a w σ j : ℕ) [NeZero N] (hj : j < 2*bIC N M+1) :
    let h := highBitsS N M
    let L := descBitsS N M
    let k := bIC N M
    acsRef N M a w σ (.W (acsOutSrc h L k j)) =
      acsB (acsMask h k (acsC L (slotBitsS N M) a w σ) j (σ.testBit 1) (σ.testBit 0)) := by
  let h := highBitsS N M
  let L := descBitsS N M
  let k := bIC N M
  have hk : k = h+1 := (acsWidth N M).1
  have hl : L = 2*h+4 := rfl
  let c := acsC L (slotBitsS N M) a w σ
  have hd (i : ℕ) (hi : i < L) : acsRef N M a w σ (.W (1+i)) = acsB (c.testBit i) := by
    change acsB (acsWorkBit h L _ a w σ (1+i)) = _
    simp only [acsWorkBit, if_neg (by omega : 1+i≠0), if_pos (by omega : 1+i≤L),
      show 1+i-1=i by omega, c]
  change acsRef _ _ _ _ _ (.W (acsOutSrc h L k j)) = acsB (acsMask h k c j _ _)
  unfold acsOutSrc acsMask
  split_ifs <;>
    first
    | exact hd _ (by omega)
    | simp (disch := omega) [acsRef, acsWorkBit, c, L, h]

theorem acsWriteVal (N M a w σ j : ℕ) [NeZero N] (hσ : σ < 2^gP N M a)
    (hj : j < 2*bIC N M+1) :
    ((acsWrites N M a j).map (acsTermVal (acsRef N M a w σ))).sum =
      AliasCircuit.bitN (outNatS N M a w σ) j := by
  let c := acsC (descBitsS N M) (slotBitsS N M) a w σ
  let ok := decide (σ / 2^(2+slotBitsS N M) < 2^a)
  let en := ok && acsLive (highBitsS N M) c (σ.testBit 1) (σ.testBit 0)
  let mask := acsMask (highBitsS N M) (bIC N M) c j (σ.testBit 1) (σ.testBit 0)
  let base := acsBaseBit (N+M) (bIC N M) j
  let u := acsPin.W (descBitsS N M+4+extraS N M a)
  let v := acsPin.W (acsOutSrc (highBitsS N M) (descBitsS N M) (bIC N M) j)
  let f := acsRef N M a w σ
  have hout : AliasCircuit.bitN (outNatS N M a w σ) j = acsB (base ^^ (en && mask)) := by
    rw [acsBit, acsOut]
    exact congrArg acsB (acsEmitBit (N := N) (M := M) c j (σ.testBit 1) (σ.testBit 0) ok hj)
  have hu : f u = acsB en := congrArg acsB (acsLast N M a w σ hσ)
  have hv : f v = acsB mask := acsMaskSrc N M a w σ j hj
  rw [hout, acsBoolXor base (en && mask), acsBoolAnd en mask]
  change ((if base then [acsTerm.x, .cc u v] else [.cc u v]).map (acsTermVal f)).sum = _
  cases base <;> simp [acsTermVal, hu, hv, show acsB true = 1 from rfl,
    show acsB false = 0 from rfl]

theorem acsOrientation (N M a w σ : ℕ) [NeZero N] :
    AliasCircuit.bitN (outNatS N M a w σ) (2*bIC N M+1) = 0 := by
  let c := acsC (descBitsS N M) (slotBitsS N M) a w σ
  let h := highBitsS N M
  let k := bIC N M
  have hJ : N+M < 2^h := (acsWidth N M).2
  have hk : k = h+1 := (acsWidth N M).1
  have hr (x : ℕ) (l : Bool) : 2*Nat.xor (N+M) (x%2^h)+bnS l < 2^k := by
    rw [hk]
    exact acsRowBound hJ x l
  have hI : 2*(N+M) < 2^k := rows_le_bIC N M
  rw [acsBit, acsOut]
  change acsB ((acsEmit N M c _ _ _).testBit (2*k+1)) = 0
  simp only [acsEmit]
  refold_let h k
  rw [acsNatXor]
  split_ifs <;>
    first
    | rw [acsPackedBit (hr _ _) (hr _ _)]
      simp [acsB, show ¬ 2*k+1 < k by omega]
    | change acsB ((2*(N+M)+2^k*(2*(N+M))+2^(2*k)*bnS false).testBit (2*k+1)) = 0
      rw [acsPackedBit hI hI]
      simp [acsB, show ¬ 2*k+1 < k by omega]

/-- The accumulated XOR after writing the first j cells of one register. -/
def acsSum (place : ℕ → Wire n) (v : ℕ → ZMod 2) (j : ℕ) : BitAssignment n :=
  ∑ i ∈ range j, Pi.single (place i) (v i)

theorem acsSumOff (place : ℕ → Wire n) (v : ℕ → ZMod 2) (j : ℕ) (q : Wire n)
    (ho : ∀ i, i < j → q ≠ place i) : acsSum place v j q = 0 := by
  unfold acsSum
  rw [Finset.sum_apply]
  apply Finset.sum_eq_zero
  intro i hi
  rw [Pi.single_apply, if_neg (ho i (mem_range.mp hi))]

theorem acsSumOn (place : ℕ → Wire n) (v : ℕ → ZMod 2) {i j : ℕ} (hi : i < j)
    (hdist : ∀ k, k < j → k ≠ i → place i ≠ place k) :
    acsSum place v j (place i) = v i := by
  unfold acsSum
  rw [Finset.sum_apply, Finset.sum_eq_single i]
  · simp
  · intro k hk hki
    rw [Pi.single_apply, if_neg (hdist k (mem_range.mp hk) hki)]
  · intro hi'; exact (hi' (mem_range.mpr hi)).elim

theorem acsLoopKet (step : ℕ → Circuit n) (place : ℕ → Wire n) (v : ℕ → ZMod 2)
    (β : BitAssignment n) (m : ℕ)
    (hs : ∀ j, j < m →
      let γ := β + acsSum place v j
      (step j).eval.1 *ᵥ ket γ = ket (Function.update γ (place j) (γ (place j)+v j))) :
    (acsLoop step m).eval.1 *ᵥ ket β = ket (β + acsSum place v m) := by
  induction m with
  | zero =>
    simp only [acsLoop, Circuit.eval_identity, Submonoid.coe_one, Matrix.one_mulVec, acsSum,
      Finset.range_zero, Finset.sum_empty, add_zero]
  | succ m ih =>
    rw [acsLoop, seq_mulVec, ih (fun j hj => hs j (by omega)), hs m (by omega),
      AliasCircuit.upd_add]
    simp only [acsSum, Finset.sum_range_succ, add_assoc]

theorem acsReadyOf (p : acsPin → Wire n) (f : acsPin → ZMod 2) (γ : BitAssignment n)
    (P : acsPin → Prop) (t w : Wire n)
    (read : ∀ u, P u → γ (p u) = f u)
    (ht : ∀ u, P u → p u ≠ t) (hw : ∀ u, P u → p u ≠ w)
    (hi : ∀ u v, P u → P v → u ≠ v → p u ≠ p v) (g : acsTerm) (hg : acsLegal P g) :
    acsReady p t w γ f g := by
  cases g with
  | x => trivial
  | cx u => exact ⟨ht u hg, read u hg⟩
  | cc u v =>
    obtain ⟨hu,hv,hne⟩ := hg
    exact ⟨⟨ht u hu,read u hu⟩,⟨ht v hv,read v hv⟩,hi u v hu hv hne,hw u hu,hw v hv⟩

theorem acsReadValid {N M a j : ℕ} {u : acsPin} (hj : j ≤ acsEnd N M a)
    (hu : acsReadAt N M a j u) : acsValid N M a u := by
  cases u <;> simp [acsReadAt, acsValid, acsEnd, decWorkS] at * <;> omega

section Action
local notation "P" => acsPlace idx seed raw work
local notation "E" => acsEnd N M a
local notation "L" => descBitsS N M
local notation "Hh" => highBitsS N M
local notation "Mm" => slotBitsS N M

theorem acsLocalRead {k : ℕ} (r : QRegister k n) (i : ℕ) (hk : 0 < k) (hi : i < k)
    (β : BitAssignment n) : β (acsAt r i hk) = acsB ((localIdx r β).val.testBit i) := by
  have h := basisBits_eq_testBit k ((basisBits k).symm (fun j ↦ β (r j))) ⟨i,hi⟩
  rw [Equiv.apply_symm_apply] at h
  have hat : acsAt r i hk = r ⟨i,hi⟩ := by
    unfold acsAt
    apply congrArg r.wires
    exact Fin.ext (Nat.mod_eq_of_lt hi)
  rw [hat]
  change β (r ⟨i,hi⟩) = (if ((basisBits k).symm (fun j ↦ β (r j))).val.testBit i then 1 else 0)
  exact h

theorem acsCmpAction (w σ : ℕ) (β : BitAssignment n)
    (read : ∀ u, acsReadAt N M a 0 u → β (P u) = acsRef N M a w σ u)
    (clean : ∀ j, j < decWorkS N M a → β (P (.W j)) = 0) :
    ((acsCmp idx seed raw work hd).cmp).eval.1 *ᵥ ket β =
      ket (Function.update β (P (.W 0)) (β (P (.W 0))+acsRef N M a w σ (.W 0))) := by
  let C := acsCmp idx seed raw work hd
  have hs := acsSeedWidth N M a
  let r := σ / 2^(2+Mm)
  let k := w / (2^L)^2
  -- CHECK C1: compare the low ticket with the top field of the raw word.
  have hv : AliasCircuit.borW (fun i ↦ β (C.rf i)) (fun i ↦ β (C.Kf i)) a =
      AliasCircuit.borW (AliasCircuit.bitN r) (AliasCircuit.bitN k) a := by
    apply AliasCircuit.borW_cong
    · intro i hi
      change β (P (.S (2+Mm+i))) = _
      rw [read (.S (2+Mm+i)) (show 2+Mm+i < gP N M a by omega), acsBit]
      simp only [acsRef, r, Nat.testBit_div_two_pow, Nat.add_comm i (2+Mm)]
    · intro i hi
      change β (P (.R (2*L+i))) = _
      rw [read (.R (2*L+i)) (show 2*L+i < wordBitsS N M a by unfold wordBitsS; omega), acsBit]
      have hp : (2^L)^2 = 2^(2*L) := by rw [two_mul, pow_two, pow_add]
      simp only [acsRef, k, hp, Nat.testBit_div_two_pow, Nat.add_comm i (2*L)]
  have hc := C.cmp_ket β (clean E (by unfold acsEnd decWorkS; omega))
    (fun i hi => clean (E+1+i) (by unfold acsEnd decWorkS; omega))
  have hfl : C.fl = P (.W 0) := rfl
  have hflag : acsRef N M a w σ (.W 0) = (if r % 2^a < k % 2^a then 1 else 0) := by
    simp only [acsRef, acsWorkBit, if_pos rfl, ↓reduceIte, acsFlag, acsB, decide_eq_true_eq, r, k]
  rw [hv, AliasCircuit.borW_bitN, hfl] at hc
  rw [hflag]
  exact hc

theorem acsComputeKet (w σ : ℕ) (β : BitAssignment n)
    (read : ∀ u, acsReadAt N M a 0 u → β (P u) = acsRef N M a w σ u)
    (clean : ∀ j, j < decWorkS N M a → β (P (.W j)) = 0) :
    (acsLoop (acsStep idx seed raw work hd) E).eval.1 *ᵥ ket β =
      ket (β + acsSum (fun i => P (.W i)) (fun i => acsRef N M a w σ (.W i)) E) := by
  let f := acsRef N M a w σ
  have he : E < decWorkS N M a := by unfold acsEnd decWorkS; omega
  have sep := @acsApart n N M a _ idx seed raw work hd
  apply acsLoopKet
  intro j hj
  by_cases j0 : j=0
  · subst j
    simpa [acsStep, acsSum] using acsCmpAction idx seed raw work hd w σ β read clean
  let γ := β + acsSum (fun i => P (.W i)) (fun i => f (.W i)) j
  have off (u : acsPin) (vu : acsValid N M a u) (hne : ∀ k, k < j → u ≠ .W k) :
      γ (P u) = β (P u) := by
    have hzero : acsSum (fun i => P (.W i)) (fun i => f (.W i)) j (P u) = 0 :=
      acsSumOff _ _ j (P u) (fun k hk => sep (u := u) (v := .W k)
        vu (show k < decWorkS N M a by omega) (hne k hk))
    change β (P u) + acsSum (fun i => P (.W i)) (fun i => f (.W i)) j (P u) = _
    rw [hzero, add_zero]
  -- CHECK K1: the prefix sum agrees with each previously initialized cell.
  have read' (u : acsPin) (hu : acsReadAt N M a j u) : γ (P u) = f u := by
    have vu := acsReadValid (Nat.le_of_lt hj) hu
    cases u with
    | I i => exact hu.elim
    | W i =>
      change i < j at hu
      rw [show γ (P (.W i)) = β (P (.W i)) + _ from rfl, clean i (by omega), zero_add]
      apply acsSumOn _ _ hu
      intro k hk hki
      exact sep (u := .W i) (v := .W k) vu (show k < decWorkS N M a by omega)
        (fun e => hki (acsPin.W.inj e).symm)
    | S i =>
      rw [off (.S i) vu (by simp)]
      exact read (.S i) hu
    | R i =>
      rw [off (.R i) vu (by simp)]
      exact read (.R i) hu
  have avoid (q : ℕ) (hq : j ≤ q) (vq : q < decWorkS N M a) (u : acsPin)
      (hu : acsReadAt N M a j u) : P u ≠ P (.W q) := by
    apply sep (u := u) (v := .W q) (acsReadValid hj.le hu) vq
    cases u with
    | W i =>
      change i < j at hu
      exact fun e => (Nat.ne_of_lt (Nat.lt_of_lt_of_le hu hq)) (acsPin.W.inj e)
    | I i | S i | R i => simp
  have hw : γ (P (.W E)) = 0 := by
    have hn (k : ℕ) (hk : k < j) : acsPin.W E ≠ .W k :=
      fun e => (Nat.ne_of_lt (hk.trans hj)) (acsPin.W.inj e).symm
    exact (off (.W E) he hn).trans (clean E he)
  let ops := acsOps Hh L Mm a j
  have hr := acsLineKet P (P (.W j)) (P (.W E)) f ops γ hw
    (sep (u := .W j) (v := .W E) (show j < decWorkS N M a by omega) he
      (fun e => (Nat.ne_of_lt hj) (acsPin.W.inj e)))
    (fun g hg => acsReadyOf P f γ (acsReadAt N M a j) _ _ read' (avoid j le_rfl (by omega))
      (avoid E (by omega) he) (fun _ _ hu hv hn => sep (acsReadValid hj.le hu)
        (acsReadValid hj.le hv) hn) g (acsOpsLegal N M a j (by omega) hj g hg))
  change (acsStep idx seed raw work hd j).eval.1 *ᵥ ket γ = _
  rw [acsStep, if_neg j0]
  simpa only [ops, f, acsCell N M a w σ j (by omega)] using hr

include hd in
theorem acsTargetOff (w σ j : ℕ) (hj : j ≤ bP N M)
    (u : acsPin) (hu : acsValid N M a u) (hni : ∀ q, u ≠ .I q) :
    acsSum (fun i => P (.I i)) (AliasCircuit.bitN (outNatS N M a w σ)) j (P u) = 0 := by
  exact acsSumOff _ _ j (P u) (fun i hi => acsApart idx seed raw work hd (u := u) (v := .I i) hu
    (show i < bP N M by omega) (hni i))

include hd in
theorem acsOutputKet (w σ : ℕ) (hσ : σ < 2^gP N M a) (β : BitAssignment n)
    (read : ∀ u, acsReadAt N M a E u → β (P u) = acsRef N M a w σ u)
    (clean : β (P (.W E)) = 0) :
    (acsLoop (acsWrite idx seed raw work) (2*bIC N M+1)).eval.1 *ᵥ ket β =
      ket (β + acsSum (fun i => P (.I i)) (AliasCircuit.bitN (outNatS N M a w σ)) (2*bIC N M+1)) := by
  let f := acsRef N M a w σ
  have he : E < decWorkS N M a := by unfold acsEnd decWorkS; omega
  have sep := @acsApart n N M a _ idx seed raw work hd
  apply acsLoopKet
  intro j hj
  have vj : j < bP N M := by unfold bP idxC; omega
  let γ := β + acsSum (fun i => P (.I i)) (AliasCircuit.bitN (outNatS N M a w σ)) j
  have notI (u : acsPin) (hu : acsReadAt N M a E u) (i : ℕ) : u ≠ .I i := by
    cases u <;> simp [acsReadAt] at *
  have read' (u : acsPin) (hu : acsReadAt N M a E u) : γ (P u) = f u := by
    dsimp only [γ, Pi.add_apply]
    rw [acsTargetOff idx seed raw work hd w σ j vj.le u (acsReadValid le_rfl hu) (notI u hu),
      add_zero, read u hu]
  have hw : γ (P (.W E)) = 0 := by
    dsimp only [γ, Pi.add_apply]
    rw [acsTargetOff idx seed raw work hd w σ j vj.le (.W E) he (by simp), clean, add_zero]
  have hc := acsLineKet P (P (.I j)) (P (.W E)) f (acsWrites N M a j) γ hw
    (sep (u := .I j) (v := .W E) vj he (by simp))
    (fun g hg => acsReadyOf P f γ (acsReadAt N M a E) _ _ read'
      (fun u hu => sep (u := u) (v := .I j) (acsReadValid le_rfl hu) vj (notI u hu j))
      (fun u hu => sep (u := u) (v := .W E) (acsReadValid le_rfl hu) he (by
        cases u with
        | W i => exact fun e => (Nat.ne_of_lt (show i < E from hu)) (acsPin.W.inj e)
        | I i | S i | R i => simp))
      (fun _ _ hu hv hn => sep (acsReadValid le_rfl hu) (acsReadValid le_rfl hv) hn)
      g (acsWritesLegal N M a j hj g hg))
  simpa only [acsWrite, f, acsWriteVal N M a w σ j hσ hj] using hc

-- CHECK: quantified over every target and raw word. Work returns to zero.
theorem decodeS_ket (β : BitAssignment n) (hz : localIdx work β = 0) :
    (decodeS idx seed raw work hd).eval.1 *ᵥ ket β =
      ket (β + ∑ i : Fin (bP N M), Pi.single (idx i)
        (AliasCircuit.bitN (outNatS N M a (localIdx raw β).val (localIdx seed β).val) i.val)) := by
  let w := (localIdx raw β).val
  let σ := (localIdx seed β).val
  let f := acsRef N M a w σ
  let mid := acsSum (fun i => P (.W i)) (fun i => f (.W i)) E
  let out := AliasCircuit.bitN (outNatS N M a w σ)
  let dm := 2*bIC N M+1
  let delta := acsSum (fun i => P (.I i)) out dm
  let V := acsLoop (acsStep idx seed raw work hd) E
  let O := acsLoop (acsWrite idx seed raw work) dm
  have hdm : dm+1 = bP N M := rfl
  have he : E < decWorkS N M a := by unfold acsEnd decWorkS; omega
  have sep := @acsApart n N M a _ idx seed raw work hd
  have read (u : acsPin) (hu : acsReadAt N M a 0 u) : β (P u) = f u := by
    cases u with
    | I i => exact hu.elim
    | W i => exact (Nat.not_lt_zero _ hu).elim
    | S i => exact acsLocalRead seed i (Nat.zero_lt_of_lt (show i < gP N M a from hu)) hu β
    | R i => exact acsLocalRead raw i (Nat.zero_lt_of_lt (show i < wordBitsS N M a from hu)) hu β
  have clean (j : ℕ) (_ : j < decWorkS N M a) : β (P (.W j)) = 0 :=
    (QC14.localIdx_eq_zero_iff _ _).1 hz _
  have forward : V.eval.1 *ᵥ ket β = ket (β+mid) :=
    acsComputeKet idx seed raw work hd w σ β read clean
  have midOff (u : acsPin) (hu : acsValid N M a u) (hn : ∀ i, i < E → u ≠ .W i) :
      mid (P u) = 0 := by
    exact acsSumOff _ _ E (P u) (fun i hi => sep (u := u) (v := .W i) hu
      (show i<decWorkS N M a by omega) (hn i hi))
  have readMid (u : acsPin) (hu : acsReadAt N M a E u) : (β+mid) (P u) = f u := by
    have vu := acsReadValid le_rfl hu
    rw [Pi.add_apply]
    cases u with
    | I i => exact hu.elim
    | R i => rw [midOff _ vu (by simp), add_zero]; exact read _ hu
    | S i => rw [midOff _ vu (by simp), add_zero]; exact read _ hu
    | W i =>
      change i<E at hu
      rw [clean i (by omega), zero_add]
      exact acsSumOn _ _ hu (fun k hk hki => sep (u := .W i) (v := .W k) vu
        (show k<decWorkS N M a by omega) (fun e => hki (acsPin.W.inj e).symm))
  have hw : (β+mid) (P (.W E)) = 0 := by
    have hn (i : ℕ) (hi : i < E) : acsPin.W E ≠ .W i :=
      fun e => (Nat.ne_of_lt hi) (acsPin.W.inj e).symm
    rw [Pi.add_apply, midOff (.W E) he hn, clean E he, add_zero]
  have output : O.eval.1 *ᵥ ket (β+mid) = ket ((β+mid)+delta) :=
    acsOutputKet idx seed raw work hd w σ (localIdx seed β).isLt _ readMid hw
  have doff (u : acsPin) (hu : acsValid N M a u) (hn : ∀ i, u ≠ .I i) : delta (P u) = 0 :=
    acsTargetOff idx seed raw work hd w σ dm (by omega) u hu hn
  have readBack (u : acsPin) (hu : acsReadAt N M a 0 u) : (β+delta) (P u) = f u := by
    have vu := acsReadValid (Nat.zero_le E) hu
    have hn : ∀ i, u ≠ .I i := by cases u <;> simp [acsReadAt] at *
    rw [Pi.add_apply, doff u vu hn, add_zero, read u hu]
  have cleanBack (j : ℕ) (hj : j<decWorkS N M a) : (β+delta) (P (.W j)) = 0 := by
    rw [Pi.add_apply, doff (.W j) hj (by simp), clean j hj, add_zero]
  -- CHECK K2: the forward computation on the updated index supplies the inverse input.
  have replay : V.eval.1 *ᵥ ket (β+delta) = ket ((β+mid)+delta) := by
    simpa only [add_right_comm β delta mid] using
      (show V.eval.1 *ᵥ ket (β+delta) = ket ((β+delta)+mid) from
        acsComputeKet idx seed raw work hd w σ _ readBack cleanBack)
  change (Circuit.seq V (.seq O V.inverse)).eval.1 *ᵥ ket β = _
  rw [seq_mulVec, forward, seq_mulVec, output, AliasCircuit.inv_ket _ _ _ replay]
  refine congrArg ket (congrArg (fun v : BitAssignment n => β+v) ?_)
  have hlast : out dm = 0 := acsOrientation N M a w σ
  calc
    delta = ∑ i ∈ range (dm+1), Pi.single (P (.I i)) (out i) := by
      rw [Finset.sum_range_succ, hlast]; simp [delta, acsSum]
    _ = ∑ i : Fin (bP N M), Pi.single (idx i) (out i.val) := by
      rw [hdm, Finset.sum_range]
      apply Finset.sum_congr rfl
      intro i _
      simp only [acsPlace, acsAt, Nat.mod_eq_of_lt i.isLt, Fin.eta]
end Action

/-- The comparator at j=0 costs 16a, the spin equality cell costs zero, and each
other cell contains at most one Clifford+T implementation of a Toffoli. -/
def acsBudget (L a j : ℕ) :=
  (if j=0 then 0 else 16*a) + 8*(j-1-(if L+1 < j then 1 else 0))

theorem acsComputeCount (m : ℕ) :
    (acsLoop (acsStep idx seed raw work hd) m).count PrimitiveGate.TOFF = 0 ∧
    (acsLoop (acsStep idx seed raw work hd) m).count PrimitiveGate.T ≤ acsBudget (descBitsS N M) a m := by
  induction m with
  | zero => simp [acsLoop, acsBudget]
  | succ j ih =>
    obtain ⟨hO,hT⟩ := ih
    simp only [acsLoop, Circuit.count_seq, hO, zero_add]
    by_cases j0 : j=0
    · subst j
      obtain ⟨ho,ht⟩ := (acsCmp idx seed raw work hd).cmp_count
      simp only [acsStep, if_pos rfl]
      exact ⟨ho, by simp [acsBudget] at hT ⊢ <;> omega⟩
    · let ops := acsOps (highBitsS N M) (descBitsS N M) (slotBitsS N M) a j
      let p := acsPlace idx seed raw work
      obtain ⟨ho,ht⟩ := acsLineCount p (p (.W j)) (p (.W (acsEnd N M a))) ops
      rw [acsStep, if_neg j0]
      refine ⟨ho, ?_⟩
      -- CHECK T1: equality uses only Clifford gates, including at the prefix boundary.
      have hc : (ops.map acsTermCost).sum ≤ (if j=descBitsS N M+1 then 0 else 8) := by
        dsimp [ops, acsOps]
        split_ifs <;> simp [acsTermCost] <;> omega
      have stepT := ht.trans hc
      change _ + (acsLine p (p (.W j)) (p (.W (acsEnd N M a))) ops).count PrimitiveGate.T ≤ _
      unfold acsBudget at hT ⊢
      split_ifs at * <;> omega

theorem acsOutputCount (m : ℕ) :
    (acsLoop (acsWrite idx seed raw work) m).count PrimitiveGate.TOFF = 0 ∧
    (acsLoop (acsWrite idx seed raw work) m).count PrimitiveGate.T ≤ 8*m := by
  induction m with
  | zero => simp [acsLoop]
  | succ j ih =>
    obtain ⟨hO,hT⟩ := ih
    let p := acsPlace idx seed raw work
    obtain ⟨ho,ht⟩ := acsLineCount p (p (.I j)) (p (.W (acsEnd N M a))) (acsWrites N M a j)
    have hc : ((acsWrites N M a j).map acsTermCost).sum = 8 := by
      cases hb : acsBaseBit (N+M) (bIC N M) j <;> simp [acsWrites, hb, acsTermCost]
    rw [hc] at ht
    change (acsWrite idx seed raw work j).count PrimitiveGate.T ≤ 8 at ht
    simp only [acsLoop, Circuit.count_seq, hO, zero_add]
    exact ⟨ho, by omega⟩

theorem decodeS_count :
    (decodeS idx seed raw work hd).count PrimitiveGate.TOFF = 0 ∧
    (decodeS idx seed raw work hd).count PrimitiveGate.T ≤ decodeTS N M a := by
  let E := acsEnd N M a
  let L := descBitsS N M
  have h := acsComputeCount idx seed raw work hd E
  have h' := acsOutputCount idx seed raw work (2*bIC N M+1)
  have hb : acsBudget L a E = computeTS N M a := by
    have h1 : E ≠ 0 := by dsimp [E, acsEnd]; omega
    have h2 : L+1<E := by dsimp [L, E, acsEnd]; omega
    simp only [acsBudget, if_neg h1, if_pos h2]
    dsimp [computeTS, L, E, acsEnd]; omega
  have ht := h.2
  change _ ≤ acsBudget L a E at ht
  rw [hb] at ht
  have hk := (acsWidth N M).1
  obtain ⟨hwo,hwt⟩ := h'
  change (acsLoop (acsStep idx seed raw work hd) (acsEnd N M a)).count PrimitiveGate.T ≤ _ at ht
  have hco := h.1
  dsimp only [E] at hco
  simp only [decodeS, Circuit.count_seq,
    Circuit.count_inverse_of_ne PrimitiveGate.T (by simp) (by simp),
    Circuit.count_inverse_of_ne PrimitiveGate.TOFF (by simp) (by simp), hco, hwo, zero_add,
    true_and, decodeTS]
  omega
end Decoder

