/-- Two-body row `a = 2μ + σ`: the reflection of leaf `χ^μ` on spin `σ`. -/
noncomputable def twoRow {N M : ℕ} (thc : THCFactorization N M) (a : Fin (2 * M)) :
    Operator (2 ^ (2 * N)) :=
  orbitalReflection N (thc.chi ⟨a.val / 2, by omega⟩) ⟨a.val % 2, by omega⟩

/-- Core weight of a row pair: `ζ_{a/2, b/2}`. -/
noncomputable def zeta2 {N M : ℕ} (thc : THCFactorization N M) (a b : Fin (2 * M)) : ℝ :=
  thc.zeta ⟨a.val / 2, by omega⟩ ⟨b.val / 2, by omega⟩

/-! ### Row indexing `a = 2μ + σ` -/

private def rowEquiv (M : ℕ) : Fin M × Fin 2 ≃ Fin (2 * M) where
  toFun x := ⟨2 * x.1.val + x.2.val, by have := x.1.isLt; have := x.2.isLt; omega⟩
  invFun a := (⟨a.val / 2, by omega⟩, ⟨a.val % 2, by omega⟩)
  left_inv x := by
    obtain ⟨⟨μ, hμ⟩, ⟨σ, hσ⟩⟩ := x
    refine Prod.ext (Fin.ext ?_) (Fin.ext ?_)
    · show (2 * μ + σ) / 2 = μ
      omega
    · show (2 * μ + σ) % 2 = σ
      omega
  right_inv a := by
    obtain ⟨a, ha⟩ := a
    refine Fin.ext ?_
    show 2 * (a / 2) + a % 2 = a
    omega

private lemma rowEquiv_val (M : ℕ) (μ : Fin M) (σ : Fin 2) :
    (rowEquiv M (μ, σ)).val = 2 * μ.val + σ.val := rfl

private lemma sumRows {β : Type*} [AddCommMonoid β] (M : ℕ) (f : Fin (2 * M) → β) :
    ∑ a, f a = ∑ μ : Fin M, ∑ σ : Fin 2, f (rowEquiv M (μ, σ)) := by
  rw [← (rowEquiv M).sum_comp f, Fintype.sum_prod_type]

private lemma sum4_perm {β : Type*} [AddCommMonoid β] {M : ℕ}
    (g : Fin M → Fin 2 → Fin M → Fin 2 → β) :
    ∑ μ, ∑ σ, ∑ ν, ∑ τ, g μ σ ν τ = ∑ σ, ∑ τ, ∑ μ, ∑ ν, g μ σ ν τ := by
  calc ∑ μ, ∑ σ, ∑ ν, ∑ τ, g μ σ ν τ = ∑ σ, ∑ μ, ∑ ν, ∑ τ, g μ σ ν τ := Finset.sum_comm
    _ = ∑ σ, ∑ μ, ∑ τ, ∑ ν, g μ σ ν τ :=
        Finset.sum_congr rfl fun σ _ => Finset.sum_congr rfl fun μ _ => Finset.sum_comm
    _ = ∑ σ, ∑ τ, ∑ μ, ∑ ν, g μ σ ν τ := Finset.sum_congr rfl fun σ _ => Finset.sum_comm

/-- Number operator of row `a`, so that `twoRow a = 1 - 2 nRow a`. -/
private noncomputable def nRow {N M : ℕ} (thc : THCFactorization N M) (a : Fin (2 * M)) :
    Operator (2 ^ (2 * N)) :=
  orbitalNumberOp N (thc.chi ⟨a.val / 2, by omega⟩) ⟨a.val % 2, by omega⟩

private lemma twoRow_eq_nRow {N M : ℕ} (thc : THCFactorization N M) (a : Fin (2 * M)) :
    twoRow thc a = 1 - (2 : ℂ) • nRow thc a := rfl

private lemma nRow_eq {N M : ℕ} (thc : THCFactorization N M) (a : Fin (2 * M)) (μ : Fin M)
