            (1 : Matrix (Fin (2 ^ (2 * N))) (Fin (2 ^ (2 * N))) ℂ) +
          ∑ p : Fin N, ∑ x : Fin 2,
            ((coef g (σ, p, p, x) : ℝ) : ℂ) • (selectPauliString (pRow N (σ, p, p, x))).1 := by
