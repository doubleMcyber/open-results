/-- `Z` on wire `p`, identity elsewhere. -/
def zRow (k : ℕ) (p : Fin k) : Fin k → SelectPauli.Pauli := fun r ↦ if r = p then .Z else .I

/-- `P` on wires `p` and `q`, `Z` strictly between them, identity elsewhere. -/
def hopRow (k : ℕ) (p q : Fin k) (P : SelectPauli.Pauli) : Fin k → SelectPauli.Pauli :=
  fun r ↦ if r = p ∨ r = q then P else if p < r ∧ r < q then .Z else .I

namespace JWPauliAux

open QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.OrbitalBridge
open Operator

/-! ## Basis-ket helpers -/

noncomputable abbrev ket {n : ℕ} (β : BitAssignment n) : Fin (2 ^ n) → ℂ :=
  basisState ((basisBits n).symm β)

theorem single_eq_ket {n : ℕ} (g : Fin (2 ^ n)) :
    (Pi.single g 1 : Fin (2 ^ n) → ℂ) = ket (basisBits n g) := by
  simp [ket, basisState]

theorem matrix_ext_ket {n : ℕ} {A B : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ}
    (h : ∀ β, A *ᵥ ket β = B *ᵥ ket β) : A = B := by
  ext i j
  have := congrFun (h (basisBits n j)) i
  simpa [← single_eq_ket, Matrix.mulVec_single_one] using this

noncomputable def writeReg {n k : ℕ} (β : BitAssignment n) (r : QRegister k n)
    (γ : BitAssignment k) : BitAssignment n :=
  basisBits n (r.replaceIndex ((basisBits n).symm β) ((basisBits k).symm γ))

@[simp]
theorem writeReg_apply_reg {n k : ℕ} (β : BitAssignment n) (r : QRegister k n)
    (γ : BitAssignment k) (i : Fin k) : writeReg β r γ (r i) = γ i := by
  simp [writeReg, QRegister.basisBits_replaceIndex_apply]

theorem writeReg_apply_of_not_mem {n k : ℕ} (β : BitAssignment n) (r : QRegister k n)
    (γ : BitAssignment k) (w : Wire n) (hw : w ∉ Set.range r.wires) :
    writeReg β r γ w = β w := by
  simp [writeReg, QRegister.basisBits_replaceIndex_of_not_mem _ _ _ _ hw]

theorem writeReg_eq_update {n k : ℕ} (β : BitAssignment n) (r : QRegister k n)
    (γ : BitAssignment k) (i₀ : Fin k) (hγ : ∀ i, i ≠ i₀ → γ i = β (r i)) :
    writeReg β r γ = Function.update β (r i₀) (γ i₀) := by
  funext w
  by_cases hw : w ∈ Set.range r.wires
  · obtain ⟨i, rfl⟩ := hw
    rw [writeReg_apply_reg]
    by_cases hi : i = i₀
    · subst hi
      simp
    · rw [Function.update_of_ne (fun h ↦ hi (r.wires.injective h)), hγ i hi]
  · rw [writeReg_apply_of_not_mem _ _ _ _ hw, Function.update_of_ne]
    exact fun h ↦ hw ⟨i₀, h.symm⟩

noncomputable abbrev localIdx {n k : ℕ} (r : QRegister k n) (β : BitAssignment n) :
    Fin (2 ^ k) :=
  (basisBits k).symm (fun i ↦ β (r i))

theorem embedMatrix_mulVec_ket {n k : ℕ} (r : QRegister k n)
    (A : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ) (β : BitAssignment n) :
    r.embedMatrix A *ᵥ ket β =
      ∑ l : Fin (2 ^ k), A l (localIdx r β) • ket (writeReg β r (basisBits k l)) := by
  have hext : r.extractIndex ((basisBits n).symm β) = localIdx r β := by
    simp [QRegister.extractIndex]
  have hcol (j : Fin (2 ^ k)) :
      A *ᵥ Pi.single j 1 = ∑ l : Fin (2 ^ k), A l j • Pi.single l 1 := by
    funext x
    simp [Matrix.mulVec, dotProduct, Pi.single_apply]
  rw [ket, basisState, r.embedMatrix_mulVec_single_factors, hext, hcol,
    QRegister.tensorState_sum_left]
  refine Finset.sum_congr rfl fun l _ ↦ ?_
  rw [QRegister.tensorState_smul_left, QRegister.tensorState_single_replaceIndex]
  simp [writeReg, ket, basisState]

theorem singleton_embedMatrix_mulVec_ket {n : ℕ} (q : Wire n) (A : Matrix (Fin 2) (Fin 2) ℂ)
    (β : BitAssignment n) :
    (QRegister.singleton q).embedMatrix A *ᵥ ket β =
      A 0 (if β q = 0 then 0 else 1) • ket (Function.update β q 0) +
        A 1 (if β q = 0 then 0 else 1) • ket (Function.update β q 1) := by
  have hloc : localIdx (QRegister.singleton q) β = if β q = 0 then 0 else 1 := by
    have h : ∀ b : ZMod 2,
        ((basisBits 1).symm (fun _ ↦ b) : Fin 2) = if b = 0 then 0 else 1 := by decide
    exact h (β q)
  have hw (l : Fin 2) (b : ZMod 2) (hb : basisBits 1 l = fun _ ↦ b) :
      writeReg β (QRegister.singleton q) (basisBits 1 l) = Function.update β q b := by
    rw [writeReg_eq_update _ _ _ 0 (fun i hi ↦ absurd (Subsingleton.elim i 0) hi), hb]
    rfl
  rw [embedMatrix_mulVec_ket, hloc]
  change ∑ l : Fin 2, _ = _
  rw [Fin.sum_univ_two, hw 0 0 (by decide), hw 1 1 (by decide)]

theorem bit_cases (b : ZMod 2) : b = 0 ∨ b = 1 := by
  fin_cases b
  · exact Or.inl rfl
  · exact Or.inr rfl

theorem one_add_one_zmod2 : (1 : ZMod 2) + 1 = 0 := rfl

/-! ## Pauli strings on basis kets -/

/-- Sign `(-1)^b` of a bit. -/
abbrev bitSign (b : ZMod 2) : ℂ := if b = 0 then 1 else -1

theorem bitSign_eq_pow (b : ZMod 2) : bitSign b = (-1 : ℂ) ^ b.val := by
  have h1 : (1 : ZMod 2).val = 1 := rfl
  rcases bit_cases b with h | h <;> simp [h, bitSign, h1]

/-- Bit flipped by the Pauli. -/
def pf : SelectPauli.Pauli → ZMod 2
  | .I => 0
  | .X => 1
  | .Y => 1
  | .Z => 0

/-- Phase picked up by the Pauli on a basis ket with bit `x`. -/
noncomputable def pc : SelectPauli.Pauli → ZMod 2 → ℂ
  | .I, _ => 1
  | .X, _ => 1
  | .Y, x => if x = 0 then Complex.I else -Complex.I
  | .Z, x => bitSign x

theorem pauli_ket {N : ℕ} (q : Wire N) (p : SelectPauli.Pauli) (δ : BitAssignment N) :
    ((QRegister.singleton q).embedUnitary p.unitary).1.mulVec (ket δ) =
      pc p (δ q) • ket (Function.update δ q (δ q + pf p)) := by
  rw [QRegister.embedUnitary_val]
  have e := Function.update_eq_self q δ
  cases p
  · show ((QRegister.singleton q).embedMatrix (1 : Matrix (Fin 2) (Fin 2) ℂ)).mulVec _ = _
    rw [singleton_embedMatrix_mulVec_ket]
    rcases bit_cases (δ q) with h | h <;> rw [h] at e <;>
      simp [h, e, pf, pc, Matrix.one_apply]
  · show ((QRegister.singleton q).embedMatrix !![(0 : ℂ), 1; 1, 0]).mulVec _ = _
    rw [singleton_embedMatrix_mulVec_ket]
    rcases bit_cases (δ q) with h | h <;> rw [h] at e <;>
      simp [h, e, pf, pc, one_add_one_zmod2]
  · show ((QRegister.singleton q).embedMatrix !![(0 : ℂ), -Complex.I; Complex.I, 0]).mulVec _ = _
    rw [singleton_embedMatrix_mulVec_ket]
    rcases bit_cases (δ q) with h | h <;> rw [h] at e <;>
      simp [h, e, pf, pc, one_add_one_zmod2]
  · show ((QRegister.singleton q).embedMatrix !![(1 : ℂ), 0; 0, -1]).mulVec _ = _
    rw [singleton_embedMatrix_mulVec_ket]
    rcases bit_cases (δ q) with h | h <;> rw [h] at e <;>
      simp [h, e, pf, pc, one_add_one_zmod2, bitSign]

theorem update_eq_add_single {n : ℕ} (β : BitAssignment n) (w : Wire n) (a : ZMod 2) :
    Function.update β w (β w + a) = β + Pi.single w a := by
  funext x
  by_cases h : x = w
  · subst h; simp
  · simp [h, Pi.single_apply]

theorem unitary_list_prod_ket {N : ℕ} (row : Fin N → SelectPauli.Pauli) (l : List (Fin N))
    (hl : l.Nodup) (δ : BitAssignment N) :
    (l.map fun q : Fin N ↦ (QRegister.singleton q).embedUnitary (row q).unitary).prod.1.mulVec
        (ket δ) =
      (l.map fun q ↦ pc (row q) (δ q)).prod •
        ket (δ + ∑ q ∈ l.toFinset, Pi.single q (pf (row q))) := by
  induction l generalizing δ with
  | nil =>
    have h1 : ((1 : Unitary (2 ^ N)).1) = 1 := rfl
    simp only [List.map_nil, List.prod_nil, List.toFinset_nil, Finset.sum_empty, add_zero,
      one_smul, h1, Matrix.one_mulVec]
  | cons q l ih =>
    rw [List.nodup_cons] at hl
    have hq : q ∉ l.toFinset := by simpa using hl.1
    have h0 : (δ + ∑ q' ∈ l.toFinset, Pi.single q' (pf (row q'))) q = δ q := by
      simp only [Pi.add_apply, Finset.sum_apply, Pi.single_apply]
      rw [Finset.sum_eq_zero]
      · simp
      · intro q' hq'
        have : q ≠ q' := fun h ↦ hq (h ▸ hq')
        simp [this]
    have hu := update_eq_add_single (δ + ∑ q' ∈ l.toFinset, Pi.single q' (pf (row q'))) q
      (pf (row q))
    rw [h0] at hu
    rw [List.map_cons, List.prod_cons, show ∀ (a b : Unitary (2 ^ N)), (a * b).1 = a.1 * b.1
      from fun _ _ ↦ rfl, ← Matrix.mulVec_mulVec, ih hl.2 δ, Matrix.mulVec_smul, pauli_ket, h0, hu,
      smul_smul, List.map_cons, List.prod_cons, List.toFinset_cons, Finset.sum_insert hq]
    have : δ + ∑ q' ∈ l.toFinset, Pi.single q' (pf (row q')) + Pi.single q (pf (row q)) =
        δ + (Pi.single q (pf (row q)) + ∑ q' ∈ l.toFinset, Pi.single q' (pf (row q'))) := by
      abel
    rw [this, mul_comm]

theorem string_ket {N : ℕ} (row : Fin N → SelectPauli.Pauli) (γ : BitAssignment N) :
    (selectPauliString row).1.mulVec (ket γ) =
      (∏ q, pc (row q) (γ q)) • ket (γ + ∑ q, Pi.single q (pf (row q))) := by
  have := unitary_list_prod_ket row (List.finRange N) (List.nodup_finRange N) γ
  have hs : (List.finRange N).toFinset = Finset.univ := by ext; simp
  rw [hs] at this
  rw [selectPauliString, List.ofFn_eq_map, this, Fin.prod_univ_def]

/-! ## The `Z` string and the hopping strings -/

theorem zString_ket (k : ℕ) (p : Fin k) (β : BitAssignment k) :
    (selectPauliString (zRow k p)).1 *ᵥ ket β = bitSign (β p) • ket β := by
  rw [string_ket]
  have hprod : ∏ q, pc (zRow k p q) (β q) = bitSign (β p) := by
    rw [Finset.prod_eq_single p]
    · simp [zRow, pc]
    · intro q _ hq
      simp [zRow, hq, pc]
    · simp
  have hsum : ∑ q, Pi.single q (pf (zRow k p q)) = (0 : BitAssignment k) := by
    apply Finset.sum_eq_zero
    intro q _
    have : pf (zRow k p q) = 0 := by
      unfold zRow
      split_ifs <;> rfl
    rw [this]
    simp
  rw [hprod, hsum, add_zero]

theorem hopRow_of_eq {k : ℕ} {p q r : Fin k} {P : SelectPauli.Pauli} (h : r = p ∨ r = q) :
    hopRow k p q P r = P := by
  simp only [hopRow, if_pos h]

theorem hopRow_of_btw {k : ℕ} {p q r : Fin k} {P : SelectPauli.Pauli} (h : ¬(r = p ∨ r = q))
    (hb : p < r ∧ r < q) : hopRow k p q P r = .Z := by
  simp only [hopRow, if_neg h, if_pos hb]

theorem hopRow_of_other {k : ℕ} {p q r : Fin k} {P : SelectPauli.Pauli} (h : ¬(r = p ∨ r = q))
    (hb : ¬(p < r ∧ r < q)) : hopRow k p q P r = .I := by
  simp only [hopRow, if_neg h, if_neg hb]

/-- The ket reached from `β` by flipping bits `p` and `q`. -/
def flip2 {k : ℕ} (β : BitAssignment k) (p q : Fin k) : BitAssignment k :=
  β + Pi.single p 1 + Pi.single q 1

theorem flip_01 {k : ℕ} (β : BitAssignment k) {p q : Fin k} (hpq : p ≠ q) (hp : β p = 0)
    (hq : β q = 1) : Function.update (Function.update β q 0) p 1 = flip2 β p q := by
  funext r
  by_cases hrp : r = p
  · subst hrp
    simp [flip2, Function.update_apply, Pi.single_apply, hp, hpq]
  · by_cases hrq : r = q
    · subst hrq
      simp [flip2, Function.update_apply, Pi.single_apply, hq, hpq, Ne.symm hpq,
        one_add_one_zmod2]
    · simp [flip2, Function.update_apply, Pi.single_apply, hrp, hrq]

theorem flip_10 {k : ℕ} (β : BitAssignment k) {p q : Fin k} (hpq : p ≠ q) (hp : β p = 1)
    (hq : β q = 0) : Function.update (Function.update β p 0) q 1 = flip2 β p q := by
  funext r
  by_cases hrp : r = p
  · subst hrp
    simp [flip2, Function.update_apply, Pi.single_apply, hp, hpq, Ne.symm hpq,
      one_add_one_zmod2]
  · by_cases hrq : r = q
    · subst hrq
      simp [flip2, Function.update_apply, Pi.single_apply, hq, hpq, Ne.symm hpq]
    · simp [flip2, Function.update_apply, Pi.single_apply, hrp, hrq]

theorem hopString_ket {k : ℕ} (p q : Fin k) (hpq : p < q) (P : SelectPauli.Pauli) (hP : pf P = 1)
    (β : BitAssignment k) :
    (selectPauliString (hopRow k p q P)).1 *ᵥ ket β =
      (pc P (β p) * pc P (β q) *
        (-1 : ℂ) ^ (∑ r ∈ Finset.univ.filter (fun r ↦ p < r ∧ r < q), (β r).val)) •
        ket (flip2 β p q) := by
  rw [string_ket]
  have hpq' : p ≠ q := hpq.ne
  have hpt : ∀ r, pc (hopRow k p q P r) (β r) =
      (if r = p then pc P (β p) else 1) * (if r = q then pc P (β q) else 1) *
        (if p < r ∧ r < q then (-1 : ℂ) ^ (β r).val else 1) := by
    intro r
    by_cases hrp : r = p
    · have := hopRow_of_eq (k := k) (p := p) (q := q) (r := r) (P := P) (Or.inl hrp)
      rw [this]
      simp [hrp, hpq']
    · by_cases hrq : r = q
      · have := hopRow_of_eq (k := k) (p := p) (q := q) (r := r) (P := P) (Or.inr hrq)
        rw [this]
        simp [hrp, hrq, hpq'.symm]
      · have hn : ¬(r = p ∨ r = q) := by tauto
        by_cases hb : p < r ∧ r < q
        · rw [hopRow_of_btw hn hb]
          simp [hrp, hrq, hb, pc, bitSign_eq_pow]
        · rw [hopRow_of_other hn hb]
          simp [hrp, hrq, hb, pc]
  have hprod : ∏ r, pc (hopRow k p q P r) (β r) =
      pc P (β p) * pc P (β q) *
        (-1 : ℂ) ^ (∑ r ∈ Finset.univ.filter (fun r ↦ p < r ∧ r < q), (β r).val) := by
    rw [Finset.prod_congr rfl (fun r _ ↦ hpt r), Finset.prod_mul_distrib, Finset.prod_mul_distrib,
      Finset.prod_ite_eq', Finset.prod_ite_eq', ← Finset.prod_filter,
      Finset.prod_pow_eq_pow_sum]
    simp
  have hsum : ∑ r, Pi.single r (pf (hopRow k p q P r)) =
      (Pi.single p 1 + Pi.single q 1 : BitAssignment k) := by
    funext x
    simp only [Finset.sum_apply, Pi.single_apply, Pi.add_apply]
    rw [Finset.sum_eq_single x]
    · simp only [if_true]
      by_cases hxp : x = p
      · subst hxp
        rw [hopRow_of_eq (Or.inl rfl), hP]
        simp [hpq', hpq'.symm]
      · by_cases hxq : x = q
        · subst hxq
          rw [hopRow_of_eq (Or.inr rfl), hP]
          simp [hpq', hpq'.symm]
        · have hn : ¬(x = p ∨ x = q) := by tauto
          by_cases hb : p < x ∧ x < q
          · rw [hopRow_of_btw hn hb]
            simp [hxp, hxq, pf]
          · rw [hopRow_of_other hn hb]
            simp [hxp, hxq, pf]
    · intro r _ hr
      simp [Ne.symm hr]
    · simp
  rw [hprod, hsum, flip2, add_assoc]

/-! ## Jordan-Wigner operators on basis kets -/

theorem jwString_ket {k : ℕ} (j : Fin k) (β : BitAssignment k) :
    jwString k j *ᵥ ket β =
      ((-1 : ℂ) ^ (∑ q ∈ Finset.univ.filter (· < j), (β q).val)) • ket β := by
  funext x
  rw [jwString, Matrix.mulVec_diagonal]
  by_cases hx : x = (basisBits k).symm β
  · subst hx
    simp [ket, basisState]
  · simp [ket, basisState, Pi.single_apply, hx]

theorem jwStep_ket {k : ℕ} (j : Fin k) (β : BitAssignment k) :
    jwStep k j *ᵥ ket β = if β j = 1 then ket (Function.update β j 0) else 0 := by
  rw [jwStep, singleton_embedMatrix_mulVec_ket]
  rcases bit_cases (β j) with h | h
  · simp [h, Matrix.single_apply]
  · simp [h, Matrix.single_apply]

theorem jwStepH_ket {k : ℕ} (j : Fin k) (β : BitAssignment k) :
    (jwStep k j)ᴴ *ᵥ ket β = if β j = 0 then ket (Function.update β j 1) else 0 := by
  rw [jwStep, ← QRegister.embedMatrix_conjTranspose, singleton_embedMatrix_mulVec_ket]
  rcases bit_cases (β j) with h | h
  · simp [h, Matrix.single_apply, Matrix.conjTranspose_apply]
  · simp [h, Matrix.single_apply, Matrix.conjTranspose_apply]

theorem jwAdjMul {k : ℕ} (p q : Fin k) :
    (jwAnnihilate k p)ᴴ * jwAnnihilate k q =
      (jwStep k p)ᴴ * (jwString k p * (jwString k q * jwStep k q)) := by
  rw [jwAnnihilate_eq_mul, jwAnnihilate_eq_mul, Matrix.conjTranspose_mul, jwString_conjTranspose]
  simp only [Matrix.mul_assoc]

/-! ## Parity bookkeeping -/

theorem sum_lt_split {k : ℕ} (f : Fin k → ℕ) (p q : Fin k) (hpq : p < q) :
    ∑ r ∈ Finset.univ.filter (· < q), f r =
      ∑ r ∈ Finset.univ.filter (· < p), f r + f p +
        ∑ r ∈ Finset.univ.filter (fun r ↦ p < r ∧ r < q), f r := by
  rw [Finset.sum_filter, Finset.sum_filter, Finset.sum_filter]
  have hfp : f p = ∑ r, if r = p then f r else 0 := by simp
  rw [hfp, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun r _ ↦ ?_
  simp only [Fin.lt_def, Fin.ext_iff] at hpq ⊢
  split_ifs <;> omega

theorem neg_one_pow_aux (a t c : ℕ) (hc : c = 0) :
    (-1 : ℂ) ^ a * (-1 : ℂ) ^ (a + c + t) = (-1) ^ t := by
  subst hc
  rw [← pow_add, show a + (a + 0 + t) = 2 * a + t by ring, pow_add, pow_mul]
  simp

theorem sign_between {k : ℕ} (β : BitAssignment k) (p q : Fin k) (hpq : p < q) (hp : β p = 0) :
    (-1 : ℂ) ^ (∑ r ∈ Finset.univ.filter (· < p), (β r).val) *
        (-1 : ℂ) ^ (∑ r ∈ Finset.univ.filter (· < q), (β r).val) =
      (-1 : ℂ) ^ (∑ r ∈ Finset.univ.filter (fun r ↦ p < r ∧ r < q), (β r).val) := by
  rw [sum_lt_split (fun r ↦ (β r).val) p q hpq]
  exact neg_one_pow_aux _ _ _ (by simp [hp])

theorem sum_between_update {k : ℕ} (β : BitAssignment k) (p q w : Fin k) (a : ZMod 2)
    (hw : w = p ∨ w = q) :
    ∑ r ∈ Finset.univ.filter (fun r ↦ p < r ∧ r < q), ((Function.update β w a) r).val =
      ∑ r ∈ Finset.univ.filter (fun r ↦ p < r ∧ r < q), (β r).val := by
  refine Finset.sum_congr rfl fun r hr ↦ ?_
  have hr' := (Finset.mem_filter.mp hr).2
  rw [Function.update_of_ne]
  rcases hw with rfl | rfl
  · exact hr'.1.ne'
  · exact hr'.2.ne

/-! ## The two hopping terms -/

theorem hop_ket₁ {k : ℕ} (p q : Fin k) (hpq : p < q) (β : BitAssignment k) :
    ((jwAnnihilate k p)ᴴ * jwAnnihilate k q) *ᵥ ket β =
      if β p = 0 ∧ β q = 1 then
        ((-1 : ℂ) ^ (∑ r ∈ Finset.univ.filter (fun r ↦ p < r ∧ r < q), (β r).val)) •
          ket (flip2 β p q)
      else 0 := by
  rw [jwAdjMul]
  simp only [← Matrix.mulVec_mulVec]
  by_cases hq : β q = 1
  · have hp' : ∀ hp : β p = 0, Function.update β q 0 p = 0 := fun hp ↦ by
      rw [Function.update_of_ne hpq.ne]; exact hp
    by_cases hp : β p = 0
    · rw [if_pos ⟨hp, hq⟩, jwStep_ket, if_pos hq, jwString_ket, Matrix.mulVec_smul, jwString_ket,
        Matrix.mulVec_smul, Matrix.mulVec_smul, jwStepH_ket, if_pos (hp' hp), smul_smul,
        flip_01 β hpq.ne hp hq]
      congr 1
      rw [mul_comm, sign_between _ p q hpq (hp' hp), sum_between_update _ _ _ _ _ (Or.inr rfl)]
    · rw [if_neg (fun h ↦ hp h.1), jwStep_ket, if_pos hq, jwString_ket, Matrix.mulVec_smul,
        jwString_ket, Matrix.mulVec_smul, Matrix.mulVec_smul, jwStepH_ket]
      have : ¬ Function.update β q 0 p = 0 := by
        rw [Function.update_of_ne hpq.ne]; exact hp
      rw [if_neg this]
      simp
  · rw [if_neg (fun h ↦ hq h.2), jwStep_ket, if_neg hq]
    simp

theorem hop_ket₂ {k : ℕ} (p q : Fin k) (hpq : p < q) (β : BitAssignment k) :
    ((jwAnnihilate k q)ᴴ * jwAnnihilate k p) *ᵥ ket β =
      if β p = 1 ∧ β q = 0 then
        ((-1 : ℂ) ^ (∑ r ∈ Finset.univ.filter (fun r ↦ p < r ∧ r < q), (β r).val)) •
          ket (flip2 β p q)
      else 0 := by
  rw [jwAdjMul]
  simp only [← Matrix.mulVec_mulVec]
  by_cases hp : β p = 1
  · have hq' : ∀ hq : β q = 0, Function.update β p 0 q = 0 := fun hq ↦ by
      rw [Function.update_of_ne hpq.ne']; exact hq
    by_cases hq : β q = 0
    · rw [if_pos ⟨hp, hq⟩, jwStep_ket, if_pos hp, jwString_ket, Matrix.mulVec_smul, jwString_ket,
        Matrix.mulVec_smul, Matrix.mulVec_smul, jwStepH_ket, if_pos (hq' hq), smul_smul,
        flip_10 β hpq.ne hp hq]
      congr 1
      rw [sign_between _ p q hpq (by simp), sum_between_update _ _ _ _ _ (Or.inl rfl)]
    · rw [if_neg (fun h ↦ hq h.2), jwStep_ket, if_pos hp, jwString_ket, Matrix.mulVec_smul,
        jwString_ket, Matrix.mulVec_smul, Matrix.mulVec_smul, jwStepH_ket]
      have : ¬ Function.update β p 0 q = 0 := by
        rw [Function.update_of_ne hpq.ne']; exact hq
      rw [if_neg this]
      simp
  · rw [if_neg (fun h ↦ hp h.1), jwStep_ket, if_neg hp]
    simp

theorem number_ket {k : ℕ} (p : Fin k) (β : BitAssignment k) :
    ((jwAnnihilate k p)ᴴ * jwAnnihilate k p) *ᵥ ket β = if β p = 1 then ket β else 0 := by
  rw [jwAdjMul]
  simp only [← Matrix.mulVec_mulVec]
  by_cases hp : β p = 1
  · rw [if_pos hp, jwStep_ket, if_pos hp, jwString_ket, Matrix.mulVec_smul, jwString_ket,
      Matrix.mulVec_smul, Matrix.mulVec_smul, jwStepH_ket, Function.update_self, if_pos rfl,
      smul_smul, ← pow_add, ← two_mul, pow_mul, Function.update_idem, ← hp,
      Function.update_eq_self]
    simp
  · rw [if_neg hp, jwStep_ket, if_neg hp]
    simp

end JWPauliAux

open JWPauliAux

theorem numberOp_eq_pauli (k : ℕ) (p : Fin k) :
    (jwAnnihilate k p)ᴴ * jwAnnihilate k p =
      (2 : ℂ)⁻¹ • (1 - (selectPauliString (zRow k p)).1) := by
  apply matrix_ext_ket
  intro β
  rw [number_ket, Matrix.smul_mulVec, Matrix.sub_mulVec, Matrix.one_mulVec, zString_ket]
  rcases bit_cases (β p) with h | h
  · simp [h, bitSign]
  · have h1 : (1 : ZMod 2) ≠ 0 := by decide
    simp [h, bitSign, h1]
    try module

theorem hop_eq_pauli (k : ℕ) (p q : Fin k) (hpq : p < q) :
    (jwAnnihilate k p)ᴴ * jwAnnihilate k q + (jwAnnihilate k q)ᴴ * jwAnnihilate k p =
      (2 : ℂ)⁻¹ • ((selectPauliString (hopRow k p q .X)).1 +
        (selectPauliString (hopRow k p q .Y)).1) := by
  apply matrix_ext_ket
  intro β
  rw [Matrix.add_mulVec, hop_ket₁ p q hpq, hop_ket₂ p q hpq, Matrix.smul_mulVec,
    Matrix.add_mulVec, hopString_ket p q hpq .X rfl, hopString_ket p q hpq .Y rfl]
  rcases bit_cases (β p) with hp | hp <;> rcases bit_cases (β q) with hq | hq <;>
    simp [hp, hq, pc] <;> module

theorem sum_sum_split {M : Type*} [AddCommMonoid M] {N : ℕ} (F : Fin N → Fin N → M) :
    ∑ p, ∑ q, F p q = ∑ p, F p p +
      ∑ p, ∑ q ∈ Finset.univ.filter (fun q ↦ p < q), F p q +
      ∑ p, ∑ q ∈ Finset.univ.filter (fun q ↦ p < q), F q p := by
  have h1 : ∀ p : Fin N, ∑ q, F p q = F p p +
      ∑ q ∈ Finset.univ.filter (fun q ↦ p < q), F p q +
      ∑ q ∈ Finset.univ.filter (fun q ↦ q < p), F p q := by
    intro p
    rw [Finset.sum_filter, Finset.sum_filter]
    have hFp : F p p = ∑ q, if q = p then F p q else 0 := by simp
    rw [hFp, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun q _ ↦ ?_
    rcases lt_trichotomy p q with h | h | h
    · simp [h, h.ne', not_lt.2 h.le]
    · subst h; simp
    · simp [h, h.ne, not_lt.2 h.le]
  have h2 : ∑ p, ∑ q ∈ Finset.univ.filter (fun q ↦ q < p), F p q =
      ∑ p, ∑ q ∈ Finset.univ.filter (fun q ↦ p < q), F q p := by
    simp only [Finset.sum_filter]
    exact Finset.sum_comm
  rw [Finset.sum_congr rfl (fun p _ ↦ h1 p), Finset.sum_add_distrib, Finset.sum_add_distrib, h2]

theorem oneBodyHamiltonian_eq_pauli (N : ℕ) (h : Matrix (Fin N) (Fin N) ℝ) (hs : h.IsSymm) :
    oneBodyHamiltonian h =
      ∑ σ : Fin 2,
        ((∑ p : Fin N, ((h p p : ℂ) * (2 : ℂ)⁻¹) •
            (1 - (selectPauliString (zRow (2 * N) (spinOrbital N p σ))).1)) +
          ∑ p : Fin N, ∑ q ∈ Finset.univ.filter (fun q : Fin N ↦ p < q),
            ((h p q : ℂ) * (2 : ℂ)⁻¹) •
              ((selectPauliString (hopRow (2 * N) (spinOrbital N p σ) (spinOrbital N q σ) .X)).1 +
                (selectPauliString (hopRow (2 * N) (spinOrbital N p σ) (spinOrbital N q σ) .Y)).1)) := by
  unfold oneBodyHamiltonian
  refine Finset.sum_congr rfl fun σ _ ↦ ?_
  have hw : ∀ p q : Fin N, p < q → spinOrbital N p σ < spinOrbital N q σ := by
    intro p q hpq
    rw [Fin.lt_def] at hpq ⊢
    simp only [spinOrbital]
    omega
  rw [sum_sum_split, add_assoc]
  congr 1
  · refine Finset.sum_congr rfl fun p _ ↦ ?_
    rw [numberOp_eq_pauli, smul_smul]
  · rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun p _ ↦ ?_
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun q hq ↦ ?_
    have hpq : p < q := (Finset.mem_filter.mp hq).2
