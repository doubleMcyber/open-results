/-- Row index. -/
abbrev RowIdx (N : ℕ) : Type := Fin 2 × Fin N × Fin N × Fin 2

/-- The Pauli string of a row. -/
def pRow (N : ℕ) : RowIdx N → Fin (2 * N) → SelectPauli.Pauli
  | (σ, p, q, x) =>
    if p = q then zRow (2 * N) (spinOrbital N p σ)
    else hopRow (2 * N) (spinOrbital N (min p q) σ) (spinOrbital N (max p q) σ)
      (if x = 0 then .X else .Y)

/-- The coefficient of a row. -/
noncomputable def coef {N : ℕ} (g : Matrix (Fin N) (Fin N) ℝ) : RowIdx N → ℝ
  | (_, p, q, _) => if p = q then -(g p p) / 4 else g p q / 4

/-- The two `x` rows of a diagonal entry. -/
theorem rows_diag {N : ℕ} (g : Matrix (Fin N) (Fin N) ℝ) (σ : Fin 2) (p : Fin N) :
    ∑ x : Fin 2, ((coef g (σ, p, p, x) : ℝ) : ℂ) • (selectPauliString (pRow N (σ, p, p, x))).1 =
      (-((g p p : ℂ) * (2 : ℂ)⁻¹)) • (selectPauliString (zRow (2 * N) (spinOrbital N p σ))).1 := by
  simp only [Fin.sum_univ_two, coef, pRow, if_true]
  push_cast
  module

/-- The `2 × 2` rows of an off-diagonal pair `p < q`. -/
theorem rows_hop {N : ℕ} (g : Matrix (Fin N) (Fin N) ℝ) (hs : g.IsSymm) (σ : Fin 2)
    {p q : Fin N} (hpq : p < q) :
    ∑ x : Fin 2, ((coef g (σ, p, q, x) : ℝ) : ℂ) • (selectPauliString (pRow N (σ, p, q, x))).1 +
      ∑ x : Fin 2, ((coef g (σ, q, p, x) : ℝ) : ℂ) • (selectPauliString (pRow N (σ, q, p, x))).1 =
      ((g p q : ℂ) * (2 : ℂ)⁻¹) •
        ((selectPauliString (hopRow (2 * N) (spinOrbital N p σ) (spinOrbital N q σ) .X)).1 +
          (selectPauliString (hopRow (2 * N) (spinOrbital N p σ) (spinOrbital N q σ) .Y)).1) := by
  have h1 : p ≠ q := hpq.ne
  have h2 : q ≠ p := hpq.ne'
  have hsym : g q p = g p q := hs.apply p q
  simp only [Fin.sum_univ_two, coef, pRow, if_neg h1, if_neg h2, min_eq_left hpq.le,
    max_eq_right hpq.le, min_eq_right hpq.le, max_eq_left hpq.le, hsym]
  simp only [Fin.isValue, if_true, one_ne_zero, if_false, Fin.one_eq_zero_iff, OfNat.ofNat_ne_zero]
  push_cast
  module

