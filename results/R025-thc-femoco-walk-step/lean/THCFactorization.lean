namespace QC14.RegCascade

open QuantumComputation QuantumComputation.Specs Matrix
open QuantumComputation.Specs.ArcsinImpl
open QC14.Catalytic QC14.GivensPlane QC14.GivensCascade QC14.RegKick
open QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.GivensOps
open Operator QProg Function
open scoped Matrix ComplexOrder MatrixOrder

variable {n : ℕ}

/-! ## Block-diagonal unitaries -/

/-- Low `k` bits of a `(k + j)`-bit index (the target part). -/
def bdLo {k j : ℕ} (x : Fin (2 ^ (k + j))) : Fin (2 ^ k) :=
  ⟨x.val % 2 ^ k, Nat.mod_lt _ (by positivity)⟩

theorem bdHi_lt {k j : ℕ} (x : Fin (2 ^ (k + j))) : x.val / 2 ^ k < 2 ^ j := by
  rw [Nat.div_lt_iff_lt_mul (by positivity), ← pow_add, Nat.add_comm j k]
  exact x.isLt

/-- High `j` bits of a `(k + j)`-bit index (the control word). -/
def bdHi {k j : ℕ} (x : Fin (2 ^ (k + j))) : Fin (2 ^ j) :=
  ⟨x.val / 2 ^ k, bdHi_lt x⟩

theorem rcBits_lo {k j : ℕ} (x : Fin (2 ^ (k + j))) (i : Fin k) :
    basisBits (k + j) x (Fin.castAdd j i) = basisBits k (bdLo x) i := by
  rw [basisBits_eq_testBit, basisBits_eq_testBit]
  show (if x.val.testBit i.val then 1 else 0 : ZMod 2) =
    if (x.val % 2 ^ k).testBit i.val then 1 else 0
  rw [Nat.testBit_mod_two_pow]
  simp [i.isLt]

theorem rcBits_hi {k j : ℕ} (x : Fin (2 ^ (k + j))) (l : Fin j) :
    basisBits (k + j) x (Fin.natAdd k l) = basisBits j (bdHi x) l := by
  rw [basisBits_eq_testBit, basisBits_eq_testBit]
  show (if x.val.testBit (k + l.val) then 1 else 0 : ZMod 2) =
    if (x.val / 2 ^ k).testBit l.val then 1 else 0
  rw [Nat.testBit_div_two_pow, Nat.add_comm l.val k]

theorem rcEq_iff {k j : ℕ} (x y : Fin (2 ^ (k + j))) :
    x = y ↔ bdLo x = bdLo y ∧ bdHi x = bdHi y := by
  constructor
  · rintro rfl
    exact ⟨rfl, rfl⟩
  · rintro ⟨h1, h2⟩
    apply Fin.ext
    have e1 := congrArg Fin.val h1
    have e2 := congrArg Fin.val h2
    change x.val % 2 ^ k = y.val % 2 ^ k at e1
    change x.val / 2 ^ k = y.val / 2 ^ k at e2
    rw [← Nat.mod_add_div x.val (2 ^ k), ← Nat.mod_add_div y.val (2 ^ k), e1, e2]

/-- `x ↦ (bdLo x, bdHi x)`. -/
def rcSplit (k j : ℕ) : Fin (2 ^ (k + j)) ≃ Fin (2 ^ k) × Fin (2 ^ j) where
  toFun x := (bdLo x, bdHi x)
  invFun p := ⟨p.1.val + 2 ^ k * p.2.val, by
    have h1 := p.1.isLt
    have h2 := p.2.isLt
    have h3 : 2 ^ k * p.2.val + 2 ^ k ≤ 2 ^ k * 2 ^ j := by
      rw [← Nat.mul_succ]
      exact Nat.mul_le_mul_left _ h2
    rw [pow_add]
    omega⟩
  left_inv x := Fin.ext (Nat.mod_add_div x.val (2 ^ k))
  right_inv p := by
    obtain ⟨⟨a, ha⟩, ⟨c, hc⟩⟩ := p
    have hp : 0 < 2 ^ k := by positivity
    refine Prod.ext (Fin.ext ?_) (Fin.ext ?_)
    · show (a + 2 ^ k * c) % 2 ^ k = a
      rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt ha]
    · show (a + 2 ^ k * c) / 2 ^ k = c
      rw [Nat.add_mul_div_left _ _ hp, Nat.div_eq_of_lt ha, Nat.zero_add]

theorem rcSplit_apply {k j : ℕ} (x : Fin (2 ^ (k + j))) : rcSplit k j x = (bdLo x, bdHi x) :=
  rfl

/-- Block-diagonal matrix in the `(bdLo, bdHi)` coordinates. -/
noncomputable def rcBD {k j : ℕ} (M : Fin (2 ^ j) → Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ) :
    Matrix (Fin (2 ^ (k + j))) (Fin (2 ^ (k + j))) ℂ :=
  (blockDiagonal M).submatrix (rcSplit k j) (rcSplit k j)

theorem rcBD_mul {k j : ℕ} (M M' : Fin (2 ^ j) → Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ) :
    rcBD M * rcBD M' = rcBD (fun a ↦ M a * M' a) := by
  unfold rcBD
  rw [submatrix_mul_equiv, blockDiagonal_mul]

theorem rcBD_one {k j : ℕ} :
    rcBD (fun _ : Fin (2 ^ j) ↦ (1 : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ)) = 1 := by
  unfold rcBD
  rw [← Pi.one_def, blockDiagonal_one, submatrix_one_equiv]

theorem rcBD_conj {k j : ℕ} (M : Fin (2 ^ j) → Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ) :
    (rcBD M)ᴴ = rcBD (fun a ↦ (M a)ᴴ) := by
  unfold rcBD
  rw [conjTranspose_submatrix, blockDiagonal_conjTranspose]

/-- `Σ_a |a⟩⟨a| ⊗ W a` as a matrix. -/
noncomputable def blockDiagMat {k j : ℕ} (W : Fin (2 ^ j) → Unitary (2 ^ k)) :
    Matrix (Fin (2 ^ (k + j))) (Fin (2 ^ (k + j))) ℂ :=
  fun x y ↦ if bdHi x = bdHi y then (W (bdHi y)).1 (bdLo x) (bdLo y) else 0

theorem rcMat_eq {k j : ℕ} (W : Fin (2 ^ j) → Unitary (2 ^ k)) :
    blockDiagMat W = rcBD (fun a ↦ (W a).1) := by
  ext x y
  simp only [rcBD, submatrix_apply, blockDiagonal_apply, rcSplit_apply, blockDiagMat]
  split_ifs with h <;> simp [h]

theorem blockDiagMat_mem {k j : ℕ} (W : Fin (2 ^ j) → Unitary (2 ^ k)) :
    blockDiagMat W ∈ Matrix.unitaryGroup (Fin (2 ^ (k + j))) ℂ := by
  rw [rcMat_eq, Matrix.mem_unitaryGroup_iff, star_eq_conjTranspose, rcBD_conj, rcBD_mul]
  have e : (fun a ↦ (W a).1 * ((W a).1)ᴴ) =
      fun _ ↦ (1 : Matrix (Fin (2 ^ k)) (Fin (2 ^ k)) ℂ) := by
    funext a
    rw [← star_eq_conjTranspose]
    exact Matrix.mem_unitaryGroup_iff.mp (W a).2
  rw [e, rcBD_one]

/-- The block-diagonal unitary `Σ_a |a⟩⟨a| ⊗ W a`. -/
noncomputable def blockDiag {k j : ℕ} (W : Fin (2 ^ j) → Unitary (2 ^ k)) :
    Unitary (2 ^ (k + j)) :=
  ⟨blockDiagMat W, blockDiagMat_mem W⟩

theorem blockDiag_val {k j : ℕ} (W : Fin (2 ^ j) → Unitary (2 ^ k)) :
    (blockDiag W).1 = blockDiagMat W := rfl

theorem blockDiag_mul {k j : ℕ} (W V : Fin (2 ^ j) → Unitary (2 ^ k)) :
    blockDiag W * blockDiag V = blockDiag (fun a ↦ W a * V a) := by
  apply Subtype.ext
  show blockDiagMat W * blockDiagMat V = blockDiagMat (fun a ↦ W a * V a)
  rw [rcMat_eq, rcMat_eq, rcMat_eq]
  exact rcBD_mul _ _

theorem blockDiag_one {k j : ℕ} :
    blockDiag (fun _ : Fin (2 ^ j) ↦ (1 : Unitary (2 ^ k))) = 1 := by
  apply Subtype.ext
  show blockDiagMat (fun _ : Fin (2 ^ j) ↦ (1 : Unitary (2 ^ k))) = 1
  rw [rcMat_eq]
  exact rcBD_one

theorem blockDiag_inv {k j : ℕ} (W : Fin (2 ^ j) → Unitary (2 ^ k)) :
    (blockDiag W)⁻¹ = blockDiag (fun a ↦ (W a)⁻¹) := by
  apply inv_eq_of_mul_eq_one_right
  rw [blockDiag_mul]
  have e : (fun a ↦ W a * (W a)⁻¹) = fun _ ↦ (1 : Unitary (2 ^ k)) :=
    funext fun a ↦ mul_inv_cancel (W a)
  rw [e, blockDiag_one]

theorem rcExt_block {M : ℕ} (o w : ℕ) (h : o + w ≤ M) (x : Fin (2 ^ M)) :
    ((QRegister.block o w h).extractIndex x).val = x.val / 2 ^ o % 2 ^ w := by
  have hlt : x.val / 2 ^ o % 2 ^ w < 2 ^ w := Nat.mod_lt _ (by positivity)
  have e : (QRegister.block o w h).extractIndex x = ⟨x.val / 2 ^ o % 2 ^ w, hlt⟩ := by
    apply (basisBits w).injective
    funext i
    rw [QRegister.basisBits_extractIndex, basisBits_eq_testBit, basisBits_eq_testBit]
    show (if x.val.testBit (o + i.val) then 1 else 0 : ZMod 2) =
      if (x.val / 2 ^ o % 2 ^ w).testBit i.val then 1 else 0
    rw [Nat.testBit_mod_two_pow, Nat.testBit_div_two_pow, Nat.add_comm i.val o]
    simp [i.isLt]
  rw [e]

theorem rcLo_eq {k j : ℕ} (x : Fin (2 ^ (k + j))) :
    bdLo x = (QRegister.block 0 k (by omega) : QRegister k (k + j)).extractIndex x := by
  apply Fin.ext
  rw [rcExt_block]
  show x.val % 2 ^ k = x.val / 2 ^ 0 % 2 ^ k
  rw [pow_zero, Nat.div_one]

theorem rcB0 {k j : ℕ} (h : 0 + k ≤ k + j) (i : Fin k) :
    (QRegister.block 0 k h : QRegister k (k + j)) i = Fin.castAdd j i :=
  Fin.ext (by change 0 + i.val = i.val; omega)

theorem rcB1 {k j : ℕ} (h : k + j ≤ k + j) (i : Fin j) :
    (QRegister.block k j h : QRegister j (k + j)) i = Fin.natAdd k i :=
  Fin.ext rfl

theorem rcAgree_block0 {k j : ℕ} (h : 0 + k ≤ k + j) (x y : Fin (2 ^ (k + j))) :
    (QRegister.block 0 k h : QRegister k (k + j)).AgreeOutside x y ↔ bdHi x = bdHi y := by
  constructor
  · intro hA
    apply (basisBits j).injective
    funext l
    rw [← rcBits_hi, ← rcBits_hi]
    apply hA
    rintro ⟨i, hi⟩
    have e := congrArg Fin.val hi
    change 0 + i.val = k + l.val at e
    have := i.isLt
    omega
  · intro hH q hq
    induction q using Fin.addCases with
    | left i => exact (hq ⟨i, rcB0 h i⟩).elim
    | right l => rw [rcBits_hi, rcBits_hi, hH]

/-- A constant block is the unitary on the low `k` wires. -/
theorem blockDiag_const {k j : ℕ} (U : Unitary (2 ^ k)) :
    blockDiag (fun _ : Fin (2 ^ j) ↦ U) =
      (QRegister.block 0 k (by omega) : QRegister k (k + j)).embedUnitary U := by
  apply Subtype.ext
  ext x y
  change blockDiagMat (fun _ ↦ U) x y =
    (QRegister.block 0 k (by omega) : QRegister k (k + j)).embedMatrix U.1 x y
  rw [QRegister.embedMatrix_apply_of_agreeOutside, ← rcLo_eq, ← rcLo_eq]
  by_cases hH : bdHi x = bdHi y <;> simp [blockDiagMat, hH, rcAgree_block0]

/-- Action on a basis ket: the control word `bdHi y` selects the block. -/
theorem blockDiag_mulVec_ket {k j : ℕ} (W : Fin (2 ^ j) → Unitary (2 ^ k))
    (y : Fin (2 ^ (k + j))) :
    (blockDiag W).1 *ᵥ (Pi.single y 1 : Fin (2 ^ (k + j)) → ℂ) =
      fun x ↦ if bdHi x = bdHi y then (W (bdHi y)).1 (bdLo x) (bdLo y) else 0 := by
  rw [mulVec_single_one]
  rfl

theorem rcBD_diag {k j : ℕ} (W : Fin (2 ^ j) → Unitary (2 ^ k))
    (d : Fin (2 ^ j) → Fin (2 ^ k) → ℂ) (h : ∀ a, (W a).1 = diagonal (d a)) :
    blockDiagMat W = diagonal (fun x ↦ d (bdHi x) (bdLo x)) := by
  ext x y
  simp only [blockDiagMat, h, diagonal_apply]
  by_cases hxy : x = y
  · subst hxy
    simp
  · by_cases hH : bdHi x = bdHi y
    · have hL : bdLo x ≠ bdLo y := fun hL ↦ hxy ((rcEq_iff x y).2 ⟨hL, hH⟩)
      simp [hxy, hH, hL]
    · simp [hxy, hH]

/-! ## Embedding a block-diagonal unitary of a sub-register -/

theorem lrReg_disj {k j p w : ℕ} (P : QRegister p k) (Q : QRegister w j) :
    ((QRegister.block 0 k (by omega) : QRegister k (k + j)).compose P).DisjointWires
      ((QRegister.block k j le_rfl : QRegister j (k + j)).compose Q) := by
  exact ((QRegister.block_disjoint_of_le 0 k k j (by omega) le_rfl (by omega)).compose_left
    P).compose_right Q

/-- `P` inside the low (target) part and `Q` inside the high (control) part of `k + j` wires. -/
def lrReg {k j p w : ℕ} (P : QRegister p k) (Q : QRegister w j) : QRegister (p + w) (k + j) :=
  ((QRegister.block 0 k (by omega) : QRegister k (k + j)).compose P).concat
    ((QRegister.block k j le_rfl : QRegister j (k + j)).compose Q) (lrReg_disj P Q)

theorem rcLr_left {k j p w : ℕ} (P : QRegister p k) (Q : QRegister w j) (a : Fin p) :
    lrReg P Q (Fin.castAdd w a) = Fin.castAdd j (P a) := by
  simp only [lrReg, QRegister.concat_apply_left, QRegister.compose_apply, rcB0]

theorem rcLr_right {k j p w : ℕ} (P : QRegister p k) (Q : QRegister w j) (a : Fin w) :
    lrReg P Q (Fin.natAdd p a) = Fin.natAdd k (Q a) := by
  simp only [lrReg, QRegister.concat_apply_right, QRegister.compose_apply, rcB1]

/-- `(rT ++ rA)` restricted by `lrReg P Q` is `(rT ∘ P) ++ (rA ∘ Q)`. -/
theorem concat_compose_lrReg {k j p w : ℕ} (rT : QRegister k n) (rA : QRegister j n)
    (hTA : rT.DisjointWires rA) (P : QRegister p k) (Q : QRegister w j) :
    (rT.concat rA hTA).compose (lrReg P Q) =
      (rT.compose P).concat (rA.compose Q) ((hTA.compose_left P).compose_right Q) := by
  apply QRegister.ext
  ext i
  induction i using Fin.addCases with
  | left a => simp only [QRegister.compose_apply, rcLr_left, QRegister.concat_apply_left]
  | right a => simp only [QRegister.compose_apply, rcLr_right, QRegister.concat_apply_right]

theorem rcAgree_lr {k j p w : ℕ} (P : QRegister p k) (Q : QRegister w j)
    (x y : Fin (2 ^ (k + j))) :
    (lrReg P Q).AgreeOutside x y ↔
      P.AgreeOutside (bdLo x) (bdLo y) ∧ Q.AgreeOutside (bdHi x) (bdHi y) := by
  constructor
  · intro h
    refine ⟨fun q hq ↦ ?_, fun q hq ↦ ?_⟩
    · rw [← rcBits_lo, ← rcBits_lo]
      apply h
      rintro ⟨t, ht⟩
      induction t using Fin.addCases with
      | left a =>
          rw [rcLr_left] at ht
          have e := congrArg Fin.val ht
          change (P.wires a).val = q.val at e
          exact hq ⟨a, Fin.ext e⟩
      | right a =>
          rw [rcLr_right] at ht
          have e := congrArg Fin.val ht
          change k + (Q a).val = q.val at e
          have := q.isLt
          omega
    · rw [← rcBits_hi, ← rcBits_hi]
      apply h
      rintro ⟨t, ht⟩
      induction t using Fin.addCases with
      | left a =>
          rw [rcLr_left] at ht
          have e := congrArg Fin.val ht
          change (P a).val = k + q.val at e
          have := (P a).isLt
          omega
      | right a =>
          rw [rcLr_right] at ht
          have e := congrArg Fin.val ht
          change k + (Q a).val = k + q.val at e
          exact hq ⟨a, Fin.ext (by omega)⟩
  · rintro ⟨hP, hQ⟩ q hq
    induction q using Fin.addCases with
    | left a =>
        rw [rcBits_lo, rcBits_lo]
        apply hP
        rintro ⟨t, rfl⟩
        exact hq ⟨Fin.castAdd w t, rcLr_left P Q t⟩
    | right a =>
        rw [rcBits_hi, rcBits_hi]
        apply hQ
        rintro ⟨t, rfl⟩
        exact hq ⟨Fin.natAdd p t, rcLr_right P Q t⟩

theorem rcLoL {k j p w : ℕ} (P : QRegister p k) (Q : QRegister w j) (x : Fin (2 ^ (k + j))) :
    bdLo ((lrReg P Q).extractIndex x) = P.extractIndex (bdLo x) := by
  apply (basisBits p).injective
  funext i
  rw [← rcBits_lo, QRegister.basisBits_extractIndex, QRegister.basisBits_extractIndex,
    rcLr_left, rcBits_lo]

theorem rcHiL {k j p w : ℕ} (P : QRegister p k) (Q : QRegister w j) (x : Fin (2 ^ (k + j))) :
    bdHi ((lrReg P Q).extractIndex x) = Q.extractIndex (bdHi x) := by
  apply (basisBits w).injective
  funext i
  rw [← rcBits_hi, QRegister.basisBits_extractIndex, QRegister.basisBits_extractIndex,
    rcLr_right, rcBits_hi]

theorem rcEqIff_reg {j w : ℕ} (Q : QRegister w j) (a c : Fin (2 ^ j)) :
    a = c ↔ Q.extractIndex a = Q.extractIndex c ∧ Q.AgreeOutside a c := by
  constructor
  · rintro rfl
    exact ⟨rfl, fun _ _ ↦ rfl⟩
  · rintro ⟨h1, h2⟩
    apply (basisBits j).injective
    funext q
    by_cases hq : q ∈ Set.range Q.wires
    · obtain ⟨i, rfl⟩ := hq
      rw [← QRegister.basisBits_extractIndex, ← QRegister.basisBits_extractIndex, h1]
    · exact h2 q hq

/-- A block-diagonal unitary on `P ++ Q` embeds as the block-diagonal unitary whose block at
control word `x` is `W` at `Q`'s part of `x`, placed on `P`. -/
theorem embedUnitary_lrReg_blockDiag {k j p w : ℕ} (P : QRegister p k) (Q : QRegister w j)
    (W : Fin (2 ^ w) → Unitary (2 ^ p)) :
    (lrReg P Q).embedUnitary (blockDiag W) =
      blockDiag (fun x : Fin (2 ^ j) ↦ P.embedUnitary (W (Q.extractIndex x))) := by
  apply Subtype.ext
  ext x y
  change (lrReg P Q).embedMatrix (blockDiagMat W) x y =
    blockDiagMat (fun x : Fin (2 ^ j) ↦ P.embedUnitary (W (Q.extractIndex x))) x y
  rw [QRegister.embedMatrix_apply_of_agreeOutside]
  simp only [blockDiagMat, rcLoL, rcHiL, QRegister.embedUnitary_val,
    QRegister.embedMatrix_apply_of_agreeOutside, rcAgree_lr]
  have hH := rcEqIff_reg Q (bdHi x) (bdHi y)
  by_cases hP : P.AgreeOutside (bdLo x) (bdLo y) <;>
  by_cases hQ : Q.AgreeOutside (bdHi x) (bdHi y) <;>
  by_cases hE : Q.extractIndex (bdHi x) = Q.extractIndex (bdHi y) <;>
  simp [hP, hQ, hE, hH, rcAgree_lr]

/-! ## The register plane -/

theorem kickSel_inj (b : ℕ) (i : Fin 2) :
    Injective (Fin.cons (Fin.castAdd b i) (fun j : Fin b ↦ Fin.natAdd 2 j) :
      Fin (b + 1) → Fin (2 + b)) := by
  rw [Fin.cons_injective_iff]
  refine ⟨?_, ?_⟩
  · rintro ⟨l, hl⟩
    have e := congrArg Fin.val hl
    change 2 + l.val = i.val at e
    have := i.isLt
    omega
  · intro a c h
    have e := congrArg Fin.val h
    change 2 + a.val = 2 + c.val at e
    exact Fin.ext (by omega)

/-- Kick target inside `r2 ++ rW`: wire `i` of the pair, then the `b` word wires. -/
def kickSel (b : ℕ) (i : Fin 2) : QRegister (b + 1) (2 + b) where
  wires := ⟨Fin.cons (Fin.castAdd b i) (fun j : Fin b ↦ Fin.natAdd 2 j), kickSel_inj b i⟩

/-- Plane angle at word value `a`: `2·2πa/2^b`, negated for the inverse plane. -/
noncomputable def regPlaneAngle (b : ℕ) (inv : Bool) (a : Fin (2 ^ b)) : ℝ :=
  (if inv then -1 else 1) * (2 * (2 * Real.pi * (a.val : ℝ) / 2 ^ b))

/-- One Givens plane on `r2` whose angle is read from the word `rW`. -/
noncomputable def regPlaneProgram {Var : Type} (v : Var) (b : ℕ) (inv : Bool)
    (r2 : QRegister 2 n) (rW : QRegister b n) (h2W : r2.DisjointWires rW)
    (rS : QRegister (2 * b) n) (rCat : QRegister b n) : DynamicCircuit Var n :=
  .seq (.circuit (planeClifford.onRegister r2))
    (.seq (regKickProgram v b (!inv) ((r2.concat rW h2W).compose (kickSel b 0)) rS rCat)
      (.seq (regKickProgram v b inv ((r2.concat rW h2W).compose (kickSel b 1)) rS rCat)
        (.circuit (planeClifford.inverse.onRegister r2))))

/-- The kick constant of `kickF` as a function of the word value. -/
def rcG (b : ℕ) (neg : Bool) (w : ℕ) : ℕ :=
  if neg then 2 ^ b - 2 * w % 2 ^ b else 2 * w

theorem rcSumNat (x : ℕ) : ∀ m : ℕ, ∑ l ∈ Finset.range m, x / 2 ^ l % 2 * 2 ^ l = x % 2 ^ m
  | 0 => by rw [Finset.sum_range_zero, pow_zero, Nat.mod_one]
  | m + 1 => by
      rw [Finset.sum_range_succ, rcSumNat x m, Nat.mod_pow_succ]
      ring

theorem rcSumBits (b : ℕ) (a : Fin (2 ^ b)) :
    ∑ l : Fin b, (basisBits b a l).val * 2 ^ l.val = a.val := by
  have h : ∀ l : Fin b, (basisBits b a l).val = a.val / 2 ^ l.val % 2 := by
    intro l
    rw [basisBits_eq_div_mod, ZMod.val_natCast, Nat.mod_mod]
  simp only [h]
  exact (Fin.sum_univ_eq_sum_range (fun l ↦ a.val / 2 ^ l % 2 * 2 ^ l) b).trans
    ((rcSumNat a.val b).trans (Nat.mod_eq_of_lt a.isLt))

theorem rcFin1 (t : Fin (2 ^ 1)) : t.val = (basisBits 1 t 0).val := by
  rw [basisBits_eq_div_mod, ZMod.val_natCast]
  have h := t.isLt
  change t.val < 2 at h
  change t.val = t.val / 2 ^ 0 % 2 % 2
  rw [pow_zero, Nat.div_one, Nat.mod_mod, Nat.mod_eq_of_lt h]

theorem rcKickSel_zero (b : ℕ) (i : Fin 2) : kickSel b i 0 = Fin.castAdd b i := by
  show (Fin.cons (Fin.castAdd b i) (fun j : Fin b ↦ Fin.natAdd 2 j) :
    Fin (b + 1) → Fin (2 + b)) 0 = _
  exact Fin.cons_zero _ _

theorem rcKickSel_succ (b : ℕ) (i : Fin 2) (l : Fin b) : kickSel b i l.succ = Fin.natAdd 2 l := by
  show (Fin.cons (Fin.castAdd b i) (fun j : Fin b ↦ Fin.natAdd 2 j) :
    Fin (b + 1) → Fin (2 + b)) l.succ = _
  exact Fin.cons_succ _ _ _

theorem rcWord (b : ℕ) (i : Fin 2) (x : Fin (2 ^ (2 + b))) :
    kickWord b ((kickSel b i).extractIndex x) = (bdHi x).val := by
  unfold kickWord
  simp only [QRegister.basisBits_extractIndex, rcKickSel_succ, rcBits_hi]
  exact rcSumBits b (bdHi x)

theorem rcKickF (b : ℕ) (neg : Bool) (i : Fin 2) (x : Fin (2 ^ (2 + b))) :
    kickF b neg ((kickSel b i).extractIndex x) =
      ((QRegister.singleton (n := 2) i).extractIndex (bdLo x)).val * rcG b neg (bdHi x).val := by
  have h0 : (basisBits (b + 1) ((kickSel b i).extractIndex x) 0).val =
      ((QRegister.singleton (n := 2) i).extractIndex (bdLo x)).val := by
    rw [rcFin1 ((QRegister.singleton (n := 2) i).extractIndex (bdLo x)),
      QRegister.basisBits_extractIndex, QRegister.basisBits_extractIndex, rcKickSel_zero,
      QRegister.singleton_apply, rcBits_lo]
  unfold kickF rcG
  rw [h0, rcWord]

theorem rcKick (b : ℕ) (neg : Bool) (i : Fin 2) :
    (kickSel b i).embedUnitary (phaseUnitary (b + 1) b (kickF b neg)) =
      blockDiag (k := 2) (j := b) (fun a ↦ (QRegister.singleton (n := 2) i).embedUnitary
        (phaseUnitary 1 b (fun t ↦ t.val * rcG b neg a.val))) := by
  have hd : ∀ a : Fin (2 ^ b), ((QRegister.singleton (n := 2) i).embedUnitary
      (phaseUnitary 1 b (fun t ↦ t.val * rcG b neg a.val))).1 =
      diagonal (fun g ↦ Complex.exp (2 * Real.pi * Complex.I *
        ((((QRegister.singleton (n := 2) i).extractIndex g).val * rcG b neg a.val : ℕ) : ℂ) /
          2 ^ b)) := by
    intro a
    rw [QRegister.embedUnitary_val, phaseUnitary_val, QRegister.embedMatrix_diagonal]
  apply Subtype.ext
  rw [QRegister.embedUnitary_val, phaseUnitary_val, QRegister.embedMatrix_diagonal, blockDiag_val,
    rcBD_diag _ _ hd]
  congr 1
  funext x
  rw [rcKickF]

theorem rcExpCongr (b u u' : ℕ) (h : (u : ℤ) % 2 ^ b = (u' : ℤ) % 2 ^ b) :
    Complex.exp (2 * Real.pi * Complex.I * (u : ℂ) / 2 ^ b) =
      Complex.exp (2 * Real.pi * Complex.I * (u' : ℂ) / 2 ^ b) := by
  have hk : kickConst b u = kickConst b u' := Fin.ext (by simp only [kickConst, h])
  have e1 := exp_kickConst b u
  have e2 := exp_kickConst b u'
  rw [hk, Int.cast_natCast] at e1
  rw [Int.cast_natCast] at e2
  rw [← e1, e2]

theorem rcPhaseCongr {k b : ℕ} (f g : Fin (2 ^ k) → ℕ)
    (h : ∀ t, ((f t : ℕ) : ℤ) % 2 ^ b = ((g t : ℕ) : ℤ) % 2 ^ b) :
    phaseUnitary k b f = phaseUnitary k b g := by
  apply Subtype.ext
  rw [phaseUnitary_val, phaseUnitary_val]
  congr 1
  funext t
  exact rcExpCongr b (f t) (g t) (h t)

theorem rcGmod (b w : ℕ) (neg : Bool) :
    ((rcG b neg w : ℕ) : ℤ) % 2 ^ b = (if neg then -(2 * (w : ℤ)) else 2 * w) % 2 ^ b := by
  cases neg
  · show ((2 * w : ℕ) : ℤ) % 2 ^ b = (2 * (w : ℤ)) % 2 ^ b
    simp only [Nat.cast_mul, Nat.cast_ofNat]
  · show ((2 ^ b - 2 * w % 2 ^ b : ℕ) : ℤ) % 2 ^ b = (-(2 * (w : ℤ))) % 2 ^ b
    have hlt : 2 * w % 2 ^ b ≤ 2 ^ b := (Nat.mod_lt _ (by positivity)).le
    rw [Nat.cast_sub hlt]
    push_cast
    have e : (2 : ℤ) ^ b - 2 * (w : ℤ) % 2 ^ b = -(2 * w) + 2 ^ b * (1 + 2 * w / 2 ^ b) := by
      rw [Int.emod_def]
      ring
    rw [e, Int.add_mul_emod_self_left]

theorem rcModKick (b w : ℕ) (neg : Bool) (s : ℤ)
    (hs : (if neg then -(2 * (w : ℤ)) else 2 * w) = s) (t : Fin (2 ^ 1)) :
    ((t.val * rcG b neg w : ℕ) : ℤ) % 2 ^ b = ((t.val * (kickConst b s).val : ℕ) : ℤ) % 2 ^ b := by
  have hX : Int.ModEq (2 ^ b) (rcG b neg w : ℤ) ((kickConst b s).val : ℤ) := by
    show (rcG b neg w : ℤ) % 2 ^ b = ((kickConst b s).val : ℤ) % 2 ^ b
    rw [kickConst_val_int, Int.emod_emod, rcGmod, hs]
  have := Int.ModEq.mul_left ((t.val : ℕ) : ℤ) hX
  simp only [Nat.cast_mul]
  exact this

theorem rcBlock (b : ℕ) (inv : Bool) (a : Fin (2 ^ b)) :
    ((planeClifford.inverse.eval *
        (QRegister.singleton (n := 2) (1 : Fin 2)).embedUnitary
          (phaseUnitary 1 b fun t ↦ t.val * rcG b inv a.val)) *
        (QRegister.singleton (n := 2) (0 : Fin 2)).embedUnitary
          (phaseUnitary 1 b fun t ↦ t.val * rcG b (!inv) a.val)) *
      planeClifford.eval = givensPlaneUnitary (regPlaneAngle b inv a) := by
  cases inv
  · have h1 : phaseUnitary 1 b (fun t ↦ t.val * rcG b false a.val) =
        phaseUnitary 1 b (fun t ↦ t.val * (kickConst b (2 * ((a.val : ℕ) : ℤ))).val) :=
      rcPhaseCongr _ _ (rcModKick b a.val false _ (by simp))
    have h0 : phaseUnitary 1 b (fun t ↦ t.val * rcG b true a.val) =
        phaseUnitary 1 b (fun t ↦ t.val * (kickConst b (-(2 * ((a.val : ℕ) : ℤ)))).val) :=
      rcPhaseCongr _ _ (rcModKick b a.val true _ (by simp))
    simp only [Bool.not_false]
    rw [h1, h0]
    refine (planeProgram_unitary b ((a.val : ℕ) : ℤ)).trans ?_
    congr 1
    rw [regPlaneAngle, if_neg Bool.false_ne_true]
    push_cast
    ring
  · have h1 : phaseUnitary 1 b (fun t ↦ t.val * rcG b true a.val) =
        phaseUnitary 1 b (fun t ↦ t.val * (kickConst b (2 * (-((a.val : ℕ) : ℤ)))).val) :=
      rcPhaseCongr _ _ (rcModKick b a.val true _ (by simp))
    have h0 : phaseUnitary 1 b (fun t ↦ t.val * rcG b false a.val) =
        phaseUnitary 1 b (fun t ↦ t.val * (kickConst b (-(2 * (-((a.val : ℕ) : ℤ))))).val) :=
      rcPhaseCongr _ _ (rcModKick b a.val false _ (by simp))
    simp only [Bool.not_true]
    rw [h1, h0]
    refine (planeProgram_unitary b (-((a.val : ℕ) : ℤ))).trans ?_
    congr 1
    rw [regPlaneAngle, if_pos rfl]
    push_cast
    ring

theorem rcConcat_lo {k m : ℕ} (r : QRegister k n) (s : QRegister m n) (h : r.DisjointWires s) :
    (r.concat s h).compose (QRegister.block 0 k (by omega)) = r := by
  apply QRegister.ext
  ext i
  simp only [QRegister.compose_apply, rcB0, QRegister.concat_apply_left]

theorem regPlane_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (b : ℕ)
    (hb : 2 ≤ b) (inv : Bool) (r2 : QRegister 2 n) (rW : QRegister b n)
    (h2W : r2.DisjointWires rW) (rS : QRegister (2 * b) n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (hdisj : (r2.concat rW h2W).DisjointWires (rS.concat rCat hsc)) :
    CatKet (r2.concat rW h2W) rS rCat hsc (regPlaneProgram v b inv r2 rW h2W rS rCat).compile
      (blockDiag fun a ↦ givensPlaneUnitary (regPlaneAngle b inv a)) := by
  have hc : ∀ c : Circuit 2, CatKet (r2.concat rW h2W) rS rCat hsc
      ((c.onRegister r2).compile (Var := Var)) (blockDiag fun _ : Fin (2 ^ b) ↦ c.eval) := by
    intro c
    have h0 : CatKet ((r2.concat rW h2W).compose (QRegister.block 0 2 (by omega))) rS rCat hsc
        ((c.onRegister r2).compile (Var := Var)) c.eval := by
      rw [rcConcat_lo]
      exact CatKet.circuit r2 rS rCat hsc c
    rw [blockDiag_const]
    exact CatKet.compose _ h0
  have hp : ∀ (i : Fin 2) (neg : Bool), CatKet (r2.concat rW h2W) rS rCat hsc
      (regKickProgram v b neg ((r2.concat rW h2W).compose (kickSel b i)) rS rCat).compile
      (blockDiag (k := 2) (j := b) fun a ↦ (QRegister.singleton (n := 2) i).embedUnitary
        (phaseUnitary 1 b (fun t ↦ t.val * rcG b neg a.val))) := by
    intro i neg
    rw [← rcKick b neg i]
    exact CatKet.compose (outer := r2.concat rW h2W) (kickSel b i)
      (regKick_catKet v b hb neg ((r2.concat rW h2W).compose (kickSel b i)) rS rCat hsc
        (hdisj.compose_left _))
  have h := CatKet.seq hdisj (hc planeClifford) (CatKet.seq hdisj (hp 0 (!inv))
    (CatKet.seq hdisj (hp 1 inv) (hc planeClifford.inverse)))
  simp only [blockDiag_mul, rcBlock] at h
  exact h

theorem regPlane_count {Var : Type} (v : Var) (b : ℕ) (inv : Bool) (r2 : QRegister 2 n)
    (rW : QRegister b n) (h2W : r2.DisjointWires rW) (rS : QRegister (2 * b) n)
    (rCat : QRegister b n) :
    (regPlaneProgram v b inv r2 rW h2W rS rCat).count PrimitiveGate.TOFF = 0 ∧
      (regPlaneProgram v b inv r2 rW h2W rS rCat).count PrimitiveGate.T ≤ 16 * b := by
  obtain ⟨a0, a1⟩ := regKick_count v b (!inv) ((r2.concat rW h2W).compose (kickSel b 0)) rS rCat
  obtain ⟨c0, c1⟩ := regKick_count v b inv ((r2.concat rW h2W).compose (kickSel b 1)) rS rCat
  have iT : planeClifford.inverse.count PrimitiveGate.T = 0 := by
    rw [Circuit.count_inverse_of_ne _ (by simp) (by simp)]
    exact planeClifford_count_T
  have iTOFF : planeClifford.inverse.count PrimitiveGate.TOFF = 0 := by
    rw [Circuit.count_inverse_of_ne _ (by simp) (by simp)]
    exact planeClifford_count_TOFF
  unfold regPlaneProgram
  simp only [DynamicCircuit.count, Circuit.count_onRegister, iT, iTOFF, planeClifford_count_T,
    planeClifford_count_TOFF, a0, c0]
  exact ⟨trivial, by omega⟩

/-! ## The register cascade -/

/-- The angle vector held in `N·b` angle bits: word `q` is bits `q·b … q·b + b − 1`. -/
def angleVec (N b : ℕ) (x : Fin (2 ^ (N * b))) : Fin N → ℤ :=
  fun q ↦ ((x.val / 2 ^ (q.val * b) % 2 ^ b : ℕ) : ℤ)

theorem angleWord_le (N b q : ℕ) (hq : q < N) : q * b + b ≤ N * b := by
  calc q * b + b = (q + 1) * b := by ring
    _ ≤ N * b := Nat.mul_le_mul_right b hq

/-- Word `q` of the angle register. -/
def angleWord {N : ℕ} (b q : ℕ) (rA : QRegister (N * b) n) (hq : q < N) : QRegister b n :=
  rA.slice (q * b) b (angleWord_le N b q hq)

theorem rcDisj {N b : ℕ} (rT : QRegister N n) (rA : QRegister (N * b) n)
    (hTA : rT.DisjointWires rA) (m : ℕ) (hm : m + 1 < N) :
    (rT.compose (pairAdj N m hm)).DisjointWires (angleWord b m rA (by omega)) := by
  exact (hTA.compose_left (pairAdj N m hm)).compose_right
    (QRegister.block (m * b) b (angleWord_le N b m (by omega)))

/-- Planes `m − 1` down to `0`, angles from the words of `rA`. -/
noncomputable def regCascadeProgram {Var : Type} (v : Var) (b : ℕ) {N : ℕ}
    (rT : QRegister N n) (rA : QRegister (N * b) n) (hTA : rT.DisjointWires rA)
    (rS : QRegister (2 * b) n) (rCat : QRegister b n) : (m : ℕ) → m < N → DynamicCircuit Var n
  | 0, _ => .circuit .identity
  | m + 1, hm =>
      .seq (regPlaneProgram v b false (rT.compose (pairAdj N m hm)) (angleWord b m rA (by omega))
          (rcDisj rT rA hTA m hm) rS rCat)
        (regCascadeProgram v b rT rA hTA rS rCat m (by omega))

/-- Inverse planes `0` up to `m − 1`, angles from the words of `rA`. -/
noncomputable def regCascadeInvProgram {Var : Type} (v : Var) (b : ℕ) {N : ℕ}
    (rT : QRegister N n) (rA : QRegister (N * b) n) (hTA : rT.DisjointWires rA)
    (rS : QRegister (2 * b) n) (rCat : QRegister b n) : (m : ℕ) → m < N → DynamicCircuit Var n
  | 0, _ => .circuit .identity
  | m + 1, hm =>
      .seq (regCascadeInvProgram v b rT rA hTA rS rCat m (by omega))
        (regPlaneProgram v b true (rT.compose (pairAdj N m hm)) (angleWord b m rA (by omega))
          (rcDisj rT rA hTA m hm) rS rCat)

theorem rcAngle (N b m : ℕ) (hm : m < N) (hq : m * b + b ≤ N * b) (x : Fin (2 ^ (N * b))) :
    regPlaneAngle b false ((QRegister.block (m * b) b hq).extractIndex x) =
      givensLeafAngle N b (angleVec N b x) m := by
  rw [givensLeafAngle, dif_pos hm, regPlaneAngle, if_neg Bool.false_ne_true, rcExt_block]
  simp only [angleVec, Int.cast_natCast]
  ring

theorem rcAngleInv (b : ℕ) (a : Fin (2 ^ b)) :
    regPlaneAngle b true a = -regPlaneAngle b false a := by
  rw [regPlaneAngle, regPlaneAngle, if_pos rfl, if_neg Bool.false_ne_true]
  ring

theorem rcPlaneLift {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (b : ℕ)
    (hb : 2 ≤ b) (inv : Bool) {N : ℕ} (rT : QRegister N n) (rA : QRegister (N * b) n)
    (hTA : rT.DisjointWires rA) (rS : QRegister (2 * b) n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (hdisj : (rT.concat rA hTA).DisjointWires (rS.concat rCat hsc))
    (m : ℕ) (hm : m + 1 < N) (hq : m * b + b ≤ N * b) :
    CatKet (rT.concat rA hTA) rS rCat hsc
      (regPlaneProgram v b inv (rT.compose (pairAdj N m hm)) (angleWord b m rA (by omega))
        (rcDisj rT rA hTA m hm) rS rCat).compile
      (blockDiag fun x : Fin (2 ^ (N * b)) ↦ (pairAdj N m hm).embedUnitary
        (givensPlaneUnitary (regPlaneAngle b inv ((QRegister.block (m * b) b hq).extractIndex x)))) := by
  have hd' := hdisj.compose_left (lrReg (pairAdj N m hm) (QRegister.block (m * b) b hq))
  rw [concat_compose_lrReg] at hd'
  have hp0 : CatKet ((rT.concat rA hTA).compose
      (lrReg (pairAdj N m hm) (QRegister.block (m * b) b hq))) rS rCat hsc
      (regPlaneProgram v b inv (rT.compose (pairAdj N m hm)) (angleWord b m rA (by omega))
        (rcDisj rT rA hTA m hm) rS rCat).compile
      (blockDiag fun a ↦ givensPlaneUnitary (regPlaneAngle b inv a)) := by
    rw [concat_compose_lrReg]
    exact regPlane_catKet v b hb inv (rT.compose (pairAdj N m hm)) (angleWord b m rA (by omega))
      (rcDisj rT rA hTA m hm) rS rCat hsc hd'
  have hp := CatKet.compose (outer := rT.concat rA hTA)
    (lrReg (pairAdj N m hm) (QRegister.block (m * b) b hq)) hp0
  rw [embedUnitary_lrReg_blockDiag] at hp
  exact hp

theorem regCascade_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (b : ℕ)
    (hb : 2 ≤ b) {N : ℕ} (rT : QRegister N n) (rA : QRegister (N * b) n)
    (hTA : rT.DisjointWires rA) (rS : QRegister (2 * b) n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (hdisj : (rT.concat rA hTA).DisjointWires (rS.concat rCat hsc))
    (m : ℕ) (hm : m < N) :
    CatKet (rT.concat rA hTA) rS rCat hsc
      (regCascadeProgram v b rT rA hTA rS rCat m hm).compile
      (blockDiag fun x ↦ givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) m hm) := by
  induction m with
  | zero =>
      have h := CatKet.circuit (Var := Var) (rT.concat rA hTA) rS rCat hsc Circuit.identity
      have e : (blockDiag fun x : Fin (2 ^ (N * b)) ↦
          givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) 0 hm) =
          Circuit.identity.eval := by
        simp only [givensCascadePrefix, Circuit.eval_identity]
        exact blockDiag_one
      simp only [regCascadeProgram, DynamicCircuit.compile_circuit]
      rw [e]
      exact h
  | succ m ih =>
      have hq : m * b + b ≤ N * b := angleWord_le N b m (by omega)
      have hp := rcPlaneLift v b hb false rT rA hTA rS rCat hsc hdisj m hm hq
      have h := CatKet.seq hdisj hp (ih (by omega))
      simp only [blockDiag_mul] at h
      have e : (fun x : Fin (2 ^ (N * b)) ↦
          givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) (m + 1) hm) =
          fun x ↦ givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) m (by omega) *
            (pairAdj N m hm).embedUnitary (givensPlaneUnitary
              (regPlaneAngle b false ((QRegister.block (m * b) b hq).extractIndex x))) := by
        funext x
        rw [rcAngle N b m (by omega) hq x]
        simp only [givensCascadePrefix, givensAdjUnitary]
      simp only [regCascadeProgram, DynamicCircuit.compile_seq]
      rw [e]
      exact h

theorem regCascadeInv_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (b : ℕ)
    (hb : 2 ≤ b) {N : ℕ} (rT : QRegister N n) (rA : QRegister (N * b) n)
    (hTA : rT.DisjointWires rA) (rS : QRegister (2 * b) n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (hdisj : (rT.concat rA hTA).DisjointWires (rS.concat rCat hsc))
    (m : ℕ) (hm : m < N) :
    CatKet (rT.concat rA hTA) rS rCat hsc
      (regCascadeInvProgram v b rT rA hTA rS rCat m hm).compile
      (blockDiag fun x ↦ (givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) m hm)⁻¹) := by
  induction m with
  | zero =>
      have h := CatKet.circuit (Var := Var) (rT.concat rA hTA) rS rCat hsc Circuit.identity
      have e : (blockDiag fun x : Fin (2 ^ (N * b)) ↦
          (givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) 0 hm)⁻¹) =
          Circuit.identity.eval := by
        simp only [givensCascadePrefix, inv_one, Circuit.eval_identity]
        exact blockDiag_one
      simp only [regCascadeInvProgram, DynamicCircuit.compile_circuit]
      rw [e]
      exact h
  | succ m ih =>
      have hq : m * b + b ≤ N * b := angleWord_le N b m (by omega)
      have hp := rcPlaneLift v b hb true rT rA hTA rS rCat hsc hdisj m hm hq
      have h := CatKet.seq hdisj (ih (by omega)) hp
      simp only [blockDiag_mul] at h
      have e : (fun x : Fin (2 ^ (N * b)) ↦
          (givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) (m + 1) hm)⁻¹) =
          fun x ↦ (pairAdj N m hm).embedUnitary (givensPlaneUnitary
              (regPlaneAngle b true ((QRegister.block (m * b) b hq).extractIndex x))) *
            (givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) m (by omega))⁻¹ := by
        funext x
        rw [rcAngleInv, givensPlaneUnitary_neg, QRegister.embedUnitary_inv,
          rcAngle N b m (by omega) hq x]
        simp only [givensCascadePrefix, givensAdjUnitary, _root_.mul_inv_rev]
      simp only [regCascadeInvProgram, DynamicCircuit.compile_seq]
      rw [e]
      exact h

theorem regCascade_count {Var : Type} (v : Var) (b : ℕ) {N : ℕ} (rT : QRegister N n)
    (rA : QRegister (N * b) n) (hTA : rT.DisjointWires rA) (rS : QRegister (2 * b) n)
    (rCat : QRegister b n) (m : ℕ) (hm : m < N) :
    (regCascadeProgram v b rT rA hTA rS rCat m hm).count PrimitiveGate.TOFF = 0 ∧
      (regCascadeProgram v b rT rA hTA rS rCat m hm).count PrimitiveGate.T ≤ 16 * m * b := by
  induction m with
  | zero => simp [regCascadeProgram]
  | succ m ih =>
      obtain ⟨a, c⟩ := regPlane_count v b false (rT.compose (pairAdj N m hm))
        (angleWord b m rA (by omega)) (rcDisj rT rA hTA m hm) rS rCat
      obtain ⟨a', c'⟩ := ih (by omega)
      simp only [regCascadeProgram, DynamicCircuit.count]
      have e : 16 * (m + 1) * b = 16 * m * b + 16 * b := by ring
      rw [e]
      exact ⟨by omega, by omega⟩

theorem regCascadeInv_count {Var : Type} (v : Var) (b : ℕ) {N : ℕ} (rT : QRegister N n)
    (rA : QRegister (N * b) n) (hTA : rT.DisjointWires rA) (rS : QRegister (2 * b) n)
    (rCat : QRegister b n) (m : ℕ) (hm : m < N) :
    (regCascadeInvProgram v b rT rA hTA rS rCat m hm).count PrimitiveGate.TOFF = 0 ∧
      (regCascadeInvProgram v b rT rA hTA rS rCat m hm).count PrimitiveGate.T ≤ 16 * m * b := by
  induction m with
  | zero => simp [regCascadeInvProgram]
  | succ m ih =>
      obtain ⟨a, c⟩ := regPlane_count v b true (rT.compose (pairAdj N m hm))
        (angleWord b m rA (by omega)) (rcDisj rT rA hTA m hm) rS rCat
      obtain ⟨a', c'⟩ := ih (by omega)
      simp only [regCascadeInvProgram, DynamicCircuit.count]
      have e : 16 * (m + 1) * b = 16 * m * b + 16 * b := by ring
      rw [e]
      exact ⟨by omega, by omega⟩

/-! ## Angles modulo `2^b` -/

/-- The cascade depends on the integer angles only modulo `2^b` (E1.3c stores them mod `2^b`). -/
theorem givensCascadePrefix_leaf_congr (N b : ℕ) (k k' : Fin N → ℤ)
    (h : ∀ q, k q % 2 ^ b = k' q % 2 ^ b) (m : ℕ) (hm : m < N) :
    givensCascadePrefix N (givensLeafAngle N b k) m hm =
      givensCascadePrefix N (givensLeafAngle N b k') m hm := by
  induction m with
  | zero => simp only [givensCascadePrefix]
  | succ m ih =>
      have hm' : m < N := by omega
      have hang : ∀ kk : Fin N → ℤ, givensLeafAngle N b kk m =
          2 * (2 * Real.pi * ((kk ⟨m, hm'⟩ : ℤ) : ℝ) / 2 ^ b) := by
        intro kk
        rw [givensLeafAngle, dif_pos hm']
      obtain ⟨t, ht⟩ := Int.ModEq.dvd (h ⟨m, hm'⟩)
      have hk' : ((k' ⟨m, hm'⟩ : ℤ) : ℝ) = ((k ⟨m, hm'⟩ : ℤ) : ℝ) + 2 ^ b * (t : ℝ) := by
        have e : k' ⟨m, hm'⟩ = k ⟨m, hm'⟩ + 2 ^ b * t := by linarith
        rw [e]
        push_cast
        ring
      have hc : givensLeafAngle N b k' m =
          givensLeafAngle N b k m + ((2 * t : ℤ) : ℝ) * (2 * Real.pi) := by
        rw [hang, hang, hk']
        push_cast
        field_simp
      have hU : givensPlaneUnitary (givensLeafAngle N b k' m) =
          givensPlaneUnitary (givensLeafAngle N b k m) := by
        rw [hc]
        apply Subtype.ext
        simp only [givensPlaneUnitary_val, givensPlaneMatrix, Real.cos_add_int_mul_two_pi,
          Real.sin_add_int_mul_two_pi]
      simp only [givensCascadePrefix, givensAdjUnitary]
      rw [ih (by omega), hU]

end QC14.RegCascade


/-! Inlined from lane module `THC/RegKickS.lean`. -/

namespace QC14.RegKickS

open QuantumComputation QuantumComputation.Specs Matrix
open QuantumComputation.Specs.ArcsinImpl
open QC14.Catalytic QC14.GivensPlane QC14.GivensCascade QC14.RegKick QC14.RegCascade
open QuantumComputationSpecs.Algorithms.P450GroundEnergy.Solution.GivensOps
open Operator QProg Function
open scoped Matrix ComplexOrder MatrixOrder

variable {n : ℕ}

/-! ## The signed kick -/

/-- Signed kick constant on target ++ word: with `c = t` (`neg`) or `c = 1 − t` (`¬neg`),
`a` at `c = 0` and `2^b − a mod 2^b` at `c = 1`. -/
def signedKickF (b : ℕ) (neg : Bool) (j : Fin (2 ^ (b + 1))) : ℕ :=
  let a := kickWord b j
  let t := (basisBits (b + 1) j 0).val
  let c := if neg then t else 1 - t
  if c = 0 then a else (2 ^ b - a) % 2 ^ b

/-- Signed kick steps: optional `X` on the target, fan of the target onto the word, ripple add
of the word into the catalyst with the target as carry-in (carries on scratch `0 .. b − 2`),
fan, optional `X`. The scratch interface (`2 b` wires) matches `regKickSteps`. -/
def regKickSSteps (b : ℕ) (neg : Bool) (rT : QRegister (b + 1) n)
    (rS : QRegister (2 * b) n) (rCat : QRegister b n) : List (Step n) :=
  match b, rT, rS, rCat with
  | 0, _, _, _ => []
  | k + 1, rT, rS, rCat =>
    let target := rT 0
    let word := regTail rT
    let toggle : List (Step n) := if neg then [] else [Step.x target]
    let fan := xorSteps (some target) (k + 1) word (fun _ ↦ 1)
    let carries := rS.slice 0 k (by omega)
    toggle ++ fan ++ rippleSteps k word rCat target carries ++ fan ++ toggle

noncomputable def regKickSProgram {Var : Type} (v : Var) (b : ℕ) (neg : Bool)
    (rT : QRegister (b + 1) n) (rS : QRegister (2 * b) n) (rCat : QRegister b n) :
    DynamicCircuit Var n :=
  compileList v (regKickSSteps b neg rT rS rCat)

/-! ### Helpers for the run lemma -/

theorem rksZ2_add_one_add_one (x : ZMod 2) : x + 1 + 1 = x := by revert x; decide

theorem rksZ2_add_self (x y : ZMod 2) : x + y + y = x := by revert x y; decide

/-- Value of the complemented word. -/
theorem rks_compl_val (m : ℕ) (w : Fin m → ZMod 2) :
    ∑ i : Fin m, (w i + 1).val * 2 ^ (i : ℕ) =
      2 ^ m - 1 - ∑ i : Fin m, (w i).val * 2 ^ (i : ℕ) := by
  have h := rk_mask_val true m 1 w
  have hr : ∀ x : ZMod 2, rkBit true 1 x = x + 1 := fun x ↦ by simp [rkBit]
  have h1 : (1 : ZMod 2).val = 1 := rfl
  simp only [hr] at h
  rw [h, h1, one_mul, if_pos trivial]

/-- Value of the word after the fan of `c`. -/
theorem rks_word_val (m : ℕ) (w : Fin m → ZMod 2) (c : ZMod 2) :
    ∑ i : Fin m, (w i + c).val * 2 ^ (i : ℕ) =
      if c.val = 0 then ∑ i : Fin m, (w i).val * 2 ^ (i : ℕ)
      else 2 ^ m - 1 - ∑ i : Fin m, (w i).val * 2 ^ (i : ℕ) := by
  rcases rkZ2_cases c with rfl | rfl
  · simp
  · rw [rks_compl_val, if_neg (by decide)]

theorem rks_num (P a cat cv : ℕ) (ha : a < P) (hc : cv ≤ 1) :
    ((if cv = 0 then a else P - 1 - a) + cat + cv) % P =
      (cat + (if cv = 0 then a else (P - a) % P)) % P := by
  rcases (by omega : cv = 0 ∨ cv = 1) with rfl | rfl
  · simp only [↓reduceIte]
    congr 1
    omega
  · simp only [Nat.one_ne_zero, ↓reduceIte]
    rw [Nat.add_mod_mod]
    congr 1
    omega

theorem rksDisj_regTail_left {k m : ℕ} {r : QRegister (k + 1) n} {s : QRegister m n}
    (h : r.DisjointWires s) : (regTail r).DisjointWires s := by
  rw [QRegister.disjoint_iff] at h ⊢
  intro i j
  rw [regTail_apply]
  exact h _ _

theorem rks_kickWord (K : ℕ) (rT : QRegister (K + 1 + 1) n) (β : BitAssignment n) :
    kickWord (K + 1) (localIdx rT β) = (localIdx (regTail rT) β : ℕ) := by
  have hb : ∀ i, basisBits (K + 1 + 1) (localIdx rT β) i = β (rT i) := fun i ↦
    congrFun ((basisBits (K + 1 + 1)).apply_symm_apply _) i
  unfold kickWord
  simp only [hb]
  rw [localIdx_val]
  simp only [regTail_apply]

/-- The optional `X` on the target, run once and run again after a catalyst write. -/
theorem rks_toggle_spec (neg : Bool) {k : ℕ} (w : Wire n) (rCat : QRegister k n)
    (hw : w ∉ Set.range rCat.wires) (β : BitAssignment n) :
    ∃ β0 : BitAssignment n, runList (if neg then [] else [Step.x w]) β = some β0 ∧
      (∀ w', w' ≠ w → β0 w' = β w') ∧
      (β0 w).val = (if neg then (β w).val else 1 - (β w).val) ∧
      ∀ X, runList (if neg then [] else [Step.x w]) (writeReg β0 rCat X) =
        some (writeReg β rCat X) := by
  cases neg
  · refine ⟨update β w (β w + 1), rfl, fun w' h ↦ update_of_ne h _ _, ?_, fun X ↦ ?_⟩
    · rw [update_self]
      have := rkZ2_val_add_one (β w)
      simp only [Bool.false_eq_true, ↓reduceIte]
      omega
    · show some (update (writeReg (update β w (β w + 1)) rCat X) w
          (writeReg (update β w (β w + 1)) rCat X w + 1)) = _
      rw [writeReg_apply_of_not_mem _ _ _ _ hw, update_self,
        ← writeReg_update_of_not_mem _ _ _ hw, update_idem, rksZ2_add_one_add_one,
        update_eq_self]
  · exact ⟨β, rfl, fun _ _ ↦ rfl, by simp, fun X ↦ rfl⟩

/-! ### The run lemma -/

theorem rksRun (K : ℕ) (neg : Bool) (rT : QRegister (K + 1 + 1) n)
    (rS : QRegister (2 * (K + 1)) n) (rCat : QRegister (K + 1) n)
    (hTC : rT.DisjointWires rCat) (hTS : rT.DisjointWires rS) (hsc : rS.DisjointWires rCat)
    (β : BitAssignment n) (hβ : ∀ i, β (rS i) = 0) :
    runList (regKickSSteps (K + 1) neg rT rS rCat) β = some (writeReg β rCat (basisBits (K + 1)
      ⟨(localIdx rCat β + signedKickF (K + 1) neg (localIdx rT β)) % 2 ^ (K + 1),
        Nat.mod_lt _ (by positivity)⟩)) := by
  -- disjointness
  have hWC : (regTail rT).DisjointWires rCat := rksDisj_regTail_left hTC
  have hWS : (regTail rT).DisjointWires (rS.slice 0 K (by omega)) :=
    rksDisj_regTail_left (QRegister.disjoint_comm.mp
      (rkDisj_slice_left (QRegister.disjoint_comm.mp hTS) 0 K (by omega)))
  have hCS : rCat.DisjointWires (rS.slice 0 K (by omega)) :=
    QRegister.disjoint_comm.mp (rkDisj_slice_left hsc 0 K (by omega))
  have htW : rT 0 ∉ Set.range (regTail rT).wires := zero_not_mem_regTail rT
  have htC : rT 0 ∉ Set.range rCat.wires := not_mem_of_disjoint hTC 0
  have htS : rT 0 ∉ Set.range (rS.slice 0 K (by omega)).wires :=
    not_mem_slice (not_mem_of_disjoint hTS 0) 0 K (by omega)
  have hctl : ∀ i, CtrlNe (some (rT 0)) (regTail rT i) :=
    fun i ↦ CtrlNe.some (regTail_ne_zero rT i).symm
  -- toggle
  obtain ⟨β0, h0, hβ0, ht0, hfin⟩ := rks_toggle_spec neg (rT 0) rCat htC β
  -- fan
  have h1 := runList_xorSteps (some (rT 0)) (K + 1) (regTail rT) (fun _ ↦ 1) hctl β0
  simp only [ctrlVal, mul_one] at h1
  obtain ⟨β1, hβ1⟩ : ∃ β1, β1 = writeReg β0 (regTail rT)
      (fun i ↦ β0 (regTail rT i) + β0 (rT 0)) := ⟨_, rfl⟩
  rw [← hβ1] at h1
  have hclS : ∀ i, β1 (rS.slice 0 K (by omega) i) = 0 := fun i ↦ by
    rw [hβ1, writeReg_apply_of_not_mem _ _ _ _
      (not_mem_of_disjoint (QRegister.disjoint_comm.mp hWS) i),
      hβ0 _ (fun h ↦ htS ⟨i, h⟩), QRegister.slice_apply]
    exact hβ _
  -- ripple add
  have h2 := runList_rippleSteps K (regTail rT) rCat (rT 0) (rS.slice 0 K (by omega)) hWC hWS hCS
    htW htC htS β1 hclS
  obtain ⟨X, hX⟩ : ∃ X : BitAssignment (K + 1), X = basisBits (K + 1)
      ⟨((localIdx (regTail rT) β1 : ℕ) + (localIdx rCat β1 : ℕ) + (β1 (rT 0)).val) % 2 ^ (K + 1),
        Nat.mod_lt _ (by positivity)⟩ := ⟨_, rfl⟩
  rw [← hX] at h2
  obtain ⟨β2, hβ2⟩ : ∃ β2, β2 = writeReg β1 rCat X := ⟨_, rfl⟩
  rw [← hβ2] at h2
  -- fan again
  have h3 := runList_xorSteps (some (rT 0)) (K + 1) (regTail rT) (fun _ ↦ 1) hctl β2
  simp only [ctrlVal, mul_one] at h3
  have ht1 : β1 (rT 0) = β0 (rT 0) := by rw [hβ1, writeReg_apply_of_not_mem _ _ _ _ htW]
  have ht2 : β2 (rT 0) = β0 (rT 0) := by rw [hβ2, writeReg_apply_of_not_mem _ _ _ _ htC, ht1]
  have hw : ∀ i, β2 (regTail rT i) + β2 (rT 0) = β0 (regTail rT i) := fun i ↦ by
    rw [ht2, hβ2, writeReg_apply_of_not_mem _ _ _ _ (not_mem_of_disjoint hWC i), hβ1,
      writeReg_apply_reg, rksZ2_add_self]
  have e3 : writeReg β2 (regTail rT) (fun i ↦ β2 (regTail rT i) + β2 (rT 0)) =
      writeReg β0 rCat X := by
    simp only [hw]
    rw [hβ2, hβ1, writeReg_comm _ (regTail rT) rCat hWC, writeReg_writeReg,
      show (fun i ↦ β0 (regTail rT i)) = fun i ↦ writeReg β0 rCat X (regTail rT i) from
        funext fun i ↦ (writeReg_apply_of_not_mem _ _ _ _ (not_mem_of_disjoint hWC i)).symm,
      writeReg_self]
  -- assemble
  show runList ((if neg then [] else [Step.x (rT 0)]) ++
      xorSteps (some (rT 0)) (K + 1) (regTail rT) (fun _ ↦ 1) ++
      rippleSteps K (regTail rT) rCat (rT 0) (rS.slice 0 K (by omega)) ++
      xorSteps (some (rT 0)) (K + 1) (regTail rT) (fun _ ↦ 1) ++
      (if neg then [] else [Step.x (rT 0)])) β = _
  rw [runList_append, runList_append, runList_append, runList_append, h0, Option.bind_some, h1,
    Option.bind_some, h2, Option.bind_some, h3, Option.bind_some, e3, hfin]
  -- numerics
  have hlc : (localIdx rCat β1 : ℕ) = localIdx rCat β := by
    rw [hβ1, localIdx_writeReg_of_disjoint _ _ _ hWC, localIdx_val, localIdx_val]
    exact Finset.sum_congr rfl fun i _ ↦ by rw [hβ0 _ (fun h ↦ htC ⟨i, h⟩)]
  have hlw : (localIdx (regTail rT) β1 : ℕ) = if (β0 (rT 0)).val = 0 then
      (localIdx (regTail rT) β : ℕ) else 2 ^ (K + 1) - 1 - localIdx (regTail rT) β := by
    have hsw : ∑ i : Fin (K + 1), (β0 (regTail rT i)).val * 2 ^ (i : ℕ) =
        ∑ i : Fin (K + 1), (β (regTail rT i)).val * 2 ^ (i : ℕ) :=
      Finset.sum_congr rfl fun i _ ↦ by rw [hβ0 _ (regTail_ne_zero rT i)]
    rw [localIdx_val, hβ1]
    simp only [writeReg_apply_reg]
    rw [rks_word_val, hsw, ← localIdx_val]
  have hb0 : basisBits (K + 1 + 1) (localIdx rT β) 0 = β (rT 0) :=
    congrFun ((basisBits (K + 1 + 1)).apply_symm_apply _) 0
  have hsk : signedKickF (K + 1) neg (localIdx rT β) =
      if (if neg then (β (rT 0)).val else 1 - (β (rT 0)).val) = 0 then
        (localIdx (regTail rT) β : ℕ)
      else (2 ^ (K + 1) - localIdx (regTail rT) β) % 2 ^ (K + 1) := by
    simp only [signedKickF, rks_kickWord, hb0]
  have hval : ((localIdx (regTail rT) β1 : ℕ) + (localIdx rCat β1 : ℕ) + (β1 (rT 0)).val) %
      2 ^ (K + 1) = (localIdx rCat β + signedKickF (K + 1) neg (localIdx rT β)) % 2 ^ (K + 1) := by
    rw [hlw, hlc, ht1, hsk, ← ht0]
    exact rks_num _ _ _ _ (localIdx (regTail rT) β).isLt
      (by have := ZMod.val_lt (β0 (rT 0)); omega)
  rw [hX]
  exact congrArg (fun x ↦ some (writeReg β rCat (basisBits (K + 1) x))) (Fin.ext hval)

theorem regKickS_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (b : ℕ)
    (hb : 2 ≤ b) (neg : Bool) (rT : QRegister (b + 1) n) (rS : QRegister (2 * b) n)
    (rCat : QRegister b n) (hsc : rS.DisjointWires rCat)
    (hdisj : rT.DisjointWires (rS.concat rCat hsc)) :
    CatKet rT rS rCat hsc (regKickSProgram v b neg rT rS rCat).compile
      (phaseUnitary (b + 1) b (signedKickF b neg)) := by
  obtain ⟨K, rfl⟩ : ∃ K, b = K + 1 := ⟨b - 1, by omega⟩
  obtain ⟨hTC, hTS⟩ := disjoint_cat rT rS rCat hsc hdisj
  obtain ⟨R, hR, hk⟩ := catKet_kick_compileList v (regKickSSteps (K + 1) neg rT rS rCat) rT rS
    rCat hsc hdisj (signedKickF (K + 1) neg) (fun β hβ ↦
      rksRun K neg rT rS rCat hTC hTS hsc β (eq_zero_of_localIdx_eq_zero rS β hβ))
  exact ⟨R, hR, hk⟩

theorem regKickS_count {Var : Type} (v : Var) (b : ℕ) (neg : Bool)
    (rT : QRegister (b + 1) n) (rS : QRegister (2 * b) n) (rCat : QRegister b n) :
    (regKickSProgram v b neg rT rS rCat).count PrimitiveGate.TOFF = 0 ∧
      (regKickSProgram v b neg rT rS rCat).count PrimitiveGate.T ≤ 4 * (b - 1) := by
  refine ⟨count_TOFF_compileList v _, ?_⟩
  refine (count_T_compileList v _).trans ?_
  match b, rT, rS, rCat with
  | 0, rT, rS, rCat => simp [regKickSSteps]
  | K + 1, rT, rS, rCat =>
    have ht : (((if neg then [] else [Step.x (rT 0)]) : List (Step n)).map Step.andCount).sum =
        0 := by
      cases neg <;> rfl
    have h : ((regKickSSteps (K + 1) neg rT rS rCat).map Step.andCount).sum = K := by
      show (((if neg then [] else [Step.x (rT 0)]) ++
          xorSteps (some (rT 0)) (K + 1) (regTail rT) (fun _ ↦ 1) ++
          rippleSteps K (regTail rT) rCat (rT 0) (rS.slice 0 K (by omega)) ++
          xorSteps (some (rT 0)) (K + 1) (regTail rT) (fun _ ↦ 1) ++
          (if neg then [] else [Step.x (rT 0)])).map Step.andCount).sum = K
      simp only [List.map_append, List.sum_append, ht, andCount_xorSteps, andCount_rippleSteps,
        Nat.zero_add, Nat.add_zero]
    rw [h]
    omega

/-! ## The signed plane -/

/-- The signed kick constant as a function of the target bit `t` and the word value `w`. -/
def rcsG (b : ℕ) (neg : Bool) (t w : ℕ) : ℕ :=
  if (if neg then t else 1 - t) = 0 then w else (2 ^ b - w) % 2 ^ b

theorem rcsGmod (b : ℕ) (neg : Bool) (t w : ℕ) (hw : w ≤ 2 ^ b) :
    ((rcsG b neg t w : ℕ) : ℤ) ≡
      (if (if neg then t else 1 - t) = 0 then (w : ℤ) else -(w : ℤ)) [ZMOD 2 ^ b] := by
  unfold rcsG
  by_cases hc : (if neg then t else 1 - t) = 0
  · rw [if_pos hc, if_pos hc]
  · rw [if_neg hc, if_neg hc]
    have e : (((2 ^ b - w) % 2 ^ b : ℕ) : ℤ) = ((2 : ℤ) ^ b - w) % 2 ^ b := by
      rw [Int.natCast_mod, Nat.cast_sub hw]
      push_cast
      try rfl
    show (((2 ^ b - w) % 2 ^ b : ℕ) : ℤ) % 2 ^ b = (-(w : ℤ)) % 2 ^ b
    rw [e, Int.emod_emod, show (2 : ℤ) ^ b - w = -(w : ℤ) + 2 ^ b * 1 by ring,
      Int.add_mul_emod_self_left]

theorem rcsPairInt (b : ℕ) (inv : Bool) (w t1 t0 : ℕ) (hw : w ≤ 2 ^ b) (h1 : t1 < 2 ^ 1)
    (h0 : t0 < 2 ^ 1) :
    ((rcsG b inv t1 w + rcsG b (!inv) t0 w : ℕ) : ℤ) ≡
      ((t1 * rcG b inv w + t0 * rcG b (!inv) w : ℕ) : ℤ) [ZMOD 2 ^ b] := by
  have h1' : t1 < 2 := by simpa using h1
  have h0' : t0 < 2 := by simpa using h0
  have hL := (rcsGmod b inv t1 w hw).add (rcsGmod b (!inv) t0 w hw)
  have g1 : ((rcG b inv w : ℕ) : ℤ) ≡ (if inv then -(2 * (w : ℤ)) else 2 * w) [ZMOD 2 ^ b] :=
    rcGmod b w inv
  have g0 : ((rcG b (!inv) w : ℕ) : ℤ) ≡ (if !inv then -(2 * (w : ℤ)) else 2 * w)
      [ZMOD 2 ^ b] := rcGmod b w (!inv)
  have hR := (g1.mul_left (t1 : ℤ)).add (g0.mul_left (t0 : ℤ))
  push_cast
  refine hL.trans (Int.ModEq.trans (congrArg (· % (2 ^ b : ℤ)) ?_) hR.symm)
  interval_cases t1 <;> interval_cases t0 <;> cases inv <;> simp <;> ring

/-- The two signed kicks of a plane (flag `!inv` on wire 0, `inv` on wire 1, word value `a`)
multiply to the same diagonal as the two masked kicks of `regPlaneProgram`. -/
theorem rcsPair (b : ℕ) (inv : Bool) (a : Fin (2 ^ b)) :
    (QRegister.singleton (n := 2) (1 : Fin 2)).embedUnitary
        (phaseUnitary 1 b fun t ↦ rcsG b inv t.val a.val) *
      (QRegister.singleton (n := 2) (0 : Fin 2)).embedUnitary
        (phaseUnitary 1 b fun t ↦ rcsG b (!inv) t.val a.val) =
    (QRegister.singleton (n := 2) (1 : Fin 2)).embedUnitary
        (phaseUnitary 1 b fun t ↦ t.val * rcG b inv a.val) *
      (QRegister.singleton (n := 2) (0 : Fin 2)).embedUnitary
        (phaseUnitary 1 b fun t ↦ t.val * rcG b (!inv) a.val) := by
  have hexp : ∀ u1 u0 v1 v0 : ℕ, ((u1 + u0 : ℕ) : ℤ) ≡ ((v1 + v0 : ℕ) : ℤ) [ZMOD 2 ^ b] →
      Complex.exp (2 * Real.pi * Complex.I * (u1 : ℂ) / 2 ^ b) *
        Complex.exp (2 * Real.pi * Complex.I * (u0 : ℂ) / 2 ^ b) =
      Complex.exp (2 * Real.pi * Complex.I * (v1 : ℂ) / 2 ^ b) *
        Complex.exp (2 * Real.pi * Complex.I * (v0 : ℂ) / 2 ^ b) := by
    intro u1 u0 v1 v0 h
    rw [← Complex.exp_add, ← Complex.exp_add]
    have e := rcExpCongr b (u1 + u0) (v1 + v0) h
    push_cast at e
    convert e using 2 <;> ring
  apply Subtype.ext
  simp only [Submonoid.coe_mul, QRegister.embedUnitary_val, phaseUnitary_val,
    QRegister.embedMatrix_diagonal, diagonal_mul_diagonal]
  congr 1
  funext g
  exact hexp _ _ _ _ (rcsPairInt b inv a.val _ _ a.isLt.le (Fin.isLt _) (Fin.isLt _))

/-- One Givens plane on `r2` whose angle is read from the word `rW`, with signed kicks. -/
noncomputable def regPlaneSProgram {Var : Type} (v : Var) (b : ℕ) (inv : Bool)
    (r2 : QRegister 2 n) (rW : QRegister b n) (h2W : r2.DisjointWires rW)
    (rS : QRegister (2 * b) n) (rCat : QRegister b n) : DynamicCircuit Var n :=
  .seq (.circuit (planeClifford.onRegister r2))
    (.seq (regKickSProgram v b (!inv) ((r2.concat rW h2W).compose (kickSel b 0)) rS rCat)
      (.seq (regKickSProgram v b inv ((r2.concat rW h2W).compose (kickSel b 1)) rS rCat)
        (.circuit (planeClifford.inverse.onRegister r2))))

theorem rcsKickF (b : ℕ) (neg : Bool) (i : Fin 2) (x : Fin (2 ^ (2 + b))) :
    signedKickF b neg ((kickSel b i).extractIndex x) =
      rcsG b neg ((QRegister.singleton (n := 2) i).extractIndex (bdLo x)).val (bdHi x).val := by
  have h0 : (basisBits (b + 1) ((kickSel b i).extractIndex x) 0).val =
      ((QRegister.singleton (n := 2) i).extractIndex (bdLo x)).val := by
    rw [rcFin1 ((QRegister.singleton (n := 2) i).extractIndex (bdLo x)),
      QRegister.basisBits_extractIndex, QRegister.basisBits_extractIndex, rcKickSel_zero,
      QRegister.singleton_apply, rcBits_lo]
  simp only [signedKickF, rcsG, h0, rcWord]

theorem rcsKick (b : ℕ) (neg : Bool) (i : Fin 2) :
    (kickSel b i).embedUnitary (phaseUnitary (b + 1) b (signedKickF b neg)) =
      blockDiag (k := 2) (j := b) (fun a ↦ (QRegister.singleton (n := 2) i).embedUnitary
        (phaseUnitary 1 b (fun t ↦ rcsG b neg t.val a.val))) := by
  have hd : ∀ a : Fin (2 ^ b), ((QRegister.singleton (n := 2) i).embedUnitary
      (phaseUnitary 1 b (fun t ↦ rcsG b neg t.val a.val))).1 =
      diagonal (fun g ↦ Complex.exp (2 * Real.pi * Complex.I *
        ((rcsG b neg ((QRegister.singleton (n := 2) i).extractIndex g).val a.val : ℕ) : ℂ) /
          2 ^ b)) := by
    intro a
    rw [QRegister.embedUnitary_val, phaseUnitary_val, QRegister.embedMatrix_diagonal]
  apply Subtype.ext
  rw [QRegister.embedUnitary_val, phaseUnitary_val, QRegister.embedMatrix_diagonal, blockDiag_val,
    rcBD_diag _ _ hd]
  congr 1
  funext x
  rw [rcsKickF]

theorem rcsBlock (b : ℕ) (inv : Bool) (a : Fin (2 ^ b)) :
    ((planeClifford.inverse.eval *
        (QRegister.singleton (n := 2) (1 : Fin 2)).embedUnitary
          (phaseUnitary 1 b fun t ↦ rcsG b inv t.val a.val)) *
        (QRegister.singleton (n := 2) (0 : Fin 2)).embedUnitary
          (phaseUnitary 1 b fun t ↦ rcsG b (!inv) t.val a.val)) *
      planeClifford.eval = givensPlaneUnitary (regPlaneAngle b inv a) := by
  rw [mul_assoc planeClifford.inverse.eval, rcsPair, ← mul_assoc, rcBlock]

theorem regPlaneS_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (b : ℕ)
    (hb : 2 ≤ b) (inv : Bool) (r2 : QRegister 2 n) (rW : QRegister b n)
    (h2W : r2.DisjointWires rW) (rS : QRegister (2 * b) n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (hdisj : (r2.concat rW h2W).DisjointWires (rS.concat rCat hsc)) :
    CatKet (r2.concat rW h2W) rS rCat hsc (regPlaneSProgram v b inv r2 rW h2W rS rCat).compile
      (blockDiag fun a ↦ givensPlaneUnitary (regPlaneAngle b inv a)) := by
  have hc : ∀ c : Circuit 2, CatKet (r2.concat rW h2W) rS rCat hsc
      ((c.onRegister r2).compile (Var := Var)) (blockDiag fun _ : Fin (2 ^ b) ↦ c.eval) := by
    intro c
    have h0 : CatKet ((r2.concat rW h2W).compose (QRegister.block 0 2 (by omega))) rS rCat hsc
        ((c.onRegister r2).compile (Var := Var)) c.eval := by
      rw [rcConcat_lo]
      exact CatKet.circuit r2 rS rCat hsc c
    rw [blockDiag_const]
    exact CatKet.compose _ h0
  have hp : ∀ (i : Fin 2) (neg : Bool), CatKet (r2.concat rW h2W) rS rCat hsc
      (regKickSProgram v b neg ((r2.concat rW h2W).compose (kickSel b i)) rS rCat).compile
      (blockDiag (k := 2) (j := b) fun a ↦ (QRegister.singleton (n := 2) i).embedUnitary
        (phaseUnitary 1 b (fun t ↦ rcsG b neg t.val a.val))) := by
    intro i neg
    rw [← rcsKick b neg i]
    exact CatKet.compose (outer := r2.concat rW h2W) (kickSel b i)
      (regKickS_catKet v b hb neg ((r2.concat rW h2W).compose (kickSel b i)) rS rCat hsc
        (hdisj.compose_left _))
  have h := CatKet.seq hdisj (hc planeClifford) (CatKet.seq hdisj (hp 0 (!inv))
    (CatKet.seq hdisj (hp 1 inv) (hc planeClifford.inverse)))
  simp only [blockDiag_mul, rcsBlock] at h
  exact h

theorem regPlaneS_count {Var : Type} (v : Var) (b : ℕ) (inv : Bool) (r2 : QRegister 2 n)
    (rW : QRegister b n) (h2W : r2.DisjointWires rW) (rS : QRegister (2 * b) n)
    (rCat : QRegister b n) :
    (regPlaneSProgram v b inv r2 rW h2W rS rCat).count PrimitiveGate.TOFF = 0 ∧
      (regPlaneSProgram v b inv r2 rW h2W rS rCat).count PrimitiveGate.T ≤ 8 * (b - 1) := by
  obtain ⟨a0, a1⟩ := regKickS_count v b (!inv) ((r2.concat rW h2W).compose (kickSel b 0)) rS rCat
  obtain ⟨c0, c1⟩ := regKickS_count v b inv ((r2.concat rW h2W).compose (kickSel b 1)) rS rCat
  have iT : planeClifford.inverse.count PrimitiveGate.T = 0 := by
    rw [Circuit.count_inverse_of_ne _ (by simp) (by simp)]
    exact planeClifford_count_T
  have iTOFF : planeClifford.inverse.count PrimitiveGate.TOFF = 0 := by
    rw [Circuit.count_inverse_of_ne _ (by simp) (by simp)]
    exact planeClifford_count_TOFF
  unfold regPlaneSProgram
  simp only [DynamicCircuit.count, Circuit.count_onRegister, iT, iTOFF, planeClifford_count_T,
    planeClifford_count_TOFF, a0, c0]
  exact ⟨trivial, by omega⟩

/-! ## The signed cascade (lead-written copies of the `RegCascade` proofs) -/

/-- Planes `m − 1` down to `0`, angles from the words of `rA`, signed kicks. -/
noncomputable def regCascadeSProgram {Var : Type} (v : Var) (b : ℕ) {N : ℕ}
    (rT : QRegister N n) (rA : QRegister (N * b) n) (hTA : rT.DisjointWires rA)
    (rS : QRegister (2 * b) n) (rCat : QRegister b n) : (m : ℕ) → m < N → DynamicCircuit Var n
  | 0, _ => .circuit .identity
  | m + 1, hm =>
      .seq (regPlaneSProgram v b false (rT.compose (pairAdj N m hm)) (angleWord b m rA (by omega))
          (rcDisj rT rA hTA m hm) rS rCat)
        (regCascadeSProgram v b rT rA hTA rS rCat m (by omega))

/-- Inverse planes `0` up to `m − 1`, angles from the words of `rA`, signed kicks. -/
noncomputable def regCascadeInvSProgram {Var : Type} (v : Var) (b : ℕ) {N : ℕ}
    (rT : QRegister N n) (rA : QRegister (N * b) n) (hTA : rT.DisjointWires rA)
    (rS : QRegister (2 * b) n) (rCat : QRegister b n) : (m : ℕ) → m < N → DynamicCircuit Var n
  | 0, _ => .circuit .identity
  | m + 1, hm =>
      .seq (regCascadeInvSProgram v b rT rA hTA rS rCat m (by omega))
        (regPlaneSProgram v b true (rT.compose (pairAdj N m hm)) (angleWord b m rA (by omega))
          (rcDisj rT rA hTA m hm) rS rCat)

theorem rcsPlaneLift {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (b : ℕ)
    (hb : 2 ≤ b) (inv : Bool) {N : ℕ} (rT : QRegister N n) (rA : QRegister (N * b) n)
    (hTA : rT.DisjointWires rA) (rS : QRegister (2 * b) n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (hdisj : (rT.concat rA hTA).DisjointWires (rS.concat rCat hsc))
    (m : ℕ) (hm : m + 1 < N) (hq : m * b + b ≤ N * b) :
    CatKet (rT.concat rA hTA) rS rCat hsc
      (regPlaneSProgram v b inv (rT.compose (pairAdj N m hm)) (angleWord b m rA (by omega))
        (rcDisj rT rA hTA m hm) rS rCat).compile
      (blockDiag fun x : Fin (2 ^ (N * b)) ↦ (pairAdj N m hm).embedUnitary
        (givensPlaneUnitary (regPlaneAngle b inv ((QRegister.block (m * b) b hq).extractIndex x)))) := by
  have hd' := hdisj.compose_left (lrReg (pairAdj N m hm) (QRegister.block (m * b) b hq))
  rw [concat_compose_lrReg] at hd'
  have hp0 : CatKet ((rT.concat rA hTA).compose
      (lrReg (pairAdj N m hm) (QRegister.block (m * b) b hq))) rS rCat hsc
      (regPlaneSProgram v b inv (rT.compose (pairAdj N m hm)) (angleWord b m rA (by omega))
        (rcDisj rT rA hTA m hm) rS rCat).compile
      (blockDiag fun a ↦ givensPlaneUnitary (regPlaneAngle b inv a)) := by
    rw [concat_compose_lrReg]
    exact regPlaneS_catKet v b hb inv (rT.compose (pairAdj N m hm)) (angleWord b m rA (by omega))
      (rcDisj rT rA hTA m hm) rS rCat hsc hd'
  have hp := CatKet.compose (outer := rT.concat rA hTA)
    (lrReg (pairAdj N m hm) (QRegister.block (m * b) b hq)) hp0
  rw [embedUnitary_lrReg_blockDiag] at hp
  exact hp

theorem regCascadeS_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (b : ℕ)
    (hb : 2 ≤ b) {N : ℕ} (rT : QRegister N n) (rA : QRegister (N * b) n)
    (hTA : rT.DisjointWires rA) (rS : QRegister (2 * b) n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (hdisj : (rT.concat rA hTA).DisjointWires (rS.concat rCat hsc))
    (m : ℕ) (hm : m < N) :
    CatKet (rT.concat rA hTA) rS rCat hsc
      (regCascadeSProgram v b rT rA hTA rS rCat m hm).compile
      (blockDiag fun x ↦ givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) m hm) := by
  induction m with
  | zero =>
      have h := CatKet.circuit (Var := Var) (rT.concat rA hTA) rS rCat hsc Circuit.identity
      have e : (blockDiag fun x : Fin (2 ^ (N * b)) ↦
          givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) 0 hm) =
          Circuit.identity.eval := by
        simp only [givensCascadePrefix, Circuit.eval_identity]
        exact blockDiag_one
      simp only [regCascadeSProgram, DynamicCircuit.compile_circuit]
      rw [e]
      exact h
  | succ m ih =>
      have hq : m * b + b ≤ N * b := angleWord_le N b m (by omega)
      have hp := rcsPlaneLift v b hb false rT rA hTA rS rCat hsc hdisj m hm hq
      have h := CatKet.seq hdisj hp (ih (by omega))
      simp only [blockDiag_mul] at h
      have e : (fun x : Fin (2 ^ (N * b)) ↦
          givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) (m + 1) hm) =
          fun x ↦ givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) m (by omega) *
            (pairAdj N m hm).embedUnitary (givensPlaneUnitary
              (regPlaneAngle b false ((QRegister.block (m * b) b hq).extractIndex x))) := by
        funext x
        rw [rcAngle N b m (by omega) hq x]
        simp only [givensCascadePrefix, givensAdjUnitary]
      simp only [regCascadeSProgram, DynamicCircuit.compile_seq]
      rw [e]
      exact h

theorem regCascadeInvS_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (b : ℕ)
    (hb : 2 ≤ b) {N : ℕ} (rT : QRegister N n) (rA : QRegister (N * b) n)
    (hTA : rT.DisjointWires rA) (rS : QRegister (2 * b) n) (rCat : QRegister b n)
    (hsc : rS.DisjointWires rCat) (hdisj : (rT.concat rA hTA).DisjointWires (rS.concat rCat hsc))
    (m : ℕ) (hm : m < N) :
    CatKet (rT.concat rA hTA) rS rCat hsc
      (regCascadeInvSProgram v b rT rA hTA rS rCat m hm).compile
      (blockDiag fun x ↦ (givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) m hm)⁻¹) := by
  induction m with
  | zero =>
      have h := CatKet.circuit (Var := Var) (rT.concat rA hTA) rS rCat hsc Circuit.identity
      have e : (blockDiag fun x : Fin (2 ^ (N * b)) ↦
          (givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) 0 hm)⁻¹) =
          Circuit.identity.eval := by
        simp only [givensCascadePrefix, inv_one, Circuit.eval_identity]
        exact blockDiag_one
      simp only [regCascadeInvSProgram, DynamicCircuit.compile_circuit]
      rw [e]
      exact h
  | succ m ih =>
      have hq : m * b + b ≤ N * b := angleWord_le N b m (by omega)
      have hp := rcsPlaneLift v b hb true rT rA hTA rS rCat hsc hdisj m hm hq
      have h := CatKet.seq hdisj (ih (by omega)) hp
      simp only [blockDiag_mul] at h
      have e : (fun x : Fin (2 ^ (N * b)) ↦
          (givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) (m + 1) hm)⁻¹) =
          fun x ↦ (pairAdj N m hm).embedUnitary (givensPlaneUnitary
              (regPlaneAngle b true ((QRegister.block (m * b) b hq).extractIndex x))) *
            (givensCascadePrefix N (givensLeafAngle N b (angleVec N b x)) m (by omega))⁻¹ := by
        funext x
        rw [rcAngleInv, givensPlaneUnitary_neg, QRegister.embedUnitary_inv,
          rcAngle N b m (by omega) hq x]
        simp only [givensCascadePrefix, givensAdjUnitary, _root_.mul_inv_rev]
      simp only [regCascadeInvSProgram, DynamicCircuit.compile_seq]
      rw [e]
      exact h

theorem regCascadeS_count {Var : Type} (v : Var) (b : ℕ) {N : ℕ} (rT : QRegister N n)
    (rA : QRegister (N * b) n) (hTA : rT.DisjointWires rA) (rS : QRegister (2 * b) n)
    (rCat : QRegister b n) (m : ℕ) (hm : m < N) :
    (regCascadeSProgram v b rT rA hTA rS rCat m hm).count PrimitiveGate.TOFF = 0 ∧
      (regCascadeSProgram v b rT rA hTA rS rCat m hm).count PrimitiveGate.T ≤ 8 * m * (b - 1) := by
  induction m with
  | zero => simp [regCascadeSProgram]
  | succ m ih =>
      obtain ⟨a, c⟩ := regPlaneS_count v b false (rT.compose (pairAdj N m hm))
        (angleWord b m rA (by omega)) (rcDisj rT rA hTA m hm) rS rCat
      obtain ⟨a', c'⟩ := ih (by omega)
      simp only [regCascadeSProgram, DynamicCircuit.count]
      have e : 8 * (m + 1) * (b - 1) = 8 * m * (b - 1) + 8 * (b - 1) := by ring
      rw [e]
      exact ⟨by omega, by omega⟩

theorem regCascadeInvS_count {Var : Type} (v : Var) (b : ℕ) {N : ℕ} (rT : QRegister N n)
    (rA : QRegister (N * b) n) (hTA : rT.DisjointWires rA) (rS : QRegister (2 * b) n)
    (rCat : QRegister b n) (m : ℕ) (hm : m < N) :
    (regCascadeInvSProgram v b rT rA hTA rS rCat m hm).count PrimitiveGate.TOFF = 0 ∧
      (regCascadeInvSProgram v b rT rA hTA rS rCat m hm).count PrimitiveGate.T ≤
        8 * m * (b - 1) := by
  induction m with
  | zero => simp [regCascadeInvSProgram]
  | succ m ih =>
      obtain ⟨a, c⟩ := regPlaneS_count v b true (rT.compose (pairAdj N m hm))
        (angleWord b m rA (by omega)) (rcDisj rT rA hTA m hm) rS rCat
      obtain ⟨a', c'⟩ := ih (by omega)
      simp only [regCascadeInvSProgram, DynamicCircuit.count]
      have e : 8 * (m + 1) * (b - 1) = 8 * m * (b - 1) + 8 * (b - 1) := by ring
      rw [e]
      exact ⟨by omega, by omega⟩

end QC14.RegKickS


