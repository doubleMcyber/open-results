        ∑ p : Fin N, ∑ q ∈ Finset.univ.filter (fun q : Fin N ↦ p < q), ∑ x : Fin 2,
            ((coef g (σ, p, q, x) : ℝ) : ℂ) • (selectPauliString (pRow N (σ, p, q, x))).1 +
          ∑ p : Fin N, ∑ q ∈ Finset.univ.filter (fun q : Fin N ↦ p < q), ∑ x : Fin 2,
            ((coef g (σ, q, p, x) : ℝ) : ℂ) • (selectPauliString (pRow N (σ, q, p, x))).1 := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun p _ ↦ ?_
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun q hq ↦ ?_
      rw [rows_hop g hs σ (Finset.mem_filter.mp hq).2]
    rw [hD, hH]
    abel
