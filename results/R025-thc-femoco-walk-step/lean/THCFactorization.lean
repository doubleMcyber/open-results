variable {n : ℕ}

/-- `A† S A` on system (`2N`) ++ index (`b`) ++ garbage (`g`). -/
noncomputable def lcuU (N b g : ℕ) (F : Fin (2 ^ g) → Fin (2 ^ b)) (S : Unitary (2 ^ (2 * N + b))) :
    Unitary (2 ^ (2 * N + (b + g))) :=
  star ((blkA (2 * N) b g).embedUnitary (prepU b g F)) * (blkS (2 * N) b g).embedUnitary S *
    (blkA (2 * N) b g).embedUnitary (prepU b g F)

/-- The B4 form `Σ_j P_j sys(W_j)`, embedded into the data register, is phase one's form. -/
theorem embed_selectForm (N b g : ℕ) (W : Fin (2 ^ b) → Operator (2 ^ (2 * N))) :
    (blkS (2 * N) b g).embedMatrix
        (∑ j : Fin (2 ^ b), idxProj N b j.val j.2 * (sysReg N b).embedMatrix (W j)) =
      ∑ j : Fin (2 ^ b), ((blkS (2 * N) b g).slice (2 * N) b (by omega)).basisOutcomeProjector j *
        (blkSys (2 * N) b g).embedMatrix (W j) := by
  have hsys : (blkS (2 * N) b g).compose (sysReg N b) = blkSys (2 * N) b g := by
    apply QRegister.ext
    apply Function.Embedding.ext
    intro i
    apply Fin.ext
    first
      | (simp [sysReg]; done)
      | (show (0 + (0 + i.val) : ℕ) = 0 + i.val; omega)
  have h1 : ∀ j : Fin (2 ^ b), (blkS (2 * N) b g).embedMatrix (idxProj N b j.val j.2) =
      ((blkS (2 * N) b g).slice (2 * N) b (by omega)).basisOutcomeProjector j := by
    intro j
    show (blkS (2 * N) b g).embedMatrix ((idxReg N b).embedMatrix (compProj ⟨j.val, j.2⟩)) =
      ((blkS (2 * N) b g).slice (2 * N) b (by omega)).embedMatrix (compProj j)
    exact (QRegister.embedMatrix_compose _ _ _).symm
  have h2 : ∀ j : Fin (2 ^ b), (blkS (2 * N) b g).embedMatrix ((sysReg N b).embedMatrix (W j)) =
      (blkSys (2 * N) b g).embedMatrix (W j) := by
    intro j
    rw [← QRegister.embedMatrix_compose, hsys]
  rw [QRegister.embedMatrix_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [QRegister.embedMatrix_mul, h1 j, h2 j]

/-- Top-left block of `A† S A`. -/
theorem lcuU_block (N b g : ℕ) (F : Fin (2 ^ g) → Fin (2 ^ b)) (S : Unitary (2 ^ (2 * N + b)))
    (W : Fin (2 ^ b) → Operator (2 ^ (2 * N)))
    (hS : S.1 = ∑ j : Fin (2 ^ b), idxProj N b j.val j.2 * (sysReg N b).embedMatrix (W j)) :
    (blkA (2 * N) b g).basisOutcomeProjector 0 * (lcuU N b g F S).1 *
        (blkA (2 * N) b g).basisOutcomeProjector 0 =
      (blkA (2 * N) b g).basisOutcomeProjector 0 *
        (blkSys (2 * N) b g).embedMatrix (∑ j : Fin (2 ^ b),
          ((((univ.filter fun σ ↦ F σ = j).card : ℝ) / 2 ^ g : ℝ) : ℂ) • W j) *
        (blkA (2 * N) b g).basisOutcomeProjector 0 := by
  set P := (blkA (2 * N) b g).basisOutcomeProjector 0 with hP
  set A := (blkA (2 * N) b g).embedMatrix (prepU b g F).1 with hA
  set T : Fin (2 ^ b) → Matrix (Fin (2 ^ (2 * N + (b + g)))) (Fin (2 ^ (2 * N + (b + g)))) ℂ :=
    fun j ↦ (blkSys (2 * N) b g).embedMatrix (W j) with hT
  set D : Fin (2 ^ b) → Matrix (Fin (2 ^ (2 * N + (b + g)))) (Fin (2 ^ (2 * N + (b + g)))) ℂ :=
    fun j ↦ (blkA (2 * N) b g).embedMatrix (Matrix.diagonal fun y : Fin (2 ^ (b + g)) ↦
      if y.val % 2 ^ b = j.val then (1 : ℂ) else 0) with hD
  obtain ⟨p, hp⟩ : ∃ p : Fin (2 ^ b) → ℂ, ∀ j, p j =
      ((((univ.filter fun σ ↦ F σ = j).card : ℝ) / 2 ^ g : ℝ) : ℂ) :=
    ⟨fun j ↦ ((((univ.filter fun σ ↦ F σ = j).card : ℝ) / 2 ^ g : ℝ) : ℂ), fun _ ↦ rfl⟩
  have hdSA : (blkSys (2 * N) b g).DisjointWires (blkA (2 * N) b g) := by
    rw [QRegister.disjoint_iff]
    intro i j h
    have := congrArg Fin.val h
    simp at this
    omega
  have hTA : ∀ j, T j * A = A * T j := fun j ↦
    QRegister.embedMatrix_comm_of_disjoint _ _ hdSA _ _
  have hTP : ∀ j, T j * P = P * T j := fun j ↦
    QRegister.embedMatrix_comm_of_disjoint _ _ hdSA _ _
  have hPP : P * P = P := QRegister.basisOutcomeProjector_mul_self _ 0
  have hUv : (lcuU N b g F S).1 = Aᴴ * (∑ j, D j * T j) * A := by
    have hsel : (blkS (2 * N) b g).embedMatrix S.1 =
        ∑ j : Fin (2 ^ b), ((blkS (2 * N) b g).slice (2 * N) b (by omega)).basisOutcomeProjector j *
          (blkSys (2 * N) b g).embedMatrix (W j) := by
      rw [hS]
      exact embed_selectForm N b g W
    simp only [QC14.idx_diag] at hsel
    unfold lcuU
    show (star ((blkA (2 * N) b g).embedUnitary (prepU b g F))).1 *
      ((blkS (2 * N) b g).embedUnitary S).1 *
      ((blkA (2 * N) b g).embedUnitary (prepU b g F)).1 = _
    rw [Unitary.coe_star, Matrix.star_eq_conjTranspose, QRegister.embedUnitary_val,
      QRegister.embedUnitary_val (blkS (2 * N) b g), hsel]
  have hcore : ∀ j, P * Aᴴ * D j * A * P = p j • P := by
    intro j
    rw [hp]
    calc P * Aᴴ * D j * A * P
        = (blkA (2 * N) b g).embedMatrix (compProj (0 : Fin (2 ^ (b + g))) * (prepU b g F).1ᴴ *
          Matrix.diagonal (fun y : Fin (2 ^ (b + g)) ↦
            if y.val % 2 ^ b = j.val then (1 : ℂ) else 0) * (prepU b g F).1 * compProj 0) := by
          simp only [QRegister.embedMatrix_mul, QRegister.embedMatrix_conjTranspose] <;> rfl
      _ = ((((univ.filter fun σ ↦ F σ = j).card : ℝ) / 2 ^ g : ℝ) : ℂ) • P := by
          rw [QC14.prep_prob_block, QC14.prepU_prob, QRegister.embedMatrix_smul] <;> rfl
  have key : ∀ j, P * (Aᴴ * (D j * T j) * A) * P = p j • (P * T j) := by
    intro j
    calc P * (Aᴴ * (D j * T j) * A) * P
        = P * Aᴴ * D j * (T j * A) * P := by simp only [Matrix.mul_assoc]
      _ = P * Aᴴ * D j * (A * T j) * P := by rw [hTA j]
      _ = (P * Aᴴ * D j * A) * (T j * P) := by simp only [Matrix.mul_assoc]
      _ = (P * Aᴴ * D j * A) * (P * T j) := by rw [hTP j]
      _ = (P * Aᴴ * D j * A * P) * T j := by simp only [Matrix.mul_assoc]
      _ = p j • (P * T j) := by rw [hcore j, Matrix.smul_mul]
  have hsum_eq : (∑ j : Fin (2 ^ b),
      ((((univ.filter fun σ ↦ F σ = j).card : ℝ) / 2 ^ g : ℝ) : ℂ) • W j) =
      ∑ j : Fin (2 ^ b), p j • W j :=
    Finset.sum_congr rfl fun j _ ↦ by rw [hp]
  have hrhs : P * (blkSys (2 * N) b g).embedMatrix (∑ j : Fin (2 ^ b), p j • W j) * P =
      ∑ j, p j • (P * T j) := by
    simp only [QRegister.embedMatrix_sum, QRegister.embedMatrix_smul, Finset.mul_sum,
      Finset.sum_mul, Matrix.mul_smul, Matrix.smul_mul]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    show p j • (P * T j * P) = p j • (P * T j)
    rw [Matrix.mul_assoc, hTP j, ← Matrix.mul_assoc, hPP]
  rw [hsum_eq, hrhs, hUv]
  simp only [Finset.mul_sum, Finset.sum_mul, key]

/-- `A† S A` is Hermitian when every block is. -/
theorem lcuU_herm (N b g : ℕ) (F : Fin (2 ^ g) → Fin (2 ^ b)) (S : Unitary (2 ^ (2 * N + b)))
    (W : Fin (2 ^ b) → Operator (2 ^ (2 * N)))
    (hS : S.1 = ∑ j : Fin (2 ^ b), idxProj N b j.val j.2 * (sysReg N b).embedMatrix (W j))
    (hW : ∀ j, (W j)ᴴ = W j) :
    (lcuU N b g F S).1ᴴ = (lcuU N b g F S).1 := by
  have hdis : (sysReg N b).DisjointWires (idxReg N b) :=
    QRegister.block_disjoint_of_le 0 (2 * N) (2 * N) b (by omega) le_rfl (by omega)
  have hPh : ∀ j : Fin (2 ^ b), (idxProj N b j.val j.2)ᴴ = idxProj N b j.val j.2 := fun j ↦ by
    unfold idxProj
    exact QRegister.basisOutcomeProjector_conjTranspose _ _
  have hSh : S.1ᴴ = S.1 := by
    rw [hS, Matrix.conjTranspose_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [Matrix.conjTranspose_mul, hPh j, ← QRegister.embedMatrix_conjTranspose, hW j]
    unfold idxProj QRegister.basisOutcomeProjector
    exact (QRegister.embedMatrix_comm_of_disjoint _ _ hdis _ _)
  have hSu : star S = S := Subtype.ext (by
    rw [Unitary.coe_star, Matrix.star_eq_conjTranspose]; exact hSh)
  have hsS : star ((blkS (2 * N) b g).embedUnitary S) = (blkS (2 * N) b g).embedUnitary S := by
    rw [← QC14.embedUnitary_star', hSu]
  have h : star (lcuU N b g F S) = lcuU N b g F S := by
    unfold lcuU
    rw [star_mul, star_mul, star_star, hsS]
    exact (mul_assoc _ _ _).symm
  have := congrArg Subtype.val h
  rwa [Unitary.coe_star, Matrix.star_eq_conjTranspose] at this

/-! ## PREPARE on clean scratch, ket by ket -/

/-- Exact action of `prepC` on every basis ket with clean scratch. -/
theorem prepC_ket {N b g : ℕ} (F : Fin (2 ^ g) → Fin (2 ^ b)) (rData : QRegister (N + (b + g)) n)
    (rAnc : QRegister (b + g + 1) n) (hd : ∀ i j, rData i ≠ rAnc j) (β : BitAssignment n)
    (h0 : localIdx rAnc β = 0) :
    (prepC F rData rAnc hd).eval.1 *ᵥ ket β =
      (rData.embedUnitary ((blkA N b g).embedUnitary (prepU b g F))).1 *ᵥ ket β := by
  have h0' := QC14.localIdx_slice_zero rAnc 0 (g + 1) (by omega) β h0
  have hdP : (rData.slice N (b + g) le_rfl).DisjointWires (rAnc.slice 0 (g + 1) (by omega)) :=
    QRegister.disjoint_iff.2 (fun i j ↦ hd _ _)
  rw [← QRegister.embedUnitary_compose, prepU, QRegister.embedUnitary_mul]
  unfold prepC
  rw [Circuit.eval_seq, Circuit.eval_onRegister, mulVec_mul_unitary, mulVec_mul_unitary]
  exact clean_key b g _ (rData.slice N (b + g) le_rfl) (rAnc.slice 0 (g + 1) (by omega)) hdP _ β h0'

/-- Exact action of `prepC⁻¹` on every basis ket with clean scratch. -/
theorem prepCinv_ket {N b g : ℕ} (F : Fin (2 ^ g) → Fin (2 ^ b)) (rData : QRegister (N + (b + g)) n)
    (rAnc : QRegister (b + g + 1) n) (hd : ∀ i j, rData i ≠ rAnc j) (β : BitAssignment n)
    (h0 : localIdx rAnc β = 0) :
    (prepC F rData rAnc hd).inverse.eval.1 *ᵥ ket β =
      (rData.embedUnitary (star ((blkA N b g).embedUnitary (prepU b g F)))).1 *ᵥ ket β := by
  have hdD : rData.DisjointWires rAnc := QRegister.disjoint_iff.2 hd
  rw [QC14.embedUnitary_star']
  set Q := rAnc.basisOutcomeProjector 0 with hQ
  set A' : Unitary (2 ^ n) := rData.embedUnitary ((blkA N b g).embedUnitary (prepU b g F)) with hA'
  have hCQ : (prepC F rData rAnc hd).eval.1 * Q = A'.1 * Q :=
    QC14.clean_ext rAnc _ _ (fun β h0 ↦ prepC_ket F rData rAnc hd β h0)
  have hcAi : (star A').1 * Q = Q * (star A').1 := by
    rw [hA', ← QC14.embedUnitary_star']
    exact (CleanSubroutineBridge.embed_comm_proj rData rAnc hdD _).symm
  have hCi : (prepC F rData rAnc hd).inverse.eval.1 * (prepC F rData rAnc hd).eval.1 = 1 := by
    rw [Circuit.eval_inverse]
    exact congrArg Subtype.val (inv_mul_cancel (prepC F rData rAnc hd).eval)
  have hAu : A'.1 * (star A').1 = 1 := by
    have : A' * star A' = 1 := by rw [Unitary.star_eq_inv, mul_inv_cancel A']
    exact congrArg Subtype.val this
  have hInv : (prepC F rData rAnc hd).inverse.eval.1 * Q = (star A').1 * Q :=
    QC14.inv_clean hCQ hcAi.symm hAu hCi
  have hQk : Q *ᵥ ket β = ket β := by
    rw [hQ, basisOutcomeProjector_mulVec_ket]
    exact if_pos h0
  have h1 := congrArg (fun M ↦ M *ᵥ ket β) hInv
  simp only [← Matrix.mulVec_mulVec, hQk] at h1
  exact h1

/-! ## Scratch sub-registers -/

private theorem concat_sub2 {b g beth : ℕ} (rAnc : QRegister (b + g + 1) n)
    (rK : QRegister (2 * beth) n) (hb : 0 + (b + 1) ≤ b + g + 1) (hAK : rAnc.DisjointWires rK)
    (hAK' : (rAnc.slice 0 (b + 1) hb).DisjointWires rK) (i : Fin (b + 1 + 2 * beth)) :
    ∃ i' : Fin (b + g + 1 + 2 * beth),
      ((rAnc.slice 0 (b + 1) hb).concat rK hAK') i = (rAnc.concat rK hAK) i' := by
  induction i using Fin.addCases with
  | left i2 =>
    refine ⟨Fin.castAdd (2 * beth) ⟨i2.val, by omega⟩, ?_⟩
    simp only [QRegister.concat_apply_left]
    first
      | done
      | (simp [QRegister.slice_apply]; done)
      | (rw [QRegister.slice_apply]; congr 1; exact Fin.ext (Nat.zero_add _))
  | right i2 =>
    refine ⟨Fin.natAdd (b + g + 1) i2, ?_⟩
    simp only [QRegister.concat_apply_right]

private theorem concat_sub3 {b g beth : ℕ} (rAnc : QRegister (b + g + 1) n)
    (rK : QRegister (2 * beth) n) (rCat : QRegister beth n) (hb : 0 + (b + 1) ≤ b + g + 1)
    (hAK : rAnc.DisjointWires rK) (hAK' : (rAnc.slice 0 (b + 1) hb).DisjointWires rK)
    (hsc : (rAnc.concat rK hAK).DisjointWires rCat)
    (hsc' : ((rAnc.slice 0 (b + 1) hb).concat rK hAK').DisjointWires rCat)
    (i : Fin (b + 1 + 2 * beth + beth)) :
    ∃ i' : Fin (b + g + 1 + 2 * beth + beth),
      (((rAnc.slice 0 (b + 1) hb).concat rK hAK').concat rCat hsc') i =
        ((rAnc.concat rK hAK).concat rCat hsc) i' := by
  induction i using Fin.addCases with
  | left i1 =>
    obtain ⟨i1', h⟩ := concat_sub2 rAnc rK hb hAK hAK' i1
    exact ⟨Fin.castAdd beth i1', by simp only [QRegister.concat_apply_left]; exact h⟩
  | right i1 =>
    exact ⟨Fin.natAdd (b + g + 1 + 2 * beth) i1, by simp only [QRegister.concat_apply_right]⟩

/-! ## The program -/

/-- `PREPARE; SELECT; PREPARE†`; SELECT targets system ++ index and uses the first `b + 1`
scratch wires as its chain. -/
noncomputable def lcuProgram {Var : Type} (v : Var) (beth : ℕ) {N b g : ℕ}
    (F : Fin (2 ^ g) → Fin (2 ^ b)) (k : Fin N → Fin N → ℤ) (s : Fin N → Bool)
    (rData : QRegister (2 * N + (b + g)) n) (rAnc : QRegister (b + g + 1) n)
    (rK : QRegister (2 * beth) n) (rCat : QRegister beth n) (hd : ∀ i j, rData i ≠ rAnc j)
    (hcD : rCat.DisjointWires rData) : DynamicCircuit Var n :=
  .seq (.circuit (prepC F rData rAnc hd))
    (.seq (selectProgram v beth k s (rData.compose (blkS (2 * N) b g)) (rAnc.slice 0 (b + 1) (by omega))
        rK rCat (fun i j ↦ hd _ _) (hcD.compose_right _))
      (.circuit (prepC F rData rAnc hd).inverse))

theorem lcu_catKet {Var : Type} [DecidableEq Var] [NeZero (2 ^ n)] (v : Var) (beth : ℕ)
    {N b g : ℕ} (F : Fin (2 ^ g) → Fin (2 ^ b)) (k : Fin N → Fin N → ℤ)
    (s : Fin N → Bool) (h2N : 2 * N ≤ 2 ^ b) (rData : QRegister (2 * N + (b + g)) n)
    (rAnc : QRegister (b + g + 1) n) (rK : QRegister (2 * beth) n) (rCat : QRegister beth n)
    (hd : ∀ i j, rData i ≠ rAnc j) (hcD : rCat.DisjointWires rData)
    (hAK : rAnc.DisjointWires rK) (hsc : (rAnc.concat rK hAK).DisjointWires rCat)
    (hdisj : rData.DisjointWires ((rAnc.concat rK hAK).concat rCat hsc)) :
    ∃ S : Unitary (2 ^ (2 * N + b)),
      S.1 = selectOp N b beth k s h2N ∧
      CatKet rData (rAnc.concat rK hAK) rCat hsc
        (lcuProgram v beth F k s rData rAnc rK rCat hd hcD).compile (lcuU N b g F S) := by
  have hb : 0 + (b + 1) ≤ b + g + 1 := by omega
  have hAK' : (rAnc.slice 0 (b + 1) hb).DisjointWires rK := hAK.compose_left _
  have hsc' : ((rAnc.slice 0 (b + 1) hb).concat rK hAK').DisjointWires rCat := by
    rw [QRegister.disjoint_iff]
    intro i j h
    obtain ⟨i', hi'⟩ := concat_sub2 rAnc rK hb hAK hAK' i
    exact (QRegister.disjoint_iff.1 hsc i' j) (hi'.symm.trans h)
  have hdisj' : (rData.compose (blkS (2 * N) b g)).DisjointWires
      (((rAnc.slice 0 (b + 1) hb).concat rK hAK').concat rCat hsc') := by
    rw [QRegister.disjoint_iff]
    intro i j h
    obtain ⟨j', hj'⟩ := concat_sub3 rAnc rK rCat hb hAK hAK' hsc hsc' j
    exact (QRegister.disjoint_iff.1 hdisj (blkS (2 * N) b g i) j') (h.trans hj')
  obtain ⟨S, hSval, hSel⟩ := select_catKet v beth k s h2N (rData.compose (blkS (2 * N) b g))
    (rAnc.slice 0 (b + 1) hb) rK rCat (fun i j ↦ hd _ _) (hcD.compose_right _) hAK' hsc' hdisj'
  have hSel2 := CatKet.compose (blkS (2 * N) b g) hSel
  have hsub : ∀ β : BitAssignment n,
      localIdx ((rAnc.concat rK hAK).concat rCat hsc) β = 0 →
      localIdx (((rAnc.slice 0 (b + 1) hb).concat rK hAK').concat rCat hsc') β = 0 := by
    intro β h0
    apply localIdx_eq_zero_of_forall
    intro i
    obtain ⟨i', hi'⟩ := concat_sub3 rAnc rK rCat hb hAK hAK' hsc hsc' i
    rw [hi']
    exact eq_zero_of_localIdx_eq_zero _ β h0 i'
  have hSel3 := catKet_mono_scratch hsub hSel2
  have hPrep := catKet_circuit_ket (Var := Var) rData (rAnc.concat rK hAK) rCat hsc
    (prepC F rData rAnc hd) ((blkA (2 * N) b g).embedUnitary (prepU b g F))
    (fun β h0 ↦ prepC_ket F rData rAnc hd β (localIdx_concat_zero rAnc rK hAK β h0).1)
  have hInvK := catKet_circuit_ket (Var := Var) rData (rAnc.concat rK hAK) rCat hsc
    (prepC F rData rAnc hd).inverse (star ((blkA (2 * N) b g).embedUnitary (prepU b g F)))
    (fun β h0 ↦ prepCinv_ket F rData rAnc hd β (localIdx_concat_zero rAnc rK hAK β h0).1)
  refine ⟨S, hSval, ?_⟩
  unfold lcuU
  simp only [lcuProgram, DynamicCircuit.compile_seq]
  exact CatKet.seq hdisj hPrep (CatKet.seq hdisj hSel3 hInvK)

theorem lcu_count {Var : Type} (v : Var) (beth : ℕ) {N b g : ℕ}
    (F : Fin (2 ^ g) → Fin (2 ^ b)) (k : Fin N → Fin N → ℤ) (s : Fin N → Bool)
    (rData : QRegister (2 * N + (b + g)) n) (rAnc : QRegister (b + g + 1) n)
    (rK : QRegister (2 * beth) n) (rCat : QRegister beth n) (hd : ∀ i j, rData i ≠ rAnc j)
    (hcD : rCat.DisjointWires rData) :
    (lcuProgram v beth F k s rData rAnc rK rCat hd hcD).count PrimitiveGate.TOFF = 0 ∧
      (lcuProgram v beth F k s rData rAnc rK rCat hd hcD).count PrimitiveGate.T ≤
        2 * (8 * g * 2 ^ g) + 2 * N * (16 * (N - 1) * (beth - 1) + 8 * b) := by
  have hp : (prepC F rData rAnc hd).count PrimitiveGate.TOFF = 0 ∧
      (prepC F rData rAnc hd).count PrimitiveGate.T ≤ 8 * g * 2 ^ g :=
    count_prog b g (tblOf b g F) (rData.slice (2 * N) (b + g) le_rfl)
      (rAnc.slice 0 (g + 1) (by omega)) (fun i j ↦ hd _ _)
  have hs := select_count v beth k s (rData.compose (blkS (2 * N) b g))
    (rAnc.slice 0 (b + 1) (by omega)) rK rCat (fun i j ↦ hd _ _) (hcD.compose_right _)
  have hiT : ∀ c : Circuit n, c.inverse.count PrimitiveGate.T = c.count PrimitiveGate.T :=
    fun c ↦ Circuit.count_inverse_of_ne _ (by simp) (by simp) c
  have hiO : ∀ c : Circuit n, c.inverse.count PrimitiveGate.TOFF = c.count PrimitiveGate.TOFF :=
    fun c ↦ Circuit.count_inverse_of_ne _ (by simp) (by simp) c
  simp only [lcuProgram, DynamicCircuit.count, hiT, hiO]
  omega


end QC14.BlockLCU


/-! Inlined from lane module `THC/PairBlock.lean`. -/

namespace QC14.PairBlock

open QuantumComputation QuantumComputation.Specs Matrix Finset
open Operator
open PrepareImpl
open QC14.RowProgram QC14.SelectRows QC14.SelectL QC14.BlockLCU QC14.WeightsC
open QC14 (blkA blkS blkSys prepU)
open scoped Matrix

/-! ## A block lemma for any PREPARE unitary -/

/-- `Q† S Q` on system (`2N`) ++ index (`b`) ++ garbage (`g`). -/
noncomputable def lcuQ (N b g : ℕ) (Q : Unitary (2 ^ (b + g))) (S : Unitary (2 ^ (2 * N + b))) :
    Unitary (2 ^ (2 * N + (b + g))) :=
  star ((blkA (2 * N) b g).embedUnitary Q) * (blkS (2 * N) b g).embedUnitary S *
    (blkA (2 * N) b g).embedUnitary Q

/-- `|y⟩⟨x|` on the index wires of system ++ index. -/
noncomputable def idxTr (N b : ℕ) (y x : Fin (2 ^ b)) : Operator (2 ^ (2 * N + b)) :=
  (idxReg N b).embedMatrix (Matrix.single y x 1)

/-- `Σ_σ conj ψ(y, σ) ψ(x, σ)` for `ψ = Q|0⟩` (index `y` or `x`, garbage `σ`). -/
noncomputable def redAmp (b g : ℕ) (Q : Unitary (2 ^ (b + g))) (y x : Fin (2 ^ b)) : ℂ :=
  ∑ σ : Fin (2 ^ g),
    star (Q.1 (prepareDataEquiv b g (y, σ)) 0) * Q.1 (prepareDataEquiv b g (x, σ)) 0

/-- The low `b` wires of `m` wires. -/
private def lowR (b m : ℕ) (h : b ≤ m) : QRegister b m := QRegister.block 0 b (by omega)


private abbrev lowB (b g : ℕ) : QRegister b (b + g) := lowR b (b + g) (Nat.le_add_right b g)

private theorem lowR_val (b m : ℕ) (h : b ≤ m) (i : Fin b) : ((lowR b m h) i).val = i.val := by
  show (0 + i.val : ℕ) = i.val
  omega

private theorem lowR_extract (b m : ℕ) (h : b ≤ m) (j : Fin (2 ^ m)) :
    (lowR b m h).extractIndex j = ⟨j.val % 2 ^ b, Nat.mod_lt _ (Nat.two_pow_pos _)⟩ := by
  apply (basisBits b).injective
  funext i
  rw [QRegister.basisBits_extractIndex, basisBits_eq_testBit, basisBits_eq_testBit]
  simp only [lowR_val, Nat.testBit_mod_two_pow, i.2, decide_true, Bool.true_and]

private theorem lowR_agree (b m : ℕ) (h : b ≤ m) (i j : Fin (2 ^ m)) :
    (lowR b m h).AgreeOutside i j ↔ i.val / 2 ^ b = j.val / 2 ^ b := by
  have e : ∀ x y : Bool, ((if x then (1 : ZMod 2) else 0) = if y then 1 else 0) ↔ x = y := by
    decide
  have hnot : ∀ q : Fin m, b ≤ q.val → q ∉ Set.range (lowR b m h).wires := by
    rintro q hq ⟨i', hi'⟩
    have h1 : ((lowR b m h) i').val = q.val := congrArg Fin.val hi'
    rw [lowR_val] at h1
    have := i'.2
    omega
  constructor
  · intro h
    apply Nat.eq_of_testBit_eq
    intro k
    rw [Nat.testBit_div_two_pow, Nat.testBit_div_two_pow]
    by_cases hk : k + b < m
    · have h1 := h ⟨k + b, hk⟩ (hnot _ (by simp))
      rw [basisBits_eq_testBit, basisBits_eq_testBit] at h1
      exact (e _ _).1 h1
    · have hi := i.2
      have hj := j.2
      have h2 : 2 ^ m ≤ 2 ^ (k + b) := Nat.pow_le_pow_right (by omega) (by omega)
      rw [Nat.testBit_lt_two_pow (by omega), Nat.testBit_lt_two_pow (by omega)]
  · intro h q hq
    have hqb : b ≤ q.val := by
      by_contra hlt
      exact hq ⟨⟨q.val, by omega⟩, Fin.ext (by rw [lowR_val])⟩
    rw [basisBits_eq_testBit, basisBits_eq_testBit]
    refine (e _ _).2 ?_
    have h3 := congrArg (fun m ↦ Nat.testBit m (q.val - b)) h
    simp only [Nat.testBit_div_two_pow] at h3
    rwa [Nat.sub_add_cancel hqb] at h3

private theorem lowR_entry (b m : ℕ) (h : b ≤ m) (y x : Fin (2 ^ b)) (r s : Fin (2 ^ m)) :
    (lowR b m h).embedMatrix (Matrix.single y x (1 : ℂ)) r s =
      if y.val = r.val % 2 ^ b ∧ x.val = s.val % 2 ^ b ∧ r.val / 2 ^ b = s.val / 2 ^ b
        then 1 else 0 := by
  rw [QRegister.embedMatrix_apply_of_agreeOutside, lowR_extract, lowR_extract]
  by_cases hA : (lowR b m h).AgreeOutside r s
  · have h3 := (lowR_agree b m h r s).1 hA
    rw [if_pos hA, mul_one, Matrix.single_apply]
    simp [Fin.ext_iff, h3]
  · rw [if_neg hA, mul_zero, if_neg]
    rintro ⟨-, -, h'⟩
    exact hA ((lowR_agree b m h r s).2 h')

private theorem redAmp_eq (b g : ℕ) (Q : Unitary (2 ^ (b + g))) (y x : Fin (2 ^ b)) :
    ((Q.1)ᴴ * (lowB b g).embedMatrix (Matrix.single y x (1 : ℂ)) * Q.1) 0 0 =
      redAmp b g Q y x := by
  have hre : ∀ f : Fin (2 ^ (b + g)) → ℂ, ∑ i, f i =
      ∑ p : Fin (2 ^ b) × Fin (2 ^ g), f (prepareDataEquiv b g p) :=
    fun f ↦ ((prepareDataEquiv b g).sum_comp f).symm
  have hE : ∀ p s : Fin (2 ^ b) × Fin (2 ^ g),
      (lowB b g).embedMatrix (Matrix.single y x (1 : ℂ)) (prepareDataEquiv b g p)
        (prepareDataEquiv b g s) = if y = p.1 ∧ x = s.1 ∧ p.2 = s.2 then 1 else 0 := by
    intro p s
    rw [lowR_entry]
    have h1 : ∀ (j : Fin (2 ^ b)) (σ : Fin (2 ^ g)),
        (prepareDataEquiv b g (j, σ)).val % 2 ^ b = j.val := fun j σ ↦ by
      rw [prepareDataEquiv_val, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt j.2]
    have h2 : ∀ (j : Fin (2 ^ b)) (σ : Fin (2 ^ g)),
        (prepareDataEquiv b g (j, σ)).val / 2 ^ b = σ.val := fun j σ ↦ by
      rw [prepareDataEquiv_val, Nat.add_mul_div_left _ _ (Nat.two_pow_pos b),
        Nat.div_eq_of_lt j.2, zero_add]
    obtain ⟨j, σ⟩ := p
    obtain ⟨j', σ'⟩ := s
    simp only [h1, h2, Fin.ext_iff]
  have hin : ∀ s : Fin (2 ^ b) × Fin (2 ^ g),
      ∑ p : Fin (2 ^ b) × Fin (2 ^ g), star (Q.1 (prepareDataEquiv b g p) 0) *
          (if y = p.1 ∧ x = s.1 ∧ p.2 = s.2 then (1 : ℂ) else 0) *
          Q.1 (prepareDataEquiv b g s) 0 =
        if x = s.1 then star (Q.1 (prepareDataEquiv b g (y, s.2)) 0) *
          Q.1 (prepareDataEquiv b g s) 0 else 0 := by
    intro s
    rw [Finset.sum_eq_single (y, s.2)]
    · by_cases h : x = s.1 <;> simp [h]
    · intro p _ hp
      have : ¬(y = p.1 ∧ x = s.1 ∧ p.2 = s.2) := by
        rintro ⟨h1, -, h3⟩
        exact hp (Prod.ext h1.symm h3)
      simp [this]
    · simp
  unfold redAmp
  simp only [Matrix.mul_apply, Finset.sum_mul, Matrix.conjTranspose_apply]
  simp only [hre, hE, hin]
  rw [Fintype.sum_prod_type, Finset.sum_eq_single x]
  · simp
  · intro j' _ hj'
    have : x ≠ j' := Ne.symm hj'
    simp [this]
  · simp

private theorem idxTr_embed (N b g : ℕ) (y x : Fin (2 ^ b)) :
    (blkS (2 * N) b g).embedMatrix (idxTr N b y x) =
      (blkA (2 * N) b g).embedMatrix ((lowB b g).embedMatrix (Matrix.single y x (1 : ℂ))) := by
  have hreg : (blkS (2 * N) b g).compose (idxReg N b) = (blkA (2 * N) b g).compose (lowB b g) := by
    apply QRegister.ext
    apply Function.Embedding.ext
    intro i
    apply Fin.ext
    show (0 + (2 * N + i.val) : ℕ) = 2 * N + (0 + i.val)
    omega
  unfold idxTr
  rw [← QRegister.embedMatrix_compose, ← QRegister.embedMatrix_compose, hreg]

private theorem sys_embed (N b g : ℕ) (W : Operator (2 ^ (2 * N))) :
    (blkS (2 * N) b g).embedMatrix ((sysReg N b).embedMatrix W) =
      (blkSys (2 * N) b g).embedMatrix W := by
  have hsys : (blkS (2 * N) b g).compose (sysReg N b) = blkSys (2 * N) b g := by
    apply QRegister.ext
    apply Function.Embedding.ext
    intro i
    apply Fin.ext
    first
      | (simp [sysReg]; done)
      | (show (0 + (0 + i.val) : ℕ) = 0 + i.val; omega)
  rw [← QRegister.embedMatrix_compose, hsys]

/-- Top-left block of `Q† S Q`. -/
theorem lcuQ_block (N b g : ℕ) (Q : Unitary (2 ^ (b + g))) (S : Unitary (2 ^ (2 * N + b)))
    (W : Fin (2 ^ b) → Fin (2 ^ b) → Operator (2 ^ (2 * N)))
    (hS : S.1 = ∑ y, ∑ x, idxTr N b y x * (sysReg N b).embedMatrix (W y x)) :
    (blkA (2 * N) b g).basisOutcomeProjector 0 * (lcuQ N b g Q S).1 *
        (blkA (2 * N) b g).basisOutcomeProjector 0 =
      (blkA (2 * N) b g).basisOutcomeProjector 0 *
        (blkSys (2 * N) b g).embedMatrix (∑ y, ∑ x, redAmp b g Q y x • W y x) *
        (blkA (2 * N) b g).basisOutcomeProjector 0 := by
  set P := (blkA (2 * N) b g).basisOutcomeProjector 0 with hP
  set A := (blkA (2 * N) b g).embedMatrix Q.1 with hA
  set T : Fin (2 ^ b) → Fin (2 ^ b) →
      Matrix (Fin (2 ^ (2 * N + (b + g)))) (Fin (2 ^ (2 * N + (b + g)))) ℂ :=
    fun y x ↦ (blkSys (2 * N) b g).embedMatrix (W y x) with hT
  set E : Fin (2 ^ b) → Fin (2 ^ b) →
      Matrix (Fin (2 ^ (2 * N + (b + g)))) (Fin (2 ^ (2 * N + (b + g)))) ℂ :=
    fun y x ↦ (blkA (2 * N) b g).embedMatrix
      ((lowB b g).embedMatrix (Matrix.single y x (1 : ℂ))) with hE
  have hdSA : (blkSys (2 * N) b g).DisjointWires (blkA (2 * N) b g) := by
    rw [QRegister.disjoint_iff]
    intro i j h
    have := congrArg Fin.val h
    simp at this
    omega
  have hTA : ∀ y x, T y x * A = A * T y x := fun y x ↦
    QRegister.embedMatrix_comm_of_disjoint _ _ hdSA _ _
  have hTP : ∀ y x, T y x * P = P * T y x := fun y x ↦
    QRegister.embedMatrix_comm_of_disjoint _ _ hdSA _ _
  have hPP : P * P = P := QRegister.basisOutcomeProjector_mul_self _ 0
  have hUv : (lcuQ N b g Q S).1 = Aᴴ * (∑ y, ∑ x, E y x * T y x) * A := by
    have hsel : (blkS (2 * N) b g).embedMatrix S.1 = ∑ y, ∑ x, E y x * T y x := by
      rw [hS]
      simp only [QRegister.embedMatrix_sum, QRegister.embedMatrix_mul, idxTr_embed, sys_embed]
      rfl
    unfold lcuQ
    show (star ((blkA (2 * N) b g).embedUnitary Q)).1 *
      ((blkS (2 * N) b g).embedUnitary S).1 * ((blkA (2 * N) b g).embedUnitary Q).1 = _
    rw [Unitary.coe_star, Matrix.star_eq_conjTranspose, QRegister.embedUnitary_val,
      QRegister.embedUnitary_val (blkS (2 * N) b g), hsel]
  have hcp : ∀ y x, compProj (0 : Fin (2 ^ (b + g))) * Q.1ᴴ *
      (lowB b g).embedMatrix (Matrix.single y x (1 : ℂ)) * Q.1 * compProj 0 =
      redAmp b g Q y x • compProj 0 := by
    intro y x
    have e : compProj (0 : Fin (2 ^ (b + g))) * Q.1ᴴ *
        (lowB b g).embedMatrix (Matrix.single y x (1 : ℂ)) * Q.1 * compProj 0 =
        compProj 0 * (Q.1ᴴ * (lowB b g).embedMatrix (Matrix.single y x (1 : ℂ)) * Q.1) *
          compProj 0 := by simp only [Matrix.mul_assoc]
    rw [e]
    unfold compProj
    rw [Matrix.single_mul_mul_single, redAmp_eq, Matrix.smul_single]
    simp
  have hcore : ∀ y x, P * Aᴴ * E y x * A * P = redAmp b g Q y x • P := by
    intro y x
    calc P * Aᴴ * E y x * A * P
        = (blkA (2 * N) b g).embedMatrix (compProj (0 : Fin (2 ^ (b + g))) * Q.1ᴴ *
          (lowB b g).embedMatrix (Matrix.single y x (1 : ℂ)) * Q.1 * compProj 0) := by
          simp only [QRegister.embedMatrix_mul, QRegister.embedMatrix_conjTranspose] <;> rfl
      _ = redAmp b g Q y x • P := by
          rw [hcp, QRegister.embedMatrix_smul] <;> rfl
  have key : ∀ y x, P * (Aᴴ * (E y x * T y x) * A) * P = redAmp b g Q y x • (P * T y x) := by
    intro y x
    calc P * (Aᴴ * (E y x * T y x) * A) * P
        = P * Aᴴ * E y x * (T y x * A) * P := by simp only [Matrix.mul_assoc]
      _ = P * Aᴴ * E y x * (A * T y x) * P := by rw [hTA y x]
      _ = (P * Aᴴ * E y x * A) * (T y x * P) := by simp only [Matrix.mul_assoc]
      _ = (P * Aᴴ * E y x * A) * (P * T y x) := by rw [hTP y x]
      _ = (P * Aᴴ * E y x * A * P) * T y x := by simp only [Matrix.mul_assoc]
      _ = redAmp b g Q y x • (P * T y x) := by rw [hcore y x, Matrix.smul_mul]
  have hrhs : P * (blkSys (2 * N) b g).embedMatrix
      (∑ y, ∑ x, redAmp b g Q y x • W y x) * P =
      ∑ y, ∑ x, redAmp b g Q y x • (P * T y x) := by
    simp only [QRegister.embedMatrix_sum, QRegister.embedMatrix_smul, Finset.mul_sum,
      Finset.sum_mul, Matrix.mul_smul, Matrix.smul_mul]
    refine Finset.sum_congr rfl fun y _ ↦ Finset.sum_congr rfl fun x _ ↦ ?_
    show redAmp b g Q y x • (P * T y x * P) = redAmp b g Q y x • (P * T y x)
    rw [Matrix.mul_assoc, hTP y x, ← Matrix.mul_assoc, hPP]
  rw [hrhs, hUv]
  simp only [Finset.mul_sum, Finset.sum_mul, key]

/-- `lcuQ_block` for a SELECT that moves index `x` to `π x`. -/
theorem lcuQ_block_map (N b g : ℕ) (Q : Unitary (2 ^ (b + g))) (S : Unitary (2 ^ (2 * N + b)))
    (π : Fin (2 ^ b) → Fin (2 ^ b)) (W : Fin (2 ^ b) → Operator (2 ^ (2 * N)))
    (hS : S.1 = ∑ x, idxTr N b (π x) x * (sysReg N b).embedMatrix (W x)) :
    (blkA (2 * N) b g).basisOutcomeProjector 0 * (lcuQ N b g Q S).1 *
        (blkA (2 * N) b g).basisOutcomeProjector 0 =
      (blkA (2 * N) b g).basisOutcomeProjector 0 *
        (blkSys (2 * N) b g).embedMatrix (∑ x, redAmp b g Q (π x) x • W x) *
        (blkA (2 * N) b g).basisOutcomeProjector 0 := by
  have hS' : S.1 = ∑ y, ∑ x, idxTr N b y x *
      (sysReg N b).embedMatrix (if y = π x then W x else 0) := by
    rw [hS, Finset.sum_comm]
    refine Finset.sum_congr rfl fun x _ ↦ ?_
    rw [Finset.sum_eq_single (π x)]
    · simp
    · intro y _ hy
      simp [hy, QRegister.embedMatrix_zero]
    · simp
  have hsum : ∑ y, ∑ x, redAmp b g Q y x • (if y = π x then W x else 0) =
      ∑ x, redAmp b g Q (π x) x • W x := by
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun x _ ↦ ?_
    rw [Finset.sum_eq_single (π x)]
    · simp
    · intro y _ hy
      simp [hy]
    · simp
  have := lcuQ_block N b g Q S (fun y x ↦ if y = π x then W x else 0) hS'
  beta_reduce at this
  rw [this, hsum]

/-- `Q† S Q` is Hermitian when `S` is. -/
theorem lcuQ_herm (N b g : ℕ) (Q : Unitary (2 ^ (b + g))) (S : Unitary (2 ^ (2 * N + b)))
    (hS : S.1ᴴ = S.1) : (lcuQ N b g Q S).1ᴴ = (lcuQ N b g Q S).1 := by
  have hSu : star S = S := Subtype.ext (by
    rw [Unitary.coe_star, Matrix.star_eq_conjTranspose]; exact hS)
  have hsS : star ((blkS (2 * N) b g).embedUnitary S) = (blkS (2 * N) b g).embedUnitary S := by
    rw [← QC14.embedUnitary_star', hSu]
  have h : star (lcuQ N b g Q S) = lcuQ N b g Q S := by
    unfold lcuQ
    rw [star_mul, star_mul, star_star, hsS]
    exact (mul_assoc _ _ _).symm
  have := congrArg Subtype.val h
  rwa [Unitary.coe_star, Matrix.star_eq_conjTranspose] at this

/-! ## The pair index `A ++ B ++ z ++ o` -/

/-- Width of the pair index. -/
abbrev bP (N M : ℕ) : ℕ := idxC N M + 1

/-- Low part `A ++ B ++ z`. -/
def loP {N M : ℕ} (x : Fin (2 ^ bP N M)) : Fin (2 ^ idxC N M) :=
  ⟨x.val % 2 ^ idxC N M, Nat.mod_lt _ (Nat.two_pow_pos _)⟩

/-- The top bit `o`. -/
def oP {N M : ℕ} (x : Fin (2 ^ bP N M)) : Bool :=
  decide (2 ^ idxC N M ≤ x.val)

/-- `y ++ o`. -/
def encP {N M : ℕ} (y : Fin (2 ^ idxC N M)) (o : Bool) : Fin (2 ^ bP N M) :=
  ⟨y.val + 2 ^ idxC N M * (if o then 1 else 0), by
    have hy := y.2
    have h : 2 ^ bP N M = 2 ^ idxC N M + 2 ^ idxC N M := by
      show 2 ^ (idxC N M + 1) = _
      rw [pow_succ]; ring
    rw [h]
    split_ifs <;> omega⟩

/-- Swap the rows `A` and `B` of `A ++ B ++ z`. -/
def swapAB {N M : ℕ} (y : Fin (2 ^ idxC N M)) : Fin (2 ^ idxC N M) :=
  encC (idxB y) (idxA y) (idxZ y)

/-- The pair SELECT's index map: swap `A` and `B`, flip `o`. -/
def swapP {N M : ℕ} (x : Fin (2 ^ bP N M)) : Fin (2 ^ bP N M) :=
  encP (swapAB (loP x)) (!oP x)

private theorem two_pow_bP (N M : ℕ) : 2 ^ bP N M = 2 ^ idxC N M + 2 ^ idxC N M := by
  show 2 ^ (idxC N M + 1) = _
  rw [pow_succ]; ring

theorem loP_encP {N M : ℕ} (y : Fin (2 ^ idxC N M)) (o : Bool) : loP (encP y o) = y := by
  apply Fin.ext
  show (y.val + 2 ^ idxC N M * (if o then 1 else 0)) % 2 ^ idxC N M = y.val
  have hy := y.2
  cases o
  · simp [Nat.mod_eq_of_lt hy]
  · simp [Nat.mod_eq_of_lt hy]

theorem oP_encP {N M : ℕ} (y : Fin (2 ^ idxC N M)) (o : Bool) : oP (encP y o) = o := by
  show decide (2 ^ idxC N M ≤ y.val + 2 ^ idxC N M * (if o then 1 else 0)) = o
  have hy := y.2
  cases o
  · simp <;> omega
  · simp

theorem encP_loP {N M : ℕ} (x : Fin (2 ^ bP N M)) : encP (loP x) (oP x) = x := by
  apply Fin.ext
  show x.val % 2 ^ idxC N M + 2 ^ idxC N M * (if decide (2 ^ idxC N M ≤ x.val) = true then 1 else 0)
    = x.val
  have hx : x.val < 2 ^ idxC N M + 2 ^ idxC N M := lt_of_lt_of_eq x.2 (two_pow_bP N M)
  by_cases h : 2 ^ idxC N M ≤ x.val
  · have hm : x.val % 2 ^ idxC N M = x.val - 2 ^ idxC N M := by
      rw [Nat.mod_eq_sub_mod h]; exact Nat.mod_eq_of_lt (by omega)
    rw [decide_eq_true h, if_pos rfl, hm]
    omega
  · rw [decide_eq_false h, if_neg (by simp), Nat.mod_eq_of_lt (not_le.mp h)]
    omega

/-- Sums over pair indices are sums over `(A ++ B ++ z, o)`. -/
theorem sum_bP_eq {N M : ℕ} {V : Type*} [AddCommMonoid V] (f : Fin (2 ^ bP N M) → V) :
    ∑ x, f x = ∑ y : Fin (2 ^ idxC N M), ∑ o : Bool, f (encP y o) := by
  let e : (Fin (2 ^ idxC N M) × Bool) ≃ Fin (2 ^ bP N M) :=
    { toFun := fun p => encP p.1 p.2
      invFun := fun x => (loP x, oP x)
      left_inv := fun ⟨y, o⟩ => by simp [loP_encP, oP_encP]
      right_inv := fun x => encP_loP x }
  refine (Equiv.sum_comp e f).symm.trans ?_
  rw [Fintype.sum_prod_type]
  all_goals rfl

theorem idxA_swapAB {N M : ℕ} (y : Fin (2 ^ idxC N M)) : idxA (swapAB y) = idxB y :=
  idxA_encC _ _ _

theorem idxB_swapAB {N M : ℕ} (y : Fin (2 ^ idxC N M)) : idxB (swapAB y) = idxA y :=
  idxB_encC _ _ _

theorem idxZ_swapAB {N M : ℕ} (y : Fin (2 ^ idxC N M)) : idxZ (swapAB y) = idxZ y :=
  idxZ_encC _ _ _

theorem swapAB_swapAB {N M : ℕ} (y : Fin (2 ^ idxC N M)) : swapAB (swapAB y) = y := by
  unfold swapAB
  rw [idxA_encC, idxB_encC, idxZ_encC]
  exact encC_idx y

theorem swapP_swapP {N M : ℕ} (x : Fin (2 ^ bP N M)) : swapP (swapP x) = x := by
  unfold swapP
  rw [loP_encP, oP_encP, swapAB_swapAB, Bool.not_not]
  exact encP_loP x

theorem sum_swapP {N M : ℕ} {V : Type*} [AddCommMonoid V] (f : Fin (2 ^ bP N M) → V) :
    ∑ x, f (swapP x) = ∑ x, f x :=
  Equiv.sum_comp ⟨swapP, swapP, swapP_swapP, swapP_swapP⟩ f

/-! ## The pair SELECT -/

/-- Block of pair index `x`: `(-1)^z V_B V_A` (then the index moves to `swapP x`). -/
noncomputable def selPW {N M : ℕ} (D : CData N M) (beth : ℕ) (x : Fin (2 ^ bP N M)) :
    Operator (2 ^ (2 * N)) :=
  (if idxZ (loP x) then (-1 : ℂ) else 1) •
    (VC D beth (idxB (loP x)) * VC D beth (idxA (loP x)))

/-- The pair SELECT `Σ_x |swapP x⟩⟨x| ⊗ (-1)^z V_B V_A`. -/
noncomputable def pairSelOp {N M : ℕ} (D : CData N M) (beth : ℕ) :
    Operator (2 ^ (2 * N + bP N M)) :=
  ∑ x, idxTr N (bP N M) (swapP x) x * (sysReg N (bP N M)).embedMatrix (selPW D beth x)

private theorem idxTr_conjTranspose (N b : ℕ) (y x : Fin (2 ^ b)) :
    (idxTr N b y x)ᴴ = idxTr N b x y := by
  unfold idxTr
  rw [← QRegister.embedMatrix_conjTranspose, Matrix.conjTranspose_single]
  simp

private theorem idxTr_comm_sys (N b : ℕ) (y x : Fin (2 ^ b)) (A : Operator (2 ^ (2 * N))) :
    idxTr N b y x * (sysReg N b).embedMatrix A = (sysReg N b).embedMatrix A * idxTr N b y x := by
  have hSI : (sysReg N b).DisjointWires (idxReg N b) :=
    QRegister.block_disjoint_of_le 0 (2 * N) (2 * N) b (by omega) le_rfl (by omega)
  exact (QRegister.embedMatrix_comm_of_disjoint _ _ hSI _ _).symm

private theorem idxTr_mul (N b : ℕ) (y x x' y' : Fin (2 ^ b)) :
    idxTr N b y x * idxTr N b x' y' = if x = x' then idxTr N b y y' else 0 := by
  unfold idxTr
  rw [← QRegister.embedMatrix_mul]
  by_cases h : x = x'
  · subst h
    rw [if_pos rfl, Matrix.single_mul_single_same, mul_one]
  · have h0 : Matrix.single y x (1 : ℂ) * Matrix.single x' y' 1 = 0 := by simp [h]
    rw [if_neg h, h0, QRegister.embedMatrix_zero]

private theorem idxTr_sum_one (N b : ℕ) : ∑ x : Fin (2 ^ b), idxTr N b x x = 1 := by
  unfold idxTr
  rw [← QRegister.embedMatrix_sum, ← QRegister.embedMatrix_one]
  congr 1
  ext i j
  rw [Matrix.sum_apply, Matrix.one_apply]
  by_cases h : i = j
  · subst h
    rw [Finset.sum_eq_single i]
    · simp
    · intro x _ hx
      rw [Matrix.single_apply_of_ne]
      rintro ⟨h1, -⟩
      exact hx h1
    · simp
  · rw [if_neg h]
    apply Finset.sum_eq_zero
    intro x _
    rw [Matrix.single_apply_of_ne]
    rintro ⟨rfl, rfl⟩
    exact h rfl

private theorem mul_swap_mid {R : Type*} [Ring R] (P Q Rr S : R) (h : Rr * Q = Q * Rr) :
    (P * Rr) * (Q * S) = (P * Q) * (Rr * S) := by
  calc (P * Rr) * (Q * S) = P * (Rr * Q) * S := by simp only [mul_assoc]
    _ = P * (Q * Rr) * S := by rw [h]
    _ = (P * Q) * (Rr * S) := by simp only [mul_assoc]

theorem loP_swapP {N M : ℕ} (x : Fin (2 ^ bP N M)) : loP (swapP x) = swapAB (loP x) :=
  loP_encP _ _

theorem selPW_swapP {N M : ℕ} (D : CData N M) (beth : ℕ) (x : Fin (2 ^ bP N M)) :
    selPW D beth (swapP x) = (if idxZ (loP x) then (-1 : ℂ) else 1) •
      (VC D beth (idxA (loP x)) * VC D beth (idxB (loP x))) := by
  unfold selPW
  rw [loP_swapP, idxZ_swapAB, idxA_swapAB, idxB_swapAB]

theorem selPW_conjTranspose {N M : ℕ} [NeZero N] (D : CData N M) (beth : ℕ)
    (x : Fin (2 ^ bP N M)) : (selPW D beth x)ᴴ = selPW D beth (swapP x) := by
  rw [selPW_swapP]
  unfold selPW
  have hc : star (if idxZ (loP x) then (-1 : ℂ) else 1) = if idxZ (loP x) then -1 else 1 := by
    split_ifs <;> simp
  rw [Matrix.conjTranspose_smul, Matrix.conjTranspose_mul, VC_conjTranspose, VC_conjTranspose, hc]

theorem selPW_mul_swap {N M : ℕ} [NeZero N] (D : CData N M) (beth : ℕ) (x : Fin (2 ^ bP N M)) :
    selPW D beth x * selPW D beth (swapP x) = 1 := by
  rw [selPW_swapP]
  unfold selPW
  have h1 : VC D beth (idxB (loP x)) * VC D beth (idxA (loP x)) *
      (VC D beth (idxA (loP x)) * VC D beth (idxB (loP x))) = 1 := by
    calc _ = VC D beth (idxB (loP x)) * (VC D beth (idxA (loP x)) * VC D beth (idxA (loP x))) *
          VC D beth (idxB (loP x)) := by simp only [Matrix.mul_assoc]
      _ = 1 := by rw [VC_mul_self, Matrix.mul_one, VC_mul_self]
  have hc : (if idxZ (loP x) then (-1 : ℂ) else 1) * (if idxZ (loP x) then (-1 : ℂ) else 1) = 1 := by
    split_ifs <;> norm_num
  rw [Matrix.smul_mul, Matrix.mul_smul, smul_smul, h1, hc, one_smul]

theorem pairSelOp_conjTranspose {N M : ℕ} [NeZero N] (D : CData N M) (beth : ℕ) :
    (pairSelOp D beth)ᴴ = pairSelOp D beth := by
  unfold pairSelOp
  rw [Matrix.conjTranspose_sum]
  have h1 : ∀ x, (idxTr N (bP N M) (swapP x) x *
      (sysReg N (bP N M)).embedMatrix (selPW D beth x))ᴴ =
      idxTr N (bP N M) x (swapP x) *
        (sysReg N (bP N M)).embedMatrix (selPW D beth (swapP x)) := by
    intro x
    rw [Matrix.conjTranspose_mul, ← QRegister.embedMatrix_conjTranspose (sysReg N (bP N M)),
      selPW_conjTranspose, idxTr_conjTranspose]
    exact (idxTr_comm_sys _ _ _ _ _).symm
  simp only [h1]
  have h2 := sum_swapP (fun x ↦ idxTr N (bP N M) (swapP x) x *
    (sysReg N (bP N M)).embedMatrix (selPW D beth x))
  simp only [swapP_swapP] at h2
  exact h2

theorem pairSelOp_mem {N M : ℕ} [NeZero N] (D : CData N M) (beth : ℕ) :
    pairSelOp D beth ∈ Matrix.unitaryGroup (Fin (2 ^ (2 * N + bP N M))) ℂ := by
  rw [Matrix.mem_unitaryGroup_iff, Matrix.star_eq_conjTranspose, pairSelOp_conjTranspose]
  have hterm : ∀ x x' : Fin (2 ^ bP N M),
      (idxTr N (bP N M) (swapP x) x * (sysReg N (bP N M)).embedMatrix (selPW D beth x)) *
        (idxTr N (bP N M) (swapP x') x' * (sysReg N (bP N M)).embedMatrix (selPW D beth x')) =
      if x = swapP x' then idxTr N (bP N M) (swapP x) x' *
        (sysReg N (bP N M)).embedMatrix (selPW D beth x * selPW D beth x') else 0 := by
    intro x x'
    rw [mul_swap_mid _ _ _ _ (idxTr_comm_sys _ _ _ _ _).symm, idxTr_mul,
      ← QRegister.embedMatrix_mul]
    split_ifs <;> simp [Matrix.zero_mul]
  unfold pairSelOp
  rw [Finset.sum_mul_sum]
  simp only [hterm]
  have hrow : ∀ x, ∑ x', (if x = swapP x' then idxTr N (bP N M) (swapP x) x' *
      (sysReg N (bP N M)).embedMatrix (selPW D beth x * selPW D beth x') else 0) =
      idxTr N (bP N M) (swapP x) (swapP x) := by
    intro x
    rw [Finset.sum_eq_single (swapP x)]
    · rw [if_pos (swapP_swapP x).symm, selPW_mul_swap, QRegister.embedMatrix_one, mul_one]
    · intro x' _ hx'
      rw [if_neg]
      intro h
      apply hx'
      rw [h, swapP_swapP]
    · simp
  simp only [hrow]
  rw [sum_swapP (fun x ↦ idxTr N (bP N M) x x)]
  exact idxTr_sum_one N _

/-! ## Factorization through C1's SELECT -/

/-- System ++ row `A` (the low `bIC` index wires), a contiguous block. -/
def regSA (N M : ℕ) : QRegister (2 * N + bIC N M) (2 * N + bP N M) :=
  QRegister.block 0 (2 * N + bIC N M) (by unfold bP idxC; omega)

/-- C1's SELECT over the `N + M` leaves (no sign bits) on system ++ `A`. -/
noncomputable def selA {N M : ℕ} (D : CData N M) (beth : ℕ) : Operator (2 ^ (2 * N + bP N M)) :=
  (regSA N M).embedMatrix (selectOpL N (N + M) (bIC N M) beth (kAll D) (fun _ ↦ false)
    (by have := rows_le_bIC N M; omega))

/-- `SWAP(A, B)` and `X_o` on the index. -/
noncomputable def swapOp (N M : ℕ) : Operator (2 ^ (2 * N + bP N M)) :=
  ∑ x, idxTr N (bP N M) (swapP x) x

/-- `Z` on the sign wire `z`. -/
noncomputable def zOp (N M : ℕ) : Operator (2 ^ (2 * N + bP N M)) :=
  ∑ x, (if idxZ (loP x) then (-1 : ℂ) else 1) • idxTr N (bP N M) x x

private theorem blockR_extract (s k m : ℕ) (h : s + k ≤ m) (j : Fin (2 ^ m)) :
    (QRegister.block s k h).extractIndex j =
      ⟨j.val / 2 ^ s % 2 ^ k, Nat.mod_lt _ (Nat.two_pow_pos _)⟩ := by
  apply (basisBits k).injective
  funext i
  rw [QRegister.basisBits_extractIndex, basisBits_eq_testBit, basisBits_eq_testBit]
  have hv : ((QRegister.block s k h) i).val = s + i.val := rfl
  simp only [hv, Nat.testBit_mod_two_pow, Nat.testBit_div_two_pow, i.2, decide_true,
    Bool.true_and, Nat.add_comm i.val s]

private theorem single_eq_diag {n : ℕ} (x : Fin n) :
    Matrix.single x x (1 : ℂ) = Matrix.diagonal fun i ↦ if i = x then (1 : ℂ) else 0 := by
  ext i j
  rw [Matrix.single_apply, Matrix.diagonal_apply]
  by_cases h1 : x = i <;> by_cases h2 : x = j
  · subst h1; subst h2; simp
  · subst h1; simp [h2, Ne.symm h2]
  · subst h2; simp [h1, Ne.symm h1]
  · simp [h1, h2, Ne.symm h1]

private theorem idxTr_diag (N b : ℕ) (x : Fin (2 ^ b)) :
    idxTr N b x x =
      Matrix.diagonal fun g ↦ if (idxReg N b).extractIndex g = x then (1 : ℂ) else 0 := by
  unfold idxTr
  rw [single_eq_diag, QRegister.embedMatrix_diagonal]

private theorem regSA_ext (N M : ℕ) (g : Fin (2 ^ (2 * N + bP N M))) :
    (idxReg N (bIC N M)).extractIndex ((regSA N M).extractIndex g) =
      idxA (loP ((idxReg N (bP N M)).extractIndex g)) := by
  unfold regSA idxReg
  rw [blockR_extract, blockR_extract, blockR_extract]
  apply Fin.ext
  apply Nat.eq_of_testBit_eq
  intro k
  simp only [idxA, loP, Fin.val_mk, Nat.testBit_mod_two_pow, Nat.testBit_div_two_pow, pow_zero,
    Nat.div_one]
  by_cases hk : k < bIC N M
  · have h1 : k < idxC N M := by unfold idxC; omega
    have h2 : k < bP N M := by unfold bP idxC; omega
    have h3 : k + 2 * N < 2 * N + bIC N M := by omega
    simp [hk, h1, h2, h3]
  · simp [hk]

private theorem regSA_idxProj (N M : ℕ) (A : Fin (2 ^ bIC N M)) :
    (regSA N M).embedMatrix (idxProj N (bIC N M) A.val A.2) =
      ∑ x : Fin (2 ^ bP N M), if idxA (loP x) = A then idxTr N (bP N M) x x else 0 := by
  have hL : (regSA N M).embedMatrix (idxProj N (bIC N M) A.val A.2) =
      Matrix.diagonal fun g ↦
        if idxA (loP ((idxReg N (bP N M)).extractIndex g)) = A then (1 : ℂ) else 0 := by
    unfold idxProj
    rw [QRegister.basisOutcomeProjector_eq_diagonal, QRegister.embedMatrix_diagonal]
    congr 1
    funext g
    simp [regSA_ext]
  rw [hL]
  ext i j
  rw [Matrix.sum_apply]
  by_cases hij : i = j
  · subst hij
    rw [Matrix.diagonal_apply_eq, Finset.sum_eq_single ((idxReg N (bP N M)).extractIndex i)]
    · by_cases hp : idxA (loP ((idxReg N (bP N M)).extractIndex i)) = A <;> simp [hp, idxTr_diag]
    · intro x _ hx
      by_cases hp : idxA (loP x) = A <;> simp [hp, idxTr_diag, hx.symm]
    · simp
  · rw [Matrix.diagonal_apply_ne _ hij]
    symm
    apply Finset.sum_eq_zero
    intro x _
    by_cases hp : idxA (loP x) = A <;> simp [hp, idxTr_diag, Matrix.diagonal_apply_ne _ hij]

private theorem selA_eq {N M : ℕ} (D : CData N M) (beth : ℕ) :
    selA D beth = ∑ x : Fin (2 ^ bP N M), idxTr N (bP N M) x x *
      (sysReg N (bP N M)).embedMatrix (VC D beth (idxA (loP x))) := by
  unfold selA
  rw [selectOpL_eq_sum, QRegister.embedMatrix_sum]
  have hc : (regSA N M).compose (sysReg N (bIC N M)) = sysReg N (bP N M) := by
    apply QRegister.ext
    apply Function.Embedding.ext
    intro i
    apply Fin.ext
    show 0 + (0 + i.val) = 0 + i.val
    omega
  have hterm : ∀ j : Fin (2 ^ bIC N M),
      (regSA N M).embedMatrix (idxProj N (bIC N M) j.val j.2 *
        (sysReg N (bIC N M)).embedMatrix (selWL beth (bIC N M) (kAll D) (fun _ ↦ false) j)) =
      (∑ x : Fin (2 ^ bP N M), if idxA (loP x) = j then idxTr N (bP N M) x x else 0) *
        (sysReg N (bP N M)).embedMatrix (VC D beth j) := by
    intro j
    rw [QRegister.embedMatrix_mul, regSA_idxProj, ← QRegister.embedMatrix_compose, hc]
    rfl
  simp only [hterm, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun x _ ↦ ?_
  rw [Finset.sum_eq_single (idxA (loP x))]
  · rw [if_pos rfl]
  · intro j _ hj
    rw [if_neg (Ne.symm hj), zero_mul]
  · simp

/-- Product with a diagonal factor on the right: the diagonal acts on the column index. -/
private theorem prod_diag_right (N b : ℕ) (π : Fin (2 ^ b) → Fin (2 ^ b))
    (W W' : Fin (2 ^ b) → Operator (2 ^ (2 * N))) :
    (∑ x, idxTr N b (π x) x * (sysReg N b).embedMatrix (W x)) *
        (∑ y, idxTr N b y y * (sysReg N b).embedMatrix (W' y)) =
      ∑ x, idxTr N b (π x) x * (sysReg N b).embedMatrix (W x * W' x) := by
  rw [Finset.sum_mul_sum]
  refine Finset.sum_congr rfl fun x _ ↦ ?_
  have hterm : ∀ y, (idxTr N b (π x) x * (sysReg N b).embedMatrix (W x)) *
      (idxTr N b y y * (sysReg N b).embedMatrix (W' y)) =
      if x = y then idxTr N b (π x) y * (sysReg N b).embedMatrix (W x * W' y) else 0 := by
    intro y
    rw [mul_swap_mid _ _ _ _ (idxTr_comm_sys _ _ _ _ _).symm, idxTr_mul,
      ← QRegister.embedMatrix_mul]
    split_ifs <;> simp [Matrix.zero_mul]
  simp only [hterm]
  rw [Finset.sum_eq_single x]
  · rw [if_pos rfl]
  · intro y _ hy
    rw [if_neg (Ne.symm hy)]
  · simp

/-- Product with a diagonal factor on the left: the diagonal acts on the row index. -/
private theorem prod_diag_left (N b : ℕ) (π : Fin (2 ^ b) → Fin (2 ^ b))
    (W W' : Fin (2 ^ b) → Operator (2 ^ (2 * N))) :
    (∑ x, idxTr N b x x * (sysReg N b).embedMatrix (W x)) *
        (∑ y, idxTr N b (π y) y * (sysReg N b).embedMatrix (W' y)) =
      ∑ y, idxTr N b (π y) y * (sysReg N b).embedMatrix (W (π y) * W' y) := by
  rw [Finset.sum_mul_sum, Finset.sum_comm]
  refine Finset.sum_congr rfl fun y _ ↦ ?_
  have hterm : ∀ x, (idxTr N b x x * (sysReg N b).embedMatrix (W x)) *
      (idxTr N b (π y) y * (sysReg N b).embedMatrix (W' y)) =
      if x = π y then idxTr N b x y * (sysReg N b).embedMatrix (W x * W' y) else 0 := by
    intro x
    rw [mul_swap_mid _ _ _ _ (idxTr_comm_sys _ _ _ _ _).symm, idxTr_mul,
      ← QRegister.embedMatrix_mul]
    split_ifs <;> simp [Matrix.zero_mul]
  simp only [hterm]
  rw [Finset.sum_eq_single (π y)]
  · rw [if_pos rfl]
  · intro x _ hx
    rw [if_neg hx]
  · simp

/-- `S = Z_z · SEL_A · (SWAP(A, B) X_o) · SEL_A`: apply `V_A`, swap the rows, apply `V_B`. -/
theorem pairSelOp_factor {N M : ℕ} (D : CData N M) (beth : ℕ) :
    pairSelOp D beth = zOp N M * selA D beth * swapOp N M * selA D beth := by
  have hz : zOp N M = ∑ x, idxTr N (bP N M) x x * (sysReg N (bP N M)).embedMatrix
      ((if idxZ (loP x) then (-1 : ℂ) else 1) • (1 : Operator (2 ^ (2 * N)))) := by
    unfold zOp
    refine Finset.sum_congr rfl fun x _ ↦ ?_
    rw [QRegister.embedMatrix_smul, QRegister.embedMatrix_one, Matrix.mul_smul, mul_one]
  have hs : swapOp N M = ∑ x, idxTr N (bP N M) (swapP x) x *
      (sysReg N (bP N M)).embedMatrix (1 : Operator (2 ^ (2 * N))) := by
    unfold swapOp
    refine Finset.sum_congr rfl fun x _ ↦ ?_
    rw [QRegister.embedMatrix_one, mul_one]
  have h1 := prod_diag_right N (bP N M) (fun x ↦ x)
    (fun x ↦ (if idxZ (loP x) then (-1 : ℂ) else 1) • (1 : Operator (2 ^ (2 * N))))
    (fun x ↦ VC D beth (idxA (loP x)))
  have h2 := prod_diag_left N (bP N M) swapP
    (fun x ↦ (if idxZ (loP x) then (-1 : ℂ) else 1) • (1 : Operator (2 ^ (2 * N))) *
      VC D beth (idxA (loP x)))
    (fun _ ↦ (1 : Operator (2 ^ (2 * N))))
  have h3 := prod_diag_right N (bP N M) swapP
    (fun y ↦ (if idxZ (loP (swapP y)) then (-1 : ℂ) else 1) • (1 : Operator (2 ^ (2 * N))) *
      VC D beth (idxA (loP (swapP y))) * 1)
    (fun y ↦ VC D beth (idxA (loP y)))
  beta_reduce at h1 h2 h3
  rw [selA_eq, hz, hs, h1, h2, h3]
  unfold pairSelOp
  refine Finset.sum_congr rfl fun y _ ↦ ?_
  have e : selPW D beth y =
      (if idxZ (loP (swapP y)) then (-1 : ℂ) else 1) • (1 : Operator (2 ^ (2 * N))) *
        VC D beth (idxA (loP (swapP y))) * 1 * VC D beth (idxA (loP y)) := by
    unfold selPW
    rw [loP_swapP, idxZ_swapAB, idxA_swapAB]
    simp only [mul_one, Matrix.smul_mul, Matrix.one_mul]
  rw [e]

end QC14.PairBlock


/-! Inlined from lane module `THC/Rounding.lean`. -/

namespace QC14
open QuantumComputation QuantumComputation.Specs Finset

/-! ## Exact preparation of integer weights -/

/-- Integer weights as a `PrepareWeights` table. -/
def natW {L : ℕ} (k : Fin L → ℕ) : PrepareWeights L := fun i ↦ (k i : ℚ)

theorem prepareLambda_natW {b L μ : ℕ} (k : Fin L → ℕ) (hk : ∑ j, k j = 2 ^ (b + μ)) :
    prepareLambda (natW k) = 2 ^ (b + μ) := by
  have h : prepareLambda (natW k) = ((∑ j, k j : ℕ) : ℚ) := by
    unfold prepareLambda natW
    rw [Nat.cast_sum]
  rw [h, hk, Nat.cast_pow, Nat.cast_ofNat]

theorem thr_natW {b L μ : ℕ} (k : Fin L → ℕ) (hk : ∑ j, k j = 2 ^ (b + μ)) (j : ℕ) :
    PrepareImpl.thr b L μ (natW k) j =
      ∑ i ∈ univ.filter (fun i : Fin L ↦ i.val < j), k i := by
  unfold PrepareImpl.thr PrepareImpl.cumW
  rw [prepareLambda_natW (b := b) (μ := μ) k hk]
  have h : (∑ i ∈ univ.filter (fun i : Fin L ↦ i.val < j), natW k i) =
      ((∑ i ∈ univ.filter (fun i : Fin L ↦ i.val < j), k i : ℕ) : ℚ) := by
    rw [Nat.cast_sum]; rfl
  have hne : (2 : ℚ) ^ (b + μ) ≠ 0 := by positivity
  rw [h, mul_div_cancel_left₀ _ hne]
  exact Nat.floor_natCast _

theorem fibre_card_natW {b L μ : ℕ} (hLb : L ≤ 2 ^ b) (k : Fin L → ℕ)
    (hk : ∑ j, k j = 2 ^ (b + μ)) (j : Fin (2 ^ b)) (hj : j.val < L) :
    (univ.filter (fun σ : Fin (2 ^ (b + μ)) ↦ PrepareImpl.pickF b L μ (natW k) σ = j)).card =
      k ⟨j.val, hj⟩ := by
  have hpos : 0 < prepareLambda (natW k) := by
    rw [prepareLambda_natW (b := b) (μ := μ) k hk]; positivity
  have hw : ∀ i, 0 ≤ natW k i := fun i ↦ by simp [natW]
  rw [PrepareImpl.fibre_card (w := natW k) (b := b) (μ := μ) hLb hw hpos j hj,
    thr_natW k hk, thr_natW k hk]
  have hins : univ.filter (fun i : Fin L ↦ i.val < j.val + 1) =
      insert ⟨j.val, hj⟩ (univ.filter (fun i : Fin L ↦ i.val < j.val)) := by
    ext i
    simp only [mem_filter, mem_univ, true_and, mem_insert, Fin.ext_iff]
    omega
  rw [hins, Finset.sum_insert (by simp)]
  omega

theorem fibre_card_natW_ge {b L μ : ℕ} (hLb : L ≤ 2 ^ b) (k : Fin L → ℕ)
    (hk : ∑ j, k j = 2 ^ (b + μ)) (j : Fin (2 ^ b)) (hj : L ≤ j.val) :
    (univ.filter (fun σ : Fin (2 ^ (b + μ)) ↦ PrepareImpl.pickF b L μ (natW k) σ = j)).card =
      0 := by
  have hpos : 0 < prepareLambda (natW k) := by
    rw [prepareLambda_natW (b := b) (μ := μ) k hk]; positivity
  rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  intro σ _ h
  have := PrepareImpl.pickF_lt (w := natW k) (b := b) (μ := μ) hLb hpos σ
  rw [h] at this
  omega

/-! ## Bounds from `IsRounded` at M = 0 -/

theorem abs_givensLeaf_le_one {N : ℕ} (b : ℕ) (k : Fin N → ℤ) (p : Fin N) :
    |givensLeaf b k p| ≤ 1 := by
  unfold givensLeaf
  dsimp only
  rw [abs_mul]
  refine (mul_le_mul ?_ ?_ (abs_nonneg _) zero_le_one).trans_eq (one_mul 1)
  · rw [Finset.abs_prod]
    exact Finset.prod_le_one₀ (fun _ _ ↦ abs_nonneg _) (fun _ _ ↦ Real.abs_sin_le_one _)
  · split_ifs
    · simp
    · exact Real.abs_cos_le_one _

theorem abs_h1eMod_le {N : ℕ} (thc : THCFactorization N 0) {aleph beth : ℕ} {lam : ℝ}
    (hround : thc.IsRounded aleph beth lam) (p q : Fin N) : |thc.h1eMod p q| ≤ lam := by
  obtain ⟨-, t, k, h⟩ := hround
  try dsimp only at h
  obtain ⟨hT, hlam, -⟩ := h
  have hS : ∀ p q, thcShiftedOneBody thc p q = thc.h1eMod p q := by
    intro p q
    simp [thcShiftedOneBody]
  have e := (hS p q).symm.trans (congrFun (congrFun hT p) q)
  simp only [Matrix.sum_apply, Matrix.smul_apply, Matrix.vecMulVec_apply, smul_eq_mul] at e
  have hz : ∑ μ : Fin 0, ∑ ν : Fin 0, |thc.zeta μ ν| = 0 := by simp
  have hs : ∑ ℓ, |t ℓ| ≤ lam := by
    rw [hz] at hlam
    linarith
  rw [e]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (le_trans ?_ hs)
  refine Finset.sum_le_sum fun ℓ _ ↦ ?_
  rw [abs_mul, abs_mul]
  have ha := abs_givensLeaf_le_one beth (k ℓ) p
  have hb := abs_givensLeaf_le_one beth (k ℓ) q
  have hab : |givensLeaf beth (k ℓ) p| * |givensLeaf beth (k ℓ) q| ≤ 1 := by
    nlinarith [abs_nonneg (givensLeaf beth (k ℓ) p), abs_nonneg (givensLeaf beth (k ℓ) q)]
  calc |t ℓ| * (|givensLeaf beth (k ℓ) p| * |givensLeaf beth (k ℓ) q|) ≤ |t ℓ| * 1 :=
        mul_le_mul_of_nonneg_left hab (abs_nonneg _)
    _ = |t ℓ| := mul_one _

/-! ## Sizes -/

/-- Subnormalization `R = 1 + N² ⌈lamMax⌉₊`, strictly above `∑_{p,q} |h_pq|`. -/
noncomputable def capR (N : ℕ) (lamMax : ℝ) : ℕ := 1 + N ^ 2 * ⌈lamMax⌉₊

/-- Index width: `2^b ≥ 4N² + 1` rows. -/
def bOf (N : ℕ) : ℕ := Nat.clog 2 (4 * N ^ 2 + 1)

/-- Extra precision: `2^μ ≥ 4N²R/ε`. -/
noncomputable def muOf (N : ℕ) (lamMax ε : ℝ) : ℕ :=
  Nat.clog 2 ⌈(4 * N ^ 2 * capR N lamMax : ℝ) / ε⌉₊

theorem rows_le_pow (N : ℕ) : 4 * N ^ 2 + 1 ≤ 2 ^ bOf N :=
  Nat.le_pow_clog (by norm_num) _

theorem muOf_spec (N : ℕ) (lamMax : ℝ) {ε : ℝ} (hε : 0 < ε) :
    (4 * N ^ 2 * capR N lamMax : ℝ) ≤ ε * 2 ^ muOf N lamMax ε := by
  unfold muOf
  set X : ℝ := 4 * N ^ 2 * capR N lamMax with hX
  have h1 : X / ε ≤ ⌈X / ε⌉₊ := Nat.le_ceil _
  have h2 : ⌈X / ε⌉₊ ≤ 2 ^ Nat.clog 2 ⌈X / ε⌉₊ := Nat.le_pow_clog (by norm_num) _
  have h3 : (⌈X / ε⌉₊ : ℝ) ≤ 2 ^ Nat.clog 2 ⌈X / ε⌉₊ := by exact_mod_cast h2
  have h4 := h1.trans h3
  rw [div_le_iff₀ hε] at h4
  linarith

/-! ## Rounded weights -/

/-- Rounded weight of a coefficient of magnitude `|x| / 4`, on `D` slots with norm `R`. -/
noncomputable def wt (D R : ℕ) (x : ℝ) : ℕ := ⌊(D : ℝ) * |x| / (4 * R)⌋₊

theorem wt_err (D R : ℕ) (hD : 0 < D) (hR : 0 < R) (x : ℝ) :
    |(R : ℝ) * wt D R x / D - |x| / 4| ≤ R / D := by
  unfold wt
  have hDr : (0 : ℝ) < D := by exact_mod_cast hD
  have hRr : (0 : ℝ) < R := by exact_mod_cast hR
  have hD0 : (D : ℝ) ≠ 0 := hDr.ne'
  have hR0 : (R : ℝ) ≠ 0 := hRr.ne'
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = (D : ℝ) * |x| / (4 * R) := ⟨_, rfl⟩
  rw [← ha]
  have ha0 : 0 ≤ a := by rw [ha]; positivity
  have h1 := Nat.floor_le ha0
  have h2 := Nat.lt_floor_add_one a
  have key : |x| / 4 = R * a / D := by
    rw [ha]
    field_simp
  have hk : 0 < (R : ℝ) / D := by positivity
  have e : (R : ℝ) * (⌊a⌋₊ : ℝ) / D - R * a / D = (R / D) * ((⌊a⌋₊ : ℝ) - a) := by ring
  rw [key, e, abs_le]
  constructor
  · have : (R : ℝ) / D * (-1) ≤ R / D * ((⌊a⌋₊ : ℝ) - a) :=
      mul_le_mul_of_nonneg_left (by linarith) hk.le
    linarith
  · have : (R : ℝ) / D * ((⌊a⌋₊ : ℝ) - a) ≤ R / D * 0 :=
      mul_le_mul_of_nonneg_left (by linarith) hk.le
    linarith

theorem sum_wt_le {N : ℕ} (h : Matrix (Fin N) (Fin N) ℝ) {lam : ℝ}
    (hb : ∀ p q, |h p q| ≤ lam) (D : ℕ) :
    4 * ∑ p, ∑ q, wt D (capR N lam) (h p q) ≤ D := by
  have hR : ((capR N lam : ℕ) : ℝ) = 1 + (N : ℝ) ^ 2 * (⌈lam⌉₊ : ℝ) := by simp [capR]
  have hRpos : (0 : ℝ) < capR N lam := by rw [hR]; positivity
  have hR0 : (capR N lam : ℝ) ≠ 0 := hRpos.ne'
  have hle : (N : ℝ) ^ 2 * (⌈lam⌉₊ : ℝ) ≤ capR N lam := by rw [hR]; linarith
  obtain ⟨B, hB⟩ : ∃ B : ℝ, B = (D : ℝ) * ⌈lam⌉₊ / (4 * capR N lam) := ⟨_, rfl⟩
  have hwt : ∀ p q, (wt D (capR N lam) (h p q) : ℝ) ≤ B := by
    intro p q
    unfold wt
    refine (Nat.floor_le (by positivity)).trans ?_
    rw [hB]
    gcongr
    exact (hb p q).trans (Nat.le_ceil lam)
  have h1 : ∑ p, ∑ q, (wt D (capR N lam) (h p q) : ℝ) ≤ (N : ℝ) * ((N : ℝ) * B) := by
    calc ∑ p, ∑ q, (wt D (capR N lam) (h p q) : ℝ) ≤ ∑ _p : Fin N, ∑ _q : Fin N, B :=
          Finset.sum_le_sum fun p _ ↦ Finset.sum_le_sum fun q _ ↦ hwt p q
      _ = (N : ℝ) * ((N : ℝ) * B) := by
          simp
  have e : 4 * ((N : ℝ) * ((N : ℝ) * B)) = D * ((N : ℝ) ^ 2 * (⌈lam⌉₊ : ℝ)) / capR N lam := by
    rw [hB]
    field_simp
  have hfin : 4 * ((N : ℝ) * ((N : ℝ) * B)) ≤ D := by
    rw [e, div_le_iff₀ hRpos]
    exact mul_le_mul_of_nonneg_left hle (Nat.cast_nonneg _)
  have hS : (4 * ∑ p, ∑ q, wt D (capR N lam) (h p q) : ℝ) ≤ D := by
    push_cast
    linarith
  exact_mod_cast hS

/-- Rows: `some (σ, p, q, x)` for the Pauli rows, `none` for the identity filler. -/
abbrev Row (N : ℕ) : Type := Option (Fin 2 × Fin N × Fin N × Fin 2)

theorem card_row (N : ℕ) : Fintype.card (Row N) = 4 * N ^ 2 + 1 := by
  simp only [Row, Fintype.card_option, Fintype.card_prod, Fintype.card_fin]
  ring

/-- Row weights: Pauli rows get `wt`, the filler gets the rest of the `D` slots. -/
noncomputable def rowWt {N : ℕ} (D R : ℕ) (h : Matrix (Fin N) (Fin N) ℝ) : Row N → ℕ
  | some (_, p, q, _) => wt D R (h p q)
  | none => D - 4 * ∑ p, ∑ q, wt D R (h p q)

theorem sum_rowWt {N : ℕ} (h : Matrix (Fin N) (Fin N) ℝ) {lam : ℝ}
    (hb : ∀ p q, |h p q| ≤ lam) (D : ℕ) :
    ∑ r, rowWt D (capR N lam) h r = D := by
  have hn : rowWt D (capR N lam) h none = D - 4 * ∑ p, ∑ q, wt D (capR N lam) (h p q) := rfl
  have h4 : ∑ i : Fin 2 × Fin N × Fin N × Fin 2, rowWt D (capR N lam) h (some i) =
      4 * ∑ p, ∑ q, wt D (capR N lam) (h p q) := by
    have : ∀ i : Fin 2 × Fin N × Fin N × Fin 2, rowWt D (capR N lam) h (some i) =
        wt D (capR N lam) (h i.2.1 i.2.2.1) := by
      rintro ⟨a, p, q, x⟩
      rfl
    rw [Finset.sum_congr rfl fun i _ ↦ this i]
    simp only [Fintype.sum_prod_type, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      smul_eq_mul, ← Finset.mul_sum]
    ring
  rw [Fintype.sum_option, hn, h4]
  exact Nat.sub_add_cancel (sum_wt_le h hb D)

/-- Row numbering. -/
noncomputable def rowEquiv (N : ℕ) : Row N ≃ Fin (4 * N ^ 2 + 1) :=
  Fintype.equivFinOfCardEq (card_row N)

/-- Weights on `Fin L`, `L = 4N² + 1`. -/
noncomputable def finWt {N : ℕ} (D R : ℕ) (h : Matrix (Fin N) (Fin N) ℝ) :
    Fin (4 * N ^ 2 + 1) → ℕ :=
  fun j ↦ rowWt D R h ((rowEquiv N).symm j)

theorem sum_finWt {N : ℕ} (h : Matrix (Fin N) (Fin N) ℝ) {lam : ℝ}
    (hb : ∀ p q, |h p q| ≤ lam) (D : ℕ) :
    ∑ j, finWt D (capR N lam) h j = D :=
  (Equiv.sum_comp (rowEquiv N).symm (rowWt D (capR N lam) h)).trans (sum_rowWt h hb D)

/-- Total rounding error over the `4N²` Pauli rows is at most `ε`. -/
theorem total_err_le (N : ℕ) (lamMax : ℝ) {ε : ℝ} (hε : 0 < ε) (b : ℕ) :
    (4 * N ^ 2 : ℝ) * (capR N lamMax / 2 ^ (b + muOf N lamMax ε)) ≤ ε := by
  have hspec := muOf_spec N lamMax hε
  have hP : (2 : ℝ) ^ (muOf N lamMax ε) ≤ 2 ^ (b + muOf N lamMax ε) := by
    exact pow_le_pow_right₀ (by norm_num) (by omega)
  have hPpos : (0 : ℝ) < 2 ^ (b + muOf N lamMax ε) := by positivity
  rw [← mul_div_assoc, div_le_iff₀ hPpos]
  calc (4 * N ^ 2 : ℝ) * capR N lamMax ≤ ε * 2 ^ muOf N lamMax ε := hspec
    _ ≤ ε * 2 ^ (b + muOf N lamMax ε) := mul_le_mul_of_nonneg_left hP hε.le

end QC14


